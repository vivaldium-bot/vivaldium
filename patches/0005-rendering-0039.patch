-                            'third', true, function() {
-                                test = test;
-
-                                /* Expect that we did indeed do a preflight */
-                                dothing('resources/preflight.py?check&3&token=' + token1,
-                                '1', false, function() {
-                                    test.done()
-                                })
-                            })
-                        }, 1500)
-                    })
-                })
-            })
-        })
-    })
-})();
-
-</script>
