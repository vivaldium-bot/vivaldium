diff --git a/third_party/WebKit/LayoutTests/external/wpt/content-security-policy/README.html b/third_party/WebKit/LayoutTests/external/wpt/content-security-policy/README.html
deleted file mode 100644
index e2c3e38c6b4efdaa41abc200111999b6ca41d2c9..0000000000000000000000000000000000000000
--- a/third_party/WebKit/LayoutTests/external/wpt/content-security-policy/README.html
