index 0000000000000000000000000000000000000000..a517fb69732bfeb116235521aa60384768182c63
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_aalinetemp.h
@@ -0,0 +1,242 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
+ * Copyright (C) 1999-2007  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
