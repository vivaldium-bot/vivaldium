+  std::unique_ptr<CFXJSE_Value> argTwo = GetSimpleValue(pThis, args, 1);
+  if (ValueIsNull(pThis, argTwo.get())) {
+    args.GetReturnValue()->SetNull();
+    return;
+  }
+
+  CFX_ByteString szPattern;
+  ValueToUTF8String(argOne.get(), szPattern);
