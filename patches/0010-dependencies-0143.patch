+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var Cpu = tr.model.Cpu;
+  var CpuTrack = tr.ui.tracks.CpuTrack;
+  var Slice = tr.model.Slice;
+  var StackFrame = tr.model.StackFrame;
