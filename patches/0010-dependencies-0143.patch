+    m_pFontSource = pdfium::MakeUnique<CFX_FontSourceEnum_File>();
+    m_pFDEFontMgr = CFGAS_FontMgr::Create(m_pFontSource.get());
+#endif
+  }
+  return m_pFDEFontMgr.get();
+}
