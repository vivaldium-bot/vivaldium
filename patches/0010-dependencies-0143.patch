--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_cb_bitmap.c
@@ -0,0 +1,887 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
