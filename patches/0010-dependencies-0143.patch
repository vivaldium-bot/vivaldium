+              const CFX_PointF& endPoint,
+              bool isExtendedBegin,
+              bool isExtendedEnd,
+              const FX_ARGB beginArgb,
+              const FX_ARGB endArgb);
+
+  // Radial shading.
+  CFX_Shading(const CFX_PointF& beginPoint,
+              const CFX_PointF& endPoint,
+              const FX_FLOAT beginRadius,
+              const FX_FLOAT endRadius,
+              bool isExtendedBegin,
+              bool isExtendedEnd,
