+void CXFA_Node::Script_Som_ValidationMessage(CFXJSE_Value* pValue,
+                                             bool bSetting,
+                                             XFA_ATTRIBUTE eAttribute) {
+  Script_Som_Message(pValue, bSetting, XFA_SOM_ValidationMessage);
+}
