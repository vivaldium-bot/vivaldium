+  m_pDocView->LockUpdate();
+  m_pDocView->m_bLayoutEvent = true;
+  bool bRet = hWidget->OnLButtonUp(dwFlags, hWidget->Rotate2Normal(point));
+  m_pDocView->UnlockUpdate();
