+# Object files
+*.o
+*.obj
+*.res
+
+# Dependency files
+*.d
+
+# orig files generated by astyle
+*.orig
+
+# Libraries
+*.lib
+*.a
+
+# Shared objects (inc. Windows DLLs)
+*.dll
+*.so
+*.so.*
+*.dylib
+
+# Executables
+*.exe
+*.out
+*.app
+h264dec
+h264enc
+codec_unittest
+
