+                    bool bEndBreak = true,
+                    bool bIsOl = false,
+                    int32_t iLiCount = 0);
+  bool AppendChar(const WideString& wsText,
+                  float& fLinePos,
+                  float fSpaceAbove,
+                  bool bSavePieces);
