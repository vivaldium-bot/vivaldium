+INLINE int is_via_cpu(void)
+{   int val;
+    asm("pushl %eax\n\t");
+    asm("pushl %ebx\n\t");
+    asm("pushl %ecx\n\t");
+    asm("pushl %edx\n\t");
+    asm("xorl %eax,%eax\n\t");
+    asm("cpuid\n\t");
+    asm("xorl %eax,%eax\n\t");
+    asm("subl $0x746e6543,%ebx\n\t");
+    asm("orl  %ebx,%eax\n\t");
+    asm("subl $0x48727561,%edx\n\t");
+    asm("orl  %edx,%eax\n\t");
+    asm("subl $0x736c7561,%ecx\n\t");
+    asm("orl  %ecx,%eax\n\t");
+    asm("movl %%eax,%0\n\t" : "=m" (val));
+    asm("popl %edx\n\t");
+    asm("popl %ecx\n\t");
+    asm("popl %ebx\n\t");
+    asm("popl %eax\n\t");
+    val = (val ? 0 : 1);
