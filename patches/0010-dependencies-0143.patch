+CXFA_FFWidget* CXFA_FFPageWidgetIterator::MoveToFirst() {
+  m_sIterator.Reset();
+  for (CXFA_LayoutItem* pLayoutItem = m_sIterator.GetCurrent(); pLayoutItem;
+       pLayoutItem = m_sIterator.MoveToNext()) {
+    if (CXFA_FFWidget* hWidget = GetWidget(pLayoutItem)) {
+      return hWidget;
+    }
+  }
+  return nullptr;
