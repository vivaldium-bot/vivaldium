diff --git a/third_party/usrsctp/usrsctplib/user_atomic.h b/third_party/usrsctp/usrsctplib/user_atomic.h
new file mode 100755
index 0000000000000000000000000000000000000000..33659cd226530fbc39ab7c0ac101377fc6bc26da
--- /dev/null
+++ b/third_party/usrsctp/usrsctplib/user_atomic.h
@@ -0,0 +1,300 @@
+/*-
+ * Copyright (c) 2009-2010 Brad Penoff
+ * Copyright (c) 2009-2010 Humaira Kamal
+ * Copyright (c) 2011-2012 Irene Ruengeler
+ * Copyright (c) 2011-2012 Michael Tuexen
+ *
