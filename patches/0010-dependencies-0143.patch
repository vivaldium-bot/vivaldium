+  }
+  CFX_ByteString bsAttributeName = pArguments->GetUTF8String(0);
+  CFX_WideString wsAttributeValue;
+  CFDE_XMLNode* pXMLNode = GetXMLMappingNode();
+  if (pXMLNode && pXMLNode->GetType() == FDE_XMLNODE_Element) {
