+bool IsCtrlCode(wchar_t ch) {
+  uint32_t dwRet = (FX_GetUnicodeProperties(ch) & FX_CHARTYPEBITSMASK);
+  return dwRet == FX_CHARTYPE_Tab || dwRet == FX_CHARTYPE_Control;
+}
