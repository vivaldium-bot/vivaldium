index 0000000000000000000000000000000000000000..5844ad594cd0f9dce340d2665e678c679a257d17
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast_setup/ss_tritmp.h
@@ -0,0 +1,248 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
