+  PageSpan(pArguments);
+}
+
+void CScript_LayoutPseudoModel::AbsPageInBatch(CFXJSE_Arguments* pArguments) {
+  if (pArguments->GetLength() != 1) {
+    ThrowParamCountMismatchException(L"absPageInBatch");
+    return;
+  }
+
+  CFXJSE_Value* pValue = pArguments->GetReturnValue();
+  if (pValue)
+    pValue->SetInteger(0);
+}
