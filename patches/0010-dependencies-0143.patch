index 0000000000000000000000000000000000000000..5d1c70e9481be6b51280148b880adb73a04abba6
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast_setup/ss_triangle.c
@@ -0,0 +1,265 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
