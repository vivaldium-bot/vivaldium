+tr.exportTo('tr.ui.e.chrome.gpu', function() {
+  /*
+   * Displays a GPU state snapshot in a human readable form.
+   * @constructor
+   */
+  var StateSnapshotView = tr.ui.b.define(
+      'tr-ui-e-chrome-gpu-state-snapshot-view',
