+void CBC_QRCoderVersion::Initialize() {
+  VERSION = new CFX_ArrayTemplate<CBC_QRCoderVersion*>();
+}
+void CBC_QRCoderVersion::Finalize() {
+  for (int32_t i = 0; i < VERSION->GetSize(); i++)
+    delete VERSION->GetAt(i);
