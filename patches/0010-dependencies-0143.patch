+void CXFA_Node::Script_Script_Stateless(CFXJSE_Value* pValue,
+                                        bool bSetting,
+                                        XFA_ATTRIBUTE eAttribute) {
+  if (bSetting) {
+    ThrowInvalidPropertyException();
+    return;
+  }
+  pValue->SetString(FX_UTF8Encode(CFX_WideStringC(L"0", 1)).AsStringC());
+}
