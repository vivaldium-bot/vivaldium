+CFX_RetainPtr<IFX_SeekableReadStream> MakeSeekableReadStream(
+    const std::vector<CPDF_Stream*>& streams) {
+  return CFX_RetainPtr<IFX_SeekableReadStream>(new CXFA_FileRead(streams));
+}
