+class CBC_PDF417 {
+ public:
+  CBC_PDF417();
+  explicit CBC_PDF417(bool compact);
+  virtual ~CBC_PDF417();
+
+  CBC_BarcodeMatrix* getBarcodeMatrix();
+  void generateBarcodeLogic(CFX_WideString msg,
+                            int32_t errorCorrectionLevel,
