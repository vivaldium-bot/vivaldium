+int32_t CFWL_WidgetMgr::CountRadioButtonGroup(CFWL_Widget* pFirst) const {
+  int32_t iRet = 0;
+  CFWL_Widget* pChild = pFirst;
+  while (pChild) {
+    pChild = GetNextSiblingWidget(pChild);
+    ++iRet;
+  }
+  return iRet;
+}
