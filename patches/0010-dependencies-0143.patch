+void CFWL_WidgetMgr::AddRedrawCounts(CFWL_Widget* pWidget) {
+  GetWidgetMgrItem(pWidget)->iRedrawCounter++;
+}
+
+void CFWL_WidgetMgr::ResetRedrawCounts(CFWL_Widget* pWidget) {
+  GetWidgetMgrItem(pWidget)->iRedrawCounter = 0;
