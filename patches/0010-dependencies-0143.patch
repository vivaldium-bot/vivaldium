+	EnterCriticalSection(&(_tcb)->tcb_mtx);			\
+} while (0)
+
+#else
+#define SCTP_TCB_LOCK(_tcb)  do {					\
+	EnterCriticalSection(&(_tcb)->tcb_mtx);			\
+} while (0)
+#endif
