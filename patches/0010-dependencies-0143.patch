+CFWL_Widget::CFWL_Widget(const CFWL_App* app,
+                         std::unique_ptr<CFWL_WidgetProperties> properties,
+                         CFWL_Widget* pOuter)
+    : m_pOwnerApp(app),
+      m_pWidgetMgr(app->GetWidgetMgr()),
+      m_pProperties(std::move(properties)),
+      m_pOuter(pOuter),
+      m_iLock(0),
