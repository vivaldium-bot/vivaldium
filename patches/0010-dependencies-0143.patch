diff --git a/third_party/openh264/src/codec/api/svc/codec_api.h b/third_party/openh264/src/codec/api/svc/codec_api.h
new file mode 100644
index 0000000000000000000000000000000000000000..6ac6ae42308a61e86e7a6b94458b7ac8dc623436
--- /dev/null
+++ b/third_party/openh264/src/codec/api/svc/codec_api.h
@@ -0,0 +1,576 @@
+/*!
