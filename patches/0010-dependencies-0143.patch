index 0000000000000000000000000000000000000000..8d2317ea1527921f2eab196686aa82a758849aae
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_atom_pixeltransfer.c
@@ -0,0 +1,326 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
