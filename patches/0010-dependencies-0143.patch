+void CFDE_TextEditEngine::SetTabWidth(float width) {
+  int32_t old_tab_width = text_break_.GetTabWidth();
+  text_break_.SetTabWidth(width);
+  if (old_tab_width == text_break_.GetTabWidth())
+    return;
+
+  is_dirty_ = true;
