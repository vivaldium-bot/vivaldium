+        "src/ftrace_reader/test/data/" + std::string(GetParam()) + "/";
+    FtraceProcfs ftrace_procfs(path);
+    table_ =
+        ProtoTranslationTable::Create(&ftrace_procfs, GetStaticEventInfo());
