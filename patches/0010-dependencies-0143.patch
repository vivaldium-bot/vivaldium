+Optional<BC_TEXT_LOC> CXFA_Node::GetBarcodeAttribute_TextLocation() {
+  Optional<XFA_AttributeEnum> textLocation =
+      GetWidgetAcc()->GetUIChild()->JSObject()->TryEnum(
