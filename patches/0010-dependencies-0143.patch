+void CFDE_TextEditEngine::SetFont(RetainPtr<CFGAS_GEFont> font) {
+  if (font_ == font)
+    return;
+
+  font_ = font;
+  text_break_.SetFont(font_);
+  is_dirty_ = true;
+}
+
+void CFDE_TextEditEngine::SetFontSize(float size) {
+  if (font_size_ == size)
+    return;
+
+  font_size_ = size;
+  text_break_.SetFontSize(font_size_);
+  is_dirty_ = true;
+}
