+const char *opj_j2k_convert_progression_order(OPJ_PROG_ORDER prg_order)
+{
+    const j2k_prog_order_t *po;
+    for (po = j2k_prog_order_list; po->enum_prog != -1; po++) {
+        if (po->enum_prog == prg_order) {
+            return po->str_prog;
+        }
+    }
+    return po->str_prog;
+}
