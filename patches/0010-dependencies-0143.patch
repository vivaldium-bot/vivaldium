diff --git a/third_party/mesa/src/src/mesa/program/prog_opt_constant_fold.c b/third_party/mesa/src/src/mesa/program/prog_opt_constant_fold.c
new file mode 100644
index 0000000000000000000000000000000000000000..e2418b554512373d61457970baef28bc31e3e1d0
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/program/prog_opt_constant_fold.c
@@ -0,0 +1,451 @@
+/*
