+  int32_t NodeAcc_TraverseAnySiblings(CXFA_Node* parent,
+                                      uint32_t dNameHash,
+                                      CXFA_NodeArray* pSiblings,
+                                      bool bIsClassName = false);
+  int32_t CountSiblings(CXFA_Node* pNode,
+                        XFA_LOGIC_TYPE eLogicType,
