diff --git a/third_party/trace-viewer/tracing/tracing/ui/base/polymer_utils.html b/third_party/trace-viewer/tracing/tracing/ui/base/polymer_utils.html
new file mode 100644
index 0000000000000000000000000000000000000000..e8e74475d83fc7085727b74ddaf7618cc22b0dcc
--- /dev/null
+++ b/third_party/trace-viewer/tracing/tracing/ui/base/polymer_utils.html
@@ -0,0 +1,87 @@
+<!DOCTYPE html>
+<!--
+Copyright (c) 2013 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+<link rel="import" href="/base/base.html">
+
+<script>
+'use strict';
+
+/**
+ * @fileoverview Helper code for working with Polymer.
+ */
