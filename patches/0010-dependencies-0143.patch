+                          CFDE_XMLNode* pXMLDoc,
+                          XFA_XDPPACKET ePacketID,
+                          bool bUseAttribute);
+  CXFA_Node* DataLoader(CXFA_Node* pXFANode,
+                        CFDE_XMLNode* pXMLDoc,
