+  CFX_RectF rtArc = GetRectWithoutRotate();
+  if (CXFA_Margin mgWidget = m_pDataAcc->GetMargin())
+    XFA_RectWidthoutMargin(rtArc, mgWidget);
+
+  DrawBorder(pGS, arcObj, rtArc, &mtRotate);
+}
