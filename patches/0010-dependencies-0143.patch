index 0000000000000000000000000000000000000000..4ed7b94c7bf0831665a20b1d9e7a505dfedf0d23
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_context.c
@@ -0,0 +1,954 @@
+/*
