+static const FX_DOUBLE fraction_scales[] = {0.1,
+                                            0.01,
+                                            0.001,
+                                            0.0001,
+                                            0.00001,
+                                            0.000001,
+                                            0.0000001,
+                                            0.00000001,
+                                            0.000000001,
+                                            0.0000000001,
+                                            0.00000000001,
+                                            0.000000000001,
+                                            0.0000000000001,
+                                            0.00000000000001,
+                                            0.000000000000001,
+                                            0.0000000000000001};
+CXFA_LocaleValue::CXFA_LocaleValue() {
