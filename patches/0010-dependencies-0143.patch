+CFWL_Widget* CFWL_WidgetMgr::GetRadioButtonGroupHeader(
+    CFWL_Widget* pRadioButton) const {
+  CFWL_Widget* pNext = pRadioButton;
+  if (pNext && (pNext->GetStyles() & FWL_WGTSTYLE_Group))
+    return pNext;
+  return nullptr;
