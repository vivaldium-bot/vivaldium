+static __inline__ int
+copy_to_user(void *dst, void *src, int len) {
+	memcpy(dst, src, len);
+	return 0;
+}
+
+static __inline__ int
+copy_from_user(void *dst, void *src, int len) {
+	memcpy(dst, src, len);
+	return 0;
