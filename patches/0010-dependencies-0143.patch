+CFX_RectF CFWL_Widget::GetEdgeRect() {
+  CFX_RectF rtEdge(0, 0, m_pProperties->m_rtWidget.width,
+                   m_pProperties->m_rtWidget.height);
+  if (HasBorder()) {
+    float fCX = GetBorderSize(true);
+    float fCY = GetBorderSize(false);
+    rtEdge.Deflate(fCX, fCY);
+  }
