+  if (pArguments->GetInt32(0) != 0)
+    return;
+
+  pNotify->ExecEventByDeepFirst(this, XFA_EVENT_Calculate);
+  pNotify->ExecEventByDeepFirst(this, XFA_EVENT_Validate);
+  pNotify->ExecEventByDeepFirst(this, XFA_EVENT_Ready, true);
+}
