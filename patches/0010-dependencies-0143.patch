+
+CFWL_WidgetMgr::Item* CFWL_WidgetMgr::GetWidgetMgrItem(
+    CFWL_Widget* pWidget) const {
+  auto it = m_mapWidgetItem.find(pWidget);
+  return it != m_mapWidgetItem.end() ? static_cast<Item*>(it->second.get())
+                                     : nullptr;
