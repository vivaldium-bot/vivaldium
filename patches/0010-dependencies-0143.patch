+    default: {
+      CFX_WideString wsTestPattern;
+      wsTestPattern = L"num{" + wsPattern + L"}";
+      CXFA_LocaleValue localeValue(XFA_VT_FLOAT, wsValue, wsTestPattern,
+                                   pLocale, pMgr);
