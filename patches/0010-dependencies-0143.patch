+    return;
+  }
+
+  CFX_WideString content = GetScriptContent(true);
+  if (content.IsEmpty()) {
+    pValue->SetNull();
+    return;
+  }
+  pValue->SetString(content.UTF8Encode().AsStringC());
+}
