diff --git a/v8/test/debugger/debug/debug-receiver.js b/v8/test/debugger/debug/debug-receiver.js
new file mode 100644
index 0000000000000000000000000000000000000000..9096e315f6e23f4cba6efa1543992bc34e93225f
--- /dev/null
+++ b/v8/test/debugger/debug/debug-receiver.js
@@ -0,0 +1,122 @@
+// Copyright 2011 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
