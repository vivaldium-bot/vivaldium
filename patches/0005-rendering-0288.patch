+      CHECK(v8::Locker::IsLocked(isolate2_));
+      v8::Context::Scope context_scope(context2);
+      thread->Start();
+      CalcFibAndCheck(context2);
+      thread->Join();
+    }
+  }
+
+ private:
+  v8::Isolate* isolate1_;
+  v8::Isolate* isolate2_;
+};
