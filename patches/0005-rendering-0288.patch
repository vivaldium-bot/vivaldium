-          // root is the same and is sqrt(a1^2/4 + |d|/4)
-          let d = Math.sqrt(-discriminant);
-          return Math.hypot(a1 / 2, d / 2);
-        } else {
-          // Real roots
-          let d = Math.sqrt(discriminant);
