+bool String::ComputeArrayIndex(uint32_t* index) {
+  int length = this->length();
+  if (length == 0 || length > kMaxArrayIndexSize) return false;
+  StringCharacterStream stream(this);
+  return StringToArrayIndex(&stream, index);
+}
