+    for (int i = 0; i < count; i++) {
+      byte val = static_cast<byte>(count * 10 + i);
+      code[i * 3] = kExprI32Const;
+      code[i * 3 + 1] = val;
+      if (i == (count - 1)) {
+        code[i * 3 + 2] = kExprNop;
+        expected = val;
+      } else {
+        code[i * 3 + 2] = kExprDrop;
