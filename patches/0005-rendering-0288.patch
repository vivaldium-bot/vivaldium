-      // Apply an IIRFilter to the given input signal.
-      //
-      // IIR filter in the time domain is
-      //
-      //   y[n] = sum(ff[k]*x[n-k], k, 0, M) - sum(fb[k]*y[n-k], k, 1, N)
-      //
-      function iirFilter(input, feedforward, feedback) {
