-  success =
-      success && checkTail1(renderedData, referenceData, breakpoint, should);
-
-  success =
-      success && checkTail2(renderedData, referenceData, breakpoint, should);
-
-  should(success, 'Test signal convolved').message('correctly', 'incorrectly');
-}
