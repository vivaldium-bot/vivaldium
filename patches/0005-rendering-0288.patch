+  FOR_FLOAT32_INPUTS(i) {
+    if (*i<upper_bound&& * i> lower_bound) {
+      CHECK_EQ(static_cast<uint32_t>(*i), r.Call(*i));
+    } else {
+      CHECK_TRAP32(r.Call(*i));
+    }
+  }
+}
