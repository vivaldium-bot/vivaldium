+void WasmCompiledModule::ResetSpecializationMemInfoIfNeeded() {
+  DisallowHeapAllocation no_gc;
+  if (has_embedded_mem_start()) {
+    set_embedded_mem_size(default_mem_size());
+    set_embedded_mem_start(0);
+  }
