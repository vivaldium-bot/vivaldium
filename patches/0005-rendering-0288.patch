+      PreParserExpression cond, PreParserStatement next,
+      PreParserStatement body, const SourceRange& body_range,
+      Scope* inner_scope, const ForInfo& for_info, bool* ok) {
+    // See Parser::DesugarLexicalBindingsInForStatement.
