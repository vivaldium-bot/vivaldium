+void JSGlobalObject::InvalidatePropertyCell(Handle<JSGlobalObject> global,
+                                            Handle<Name> name) {
+  DCHECK(!global->HasFastProperties());
+  auto dictionary = handle(global->global_dictionary());
+  int entry = dictionary->FindEntry(name);
