-      .beTrue();
-
-  return isZero;
-}
-
-function checkConvolvedResult(renderedBuffer, trianglePulse, should) {
-  let referenceData = trianglePulse.getChannelData(0);
-  let renderedData = renderedBuffer.getChannelData(0);
