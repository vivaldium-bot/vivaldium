+void MacroAssembler::SmiAndConstant(Register dst, Register src, Smi* constant) {
+  if (constant->value() == 0) {
+    Set(dst, 0);
+  } else if (dst.is(src)) {
+    DCHECK(!dst.is(kScratchRegister));
+    Register constant_reg = GetSmiConstant(constant);
+    andp(dst, constant_reg);
+  } else {
+    Move(dst, constant);
+    andp(dst, src);
+  }
+}
