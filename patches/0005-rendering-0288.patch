+
+  // [debug info]: Debug information.
+  DECL_ACCESSORS(debug_info, Object)
+
+  // PreParsedScopeData or null.
+  DECL_ACCESSORS(preparsed_scope_data, Object)
+
+  inline bool HasPreParsedScopeData() const;
+
