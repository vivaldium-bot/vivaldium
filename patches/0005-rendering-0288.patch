+
+var f = null;
+var i = null;
+function listener(event, exec_state, event_data, data) {
+  try {
+    if (event == Debug.DebugEvent.Break) {
+      var frameMirror = exec_state.frame(0);
+
+      var i = frameMirror.evaluate('f = function() { i = 5; }, f(), i').value();
