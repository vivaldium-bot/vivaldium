+    Script* script = NULL;
+    while ((script = iterator.Next()) != NULL) {
+      if (!script->name()->IsString()) continue;
+      String* name = String::cast(script->name());
+      if (name->Equals(*script_name)) {
+        found = Handle<Script>(script, isolate);
+        break;
