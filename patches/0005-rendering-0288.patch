+  __ str(r1, MemOperand(sp, 0 * kPointerSize));
+  __ mov(r2, Operand(-1));
+  __ Store(r2, MemOperand(sp, 0 * kPointerSize), Representation::Integer8());
+  __ ldr(r3, MemOperand(sp, 0 * kPointerSize));
+  __ mov(r2, Operand(255));
