+void MacroAssembler::Cmp(Register dst, Handle<Object> source) {
+  AllowDeferredHandleDereference smi_check;
+  if (source->IsSmi()) {
+    Cmp(dst, Smi::cast(*source));
+  } else {
+    Move(kScratchRegister, Handle<HeapObject>::cast(source));
+    cmpp(dst, kScratchRegister);
+  }
+}
