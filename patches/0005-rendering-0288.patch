+static const int kNoCodeAgeSequenceLength = 9 * Assembler::kInstrSize;
+
+Handle<Code> RelocInfo::code_age_stub_handle(Assembler* origin) {
+  UNREACHABLE();  // This should never be reached on Arm.
+  return Handle<Code>();
+}
