+
+void MacroAssembler::SmiAnd(Register dst, Register src1, Register src2) {
+  DCHECK(!dst.is(src2));
+  if (!dst.is(src1)) {
+    movp(dst, src1);
+  }
+  andp(dst, src2);
+}
