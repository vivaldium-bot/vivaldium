+  // Layout descriptors should not be shared with |split_map|.
+  CHECK(map2->owns_descriptors());
+  CHECK_NE(*split_layout_descriptor, map2->layout_descriptor());
+  CHECK(map2->layout_descriptor()->IsConsistentWithMap(*map2, true));
