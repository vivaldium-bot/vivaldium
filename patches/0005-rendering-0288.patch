+TEST(ParseNumbers) {
+  CheckParsesToNumber("1.");
+  CheckParsesToNumber("1.34");
+  CheckParsesToNumber("134");
+  CheckParsesToNumber("134e44");
+  CheckParsesToNumber("134.e44");
+  CheckParsesToNumber("134.44e44");
+  CheckParsesToNumber(".44");
+
+  CheckParsesToNumber("-1.");
+  CheckParsesToNumber("-1.0");
+  CheckParsesToNumber("-1.34");
+  CheckParsesToNumber("-134");
+  CheckParsesToNumber("-134e44");
+  CheckParsesToNumber("-134.e44");
+  CheckParsesToNumber("-134.44e44");
+  CheckParsesToNumber("-.44");
+}
