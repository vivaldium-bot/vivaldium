+const int HeapEntry::kNoEntry = -1;
+
+HeapEntry::HeapEntry(HeapSnapshot* snapshot,
+                     Type type,
+                     const char* name,
+                     SnapshotObjectId id,
+                     size_t self_size,
+                     unsigned trace_node_id)
+    : type_(type),
+      children_count_(0),
+      children_index_(-1),
+      self_size_(self_size),
+      snapshot_(snapshot),
+      name_(name),
+      id_(id),
+      trace_node_id_(trace_node_id) { }
