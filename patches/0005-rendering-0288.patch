+
+#ifndef V8_PROFILER_CPU_PROFILER_H_
+#define V8_PROFILER_CPU_PROFILER_H_
+
+#include <memory>
+
+#include "src/allocation.h"
+#include "src/base/atomic-utils.h"
+#include "src/base/atomicops.h"
