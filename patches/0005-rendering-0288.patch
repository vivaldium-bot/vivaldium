+void TurboAssembler::Ret(int bytes_dropped, Register scratch) {
+  if (is_uint16(bytes_dropped)) {
+    ret(bytes_dropped);
+  } else {
+    PopReturnAddressTo(scratch);
+    addp(rsp, Immediate(bytes_dropped));
+    PushReturnAddressFrom(scratch);
+    ret(0);
+  }
+}
