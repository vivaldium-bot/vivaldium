-        for (let k = 0; k < frequencies.length; ++k) {
-          let omega = frequencyScale * frequencies[k];
-          trueMag[k] = 1 / Math.sqrt(1.81 - 1.8 * Math.cos(omega));
-          truePhase[k] =
