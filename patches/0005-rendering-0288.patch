-//
-// Create an FFT object of order |order|.  This will
-// compute forward and inverse FFTs of length 2^|order|.
-function FFT(order) {
-  if (order <= 1) {
-    throw new this.FFTException(order);
-  }
-
-  this.order = order;
-  this.N = 1 << order;
-  this.halfN = 1 << (order - 1);
