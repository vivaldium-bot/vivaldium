+// found in the LICENSE file.
+
+#include <unordered_map>
+
+#include "src/assembler-inl.h"
+#include "src/assert-scope.h"
+#include "src/compiler/wasm-compiler.h"
+#include "src/debug/debug-scopes.h"
+#include "src/debug/debug.h"
