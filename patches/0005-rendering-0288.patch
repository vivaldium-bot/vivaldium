+// Calculate 10^exponent.
+inline int TenToThe(int exponent) {
+  DCHECK(exponent <= 9);
+  DCHECK(exponent >= 1);
+  int answer = 10;
+  for (int i = 1; i < exponent; i++) answer *= 10;
+  return answer;
+}
