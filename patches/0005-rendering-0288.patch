-        let denProduct = [
-          1, f2Coef.a1 + f1Coef.a1,
-          f2Coef.a2 + f1Coef.a1 * f2Coef.a1 + f1Coef.a2,
-          f1Coef.a1 * f2Coef.a2 + f1Coef.a2 * f2Coef.a1, f1Coef.a2 * f2Coef.a2
