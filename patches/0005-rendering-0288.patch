+    }
+    case MINA:
+      DCHECK(kArchVariant == kMips64r6);
+      SetFPUDoubleResult(fd_reg(), FPUMinA(ft, fs));
+      break;
+    case MAXA:
+      DCHECK(kArchVariant == kMips64r6);
+      SetFPUDoubleResult(fd_reg(), FPUMaxA(ft, fs));
+      break;
+    case MIN:
+      DCHECK(kArchVariant == kMips64r6);
+      SetFPUDoubleResult(fd_reg(), FPUMin(ft, fs));
+      break;
+    case MAX:
+      DCHECK(kArchVariant == kMips64r6);
+      SetFPUDoubleResult(fd_reg(), FPUMax(ft, fs));
+      break;
