+class ScopeCallsEvalField : public BitField<bool, 0, 1> {};
+class InnerScopeCallsEvalField
+    : public BitField<bool, ScopeCallsEvalField::kNext, 1> {};
+
+class VariableIsUsedField : public BitField16<bool, 0, 1> {};
