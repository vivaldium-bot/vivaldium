+  }
+  DCHECK(cc >= 0);
+  EnsureSpace ensure_space(this);
+  // Opcode: REX.W 0f 40 + cc /r.
+  emit_rex_64(dst, src);
+  emit(0x0f);
+  emit(0x40 + cc);
+  emit_operand(dst, src);
+}
