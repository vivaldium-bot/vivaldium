+    AdjustBaseAndOffset(source);                                 \
+    if (is_int10(source.offset())) {                             \
+      GenInstrMsaMI10(opcode, source.offset(), source.rm(), wd); \
+    } else {                                                     \
+      DCHECK(!rs.rm().is(at));                                   \
+      addiu(at, source.rm(), source.offset());                   \
+      GenInstrMsaMI10(opcode, 0, at, wd);                        \
+    }                                                            \
+  }
