+
+class LoopingJsThread : public LoopingThread {
+ public:
+  explicit LoopingJsThread(v8::internal::Isolate* isolate)
+      : LoopingThread(isolate) { }
+  void RunLoop() {
+    v8::Locker locker;
+    CHECK(CcTest::i_isolate() != NULL);
+    CHECK_GT(CcTest::i_isolate()->thread_manager()->CurrentId(), 0);
+    SetV8ThreadId();
