+void Decoder::DecodeTypeRegisterSPECIAL2(Instruction* instr) {
+  switch (instr->FunctionFieldRaw()) {
+    case MUL:
+      Format(instr, "mul     'rd, 'rs, 'rt");
+      break;
+    case CLZ:
+      if (kArchVariant != kMips64r6) {
+        Format(instr, "clz     'rd, 'rs");
+      }
+      break;
+    case DCLZ:
+      if (kArchVariant != kMips64r6) {
