+
+void Object::Print(std::ostream& os) {  // NOLINT
+  if (IsSmi()) {
+    os << "Smi: " << std::hex << "0x" << Smi::ToInt(this);
+    os << std::dec << " (" << Smi::ToInt(this) << ")\n";
+  } else {
+    HeapObject::cast(this)->HeapObjectPrint(os);
+  }
+}
