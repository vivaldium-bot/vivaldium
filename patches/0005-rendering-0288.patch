+BeginTest('Test 1');
+shouldBreak = function(x) { return x == 3; };
+fact(3);
+EndTest(2);
+
+BeginTest('Test 2');
+shouldBreak = function(x) { return x == 2; };
+fact(3);
+EndTest(3);
+
+BeginTest('Test 3');
+shouldBreak = function(x) { return x == 1; };
+fact(3);
+EndTest(4);
+
+BeginTest('Test 4');
+shouldBreak = function(x) { return x == 1 || x == 3; };
+fact(3);
+EndTest(5);
+
+// Get rid of the debug event listener.
+Debug.setListener(null);
