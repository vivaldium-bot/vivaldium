+  void Assembler::fill_##format(MSARegister wd, Register rs) {        \
+    DCHECK((kArchVariant == kMips64r6) && IsEnabled(MIPS_SIMD));      \
+    DCHECK(rs.is_valid() && wd.is_valid());                           \
