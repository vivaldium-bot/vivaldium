+void RegExpMacroAssemblerMIPS::IfRegisterGE(int reg,
+                                            int comparand,
+                                            Label* if_ge) {
+  __ Ld(a0, register_location(reg));
+  BranchOrBacktrack(if_ge, ge, a0, Operand(comparand));
+}
