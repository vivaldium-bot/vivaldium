+void MacroAssembler::Cmp(Register dst, Smi* src) {
+  DCHECK(!dst.is(kScratchRegister));
+  if (src->value() == 0) {
+    testp(dst, dst);
+  } else {
+    Register constant_reg = GetSmiConstant(src);
+    cmpp(dst, constant_reg);
+  }
+}
