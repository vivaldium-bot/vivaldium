-<script>
-'use strict';
-
-function prepareDOMTree(parent, delegatesFocus)
-{
-    parent.innerHTML = '';
-    let host = document.createElement('div');
-    host.id = 'shadowHost';
-    host.setAttribute('tabindex', '0');
-    var root = host.attachShadow({mode: 'open', delegatesFocus: delegatesFocus});
