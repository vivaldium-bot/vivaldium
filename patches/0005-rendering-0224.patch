-    let shadowRoot;
-    if (template.getAttribute('data-mode') === 'v0') {
-      // For legacy Shadow DOM
-      shadowRoot = parent.createShadowRoot();
-    } else {
-      shadowRoot = parent.attachShadow({mode: template.getAttribute('data-mode')});
-    }
-    let id = template.id;
