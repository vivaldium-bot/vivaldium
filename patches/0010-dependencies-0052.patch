+private:
+	bool checkTextureState (glu::CallLogWrapper& gl, const TextureGenerationSpec& spec)
+	{
+		const int queryLevel	= (spec.levels.empty()) ? (0) : (spec.levels[0].level);
+		const int refValue		= (spec.levels.empty()) ? (0) : (spec.sampleCount);
