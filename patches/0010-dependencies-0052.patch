+								   const VariableP<typename Sig::Arg1>&	arg1,
+								   const VariableP<typename Sig::Arg2>&	arg2,
+								   const VariableP<typename Sig::Arg3>&	arg3)
+{
+	return exprP(new ApplyVar<Sig>(func, arg0, arg1, arg2, arg3));
