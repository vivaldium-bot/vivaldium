+enum MemObjectType
+{
+	MEMOBJECTTYPE_TEXTURE = (1 << 0),
+	MEMOBJECTTYPE_BUFFER = (1 << 1),
+
+	MEMOBJECTTYPE_LAST
+};
+
+struct MemObjectConfig
+{
+	int minBufferSize;
+	int maxBufferSize;
+
+	int minTextureSize;
+	int maxTextureSize;
+
+	bool useDummyData;
+	bool write;
+	bool use;
+};
+
+class MemoryStressCase : public tcu::TestCase
+{
+public:
