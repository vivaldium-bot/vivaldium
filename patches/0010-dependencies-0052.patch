+bool ProgramType::isDeleteFlagged (GLuint name)
+{
+	GLint deleteFlagged = 0;
+	glGetProgramiv(name, GL_DELETE_STATUS, &deleteFlagged);
+	return deleteFlagged != 0;
+}
