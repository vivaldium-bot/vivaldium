+int computeTextureCompareDiff (const tcu::ConstPixelBufferAccess&	result,
+							   const tcu::ConstPixelBufferAccess&	reference,
+							   const tcu::PixelBufferAccess&		errorMask,
+							   const tcu::TextureCubeView&			src,
