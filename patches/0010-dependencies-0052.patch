+
+    const sel = new tr.model.EventSet();
+    sel.push(model.ir1);
+    sel.push(model.s1);
+    sel.push(model.s2);
+
+    assert.strictEqual(
+        CompoundEventSelectionState.EVENT_AND_ALL_ASSOCIATED_SELECTED,
+        model.ir1.computeCompoundEvenSelectionState(sel));
