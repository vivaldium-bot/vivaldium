+      }
+    ];
+    this.sample = undefined;
+  },
+
+  get sample() {
+    return this.sample_;
+  },
+
+  set sample(sample) {
+    this.sample_ = sample;
+    this.updateContents_();
+  },
+
+  updateContents_() {
+    if (this.sample === undefined) {
+      this.$.table.tableRows = [];
+    } else {
+      this.$.table.tableRows = [this.sample];
+    }
+    this.$.table.rebuild();
+  }
+});
