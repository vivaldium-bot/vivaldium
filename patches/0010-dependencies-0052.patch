+void ShaderInterface::getNamedStructs (std::vector<const StructType*>& structs) const
+{
+	for (std::vector<StructType*>::const_iterator i = m_structs.begin(); i != m_structs.end(); i++)
+	{
+		if ((*i)->getTypeName() != DE_NULL)
+			structs.push_back(*i);
+	}
+}
