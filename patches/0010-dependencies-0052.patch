+class QueryBinder : public Binder
+{
+public:
+						QueryBinder		(Context& ctx) : Binder(ctx) {}
+	void				bind			(GLuint name)
+	{
+		if (name != 0)
+			glBeginQuery(GL_ANY_SAMPLES_PASSED, name);
+		else
+			glEndQuery(GL_ANY_SAMPLES_PASSED);
+	}
+	GLuint				getBinding		(void) { return 0; }
+};
