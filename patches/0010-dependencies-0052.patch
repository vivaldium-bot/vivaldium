+int UniformLayout::getUniformIndex (const char* name) const
+{
+	for (int ndx = 0; ndx < (int)uniforms.size(); ndx++)
+	{
+		if (uniforms[ndx].name == name)
+			return ndx;
+	}
+	return -1;
+}
