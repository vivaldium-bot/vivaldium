+			float	xf		= ((float)x + 0.5f) / (float)dst.getWidth();
+
+			int		triNdx	= xf + yf >= 1.0f ? 1 : 0; // Top left fill rule.
+			float	triX	= triNdx ? 1.0f-xf : xf;
