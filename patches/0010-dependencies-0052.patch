+        for (const id in rawStackFrames) {
+          const node = this.stackFrameTree_.getNode('g' + id);
+          const parentId = node.parentId;
+          let parentNode = undefined;
+          if (parentId !== undefined) {
+            parentNode = this.stackFrameTree_.getNode('g' + parentId);
