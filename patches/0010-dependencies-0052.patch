index 0000000000000000000000000000000000000000..b564d3eb06430eb9fe30dd73703f86fd8817c204
--- /dev/null
+++ b/third_party/cld_2/src/internal/cld2_dynamic_data_tool.cc
@@ -0,0 +1,184 @@
+// Copyright 2014 Google Inc. All Rights Reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
