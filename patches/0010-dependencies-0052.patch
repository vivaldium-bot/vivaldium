+def indentTextBlock(text, indent):
+	indentStr = indent * "\t"
+	lines = text.split("\n")
+	lines = [indentStr + line for line in lines]
+	lines = [ ["", line][line.strip() != ""] for line in lines]
+	return "\n".join(lines)
