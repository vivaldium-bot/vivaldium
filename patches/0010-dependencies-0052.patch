+		DE_ASSERT(DE_FALSE);
+
+	buf << "layout(binding=0, std430) buffer ResultBuffer\n"
+		<< "{\n"
+		<< "	highp int resultOk[];\n"
+		<< "} sb_result;\n"
+		<< "\n"
+		<< "void main (void)\n"
