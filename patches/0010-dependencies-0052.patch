+      }
+      this.isYLogScale_ = logScale;
+    },
+
+    getYScaleMin_() {
+      return this.isYLogScale_ ? this.yLogScaleMin_ : 0;
+    },
+
+    getYScaleDomain_(minValue, maxValue) {
+      if (this.overrideDataRange_ !== undefined) {
+        return [this.dataRange.min, this.dataRange.max];
+      }
