+										 BindFunc bindFunc,
+										 GLenum bindTarget,
+										 GLenum bindingParam,
+										 bool genRequired_ = false)
+							: Binder			(ctx)
+							, m_bindFunc		(bindFunc)
+							, m_bindTarget		(bindTarget)
+							, m_bindingParam	(bindingParam)
+							, m_genRequired		(genRequired_) {}
+
+	void				bind			(GLuint name);
+	GLuint				getBinding		(void);
+	bool				genRequired		(void) const { return m_genRequired; }
