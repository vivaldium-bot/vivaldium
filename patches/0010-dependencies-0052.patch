+class FuncCaseFactory : public CaseFactory
+{
+public:
+	virtual const FuncBase&	getFunc		(void) const = 0;
+
+	string					getName		(void) const
+	{
+		return de::toLower(getFunc().getName());
+	}
+
+	string					getDesc		(void) const
+	{
+		return "Function '" + getFunc().getName() + "'";
+	}
+};
