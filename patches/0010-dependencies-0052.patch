+      let objectTypeNamePrefix = undefined;
+      let objectTypeNameSuffix = undefined;
+      const objectTypeNameMap = {};
+      for (const objectTypeId in rawObjectTypeNameMap) {
+        const rawObjectTypeName = rawObjectTypeNameMap[objectTypeId];
