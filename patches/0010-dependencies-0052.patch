+
+    assert.strictEqual(
+        CompoundEventSelectionState.ALL_ASSOCIATED_EVENTS_SELECTED,
+        model.ir1.computeCompoundEvenSelectionState(sel));
+  });
+
+  test('directAndAllAssociated', function() {
