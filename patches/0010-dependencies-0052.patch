+      return {
+        typeName: 'xmarker',
+        args: {
+          timestamp: this.timestamp
+        }
+      };
+    },
+
+    createView_(viewport) {
+      return new tr.ui.annotations.XMarkerAnnotationView(viewport, this);
+    }
+  };
+
+  tr.model.Annotation.register(
+      XMarkerAnnotation, {typeName: 'xmarker'});
+
+  return {
+    XMarkerAnnotation,
+  };
+});
+</script>
