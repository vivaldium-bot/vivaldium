+
+			m_testCtx.setTestResult(numFailed == 0 ? QP_TEST_RESULT_PASS	: QP_TEST_RESULT_FAIL,
+									numFailed == 0 ? "Pass"					: "Result comparison failed");
+		}
+
+		return STOP;
+	}
