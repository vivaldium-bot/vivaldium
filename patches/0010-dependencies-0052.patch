+TextureSamplerTest::TextureSamplerTest (tcu::TestContext& testCtx, glu::RenderContext& renderCtx, const TestSpec& spec)
+	: tcu::TestCase		(testCtx, spec.name, spec.desc)
+	, m_renderCtx		(renderCtx)
