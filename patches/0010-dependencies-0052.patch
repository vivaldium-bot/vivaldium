+  def component(self):
+    return self._component
+
+  def _AsDictInto(self, dct):
+    dct['emails'] = self.emails
+
+    if self.component is not None:
+      dct['component'] = self.component
+
+  @staticmethod
+  def FromDict(dct):
+    return Ownership(dct.get('emails'), dct.get('component'))
