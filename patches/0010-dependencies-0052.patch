+int UniformLayout::getBlockIndex (const char* name) const
+{
+	for (int ndx = 0; ndx < (int)blocks.size(); ndx++)
+	{
+		if (blocks[ndx].name == name)
+			return ndx;
+	}
+	return -1;
+}
