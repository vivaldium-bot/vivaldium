+++ b/third_party/deqp/src/modules/glshared/glsFragmentOpUtil.cpp
@@ -0,0 +1,301 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL (ES) Module
+ * -----------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
+ *
