+	// unused channels (A in rgb, G in stencil etc.)
+	{
+		static const struct
+		{
+			const char*						name;
+			deUint32						format;
+			tcu::Sampler::DepthStencilMode	mode;
+		} formats[] =
+		{
+			{ "r8",										GL_R8,						tcu::Sampler::MODE_LAST		},
+			{ "rg8_snorm",								GL_RG8_SNORM,				tcu::Sampler::MODE_LAST		},
