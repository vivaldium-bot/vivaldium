+    Polymer.dom(titleEl).appendChild(instanceLinkEl);
+
+    Polymer.dom(titleEl).appendChild(document.createTextNode(' @ '));
+
+    Polymer.dom(titleEl).appendChild(tr.v.ui.createScalarSpan(snapshot.ts, {
