+  const options = new tr.b.ExtensionRegistryOptions(
+      tr.b.TYPE_BASED_REGISTRY_MODE);
+  options.mandatoryBaseClass = ObjectSnapshotView;
+  options.defaultMetadata = {
+    showInstances: true,
+    showInTrackView: true
+  };
+  tr.b.decorateExtensionRegistry(ObjectSnapshotView, options);
+
+  return {
+    ObjectSnapshotView,
+  };
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/ui/analysis/power_sample_summary_table.html b/third_party/catapult/tracing/tracing/ui/analysis/power_sample_summary_table.html
