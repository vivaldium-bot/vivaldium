+
+    const track = {};
+    const selection = new EventSet();
+    selection.push(i10);
+    selection.push(s10);
+    selection.push(s25);
+    selection.push(s40);
+
+    const analysisEl = document.createElement('tr-ui-a-multi-object-sub-view');
+    analysisEl.selection = selection;
