+    if (!curSelection.length || !tr.b.getOnlyElement(curSelection).title) {
+      return;
+    }
+
+    const selection = new tr.model.EventSet();
+    const filter = new tr.c.ExactTitleFilter(
+        tr.b.getOnlyElement(curSelection).title);
