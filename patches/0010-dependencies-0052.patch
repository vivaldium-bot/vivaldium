+        this.rootViewState_.sortColumnIndex];
+      if (sortColumn === undefined) return;
+      this.subRows_.sort(sortColumn.cmp);
+      if (this.rootViewState_.sortDescending) {
+        this.subRows_.reverse();
+      }
