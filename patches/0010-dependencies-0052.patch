+template <typename T>
+ExprP<typename T::Element> getComponent (const ExprP<T>& container, int ndx)
+{
+	DE_ASSERT(0 <= ndx && ndx < T::SIZE);
+	return app<GetComponent<T> >(container, constant(ndx));
+}
