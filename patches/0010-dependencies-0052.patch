+  test('heapDumpsPassThrough', function() {
+    const processMemoryDumps = createProcessMemoryDumps();
+    const heapDumps = processMemoryDumps.map(function(dump) {
+      if (dump === undefined) return undefined;
+      return new HeapDump(dump, 'v8');
