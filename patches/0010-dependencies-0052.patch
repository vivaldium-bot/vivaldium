+Context::Context (tcu::TestContext& testCtx)
+	: m_testCtx		(testCtx)
+	, m_renderCtx	(DE_NULL)
+	, m_contextInfo	(DE_NULL)
+{
+	if (m_testCtx.getCommandLine().getRunMode() == tcu::RUNMODE_EXECUTE)
+		createRenderContext();
+	else
+		m_renderCtx = new glu::DummyRenderContext();
+}
