+GLuint MultiTextureSamplerTest::createTexture (const glw::Functions& gl, GLenum target, int id)
+{
+	switch (target)
+	{
+		case GL_TEXTURE_2D:
+			return createTexture2D(gl, id);
+
+		case GL_TEXTURE_3D:
+			return createTexture3D(gl, id);
+
+		case GL_TEXTURE_CUBE_MAP:
+			return createTextureCube(gl, id);
+
+		default:
+			DE_ASSERT(false);
+			return (GLuint)-1;
+	}
+}
