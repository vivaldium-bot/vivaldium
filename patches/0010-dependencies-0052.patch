+	"-DDE_DEBUG=1",
+	"-DDE_COMPILER=1", # Is preprocessor buggy in recent cppcheck?
+	"-DDE_OS=1",
+	"-DDE_CPU=1",
+	"-DDE_PTR_SIZE=4",
+	"-DAB_COMPILER=1",
+	"-DAB_OS=1",
