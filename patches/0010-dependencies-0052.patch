+template <int Size>
+static tcu::Matrix<float, Size, Size> translationMat (const float v)
+{
+	tcu::Matrix<float, Size, Size>	res(1.0f);
+	tcu::Vector<float, Size>		col(v);
+	col[Size-1] = 1.0f;
+	res.setColumn(Size-1, col);
+	return res;
+}
