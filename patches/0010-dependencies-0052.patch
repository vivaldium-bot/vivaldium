+      return this.buildNumber_;
+    }
+
+    get logUri() {
+      return this.logUri_;
+    }
+
+    static fromDict(d) {
+      return new BuildbotInfo(d);
+    }
+
+    /**
+     * @param {!tr.v.Histogram} hist
+     * @return {(undefined|!tr.v.d.BuildbotInfo)}
+     */
+    static getFromHistogram(hist) {
+      return hist.diagnostics.get(tr.v.d.RESERVED_NAMES.BUILDBOT);
