+      const leftWidth = this.getXForDatum_(data[index], index) -
+        this.getXForDatum_(data[leftIndex], leftIndex);
+      const rightWidth = this.getXForDatum_(data[rightIndex], rightIndex) -
+        this.getXForDatum_(data[index], index);
