+	GLU_EXPECT_NO_ERROR(gl.getError(), "bind result buffer");
+
+	// calc
+	gl.dispatchCompute(m_invocationGridSize, m_invocationGridSize, 1);
+	GLU_EXPECT_NO_ERROR(gl.getError(), "dispatch read multi");
