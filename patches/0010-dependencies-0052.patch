+			m_testCtx.setTestResult(allLevelsOk ? QP_TEST_RESULT_PASS	: QP_TEST_RESULT_FAIL,
+									allLevelsOk ? "Pass"				: "Image comparison failed");
+		}
+
+		return STOP;
+	}
+
+private:
+	const deUint32 m_format;
+};
