+  }
+
+  function genericMatcher(callback, defined) {
+    return function(actualValues) {
+      assert.lengthOf(actualValues, defined.length);
+      for (let i = 0; i < defined.length; i++) {
+        const actualValue = actualValues[i];
+        if (defined[i]) {
