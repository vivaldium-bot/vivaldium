+		res.append("input %s = [ %s ];" % (name, " | ".join([str(v) for v in values]).lower()))
+	for (name, values) in outputs:
+		res.append("output %s = [ %s ];" % (name, " | ".join([str(v) for v in values]).lower()))
+	return ("\n".join(res))
