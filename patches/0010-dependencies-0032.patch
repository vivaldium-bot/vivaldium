+std::string SystemSnapshotMac::MachineDescription() const {
+  INITIALIZATION_STATE_DCHECK_VALID(initialized_);
+
+  std::string model;
+  std::string board_id;
+  MacModelAndBoard(&model, &board_id);
+
+  if (!model.empty()) {
+    if (!board_id.empty()) {
+      return base::StringPrintf("%s (%s)", model.c_str(), board_id.c_str());
+    }
+    return model;
+  }
+  if (!board_id.empty()) {
