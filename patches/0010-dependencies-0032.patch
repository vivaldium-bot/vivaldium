+def _ForceLoggingLevel(functor):
+  def inner(*args, **kwargs):
+    logger = logging.getLogger()
+    current = logger.getEffectiveLevel()
+    try:
+      logger.setLevel(logging.INFO)
+      return functor(*args, **kwargs)
+    finally:
+      logger.setLevel(current)
+  return inner
+
