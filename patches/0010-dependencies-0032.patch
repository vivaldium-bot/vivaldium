+  SS_COL_LATEST_UP = gdata_lib.PrepColNameForSS(COL_LATEST_UP)
+  SS_COL_TARGET = gdata_lib.PrepColNameForSS(COL_TARGET)
+
+  COLS = [
+      COL_PKG,
