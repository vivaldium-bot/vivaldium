+          # Invalid category.
+          continue
+        # Correct pkg.
+        pv = portage_util.SplitPV(pkg)
+        key = '%s/%s' % (cat, pv.package)
+        self.fake_packages.append((key, pv.version))
+    # Add contents to with/files-1.
+    osutils.WriteFile(
+        os.path.join(fake_pkgdb_path, 'with', 'files-1', 'CONTENTS'),
