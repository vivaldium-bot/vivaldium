+#if defined(ARCH_CPU_X86_FAMILY)
+
+TEST_F(SystemSnapshotMacTest, CPUX86SupportsDAZ) {
+  // All x86-family CPUs that Apple is known to have shipped should support DAZ.
+  EXPECT_TRUE(system_snapshot().CPUX86SupportsDAZ());
+}
