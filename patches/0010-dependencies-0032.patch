+#ifndef CRASHPAD_UTIL_MAC_SERVICE_MANAGEMENT_H_
+#define CRASHPAD_UTIL_MAC_SERVICE_MANAGEMENT_H_
+
+#include <CoreFoundation/CoreFoundation.h>
