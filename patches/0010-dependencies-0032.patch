+
+  FAKE, PUB_PRIV, PUB_PRIV_VARIANT, PUB_ONLY, PUB2_ONLY, PRIV_ONLY, BRICK = (
+      'fake!board', 'pub-priv-board', 'pub-priv-board_variant',
