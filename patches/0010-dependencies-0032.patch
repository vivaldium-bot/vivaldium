+  system_snapshot().OSVersion(&major, &minor, &bugfix, &build);
+
+  EXPECT_EQ(10, major);
+  EXPECT_EQ(MacOSXMinorVersion(), minor);
+  EXPECT_FALSE(build.empty());
+}
