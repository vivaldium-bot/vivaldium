+
+  def runTest(self):
+    """Simulate a single set of canary builds with database schema v28."""
+    metadatas = GetTestDataSeries(SERIES_1_TEST_DATA_PATH)
+    self.assertEqual(len(metadatas), 18, 'Did not load expected amount of '
