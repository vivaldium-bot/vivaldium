+           r'\xfe\xff\xff\xff'),
+      'sh4eb':
+          (r'\x7f\x45\x4c\x46\x01\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00'
+           r'\x00\x02\x00\x2a',
