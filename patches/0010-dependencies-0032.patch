+  parser.add_option('-v', '--verbose',
+    action='store_true', default=False,
+    help='Be verbose')
+  parser.add_option('--skip-non-elfs',
+    action='store_true', default=False,
+    help='Skip plain (non-ELF) files instead of warning')
