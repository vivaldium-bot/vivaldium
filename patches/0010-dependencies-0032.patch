+class ThreadSnapshotMac final : public ThreadSnapshot {
+ public:
+  ThreadSnapshotMac();
+  ~ThreadSnapshotMac() override;
+
+  //! \brief Initializes the object.
+  //!
+  //! \param[in] process_reader A ProcessReader for the task containing the
