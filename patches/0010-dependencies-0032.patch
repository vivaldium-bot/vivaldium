+  def __init__(self, rows, cols=None):
+    self.entry = []
+    for row in rows:
+      self.entry.append(SSRow(row, cols))
+
+
+class UploaderTest(cros_test_lib.MoxOutputTestCase):
+  """Test the functionality of upload_package_status.Uploader class."""
+
+  COL_PKG = 'Package'
+  COL_SLOT = 'Slot'
