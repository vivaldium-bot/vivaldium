+                       display=p, debug=options.debug)
+      except exceptions.ELFError as e:
+        if options.skip_non_elfs:
+          continue
+        # XXX: Ugly.  Should unify with _Action* somehow.
+        if options.dest is not None and options.copy_non_elfs:
+          if os.path.exists(p):
