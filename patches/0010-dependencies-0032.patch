+void MinidumpModuleCodeViewRecordPDB20Writer::SetTimestampAndAge(
+    time_t timestamp,
+    uint32_t age) {
+  DCHECK_EQ(state(), kStateMutable);
+
+  internal::MinidumpWriterUtil::AssignTimeT(&codeview_record()->timestamp,
+                                            timestamp);
+
+  codeview_record()->age = age;
