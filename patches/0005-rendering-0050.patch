-def seekable(fileobj):
-    """Attempt to use file.seek on given file, with fallbacks."""
-    try:
-        fileobj.seek(fileobj.tell())
-    except Exception:
-        return CStringIO(fileobj.read())
-    else:
-        return fileobj
