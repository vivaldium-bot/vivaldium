-        blobURL = URL.createObjectURL(blob),
-        client = new XMLHttpRequest
-  URL.revokeObjectURL(blobURL)
-  client.open("GET", blobURL)
-  client.onload = t.step_func(() => assert_unreached("Got unexpected load event"))
