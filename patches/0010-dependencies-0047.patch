+    const invSampleCount = 1.0 / samples.length;
+    const locations = [];
+    // For each location, stores the number of samples less than that location.
+    const countLess = [];
+    // For each location, stores the number of samples less than or equal to
+    // that location.
+    const countLessEqual = [];
+
