+      }));
+    });
+
+    const histograms = new tr.v.HistogramSet();
+    tr.metrics.v8.runtimeStatsMetric(histograms, model);
+    assert.strictEqual(histograms.length, 64);
+    assert.strictEqual(histograms.sourceHistograms.length, 38);
