+  @staticmethod
+  def FromDict(d):
+    result = RelatedHistogramBreakdown()
+    for name, guid in d['values'].iteritems():
+      result.Set(name, HistogramRef(guid))
+    if 'colorScheme' in d:
+      result._color_scheme = d['colorScheme']
+    return result
