+    // overshoot = max(countClosed(i, j)/N - length(i, j)) for all i < j,
+    // undershoot = min(countOpen(i, j)/N - length(i, j)) for all i < j,
+    // N = len(samples),
+    // countClosed(i, j) is the number of points between i and j
