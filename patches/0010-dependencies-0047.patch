+      '<idle>-0     [001] ..s3  1043.718832: cpufreq_interactive_notyet: ' +
+          'cpu=1 load=10 cur=700000 targ=200000\n',
+      '<idle>-0     [001] ..s3  1043.718832: cpufreq_interactive_notyet: ' +
+          'cpu=1 load=10 cur=700000 actual=1000000 targ=200000\n'
+    ];
+    const m = newModel(lines.join('\n'));
