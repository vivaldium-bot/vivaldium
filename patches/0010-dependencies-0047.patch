+
+      m.flowEvents.push(m.f1);
+      m.flowEvents.push(m.f2);
+      m.flowEvents.push(m.f3);
+      m.flowEvents.push(m.f4);
+      m.flowEvents.push(m.f5);
+      m.flowEvents.push(m.f6);
