+  });
+
+  test('maxExpectedQueueingTimeInSlidingWindow_taskLargerThanRange', () => {
+    assert.closeTo(100 / 100 * (1200 + 1100) / 2,
+        maxExpectedQueueingTimeInSlidingWindow(0, 1000, 100,
+            [{start: -200, end: 1200}]),
