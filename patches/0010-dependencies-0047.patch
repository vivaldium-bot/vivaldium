+      // Support Flow API v2.
+      if (event.bind_id) {
+        if (event.flow_in === undefined && event.flow_out === undefined) {
+          this.model_.importWarning({
+            type: 'flow_slice_parse_error',
+            message: 'Flow producer or consumer require flow_in or flow_out.'
+          });
+          return false;
+        }
+        return true;
+      }
+
+      return false;
