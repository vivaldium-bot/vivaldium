+  def testSerializationSize(self):
+    hist = histogram.Histogram('', 'unitless', self.TEST_BOUNDARIES)
+    d = hist.AsDict()
+    self.assertEqual(107, len(ToJSON(d)))
+    self.assertIsNone(d.get('allBins'))
