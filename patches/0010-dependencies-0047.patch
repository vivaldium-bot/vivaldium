+// Counts number of spaces; a little faster than one-at-a-time
+// Doesn't count odd bytes at end
+int CountSpaces4(const char* src, int src_len) {
+  int s_count = 0;
+  for (int i = 0; i < (src_len & ~3); i += 4) {
+    s_count += (src[i] == ' ');
+    s_count += (src[i+1] == ' ');
+    s_count += (src[i+2] == ' ');
+    s_count += (src[i+3] == ' ');
+  }
+  return s_count;
+}
