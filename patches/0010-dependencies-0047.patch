+        for (const key in object) {
+          const res = func.call(thisArg, object, key, object[key],
+              containingSnapshot);
+          if (res === null) continue;
+          if (res) {
+            iterObject(res, func, containingSnapshot, thisArg);
+          } else {
+            iterObject(object[key], func, containingSnapshot, thisArg);
+          }
