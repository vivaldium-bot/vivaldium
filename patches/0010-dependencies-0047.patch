+      });
+
+      it("fail on invalid pattern with some valid tokens", function(){
+
+        expect(compiling('foo/')).toThrow();
+      });
+
+      it("fail on unclosed duck clause", function(){
+
+        expect(compiling('{foo')).toThrow();
+      });
+
+      it("fail on token with capture alone", function(){
+
+        expect(compiling('foo$')).toThrow();
+      });
+    });
+
+  });
