+    let i = 0;
+    for (const elt of ary) {
+      ret = Math.max(ret, func.call(opt_this, elt, i++));
+    }
+    return ret;
+  };
+
+  Statistics.min = function(ary, opt_func, opt_this) {
+    const func = opt_func || identity;
+    let ret = Infinity;
+    let i = 0;
+    for (const elt of ary) {
+      ret = Math.min(ret, func.call(opt_this, elt, i++));
+    }
