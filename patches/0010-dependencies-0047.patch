+      // Populate locations with sample positions. Append 0 and 1 if necessary.
+      if (samples[0] > 0.0) {
+        locations.push(0.0);
+        countLess.push(0);
+        countLessEqual.push(0);
+      }
+      for (let i = 0; i < samples.length; i++) {
+        locations.push(samples[i]);
+        countLess.push(i);
+        countLessEqual.push(i + 1);
+      }
