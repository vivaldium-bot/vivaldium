+      // Support Flow API v1.
+      if (event.ph === 's' || event.ph === 'f' || event.ph === 't') {
+        if (event.id === undefined) {
+          this.model_.importWarning({
+            type: 'flow_slice_parse_error',
+            message: 'Flow events (ph: s, t or f) require an id parameter.'
+          });
+          return false;
+        }
+        return true;
+      }
