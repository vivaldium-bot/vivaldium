+      // ends at location (i-1).
+      const countClosedIncrement =
+          countLessEqual[i] - countLessEqual[i - 1];
+      // Number of points that are added if we extend an open range that
+      // ends at location (i-1).
+      const countOpenIncrement = countLess[i] - countLess[i - 1];
