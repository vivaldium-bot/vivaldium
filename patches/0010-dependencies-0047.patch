+               testJson.animals.mammals,
+               testJson.animals.mammals.humans
+            ]
+         );
+       });
+
+
+
+// ----------- end of tests -----------
+
+   var bus, matches, jsonPathCompiler;
+
+   beforeEach(function(){
+
+      matches = {};
+
+      bus = spiedPubSub();
+
+      jsonPathCompiler = jasmine.createSpy('jsonPathCompiler').and.callFake(
