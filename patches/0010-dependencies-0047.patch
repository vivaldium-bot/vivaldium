+  });
+
+  test('maxExpectedQueueingTimeInSlidingWindow_emptyWindowThrows', () => {
+    assert.throws(() => maxExpectedQueueingTimeInSlidingWindow(0, 10, 0,
+        [{start: 0, end: 100}]),
+        'The window size must be positive number'
