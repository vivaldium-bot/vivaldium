+          ,  {key:'alphabet', node:['a']                 }
+          ,  {key:0,          node:'a'                   }
+        )
+      );
+    })
+
+    it('emitted node event', function(){
+      expect(builder).toHaveEmitted(
+        NODE_CLOSED
+        ,  anAscentContaining(
+          {key:ROOT_PATH,      node:{'alphabet':['a']} }
+          ,  {key:'alphabet',     node:['a']              }
+          ,  {key:0,              node:'a'                }
+        )
+      )
+    })
+
+    it('reports correct root', function(){
+
+      expect(builder).toHaveEmittedRootWhichIsNow({'alphabet':['a']});
