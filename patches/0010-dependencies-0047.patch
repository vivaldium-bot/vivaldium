+  test('discrepancyMultipleRanges', function() {
+    const samples = [[0.0, 1.2, 2.3, 3.3], [6.3, 7.5, 8.4], [4.2, 5.4, 5.9]];
+    const d0 = Statistics.timestampsDiscrepancy(samples[0]);
