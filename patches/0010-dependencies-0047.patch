+        expectedQueueingTime(window,
+            [{start: 500, end: 510}, {start: 600, end: 700}]),
+        1e-6);
+  });
+
+  test('expectedQueueingTime_twoTasksPartiallyInsideWindow', () => {
+    const window = tr.b.math.Range.fromExplicitRange(0, 1000);
