+      if (referenceDisplayLabel === this.displayLabel_) return undefined;
+      return this.row.columns.get(referenceDisplayLabel);
+    },
+
+    get isHistogramOpen() {
+      return (this.histogramSpan_ !== undefined) &&
+        (this.$.histogram.style.display === 'block');
+    },
+
+    get brushedBinRange() {
