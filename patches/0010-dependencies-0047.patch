+        Statistics.uniformlySampleStream(tempSamples, streamLengthB + i + 1,
+            samplesA[i], numSamples);
+      }
+      // Copy that back into the first vector.
+      for (let i = 0; i < tempSamples.length; ++i) {
+        samplesA[i] = tempSamples[i];
+      }
+      return;
+    }
