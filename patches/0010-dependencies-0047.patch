+        let cat;
+        if (implicitSnapshot.cat !== undefined) {
+          cat = implicitSnapshot.cat;
+        } else {
+          cat = containingSnapshot.objectInstance.category;
+        }
+
+        let baseTypename;
+        if (implicitSnapshot.base_type) {
+          baseTypename = implicitSnapshot.base_type;
+        } else {
+          baseTypename = undefined;
+        }
