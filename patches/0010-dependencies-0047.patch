+  });
+
+  test('maxExpectedQueueingTimeInSlidingWindow_multipleTasks', () => {
+    assert.closeTo(40 / 100 * 40 / 2,
+        maxExpectedQueueingTimeInSlidingWindow(0, 1000, 100, [
+          {start: 500, end: 510},
