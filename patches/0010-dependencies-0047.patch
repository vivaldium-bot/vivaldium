+
+            function compiled ( ascent ){
+               if( matches[pattern] === ascent ) {
+                  return head(ascent);
+               } else {
+                  return false;
+               }
+            }
+
+            return compiled;
+         }
+      );
+
+      patternAdapter(bus, jsonPathCompiler);
