+  });
+
+  test('maxExpectedQueueingTimeInSlidingWindow_overlappingTasksThrow', () => {
+    assert.throws(() => maxExpectedQueueingTimeInSlidingWindow(0, 100, 10,
+        [{start: 0, end: 100}, {start: 99, end: 101}]),
