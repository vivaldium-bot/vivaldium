+    var ascent = emptyList;
+
+    for (var i = 0; i < pathStack.length; i++) {
+
+      var mapping = {key: pathStack[i], node:nodeStack[i]};
+
+      ascent = cons( mapping, ascent );
+    }
+
+    return ascent;
+  }
+
+
+});
