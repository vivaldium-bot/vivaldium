diff --git a/buildtools/third_party/libc++/trunk/test/std/experimental/utilities/tuple/tuple.apply/arg_type.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/experimental/utilities/tuple/tuple.apply/arg_type.pass.cpp
