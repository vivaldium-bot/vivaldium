+      std::is_same<
+        decltype(ex::treat_as_floating_point_v<float>), const bool
+      >::value, ""
+    );
+  }
+  test<int, false>();
+  test<unsigned, false>();
+  test<char, false>();
+  test<bool, false>();
+  test<float, true>();
+  test<double, true>();
+  test<long double, true>();
+}
