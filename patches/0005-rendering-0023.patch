+
+Variable* Scope::DeclareDynamicGlobal(const AstRawString* name) {
+  DCHECK(is_script_scope());
+  return variables_.Declare(this,
+                            name,
+                            DYNAMIC_GLOBAL,
+                            Variable::NORMAL,
+                            kCreatedInitialized);
+}
