+HInstruction* HGraphBuilder::BuildLoadStringLength(HValue* string) {
+  if (string->IsConstant()) {
+    HConstant* c_string = HConstant::cast(string);
+    if (c_string->HasStringValue()) {
+      return New<HConstant>(c_string->StringValue()->length());
+    }
