+
+std::ostream& operator<<(std::ostream& os, const CallICState& s) {
+  return os << "(args(" << s.arg_count() << "), "
+            << (s.call_type() == CallICState::METHOD ? "METHOD" : "FUNCTION")
+            << ", ";
+}
