+void CodeEventLogger::RegExpCodeCreateEvent(Code* code, String* source) {
+  name_buffer_->Init(Logger::REG_EXP_TAG);
+  name_buffer_->AppendString(source);
+  LogRecordedBuffer(code, NULL, name_buffer_->get(), name_buffer_->size());
+}
