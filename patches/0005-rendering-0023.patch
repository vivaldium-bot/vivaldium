+void MacroAssembler::LoadUint32(XMMRegister dst,
+                                Register src) {
+  if (FLAG_debug_code) {
+    cmpq(src, Immediate(0xffffffff));
+    Assert(below_equal, kInputGPRIsExpectedToHaveUpper32Cleared);
+  }
+  cvtqsi2sd(dst, src);
+}
