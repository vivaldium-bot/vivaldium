+  HCheckInstanceType(HValue* value, Check check)
+      : HUnaryOperation(value, HType::HeapObject()), check_(check) {
+    set_representation(Representation::Tagged());
+    SetFlag(kUseGVN);
+  }
+
+  const Check check_;
+};
