+
+void MacroAssembler::SmiOr(Register dst, Register src1, Register src2) {
+  if (!dst.is(src1)) {
+    DCHECK(!src1.is(src2));
+    movp(dst, src1);
+  }
+  orp(dst, src2);
+}
