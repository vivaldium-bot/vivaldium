+void RegExpMacroAssemblerMIPS::IfRegisterEqPos(int reg,
+                                               Label* if_eq) {
+  __ lw(a0, register_location(reg));
+  BranchOrBacktrack(if_eq, eq, a0, Operand(current_input_offset()));
+}
