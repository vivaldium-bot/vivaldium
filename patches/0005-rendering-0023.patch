+void Scope::SetIllegalRedeclaration(Expression* expression) {
+  // Record only the first illegal redeclaration.
+  if (!HasIllegalRedeclaration()) {
+    illegal_redecl_ = expression;
+  }
+  DCHECK(HasIllegalRedeclaration());
