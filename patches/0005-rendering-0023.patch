+#include "src/macro-assembler.h"
+
+namespace v8 {
+namespace internal {
+
+class PlatformInterfaceDescriptor;
+
+#define INTERFACE_DESCRIPTOR_LIST(V)          \
+  V(Load)                                     \
+  V(Store)                                    \
+  V(StoreTransition)                          \
+  V(ElementTransitionAndStore)                \
+  V(VectorStoreICTrampoline)                  \
