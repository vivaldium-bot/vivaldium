+template <typename T>
+int Compare(const T& a, const T& b) {
+  if (a == b)
+    return 0;
+  else if (a < b)
+    return -1;
+  else
+    return 1;
+}
+
+
+template <typename T>
+int PointerValueCompare(const T* a, const T* b) {
+  return Compare<T>(*a, *b);
+}
