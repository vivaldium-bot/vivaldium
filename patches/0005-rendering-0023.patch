+Handle<Object> CallSite::GetFileName(Isolate* isolate) {
+  Handle<Object> script(fun_->shared()->script(), isolate);
+  if (script->IsScript()) {
+    return Handle<Object>(Handle<Script>::cast(script)->name(), isolate);
+  }
+  return isolate->factory()->null_value();
+}
