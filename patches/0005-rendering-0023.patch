+void MacroAssembler::InitializeFieldsWithFiller(Register start_offset,
+                                                Register end_offset,
+                                                Register filler) {
+  Label loop, entry;
+  jmp(&entry);
+  bind(&loop);
+  movp(Operand(start_offset, 0), filler);
+  addp(start_offset, Immediate(kPointerSize));
+  bind(&entry);
+  cmpp(start_offset, end_offset);
+  j(below, &loop);
+}
