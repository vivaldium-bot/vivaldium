+  __ movp(rcx, FieldOperand(rax, HeapObject::kMapOffset));
+  __ movp(rbx, FieldOperand(rdx, HeapObject::kMapOffset));
+  __ cmpp(rcx, rdi);
+  __ j(not_equal, &miss, Label::kNear);
+  __ cmpp(rbx, rdi);
+  __ j(not_equal, &miss, Label::kNear);
+
+  __ subp(rax, rdx);
+  __ ret(0);
+
+  __ bind(&miss);
+  GenerateMiss(masm);
+}
