+static const char* TypeToString(InstanceType type) {
+  switch (type) {
+#define TYPE_TO_STRING(TYPE) case TYPE: return #TYPE;
+  INSTANCE_TYPE_LIST(TYPE_TO_STRING)
+#undef TYPE_TO_STRING
+  }
+  UNREACHABLE();
+  return "UNKNOWN";  // Keep the compiler happy.
+}
