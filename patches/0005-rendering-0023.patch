+class SaveContext BASE_EMBEDDED {
+ public:
+  explicit SaveContext(Isolate* isolate);
+
+  ~SaveContext() {
+    isolate_->set_context(context_.is_null() ? NULL : *context_);
+    isolate_->set_save_context(prev_);
+  }
