+
+Handle<Code> NamedLoadHandlerCompiler::CompileLoadConstant(Handle<Name> name,
+                                                           int constant_index) {
+  Register reg = Frontend(name);
+  __ Move(receiver(), reg);
+  LoadConstantStub stub(isolate(), constant_index);
