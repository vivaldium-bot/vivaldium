+
+void MacroAssembler::SmiOrConstant(Register dst, Register src, Smi* constant) {
+  if (dst.is(src)) {
+    DCHECK(!dst.is(kScratchRegister));
+    Register constant_reg = GetSmiConstant(constant);
+    orp(dst, constant_reg);
+  } else {
+    LoadSmiConstant(dst, constant);
+    orp(dst, src);
