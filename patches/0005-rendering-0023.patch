+SmartArrayPointer<const char> StringStream::ToCString() const {
+  char* str = NewArray<char>(length_ + 1);
+  MemCopy(str, buffer_, length_);
+  str[length_] = '\0';
+  return SmartArrayPointer<const char>(str);
+}
