+AstTyper::AstTyper(CompilationInfo* info)
+    : info_(info),
+      oracle_(info->isolate(), info->zone(),
+              handle(info->closure()->shared()->code()),
+              handle(info->closure()->shared()->feedback_vector()),
+              handle(info->closure()->context()->native_context())),
