+
+#ifdef DEBUG
+bool StringStream::IsMentionedObjectCacheClear(Isolate* isolate) {
+  return object_print_mode_ == kPrintObjectConcise ||
+         isolate->string_stream_debug_object_cache()->length() == 0;
+}
