+
+void Struct::InitializeBody(int object_size) {
+  Object* value = GetHeap()->undefined_value();
+  for (int offset = kHeaderSize; offset < object_size; offset += kPointerSize) {
+    WRITE_FIELD(this, offset, value);
+  }
+}
