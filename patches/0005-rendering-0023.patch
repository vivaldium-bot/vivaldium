+std::ostream& HBoundsCheck::PrintDataTo(std::ostream& os) const {  // NOLINT
+  os << NameOf(index()) << " " << NameOf(length());
+  if (base() != NULL && (offset() != 0 || scale() != 0)) {
+    os << " base: ((";
+    if (base() != index()) {
+      os << NameOf(index());
+    } else {
+      os << "index";
+    }
+    os << " + " << offset() << ") >> " << scale() << ")";
+  }
+  if (skip_check()) os << " [DISABLED]";
+  return os;
+}
