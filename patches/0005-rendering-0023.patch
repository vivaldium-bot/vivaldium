+
+void AstPrinter::PrintLabelsIndented(ZoneList<const AstRawString*>* labels) {
+  if (labels == NULL || labels->length() == 0) return;
+  PrintIndented("LABELS ");
+  PrintLabels(labels);
+  Print("\n");
+}
