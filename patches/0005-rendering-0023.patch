+
+void Assembler::Align(int m) {
+  DCHECK(base::bits::IsPowerOfTwo32(m));
+  int delta = (m - (pc_offset() & (m - 1))) & (m - 1);
+  Nop(delta);
+}
+
+
+void Assembler::CodeTargetAlign() {
+  Align(16);  // Preferred alignment of jump targets on x64.
+}
