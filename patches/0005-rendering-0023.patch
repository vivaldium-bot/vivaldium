+  ZoneList<const AstRawString*>* labels = node->target()->labels();
+  if (labels != NULL) {
+    Print(" ");
+    DCHECK(labels->length() > 0);  // guaranteed to have at least one entry
+    PrintLiteral(labels->at(0), false);  // any label from the list is fine
+  }
+  Print(";");
