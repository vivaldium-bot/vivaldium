+  MOVZ = ((1 << 3) + 2),
+  MOVN = ((1 << 3) + 3),
+  BREAK = ((1 << 3) + 5),
+
+  MFHI = ((2 << 3) + 0),
+  CLZ_R6 = ((2 << 3) + 0),
+  CLO_R6 = ((2 << 3) + 1),
+  MFLO = ((2 << 3) + 2),
+
+  MULT = ((3 << 3) + 0),
+  MULTU = ((3 << 3) + 1),
+  DIV = ((3 << 3) + 2),
+  DIVU = ((3 << 3) + 3),
+
+  ADD = ((4 << 3) + 0),
+  ADDU = ((4 << 3) + 1),
+  SUB = ((4 << 3) + 2),
+  SUBU = ((4 << 3) + 3),
+  AND = ((4 << 3) + 4),
+  OR = ((4 << 3) + 5),
+  XOR = ((4 << 3) + 6),
+  NOR = ((4 << 3) + 7),
+
+  SLT = ((5 << 3) + 2),
+  SLTU = ((5 << 3) + 3),
+
+  TGE = ((6 << 3) + 0),
+  TGEU = ((6 << 3) + 1),
+  TLT = ((6 << 3) + 2),
+  TLTU = ((6 << 3) + 3),
+  TEQ = ((6 << 3) + 4),
+  SELEQZ_S = ((6 << 3) + 5),
+  TNE = ((6 << 3) + 6),
+  SELNEZ_S = ((6 << 3) + 7),
