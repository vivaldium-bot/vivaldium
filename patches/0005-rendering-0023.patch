+static const char* ComputeMarker(SharedFunctionInfo* shared, Code* code) {
+  switch (code->kind()) {
+    case Code::FUNCTION:
+      return shared->optimization_disabled() ? "" : "~";
+    case Code::OPTIMIZED_FUNCTION:
+      return "*";
+    default:
+      return "";
+  }
