-    debugger;
-}
-
-Framework.empty = function()
-{
-}
-
-Framework.doSomeWork = function()
-{
-    const numberOfSteps = 50;
-    for (var i = 0; i < numberOfSteps; ++i) {
-        if (window["dummy property should not exist!" + i]) // Prevent optimizations.
