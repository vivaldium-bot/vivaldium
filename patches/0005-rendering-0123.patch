-            // One block to cross:
-            testParsing("1<i><div>2</i>3</div>4",
-                        "1<i></i><div><i>2</i>3</div>4");
-
-            // Non-affected block to cross:
-            testParsing("1<i>2<object>3</i>4</object>5",
