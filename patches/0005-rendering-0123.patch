-}
-
-// Keyboard actions
-function keyboardScrollUp() {
-  if (window.eventSender)
-    eventSender.keyDown('ArrowDown');
-}
-
-function keyboardScrollLeft() {
-  if (window.eventSender)
-    eventSender.keyDown('ArrowRight');
-}
-
-// Defined in every test
-inject_input();
