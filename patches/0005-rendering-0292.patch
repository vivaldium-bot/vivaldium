+  // the mov instruction. They must be generated using nop(int/NopMarkerTypes).
+  DCHECK(!(src.IsRegister() && src.rm().is(dst) && s == LeaveCC && cond == al));
+  AddrMode1(cond | MOV | s, dst, no_reg, src);
+}
