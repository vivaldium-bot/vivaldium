+void DisassemblingDecoder::VisitNEONScalarShiftImmediate(Instruction* instr) {
+  const char* mnemonic = "unimplemented";
+  const char* form = "%sd, %sn, 'Is1";
+  const char* form_2 = "%sd, %sn, 'Is2";
+
+  static const NEONFormatMap map_shift = {
+      {22, 21, 20, 19},
