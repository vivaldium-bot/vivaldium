-
-vr_test( (t) => {
-  return navigator.getVRDisplays().then( (displays) => {
-
-    let display = displays[0];
-
-    let usingPresentingRAF = false;
-    let lastTime = -1;
-    let lastrAFTime = -1;
-    let tolerance_ms = 250;
-
-    function onAnimationFrame(time) {
