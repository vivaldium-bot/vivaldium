+const char* CodeStub::MajorName(CodeStub::Major major_key) {
+  switch (major_key) {
+#define DEF_CASE(name) case name: return #name "Stub";
+    CODE_STUB_LIST(DEF_CASE)
+#undef DEF_CASE
+    case NoCache:
+      return "<NoCache>Stub";
+    case NUMBER_OF_IDS:
+      UNREACHABLE();
+  }
+  return NULL;
+}
