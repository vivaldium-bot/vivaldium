+    AVFormatContext *sub_ctx;
+    AVPacket sub_pkt;
+    uint8_t *sub_buffer;
+
+    int64_t seek_pos;
+} AVIStream;
+
+typedef struct AVIContext {
+    const AVClass *class;
+    int64_t riff_end;
+    int64_t movi_end;
