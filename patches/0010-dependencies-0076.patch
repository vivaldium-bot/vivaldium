index 0000000000000000000000000000000000000000..f4dc33d7e596ed309ee49b1b701ce4f38f5568e4
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_setfield.c
@@ -0,0 +1,94 @@
+/*
