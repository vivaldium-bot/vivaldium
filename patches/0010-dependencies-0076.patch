index 0000000000000000000000000000000000000000..570a1c90b9bfc389cce78707acd6d94c1c763fe3
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_pp7.c
@@ -0,0 +1,406 @@
+/*
+ * Copyright (c) 2005 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (c) 2014 Arwa Arif <arwaarif1994@gmail.com>
+ *
