+  };
+  for (size_t i = 0; i < sizeof(testStruct) / sizeof(testStruct[0]); ++i) {
+    NSScanner *scanner = [NSScanner scannerWithString:testStruct[i].string];
+    STAssertNotNil(scanner, nil);
