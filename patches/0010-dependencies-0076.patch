+#		define DE_WARN_UNUSED_TYPE __attribute__((warn_unused))
+#	else
+#		define DE_WARN_UNUSED_TYPE
+#	endif
+#else
+#	define DE_WARN_UNUSED_TYPE
+#endif
+
+#endif // _DEDEFS_HPP
