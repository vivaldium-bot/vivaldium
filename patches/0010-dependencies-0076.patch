+                                                  errorCode:&err]
+      autorelease];
+
+  STAssertNotNil(dbNoCFAdditions, @"Failed to create DB");
+  STAssertEquals(err, SQLITE_OK, @"Failed to create DB");
+
+  err = [dbNoCFAdditions executeSQL:nil];
