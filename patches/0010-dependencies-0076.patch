new file mode 100644
index 0000000000000000000000000000000000000000..26f2945c847f0e4cc0407827b4c3a4d34896b5f0
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_lut.c
@@ -0,0 +1,591 @@
