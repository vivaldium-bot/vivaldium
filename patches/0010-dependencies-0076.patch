+#define XCTAssertNULL(a1, format...) \
+({ \
+  NSString *_failure = nil; \
+  @try { \
+    __typeof__(a1) _a1value = (a1); \
+    if (_a1value != (__typeof__(a1))NULL) { \
+      _failure = @""; \
