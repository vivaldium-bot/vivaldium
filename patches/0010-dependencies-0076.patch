+                   @"%@", testStruct[i].string);
+    if (isGood && testStruct[i].goodScan) {
+      STAssertEquals(value, testStruct[i].val, @"%@", testStruct[i].string);
+    }
+    STAssertEquals(testStruct[i].location, [scanner scanLocation], 
+                   @"%@", testStruct[i].string);
