index 0000000000000000000000000000000000000000..298881bc72b902f641351ac3fef1273d092a3619
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_signalstats.c
@@ -0,0 +1,1024 @@
+/*
+ * Copyright (c) 2010 Mark Heath mjpeg0 @ silicontrip dot org
+ * Copyright (c) 2014 Clément Bœsch
+ * Copyright (c) 2014 Dave Rice @dericed
+ *
+ * This file is part of FFmpeg.
