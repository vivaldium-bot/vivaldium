diff --git a/third_party/deqp/src/framework/delibs/decpp/deMutex.hpp b/third_party/deqp/src/framework/delibs/decpp/deMutex.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..4ff303f0679371246ea58f11781bcf03a758bcde
--- /dev/null
