diff --git a/third_party/google_toolbox_for_mac/src/XcodeConfig/Target/LoadableBundle.xcconfig b/third_party/google_toolbox_for_mac/src/XcodeConfig/Target/LoadableBundle.xcconfig
new file mode 100644
