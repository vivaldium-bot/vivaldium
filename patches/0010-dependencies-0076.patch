index 0000000000000000000000000000000000000000..af44b1e22ee6211727b4eba741292a9adcade2a6
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_fftfilt.c
@@ -0,0 +1,442 @@
