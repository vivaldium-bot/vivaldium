index 0000000000000000000000000000000000000000..dfe474c40cb2ad8a46f8407b468649a77548cb30
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_libvmaf.c
@@ -0,0 +1,360 @@
