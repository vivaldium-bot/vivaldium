+
+static const AVCodecTag flv_video_codec_ids[] = {
+    { AV_CODEC_ID_FLV1,     FLV_CODECID_H263 },
+    { AV_CODEC_ID_H263,     FLV_CODECID_REALH263 },
+    { AV_CODEC_ID_MPEG4,    FLV_CODECID_MPEG4 },
+    { AV_CODEC_ID_FLASHSV,  FLV_CODECID_SCREEN },
