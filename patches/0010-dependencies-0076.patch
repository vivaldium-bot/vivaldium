+  Protocol *prot = @protocol(GTMVCTestProtocol);
+  validator_ = [[GTMConformsToProtocolValidator alloc] initWithProtocol:prot];
+  selector_ = @selector(validateObject:forContainer:);
+}
+
+- (void)tearDown {
+  [validator_ release];
+  [super tearDown];
+}
+@end
