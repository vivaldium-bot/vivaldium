+GTM_CONFIGURATION_OTHER_CFLAGS[sdk=macosx10.4*] =
diff --git a/third_party/google_toolbox_for_mac/src/XcodeConfig/subconfig/GTMMerge.xcconfig b/third_party/google_toolbox_for_mac/src/XcodeConfig/subconfig/GTMMerge.xcconfig
