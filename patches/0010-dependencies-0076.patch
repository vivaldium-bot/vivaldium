diff --git a/third_party/ffmpeg/libavformat/mgsts.c b/third_party/ffmpeg/libavformat/mgsts.c
new file mode 100644
index 0000000000000000000000000000000000000000..0720de8d8687f1a0d797a612299df636b1d83661
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mgsts.c
@@ -0,0 +1,106 @@
+/*
+ * Metar Gear Solid: The Twin Snakes demuxer
+ * Copyright (c) 2012 Paul B Mahol
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
