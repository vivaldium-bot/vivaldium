index 0000000000000000000000000000000000000000..7ecfe7da6038c02483e774c59c01f84c4d1881a1
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_mestimate.c
@@ -0,0 +1,377 @@
+/**
+ * Copyright (c) 2016 Davinder Singh (DSM_) <ds.mudhar<@gmail.com>
+ *
