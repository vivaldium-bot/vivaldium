+      rc = sqlite3_exec(db_,
+                        [[sql precomposedStringWithCanonicalMapping]
+                          UTF8String],
+                        NULL, NULL, NULL);
+    } else {
+      rc = sqlite3_exec(db_, [sql UTF8String], NULL, NULL, NULL);
+    }
+  }
+  return rc;
