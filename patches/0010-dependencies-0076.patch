diff --git a/third_party/ffmpeg/libavformat/lrc.h b/third_party/ffmpeg/libavformat/lrc.h
new file mode 100644
index 0000000000000000000000000000000000000000..0297bc1eb19dc6c8610e0b01eb2841a09f5dac30
