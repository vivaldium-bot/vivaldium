index 0000000000000000000000000000000000000000..2f4eb679eaa8961b199280f164d0d48b3273e2a3
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_field.c
@@ -0,0 +1,111 @@
+/*
+ * Copyright (c) 2003 Rich Felker
+ * Copyright (c) 2012 Stefano Sabatini
+ *
