index 0000000000000000000000000000000000000000..4cf17f6e1a9503518959f0b2358ef730bd93e13c
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/iff.c
@@ -0,0 +1,895 @@
+/*
+ * Copyright (c) 2008 Jaikrishnan Menon <realityman@gmx.net>
