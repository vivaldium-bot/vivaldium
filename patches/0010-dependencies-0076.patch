+#endif
+
+/* Same as mpeg2vob_mux except that the pack size is 2324 */
+#if CONFIG_MPEG2SVCD_MUXER
+MPEGENC_CLASS(svcd)
+AVOutputFormat ff_mpeg2svcd_muxer = {
+    .name              = "svcd",
