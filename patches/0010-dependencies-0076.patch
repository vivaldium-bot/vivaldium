index 0000000000000000000000000000000000000000..d8ce656817cab7009362d692fee25d14d006f772
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/nsvdec.c
@@ -0,0 +1,733 @@
+/*
+ * NSV demuxer
+ * Copyright (c) 2004 The FFmpeg Project
+ *
+ * first version by Francois Revol <revol@free.fr>
+ *
