+#define ASSERT_ENCODE_DECODE_STRING(coder, decoded, encoded) do { \
+  STAssertEqualStrings([coder encodeString:decoded], encoded, nil); \
+  STAssertEqualStrings([coder stringByDecoding:encoded], decoded, nil); \
+} while (0)
