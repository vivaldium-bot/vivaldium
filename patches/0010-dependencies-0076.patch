+  val7 = [test kwyjibo];
+  STAssertNotNil(val7, nil);
+  val8 = [test eatMyShorts];
+  STAssertNotNil(val8, nil);
+  STAssertEqualStrings(val1, val7, nil);
+  STAssertEqualStrings(val2, val8, nil);
