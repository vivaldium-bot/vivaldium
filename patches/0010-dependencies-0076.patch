index 0000000000000000000000000000000000000000..b77afc77fc9ec343ad76348cbc3ed95aa24cfa85
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_hflip.c
@@ -0,0 +1,255 @@
