+#include "rawenc.h"
+
+static int jacosub_write_header(AVFormatContext *s)
+{
+    const AVCodecParameters *par = s->streams[0]->codecpar;
+
+    if (par->extradata_size) {
+        avio_write(s->pb, par->extradata, par->extradata_size - 1);
+        avio_flush(s->pb);
+    }
+    return 0;
+}
