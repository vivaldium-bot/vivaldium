+
+static void envelope16(WaveformContext *s, AVFrame *out, int plane, int component, int offset)
+{
+    if (s->envelope == 0) {
+        return;
+    } else if (s->envelope == 1) {
+        envelope_instant16(s, out, plane, component, offset);
+    } else {
+        envelope_peak16(s, out, plane, component, offset);
+    }
+}
