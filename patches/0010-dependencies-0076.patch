+if (DE_ANDROID_API GREATER 8)
+	set(CRTBEGIN_SO	"${ANDROID_SYSROOT}/usr/lib/crtbegin_so.o")
+	set(CRTEND_SO	"${ANDROID_SYSROOT}/usr/lib/crtend_so.o")
