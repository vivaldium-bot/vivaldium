+    uint16_t next_equivalent;
+} LangEntry;
+
+static const uint16_t lang_table_counts[] = { 484, 20, 184 };
+static const uint16_t lang_table_offsets[] = { 0, 484, 504 };
+
+static const LangEntry lang_table[] = {
+    /*----- AV_LANG_ISO639_2_BIBL entries (484) -----*/
+    /*0000*/ { "aar",  504 },
+    /*0001*/ { "abk",  505 },
+    /*0002*/ { "ace",    2 },
+    /*0003*/ { "ach",    3 },
+    /*0004*/ { "ada",    4 },
+    /*0005*/ { "ady",    5 },
