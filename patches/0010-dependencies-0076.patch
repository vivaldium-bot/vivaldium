+		UNORM_SHORT_1555,
+		UNORM_INT_101010,
+		SNORM_INT_1010102_REV,
+		UNORM_INT_1010102_REV,
+		UNSIGNED_BYTE_44,
+		UNSIGNED_SHORT_565,
+		UNSIGNED_SHORT_4444,
+		UNSIGNED_SHORT_5551,
+		SIGNED_INT_1010102_REV,
+		UNSIGNED_INT_1010102_REV,
+		UNSIGNED_INT_11F_11F_10F_REV,
+		UNSIGNED_INT_999_E5_REV,
+		UNSIGNED_INT_16_8_8,
+		UNSIGNED_INT_24_8,
+		UNSIGNED_INT_24_8_REV,
+		SIGNED_INT8,
+		SIGNED_INT16,
+		SIGNED_INT32,
+		UNSIGNED_INT8,
+		UNSIGNED_INT16,
+		UNSIGNED_INT24,
+		UNSIGNED_INT32,
+		HALF_FLOAT,
+		FLOAT,
+		FLOAT64,
+		FLOAT_UNSIGNED_INT_24_8_REV,
+
+		CHANNELTYPE_LAST
+	};
+
+	ChannelOrder	order;
+	ChannelType		type;
+
+	TextureFormat (ChannelOrder order_, ChannelType type_)
+		: order	(order_)
+		, type	(type_)
+	{
+	}
