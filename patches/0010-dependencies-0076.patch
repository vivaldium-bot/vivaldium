+  } \
+  @catch (...) { \
+    _failure = @": " _XCUnknownExceptionString; \
+  } \
+  if (_failure) { \
+    NSString *_expression = [NSString stringWithFormat:@"((%@) == NULL) failed%@", @#a1, _failure]; \
+    _GTMXCRegisterFailure(_expression, format); \
+  } \
+})
+#endif  // XCTAssertNULL
