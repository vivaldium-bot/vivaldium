+  static FT_F26Dot6
+  Round_Down_To_Grid( TT_ExecContext  exc,
+                      FT_F26Dot6      distance,
+                      FT_F26Dot6      compensation )
+  {
+    FT_F26Dot6  val;
+
+    FT_UNUSED( exc );
+
+
+    if ( distance >= 0 )
+    {
+      val = FT_PIX_FLOOR( distance + compensation );
+      if ( val < 0 )
+        val = 0;
+    }
+    else
+    {
+      val = -FT_PIX_FLOOR( compensation - distance );
+      if ( val > 0 )
+        val = 0;
