index 0000000000000000000000000000000000000000..ba32cf744cefac5449c2f374c2a6de355d1331e9
--- /dev/null
+++ b/third_party/freetype-android/src/src/truetype/tterrors.h
@@ -0,0 +1,41 @@
+/***************************************************************************/
+/*                                                                         */
+/*  tterrors.h                                                             */
+/*                                                                         */
+/*    TrueType error codes (specification only).                           */
