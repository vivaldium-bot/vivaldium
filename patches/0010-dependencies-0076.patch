index 0000000000000000000000000000000000000000..de4a12f04830d6f7ad96a3158dde8683aca2702b
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_neighbor.c
@@ -0,0 +1,323 @@
