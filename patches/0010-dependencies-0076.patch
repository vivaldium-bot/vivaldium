index 0000000000000000000000000000000000000000..f13791d254f46fda02dbe52c3a32a7d224a327c4
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_tinterlace.c
@@ -0,0 +1,527 @@
+/*
