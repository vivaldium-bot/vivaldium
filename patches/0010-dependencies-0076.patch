+
+GTM_INLINE int lcm(int a, int b) {
+  for (int aa = a, bb = b;;) {
+    if (aa == bb)
+      return aa;
+    else if (aa < bb)
+      aa += a;
+    else
+      bb += b;
+  }
+}
