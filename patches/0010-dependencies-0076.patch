+
+- (void)test_class_conformsToProtocol {
+  // Nil Checks
+  STAssertFalse(class_conformsToProtocol(cls_, @protocol(NSObject)), nil);
+  STAssertFalse(class_conformsToProtocol(cls_, nil), nil);
