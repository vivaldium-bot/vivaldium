+                          uint16_t *frame_ant, ptrdiff_t w, int16_t *spatial,
+                          int16_t *temporal);
+
+av_cold void ff_hqdn3d_init_x86(HQDN3DContext *hqdn3d)
+{
+#if HAVE_X86ASM
+    hqdn3d->denoise_row[8]  = ff_hqdn3d_row_8_x86;
