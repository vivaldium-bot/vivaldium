+  // Standard use check
+  list = class_copyMethodList(cls_, nil);
+  STAssertNotNULL(list, nil);
+  free(list);
+  unsigned int count = 0;
+  list = class_copyMethodList(cls_, &count);
+  STAssertNotNULL(list, nil);
+  STAssertEquals(count, 2U, nil);
+  STAssertNULL(list[count], nil);
