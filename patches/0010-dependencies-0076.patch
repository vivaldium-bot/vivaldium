+    .long_name      = NULL_IF_CONFIG_SMALL("VobSub subtitle format"),
+    .priv_data_size = sizeof(MpegDemuxContext),
+    .read_probe     = vobsub_probe,
+    .read_header    = vobsub_read_header,
+    .read_packet    = vobsub_read_packet,
+    .read_seek2     = vobsub_read_seek,
+    .read_close     = vobsub_read_close,
+    .flags          = AVFMT_SHOW_IDS,
+    .extensions     = "idx",
+    .priv_class     = &vobsub_demuxer_class,
+};
+#endif
diff --git a/third_party/ffmpeg/libavformat/mpeg.h b/third_party/ffmpeg/libavformat/mpeg.h
new file mode 100644
index 0000000000000000000000000000000000000000..617e36cba81664cef21032faa7a0163e133b2cf4
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mpeg.h
@@ -0,0 +1,73 @@
