+  STAssertNotNil(seg, nil);
+  STAssertTrue([seg isMatch], nil);
+  STAssertEqualStrings([seg string], @"aa", nil);
+  // "\nbb\n" - skipped
+  // "aa"
+  seg = [enumerator nextObject];
+  STAssertNotNil(seg, nil);
