index 0000000000000000000000000000000000000000..f39c09ddb92b92f81081f75eed58347bbc689e7d
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/chromaprint.c
@@ -0,0 +1,191 @@
+/*
+ * Chromaprint fingerprinting muxer
+ * Copyright (c) 2015 Rodger Combs
+ *
