+//! FP32->U8 with RTE rounding (extremely fast, always accurate).
+inline deUint8 floatToU8 (float fv)
+{
+	union { float fv; deUint32 uv; deInt32 iv; } v;
+	v.fv = fv;
+
+	const deUint32	e	= (deUint32)(126-(v.iv>>23));
+	deUint32		m	= v.uv;
+
+	m &= 0x00ffffffu;
+	m |= 0x00800000u;
+	m  = (m << 8) - m;
+	m  = 0x00800000u + (m >> e);
+
+	if (e > 8)
+		m = e;
+
+	return (deUint8)(m>>24);
+}
