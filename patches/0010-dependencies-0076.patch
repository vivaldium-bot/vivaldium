+      case SQLITE_UTF16BE:
+        sqlite3_result_text16be(context, returnBuffer,
+                                convertedBytesForSQLite, &free);
+        break;
+      case SQLITE_UTF16LE:
+        sqlite3_result_text16le(context, returnBuffer,
+                                convertedBytesForSQLite, &free);
+        break;
+      default:
+        free(returnBuffer);
