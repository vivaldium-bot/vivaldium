--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/x86/vf_hflip.asm
@@ -0,0 +1,90 @@
+;*****************************************************************************
+;* x86-optimized functions for hflip filter
+;*
+;* Copyright (C) 2017 Paul B Mahol
+;*
