+		case TextureFormat::UNSIGNED_INT8:		return 1;
+		case TextureFormat::UNSIGNED_INT16:		return 2;
+		case TextureFormat::UNSIGNED_INT24:		return 3;
+		case TextureFormat::UNSIGNED_INT32:		return 4;
