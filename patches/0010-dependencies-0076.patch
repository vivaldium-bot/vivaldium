diff --git a/third_party/ffmpeg/libavformat/avr.c b/third_party/ffmpeg/libavformat/avr.c
new file mode 100644
index 0000000000000000000000000000000000000000..294160e024047467bafbac72d1c3baef0d063595
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/avr.c
@@ -0,0 +1,99 @@
+/*
+ * AVR demuxer
+ * Copyright (c) 2012 Paul B Mahol
+ *
