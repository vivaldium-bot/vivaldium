new file mode 100644
index 0000000000000000000000000000000000000000..fadeb6266dcf5c33cb188c0f1073b6a0e347a0d8
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_phase.c
@@ -0,0 +1,333 @@
