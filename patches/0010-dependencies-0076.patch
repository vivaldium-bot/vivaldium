+           "%02x.%02x.%02x.%02x."                   \
+           "%02x.%02x.%02x.%02x."                   \
+           "%02x.%02x.%02x.%02x."                   \
+           "%02x.%02x.%02x.%02x\n",                 \
+            s, UID_ARG(x))
+#else
+#define PRINT_KEY(pc, s, x) do { if(0)              \
