--- /dev/null
+++ b/third_party/ffmpeg/libavformat/dashdec.c
@@ -0,0 +1,1851 @@
+/*
+ * Dynamic Adaptive Streaming over HTTP demux
+ * Copyright (c) 2017 samsamsam@o2.pl based on HLS demux
+ * Copyright (c) 2017 Steven Liu
+ *
