index 0000000000000000000000000000000000000000..6c79aa9326b980eaf156560269736ffa67e43779
--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/Foundation/GTMPath.m
@@ -0,0 +1,175 @@
+//
+//  GTMPath.m
+//
+//  Copyright 2007-2008 Google Inc.
+//
