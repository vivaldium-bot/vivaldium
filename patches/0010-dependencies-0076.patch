index 0000000000000000000000000000000000000000..a3e52cd5966a4358c5682b9aeddab2029d1ad0df
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/dtsdec.c
@@ -0,0 +1,139 @@
+/*
+ * RAW DTS demuxer
+ * Copyright (c) 2008 Benjamin Larsson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
