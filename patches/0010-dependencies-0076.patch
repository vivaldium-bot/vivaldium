+	enum ChannelType
+	{
+		SNORM_INT8 = 0,
+		SNORM_INT16,
+		SNORM_INT32,
+		UNORM_INT8,
+		UNORM_INT16,
+		UNORM_INT24,
+		UNORM_INT32,
+		UNORM_BYTE_44,
+		UNORM_SHORT_565,
