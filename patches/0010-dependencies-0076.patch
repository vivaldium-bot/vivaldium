+static void draw_dots(uint8_t *dst, int L, int v, float o)
+{
+    const float f = 1. - o;
+    const float V = o * v;
+    int l = L * 2;
+
+    dst[ l - 3] = dst[ l - 3] * f + V;
+    dst[ l + 3] = dst[ l + 3] * f + V;
+    dst[-l - 3] = dst[-l - 3] * f + V;
+    dst[-l + 3] = dst[-l + 3] * f + V;
+
+    l += L;
+
+    dst[ l - 3] = dst[ l - 3] * f + V;
+    dst[ l + 3] = dst[ l + 3] * f + V;
+    dst[ l - 2] = dst[ l - 2] * f + V;
+    dst[ l + 2] = dst[ l + 2] * f + V;
+    dst[-l - 3] = dst[-l - 3] * f + V;
+    dst[-l + 3] = dst[-l + 3] * f + V;
+    dst[-l - 2] = dst[-l - 2] * f + V;
+    dst[-l + 2] = dst[-l + 2] * f + V;
+}
+
+static void draw_dots16(uint16_t *dst, int L, int v, float o)
+{
+    const float f = 1. - o;
+    const float V = o * v;
+    int l = L * 2;
+
+    dst[ l - 3] = dst[ l - 3] * f + V;
+    dst[ l + 3] = dst[ l + 3] * f + V;
+    dst[-l - 3] = dst[-l - 3] * f + V;
+    dst[-l + 3] = dst[-l + 3] * f + V;
+
+    l += L;
+
+    dst[ l - 3] = dst[ l - 3] * f + V;
+    dst[ l + 3] = dst[ l + 3] * f + V;
+    dst[ l - 2] = dst[ l - 2] * f + V;
+    dst[ l + 2] = dst[ l + 2] * f + V;
+    dst[-l - 3] = dst[-l - 3] * f + V;
+    dst[-l + 3] = dst[-l + 3] * f + V;
+    dst[-l - 2] = dst[-l - 2] * f + V;
+    dst[-l + 2] = dst[-l + 2] * f + V;
+}
