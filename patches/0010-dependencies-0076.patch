+static BOOL HasGzipHeader(NSData *data) {
+  // very simple check
+  const unsigned char *bytes = [data bytes];
+  return ([data length] > 2) &&
+         ((bytes[0] == 0x1f) && (bytes[1] == 0x8b));
+}
