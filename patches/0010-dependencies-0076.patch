+} MOVTrack;
+
+typedef enum {
+    MOV_ENC_NONE = 0,
+    MOV_ENC_CENC_AES_CTR,
+} MOVEncryptionScheme;
+
+typedef struct MOVMuxContext {
+    const AVClass *av_class;
+    int     mode;
