+#if defined(DE_DEBUG)
+static bool isSamplerSupported (const Sampler& sampler)
+{
+	return sampler.compare == Sampler::COMPAREMODE_NONE &&
+		   isWrapModeSupported(sampler.wrapS)			&&
+		   isWrapModeSupported(sampler.wrapT)			&&
+		   isWrapModeSupported(sampler.wrapR);
+}
