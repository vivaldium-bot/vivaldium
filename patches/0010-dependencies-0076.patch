+- (void)cleanupDB {
+  if (db_) {
+    int rc = sqlite3_close(db_);
+    if (rc != SQLITE_OK) {
+      _GTMDevLog(@"Unable to close \"%@\", error code: %d\r"
+                 @"Did you forget to call -[GTMSQLiteStatement"
+                 @" finalizeStatement] on one of your statements?",
+                 self, rc);
+    }
+  }
+  [path_ release];
+  [userArgDataPool_ release];
+}
