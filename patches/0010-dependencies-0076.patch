+- (void)failWithException:(NSException *)anException {
+  if (expectedFailureCount_ > 0) {
+    expectedFailureCount_ -= 1;
+  } else {
+    [super failWithException:anException];  // COV_NF_LINE - not expecting exception
+  }
+}
