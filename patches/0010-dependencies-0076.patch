+                        utext_next32(text);
+                        int32_t maiyamokIndex = utext_getNativeIndex(text);
+                        utext_next32(text);
+                        cuWordLength += utext_getNativeIndex(text) - maiyamokIndex;    // Add MAIYAMOK to word
+                    }
