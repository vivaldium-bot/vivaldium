index 0000000000000000000000000000000000000000..0e3bd8485a8f2f54232a0853639834ec8c94c018
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/lsf_check.c
@@ -0,0 +1,71 @@
+/*
