diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/globalsra-unknown-index.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/globalsra-unknown-index.ll
