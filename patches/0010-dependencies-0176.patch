index 0000000000000000000000000000000000000000..92b4a558b9bedc9d1856303256bdc5860909dcc5
--- /dev/null
+++ b/third_party/webrtc/media/base/videoadapter_unittest.cc
@@ -0,0 +1,811 @@
+/*
+ *  Copyright (c) 2010 The WebRTC project authors. All Rights Reserved.
+ *
