diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2004-09-20-BadLoadCombine.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2004-09-20-BadLoadCombine.ll
