+template <class T>
+static std::string ToStringIfSet(const char* key, const rtc::Optional<T>& val) {
+  std::string str;
+  if (val) {
+    str = key;
+    str += ": ";
+    str += val ? rtc::ToString(*val) : "";
+    str += ", ";
+  }
+  return str;
+}
