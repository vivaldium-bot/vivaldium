diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/IndVarSimplify/preserve-gep-loop-variant.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/IndVarSimplify/preserve-gep-loop-variant.ll
