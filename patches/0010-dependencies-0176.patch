index 0000000000000000000000000000000000000000..266c4add846c6d5b51a817d0e3159f0bc82d8ec7
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/JavaCompare.ll
@@ -0,0 +1,14 @@
+; This is the sequence of stuff that the Java front-end expands for a single 
+; <= comparison.  Check to make sure we turn it into a <= (only)
+
+; RUN: opt < %s -instcombine -S | grep {icmp sle i32 %A, %B}
+
+define i1 @le(i32 %A, i32 %B) {
+        %c1 = icmp sgt i32 %A, %B               ; <i1> [#uses=1]
+        %tmp = select i1 %c1, i32 1, i32 0              ; <i32> [#uses=1]
+        %c2 = icmp slt i32 %A, %B               ; <i1> [#uses=1]
+        %result = select i1 %c2, i32 -1, i32 %tmp               ; <i32> [#uses=1]
+        %c3 = icmp sle i32 %result, 0           ; <i1> [#uses=1]
+        ret i1 %c3
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/LandingPadClauses.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/LandingPadClauses.ll
