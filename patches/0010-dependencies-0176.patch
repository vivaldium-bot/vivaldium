diff --git a/third_party/webrtc/media/base/fakevideocapturer.h b/third_party/webrtc/media/base/fakevideocapturer.h
new file mode 100644
index 0000000000000000000000000000000000000000..026bf80a7b15f0f83f94bf66a9fe52eb23bc7cd5
--- /dev/null
+++ b/third_party/webrtc/media/base/fakevideocapturer.h
@@ -0,0 +1,164 @@
+/*
