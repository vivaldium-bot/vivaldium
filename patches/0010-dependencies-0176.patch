diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalDCE/2002-08-17-FunctionDGE.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalDCE/2002-08-17-FunctionDGE.ll
