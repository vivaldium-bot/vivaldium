+bool WebRtcVideoChannel2::SendRtcp(const uint8_t* data, size_t len) {
+  rtc::CopyOnWriteBuffer packet(data, len, kMaxRtpPacketLen);
+  return MediaChannel::SendRtcp(&packet, rtc::PacketOptions());
+}
