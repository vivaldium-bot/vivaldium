diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/FunctionAttrs/2008-12-31-NoCapture.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/FunctionAttrs/2008-12-31-NoCapture.ll
