diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/peep-test-0.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/peep-test-0.ll
new file mode 100644
index 0000000000000000000000000000000000000000..e521d8e37854c1cc02fd778fb4f6287bcc1884d9
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/peep-test-0.ll
@@ -0,0 +1,22 @@
+; RUN: llc < %s -march=x86-64 > %t
+; RUN: not grep cmp %t
+; RUN: not grep test %t
+
+define void @loop(i64 %n, double* nocapture %d) nounwind {
+entry:
+	br label %bb
+
+bb:
+	%indvar = phi i64 [ %n, %entry ], [ %indvar.next, %bb ]
+	%i.03 = add i64 %indvar, %n
+	%0 = getelementptr double* %d, i64 %i.03
+	%1 = load double* %0, align 8
+	%2 = fmul double %1, 3.000000e+00
+	store double %2, double* %0, align 8
+	%indvar.next = add i64 %indvar, 1
+	%exitcond = icmp eq i64 %indvar.next, 0
+	br i1 %exitcond, label %return, label %bb
+
+return:
+	ret void
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/peep-test-1.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/peep-test-1.ll
