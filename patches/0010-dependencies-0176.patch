diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Inline/2004-04-15-InlineDeletesCall.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Inline/2004-04-15-InlineDeletesCall.ll
