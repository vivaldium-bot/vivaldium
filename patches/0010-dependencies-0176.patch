+define i32 @chained_load(i32** %p) {
+block1:
+  %A = alloca i32*
+
+  %z = load i32** %p
+  store i32* %z, i32** %A
+  br i1 true, label %block2, label %block3
+
+block2:
+ %a = load i32** %p
+ br label %block4
+
+block3:
+  %b = load i32** %p
+  br label %block4
+
+block4:
+  %c = load i32** %p
+  %d = load i32* %c
