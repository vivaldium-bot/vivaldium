+  OPEN_FILE_WB(str->fftFilePtr, "riFFT.dat");
+  OPEN_FILE_WB(str->fftDecFilePtr, "riFFTDec.dat");
+
+  OPEN_FILE_WB(str->arrivalTime, NULL /*"ArivalTime.dat"*/);
+  str->lastArrivalTime = 0;
