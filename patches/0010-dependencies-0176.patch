+
+; The f() arguments in %xmm0 and %xmm1 cause an extra movdqa without -join-physregs.
+
+define <4 x i32> @a(<4 x i32> %i) nounwind  {
+        %A = mul <4 x i32> %i, < i32 117, i32 117, i32 117, i32 117 >
+        ret <4 x i32> %A
