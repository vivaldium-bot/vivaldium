+
+    const uint8_t* y = reinterpret_cast<uint8_t*>(ms.get()->GetBuffer());
+    const uint8_t* u = y + kWidth * kHeight;
+    const uint8_t* v = u + kWidth * kHeight / 4;
+    EXPECT_TRUE(IsEqual(frame, kWidth, kHeight, 0, y, kWidth, u,
+                        kWidth / 2, v, kWidth / 2, 0));
