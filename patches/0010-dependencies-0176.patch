+bool WebRtcVoiceEngine::StartAecDump(rtc::PlatformFile file,
+                                     int64_t max_size_bytes) {
+  RTC_DCHECK(worker_thread_checker_.CalledOnValidThread());
+  FILE* aec_dump_file_stream = rtc::FdopenPlatformFileForWriting(file);
