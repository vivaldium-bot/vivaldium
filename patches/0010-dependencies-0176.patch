diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/2009-11-16-MallocSingleStoreToGlobalVar.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/2009-11-16-MallocSingleStoreToGlobalVar.ll
