--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mlpdec.c
@@ -0,0 +1,1354 @@
+/*
+ * MLP decoder
+ * Copyright (c) 2007-2008 Ian Caulfield
+ *
+ * This file is part of FFmpeg.
+ *
