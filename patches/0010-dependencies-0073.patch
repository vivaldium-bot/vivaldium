new file mode 100644
index 0000000000000000000000000000000000000000..5cc4934c0ef6a19e0a62f25d3c99da12e19ebde5
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/lossless_videoencdsp.c
@@ -0,0 +1,84 @@
