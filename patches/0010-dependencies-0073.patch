index 0000000000000000000000000000000000000000..29c61e34f37c16abf9e3b9aaf104cc830d8722cc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mss34dsp.h
@@ -0,0 +1,46 @@
+/*
+ * Common stuff for some Microsoft Screen codecs
+ * Copyright (C) 2012 Konstantin Shishkov
+ *
