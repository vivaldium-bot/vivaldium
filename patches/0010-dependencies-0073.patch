diff --git a/third_party/ffmpeg/libavcodec/htmlsubtitles.c b/third_party/ffmpeg/libavcodec/htmlsubtitles.c
new file mode 100644
index 0000000000000000000000000000000000000000..fb9f90042228d881d18a9ecf62fd726f98e09b55
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/htmlsubtitles.c
@@ -0,0 +1,272 @@
+/*
+ * Copyright (c) 2010  Aurelien Jacobs <aurel@gnuage.org>
+ * Copyright (c) 2017  Clément Bœsch <u@pkh.me>
+ *
+ * This file is part of FFmpeg.
+ *
