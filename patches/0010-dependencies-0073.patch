+	BatchResultHandler	handler	(batchResult);
+	xe::TestLogParser	parser	(&handler);
+	deUint8				buf		[1024];
+	int					numRead	= 0;
+
+	for (;;)
+	{
+		in.read((char*)&buf[0], DE_LENGTH_OF_ARRAY(buf));
+		numRead = (int)in.gcount();
