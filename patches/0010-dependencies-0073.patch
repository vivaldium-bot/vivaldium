diff --git a/third_party/freetype2/src/builds/win32/detect.mk b/third_party/freetype2/src/builds/win32/detect.mk
new file mode 100644
index 0000000000000000000000000000000000000000..190653960901b329a6258582e44fa677e6c4cfa7
--- /dev/null
+++ b/third_party/freetype2/src/builds/win32/detect.mk
@@ -0,0 +1,183 @@
+#
+# FreeType 2 configuration file to detect a Win32 host platform.
+#
+
+
+# Copyright 1996-2000, 2003, 2004, 2006, 2007 by
+# David Turner, Robert Wilhelm, and Werner Lemberg.
+#
