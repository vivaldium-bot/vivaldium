index 0000000000000000000000000000000000000000..e531f8a904b14ad2f5cc6e59ad608bfe64b50065
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpegaudiodsp_template.c
@@ -0,0 +1,401 @@
+/*
