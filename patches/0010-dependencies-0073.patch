+
+	de::Mutex						m_connectionListLock;
+	std::vector<ConnectionHandler*>	m_liveConnections;
+	std::vector<ConnectionHandler*>	m_doneConnections;
+};
+
+class ConnectionHandler : public de::Thread
+{
+public:
