+int ff_mediacodec_surface_unref(void *surface, void *log_ctx)
+{
+    JNIEnv *env = NULL;
+
+    env = ff_jni_get_env(log_ctx);
+    if (!env) {
+        return AVERROR_EXTERNAL;
+    }
+
+    (*env)->DeleteGlobalRef(env, surface);
+
+    return 0;
+}
