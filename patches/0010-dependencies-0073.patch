+
+class TcpIpSendThread : public de::Thread
+{
+public:
+								TcpIpSendThread			(de::Socket& socket, TcpIpLinkState& state);
+								~TcpIpSendThread		(void);
+
+	void						start					(void);
+	void						run						(void);
