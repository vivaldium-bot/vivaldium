+    <TARGETLIST>
+        <TARGET>
+            <NAME>FreeTypeLib</NAME>
+            <SETTINGLIST>
+
+                <!-- Settings for "Source Trees" panel -->
+                <SETTING><NAME>UserSourceTrees</NAME><VALUE></VALUE></SETTING>
+
