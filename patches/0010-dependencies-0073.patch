+};
+
+class Event
+{
+public:
+							Event				(bool manualReset, bool initialState);
+							~Event				(void);
+
+	void					setSignaled			(void);
+	void					reset				(void);
+
+	HANDLE					getHandle			(void) const { return m_handle; }
+
+private:
+							Event				(const Event& other);
+	Event&					operator=			(const Event& other);
+
+	HANDLE					m_handle;
+};
+
+class CaseListWriter : public de::Thread
+{
+public:
+							CaseListWriter		(void);
+							~CaseListWriter		(void);
