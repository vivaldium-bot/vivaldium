+#ifndef _XETESTCASERESULT_HPP
+#define _XETESTCASERESULT_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Test Executor
+ * ------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
