+void *ff_mediacodec_surface_ref(void *surface, void *log_ctx)
+{
+    JNIEnv *env = NULL;
+
+    void *reference = NULL;
+
+    env = ff_jni_get_env(log_ctx);
+    if (!env) {
+        return NULL;
+    }
+
+    reference = (*env)->NewGlobalRef(env, surface);
+
+    return reference;
+}
