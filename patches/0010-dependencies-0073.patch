index 0000000000000000000000000000000000000000..7536d3b2f50949836bd164854d2fae66aaec1257
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mlpenc.c
@@ -0,0 +1,2416 @@
+/**
+ * MLP encoder
+ * Copyright (c) 2008 Ramiro Polla
+ *
