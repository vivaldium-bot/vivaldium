index 0000000000000000000000000000000000000000..a96ae519f533d36a998f8ad8bcf7678f0996df48
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/neon/mpegvideo.c
@@ -0,0 +1,134 @@
