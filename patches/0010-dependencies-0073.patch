+									TcpServer				(deSocketFamily family, int port);
+	virtual							~TcpServer				(void);
+
+	virtual ConnectionHandler*		createHandler			(de::Socket* socket, const de::SocketAddress& clientAddress) = DE_NULL;
+
+	virtual void					runServer				(void);
