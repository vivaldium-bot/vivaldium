+
+static const uint16_t ivi4_quant_4x4_inter[5][16] = {
+  {
+     107,  214,  257,  299,
+     214,  257,  299,  299,
+     257,  299,  299,  342,
+     299,  299,  342,  342
+  },
+  {
+     513, 1025, 1238, 1238,
+    1025, 1025, 1238, 1238,
