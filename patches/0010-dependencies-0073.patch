index 0000000000000000000000000000000000000000..ddbab60c4e51583849f1460a7a26b06c3560d4a6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mlp.c
@@ -0,0 +1,136 @@
+/*
+ * MLP codec common code
+ * Copyright (c) 2007-2008 Ian Caulfield
+ *
