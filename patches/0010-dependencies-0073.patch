--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/jpeglsenc.c
@@ -0,0 +1,483 @@
+/*
+ * JPEG-LS encoder
+ * Copyright (c) 2003 Michael Niedermayer
+ * Copyright (c) 2006 Konstantin Shishkov
+ *
+ * This file is part of FFmpeg.
+ *
