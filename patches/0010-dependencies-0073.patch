+	: m_process				(DE_NULL)
+	, m_processStartTime	(0)
+	, m_infoBuffer			(INFO_BUFFER_BLOCK_SIZE, INFO_BUFFER_NUM_BLOCKS)
+	, m_stdOutReader		(&m_infoBuffer)
+	, m_stdErrReader		(&m_infoBuffer)
+{
+}
