--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mjpegenc_common.c
@@ -0,0 +1,614 @@
+/*
+ * lossless JPEG shared bits
+ * Copyright (c) 2000, 2001 Fabrice Bellard
