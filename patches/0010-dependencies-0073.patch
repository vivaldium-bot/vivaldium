diff --git a/third_party/ffmpeg/libavcodec/msmpeg4dec.c b/third_party/ffmpeg/libavcodec/msmpeg4dec.c
new file mode 100644
index 0000000000000000000000000000000000000000..4105d4ba7d0614ab1c1aab68a7f9804027e97500
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/msmpeg4dec.c
@@ -0,0 +1,940 @@
+/*
+ * MSMPEG4 backend for encoder and decoder
+ * Copyright (c) 2001 Fabrice Bellard
+ * Copyright (c) 2002-2013 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * msmpeg4v1 & v2 stuff by Michael Niedermayer <michaelni@gmx.at>
