+Event::Event (bool manualReset, bool initialState)
+	: m_handle(0)
+{
+	m_handle = CreateEvent(NULL, manualReset ? TRUE : FALSE, initialState ? TRUE : FALSE, NULL);
+	if (!m_handle)
+		throw Error(GetLastError(), "CreateEvent() failed");
+}
+
+Event::~Event (void)
+{
+	CloseHandle(m_handle);
+}
