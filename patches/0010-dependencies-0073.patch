+    1707, 1707, 2390, 2390, 1707, 1707, 1707, 1707
+  }
+};
+
+static const uint16_t ivi4_quant_4x4_intra[5][16] = {
+  {
+      22,  214,  257,  299,
+     214,  257,  299,  342,
+     257,  299,  342,  427,
+     299,  342,  427,  513
+  },
+  {
+     129, 1025, 1451, 1451,
+    1025, 1025, 1451, 1451,
+    1451, 1451, 2049, 2049,
+    1451, 1451, 2049, 2049
+  },
