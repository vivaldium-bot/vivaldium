diff --git a/third_party/ffmpeg/libavcodec/mpegpicture.c b/third_party/ffmpeg/libavcodec/mpegpicture.c
new file mode 100644
index 0000000000000000000000000000000000000000..2be670cdbc2305c1b19a2778cfd191a6ddd1e680
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpegpicture.c
@@ -0,0 +1,476 @@
+/*
+ * Mpeg video formats-related picture management functions
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
