-
-var firstListenerCount = 0;
-function firstListener(event) {
-    checkLight(event);
-    firstListenerCount++;
-    proceedIfNecessary();
-}
-
-var secondListenerCount = 0;
-function secondListener(event) {
-    checkLight(event);
-    secondListenerCount++;
-    proceedIfNecessary();
