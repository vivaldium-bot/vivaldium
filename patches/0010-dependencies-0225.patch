+  if (channelPtr->Playing()) {
+    return 0;
+  }
+  if (StartPlayout() != 0) {
+    shared_->SetLastError(VE_AUDIO_DEVICE_MODULE_ERROR, kTraceError,
+                          "StartPlayout() failed to start playout");
+    return -1;
+  }
+  return channelPtr->StartPlayout();
