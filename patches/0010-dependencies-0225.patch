+      &fake_clock_, config, std::unique_ptr<Demuxer>(demuxer)));
+
+  const int kPacketSize = 1000;
+  const int kPacketTimeMs = PacketTimeMs(config.link_capacity_kbps,
+                                         kPacketSize);
+
