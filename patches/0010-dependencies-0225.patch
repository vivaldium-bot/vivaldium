+class StatsCounterObserverImpl : public StatsCounterObserver {
+ public:
+  StatsCounterObserverImpl() : num_calls_(0), last_sample_(-1) {}
+  void OnMetricUpdated(int sample) override {
+    ++num_calls_;
+    last_sample_ = sample;
+  }
+  int num_calls_;
+  int last_sample_;
+};
