+VideoStreamEncoder::~VideoStreamEncoder() {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  RTC_DCHECK(shutdown_event_.Wait(0))
+      << "Must call ::Stop() before destruction.";
+}
