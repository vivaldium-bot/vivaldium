+BeforeStreamingFixture::BeforeStreamingFixture()
+    : channel_(voe_base_->CreateChannel()),
+      transport_(NULL) {
+  EXPECT_GE(channel_, 0);
+
+  fake_microphone_input_file_ =
+      webrtc::test::ResourcePath("voice_engine/audio_long16", "pcm");
+
+  SetUpLocalPlayback();
+  RestartFakeMicrophone();
+}
