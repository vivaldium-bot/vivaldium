+           "Set to the number of streams to show them all.");
+int SelectedStream() {
+  return static_cast<int>(FLAG_selected_stream);
+}
+
+DEFINE_int(num_spatial_layers, 1, "Number of spatial layers to use.");
+int NumSpatialLayers() {
