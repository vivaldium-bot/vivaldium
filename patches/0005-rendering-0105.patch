-        })
-      .then(function() {
-          return assert_rejects(
-              frame.contentWindow.load_image(REMOTE_IMAGE_URL),
-              'Disallowed scope image resource should not be loaded.');
-        })
-      .then(function() {
-          return assert_resolves(
-              frame.contentWindow.load_image(
