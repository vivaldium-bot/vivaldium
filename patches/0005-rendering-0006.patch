@@ -1,60 +0,0 @@
-/*Used for applying style to a <span> so it looks like a highlight*/
-.fauxHighlight {
-  background-color: rgb(0, 255, 0);
-  color: rgb(0, 255, 0);
-}
-
-.fauxHighlightSquare {
-  background-color: rgb(0, 255, 0);
-  color: rgb(0, 255, 0);
-}
-
-.opaqueHighlight {
-  -webkit-tap-highlight-color: rgb(0, 255, 0);
-}
-
-.target {
-  cursor: pointer;  /* enables link highlighting */
-  -webkit-tap-highlight-color: rgb(0, 255, 0);
-  border: 2px solid grey;
-  box-sizing: border-box;
-}
-/* touch adjustment candidate */
-.target:active {
-  border-color: red;
-}
-
-.transparentHighlight {
-  -webkit-tap-highlight-color: rgba(0, 255, 0, 0.5);
-}
-
-.activeLink {
-  color: rgb(0, 255, 0);
-}
-
-a {
-  text-decoration: none;
-}
-
-a:active {
-  color: rgb(0, 255, 0);
-}
-
-a.needsFix:active {
-  color: rgb(255, 255, 255);
-}
-
-/*Used for a floating DIV simulating a highlight*/
-.highlightDiv {
-  background-color: rgb(0, 255, 0);
-  z-index: 1;
-  position: absolute;
-}
-
-.squaredHighlight {
-  -webkit-border-radius: 0px;
-}
-
-.composited {
-  transform: translateZ(0);
-}
