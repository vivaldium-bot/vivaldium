+private:
+    VTTRegion();
+
+    void prepareRegionDisplayTree();
+
+    // The timer is needed to continue processing when cue scrolling ended.
+    void startTimer();
+    void stopTimer();
+    void scrollTimerFired(Timer<VTTRegion>*);
+
+    enum RegionSetting {
+        None,
+        Id,
+        Width,
+        Height,
+        RegionAnchor,
+        ViewportAnchor,
+        Scroll
