+{
+    if (!layoutObject->isBox())
+        return;
+    AutoscrollController* controller = autoscrollController();
+    if (!controller)
+        return;
+    controller->startPanScrolling(toLayoutBox(layoutObject), lastKnownMousePosition());
+    invalidateClick();
+}
