+    WillBeHeapVector<RefPtrWillBeMember<TextTrack>> m_addTrackTracks;
+    WillBeHeapVector<RefPtrWillBeMember<TextTrack>> m_elementTracks;
+    WillBeHeapVector<RefPtrWillBeMember<TextTrack>> m_inbandTracks;
+};
