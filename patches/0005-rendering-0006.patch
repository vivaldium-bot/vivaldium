+
+    enum ReadyState {
+        NONE = 0,
+        LOADING = 1,
+        LOADED = 2,
+        TRACK_ERROR = 3
+    };
+    ReadyState readyState();
+    void scheduleLoad();
+
+    TextTrack* track();
+
+    DECLARE_VIRTUAL_TRACE();
+
+private:
