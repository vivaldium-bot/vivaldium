-        top: 100px;
-        height: 200px;
-        width: 200px;
-    }
-
-    .rotated {
-      transform: translateZ(0) rotate(5deg);
-    }
-
-    .counter-rotated {
-      transform: translateZ(0) rotate(-9deg);
-    }
-</style>
