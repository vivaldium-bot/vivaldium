++ (NSError *)lockError {
+  NSDictionary *userInfo = @{
+    NSLocalizedDescriptionKey:
+        @"Must call lockForConfiguration before calling this method."
+  };
+  NSError *error =
+      [[NSError alloc] initWithDomain:kRTCAudioSessionErrorDomain
+                                 code:kRTCAudioSessionErrorLockRequired
+                             userInfo:userInfo];
+  return error;
+}
