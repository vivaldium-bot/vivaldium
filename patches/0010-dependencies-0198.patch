+    return true;
+  }
+  int OnReceivedPayloadData(const uint8_t* payload_data,
+                            const size_t payload_size,
+                            const WebRtcRTPHeader* rtp_header) override {
+    return 0;
+  }
+  test::RtcpPacketParser parser_;
+};
