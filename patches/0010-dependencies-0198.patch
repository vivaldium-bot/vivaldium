+int32_t AudioDeviceLinuxPulse::PlayoutBuffer(
+    AudioDeviceModule::BufferType& type,
+    uint16_t& sizeMS) const
+{
+    RTC_DCHECK(thread_checker_.CalledOnValidThread());
+    type = _playBufType;
+    sizeMS = _playBufDelayFixed;
+
+    return 0;
+}
