diff --git a/third_party/webrtc/modules/desktop_capture/desktop_geometry.cc b/third_party/webrtc/modules/desktop_capture/desktop_geometry.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2af8cf826e4dc70193e58569b0e6824eddc140de
--- /dev/null
