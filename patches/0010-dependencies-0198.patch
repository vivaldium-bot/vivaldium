+      RTC_CHECK_EQ(AudioProcessing::kNoError,
+                   ap_->high_pass_filter()->Enable(enable));
+      if (settings_.use_verbose_logging) {
+        std::cout << " hpf_enabled: " << (enable ? "true" : "false")
+                  << std::endl;
+      }
