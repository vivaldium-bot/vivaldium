+ private:
+  void Init();
+  void MaybeTriggerOnNetworkChanged();
+
+  bool IsSendQueueFull() const;
+  bool IsNetworkDown() const;
+  bool HasNetworkParametersToReportChanged(uint32_t bitrate_bps,
