+NadaBweSender::NadaBweSender(int kbps, BitrateObserver* observer, Clock* clock)
+    : BweSender(kbps),  // Referred as "Reference Rate" = R_n.,
+      clock_(clock),
+      observer_(observer),
+      original_operating_mode_(true) {
+}
