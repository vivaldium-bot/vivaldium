+int32_t ModuleRtpRtcpImpl::DataCountersRTP(
+    size_t* bytes_sent,
+    uint32_t* packets_sent) const {
+  StreamDataCounters rtp_stats;
+  StreamDataCounters rtx_stats;
+  rtp_sender_.GetDataCounters(&rtp_stats, &rtx_stats);
