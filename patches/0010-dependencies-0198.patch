+void AudioDeviceLinuxPulse::PaStreamStateCallbackHandler(pa_stream *p)
+{
+    WEBRTC_TRACE(kTraceDebug, kTraceAudioDevice, _id,
+                 "  stream state cb");
+
+    pa_stream_state_t state = LATE(pa_stream_get_state)(p);
+    switch (state)
+    {
+        case PA_STREAM_UNCONNECTED:
+            WEBRTC_TRACE(kTraceDebug, kTraceAudioDevice, _id,
