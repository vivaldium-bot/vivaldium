+int EchoCancellationImpl::set_suppression_level(SuppressionLevel level) {
+  {
+    if (MapSetting(level) == -1) {
+      return AudioProcessing::kBadParameterError;
+    }
+    rtc::CritScope cs(crit_capture_);
+    suppression_level_ = level;
+  }
+  return Configure();
+}
