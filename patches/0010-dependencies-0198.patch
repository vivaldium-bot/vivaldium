+                         apm->num_output_channels(),
+                         output_wav_file.get(),
+                         output_raw_file.get());
+        }
+      }
+    }
+
+    ASSERT_TRUE(feof(pb_file));
+
+  } else {
+    enum Events {
+      kInitializeEvent,
+      kRenderEvent,
+      kCaptureEvent,
+      kResetEventDeprecated
