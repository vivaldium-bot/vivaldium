index 0000000000000000000000000000000000000000..a9b5cd4e60f730d87680dde31a60e10d3e14ce68
--- /dev/null
+++ b/third_party/webrtc/modules/audio_processing/aec/aec_core_mips.cc
@@ -0,0 +1,489 @@
+/*
