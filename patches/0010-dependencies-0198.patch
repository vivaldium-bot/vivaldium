+    video_module_->SetRTCPStatus(RtcpMode::kCompound);
+    video_module_->SetSSRC(test_ssrc_);
+    video_module_->SetStorePacketsStatus(true, 600);
+    EXPECT_EQ(0, video_module_->SetSendingStatus(true));
