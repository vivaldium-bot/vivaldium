+          printf("Bad parameter warning. %s\n", trace_stream.str().c_str());
+        }
+        ASSERT_TRUE(err == apm->kNoError ||
+                    err == apm->kBadStreamParameterWarning);
+        ASSERT_TRUE(near_frame.num_channels_ == apm->num_output_channels());
+
