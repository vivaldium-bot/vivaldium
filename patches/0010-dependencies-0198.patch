+class RtpSenderTest : public ::testing::Test {
+ protected:
+  RtpSenderTest()
+      : fake_clock_(kStartTime),
+        mock_rtc_event_log_(),
+        mock_paced_sender_(),
+        retransmission_rate_limiter_(&fake_clock_, 1000),
+        rtp_sender_(),
