+        apm->echo_cancellation()->set_stream_drift_samples(msg.drift());
+
+        if (msg.has_keypress()) {
+          apm->set_stream_key_pressed(msg.keypress());
+        } else {
+          apm->set_stream_key_pressed(true);
+        }
+
+        int err = apm->kNoError;
+        if (msg.has_input_data()) {
