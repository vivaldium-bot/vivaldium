+    HMIXER                  _outputMixerHandle;
+    UINT                    _outputMixerID;
+    HMIXER                  _inputMixerHandle;
+    UINT                    _inputMixerID;
+    SpeakerLineInfo         _speakerState[MAX_NUMBER_MIXER_DEVICES];
+    MicrophoneLineInfo      _microphoneState[MAX_NUMBER_MIXER_DEVICES];
