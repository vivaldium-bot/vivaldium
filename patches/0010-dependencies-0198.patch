+      RtpUtility::Payload*(const char payload_name[RTP_PAYLOAD_NAME_SIZE],
+                           int8_t payload_type,
+                           uint32_t frequency,
+                           size_t channels,
+                           uint32_t rate));
+};
+
+}  // namespace webrtc
