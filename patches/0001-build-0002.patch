+// <map>
+
+// Check that std::map fails to instantiate if the comparison predicate is
+// not copy-constructible. This is LWG issue 2436
+
+#include <map>
+
+template <class T>
+struct Comp {
+    bool operator () (const T& lhs, const T& rhs) const { return lhs < rhs; }
