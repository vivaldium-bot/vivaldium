diff --git a/buildtools/third_party/libc++/trunk/test/std/algorithms/alg.sorting/alg.clamp/clamp.comp.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/algorithms/alg.sorting/alg.clamp/clamp.comp.pass.cpp
