+  path = test.built_file_path(
+      'ExtensionContainer.app/PlugIns/ActionExtension.appex/ActionExtension',
+      chdir='extension')
+  CheckStrip(path, "ActionViewController")
+  CheckEntrypoint(path, "_NSExtensionMain")
