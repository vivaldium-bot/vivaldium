+
+// <future>
+
+// class promise<R>
+
+// void set_exception(exception_ptr p);
+// Test that a null exception_ptr is diagnosed.
+
+#define _LIBCPP_ASSERT(x, m) ((x) ? ((void)0) : throw 42)
+
+#define _LIBCPP_DEBUG 0
+#include <future>
+#include <exception>
+#include <cstdlib>
+#include <cassert>
+
+
+int main()
+{
+    {
+        typedef int T;
+        std::promise<T> p;
+        try {
+            p.set_exception(std::exception_ptr());
+            assert(false);
+        } catch (int const& value) {
+            assert(value == 42);
+        }
+    }
+    {
+        typedef int& T;
+        std::promise<T> p;
+        try {
+            p.set_exception(std::exception_ptr());
+            assert(false);
+        } catch (int const& value) {
+            assert(value == 42);
+        }
+    }
+}
