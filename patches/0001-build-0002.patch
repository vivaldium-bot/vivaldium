+    int ib[sa];
+    OutIter r = std::remove_copy_if(InIter(ia), InIter(ia+sa),
+                                    OutIter(ib), equalToTwo);
+    assert(base(r) == ib + sa-3);
+    assert(ib[0] == 0);
+    assert(ib[1] == 1);
+    assert(ib[2] == 3);
+    assert(ib[3] == 4);
+    assert(ib[4] == 3);
