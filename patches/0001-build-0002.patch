diff --git a/buildtools/third_party/libc++/trunk/test/std/containers/associative/map/map.special/swap_noexcept.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/containers/associative/map/map.special/swap_noexcept.pass.cpp
