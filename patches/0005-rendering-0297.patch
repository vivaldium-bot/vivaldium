+
+// SIMPLIFIED BINOPs without input restriction
+#define TEST_MONOTONICITY(name)                         \
+  TEST_F(TyperTest, Monotonicity_Operation_##name) {    \
+    BinaryTyper typer = [&](Type* type1, Type* type2) { \
