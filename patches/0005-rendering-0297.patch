+    data[index] = 1 << (i % 7);
+    memset(data, 0x80, index);
+
+    for (unsigned limit = 0; limit <= kMaxSize; limit++) {
+      decoder.Reset(data, data + limit);
+      unsigned length;
+      uint64_t result = decoder.read_u64v<true>(data, &length);
