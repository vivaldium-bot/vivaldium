+  'Ieee754.Acosh': [SKIP],
+  'Ieee754.Asinh': [SKIP],
+  'MoveOptimizerTest.RemovesRedundantExplicit': [SKIP],
+  'RegisterAllocatorTest.CanAllocateFPRegisters': [SKIP],
+}],  # 'arch == x87'
+
+]
