+
+testWithTypedArrayConstructors(function(TA) {
+  var sample = new TA(2);
+  var src = new TA([42, 43]);
+  var differentTA = TA === Uint8Array ? Int8Array : Uint8Array;
+  var src2 = new differentTA([42, 43]);
+  var src3 = new differentTA(sample.buffer, 0, 2);
