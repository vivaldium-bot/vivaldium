+TARGET_TEST_F(InstructionSelectorTest, ReturnFloat32Constant) {
+  const float kValue = 4.2f;
+  StreamBuilder m(this, MachineType::Float32());
+  m.Return(m.Float32Constant(kValue));
+  Stream s = m.Build(kAllInstructions);
