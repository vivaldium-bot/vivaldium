+    for (int i = 0; i < kRepetitions; ++i) {            \
+      TestBinaryMonotonicity(typer);                    \
+    }                                                   \
+  }
+SIMPLIFIED_SPECULATIVE_NUMBER_BINOP_LIST(TEST_MONOTONICITY)
