+    else
+        testFailed ("recover from NaN date using date.setUTCFullYear()");
+    return result;
+}
+
+function testDateFunctionWithValueRecoverYear(functionNameRoot)
+{
+    var result = true;
+    var is13Compatible = true;
+
+    var date = new Date();
+    var setValue = date["get" + functionNameRoot]();
