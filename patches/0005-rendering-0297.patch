+description(
+"Tests aliased uses of 'arguments' that have an unexpected escape."
+);
+
+function baz() {
+    return foo.arguments;
+}
+
+function foo() {
+    var result = 0;
+    var a = arguments;
+    for (var i = 0; i < a.length; ++i) {
