+        testFailed("date.getHours() was " + getResult + " instead of 0");
+        result = false;
+    }
+    getResult = date.getDate();
+    if (getResult != 1) {
+        testFailed("date.getDate() was " + getResult + " instead of 1");
+        result = false;
+    }
+    getResult = date.getMonth();
+    if (getResult != 0) {
+        testFailed("date.getMonth() was " + getResult + " instead of 0");
