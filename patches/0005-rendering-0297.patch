+TEST_F(NodeCacheTest, Int32Constant_back_to_back) {
+  Int32NodeCache cache;
+
+  for (int i = -2000000000; i < 2000000000; i += 3315177) {
+    Node** pos = cache.Find(zone(), i);
+    ASSERT_TRUE(pos != nullptr);
+    for (int j = 0; j < 3; j++) {
+      Node** npos = cache.Find(zone(), i);
+      EXPECT_EQ(pos, npos);
+    }
+  }
