+      kExprGetLocal, 0,
+      kExprGetLocal, 1,
+      kExprI32LoadMem, 0, 0,
+      kExprI32StoreMem, 0, 0,
+      kExprGetLocal, 1,
+      kExprI32LoadMem, 0, 0,
+    ])
+    .exportFunc();
