diff --git a/v8/test/mjsunit/regress/regress-binop.js b/v8/test/mjsunit/regress/regress-binop.js
new file mode 100644
index 0000000000000000000000000000000000000000..7a8b41924dd5673a698d0ca8ef4135c470b5d862
--- /dev/null
+++ b/v8/test/mjsunit/regress/regress-binop.js
@@ -0,0 +1,181 @@
+// Copyright 2013 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
+//     * Redistributions of source code must retain the above copyright
+//       notice, this list of conditions and the following disclaimer.
+//     * Redistributions in binary form must reproduce the above
