+function ManyI32() {
+  "use asm";
+  function main() {
+    var a = 0, b = 0, c = 0, d = 0, e = 0, f = 0, g = 0, h = 0, i = 0, j = 0;
+    a =          1 +          -2 +          3 +          -4 | 0;
