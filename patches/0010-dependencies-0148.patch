+        /** @const {number} */ var gradientMin = this.u_minGradient.value[0];
+        /** @const {number} */ var gradientMax = this.u_maxGradient.value[0];
+        /** @type {Array<number>} */ var color = deMath.clampVector(this.u_color.value, 0, 1);
