+                } else if (gluShaderUtil.isDataTypeVector(basicType)) {
+                    this.m_path.push(new gluVarTypeUtil.VarTypeComponent(gluVarTypeUtil.VarTypeComponent.s_Type.VECTOR_COMPONENT, 0));
