index 0000000000000000000000000000000000000000..ec00e17d1931c7f907d7f714a2b1eca8d4d88255
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/deqp/framework/referencerenderer/rrVertexPacket.js
@@ -0,0 +1,101 @@
+/*-------------------------------------------------------------------------
