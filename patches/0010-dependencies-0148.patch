+    tcuInterval.Interval = function(val) {
+        if (val === undefined) {
+            this.m_hasNaN = false;
+            this.m_lo = Number.POSITIVE_INFINITY;
+            this.m_hi = Number.NEGATIVE_INFINITY;
+        } else {
+            this.m_hasNaN = isNaN(val);
