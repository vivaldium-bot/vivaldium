+    var width = pixels.getWidth();
+    var height = pixels.getHeight();
+
+    for (var y = 0; y < height; y++) {
+        for (var x = 0; x < width; x++) {
+            var pixel = pixels.getPixel(x, y);
+            if (pixel[2] != 0)
+                passColorFound = true;
+
+            if (pixel[0] != 0) {
+                failColorFound = true;
+                break;
+            }
+        }
