+    this.m_buffer = gl.createBuffer();
+    gl.bindBuffer(gl.ARRAY_BUFFER, this.m_buffer);
+    gl.vertexAttribPointer(0, ELEMENTS_PER_VERTEX, gl.FLOAT, false, 0, 0);
+};
