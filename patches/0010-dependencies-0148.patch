+                }
+            }
+        }
+
+    };
+
+    es3fTextureShadowTests.run = function(context) {
+        gl = context;
+        //Set up Test Root parameters
+        var testName = 'texture_shadow';
+        var testDescription = 'Texture Shadow Test';
+        var state = tcuTestCase.runner;
+
