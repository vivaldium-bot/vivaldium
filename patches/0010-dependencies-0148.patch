+                structType.addMember('m' + i, typeWithIndex.type);
+            }
+
+            structTypesDst.push(structType);
+            return (isArray ? {
+                type: gluVarType.newTypeArray(gluVarType.newTypeStruct(structType), rnd.getInt(1, 5)),
