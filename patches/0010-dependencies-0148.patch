+        ctx.bindFramebuffer(gl.FRAMEBUFFER, srcFbo);
+        ctx.viewport(0, 0, this.m_srcSize[0], this.m_srcSize[1]);
+
+        rrUtil.drawQuad(ctx, texShaderID, [-1, -1, 0], [1, 1, 0]);
