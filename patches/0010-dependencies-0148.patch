+        var aliasingGroup = tcuTestCase.newTest('bind_aliasing', 'Test binding aliasing locations.');
+
+        root.addChild(aliasingGroup);
+
+        for (typeNdx = 0; typeNdx < es2Types.length; typeNdx++) {
+            type = es2Types[typeNdx];
