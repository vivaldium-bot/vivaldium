+            //case glsVertexArrayTests.deArray.InputType.DOUBLE:
+            case glsVertexArrayTests.deArray.InputType.HALF: {
+                return glsVertexArrayTests.GLValue.create(minv + rnd.getFloat() * (maxv - minv), type);
+                break;
+            }
