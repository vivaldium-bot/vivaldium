+				"in0 = " + in0 + " / " + tcuFloat.newFloat32(in0).bits() +
+				", in1 = " + in1 + " / " + tcuFloat.newFloat32(in1).bits() +
+				"  reference = " + refD + " / " + tcuFloat.newFloat32(refD).bits());
+
+			in0Arr = [in0, in0, in0, in0];
+			in1Arr = [in1, in1, in1, in1];
