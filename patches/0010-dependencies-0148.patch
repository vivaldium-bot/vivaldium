+
+        desc += '\t' + this.primitiveCount + ' ';
+
+        switch (this.primitive) {
+            case glsDrawTests.DrawTestSpec.Primitive.POINTS:
+                desc += 'points';
+                break;
+            case glsDrawTests.DrawTestSpec.Primitive.TRIANGLES:
+                desc += 'triangles';
