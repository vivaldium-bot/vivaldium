+  // Load the shader source
+  gl.shaderSource(shader, shaderSource);
+  var err = gl.getError();
+  if (err != gl.NO_ERROR) {
+    errFn("*** Error loading shader '" + shader + "':" + glEnumToString(gl, err));
+    return null;
+  }
