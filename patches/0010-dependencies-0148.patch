+                            value1 + '\n' +
+                                '\tExpected range: ' +
+                                reference1 + '\n';
+                    }
+                }
+                bufferedLogToConsole(builder);
+            }
+        }
+
+        if (numErrors > maxMsgs) {
+            bufferedLogToConsole('(Skipped ' + (numErrors - maxMsgs) + ' messages.)');
+        }
+
+        if (numErrors == 0) {
+            testPassed('All ' + numValues + ' inputs passed.');
+        } else {
+            testFailed('' + numErrors + '/' + numValues + ' inputs failed.');
+        }
+    };
