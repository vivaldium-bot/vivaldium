+        //Run test cases
+        tcuTestCase.runTestCases();
+    }
+    catch (err) {
+        testFailedOptions('Failed to es3fFboDepthbufferTests.run tests', false);
+        tcuTestCase.runner.terminate();
+    }
+};
+
+});
