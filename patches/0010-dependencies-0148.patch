+
+        /** @type {Array<glsAttributeLocationTests.AttribType>} */
+        var es2Types = [
+            new glsAttributeLocationTests.AttribType('float', 1, gl.FLOAT),
+            new glsAttributeLocationTests.AttribType('vec2', 1, gl.FLOAT_VEC2),
