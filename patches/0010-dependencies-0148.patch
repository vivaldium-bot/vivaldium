+
+        // Setup program.
+        gl.useProgram(this.m_program.getProgram());
+
+        gl.uniform4fv(
+            gl.getUniformLocation(this.m_program.getProgram(), 'u_scale'),
+            [0.01, 0.01, 0.01, 0.01]
+        );
+        gl.uniform4fv(
+            gl.getUniformLocation(this.m_program.getProgram(), 'u_bias'),
+            [0.5, 0.5, 0.5, 0.5]
+        );
