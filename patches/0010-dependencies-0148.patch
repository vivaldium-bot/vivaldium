+    es3fShaderTextureFunctionTests.functionHasAutoLod = function(shaderType, function_) {
+        return shaderType === gluShaderProgram.shaderType.FRAGMENT &&
+            (function_ === es3fShaderTextureFunctionTests.TexFunction.TEXTURE ||
