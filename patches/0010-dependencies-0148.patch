+        console.log('Scissor test enabled: glScissor(0, 0, ' + gl.drawingBufferWidth + ', ' + gl.drawingBufferHeight + ')');
+    }
+
+    gl.useProgram(this.m_program.getProgram());
+
+    gl.enable(gl.DEPTH_TEST);
+    gl.depthRange(0, 1);
