+            deMath.deAlign32(this.m_width * pixelSize, 4) * this.m_height
+        );
+        var access = new tcuTexture.PixelBufferAccess({
+                format: this.m_texFormat,
+                width: this.m_width,
+                rowPitch: deMath.deAlign32(this.m_width * pixelSize, 4),
+                data: data
+            });
