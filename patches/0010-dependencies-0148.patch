+        runTestOnBindingTarget(gl.TEXTURE_2D, program);
+        program = tiu.setupTexturedQuadWithCubeMap(gl, internalFormat);
+        runTestOnBindingTarget(gl.TEXTURE_CUBE_MAP, program);
