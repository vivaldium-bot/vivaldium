+debug("");
+debug("Checking TexParameter: a set of inputs that are valid in GL but invalid in WebGL");
+
+testCases = [
+  { target: 0x0DE0, // GL_TEXTURE_1D
+    pname: gl.TEXTURE_WRAP_T,
+    param: gl.REPEAT,
+    expectedError: gl.INVALID_ENUM },
+  { target: gl.TEXTURE_2D,
+    pname: gl.TEXTURE_WRAP_T,
