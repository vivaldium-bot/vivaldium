+    for (var c = 0; c < 4; c++) {
+        var map = channelMap[c];
+        if (map == tcuTexture.channel.ZERO)
+            result[c] = 0;
+        else if (map == tcuTexture.channel.ONE)
+            result[c] = 1;
+        else
+            result[c] = tcuTexture.channelToFloat(pixelPtr[map], this.m_format.type);
+    }
