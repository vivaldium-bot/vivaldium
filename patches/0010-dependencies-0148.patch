+        // Compute ranges \note Doesn't handle case where src or dest is not subset of the another!
+        /** @type {tcuTextureUtil.TextureFormatInfo} */ var srcFmtRangeInfo = tcuTextureUtil.getTextureFormatInfo(srcFormat);
