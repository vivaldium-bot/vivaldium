--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/deqp/framework/common/tcuImageCompare.js
@@ -0,0 +1,741 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
