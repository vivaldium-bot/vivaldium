+        case gl.RGB10_A2UI:
+        case gl.R32F:
+        case gl.RG32F:
+        case gl.RGB32F:
+        case gl.RGBA32F:
+        case gl.R8I:
+        case gl.R8UI:
+        case gl.R16I:
+        case gl.R16UI:
+        case gl.R32I:
+        case gl.R32UI:
+        case gl.RG8I:
+        case gl.RG8UI:
+        case gl.RG16I:
+        case gl.RG16UI:
+        case gl.RG32I:
+        case gl.RG32UI:
+        case gl.RGB8I:
+        case gl.RGB8UI:
+        case gl.RGB16I:
+        case gl.RGB16UI:
+        case gl.RGB32I:
+        case gl.RGB32UI:
+        case gl.RGBA8I:
+        case gl.RGBA8UI:
