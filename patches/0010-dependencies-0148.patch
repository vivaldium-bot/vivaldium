+    	description(state.testCases.getDescription());
+
+    	try {
+    		//Run test cases
+    		tcuTestCase.runTestCases();
+    	}
+    	catch (err) {
+    		testFailedOptions('Failed to es3fFragDepthTests.run tests', false);
+    		tcuTestCase.runner.terminate();
+    	}
+    };
+
+});
