+            var curComp = this.m_path[this.m_path.length - 1]; // gluVarTypeUtil.VarTypeComponent&
+            curComp.index += 1;
+        }
+
+        for (;;) {
+
+            var curType = gluVarTypeUtil.getVarType(this.m_type, this.m_path); // VarType
+
+            if (this.isExpanded(curType))
