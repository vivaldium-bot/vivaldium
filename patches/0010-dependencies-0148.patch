+
+                if (inCount > 1) {
+                    builder += '\t' + variables.in1.getName() + ' = ' +
+                            inputs.in1[valueNdx] + '\n';
+                }
+
+                if (inCount > 2) {
+                    builder += '\t' + variables.in2.getName() + ' = ' +
+                            inputs.in2[valueNdx] + '\n';
+                }
+
+                if (inCount > 3) {
+                    builder += '\t' + variables.in3.getName() + ' = ' +
+                            inputs.in3[valueNdx] + '\n';
+                }
