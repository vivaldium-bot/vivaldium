+        case tcuTexture.CompareMode.COMPAREMODE_LESS: return gl.LESS;
+        case tcuTexture.CompareMode.COMPAREMODE_LESS_OR_EQUAL: return gl.LEQUAL;
+        case tcuTexture.CompareMode.COMPAREMODE_GREATER: return gl.GREATER;
