+const uint32_t kUnicodeParagraphSeparator = 0x2029;
+
+}  // namespace
+
+FDE_TXTEDTPARAMS::FDE_TXTEDTPARAMS()
+    : fPlateWidth(0),
+      fPlateHeight(0),
+      nLineCount(0),
+      dwLayoutStyles(0),
+      dwAlignment(0),
+      dwMode(0),
+      fFontSize(10.0f),
+      dwFontColor(0xff000000),
+      fLineSpace(10.0f),
+      fTabWidth(36),
+      wDefChar(0xFEFF),
+      wLineBreakChar('\n'),
+      nLineEnd(0),
+      nHorzScale(100),
+      fCharSpace(0),
+      pEventSink(nullptr) {}
+
+FDE_TXTEDTPARAMS::~FDE_TXTEDTPARAMS() {}
+
+FDE_TXTEDT_TEXTCHANGE_INFO::FDE_TXTEDT_TEXTCHANGE_INFO() {}
