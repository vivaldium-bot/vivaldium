+            return false; // Vertex attribute es3fTransformFeedbackTests.count exceeded.
+
+        // check varyings
+        /** @type {number} */ var totalTfComponents = 0;
+        /** @type {number} */ var totalTfAttribs = 0;
+        /** @type {Object.<number, number>} */ var presetNumComponents = {
+            gl_Position: 4,
+            gl_PointSize: 1
