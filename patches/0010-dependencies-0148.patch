+        /** @private */
+        this.m_tokenStart = 0;
+        /** @private */
+        this.m_tokenLen = 0;
+
+        this.advance();
+
+    };
+    gluVarTypeUtil.VarTokenizer.s_Token = {
+        IDENTIFIER: 0,
+        LEFT_BRACKET: 1,
+        RIGHT_BRACKET: 2,
+        PERIOD: 3,
+        NUMBER: 4,
+        END: 5
