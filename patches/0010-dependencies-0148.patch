index 0000000000000000000000000000000000000000..3d4252f0d30b740006ff5de657699637f21ca65a
--- /dev/null
+++ b/third_party/pdfium/testing/tools/make_expected.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+#
+# Copyright 2015 PDFium Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Script to generate expected result files.
+#
+set -e
+while (( "$#" )); do
+  INFILE="$1"
+  echo $INFILE | grep -qs ' ' && echo space in filename detected && exit 1
+  out/Debug/pdfium_test --png $INFILE
+  RESULTS="$INFILE.*.png"
+  for RESULT in $RESULTS ; do
+      EXPECTED=`echo -n $RESULT | sed 's/[.]pdf[.]/_expected.pdf./'`
+      mv $RESULT $EXPECTED
+  done
+  shift
+done
