+                'layout(location = 0) out ' + precName + ' ' + typeName + ' o_out;\n';
+
+         if (isVertexCase) {
+            vtx += 'flat out ' + precName + ' ' + typeName + ' v_out;\n';
+            frag += 'flat in ' + precName + ' ' + typeName + ' v_out;\n';
+        } else {
+            vtx += 'flat out ' + precName + ' ' + typeName + ' v_in0;\n' +
