+            output.name = name;
+            output.bufferNdx = bufNdx;
+            output.offset = offset;
+
+            if (name === 'gl_Position') {
+                var posIn = es3fTransformFeedbackTests.findAttributeNameEquals(attributes, 'a_position');
+                output.type = posIn.type;
+                output.inputs.push(posIn);
+            } else if (name === 'gl_PointSize') {
