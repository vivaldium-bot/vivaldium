+            '    }\n');
+
+        es3fShaderSwitchTests.makeSwitchCases(this, "scope", "Basic switch statement usage",
+            '    switch (${CONDITION})\n' +
+            '    {\n' +
+            '        case 0:        res = coords.xyz;    break;\n' +
