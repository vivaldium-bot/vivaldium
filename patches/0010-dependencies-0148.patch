diff --git a/third_party/webgl/src/sdk/tests/resources/glsl-generator.js b/third_party/webgl/src/sdk/tests/resources/glsl-generator.js
new file mode 100644
index 0000000000000000000000000000000000000000..940c0cd17b01983d803539a9b6f483de2666a42b
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/resources/glsl-generator.js
@@ -0,0 +1,1251 @@
+/*
+** Copyright (c) 2012 The Khronos Group Inc.
+**
+** Permission is hereby granted, free of charge, to any person obtaining a
+** copy of this software and/or associated documentation files (the
+** "Materials"), to deal in the Materials without restriction, including
