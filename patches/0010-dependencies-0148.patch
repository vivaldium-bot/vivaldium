+                gl, this.m_internalFormat,
+                this.m_width, this.m_height, this.m_depth
+            );
+
+            // Fill first gradient texture.
+            for (var levelNdx = 0; levelNdx < numLevels; levelNdx++) {
+                var gMin = deMath.add(
+                    deMath.multiply([0.0, 0.0, 0.0, 1.0], cScale), cBias
