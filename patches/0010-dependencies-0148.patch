+      : m_unit(eUnit), m_fValue(fValue) {}
+
+  FDE_CSSLength& Set(FDE_CSSLengthUnit eUnit) {
+    m_unit = eUnit;
+    return *this;
+  }
+
+  FDE_CSSLength& Set(FDE_CSSLengthUnit eUnit, float fValue) {
+    m_unit = eUnit;
+    m_fValue = fValue;
+    return *this;
+  }
+
+  FDE_CSSLengthUnit GetUnit() const { return m_unit; }
