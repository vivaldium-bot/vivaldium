+    expectedError: gl.NO_ERROR }
+];
+
+if (contextVersion < 2) {
+  testCases = testCases.concat([
+    { target: gl.TEXTURE_2D,
+      pname: 0x813A, // GL_TEXTURE_MIN_LOD
