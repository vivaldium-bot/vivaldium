+        // Compute buffers.
+        while (targets.length < numTargets) {
+            /** @type {gluShaderUtil.DataType} */ var outType = outTypes[targets.length];
+            /** @type {boolean} */ var isFloat = gluShaderUtil.isDataTypeFloatOrVec(outType);
