+            /** @type {string} */
+            var scalarType = gluShaderUtil.getDataTypeScalarType(attrib.type.getBasicType());
+            /** @type {number} */
+            var numComponents = gluShaderUtil.getDataTypeScalarSize(attrib.type.getBasicType());
