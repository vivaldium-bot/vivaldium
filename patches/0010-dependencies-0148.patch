+            return gluShaderUtil.isDataTypeSampler(type.getBasicType()) ? 1 : 0;
+        else if (type.isArrayType())
+            return es3fUniformApiTests.getNumSamplersInType(type.getElementType()) * type.getArraySize();
+        else {
