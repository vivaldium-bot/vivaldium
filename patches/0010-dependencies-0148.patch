+
+enum FDE_RENDERSTATUS {
+  FDE_RENDERSTATUS_Reset = 0,
+  FDE_RENDERSTATUS_Paused,
+  FDE_RENDERSTATUS_Done,
+  FDE_RENDERSTATUS_Failed,
+};
+
+class CFDE_RenderContext {
+ public:
+  CFDE_RenderContext();
