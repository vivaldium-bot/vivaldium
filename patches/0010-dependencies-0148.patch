+    /**
+     * InstancedGridRenderTest
+     * @constructor
+     * @extends {tcuTestCase.DeqpTest}
+     * @param {string} name
+     * @param {string} desc
+     * @param {number} gridSide
+     * @param {boolean} useIndices
+     */
+    es3fDrawTests.InstancedGridRenderTest = function(name, desc, gridSide, useIndices) {
