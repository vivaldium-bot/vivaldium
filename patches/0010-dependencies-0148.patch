+        return false;
+    };
+
+    /**
+    * @typedef {Array<(number | glsFboUtil.Range<number>)>}
+    */
+    glsFboUtil.formatT;
+
+    /**
+    * @param {glsFboUtil.FormatDB} db
+    * @param {glsFboUtil.Range<glsFboUtil.formatT>} stdFmts
