+
+const double kTolerance = 0.1f;
+
+}  // namespace
+
+CFDE_TxtEdtPage::CFDE_TxtEdtPage(CFDE_TxtEdtEngine* pEngine, int32_t nPageIndex)
+    : m_pEditEngine(pEngine),
+      m_pBgnParag(nullptr),
+      m_pEndParag(nullptr),
+      m_nRefCount(0),
+      m_nPageStart(-1),
+      m_nCharCount(0),
+      m_nPageIndex(nPageIndex),
+      m_bLoaded(false) {
+}
+
+CFDE_TxtEdtPage::~CFDE_TxtEdtPage() {}
+
