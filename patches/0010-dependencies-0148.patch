+        vtx += '    v_color = res.rgb;\n';
+        frag += '    o_color = vec4(v_color.rgb, 1.0);\n';
+    }
+    else {
+        vtx += '    v_coords = a_coords;\n';
+        frag += '    o_color = vec4(res.rgb, 1.0);\n';
