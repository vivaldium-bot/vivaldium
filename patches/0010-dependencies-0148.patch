+    glsVertexArrayTests.GLValue.getRandom = function(rnd, min, max) {
+        DE_ASSERT(min.getType() == max.getType());
+
+        var minv = min.interpret();
+        var maxv = max.interpret();
+        var type = min.getType();
+        var value;
+
+        if (maxv < minv)
+            return min;
+
+        switch (type) {
