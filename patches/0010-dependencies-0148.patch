+/** Common type limits
+ *
+ */
+tcuTexture.deTypes = {
+    deInt8: {min: -(1 << 7), max: (1 << 7) - 1},
+    deInt16: {min: -(1 << 15), max: (1 << 15) - 1},
+    deInt32: {min: -2147483648, max: 2147483647},
+    deUint8: {min: 0, max: (1 << 8) - 1},
+    deUint16: {min: 0, max: (1 << 16) - 1},
+    deUint32: {min: 0, max: 4294967295}
+};
