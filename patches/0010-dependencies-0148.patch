+        }
+        return true;
+    };
+
+    /**
+     * gluVarTypeUtil.VarTokenizer class.
+     * @param {string} str
+     * @constructor
+     */
+    gluVarTypeUtil.VarTokenizer = function(str) {
+
+        /** @private */
+        this.m_str = str;
