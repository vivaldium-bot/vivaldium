+            es3fFboCompletenessTests.numSamplesParams(2, 2, 0),
+            es3fFboCompletenessTests.numSamplesParams(1, 1, 1),
+            es3fFboCompletenessTests.numSamplesParams(1, 2, 4)
+        ];
+
+        for (var i = 0; i < s_samplesParams.length; ++i) {
