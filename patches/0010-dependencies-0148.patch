+            runOneIteration(image, cases[i].flipY,
+                            cases[i].topColor, cases[i].bottomColor,
+                            gl.TEXTURE_3D, program);
+        }
+        program = tiu.setupTexturedQuadWith2DArray(gl, internalFormat);
+        for (var i in cases) {
+            runOneIteration(image, cases[i].flipY,
