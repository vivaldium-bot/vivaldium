+            gl.TEXTURE_2D, 0, this.m_subX, this.m_subY,
+            this.m_subW, this.m_subH,
+            transferFmt.format, transferFmt.dataType,
+            new Uint8Array(data, 0, rowPitch * height)
+        );
+    };
