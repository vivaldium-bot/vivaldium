+        // Step 2: Compare using bilinear sampling.
+        // \todo [pyry] Optimize sample positions!
+        /** @const {Array<Array<number>>} */ var s_offsets = [
+            [226, 186],
+            [335, 235],
+            [279, 334],
+            [178, 272],
+            [112, 202],
+            [306, 117],
+            [396, 299],
+            [206, 382],
+            [146, 96],
+            [423, 155],
+            [361, 412],
+            [84, 339],
+            [48, 130],
+            [367, 43],
+            [455, 367],
+            [105, 439],
+            [83, 46],
+            [217, 24],
+            [461, 71],
+            [450, 459],
+            [239, 469],
+            [67, 267],
+            [459, 255],
+            [13, 416],
+            [10, 192],
+            [141, 502],
+            [503, 304],
+            [380, 506]
+        ];
