+                }
+                if (curComp.index + 1 < parentType.getStruct().getNumMembers()) {
+                    break;
+                }
+
+            }
+
+            this.m_path.pop();
+        }
+    };
+    gluVarTypeUtil.SubTypeIterator.prototype.findNext = function() {
