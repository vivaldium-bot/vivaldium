+            es3fTextureShadowTests.init();
+            //Run test cases
+            tcuTestCase.runTestCases();
+        }
+        catch (err) {
+            bufferedLogToConsole(err);
+            tcuTestCase.runner.terminate();
+        }
+    };
+});
