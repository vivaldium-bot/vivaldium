+gluTextureUtil.isGLInternalColorFormatFilterable = function(format) {
+    switch (format) {
+        case gl.R8:
+        case gl.R8_SNORM:
+        case gl.RG8:
+        case gl.RG8_SNORM:
+        case gl.RGB8:
+        case gl.RGB8_SNORM:
+        case gl.RGB565:
+        case gl.RGBA4:
+        case gl.RGB5_A1:
+        case gl.RGBA8:
+        case gl.RGBA8_SNORM:
+        case gl.RGB10_A2:
+        case gl.SRGB8:
+        case gl.SRGB8_ALPHA8:
+        case gl.R16F:
+        case gl.RG16F:
+        case gl.RGB16F:
+        case gl.RGBA16F:
+        case gl.R11F_G11F_B10F:
