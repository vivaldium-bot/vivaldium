-    // But optionChangeEvent is still usable tho, so...
-    optionChangeEvent.updateWith(validDetails);
-
-    assert_throws(
-      "InvalidStateError",
-      () => {
-        optionChangeEvent.updateWith(validDetails);
-      },
-      "optionChangeEvent [[waitingForUpdate]] is true, so it must throw"
-    );
-
-    const response = await responsePromise;
