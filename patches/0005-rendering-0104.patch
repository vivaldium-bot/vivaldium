-    # Convert to XHTML, because it's quicker to re-parse than HTML5
-    doc.documentElement.setAttribute('xmlns', 'http://www.w3.org/1999/xhtml')
-    doc.removeChild(doc.firstChild) # remove the DOCTYPE
