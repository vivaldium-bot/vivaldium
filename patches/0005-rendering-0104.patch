-// A regex object for UUID(http://tools.ietf.org/html/rfc4122) validation.
-var pattern = new RegExp(['^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-',
-                           '9a-f]{3}-[0-9a-f]{12}$'].join(''), 'i');
