-      ++invalidNumberCount;
-    }
-  }
-
-  should(
-      invalidNumberCount, 'Number of non-finite values in the rendered output')
-      .beEqualTo(0);
-
-  should(maxError, 'Max error in ' + filterTypeName[filterType] + ' response')
-      .beLessThanOrEqualTo(maxAllowedError);
-}
