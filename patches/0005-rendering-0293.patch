+Node* PropertyAccessBuilder::ResolveHolder(
+    PropertyAccessInfo const& access_info, Node* receiver) {
+  Handle<JSObject> holder;
+  if (access_info.holder().ToHandle(&holder)) {
+    return jsgraph()->Constant(holder);
+  }
+  return receiver;
+}
