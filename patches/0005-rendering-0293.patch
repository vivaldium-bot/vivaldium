-  let b1;
-  let b2;
-  let a0;
-  let a1;
-  let a2;
-  let coef;
-
-  if (freq > 0 && freq < 1) {
-    if (q > 0) {
-      let w0 = Math.PI * freq;
-      let alpha = Math.sin(w0) / (2 * q);
-      let k = Math.cos(w0);
-
-      b0 = 1 - alpha;
-      b1 = -2 * k;
-      b2 = 1 + alpha;
-      a0 = 1 + alpha;
-      a1 = -2 * k;
-      a2 = 1 - alpha;
-      coef = normalizeFilterCoefficients(b0, b1, b2, a0, a1, a2);
-    } else {
-      // q = 0
-      coef = {b0: -1, b1: 0, b2: 0, a1: 0, a2: 0};
-    }
-  } else {
-    coef = {b0: 1, b1: 0, b2: 0, a1: 0, a2: 0};
