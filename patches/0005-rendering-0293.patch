+Reduction JSGenericLowering::Reduce(Node* node) {
+  switch (node->opcode()) {
+#define DECLARE_CASE(x)  \
+    case IrOpcode::k##x: \
+      Lower##x(node);    \
+      break;
+    JS_OP_LIST(DECLARE_CASE)
+#undef DECLARE_CASE
+    default:
+      // Nothing to see.
+      return NoChange();
+  }
+  return Changed(node);
+}
