+    this.end_position = raw_array[2];
+    this.param_num = raw_array[3];
+    this.scope_info = raw_array[4];
+    this.outer_index = raw_array[5];
+    this.shared_function_info = raw_array[6];
+    this.function_literal_id = raw_array[7];
