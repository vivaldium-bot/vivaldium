-function createNotchFilter(freq, q, gain) {
-  let b0;
-  let b1;
-  let b2;
-  let a0;
-  let a1;
-  let a2;
-  let coef;
-
-  if (freq > 0 && freq < 1) {
-    if (q > 0) {
-      let w0 = Math.PI * freq;
-      let alpha = Math.sin(w0) / (2 * q);
-      let k = Math.cos(w0);
-
-      b0 = 1;
-      b1 = -2 * k;
-      b2 = 1;
