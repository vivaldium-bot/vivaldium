+
+void Shell::QuitOnce(v8::FunctionCallbackInfo<v8::Value>* args) {
+  int exit_code = (*args)[0]
+                      ->Int32Value(args->GetIsolate()->GetCurrentContext())
+                      .FromMaybe(0);
+  CleanupWorkers();
+  args->GetIsolate()->Exit();
+  OnExit(args->GetIsolate());
+  Exit(exit_code);
+}
