-
-function filterData(filterCoef, signal, len) {
-  let y = new Array(len);
-  let b0 = filterCoef.b0;
-  let b1 = filterCoef.b1;
-  let b2 = filterCoef.b2;
-  let a1 = filterCoef.a1;
-  let a2 = filterCoef.a2;
