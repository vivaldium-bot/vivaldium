+size_t FrameStateDescriptor::GetTotalSize() const {
+  size_t total_size = 0;
+  for (const FrameStateDescriptor* iter = this; iter != nullptr;
+       iter = iter->outer_state_) {
+    total_size += iter->GetSize();
