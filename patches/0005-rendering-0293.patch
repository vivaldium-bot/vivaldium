+  int size = map->instance_size();
+  Struct* result = nullptr;
+  {
+    AllocationResult allocation = Allocate(map, OLD_SPACE);
+    if (!allocation.To(&result)) return allocation;
+  }
+  result->InitializeBody(size);
+  return result;
