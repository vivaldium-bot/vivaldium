+  bool first = true;
+  PrintableInstructionOperand poi = {GetRegConfig(), InstructionOperand()};
+  for (const InstructionOperand& op : pm.reference_operands_) {
+    if (!first) {
+      os << ";";
+    } else {
+      first = false;
+    }
+    poi.op_ = op;
+    os << poi;
+  }
+  return os << "}";
