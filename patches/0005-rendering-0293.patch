-// Apply the windowing function, in place.
-function applyWindow(timeData) {
-  let length = timeData.length;
-  let alpha = 0.16;
-  let a0 = (1 - alpha) / 2;
-  let a1 = 0.5;
-  let a2 = alpha / 2;
-  let omega = 2 * Math.PI / length;
-
-  for (let k = 0; k < length; ++k) {
-    let w = a0 - a1 * Math.cos(omega * k) + a2 * Math.cos(2 * omega * k);
-    timeData[k] *= w;
-  }
