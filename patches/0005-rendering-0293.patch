+RUNTIME_FUNCTION(Runtime_StoreCallbackProperty) {
+  Handle<JSObject> receiver = args.at<JSObject>(0);
+  Handle<JSObject> holder = args.at<JSObject>(1);
+  Handle<HeapObject> callback_or_cell = args.at<HeapObject>(2);
