+void BytecodeGraphBuilder::BuildJumpIf(Node* condition) {
+  NewBranch(condition);
+  {
+    SubEnvironment sub_environment(this);
+    NewIfTrue();
+    MergeIntoSuccessorEnvironment(bytecode_iterator().GetJumpTargetOffset());
+  }
+  NewIfFalse();
+}
