-  assert_not_equals(matB, null);
-
-  assert_equals(matA.length, 16);
-  assert_equals(matB.length, 16);
-  for (let i = 0; i < 16; ++i) {
-    assert_approx_equals(matA[i], matB[i], epsilon);
-  }
-}
