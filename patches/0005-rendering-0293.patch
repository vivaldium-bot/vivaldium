-  'bandpass': createBandpassFilter,
-  'lowshelf': createLowShelfFilter,
-  'highshelf': createHighShelfFilter,
-  'peaking': createPeakingFilter,
-  'notch': createNotchFilter,
-  'allpass': createAllpassFilter
