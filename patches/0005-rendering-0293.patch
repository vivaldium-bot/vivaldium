-        //   = 1/(-0.5-0.99)/(z + 0.5) - 1/(-0.5-0.99)/(z - 0.99)
-        //   = 1/1.49*(1/(z-0.99) - 1/(z+0.5))
-        //   = 1/1.49*[1/z*sum(.99^n/z^n,n,0,inf)
