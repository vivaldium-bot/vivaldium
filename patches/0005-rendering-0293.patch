+int InstructionScheduler::GetTargetInstructionFlags(
+    const Instruction* instr) const {
+  switch (instr->arch_opcode()) {
+    case kIA32Add:
+    case kIA32And:
+    case kIA32Cmp:
+    case kIA32Cmp16:
+    case kIA32Cmp8:
+    case kIA32Test:
+    case kIA32Test16:
+    case kIA32Test8:
+    case kIA32Or:
+    case kIA32Xor:
