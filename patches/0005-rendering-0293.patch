-vr_test( (t) => {
-  return navigator.getVRDisplays().then( (displays) => {
-    let display = displays[0];
-
-    function onAnimationFrameBad() {
-      t.step( () => {
-        assert_unreached();
-      }, "Unregistered callback was called");
-      t.done();
