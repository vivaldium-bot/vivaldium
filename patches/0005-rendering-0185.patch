-        text run at (0,60) width 303: "been fixed in subsequent builds."
-    LayoutBlockFlow {H2} at (0,422.42) size 512x29
-      LayoutText {#text} at (0,-4) size 93x36
-        text run at (0,-4) width 93: "Bug 2"
