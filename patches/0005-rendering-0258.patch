+
+  table_.Register(kVisitPropertyCell,
+                  &FixedBodyVisitor<StaticVisitor, PropertyCell::BodyDescriptor,
+                                    void>::Visit);
+
+  table_.Register(kVisitWeakCell, &VisitWeakCell);
