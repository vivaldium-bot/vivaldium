+    left = UseRegisterAtStart(instr->left());
+    right = UseRegisterAtStart(instr->right());
+  }
+  LMathMinMax* minmax = new (zone()) LMathMinMax(left, right, scratch);
+  return DefineSameAsFirst(minmax);
+}
