+void Heap::ZapFromSpace() {
+  if (!new_space_->IsFromSpaceCommitted()) return;
+  for (Page* page :
+       PageRange(new_space_->FromSpaceStart(), new_space_->FromSpaceEnd())) {
+    for (Address cursor = page->area_start(), limit = page->area_end();
