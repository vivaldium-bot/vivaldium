+void LCodeGen::Deoptimize(LInstruction* instr, DeoptimizeReason deopt_reason,
+                          Deoptimizer::BailoutType* override_bailout_type) {
+  DeoptimizeBranch(instr, deopt_reason, always, NoReg, -1,
+                   override_bailout_type);
+}
