+#ifndef V8_CRANKSHAFT_TYPING_H_
+#define V8_CRANKSHAFT_TYPING_H_
+
+#include "src/allocation.h"
+#include "src/ast/ast-type-bounds.h"
+#include "src/ast/ast-types.h"
+#include "src/ast/ast.h"
+#include "src/ast/variables.h"
