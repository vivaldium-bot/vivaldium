+Deoptimizer* Deoptimizer::Grab(Isolate* isolate) {
+  Deoptimizer* result = isolate->deoptimizer_data()->current_;
+  CHECK_NOT_NULL(result);
+  result->DeleteFrameDescriptions();
+  isolate->deoptimizer_data()->current_ = NULL;
+  return result;
+}
