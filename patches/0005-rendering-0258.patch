+void GlobalHandles::IdentifyWeakHandles(WeakSlotCallback f) {
+  for (NodeIterator it(this); !it.done(); it.Advance()) {
+    if (it.node()->IsWeak() && f(it.node()->location())) {
+      it.node()->MarkPending();
+    }
+  }
+}
