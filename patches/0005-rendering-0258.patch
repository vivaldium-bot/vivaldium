-              } else {
-                testFailed("offlineContext.resume() on a closed context rejected but expected InvalidStateError, not: " + e);
-              }
-            }
-          ).then(done);
-        });
-
-      });
-    });
-
-    audit.defineTask('finish-test', function (done) {
-      done();
-      finishJSTest();
-    });
-
-    audit.runTasks(
