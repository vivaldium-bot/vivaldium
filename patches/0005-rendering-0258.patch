+void HBasicBlock::Verify() {
+  // Check that every block is finished.
+  DCHECK(IsFinished());
+  DCHECK(block_id() >= 0);
+
+  // Check that the incoming edges are in edge split form.
+  if (predecessors_.length() > 1) {
