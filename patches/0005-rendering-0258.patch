+  };
+
+  Register reg = ToRegister(instr->result());
+
+  DeferredNumberTagD* deferred =
+      new(zone()) DeferredNumberTagD(this, instr);
+  if (FLAG_inline_new) {
+    Register tmp = ToRegister(instr->temp());
+    __ AllocateHeapNumber(reg, tmp, no_reg, deferred->entry());
+  } else {
