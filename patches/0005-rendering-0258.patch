+#ifndef V8_COMPILER_TYPES_H_
+#define V8_COMPILER_TYPES_H_
+
+#include "src/base/compiler-specific.h"
+#include "src/conversions.h"
+#include "src/globals.h"
+#include "src/handles.h"
