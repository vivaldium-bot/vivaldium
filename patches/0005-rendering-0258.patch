-                + ": renderFrames (" + test.renderFrames + ") outside the range [0, "
-                + testSpacingFrames + "]");
-        }
-        source.start(startTime, offset);
-        source.stop(startTime + duration);
-    } else {
-        testFailed("Test " + testNumber + " must specify renderFrames and possibly durationFrames");
-    }
