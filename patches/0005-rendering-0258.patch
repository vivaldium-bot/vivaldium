+void HGraph::FinalizeUniqueness() {
+  DisallowHeapAllocation no_gc;
+  for (int i = 0; i < blocks()->length(); ++i) {
+    for (HInstructionIterator it(blocks()->at(i)); !it.Done(); it.Advance()) {
+      it.Current()->FinalizeUniqueness();
+    }
+  }
