+template <typename StaticVisitor>
+void StaticMarkingVisitor<StaticVisitor>::VisitNativeContext(
+    Map* map, HeapObject* object) {
+  FixedBodyVisitor<StaticVisitor, Context::MarkCompactBodyDescriptor,
+                   void>::Visit(map, object);
+}
