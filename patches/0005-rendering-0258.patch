+static MemoryChunk* AllocateCodeChunk(MemoryAllocator* allocator) {
+  return allocator->AllocateChunk(Deoptimizer::GetMaxDeoptTableSize(),
+                                  MemoryAllocator::GetCommitPageSize(),
+                                  EXECUTABLE, NULL);
+}
