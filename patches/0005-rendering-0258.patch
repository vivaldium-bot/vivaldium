+  DCHECK(owner()->HasStackOverflow() || owner()->current_block() == NULL ||
+         (owner()->environment()->length() == original_length_ &&
+          (owner()->environment()->frame_type() == JS_FUNCTION ||
+           owner()->environment()->frame_type() == TAIL_CALLER_FUNCTION)));
