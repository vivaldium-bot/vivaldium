+    // This would never happen, since we got the locale from ICU.
+    JSObject::SetProperty(resolved, factory->NewStringFromStaticChars("locale"),
+                          factory->NewStringFromStaticChars("und"),
+                          SLOPPY).Assert();
+  }
+}
+
+}  // namespace
