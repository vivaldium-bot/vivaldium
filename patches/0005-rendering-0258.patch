+ScopeIterator::ScopeIterator(Isolate* isolate, FrameInspector* frame_inspector,
+                             ScopeIterator::Option option)
+    : isolate_(isolate),
+      frame_inspector_(frame_inspector),
+      nested_scope_chain_(4),
