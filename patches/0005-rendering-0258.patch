+
+Debug.setBreakPointByScriptIdAndPosition = function(script_id, position,
+                                                    condition, enabled,
+                                                    opt_position_alignment)
+{
+  var break_point = MakeBreakPoint(position);
+  break_point.setCondition(condition);
+  if (!enabled) {
+    break_point.disable();
+  }
