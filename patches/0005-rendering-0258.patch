+  void RemovePhi(HPhi* phi);
+  void AddInstruction(HInstruction* instr, SourcePosition position);
+  bool Dominates(HBasicBlock* other) const;
+  bool EqualToOrDominates(HBasicBlock* other) const;
+  int LoopNestingDepth() const;
+
