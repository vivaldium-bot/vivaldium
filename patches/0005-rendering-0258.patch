+#ifndef V8_OBJECTS_VISITING_H_
+#define V8_OBJECTS_VISITING_H_
+
+#include "src/allocation.h"
+#include "src/heap/embedder-tracing.h"
+#include "src/heap/heap.h"
+#include "src/heap/spaces.h"
+#include "src/layout-descriptor.h"
