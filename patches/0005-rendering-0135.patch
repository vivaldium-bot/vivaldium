-  ["http://host/a?x=y#z", "?", "http://host/a?"],
-  ["http://host/a?x=y#z", "?foo=bar#com", "http://host/a?foo=bar#com"],
-  // Ref input
-  ["http://host/a", "#ref", "http://host/a#ref"],
-  ["http://host/a#b", "#", "http://host/a#"],
-  ["http://host/a?foo=bar#hello", "#bye", "http://host/a?foo=bar#bye"],
