@@ -0,0 +1,63 @@
+<!-- ================= Events view =================== -->
+<dom-module id="events-view">
+  <template>
+    <!-- Filter Box: This the top bar which contains the search box.  -->
+    <div id=events-view-filter-box>
+      <table width=100%>
+        <tr>
+          <td width=1%>
