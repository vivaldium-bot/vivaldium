+      # Decrease in indentation level indicates a new report is being printed.
+      if current_indentation >= last_indentation:
+        report_key, report_value = report_line.split(':', 1)
+        if report_value:
+          report_dict[report_key.strip()] = report_value.strip()
+      elif report_dict:
