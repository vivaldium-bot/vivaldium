+    def read(self, directory):
+        """Read the last status in `directory`."""
+        usable = False
+        try:
+            status_file = os.path.join(directory, self.STATUS_FILE)
+            with open(status_file, "r") as fstatus:
+                status = json.load(fstatus)
+        except (IOError, ValueError):
+            usable = False
