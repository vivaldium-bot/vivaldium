+
+  mouseZoomOut(1);
+  sanityCheckWithTimeRange(true);
+
+  mouseZoomAllTheWayIn();
+  sanityCheckWithTimeRange(true);
+
+  mouseZoomOut(1);
+  sanityCheckWithTimeRange(true);
+
+  testDone();
+});
