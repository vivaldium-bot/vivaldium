+  if (!BN_set_word(e.get(), RSA_F4) ||
+      !RSA_generate_key_ex(rsa.get(), bits, e.get(), NULL) ||
+      !PEM_write_bio_RSAPrivateKey(bio.get(), rsa.get(), NULL /* cipher */,
