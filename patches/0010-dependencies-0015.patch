+    def _charset__get(self):
+        """
+        Get/set the charset (in the Content-Type)
+        """
+        header = self.headers.get('Content-Type')
+        if not header:
+            return None
+        match = CHARSET_RE.search(header)
+        if match:
+            return match.group(1)
+        return None
