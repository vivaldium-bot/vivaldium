+class LimitedLengthFile(io.RawIOBase):
+    def __init__(self, file, maxlen):
+        self.file = file
+        self.maxlen = maxlen
+        self.remaining = maxlen
+
+    def __repr__(self):
+        return '<%s(%r, maxlen=%s)>' % (
+            self.__class__.__name__,
+            self.file,
+            self.maxlen
+        )
+
+    def fileno(self):
+        return self.file.fileno()
