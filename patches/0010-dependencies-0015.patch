--- /dev/null
+++ b/third_party/breakpad/breakpad/src/common/linux/file_id.cc
@@ -0,0 +1,201 @@
+// Copyright (c) 2006, Google Inc.
+// All rights reserved.
+//
+// Redistribution and use in source and binary forms, with or without
