+    ps = path_set.PathSet()
+    self.assertEqual(len(ps), 0)  # Check __len__.
+    self.assertFalse(__file__ in ps)
+    for _ in ps:  # Check __iter__.
+      self.fail('New set is not empty.')
+
+    ps = path_set.PathSet([__file__])
