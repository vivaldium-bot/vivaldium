+  def testTranslateScalarValue(self):
+    story_set = story.StorySet(base_dir=os.path.dirname(__file__))
+    p = page.Page('http://www.foo.com/', story_set, story_set.base_dir)
+
+    scalar_value = {
+        'type': 'numeric',
