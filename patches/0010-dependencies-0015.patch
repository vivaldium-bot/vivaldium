+# Parse rectangle bounds given as: '[left,top][right,bottom]'.
+RE_BOUNDS = re.compile(
+    r'\[(?P<left>\d+),(?P<top>\d+)\]\[(?P<right>\d+),(?P<bottom>\d+)\]')
