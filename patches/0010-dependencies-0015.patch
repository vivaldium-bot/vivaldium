+def CaptureStderr(func, output_buffer):
+  def wrapper(*args, **kwargs):
+    original_stderr, sys.stderr = sys.stderr, output_buffer
+    try:
+      return func(*args, **kwargs)
+    finally:
+      sys.stderr = original_stderr
+  return wrapper
