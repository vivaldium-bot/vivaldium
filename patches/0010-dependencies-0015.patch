+      logging.info('No minidump found via crashpad_database_util')
+      dumps = self._GetBreakPadMinidumpPaths()
+      if dumps:
+        most_recent_dump = heapq.nlargest(1, dumps, os.path.getmtime)[0]
+        if most_recent_dump:
