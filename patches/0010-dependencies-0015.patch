+    arch_name = self.browser.platform.GetArchName()
+    stackwalk = binary_manager.FetchPath(
+        'minidump_stackwalk', arch_name, os_name)
+    if not stackwalk:
+      logging.warning('minidump_stackwalk binary not found.')
+      return None
