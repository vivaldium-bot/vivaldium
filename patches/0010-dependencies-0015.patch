+        f.write(str(int(time.time() - 2 * SECONDS_PER_DAY)))
+      self.running_interactively = False
+      self.assertEqual(
+          False,
+          self.command_runner.MaybeCheckForAndOfferSoftwareUpdate('ls', 0))
