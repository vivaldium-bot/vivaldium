+    def __repr__(self):
+        inner = repr(self.vars)
+        if len(inner) > 20:
+            inner = inner[:15] + '...' + inner[-5:]
+        return '<%s at 0x%x viewing %s>' % (
+            self.__class__.__name__,
+            abs(id(self)), inner)
