+          while stream_bytes:
+            out_fp.write(stream_bytes)
+            stream_bytes = upload_stream.read(DEFAULT_FILE_BUFFER_SIZE)
+        with open(temp_path, 'rb') as in_fp:
+          dst_uri.set_contents_from_file(in_fp, policy=canned_acl,
+                                         headers=headers)
+      finally:
+        os.close(temp_fh)
+        os.unlink(temp_path)
