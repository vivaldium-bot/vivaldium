+  def testFiveGarbageCollectionCallsByDefault(self):
+    mock_shared_state = mock.Mock()
+    p = page.Page('file://foo.html')
+    p.Run(mock_shared_state)
+    expected = [mock.call.current_tab.CollectGarbage(),
