+        key.translate(None, _valid_token_bytes)
+        # Not explicitly required by RFC6265, may consider removing later:
+        or key[0] == _b_dollar_sign
+        or key.lower() in _c_keys
+    )
+
+def _path_quote(v):
+    return b''.join(map(_escape_char, v))
+
