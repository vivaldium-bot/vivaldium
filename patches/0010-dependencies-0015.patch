+            'type': 'scalar',
+            'unit': 'timeInMs_smallerIsBetter',
+            'value': 42
+        },
+        'name': 'foo',
+        'description': 'desc'
+    }
+
+    v = common_value_helpers.TranslateScalarValue(scalar_value, p)
