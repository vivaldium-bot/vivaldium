+
+    class NonGarbageCollectPage(page.Page):
+
+      def __init__(self, url):
+        super(NonGarbageCollectPage, self).__init__(url)
+        self._collect_garbage_before_run = False
+
+    p = NonGarbageCollectPage('file://foo.html')
