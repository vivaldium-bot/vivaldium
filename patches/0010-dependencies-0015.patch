+
+  // This symbol must be visible to dlsym() - see
+  // https://bugs.chromium.org/p/google-breakpad/issues/detail?id=345 for details.
+  kern_return_t catch_exception_raise(mach_port_t target_port,
+                                      mach_port_t failed_thread,
