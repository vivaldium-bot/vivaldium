+        if not value:
+            self._content_type__del()
+            return
+        if ';' not in value:
+            header = self.headers.get('Content-Type', '')
+            if ';' in header:
+                params = header.split(';', 1)[1]
+                value += ';' + params
+        self.headers['Content-Type'] = value
