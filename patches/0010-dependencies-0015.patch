index 0000000000000000000000000000000000000000..180873f4051ef59d146bc71fc7f34a18b9b0e2e1
--- /dev/null
+++ b/third_party/breakpad/breakpad/src/client/linux/microdump_writer/microdump_writer.cc
@@ -0,0 +1,666 @@
+// Copyright (c) 2014, Google Inc.
+// All rights reserved.
+//
