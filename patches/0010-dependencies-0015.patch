diff --git a/third_party/catapult/third_party/coverage/coverage/annotate.py b/third_party/catapult/third_party/coverage/coverage/annotate.py
new file mode 100644
index 0000000000000000000000000000000000000000..4060450fffb3bd5d8360421234e973495c13ab9e
--- /dev/null
