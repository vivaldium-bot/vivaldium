+    response_handler.return_value = {
+      'result': {},
+      'error': {
+        'code': -32601  # Method does not exist.
+      }
+    }
+    backend.SimulateMemoryPressureNotification('critical')
+    self.assertEqual(1, response_handler.call_count)
