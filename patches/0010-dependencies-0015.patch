+            ',crc32c=%s' % object_metadata.crc32c.rstrip('\n'))
+      else:
+        headers['x-goog-hash'] = (
+            'crc32c=%s' % object_metadata.crc32c.rstrip('\n'))
+    if object_metadata.md5Hash:
+      if 'x-goog-hash' in headers:
+        headers['x-goog-hash'] += (
+            ',md5=%s' % object_metadata.md5Hash.rstrip('\n'))
+      else:
