+    self.assertEquals(story_set[1].display_name, 'bar.html')
+
+  def testDisplayUrlForFilesDifferingBySuffix(self):
+    story_set = story.StorySet(base_dir=os.path.dirname(__file__))
+    story_set.AddStory(page.Page(
