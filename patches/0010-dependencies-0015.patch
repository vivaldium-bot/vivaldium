+  def testRecursiveChangeAcl(self):
+    """Tests recursively changing ACLs on nested objects."""
+    obj = self.CreateObject(bucket_uri=self.sample_uri, object_name='foo/bar',
+                            contents='something')
+    self.AssertNObjectsInBucket(self.sample_uri, 1)
