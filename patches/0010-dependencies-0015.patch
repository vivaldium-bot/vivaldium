+# Make sure a generated file isn't accidentally committed.
+reduced.pylintrc
diff --git a/third_party/catapult/third_party/gsutil/third_party/apitools/.travis.yml b/third_party/catapult/third_party/gsutil/third_party/apitools/.travis.yml
new file mode 100644
index 0000000000000000000000000000000000000000..5bbdd50f9998128e2eb72e21755c0644380dbe94
--- /dev/null
+++ b/third_party/catapult/third_party/gsutil/third_party/apitools/.travis.yml
@@ -0,0 +1,14 @@
+language: python
+sudo: false
+env:
+  - TOX_ENV=py26
+  - TOX_ENV=py27
+  - TOX_ENV=py34
+  - TOX_ENV=pypy
+  - TOX_ENV=lint
+install:
+  - pip install tox
+  - pip install . --allow-external argparse
+script: tox -e $TOX_ENV
+after_success:
+  - if [[ "${TOX_ENV}" == "py27" ]]; then tox -e coveralls; fi
