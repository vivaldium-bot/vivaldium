-    var p9 = createImageBitmap(video, 400, 300, 300, 300).then(
-        function (image) { imageBitmaps.emptyTwo = image });
-    var p10 = createImageBitmap(video, 0, 0, Math.pow(10, 6),
-                                Math.pow(10, 6)).then(
-        function(image) { imageBitmaps.hugeCrop = image });
