-                                        text run at (3,2) width 21: "30.1"
-                            LayoutBlockFlow {HR} at (2,464) size 250x1 [border: (1px inset #EEEEEE) none (1px inset #EEEEEE)]
-                    LayoutText {#text} at (0,0) size 179x239
-                      text run at (0,0) width 156: "Known as ``Wilt the Stilt''"
-                      text run at (0,20) width 179: "and ``The Big Dipper,'' the 7-"
-                      text run at (0,40) width 118: "foot-1 Chamberlain"
-                      text run at (0,60) width 154: "dominated the NBA from"
-                      text run at (0,80) width 175: "1959 through 1973, when he"
-                      text run at (0,100) width 159: "played for the Philadelphia"
-                      text run at (0,120) width 148: "(later the San Francisco)"
-                      text run at (0,140) width 165: "Warriors, the 76ers and the"
-                      text run at (0,160) width 161: "Lakers. He scored 31,419"
-                      text run at (0,180) width 143: "points during his career,"
-                      text run at (0,200) width 170: "averaging 30.1 points for his"
-                      text run at (0,220) width 42: "career."
-                  LayoutBlockFlow {P} at (0,256) size 440x60
-                    LayoutText {#text} at (0,0) size 146x59
-                      text run at (0,0) width 146: "He also led the league in"
-                      text run at (0,20) width 138: "career rebounding with"
-                      text run at (0,40) width 48: "23,924."
-                  LayoutBlockFlow {P} at (0,332) size 440x180
-                    LayoutText {#text} at (0,0) size 180x179
-                      text run at (0,0) width 171: "One of only two men named"
-                      text run at (0,20) width 171: "MVP and rookie of the year"
-                      text run at (0,40) width 180: "in the same season (1959), he"
-                      text run at (0,60) width 140: "was also MVP in 1966"
-                      text run at (0,80) width 151: "through 1968. He led the"
-                      text run at (0,100) width 179: "NBA in scoring seven straight"
-                      text run at (0,120) width 169: "seasons, 1960 to 1966, and"
-                      text run at (0,140) width 167: "led the league in rebounding"
-                      text run at (0,160) width 127: "11 of his 14 seasons."
-                  LayoutBlockFlow {P} at (0,528) size 440x60
-                    LayoutText {#text} at (0,0) size 420x59
-                      text run at (0,0) width 420: "One of his most famous records is the 100 points he scored in a single"
-                      text run at (0,20) width 410: "game in the Philadelphia Warriors' 169-147 defeat of the New York"
-                      text run at (0,40) width 257: "Knicks on March 2, 1962, in Hershey, Pa."
