+class ScopedDefaultValue {
+ public:
+  explicit ScopedDefaultValue(const T& default_value) {
+    DefaultValue<T>::Set(default_value);
+  }
+
+  ~ScopedDefaultValue() { DefaultValue<T>::Clear(); }
+};
