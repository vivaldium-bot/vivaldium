+                          EXC_BREAKPOINT);
+  }
+  {
+    SCOPED_TRACE("trailing_NUL_short");
+    TestStringToException(base::StringPiece("BREAKPOINTED", 10),
+                          kAllowShortName,
+                          true,
+                          EXC_BREAKPOINT);
+  }
+}
