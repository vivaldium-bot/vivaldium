+void InitializeMachMsgPortDescriptor(mach_msg_port_descriptor_t* descriptor,
+                                     mach_port_t port) {
+  descriptor->name = port;
+  descriptor->disposition = MACH_MSG_TYPE_PORT_SEND;
+  descriptor->type = MACH_MSG_PORT_DESCRIPTOR;
+}
