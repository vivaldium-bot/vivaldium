+         index < arraysize(kThreadStateFlavorTestData);
+         ++index) {
+      SCOPED_TRACE(base::StringPrintf("index %zu", index));
+      thread_state_flavor_t flavor = kThreadStateFlavorTestData[index].flavor;
+      {
+        SCOPED_TRACE("full_name");
