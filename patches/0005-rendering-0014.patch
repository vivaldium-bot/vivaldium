+    : WebGLObject(context),
+      m_contextGroup(context->contextGroup())
+{
+}
+
+WebGLSharedObject::~WebGLSharedObject()
+{
+    if (m_contextGroup)
+        m_contextGroup->removeObject(this);
+}
+
+void WebGLSharedObject::detachContextGroup()
+{
+    detach();
+    if (m_contextGroup) {
+        deleteObject(nullptr);
+        m_contextGroup->removeObject(this);
+        m_contextGroup = nullptr;
+    }
+}
