+            context->framebufferRenderbuffer(target, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, 0);
+        } else {
+            context->framebufferRenderbuffer(target, attachment, GL_RENDERBUFFER, 0);
+        }
+    }
