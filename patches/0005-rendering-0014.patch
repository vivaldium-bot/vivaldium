+    case GL_SRGB8:
+        return GL_UNSIGNED_BYTE;
+    case GL_RGB565:
+        return GL_UNSIGNED_SHORT_5_6_5;
+    case GL_RGB8_SNORM:
+        return GL_BYTE;
+    case GL_R11F_G11F_B10F:
+        return GL_UNSIGNED_INT_10F_11F_11F_REV;
+    case GL_RGB9_E5:
