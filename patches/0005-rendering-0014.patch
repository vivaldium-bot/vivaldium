+    default:
+        return GL_NONE;
+    }
+}
+
+GLenum WebGLTexture::getValidFormatForInternalFormat(GLenum internalFormat)
+{
+    switch (internalFormat) {
+    case GL_R8:
+    case GL_R8_SNORM:
+    case GL_R16F:
+    case GL_R32F:
+        return GL_RED;
+    case GL_R8UI:
+    case GL_R8I:
+    case GL_R16UI:
+    case GL_R16I:
+    case GL_R32UI:
+    case GL_R32I:
+        return GL_RED_INTEGER;
+    case GL_RG8:
+    case GL_RG8_SNORM:
+    case GL_RG16F:
+    case GL_RG32F:
+        return GL_RG;
+    case GL_RG8UI:
