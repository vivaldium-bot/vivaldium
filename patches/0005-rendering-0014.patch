+#ifndef WorkerWebSocketChannel_h
+#define WorkerWebSocketChannel_h
+
+#include "core/frame/ConsoleTypes.h"
+#include "modules/websockets/WebSocketChannel.h"
+#include "modules/websockets/WebSocketChannelClient.h"
