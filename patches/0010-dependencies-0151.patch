+                        XFA_XDPPACKET ePacketID);
+
+  CFX_XMLParser* m_pXMLParser;
+  std::unique_ptr<CFX_XMLDoc> m_pXMLDoc;
+  CFX_RetainPtr<CFX_SeekableStreamProxy> m_pStream;
