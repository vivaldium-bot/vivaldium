+static void test_isNestedFillRects(skiatest::Reporter* reporter) {
+    // passing tests (all moveTo / lineTo...
+    SkPoint r1[] = {{0, 0}, {1, 0}, {1, 1}, {0, 1}}; // CW
+    SkPoint r2[] = {{1, 0}, {1, 1}, {0, 1}, {0, 0}};
