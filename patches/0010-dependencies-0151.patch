index 0000000000000000000000000000000000000000..04d17a67ef5e77ffa0056b5e6bf61385139cf2e9
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/filtered_cb_vecs.c
@@ -0,0 +1,48 @@
+/*
