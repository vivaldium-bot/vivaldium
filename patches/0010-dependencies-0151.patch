+SkPDFArray::SkPDFArray() { SkDEBUGCODE(fDumped = false;) }
+
+SkPDFArray::~SkPDFArray() { this->drop(); }
+
+void SkPDFArray::drop() {
+    fValues.reset();
+    SkDEBUGCODE(fDumped = true;)
+}
+
+int SkPDFArray::size() const { return fValues.count(); }
+
