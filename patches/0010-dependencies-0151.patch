+  uint32_t m_dwCsb[2];
+};
+
+class CFX_FontDescriptorInfo {
+ public:
+  CFX_FontDescriptor* pFont;
+  int32_t nPenalty;
+
+  bool operator>(const CFX_FontDescriptorInfo& other) const {
+    return nPenalty > other.nPenalty;
+  }
+  bool operator<(const CFX_FontDescriptorInfo& other) const {
+    return nPenalty < other.nPenalty;
+  }
+  bool operator==(const CFX_FontDescriptorInfo& other) const {
+    return nPenalty == other.nPenalty;
+  }
+};
