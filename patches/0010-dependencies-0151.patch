+
+    return GrGLAssembleInterface(nullptr, glfw_get);
+}
diff --git a/third_party/skia/src/gpu/gl/glx/GrGLCreateNativeInterface_glx.cpp b/third_party/skia/src/gpu/gl/glx/GrGLCreateNativeInterface_glx.cpp
