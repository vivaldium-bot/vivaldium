+#ifdef SK_DEBUG
+    , fSingleOwner(singleOwner)
+#endif
+    , fDrawingManager(drawingMgr) {
+}
diff --git a/third_party/skia/src/gpu/GrSurfaceContextPriv.h b/third_party/skia/src/gpu/GrSurfaceContextPriv.h
