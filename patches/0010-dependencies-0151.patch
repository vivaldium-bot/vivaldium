+class PorterDuffXferProcessor : public GrXferProcessor {
+public:
+    PorterDuffXferProcessor(BlendFormula blendFormula) : fBlendFormula(blendFormula) {
+        this->initClassID<PorterDuffXferProcessor>();
+    }
+
