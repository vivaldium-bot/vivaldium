diff --git a/third_party/skia/src/gpu/GrBuffer.cpp b/third_party/skia/src/gpu/GrBuffer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b565345e99604af90cae6f1401597b104910c08d
