+    , fSpotAlpha(spotAlpha)
+    , fFlags(flags) {
+    SkASSERT(fOccluderHeight > 0);
+    SkASSERT(fLightPos.z() > 0 && fLightPos.z() > fOccluderHeight);
+    SkASSERT(fLightRadius > 0);
+    SkASSERT(fSpotAlpha >= 0);
+}
+
