+                const CFX_SizeF& szText,
+                float& fLinePos,
+                bool bSavePieces);
+  bool LoadRichText(CFX_XMLNode* pXMLNode,
+                    const CFX_SizeF& szText,
+                    float& fLinePos,
+                    const CFX_RetainPtr<CFX_CSSComputedStyle>& pParentStyle,
