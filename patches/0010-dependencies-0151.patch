+  void OnProcessMessage(CFWL_Message* pMessage) override;
+  void OnDrawWidget(CXFA_Graphics* pGraphics,
+                    const CFX_Matrix& matrix) override;
+
+  void GetRange(float* fMin, float* fMax) const {
