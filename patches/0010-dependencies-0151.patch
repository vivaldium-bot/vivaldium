+  void DrawCaretBK(CXFA_Graphics* pGraphics,
+                   IFWL_ThemeProvider* pTheme,
+                   const CFX_Matrix* pMatrix);
+
+  std::unique_ptr<CFWL_Caret::Timer> m_pTimer;
+  CFX_UnownedPtr<CFWL_TimerInfo> m_pTimerInfo;
+};
+
+#endif  // XFA_FWL_CFWL_CARET_H_
