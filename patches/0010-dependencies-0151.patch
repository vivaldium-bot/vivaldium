+
+enum FX_LINEBREAKTYPE : uint8_t {
+  FX_LBT_UNKNOWN = 0x00,
+  FX_LBT_DIRECT_BRK = 0x1A,
+  FX_LBT_INDIRECT_BRK = 0x2B,
+  FX_LBT_COM_INDIRECT_BRK = 0x3C,
+  FX_LBT_COM_PROHIBITED_BRK = 0x4D,
+  FX_LBT_PROHIBITED_BRK = 0x5E,
+  FX_LBT_HANGUL_SPACE_BRK = 0x6F,
+};
