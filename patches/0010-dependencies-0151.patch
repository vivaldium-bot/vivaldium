diff --git a/third_party/skia/src/pdf/SkPDFCanon.cpp b/third_party/skia/src/pdf/SkPDFCanon.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a804d6b47b9240506550683737b79fcee6ae5d5f
