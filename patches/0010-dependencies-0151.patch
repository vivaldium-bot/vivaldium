index 0000000000000000000000000000000000000000..c9e5a8a6015203c8e9eb52e73b4eec1c1c1ccb0c
--- /dev/null
+++ b/third_party/skia/src/effects/SkXfermodeImageFilter.cpp
@@ -0,0 +1,366 @@
+/*
