+  const FX_FONTDESCRIPTOR* FindFont(const wchar_t* pszFontFamily,
+                                    uint32_t dwFontStyles,
+                                    uint32_t dwMatchFlags,
+                                    uint16_t wCodePage,
+                                    uint32_t dwUSB = 999,
+                                    wchar_t wUnicode = 0);
