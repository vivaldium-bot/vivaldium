+                    CFX_RetainPtr<CXFA_LinkUserData> pLinkData,
+                    bool bEndBreak = true,
+                    bool bIsOl = false,
+                    int32_t iLiCount = 0);
+  bool AppendChar(const CFX_WideString& wsText,
+                  float& fLinePos,
+                  float fSpaceAbove,
+                  bool bSavePieces);
+  void AppendTextLine(CFX_BreakType dwStatus,
