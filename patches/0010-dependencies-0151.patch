+GrSurfaceContext::GrSurfaceContext(GrContext* context,
+                                   GrDrawingManager* drawingMgr,
+                                   sk_sp<SkColorSpace> colorSpace,
+                                   GrAuditTrail* auditTrail,
+                                   GrSingleOwner* singleOwner)
+    : fContext(context)
+    , fColorSpace(std::move(colorSpace))
