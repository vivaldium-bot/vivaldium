+  CFX_WideString wsThickness;
+  if (bSetting) {
+    wsThickness = pValue->ToWideString();
+    for (int32_t i = 0; i < iSize; ++i) {
+      CXFA_Edge edge = border.GetEdge(i);
+      CXFA_Measurement thickness(wsThickness.AsStringC());
+      edge.SetMSThickness(thickness);
