+      with self.m.context(cwd=self.m.vars.skia_dir, env=env):
+        self._py('symbolized %s' % name,
+                 self.module.resource('symbolize_stack_trace.py'),
+                 args=args,
+                 infra_step=False)
+
+    else:
+      with self.m.context(env=env):
+        self._run(name, cmd)
