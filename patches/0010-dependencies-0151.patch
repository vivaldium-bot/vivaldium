+    case FX_LANG_es_LA:
+      return XFA_GetLocaleFromBuffer(g_esLA_Locale, sizeof(g_esLA_Locale));
+    case FX_LANG_es_ES:
+      return XFA_GetLocaleFromBuffer(g_esES_Locale, sizeof(g_esES_Locale));
+    case FX_LANG_de_DE:
