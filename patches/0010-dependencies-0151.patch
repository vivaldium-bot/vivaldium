+// doUpload indicates whether the given Job should upload its results.
+func doUpload(name string) bool {
+	for _, s := range CONFIG.NoUpload {
+		m, err := regexp.MatchString(s, name)
+		if err != nil {
+			glog.Fatal(err)
+		}
+		if m {
+			return false
+		}
+	}
+	return true
+}
