+    this->emitUniforms(args.fUniformHandler, ge);
+    SkString t = args.fFragBuilder->ensureCoords2D(args.fTransformedCoords[0]);
+    t.append(".x");
+    this->emitColor(args.fFragBuilder,
+                    args.fUniformHandler,
+                    args.fShaderCaps,
+                    ge,
+                    t.c_str(),
+                    args.fOutputColor,
+                    args.fInputColor,
+                    args.fTexSamplers);
