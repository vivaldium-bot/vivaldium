+  }
+  void DrawTrack(CXFA_Graphics* pGraphics,
+                 IFWL_ThemeProvider* pTheme,
+                 bool bLower,
+                 const CFX_Matrix* pMatrix);
+  void DrawArrowBtn(CXFA_Graphics* pGraphics,
+                    IFWL_ThemeProvider* pTheme,
+                    bool bMinBtn,
+                    const CFX_Matrix* pMatrix);
+  void DrawThumb(CXFA_Graphics* pGraphics,
+                 IFWL_ThemeProvider* pTheme,
+                 const CFX_Matrix* pMatrix);
+  void Layout();
+  void CalcButtonLen();
