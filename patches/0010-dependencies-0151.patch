index 0000000000000000000000000000000000000000..d7c2e75553b8e5225ace669f2fb258e0d5215c8e
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/get_cd_vec.c
@@ -0,0 +1,111 @@
+/*
