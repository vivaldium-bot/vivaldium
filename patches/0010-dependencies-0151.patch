+    }
+
+    sk_sp<SkSpecialImage> fullSImg(SkSpecialImage::MakeFromGpu(
+                                                            SkIRect::MakeWH(kFullSize, kFullSize),
+                                                            kNeedNewImageUniqueID_SpecialImage,
+                                                            texture));
