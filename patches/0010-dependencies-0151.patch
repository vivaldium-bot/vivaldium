+    XFA_RectWidthoutMargin(rect, mgWidget);
+
+  CFX_Matrix mtRotate = GetRotateMatrix();
+  mtRotate.Concat(matrix);
+
+  DrawBorder(pGS, rtObj, rect, mtRotate);
+}
