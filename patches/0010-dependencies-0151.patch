+    if (errors2x2 >= MAX_ERRORS) {
+        SkAutoMutexAcquire autoM(compareDebugOut3);
+        showPathOpPath(testName, one, two, a, b, scaledOne, scaledTwo, shapeOp, scale);
+        SkDebugf("\n/*");
+        REPORTER_ASSERT(reporter, 0);
+        SkDebugf(" */\n");
+    }
+    return errors2x2 >= MAX_ERRORS ? errors2x2 : 0;
+}
