+#include "SkMagnifierImageFilter.h"
+
+#include "SkBitmap.h"
+#include "SkColorPriv.h"
+#include "SkReadBuffer.h"
+#include "SkSpecialImage.h"
+#include "SkWriteBuffer.h"
+#include "SkValidationUtils.h"
+
+////////////////////////////////////////////////////////////////////////////////
+#if SK_SUPPORT_GPU
+#include "GrContext.h"
