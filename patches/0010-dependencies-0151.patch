+class GrClearStencilClipOp final : public GrOp {
+public:
+    DEFINE_OP_CLASS_ID
+
+    static std::unique_ptr<GrOp> Make(const GrFixedClip& clip, bool insideStencilMask,
+                                      GrRenderTarget* rt) {
+        return std::unique_ptr<GrOp>(new GrClearStencilClipOp(clip, insideStencilMask, rt));
