+
+#define FWL_STATE_PSB_Hovered (1 << FWL_WGTSTATE_MAX)
+#define FWL_STATE_PSB_Pressed (1 << (FWL_WGTSTATE_MAX + 1))
+
+class CFWL_MessageMouse;
+class CFX_DIBitmap;
+class CFWL_Widget;
+
+class CFWL_PushButton : public CFWL_Widget {
