+  ASSERT_NE(nullptr, data);
+  EXPECT_EQ(BarcodeType::pdf417, data->eName);
+
+  data = CXFA_FFBarcode::GetBarcodeTypeByName(L"code3Of9");
+  ASSERT_NE(nullptr, data);
+  EXPECT_EQ(BarcodeType::code3Of9, data->eName);
+}
