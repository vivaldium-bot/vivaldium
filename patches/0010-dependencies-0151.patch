+  void OnWriteEvent(rtc::AsyncSocket * socket);
+  void OnConnectEvent(rtc::AsyncSocket * socket);
+  void OnCloseEvent(rtc::AsyncSocket * socket, int error);
+#else  // USE_SSLSTREAM
