+class SkEmptyTypeface : public SkTypeface {
+public:
+    static SkEmptyTypeface* Create() { return new SkEmptyTypeface; }
+protected:
+    SkEmptyTypeface() : SkTypeface(SkFontStyle(), true) { }
+
