+  CFX_RectF rcWidget = GetRectWithoutRotate();
+  XFA_ATTRIBUTEENUM at = XFA_ATTRIBUTEENUM_TopLeft;
+  XFA_GetMatrix(mt, iRotate, at, rcWidget);
+
+  return mt;
