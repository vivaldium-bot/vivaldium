+// static
+void CXFA_FM2JSContext::Oneof(CFXJSE_Value* pThis,
+                              const CFX_ByteStringC& szFuncName,
+                              CFXJSE_Arguments& args) {
+  if (args.GetLength() < 2) {
+    ToJSContext(pThis, nullptr)->ThrowParamCountMismatchException(L"Oneof");
+    return;
