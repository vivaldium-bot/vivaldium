diff --git a/third_party/swiftshader/third_party/LLVM/lib/Support/Path.cpp b/third_party/swiftshader/third_party/LLVM/lib/Support/Path.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e5b7cd3bfbc233f78ddccbbf7f586b9a50fd81d2
