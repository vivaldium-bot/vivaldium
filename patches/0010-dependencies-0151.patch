+TEST_F(FM2JSContextEmbedderTest, Numeric) {
+  ASSERT_TRUE(OpenDocument("simple_xfa.pdf"));
+
+  struct {
+    const char* program;
+    int result;
+  } tests[] = {{"123 + 456", 579},
+               {"2 - 3 * 10 / 2 + 7", -6},
+               {"10 * 3 + 5 * 4", 50},
+               {"(5 - \"abc\") * 3", 15},
+               {"\"100\" / 10e1", 1},
+               {"5 + null + 3", 8},
+               // {"if (\"abc\") then\n"
+               //  "  10\n"
+               //  "else\n"
+               //  "  20\n"
+               //  "endif",
+               //  20},
+               // {"3 / 0 + 1", 0},
+               {"-(17)", -17},
+               {"-(-17)", 17},
+               {"+(17)", 17},
+               {"+(-17)", -17},
+               {"if (1 < 2) then\n1\nendif", 1},
+               {"if (\"abc\" > \"def\") then\n"
+                "  1 and 0\n"
+                "else\n"
+                "  0\n"
+                "endif",
