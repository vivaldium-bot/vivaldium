+
+    static uint32_t GenBatchID() { return GenID(&gCurrBatchUniqueID); }
+    mutable uint32_t                    fUniqueID;
+    SkRect                              fBounds;
+
+    static int32_t                      gCurrBatchUniqueID;
+    static int32_t                      gCurrBatchClassID;
+};
