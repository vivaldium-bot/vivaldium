+        if (this->hasColors()) {
+            input->colorInput()->setToUnknown();
+        } else {
+            input->colorInput()->setToConstant(fGeoData[0].fColor);
+        }
+        input->coverageInput()->setToSolidCoverage();
+    }
+
+    void onPrepareDraws(Target*) const override;
