+      break;
+    case BC_CODE128:
+    case BC_CODE128_B:
+    case BC_CODE128_C:
+      memptr = (memptrtype)&CBC_Code128::SetTextLocation;
+      break;
+    default:
+      break;
+  }
+  return m_pBCEngine && memptr ? (m_pBCEngine.get()->*memptr)(location) : false;
