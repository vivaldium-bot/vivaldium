+                                                                                        kFullSize),
+                                                                        bm));
+
+        {
+            sk_sp<SkSpecialImage> fromRaster(rasterImage->makeTextureImage(context));
+            test_texture_backed(reporter, rasterImage, fromRaster);
+        }
