+//////////////////////////////////////////////////////////////////////////////
+
+class DitherEffect : public GrFragmentProcessor {
+public:
+    static sk_sp<GrFragmentProcessor> Make() {
+        return sk_sp<GrFragmentProcessor>(new DitherEffect);
+    }
