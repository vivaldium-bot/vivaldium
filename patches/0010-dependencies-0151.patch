+CXFA_Node* CXFA_Node::CloneTemplateToForm(bool bRecursive) {
+  ASSERT(m_ePacket == XFA_XDPPACKET_Template);
+  CXFA_Node* pClone =
+      m_pDocument->CreateNode(XFA_XDPPACKET_Form, m_elementType);
