+SkString skiatest::Failure::toString() const {
+    SkString result = SkStringPrintf("%s:%d\t", this->fileName, this->lineNo);
+    if (!this->message.isEmpty()) {
+        result.append(this->message);
+        if (strlen(this->condition) > 0) {
+            result.append(": ");
