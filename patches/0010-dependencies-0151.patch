+  bool RunDocScript(CXFA_FFDoc* hDoc,
+                    XFA_SCRIPTTYPE eScriptType,
+                    const CFX_WideStringC& wsScript,
+                    CFXJSE_Value* pRetValue,
+                    CFXJSE_Value* pThisObject);
+};
