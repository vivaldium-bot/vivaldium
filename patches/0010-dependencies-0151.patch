+    fStencilAndCoverTextContext->drawPosText(
+            this->drawingManager()->getContext(), this, clip, skPaint, viewMatrix,
+            this->surfaceProps(), text, byteLength, pos, scalarsPerPosition, offset, clipBounds);
+}
