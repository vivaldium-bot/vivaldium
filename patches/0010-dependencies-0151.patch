index 0000000000000000000000000000000000000000..c2c18acef72e1ac2649475745d9f50b190d88af5
--- /dev/null
+++ b/third_party/skia/src/effects/SkMergeImageFilter.cpp
@@ -0,0 +1,193 @@
+/*
