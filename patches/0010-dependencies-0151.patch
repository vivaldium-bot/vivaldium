+CXFA_FFWidget* XFA_ThemeGetOuterWidget(CFWL_Widget* pWidget) {
+  CFWL_Widget* pOuter = pWidget;
+  while (pOuter && pOuter->GetOuter())
+    pOuter = pOuter->GetOuter();
+  return pOuter ? pOuter->GetLayoutItem() : nullptr;
+}
