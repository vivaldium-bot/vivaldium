+#if SK_SUPPORT_GPU
+DEF_GPUTEST_FOR_RENDERING_CONTEXTS(ImageFilterNegativeBlurSigma_Gpu, reporter, ctxInfo) {
+    test_negative_blur_sigma(reporter, ctxInfo.grContext());
+}
+#endif
