+    HRM(this->fXpsFactory->CreateGradientStop(&gradStopXpsColor,
+                                              nullptr,
+                                              SkScalarToFLOAT(offset),
+                                              xpsGradStop),
+        "Could not create gradient stop.");
+    return S_OK;
+}
