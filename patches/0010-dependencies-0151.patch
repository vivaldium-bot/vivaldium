+
+DRAW_OP_TEST_DEFINE(PLSPathOp) {
+    GrColor color = GrRandomColor(random);
+    SkMatrix vm = GrTest::TestMatrixInvertible(random);
+    SkPath path = GrTest::TestPathConvex(random);
+
+    return PLSPathOp::Make(color, path, vm);
+}
