index 0000000000000000000000000000000000000000..b3967ecabb1c3e994a1493f388ecfce0522e3df2
--- /dev/null
+++ b/third_party/skia/src/effects/SkRRectsGaussianEdgeMaskFilter.cpp
@@ -0,0 +1,574 @@
+/*
