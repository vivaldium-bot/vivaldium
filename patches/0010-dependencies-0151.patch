+  struct DATE {
+    DATE() : iYear(0), iMonth(0), iDay(0) {}
+
+    DATE(int32_t year, int32_t month, int32_t day)
+        : iYear(year), iMonth(month), iDay(day) {}
+
+    bool operator<(const DATE& right) {
+      if (iYear < right.iYear)
+        return true;
+      if (iYear == right.iYear) {
+        if (iMonth < right.iMonth)
+          return true;
+        if (iMonth == right.iMonth)
+          return iDay < right.iDay;
+      }
+      return false;
+    }
+
+    bool operator>(const DATE& right) {
+      if (iYear > right.iYear)
+        return true;
+      if (iYear == right.iYear) {
+        if (iMonth > right.iMonth)
+          return true;
+        if (iMonth == right.iMonth)
+          return iDay > right.iDay;
+      }
+      return false;
+    }
+
+    int32_t iYear;
+    int32_t iMonth;
+    int32_t iDay;
+  };
