-    function handlePromise(passFailFunc, message) {
-      return function () { 
-        passFailFunc(message); 
-      };
-    }
-
-    // Task: test suspend().
-    audit.defineTask('test-suspend', function (done) {
-
-      // Test suspend/resume.  Ideally this test is best with a online 
