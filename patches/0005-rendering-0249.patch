+template<typename Derived, typename Shape, typename Key>
+void HashTable<Derived, Shape, Key>::IteratePrefix(ObjectVisitor* v) {
+  BodyDescriptorBase::IteratePointers(this, 0, kElementsStartOffset, v);
+}
