+  if (heap()->mark_compact_collector()->sweeping_in_progress()) {
+    heap()->mark_compact_collector()->EnsureSweepingCompleted();
+  }
+  ClearHistograms(heap()->isolate());
+  HeapObjectIterator obj_it(this);
