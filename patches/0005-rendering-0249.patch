+BytecodeArrayBuilder& BytecodeArrayBuilder::LoadLiteral(
+    v8::internal::Smi* smi) {
+  int32_t raw_smi = smi->value();
+  if (raw_smi == 0) {
+    Output(Bytecode::kLdaZero);
+  } else {
+    Output(Bytecode::kLdaSmi, SignedOperand(raw_smi));
+  }
+  return *this;
+}
