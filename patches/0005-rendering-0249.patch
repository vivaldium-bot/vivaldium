+void MipsDebugger::Stop(Instruction* instr) {
+  // Get the stop code.
+  uint32_t code = instr->Bits(25, 6);
+  PrintF("Simulator hit (%u)\n", code);
+  sim_->set_pc(sim_->get_pc() + 2 * Instruction::kInstrSize);
+  Debug();
+}
