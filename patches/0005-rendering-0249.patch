+class V8_EXPORT_PRIVATE StringHasher {
+ public:
+  explicit inline StringHasher(int length, uint32_t seed);
+
+  template <typename schar>
+  static inline uint32_t HashSequentialString(const schar* chars,
+                                              int length,
+                                              uint32_t seed);
