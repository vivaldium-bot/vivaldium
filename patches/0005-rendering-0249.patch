+  Handle<TypeFeedbackVector> vector() const { return nexus()->vector_handle(); }
+  FeedbackVectorSlot slot() const { return nexus()->slot(); }
+  State saved_state() const {
+    return state() == RECOMPUTE_HANDLER ? old_state_ : state();
+  }
