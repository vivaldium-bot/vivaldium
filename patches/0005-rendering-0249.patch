+PagedSpace::PagedSpace(Heap* heap, AllocationSpace space,
+                       Executability executable)
+    : Space(heap, space, executable), anchor_(this), free_list_(this) {
+  area_size_ = MemoryAllocator::PageAreaSize(space);
