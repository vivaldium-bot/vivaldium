+// -------------------------------------------------------------------
+
+
+function ArraySpeciesCreate(array, length) {
+  length = INVERT_NEG_ZERO(length);
+  var constructor = %ArraySpeciesConstructor(array);
+  return new constructor(length);
+}
+
+
+function KeySortCompare(a, b) {
+  return a - b;
+}
