+
+void LargeObjectSpace::ReportStatistics() {
+  PrintF("  size: %" V8PRIdPTR "\n", size_);
+  int num_objects = 0;
+  ClearHistograms(heap()->isolate());
+  LargeObjectIterator it(this);
+  for (HeapObject* obj = it.Next(); obj != NULL; obj = it.Next()) {
+    num_objects++;
+    CollectHistogramInfo(obj);
