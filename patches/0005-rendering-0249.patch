-          var d = Math.sqrt(-discriminant);
-          return Math.hypot(a1 / 2, d / 2);
-        } else {
-          // Real roots
-          var d = Math.sqrt(discriminant);
-          return Math.max(Math.abs((-a1 + d) / 2), Math.abs((-a1 - d) / 2));
-        }
-      }
