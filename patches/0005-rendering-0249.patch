+void MacroAssembler::Move(Register dst, const Immediate& x) {
+  if (x.is_zero() && RelocInfo::IsNone(x.rmode_)) {
+    xor_(dst, dst);  // Shorter than mov of 32-bit immediate 0.
+  } else {
+    mov(dst, x);
+  }
+}
