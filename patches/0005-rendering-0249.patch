index 0000000000000000000000000000000000000000..8aaeaca367860d623132e57def80f6dee80a1b46
--- /dev/null
+++ b/v8/src/mips/codegen-mips.cc
@@ -0,0 +1,1127 @@
+// Copyright 2012 the V8 project authors. All rights reserved.
