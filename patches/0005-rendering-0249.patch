+
+function TryCall(x) {
+  var caught = [];
+  try {
+    x();
+  } catch (e) {
+    caught.push(e);
+  }
+
+  try {
+    new x();
+  } catch (e) {
+    caught.push(e);
+  }
+
+  assertTrue(caught[0] instanceof TypeError);
+  assertTrue(caught[1] instanceof TypeError);
+};
+
+
+TryCall(this);
+TryCall(Math);
+TryCall(true);
+TryCall(1234);
+TryCall("hest");
+
+
+// Make sure that calling a non-function global doesn't crash the
+// system while building the IC for it.
+var NonFunction = 42;
+function WillThrow() {
+  NonFunction();
+}
+assertThrows(WillThrow);
+assertThrows(WillThrow);
