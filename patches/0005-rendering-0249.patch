+Expression* Parser::ExpressionListToExpression(ZoneList<Expression*>* args) {
+  Expression* expr = args->at(0);
+  for (int i = 1; i < args->length(); ++i) {
+    expr = factory()->NewBinaryOperation(Token::COMMA, expr, args->at(i),
+                                         expr->position());
+  }
+  return expr;
+}
