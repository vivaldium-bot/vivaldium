+
+bool String::AsArrayIndex(uint32_t* index) {
+  uint32_t field = hash_field();
+  if (IsHashFieldComputed(field) && (field & kIsNotArrayIndexMask)) {
+    return false;
+  }
+  return SlowAsArrayIndex(index);
+}
