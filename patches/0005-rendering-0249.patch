+      PrintF("    %-34s%10d (%10d bytes)\n",
+             isolate->heap_histograms()[i].name(),
+             isolate->heap_histograms()[i].number(),
+             isolate->heap_histograms()[i].bytes());
+    }
+  }
+  PrintF("\n");
+
