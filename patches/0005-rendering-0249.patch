+  // Don't clear debug break inline cache as it will remove the break point.
+  if (target->is_debug_stub()) return;
+
+  if (target->kind() == Code::COMPARE_IC) {
+    CompareIC::Clear(isolate, address, target, constant_pool);
+  }
+}
