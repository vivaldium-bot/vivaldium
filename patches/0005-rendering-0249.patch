+  uint32_t Push(Handle<JSArray> receiver, Arguments* args,
+                uint32_t push_size) final {
+    return Subclass::PushImpl(receiver, args, push_size);
+  }
+
+  static uint32_t PushImpl(Handle<JSArray> receiver, Arguments* args,
+                           uint32_t push_sized) {
+    UNREACHABLE();
