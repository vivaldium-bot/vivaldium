+
+  inline void SetDescriptor(int descriptor_number, Descriptor* desc);
+
+  // Swap first and second descriptor.
+  inline void SwapSortedKeys(int first, int second);
+
+  DISALLOW_IMPLICIT_CONSTRUCTORS(DescriptorArray);
+};
