-        //   t >= timeConstant * log(v0/eps)
-        //
-        // For v1 not zero, we want |v(t) - v1|/|v1| <= eps:
-        //
-        //   t >= timeConstant * log(abs(v1-v0)/eps/v1)
-
-        if (v1)
