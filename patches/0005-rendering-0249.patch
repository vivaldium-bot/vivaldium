+void ExitFrame::Iterate(ObjectVisitor* v) const {
+  // The arguments are traversed as part of the expression stack of
+  // the calling frame.
+  IteratePc(v, pc_address(), constant_pool_address(), LookupCode());
+  v->VisitPointer(&code_slot());
+}
