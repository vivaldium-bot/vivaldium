+void MacroAssembler::NegativeZeroTest(Register result,
+                                      Register op1,
+                                      Register op2,
+                                      Register scratch,
+                                      Label* then_label) {
+  Label ok;
+  test(result, result);
+  j(not_zero, &ok, Label::kNear);
+  mov(scratch, op1);
+  or_(scratch, op2);
+  j(sign, then_label, Label::kNear);
+  bind(&ok);
+}
