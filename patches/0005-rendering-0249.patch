+char IC::TransitionMarkFromState(IC::State state) {
+  switch (state) {
+    case UNINITIALIZED:
+      return '0';
+    case PREMONOMORPHIC:
+      return '.';
+    case MONOMORPHIC:
+      return '1';
+    case RECOMPUTE_HANDLER:
+      return '^';
+    case POLYMORPHIC:
+      return 'P';
+    case MEGAMORPHIC:
+      return 'N';
+    case GENERIC:
+      return 'G';
+  }
+  UNREACHABLE();
+  return 0;
+}
+
