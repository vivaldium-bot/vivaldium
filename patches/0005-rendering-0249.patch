+void Code::Relocate(intptr_t delta) {
+  for (RelocIterator it(this, RelocInfo::kApplyMask); !it.done(); it.next()) {
+    it.rinfo()->apply(delta);
+  }
+  Assembler::FlushICache(GetIsolate(), instruction_start(), instruction_size());
+}
