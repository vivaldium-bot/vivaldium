+                               FixedArray::kHeaderSize + kPointerSize));
+  HandlePolymorphicStoreCase(masm, receiver, key, vector, slot, scratch, false,
+                             &miss);
+
+  __ bind(&miss);
+  KeyedStoreIC::GenerateMiss(masm);
