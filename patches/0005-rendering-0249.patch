+    if (token_location.IsValid() && beg_pos <= token_location.beg_pos &&
+        token_location.end_pos <= end_pos) {
+      scanner()->clear_decimal_with_leading_zero_position();
+      impl()->CountUsage(v8::Isolate::kDecimalWithLeadingZeroInStrictMode);
+    }
+  }
