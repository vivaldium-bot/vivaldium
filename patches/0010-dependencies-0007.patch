+    self._CheckAnomalies('ChromiumPerf/mac/SunSpider1.0/Total/t')
+    expected_tests = [
+        'SunSpider1.0',
+        'SunSpider1.0/3d-cube',
+        'SunSpider1.0/3d-cube/t',
