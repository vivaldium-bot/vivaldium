+    self.assertEqual(['config_path'], dep_info.config_paths)
+    self.assertFalse(dep_info.has_local_path_info)
+    self.assertTrue(dep_info.has_cloud_storage_info)
+    self.assertEqual(cs_info, dep_info._cloud_storage_info)
+
