+class FailStage(generic_stages.BuilderStage):
+  """FailStage always throws an exception"""
+
+  FAIL_EXCEPTION = failures_lib.StepFailure("Fail stage needs to fail.")
+
+  def PerformStage(self):
+    """Throw the exception to make us fail."""
