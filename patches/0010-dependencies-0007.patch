+  try:
+    return pushimage.PushImage(archive_url, board, profile=profile,
+                               sign_types=sign_types, dry_run=dryrun)
+  except pushimage.PushError as e:
+    cros_build_lib.PrintBuildbotStepFailure()
+    return e.args[1]
