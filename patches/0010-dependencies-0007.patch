+
+  def testFlattenTrace_SanitizesTraceName(self):
+    """Tests whether a trace name with special characters is sanitized."""
+    trace = {
+        'type': 'scalar',
+        'name': 'bar.baz',
+        'page': 'http://example.com',
+        'units': 'ms',
+        'value': 42
+    }
+    row = add_point._FlattenTrace(
+        'foo', 'bar', 'http://example.com', trace)
