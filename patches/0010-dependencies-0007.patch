+    self.assertEqual(
+        find_change_points.ChangePoint(
+            x_value=3, median_before=4.0, median_after=8.0, size_before=3,
+            size_after=4, window_start=0, window_end=6, relative_change=1.0,
+            std_dev_before=0.0, t_statistic=float('inf'),
