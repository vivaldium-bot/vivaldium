+      validate_boards.side_effect = badBoardException
+
+      stage = self.ConstructStage()
+
+      self.assertRaises(release_stages.PaygenNoPaygenConfigForBoard,
+                        stage.PerformStage)
+
+  def testRunPaygenInProcess(self):
