diff --git a/third_party/boringssl/src/fuzz/minimise_corpuses.sh b/third_party/boringssl/src/fuzz/minimise_corpuses.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5f9ade53e648242f9e1194fe61a6fb67e29f47cb
--- /dev/null
+++ b/third_party/boringssl/src/fuzz/minimise_corpuses.sh
@@ -0,0 +1,30 @@
+set -e
+
+buildDir=../build
+if [ $# -gt 0 ]; then
+  buildDir=$1
+fi
+
+for testSource in $(ls -1 *.cc); do
+  test=$(echo $testSource | sed -e 's/\.cc$//')
+  if [ ! -x $buildDir/fuzz/$test ] ; then
+    echo "Failed to find binary for $test"
+    exit 1
+  fi
+  if [ ! -d ${test}_corpus ]; then
+    echo "Failed to find corpus directory for $test"
+    exit 1
+  fi
+  if [ -d ${test}_corpus_old ]; then
+    echo "Old corpus directory for $test already exists"
+    exit 1
+  fi
+done
+
+for testSource in $(ls -1 *.cc); do
+  test=$(echo $testSource | sed -e 's/\.cc$//')
+  mv ${test}_corpus ${test}_corpus_old
+  mkdir ${test}_corpus
+  $buildDir/fuzz/$test -max_len=50000 -merge=1 ${test}_corpus ${test}_corpus_old
+  rm -Rf ${test}_corpus_old
+done
diff --git a/third_party/boringssl/src/fuzz/privkey.cc b/third_party/boringssl/src/fuzz/privkey.cc
new file mode 100644
index 0000000000000000000000000000000000000000..094d438fbd2ed355df26f7a8b22207b5a2ed478a
--- /dev/null
+++ b/third_party/boringssl/src/fuzz/privkey.cc
@@ -0,0 +1,7 @@
+#include <openssl/evp.h>
+
+extern "C" int LLVMFuzzerTestOneInput(uint8_t *buf, size_t len) {
+  const uint8_t *bufp = buf;
+  EVP_PKEY_free(d2i_AutoPrivateKey(NULL, &bufp, len));
+  return 0;
+}
