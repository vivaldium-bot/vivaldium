+    expected_lookup_dict = {dep: {plat1: dep_info_a,
+                                  plat2: dep_info_b},
+                            dep1: {plat1: dep_info_c},
+                            dep2: {plat1: dep_info1,
+                                   plat2: dep_info2},
+                            dep3: {plat2: dep_info3}}
+    dep_manager._UpdateDependencies(base_config_mock)
