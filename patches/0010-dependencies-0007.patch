+
+_SAMPLE_SERIES = [
+    (300, 60.06), (301, 60.36), (302, 61.76), (303, 60.06), (304, 61.24),
+    (305, 60.65), (306, 55.61), (307, 61.88), (308, 61.51), (309, 59.58),
