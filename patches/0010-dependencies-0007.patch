+        '/report?masters=M&bots=b&tests=suite%2Ffoo',
+        debug_alert._GraphUrl(test_key.get(), ''))
+    self.assertEqual(
+        '/report?masters=M&bots=b&tests=suite%2Ffoo',
+        debug_alert._GraphUrl(test_key.get(), None))
+
+
+if __name__ == '__main__':
+  unittest.main()
