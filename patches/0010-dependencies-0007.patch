+    CONFIG_TYPE_PALADIN,
+    CONFIG_TYPE_PRECQ,
+    constants.PRE_CQ_LAUNCHER_CONFIG,
+    'incremental',
+    'telemetry',
+    CONFIG_TYPE_FULL,
+    'full-group',
+    CONFIG_TYPE_RELEASE,
