+  def testUnhandledExceptions(self):
+    """Test that CQ doesn't loop due to unhandled Exceptions."""
+    pool, patches, _failed = self._setUpSubmit()
+
+    class MyException(Exception):
+      """"Unique Exception used for testing."""
