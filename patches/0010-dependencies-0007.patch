+    anomaly_config.AnomalyConfig(config=my_config, patterns=my_patterns).put()
+    test.put()
+
+    # The sample test now has an overridden config which is used.
+    # Extraneous "comment" keys are ignored.
+    expected = {
+        'max_window_size': 721,
+        'min_segment_size': 123,
+    }
