+    self._CheckRows('ChromiumPerf/mac/SunSpider/OverallScore/t')
+    self._CheckAnomalies('ChromiumPerf/mac/SunSpider/OverallScore/t')
+    expected_tests = [
+        'SunSpider',
+        'SunSpider/3d-cube',
