+
+    # Add some (6) non-triaged improvements.
+    for end_rev in range(10140, 10200, 10):
+      test_key = mean_frame_time
+      anomaly_entity = anomaly.Anomaly(
+          start_revision=end_rev - 5, end_revision=end_rev, test=test_key,
