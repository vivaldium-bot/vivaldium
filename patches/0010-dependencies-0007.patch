+      config_types: A tuple/list of config suffixes.
+
+    Returns:
+      True, if the config has a suffix matching one of the types.
+    """
+    for config_type in config_types:
+      if config_name.endswith('-' + config_type) or config_name == config_type:
+        return True
+
+    return False
