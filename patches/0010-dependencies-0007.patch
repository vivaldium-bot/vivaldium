+    self.ext_mirror = mirror
+    mirror = os.path.join(self.tempdir, 'tryjobs_int_mirror')
+    os.mkdir(mirror)
+    repository.CloneGitRepo(mirror, self.ext_mirror, reference=self.ext_mirror,
+                            bare=True)
