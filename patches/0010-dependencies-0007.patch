+    (305003, 1085427.111),
+    (305007, 1080062.222),
+]
+
+# Sample data where there is no clear step pattern.
+_NOT_STEPPISH = [
+    (301306, 965.568),
+    (301307, 962.378),
+    (301310, 962.355),
+    (301313, 959.623),
