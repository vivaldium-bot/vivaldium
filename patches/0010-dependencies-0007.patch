+
+  def testTap_withOffsetInDp(self):
+    node = self.app.GetUiNode(content_desc='Open navigation drawer')
+    node.Tap(geometry.Point(10, 20), dp_units=True)
+    self.assertTappedOnceAt(20, 98)
