+                   [5, null], [6, 57.31], [7, 57.31], [8, null]]
+        }
+      ];
+      window.ANOMALY_POINTS_INDEX = 1;
+      window.LOOKUP = [
+        30000, 30100, 30200, 30300, 30400,
