+class ListTestSuitesTest(testing_common.TestCase):
+
+  def setUp(self):
+    super(ListTestSuitesTest, self).setUp()
+    app = webapp2.WSGIApplication(
+        [('/update_test_suites',
+          update_test_suites.UpdateTestSuitesHandler)])
+    self.testapp = webtest.TestApp(app)
