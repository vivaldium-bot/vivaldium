+    # just returns None; compiling the list of test suites would
+    # take too long.
+    self._AddSampleData()
+    self.assertIsNone(update_test_suites.FetchCachedTestSuites())
+
+  def _AddSampleData(self):
+    testing_common.AddTests(
+        ['Chromium'],
+        ['win7', 'mac'],
+        {
+            'dromaeo': {
+                'dom': {},
