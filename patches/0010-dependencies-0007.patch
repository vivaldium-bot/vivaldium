+
+class GraphCsvTest(testing_common.TestCase):
+
+  def setUp(self):
+    super(GraphCsvTest, self).setUp()
+    app = webapp2.WSGIApplication([('/graph_csv', graph_csv.GraphCsvHandler)])
+    self.testapp = webtest.TestApp(app)
