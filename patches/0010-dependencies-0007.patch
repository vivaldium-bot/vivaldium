+
+_CATAPULT_BASE_PATH = os.path.abspath(
+    os.path.join(_CATAPULT_PATH, 'catapult_base'))
+
+
+def _RunTestsOrDie(top_level_dir):
+  exit_code = run_with_typ.Run(top_level_dir, path=[_CATAPULT_BASE_PATH])
