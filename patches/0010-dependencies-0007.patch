+                      (archive_lib.gs.PRIVATE_BASE_HTTPS_URL,
+                       DEFAULT_ARCHIVE_PREFIX,
+                       DEFAULT_BOT_NAME,
+                       self._VERSION))
+    self.assertEqual(expected_value, value)
