+  if (path) {
+    unlink(path);
+  }
+  path = [perlScript_ fileSystemRepresentation];
+  if (path) {
+    unlink(path);
+  }
+  path = [shOutputScript_ fileSystemRepresentation];
+  if (path) {
+    unlink(path);
+  }
+}
