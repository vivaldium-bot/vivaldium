+#else  // GTM_IPHONE_SDK
+  ABRecordRef ref = ABCopyRecordForUniqueId(addressBook_,
+                                            (CFStringRef)uniqueId);
+#endif  // GTM_IPHONE_SDK
+  if (ref) {
+    group = [GTMABGroup recordWithRecord:ref];
+  }
+  return group;
+}
