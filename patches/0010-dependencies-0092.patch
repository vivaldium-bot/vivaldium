++ (void)resizeWindowWithoutAutoResizingSubViews:(NSWindow*)window
+                                          delta:(NSSize)delta;
++ (void)resizeViewWithoutAutoResizingSubViews:(NSView*)view
+                                        delta:(NSSize)delta;
