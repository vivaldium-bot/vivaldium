+  // 6203854 ABMultiValues hash to their address
+  NSUInteger count = [self count];
+  NSUInteger hash = 0;
+  for (NSUInteger i = 0; i < count;  ++i) {
+    NSString *label = [self labelAtIndex:i];
+    id value = [self valueAtIndex:i];
