+  config.init_client(&f, NULL, NULL);
+  config.init_server(&f, NULL);
+
+  do_request_and_shutdown_server(&f, cqv);
+
+  /* now destroy and recreate the server */
+  config.init_server(&f, NULL);
+
+  do_request_and_shutdown_server(&f, cqv);
+
+  cq_verifier_destroy(cqv);
