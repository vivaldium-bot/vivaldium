+  XCTAssertTrue(isComplete);
+  isComplete = [GTMSQLiteStatement isCompleteStatement:@""];
+  XCTAssertFalse(isComplete);
+  isComplete = [GTMSQLiteStatement isCompleteStatement:@"CR"];
+  XCTAssertFalse(isComplete);
+}
