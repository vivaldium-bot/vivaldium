--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/AppKit/GTMNSBezierPath+RoundRect.m
@@ -0,0 +1,101 @@
+//
+//  GTMNSBezierPath+RoundRect.h
+//
+//  Category for adding utility functions for creating
+//  round rectangles.
+//
+//  Copyright 2006-2008 Google Inc.
+//
