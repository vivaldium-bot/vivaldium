+  @catch (NSException *_exception) { \
+    _failure = [NSString stringWithFormat:@": " _XCExceptionFormatString, [_exception reason]]; \
+  } \
+  @catch (...) { \
+    _failure = @": " _XCUnknownExceptionString; \
+  } \
+  if (_failure) { \
