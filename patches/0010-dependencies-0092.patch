+GTM_INLINE CGSize GTMCGRectSize(CGRect rect) {
+  return CGSizeMake(CGRectGetWidth(rect), CGRectGetHeight(rect));
+}
+
+/// Return rectangle of size
+//
+//  Args:
+//    size - size
+//
+//  Returns:
+//    rectangle of size (origin 0,0)
+GTM_INLINE CGRect GTMCGRectOfSize(CGSize size) {
