--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/AppKit/GTMNSColor+Luminance.m
@@ -0,0 +1,155 @@
+//
+//  GTMNSColor+Luminance.m
+//
+//  Copyright 2009 Google Inc.
