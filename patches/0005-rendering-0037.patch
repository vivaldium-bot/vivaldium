-        request = index.openCursor(IDBKeyRange.lowerBound('k4'));
-        break;
-      default:
-        continue;
-    }
-
-    operation[2] = request;
-    ++pendingCursors;
-
-    request.onsuccess = testCase.step_func(() => {
-      --pendingCursors;
