-  ['continue-empty', null],
-  ['get', 2],
-  ['get-empty', 5],
-  ['count', null],
-  ['continue-empty', null],
-  ['open-empty', 5],
-  ['add', 5],
-  ['error', 1],
-  ['continue', 2],
-  ['get-empty', 6],
-  ['put-with-id', 5],
-  ['put', 6],
-]);
-
-abortTest('large values mixed with small values', [
-  ['get', 1],
-  ['get', 2],
-  ['get-empty', 5],
-  ['count', null],
-  ['continue-empty', null],
-  ['open', 1],
-  ['continue', 2],
-  ['open-empty', 5],
-  ['getall', 4],
-  ['open', 2],
-  ['continue-empty', null],
-  ['add', 5],
-  ['get', 3],
-  ['count', null],
-  ['get-empty', 6],
-  ['put-with-id', 5],
-  ['getall', null],
-  ['continue', 3],
-  ['open-empty', 6],
-  ['put', 6],
-  ['error', 1],
-  ['continue', 2],
-  ['open', 4],
-  ['get-empty', 7],
-  ['count', null],
-  ['continue', 3],
-  ['add', 7],
-  ['getall', null],
-  ['error', 3],
-  ['count', null],
-]);
-
-</script>
