-
-if (window.testRunner) {
-    testRunner.dumpAsText();
-    testRunner.waitUntilDone();
-}
-
-if (window.internals) {
-    internals.settings.setScrollAnimatorEnabled(false);
-}
-
-if (window.eventSender) {
-    // Lock to the anchor inside the div
