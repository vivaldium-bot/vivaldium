-function propertyToIDL(property) {
-  // https://w3c.github.io/web-animations/#animation-property-name-to-idl-attribute-name
-  if (property === 'float') {
-    return 'cssFloat';
-  }
-  return property.replace(/-[a-z]/gi,
-                          function (str) {
-                            return str.substr(1).toUpperCase(); });
-}
