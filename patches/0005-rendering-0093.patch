-  let signalPower = 0;
-  let noisePower = 0;
-
-  let length = Math.min(actual.length, expected.length);
-
-  for (let k = 0; k < length; ++k) {
-    let diff = actual[k] - expected[k];
-    signalPower += expected[k] * expected[k];
-    noisePower += diff * diff;
-  }
