-                                     'sink.write', 0, 'sink.write', 1, 'writer.write done', 0,
-                                     'sink.write', 2, 'writer.write done', 1,
-                                     'writer.write done', 2],
-                            'events should happen in standard order');
-      });
-}, 'writer.write() promises should resolve in the standard order');
