-    transform() {}
-  }), 'constructor should throw');
-}, 'TransformStream constructor should throw when start does');
-
-test(() => {
-  const strategy = {
-    size() { throw new URIError('size thrown error'); }
-  };
-
-  assert_throws(new URIError(), () => new TransformStream({
