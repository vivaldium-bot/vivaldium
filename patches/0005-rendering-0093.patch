-else
-    line.appendChild(document.createTextNode("FAIL: scrollTop is " + scrollTop+ "px, but should be more than 600px"));
-document.getElementById('console').appendChild(line);
-
-if (window.testRunner)
-    testRunner.notifyDone();
-
-</script></body></html>
