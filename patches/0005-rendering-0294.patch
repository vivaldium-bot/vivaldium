+inline MemOperand UntagSmiMemOperand(Register rm, int offset) {
+  // Assumes that Smis are shifted by 32 bits.
+  STATIC_ASSERT(kSmiShift == 32);
+  return MemOperand(rm, SmiWordOffset(offset));
