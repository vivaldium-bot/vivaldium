+// -----------------------------------------------------------------------------
+// Machine instruction Operands
+
+#if V8_TARGET_ARCH_S390X
+constexpr RelocInfo::Mode kRelocInfo_NONEPTR = RelocInfo::NONE64;
+#else
+constexpr RelocInfo::Mode kRelocInfo_NONEPTR = RelocInfo::NONE32;
