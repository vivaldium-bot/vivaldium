+function Test(a, b, c, d, e, f, g, h) {
+  var Foo = function() { }
+  var Bar = function() { }
+
+  if (c) Foo.prototype = 12;
+  if (d) Bar.prototype = 13;
+  var x = a ? new Foo() : new Bar();
+  var y = b ? new Foo() : new Bar();
+  InstanceTest(x, Foo);
+  InstanceTest(y, Foo);
+  InstanceTest(x, Bar);
+  InstanceTest(y, Bar);
+  if (e) x.__proto__ = Bar.prototype;
+  if (f) y.__proto__ = Foo.prototype;
+  if (g) {
+    x.__proto__ = y;
+  } else {
+    if (h) y.__proto__ = x
+  }
+  InstanceTest(x, Foo);
+  InstanceTest(y, Foo);
+  InstanceTest(x, Bar);
+  InstanceTest(y, Bar);
+}
