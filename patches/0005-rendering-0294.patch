+      %OptimizeOsr();
+    }
+    assertEquals(1, a);
+    assertEquals(2, b);
+    assertEquals(3, c);
+  }
+})();
+
+(function TestInnerFunctionDestructuredParameter_1() {
+  var a = 1;
+  var b = 2;
+  var c = 3;
+  function inner([d, a]) {
+    a; b; c;
+  }
+  for (var i = 0; i < 3; ++i) {
