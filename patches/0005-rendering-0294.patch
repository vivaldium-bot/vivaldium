+};
+example({ a: 1, b: 2, c: 3}, { b: undefined });
+
+var x = { a: 3 };
+var y = {
+  set a(val) { assertUnreachable(); },
+  ...x,
+};
+assertEquals(y.a, 3);
+
+var {...y} = {
+  get a() {
+    return 1
+  }
+};
+assertEquals({a: 1}, y);
+
+var x = {
+  get a() { throw new Error(); },
+};
