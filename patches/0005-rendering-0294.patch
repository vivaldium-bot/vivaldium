+  T MsaBitInstrHelper(uint32_t opcode, T wd, T ws, int32_t m);
+
+  inline int32_t rs_reg() const { return instr_.RsValue(); }
+  inline int32_t rs() const { return get_register(rs_reg()); }
+  inline uint32_t rs_u() const {
