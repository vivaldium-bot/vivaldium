+  DCHECK(IsIsConcatSpreadableLookupChainIntact());
+  factory()->is_concat_spreadable_protector()->set_value(
+      Smi::FromInt(kProtectorInvalid));
+  DCHECK(!IsIsConcatSpreadableLookupChainIntact());
+}
