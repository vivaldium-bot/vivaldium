+    return &entries_[gc_subroot_indexes_[index]];
+  }
+  std::vector<HeapEntry>& entries() { return entries_; }
+  std::deque<HeapGraphEdge>& edges() { return edges_; }
+  std::deque<HeapGraphEdge*>& children() { return children_; }
