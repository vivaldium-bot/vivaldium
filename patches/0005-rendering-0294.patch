+
+bool TransitionsAccessor::IsConsistentWithBackPointers() {
+  int num_transitions = NumberOfTransitions();
+  for (int i = 0; i < num_transitions; i++) {
+    Map* target = GetTarget(i);
+    if (!CheckOneBackPointer(map_, target)) return false;
+  }
+  return true;
+}
