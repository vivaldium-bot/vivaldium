+void JSObject::NormalizeProperties(Handle<JSObject> object,
+                                   PropertyNormalizationMode mode,
+                                   int expected_additional_properties,
+                                   const char* reason) {
+  if (!object->HasFastProperties()) return;
+
+  Handle<Map> map(object->map());
