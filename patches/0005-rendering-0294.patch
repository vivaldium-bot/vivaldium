+  if (promise->IsJSPromise()) {
+    isolate->RunPromiseHook(PromiseHookType::kAfter,
+                            Handle<JSPromise>::cast(promise),
+                            isolate->factory()->undefined_value());
+  }
+  return isolate->heap()->undefined_value();
+}
+
+}  // namespace internal
+}  // namespace v8
