+void PrintIndentation(Isolate* isolate) {
+  const int nmax = 80;
+  int n = StackSize(isolate);
+  if (n <= nmax) {
+    PrintF("%4d:%*s", n, n, "");
+  } else {
+    PrintF("%4d:%*s", n, nmax, "...");
+  }
