diff --git a/v8/test/mjsunit/keywords-and-reserved_words.js b/v8/test/mjsunit/keywords-and-reserved_words.js
new file mode 100644
index 0000000000000000000000000000000000000000..ade43293d887636ecefb22ad5d7625c033a598e1
--- /dev/null
+++ b/v8/test/mjsunit/keywords-and-reserved_words.js
@@ -0,0 +1,177 @@
+// Copyright 2011 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
+//     * Redistributions of source code must retain the above copyright
