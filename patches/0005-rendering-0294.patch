+void MacroAssembler::UntagAndJumpIfSmi(Register dst,
+                                       Register src,
+                                       Label* smi_case) {
+  // DCHECK(!dst.is(src));
+  UseScratchRegisterScope temps(this);
+  Register scratch = temps.Acquire();
