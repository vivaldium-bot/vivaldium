+void ConsStringIterator::PushLeft(ConsString* string) {
+  frames_[depth_++ & kDepthMask] = string;
+}
+
+void ConsStringIterator::PushRight(ConsString* string) {
+  // Inplace update.
+  frames_[(depth_ - 1) & kDepthMask] = string;
+}
