+void String::PrintUC16(std::ostream& os, int start, int end) {  // NOLINT
+  if (end < 0) end = length();
+  StringCharacterStream stream(this, start);
+  for (int i = start; i < end && stream.HasMore(); i++) {
+    os << AsUC16(stream.GetNext());
+  }
