+class CallDescriptors {
+ public:
+  enum Key {
+#define DEF_ENUM(name, ...) name,
+    INTERFACE_DESCRIPTOR_LIST(DEF_ENUM)
+#undef DEF_ENUM
+        NUMBER_OF_DESCRIPTORS
+  };
+};
