+BytecodeArrayBuilder& BytecodeArrayBuilder::CompareOperation(Token::Value op,
+                                                             Register reg) {
+  switch (op) {
+    case Token::Value::EQ_STRICT:
+      OutputTestEqualStrictNoFeedback(reg);
+      break;
+    case Token::Value::INSTANCEOF:
+      OutputTestInstanceOf(reg);
+      break;
+    case Token::Value::IN:
+      OutputTestIn(reg);
+      break;
+    default:
+      UNREACHABLE();
+  }
+  return *this;
+}
