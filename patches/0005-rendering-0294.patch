+
+// Restore statics that are thread-local.
+char* Relocatable::RestoreState(Isolate* isolate, char* from) {
+  isolate->set_relocatable_top(*reinterpret_cast<Relocatable**>(from));
+  return from + ArchiveSpacePerThread();
+}
