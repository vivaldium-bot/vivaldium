+
+  void BuildVariableLoad(Variable* variable, FeedbackSlot slot,
+                         HoleCheckMode hole_check_mode,
+                         TypeofMode typeof_mode = NOT_INSIDE_TYPEOF);
+  void BuildVariableLoadForAccumulatorValue(
