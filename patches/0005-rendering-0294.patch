+    case BGEZALL:
+      Format(instr, "bgezall 'rs, 'imm16u -> 'imm16p4s2");
+      break;
+    case DAHI:
+      Format(instr, "dahi    'rs, 'imm16x");
+      break;
+    case DATI:
+      Format(instr, "dati    'rs, 'imm16x");
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
