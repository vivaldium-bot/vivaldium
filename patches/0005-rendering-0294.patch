+void JSObject::RawFastPropertyAtPut(FieldIndex index, Object* value) {
+  if (index.is_inobject()) {
+    int offset = index.offset();
+    WRITE_FIELD(this, offset, value);
+    WRITE_BARRIER(GetHeap(), this, offset, value);
