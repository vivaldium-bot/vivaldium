+#include "config.h"
+#include "core/frame/Location.h"
+
+#include "bindings/core/v8/ExceptionState.h"
+#include "bindings/core/v8/V8DOMActivityLogger.h"
+#include "core/dom/DOMURLUtilsReadOnly.h"
+#include "core/dom/Document.h"
