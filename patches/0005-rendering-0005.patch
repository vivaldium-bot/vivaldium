+
+    WTF_LOG(Media, "HTMLMediaElement::durationChanged(%p) : %f -> %f", this, m_duration, duration);
+    m_duration = duration;
+    scheduleEvent(EventTypeNames::durationchange);
+
+    if (mediaControls())
+        mediaControls()->reset();
+    if (layoutObject())
+        layoutObject()->updateFromElement();
+
+    if (requestSeek)
+        seek(duration);
+}
