+void HTMLImageElement::didMoveToNewDocument(Document& oldDocument)
+{
+    selectSourceURL(ImageLoader::UpdateIgnorePreviousError);
+    imageLoader().elementDidMoveToNewDocument();
+    HTMLElement::didMoveToNewDocument(oldDocument);
