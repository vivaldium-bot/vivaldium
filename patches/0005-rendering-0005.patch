+namespace blink {
+
+class DOMWindowLifecycleObserver;
+class LocalDOMWindow;
+
+class CORE_EXPORT DOMWindowLifecycleNotifier : public LifecycleNotifier<LocalDOMWindow, DOMWindowLifecycleObserver> {
