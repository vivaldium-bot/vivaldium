+    PassRefPtr<Image> copiedImage(SourceDrawingBuffer) const;
+    void clearCopiedImage();
+
+    SecurityOrigin* securityOrigin() const;
+    bool originClean() const;
+    void setOriginTainted() { m_originClean = false; }
