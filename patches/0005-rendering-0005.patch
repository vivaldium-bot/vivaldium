+    const IntSize& size() const { return m_size; }
+
+    void setWidth(int);
+    void setHeight(int);
+    void setAccelerationDisabled(bool accelerationDisabled) { m_accelerationDisabled = accelerationDisabled; }
+    bool accelerationDisabled() const { return m_accelerationDisabled; }
