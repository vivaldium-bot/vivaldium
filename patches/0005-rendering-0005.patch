+    expectDigest("abcdefg", "abcdefg");
+    expectDigest("abcdefg?", "abcdefg");
+    expectDigest("ab+de/g", "ab+de/g");
+    expectDigest("ab-de_g", "ab+de/g");
+
+    expectDigestFailure("?");
+    expectDigestFailure("&&&foobar&&&");
