+
+#ifndef ImageBitmap_h
+#define ImageBitmap_h
+
+#include "bindings/core/v8/ScriptWrappable.h"
+#include "core/CoreExport.h"
+#include "core/html/HTMLImageElement.h"
+#include "core/html/canvas/CanvasImageSource.h"
