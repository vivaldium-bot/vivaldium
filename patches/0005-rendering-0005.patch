+
+void HTMLMediaElement::togglePlayState()
+{
+    if (m_mediaController) {
+        if (m_mediaController->isRestrained())
+            m_mediaController->play();
+        else if (m_mediaController->paused())
+            m_mediaController->unpause();
+        else
+            m_mediaController->pause();
+    } else {
+        if (paused())
+            play();
+        else
+            pause();
+    }
+}
