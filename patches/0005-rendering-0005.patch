+void FrameView::show()
+{
+    if (!isSelfVisible()) {
+        setSelfVisible(true);
+        updateScrollableAreaSet();
+        if (isParentVisible()) {
+            for (const auto& child : m_children)
+                child->setParentVisible(true);
+        }
+    }
