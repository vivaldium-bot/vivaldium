+
+        // Add borders and padding
+        point.move(layoutObject->borderLeft() + layoutObject->paddingLeft(),
+            layoutObject->borderTop() + layoutObject->paddingTop());
+        return parentView->convertFromLayoutObject(*layoutObject, point);
+    }
+
+    return localPoint;
+}
