-      doc = load(docRef, "doc", "hc_staff");
-      newComment = doc.createComment("Comment");
-      appendedChild = doc.appendChild(newComment);
-      docFrag = doc.createDocumentFragment();
-      insertComment = doc.createComment("insertComment");
