-      inserted = doc.insertBefore(docFrag,newComment);
-      comment = newComment.previousSibling;
-
-      data = comment.data;
-
-      assertEquals("nodeinsertbefore09","insertComment",data);
-
-}
-
-function runTest() {
-   nodeinsertbefore09();
-}
