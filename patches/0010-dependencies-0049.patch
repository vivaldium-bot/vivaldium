+    target = targets.TaskTarget('test_service', 'test_job',
+                                'test_region', 'test_host')
+    self.mock_state = interface.State(target=target)
+    self.state_patcher = mock.patch('infra_libs.ts_mon.common.interface.state',
+                                    new=self.mock_state)
