+class _Logger(object):
+
+    def __init__(self, name, client):
+        self.name = name
+        self.client = client
+
+
+class _Client(object):
+
+    def __init__(self, project):
+        self.project = project
+
+    def logger(self, name):
+        return _Logger(name, self)
