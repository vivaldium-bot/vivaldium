+    const view = new tr.ui.e.chrome.cc.LayerTreeHostImplSnapshotView();
+    view.style.width = '900px';
+    view.style.height = '400px';
+    view.objectSnapshot = snapshot;
+
+    this.addHTMLOutput(view);
+  });
+});
+</script>
