+        PATH = '/foo'
+        extra_params = {'key': 'val'}
+        iterator = self._makeOne(client, PATH, extra_params=extra_params)
+        self.assertEqual(iterator.get_query_params(), extra_params)
+
+    def test_get_query_params_w_token_and_extra_params(self):
