+  def _AssertEqualsExcludingComments(self, lines1, lines2):
+    lines1 = [ln for ln in lines1 if not ln.startswith('#')]
+    lines2 = [ln for ln in lines2 if not ln.startswith('#')]
+
+    self.assertEquals(lines1, lines2)
