+    self.assertEqual(198, len(ToJSON(d)))
+    self.assertIsInstance(d['allBins'], dict)
+    self.assertDeepEqual(d, histogram.Histogram.FromDict(d).AsDict())
+
+    hist.AddSample(100)
+    d = hist.AsDict()
+    # SAMPLE_VALUES grew by "100,"
+    self.assertEqual(202, len(ToJSON(d)))
+    self.assertIsInstance(d['allBins'], dict)
+    self.assertDeepEqual(d, histogram.Histogram.FromDict(d).AsDict())
