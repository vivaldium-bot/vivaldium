+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  function createModel() {
+    const m = tr.c.TestUtils.newModelWithEvents([], {
+      shiftWorldToZero: false,
+      pruneContainers: false,
+      customizeModelCallback(m) {
