diff --git a/third_party/catapult/tracing/tracing/value/diagnostics/tag_map.html b/third_party/catapult/tracing/tracing/value/diagnostics/tag_map.html
new file mode 100644
index 0000000000000000000000000000000000000000..fafbd7cdfae31ab8b1924a3e216fa4f6e66c03e9
--- /dev/null
+++ b/third_party/catapult/tracing/tracing/value/diagnostics/tag_map.html
@@ -0,0 +1,117 @@
+<!DOCTYPE html>
+<!--
+Copyright 2017 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link rel="import" href="/tracing/base/utils.html">
+<link rel="import" href="/tracing/value/diagnostics/diagnostic.html">
+
+<script>
+'use strict';
+
+tr.exportTo('tr.v.d', function() {
+  class TagMap extends tr.v.d.Diagnostic {
+    constructor(opt_info) {
+      super();
+      this.tagsToStoryDisplayNames_ = new Map();
+
+      if (opt_info) {
+        for (const [tag, storyDisplayNames] of Object.entries(
+            opt_info.tagsToStoryDisplayNames || {})) {
+          this.tagsToStoryDisplayNames.set(tag, new Set(storyDisplayNames));
+        }
+      }
+    }
+
+    clone() {
+      const clone = new TagMap();
+      clone.addDiagnostic(this);
+      return clone;
+    }
+
+    addToHistogram(hist) {
+      hist.diagnostics.set(tr.v.d.TagMap.NAME, this);
+    }
+
+    equals(other) {
+      if (!(other instanceof TagMap)) return false;
+
+      const keys1 = new Set(this.tagsToStoryDisplayNames.keys());
+      const keys2 = new Set(other.tagsToStoryDisplayNames.keys());
+      if (!tr.b.setsEqual(keys1, keys2)) {
+        return false;
+      }
+
+      for (const key of keys1) {
+        if (!tr.b.setsEqual(
+            this.tagsToStoryDisplayNames.get(key),
+            other.tagsToStoryDisplayNames.get(key))) {
+          return false;
+        }
+      }
+
+      return true;
+    }
+
+    canAddDiagnostic(otherDiagnostic) {
+      return otherDiagnostic instanceof TagMap;
+    }
+
+    addDiagnostic(otherDiagnostic) {
+      for (const [name, storyDisplayNames] of
+          otherDiagnostic.tagsToStoryDisplayNames) {
+        if (!this.tagsToStoryDisplayNames.has(name)) {
+          this.tagsToStoryDisplayNames.set(name, new Set());
+        }
+        for (const t of storyDisplayNames) {
+          this.tagsToStoryDisplayNames.get(name).add(t);
+        }
+      }
+
+      return this;
+    }
+
+    asDictInto_(d) {
+      d.tagsToStoryDisplayNames = {};
+      for (const [name, value] of this.tagsToStoryDisplayNames) {
+        d.tagsToStoryDisplayNames[name] = Array.from(value);
+      }
+    }
+
+    /**
+     * @returns {Map.<string, Set.<string>>} A map of tag names to sets of story
+     * display names.
+     */
+    get tagsToStoryDisplayNames() {
+      return this.tagsToStoryDisplayNames_;
+    }
+
+    static fromDict(d) {
+      const info = new TagMap();
+
+      for (const [name, values] of
+          Object.entries(d.tagsToStoryDisplayNames || {})) {
+        info.tagsToStoryDisplayNames.set(name, new Set(values));
+      }
+
+      return info;
+    }
+  }
+
+  // Diagnostics generally do not need a constant name or getFromHistogram().
+  // TagMap is a special kind of Diagnostic that is produced by the
+  // benchmark to map tags to sets of story display names.
+
+  // Histograms produced by telemetry all have a single TagMap at this key
+  // in their DiagnosticMap.
+  TagMap.NAME = 'tagmap';
+
+  tr.v.d.Diagnostic.register(TagMap);
+
+  return {
+    TagMap,
+  };
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/value/diagnostics/tag_map_test.html b/third_party/catapult/tracing/tracing/value/diagnostics/tag_map_test.html
new file mode 100644
index 0000000000000000000000000000000000000000..e7856f0de6c5111948dde2aa163b4e3422d23356
--- /dev/null
+++ b/third_party/catapult/tracing/tracing/value/diagnostics/tag_map_test.html
@@ -0,0 +1,70 @@
+<!DOCTYPE html>
+<!--
+Copyright 2017 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link rel="import" href="/tracing/core/test_utils.html">
+<link rel="import" href="/tracing/value/diagnostics/generic.html">
+<link rel="import" href="/tracing/value/diagnostics/tag_map.html">
+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  test('merge', function() {
+    const t0 = new tr.v.d.TagMap({
+      tagsToStoryDisplayNames: {
+        press: ['story0', 'story1'],
+        desktop: ['story0', 'story1', 'story2']
+      }
+    });
+
+    const t1 = new tr.v.d.TagMap({
+      tagsToStoryDisplayNames: {
+        press: ['story3', 'story4'],
+        android: ['story3', 'story4', 'story5']
+      }
+    });
+
+    assert.isFalse(t0.canAddDiagnostic(new tr.v.d.Generic('')));
+    assert.isTrue(t0.canAddDiagnostic(t1));
+
+    const m0 = t0.clone();
+    assert.instanceOf(m0, tr.v.d.TagMap);
+    assert.isFalse(m0.canAddDiagnostic(new tr.v.d.Generic('')));
+    assert.isTrue(m0.canAddDiagnostic(t1));
+
+    m0.addDiagnostic(t1);
+
+    const m1 = t1.clone();
+    m1.addDiagnostic(t0);
+
+    assert.isTrue(m1.equals(m0));
+    assert.isTrue(m0.equals(m1));
+
+    const m2 = t1.clone();
+
+    assert.isFalse(m2.equals(m0));
+    assert.isFalse(m0.equals(m2));
+
+    // Test round-tripping of non-merged diagnostic
+    const clonet0 = tr.v.d.Diagnostic.fromDict(t0.asDict()).clone();
+
+    assert.isTrue(clonet0.equals(t0.clone()));
+
+    // Test round-tripping of merged diagnostic
+    const clone = tr.v.d.Diagnostic.fromDict(m0.asDict());
+
+    assert.deepEqual(Array.from(clone.tagsToStoryDisplayNames.keys()), [
+      'press', 'desktop', 'android']);
+    assert.deepEqual(Array.from(clone.tagsToStoryDisplayNames.get('press')), [
+      'story0', 'story1', 'story3', 'story4']);
+    assert.deepEqual(Array.from(clone.tagsToStoryDisplayNames.get('desktop')), [
+      'story0', 'story1', 'story2']);
+    assert.deepEqual(Array.from(clone.tagsToStoryDisplayNames.get('android')), [
+      'story3', 'story4', 'story5']);
+  });
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/value/diagnostics/telemetry_info.html b/third_party/catapult/tracing/tracing/value/diagnostics/telemetry_info.html
