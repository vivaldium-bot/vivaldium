+            {'kind': 'CHILD', 'id': 1234},
+            {'kind': 'GRANDCHILD', 'id': 5678},
+        ]
+        pb = self._makePB(path=_PATH, project='PROJECT')
+        key = self._callFUT(pb)
+        self.assertEqual(key.path, _PATH)
