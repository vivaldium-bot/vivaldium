+def main(argv):
+  """Main function."""
+  # No actual options used, but --help is still supported.
+  parser = GetParser()
+  _opts = parser.parse_args(argv)
+
+  if build_lib.IsInsideChroot():
+    InsideChroot().Run()
+  else:
+    OutsideChroot(argv).Run()
