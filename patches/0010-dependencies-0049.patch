+        ['--board', BOARD, '--out-dir', self.BAD_TARGET_DIR, '--package',
+         constants.CHROME_CP])
+    self.assertRaises(cros_build_lib.DieSystemExit,
+                      cros_gen.FinishParsing, options)
diff --git a/third_party/chromite/scripts/cros_install_debug_syms.py b/third_party/chromite/scripts/cros_install_debug_syms.py
