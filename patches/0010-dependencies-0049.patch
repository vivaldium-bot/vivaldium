+def _datetime_to_rfc3339_w_nanos(value):
+    from gcloud._helpers import _RFC3339_NO_FRACTION
+    no_fraction = value.strftime(_RFC3339_NO_FRACTION)
+    return '%s.%09dZ' % (no_fraction, value.microsecond * 1000)
+
