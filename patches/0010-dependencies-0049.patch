+            buckets: [
+              {
+                high: 20,
+                count: 2,
+                low: 16,
+              },
+              {
+                high: 24,
+                count: 2,
+                low: 20,
+              }
+            ],
+            important: false,
+            type: 'histogram',
+            name: 'MPArch_RWH_TabSwitchPaintDuration',
+          }
+        }
+      }
+    };
+    const histograms = new tr.v.HistogramSet();
+    tr.v.ChartJsonConverter.convertChartJson(charts, histograms);
+    assert.lengthOf(histograms, 1);
