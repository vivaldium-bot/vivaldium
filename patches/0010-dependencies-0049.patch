+
+        :type use_chunks: boolean
+        :param use_chunks: If False, ignore :attr:`chunksize`.
+
+        :rtype: str
+        :returns: Last byte to use in a 'Range' header, or None.
+        """
+        end_byte = end
+
+        if start < 0 and not self.total_size:
+            return end_byte
+
