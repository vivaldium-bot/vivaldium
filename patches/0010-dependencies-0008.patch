index 0000000000000000000000000000000000000000..250f666e1eea4c5ec5ba91f3084b7c944eca6df7
--- /dev/null
+++ b/third_party/boringssl/src/fuzz/client.cc
@@ -0,0 +1,146 @@
+/* Copyright (c) 2016, Google Inc.
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
