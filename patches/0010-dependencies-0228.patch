+    PATHS ${YASM_POSSIBLE_PATHS}
+    )
+
+SET (YASM_POSSIBLE_INCLUDE_PATHS
+    "${YASM_PATH}"
+    "${YASM_PATH}/../include"
+    "$ENV{ProgramFiles}/Yasm/Include"
+    /usr/include
+    /usr/local/include
+    )
+
+FIND_PATH(YASM_INCLUDE_PATH NAMES libyasm.h
