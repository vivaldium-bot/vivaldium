+
+SET (YASM_POSSIBLE_LIB_PATHS
+    "${YASM_PATH}"
+    "${YASM_PATH}/../lib"
+    "${YASM_INCLUDE_PATH}/../lib"
+    "$ENV{ProgramFiles}/Yasm/Lib"
+    /usr/lib
+    /usr/local/lib
+    )
+
+FIND_LIBRARY(YASM_LIBRARY
