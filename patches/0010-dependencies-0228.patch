+            }
+            free_tlist(origline);
+            break;
+
+        case PP_POP:
+            if (tline->next)
+                error(ERR_WARNING, "trailing garbage after `%%pop' ignored");
+            if (!cstk)
+                error(ERR_NONFATAL,
+                        "`%%pop': context stack is already empty");
+            else
+                ctx_pop();
+            free_tlist(origline);
+            break;
+
+        case PP_SCOPE:
+            if (tline->next)
+                error(ERR_WARNING, "trailing garbage after `%%scope' ignored");
