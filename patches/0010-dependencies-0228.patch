+
+        case PP_PUSH:
+            tline = tline->next;
+            skip_white_(tline);
+            tline = expand_id(tline);
+            if (!tok_type_(tline, TOK_ID))
+            {
+                error(ERR_NONFATAL, "`%%push' expects a context identifier");
+                free_tlist(origline);
+                return DIRECTIVE_FOUND; /* but we did _something_ */
+            }
+            if (tline->next)
+                error(ERR_WARNING, "trailing garbage after `%%push' ignored");
