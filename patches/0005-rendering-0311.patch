+    Protocol.Debugger.stepOver();
+    await Protocol.Debugger.oncePaused();
+    Protocol.Debugger.stepOver();
+    await waitPauseAndDumpLocation();
+    Protocol.Debugger.scheduleStepIntoAsync();
+    Protocol.Debugger.stepOver();
+    await waitPauseAndDumpLocation();
+    await Protocol.Debugger.resume();
+    await InspectorTest.waitForPendingTasks();
+  },
