+    var locations = (await Protocol.Debugger.getPossibleBreakpoints({
+      start: { lineNumber: 0, columnNumber: 0, scriptId }
+    })).result.locations;
+    InspectorTest.logMessage(locations.filter(location => location.type === 'return'));
+  }
+]);
