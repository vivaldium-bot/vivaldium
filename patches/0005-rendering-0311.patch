+
+const Debug = debug.Debug;
+let exception = null;
+let step_count = 0;
+
+Debug.setListener((event, execState, eventData, data) => {
+  if (event != Debug.DebugEvent.Break) return;
+  try {
+    const line = execState.frame(0).sourceLineText();
