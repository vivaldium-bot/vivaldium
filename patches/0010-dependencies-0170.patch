diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Mips/2008-10-13-LegalizerBug.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Mips/2008-10-13-LegalizerBug.ll
