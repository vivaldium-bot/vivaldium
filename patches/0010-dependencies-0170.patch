diff --git a/third_party/swiftshader/third_party/LLVM/tools/llvm-bcanalyzer/llvm-bcanalyzer.cpp b/third_party/swiftshader/third_party/LLVM/tools/llvm-bcanalyzer/llvm-bcanalyzer.cpp
