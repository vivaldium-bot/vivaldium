diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/MSP430/mult-alt-generic-msp430.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/MSP430/mult-alt-generic-msp430.ll
