diff --git a/third_party/swiftshader/third_party/LLVM/unittests/ExecutionEngine/JIT/MultiJITTest.cpp b/third_party/swiftshader/third_party/LLVM/unittests/ExecutionEngine/JIT/MultiJITTest.cpp
