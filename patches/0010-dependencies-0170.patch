diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2003-08-17-BranchFoldOrdering.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2003-08-17-BranchFoldOrdering.ll
