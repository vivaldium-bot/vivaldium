diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Reassociate/2011-01-26-UseAfterFree.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Reassociate/2011-01-26-UseAfterFree.ll
