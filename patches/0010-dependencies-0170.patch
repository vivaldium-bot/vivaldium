diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Generic/2003-07-08-BadCastToBool.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Generic/2003-07-08-BadCastToBool.ll
