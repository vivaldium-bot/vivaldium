diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/MSP430/2009-08-25-DynamicStackAlloc.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/MSP430/2009-08-25-DynamicStackAlloc.ll
