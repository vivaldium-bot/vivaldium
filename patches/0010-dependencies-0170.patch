diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyLibCalls/StrPBrk.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyLibCalls/StrPBrk.ll
