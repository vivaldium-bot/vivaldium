diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2011-03-08-UnreachableUse.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2011-03-08-UnreachableUse.ll
