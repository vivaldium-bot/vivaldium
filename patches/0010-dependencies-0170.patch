diff --git a/third_party/swiftshader/third_party/LLVM/tools/llvm-as/llvm-as.cpp b/third_party/swiftshader/third_party/LLVM/tools/llvm-as/llvm-as.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5cd707c3971bd439970d7dae32c2d6dc3aec7898
--- /dev/null
