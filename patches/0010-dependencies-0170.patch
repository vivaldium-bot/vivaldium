+
+bb314:                                            ; preds = %cond_next305
+  ret void
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Blackfin/add-overflow.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Blackfin/add-overflow.ll
