diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch_switch_fold.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch_switch_fold.ll
