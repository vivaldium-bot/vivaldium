diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Generic/llvm-ct-intrinsics.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Generic/llvm-ct-intrinsics.ll
