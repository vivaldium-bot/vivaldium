diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/speculate-with-offset.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/speculate-with-offset.ll
