+template<>
+tcu::TestStatus DrawTestInstance<DrawParams>::iterate (void)
+{
+	tcu::TestLog			&log				= m_context.getTestContext().getLog();
+	const vk::VkQueue		queue				= m_context.getUniversalQueue();
+
+	beginRenderPass();
