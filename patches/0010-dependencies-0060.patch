+typedef enum {
+  GTMFadeTruncatingTail = 0x1,
+  GTMFadeTruncatingHead = 0x2,
+  GTMFadeTruncatingHeadAndTail = GTMFadeTruncatingHead | GTMFadeTruncatingTail
+} GTMFadeTruncatingMode;
