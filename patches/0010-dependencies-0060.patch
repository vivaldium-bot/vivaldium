index 0000000000000000000000000000000000000000..f48aa3b44364e1b30b8ab57b7ba8a9c60c347ec6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/elbg.h
@@ -0,0 +1,57 @@
