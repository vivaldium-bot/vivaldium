+++ b/third_party/ffmpeg/libavcodec/libwebpenc.c
@@ -0,0 +1,112 @@
+/*
+ * WebP encoding support via libwebp
+ * Copyright (c) 2013 Justin Ruggles <justin.ruggles@gmail.com>
+ *
