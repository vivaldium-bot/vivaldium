+/**
+ * @file
+ * DSP functions (inverse transforms, motion compensations, wavelet recompostion)
+ * for Indeo Video Interactive codecs.
+ */
+
+#ifndef AVCODEC_IVI_DSP_H
+#define AVCODEC_IVI_DSP_H
