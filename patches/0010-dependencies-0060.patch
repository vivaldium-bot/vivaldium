+	const VkPipelineShaderStageCreateInfo	shaderStageParams[]	=
+	{
+		{
+			VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,	// sType
+			DE_NULL,												// pNext
