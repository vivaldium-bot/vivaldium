+		m_topology = vk::VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+
+		m_data.push_back(PositionColorVertex(tcu::Vec4(-1.0f, 0.0f, 0.0f, 1.0f), tcu::RGBA::green().toVec()));
