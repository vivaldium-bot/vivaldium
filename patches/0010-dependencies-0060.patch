+		DE_ASSERT(pOutHandles->size() != 0);
+
+		const VkPipelineShaderStageCreateInfo			stages[]			=
+		{
+			{
+				VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
