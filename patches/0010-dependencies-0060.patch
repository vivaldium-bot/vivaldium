diff --git a/third_party/ffmpeg/libavcodec/copy_block.h b/third_party/ffmpeg/libavcodec/copy_block.h
new file mode 100644
index 0000000000000000000000000000000000000000..9ed451f29409a39f29eff53e3977f11eb976680f
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/copy_block.h
@@ -0,0 +1,89 @@
