+
+.SUFFIXES: .c .o .rc
+# Rule to make compiled resource (Windows)
+.rc.o:
+	windres --include-dir $(resdir) -i $< -o $@
+	
+# Don't use implicit rules, since AIX "make" and OSF/1 "make" don't always
+# expand $< correctly in this context.
+#
+#%.o : %.c
+#	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<
+#
