+		VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		DE_NULL,
+		pAllocInfo_allocationSize,
+		pAllocInfo_memoryTypeIndex,
+	};
+	return allocateMemory(vk, device, &pAllocInfo);
+}
