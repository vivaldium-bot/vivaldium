+		cmd.indexCount						= indexC;
+		cmd.instanceCount					= instanceC;
+		cmd.firstIndex						= firstIdx;
+		cmd.vertexOffset					= vertexO;
+		cmd.firstInstance					= firstIns;
+
+		commands.push_back(cmd);
+	}
+};
