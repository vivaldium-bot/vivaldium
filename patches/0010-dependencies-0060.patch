+		VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,	// VkCommandBufferUsageFlags                flags;
+		DE_NULL,										// const VkCommandBufferInheritanceInfo*    pInheritanceInfo;
+	};
+	VK_CHECK(vk.beginCommandBuffer(commandBuffer, &info));
+}
