+    { "qcomp",            "-1" },
+//     { "rc_lookahead",     "-1" },
+    { "refs",             "-1" },
+#if FF_API_PRIVATE_OPT
+    { "sc_threshold",     "-1" },
+#endif
+    { "trellis",          "-1" },
+#if FF_API_PRIVATE_OPT
+    { "nr",               "-1" },
+#endif
+    { "me_range",         "-1" },
+#if FF_API_MOTION_EST
+    { "me_method",        "-1" },
+#endif
+    { "subq",             "-1" },
+#if FF_API_PRIVATE_OPT
+    { "b_strategy",       "-1" },
