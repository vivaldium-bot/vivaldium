+
+	const deUint32	bufferSize	= (deUint32)(m_data.indexes.size() * sizeof(deUint32));
+
+	vk::Move<vk::VkBuffer>	indexBuffer;
+
+	const vk::VkBufferCreateInfo	bufferCreateInfo =
+	{
