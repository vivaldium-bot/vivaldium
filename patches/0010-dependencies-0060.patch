+	for (size_t ndx = 0; ndx < m_managedSets.size(); ++ndx)
+	{
+		if (m_managedSets[ndx] == impl)
+		{
+			std::swap(m_managedSets[ndx], m_managedSets.back());
+			m_managedSets.pop_back();
+			delete impl;
