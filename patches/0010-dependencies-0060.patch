+static int explicit_rdpcm_flag_decode(HEVCContext *s, int c_idx)
+{
+    return GET_CABAC(elem_offset[EXPLICIT_RDPCM_FLAG] + !!c_idx);
+}
+
+static int explicit_rdpcm_dir_flag_decode(HEVCContext *s, int c_idx)
+{
