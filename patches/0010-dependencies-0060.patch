diff --git a/third_party/ffmpeg/libavcodec/gsm_parser.c b/third_party/ffmpeg/libavcodec/gsm_parser.c
new file mode 100644
index 0000000000000000000000000000000000000000..1054a30ca919fa9fe17d8fcf48c1135cd3657e4f
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/gsm_parser.c
@@ -0,0 +1,91 @@
+/*
