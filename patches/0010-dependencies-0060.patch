+		const VkAttachmentDescription attachments[2] =
+		{
+			colorAttachmentDescription,
+			depthAttachmentDescription
+		};
+
+		const VkAttachmentReference colorAttachmentReference =
+		{
+			0u,													// deUint32			attachment;
