new file mode 100644
index 0000000000000000000000000000000000000000..cf01289fdf71d72ff50e4a6edea593deaadfe75d
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/intrax8.c
@@ -0,0 +1,793 @@
