--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/fft_template.c
@@ -0,0 +1,528 @@
+/*
+ * FFT/IFFT transforms
+ * Copyright (c) 2008 Loren Merritt
+ * Copyright (c) 2002 Fabrice Bellard
