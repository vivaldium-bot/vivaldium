+
+	// Validation
+	VK_CHECK(m_vk.queueWaitIdle(queue));
+
+	tcu::Texture2D referenceFrame(vk::mapVkFormat(m_colorAttachmentFormat), (int)(0.5 + WIDTH), (int)(0.5 + HEIGHT));
