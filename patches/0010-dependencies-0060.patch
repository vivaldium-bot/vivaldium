index 0000000000000000000000000000000000000000..e5f7c4ebdc97330dba71761fed2e1bee1c4c8139
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/libfdk-aacdec.c
@@ -0,0 +1,385 @@
+/*
+ * AAC decoder wrapper
