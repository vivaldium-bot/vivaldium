+		case FMT_CASE(RGBA, HALF_FLOAT):					return VK_FORMAT_R16G16B16A16_SFLOAT;
+
+		case FMT_CASE(R, UNSIGNED_INT32):					return VK_FORMAT_R32_UINT;
+		case FMT_CASE(R, SIGNED_INT32):						return VK_FORMAT_R32_SINT;
