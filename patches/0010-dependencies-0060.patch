diff --git a/third_party/google_toolbox_for_mac/src/XcodePlugin/Resources/CreateUnitTestExecutable.applescript b/third_party/google_toolbox_for_mac/src/XcodePlugin/Resources/CreateUnitTestExecutable.applescript
