+	const vk::VkBufferCopy		range			=
+	{
+		0, 0, // Offsets
+		m_bufferSize
+	};
+
+	vkd.cmdCopyBuffer(commandBuffer, *m_srcBuffer, context.getBuffer(), 1, &range);
+}
