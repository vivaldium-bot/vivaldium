+#ifdef DEBUG
+static uint16_t ivi_calc_band_checksum(IVIBandDesc *band)
+{
+    int         x, y;
+    int16_t     *src, checksum;
+
+    src = band->buf;
+    checksum = 0;
+
+    for (y = 0; y < band->height; src += band->pitch, y++)
+        for (x = 0; x < band->width; x++)
+            checksum += src[x];
+
+    return checksum;
+}
+#endif
