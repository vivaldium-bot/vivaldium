new file mode 100644
index 0000000000000000000000000000000000000000..cd16184c18b5a1bc6a50184da2f16804b8672b6c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/jpeglsenc.c
@@ -0,0 +1,483 @@
+/*
+ * JPEG-LS encoder
+ * Copyright (c) 2003 Michael Niedermayer
+ * Copyright (c) 2006 Konstantin Shishkov
+ *
+ * This file is part of FFmpeg.
+ *
