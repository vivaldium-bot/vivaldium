+																			 const deUintptr			bufferSize,
+																			 const tcu::UVec3&			workGroupSize,
+																			 const DispatchCommandsVec&	dispatchCommands)
+										: IndirectDispatchInstanceBufferUpload(context, name, bufferSize, workGroupSize, dispatchCommands) {}
+
