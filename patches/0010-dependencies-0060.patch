+void BufferLoadStoreTestInstance::commandBindDescriptorsForLayer (const VkCommandBuffer cmdBuffer, const VkPipelineLayout pipelineLayout, const int layerNdx)
+{
+	DE_ASSERT(layerNdx == 0);
+	DE_UNREF(layerNdx);
