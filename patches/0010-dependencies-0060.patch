+				VK_SHADER_STAGE_VERTEX_BIT,
+				*res.vertexShader.object,
+				"main",
+				DE_NULL,							// pSpecializationInfo
+			},
+			{
+				VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+				DE_NULL,
+				(VkPipelineShaderStageCreateFlags)0,
