diff --git a/third_party/google_toolbox_for_mac/src/XcodePlugin/GTMXcodeCorrectWhiteSpace.m b/third_party/google_toolbox_for_mac/src/XcodePlugin/GTMXcodeCorrectWhiteSpace.m
