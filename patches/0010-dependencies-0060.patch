index 0000000000000000000000000000000000000000..1b38019a693eb72363e78c0cfb6664c3b06de00d
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/cook.c
@@ -0,0 +1,1295 @@
+/*
