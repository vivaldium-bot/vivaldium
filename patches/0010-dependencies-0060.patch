+void createFormatTests (tcu::TestCaseGroup* testGroup)
+{
+	DE_STATIC_ASSERT(VK_FORMAT_UNDEFINED == 0);
+
+	for (deUint32 formatNdx = VK_FORMAT_UNDEFINED+1; formatNdx < VK_CORE_FORMAT_LAST; ++formatNdx)
