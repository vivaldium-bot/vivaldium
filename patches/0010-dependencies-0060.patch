+		VK_QUERY_TYPE_OCCLUSION,									// queryType
+		1u,															// entryCount
+		0u,															// pipelineStatistics
+	};
+	Unique<VkQueryPool>						queryPool				(createQueryPool(vk, vkDevice, &queryPoolCreateInfo));
