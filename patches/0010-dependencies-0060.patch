+    FIRST_AUDIO_BLOCK   = 0x7c,
+    AUDIO_BLOCK         = 0x7d,
+    VIDEO_I_FRAME       = 0x03,
+    VIDEO_P_FRAME       = 0x01,
+    VIDEO_YOFF_P_FRAME  = 0x04,
+    EOF_BLOCK           = 0x14,
+};
