+			vk::VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+			DE_NULL,
+
+			0u,
+			vk::VK_IMAGE_TYPE_2D,
+			vk::VK_FORMAT_R8G8B8A8_UNORM,
+			{
+				(deUint32)m_imageWidth,
