+		| vk::VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT
+		| vk::VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
+		| vk::VK_ACCESS_TRANSFER_WRITE_BIT
+		| vk::VK_ACCESS_HOST_WRITE_BIT
+		| vk::VK_ACCESS_MEMORY_WRITE_BIT;
+}
