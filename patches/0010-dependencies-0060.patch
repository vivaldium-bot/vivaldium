diff --git a/third_party/ffmpeg/libavcodec/fft-internal.h b/third_party/ffmpeg/libavcodec/fft-internal.h
new file mode 100644
index 0000000000000000000000000000000000000000..0a8f7d05cf8dbe388c7b8ed8d7e96fd03f6847af
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/fft-internal.h
@@ -0,0 +1,94 @@
+/*
