+                resword = &wordlist[297];
+                goto compare;
+              case 981:
+                resword = &wordlist[298];
+                goto compare;
+              case 1045:
+                resword = &wordlist[299];
+                goto compare;
+            }
+          return 0;
+        compare:
+          {
+            register const char *s = resword->name;
+
+            if (*str == *s && !strcmp (str + 1, s + 1))
+              return resword;
+          }
+        }
+    }
+  return 0;
+}
