+	const vk::VkCommandBuffer	cmd			= context.getCommandBuffer();
+	const vk::VkBuffer			buffer		= context.getBuffer();
+	const vk::VkDeviceSize		sizeMask	= ~(0x3ull); // \note Round down to multiple of 4
