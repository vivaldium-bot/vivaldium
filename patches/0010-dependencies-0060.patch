+const std::string CacheTestParam::generateTestName (void) const
+{
+	std::string result(getShaderFlagStr(m_shaders[0], false));
+
+	for(deUint32 ndx = 1; ndx < m_shaderCount; ndx++)
+		result += '_' + getShaderFlagStr(m_shaders[ndx], false) ;
+
+	return result;
+}
