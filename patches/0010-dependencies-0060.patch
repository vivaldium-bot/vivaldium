+template<>
+class Deleter<VkDescriptorSet>
+{
+public:
+							Deleter		(const DeviceInterface& deviceIface, VkDevice device, VkDescriptorPool pool)
+								: m_deviceIface	(&deviceIface)
+								, m_device		(device)
+								, m_pool		(pool)
+							{}
+							Deleter		(void)
+								: m_deviceIface	(DE_NULL)
