+		VK_ATTACHMENT_LOAD_OP_CLEAR,					// loadOp
+		VK_ATTACHMENT_STORE_OP_STORE,					// storeOp
+		VK_ATTACHMENT_LOAD_OP_DONT_CARE,				// stencilLoadOp
+		VK_ATTACHMENT_STORE_OP_DONT_CARE,				// stencilStoreOp
