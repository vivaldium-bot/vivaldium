+	void							verify					(VerifyContext& context, size_t commandIndex);
+
+private:
+	const deUint32					m_seed;
+	vk::VkDeviceSize				m_bufferSize;
+	vk::Move<vk::VkBuffer>			m_srcBuffer;
+	vk::Move<vk::VkDeviceMemory>	m_memory;
+};
