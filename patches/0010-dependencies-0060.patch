+ImageFetchRenderInstance::ImageFetchRenderInstance	(vkt::Context&			context,
+													 bool					isPrimaryCmdBuf,
+													 vk::VkDescriptorType	descriptorType,
+													 vk::VkShaderStageFlags	stageFlags,
