+					0u,
+					1u
+				}
+			};
+
+			m_imageView = vk::createImageView(vkd, device, &createInfo);
+		}
+
+		{
+			const vk::VkDescriptorImageInfo			imageInfo	=
+			{
+				0,
+				*m_imageView,
+				context.getImageLayout()
+			};
+			const vk::VkWriteDescriptorSet			write		=
+			{
+				vk::VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
