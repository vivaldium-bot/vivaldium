+		VK_FILTER_NEAREST,								// VkFilter                magFilter;
+		VK_FILTER_NEAREST,								// VkFilter                minFilter;
+		VK_SAMPLER_MIPMAP_MODE_NEAREST,					// VkSamplerMipmapMode     mipmapMode;
