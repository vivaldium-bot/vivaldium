+template<typename T>
+std::vector<T> makeVector (const T& o1)
+{
+	std::vector<T> vec;
+	vec.reserve(1);
+	vec.push_back(o1);
+	return vec;
+}
+
+template<typename T>
+std::vector<T> makeVector (const T& o1, const T& o2)
+{
+	std::vector<T> vec;
+	vec.reserve(2);
+	vec.push_back(o1);
+	vec.push_back(o2);
+	return vec;
+}
+
+template<typename T>
+std::vector<T> makeVector (const T& o1, const T& o2, const T& o3)
+{
+	std::vector<T> vec;
+	vec.reserve(3);
+	vec.push_back(o1);
+	vec.push_back(o2);
+	vec.push_back(o3);
+	return vec;
+}
+
+template<typename T>
+std::vector<T> makeVector (const T& o1, const T& o2, const T& o3, const T& o4)
+{
+	std::vector<T> vec;
+	vec.reserve(4);
+	vec.push_back(o1);
+	vec.push_back(o2);
+	vec.push_back(o3);
+	vec.push_back(o4);
+	return vec;
+}
