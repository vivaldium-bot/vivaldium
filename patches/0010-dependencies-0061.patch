+};
+
+class MSInterpolationCaseBase : public TestCase
+{
+public:
+	MSInterpolationCaseBase	(tcu::TestContext&		testCtx,
+							 const std::string&		name,
+							 const ImageMSParams&	imageMSParams)
+		: TestCase(testCtx, name, "")
