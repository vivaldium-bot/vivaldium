+static const char* s_outSwizzles[]	= { "x", "yz", "xyz", "xyzw" };
+
+static const BVec4 s_outSwizzleChannelMasks[] =
+{
+	BVec4(true,  false, false, false),
+	BVec4(false, true,  true,  false),
+	BVec4(true,  true,  true,  false),
