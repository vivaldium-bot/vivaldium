+	TEXTURESWIZZLECOMPONENT_A,
+	TEXTURESWIZZLECOMPONENT_ZERO,
+	TEXTURESWIZZLECOMPONENT_ONE,
+
+	TEXTURESWIZZLECOMPONENT_LAST
+};
