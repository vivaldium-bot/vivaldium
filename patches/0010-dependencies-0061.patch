+      org.apache.http.HttpRequest)</CODE></A>, 
+<A HREF="../../../../../org/apache/http/client/HttpClient.html#execute(org.apache.http.client.methods.HttpUriRequest, org.apache.http.protocol.HttpContext)"><CODE>HttpClient.execute(HttpUriRequest,
+      org.apache.http.protocol.HttpContext)</CODE></A>, 
+<A HREF="../../../../../org/apache/http/client/HttpClient.html#execute(org.apache.http.HttpHost, org.apache.http.HttpRequest, org.apache.http.protocol.HttpContext)"><CODE>HttpClient.execute(org.apache.http.HttpHost,
+      org.apache.http.HttpRequest, org.apache.http.protocol.HttpContext)</CODE></A></DL>
+</DD>
