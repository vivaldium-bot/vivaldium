+		 1.0f,  1.0f,  0.5f, 1.0f,
+		 1.0f, -1.0f,  1.0f, 1.0f,
+	};
+
+	addAttribute(0u, VK_FORMAT_R32G32B32A32_SFLOAT, deUint32(sizeof(float) * 4), 4, vertices);
+}
