+
+inline float projectedTriInterpolate (const Vec3& s, const Vec3& w, float nx, float ny)
+{
+	return (s[0]*(1.0f-nx-ny)/w[0] + s[1]*ny/w[1] + s[2]*nx/w[2]) / ((1.0f-nx-ny)/w[0] + ny/w[1] + nx/w[2]);
+}
