+void ShaderDiscardTests::init (void)
+{
+	for (int tmpl = 0; tmpl < DISCARDTEMPLATE_LAST; tmpl++)
+		for (int mode = 0; mode < DISCARDMODE_LAST; mode++)
+			addChild(makeDiscardCase(m_testCtx, (DiscardTemplate)tmpl, (DiscardMode)mode).release());
+}
