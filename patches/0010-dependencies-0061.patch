+MipmapSparseResidencyInstance::MipmapSparseResidencyInstance (Context&					context,
+															  const ImageType			imageType,
+															  const tcu::UVec3&			imageSize,
+															  const tcu::TextureFormat&	format)
+	: SparseResourcesBaseInstance	(context)
