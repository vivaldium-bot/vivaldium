+		VK_FORMAT_R8G8B8A8_SNORM,
+		VK_FORMAT_R8G8_UINT,
+		VK_FORMAT_R8_SINT,
+		VK_FORMAT_R8G8B8A8_SRGB,
+		VK_FORMAT_R8G8B8A8_UNORM,
+		VK_FORMAT_B8G8R8A8_UNORM,
+		VK_FORMAT_B8G8R8_SRGB,
+		VK_FORMAT_R8G8_SRGB,
+		VK_FORMAT_R8_UINT,
+		VK_FORMAT_R8G8B8A8_UINT,
+		VK_FORMAT_R8G8_SINT,
