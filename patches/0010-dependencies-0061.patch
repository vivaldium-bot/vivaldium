+			, tex2DArray	(DE_NULL)
+			, texCubeArray	(DE_NULL)
+		{
+		}
+	};
+
+							ShaderEvalContext		(const QuadGrid& quadGrid);
+							~ShaderEvalContext		(void);
+
+	void					reset					(float sx, float sy);
+
+	// Inputs.
+	tcu::Vec4				coords;
