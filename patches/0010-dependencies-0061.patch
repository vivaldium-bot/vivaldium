+static deUint32 getVecStd430ByteAlignment (glu::DataType type)
+{
+	switch (glu::getDataTypeScalarSize(type))
+	{
+		case 1:		return 4u;
+		case 2:		return 8u;
+		case 3:		return 16u;
+		case 4:		return 16u;
+		default:
+			DE_ASSERT(false);
+			return 0u;
+	}
+}
