+enum PrecisionMask
+{
+	PRECMASK_NA				= 0,						//!< Precision not applicable (booleans)
+	PRECMASK_MEDIUMP		= (1<<PRECISION_MEDIUMP),
+	PRECMASK_HIGHP			= (1<<PRECISION_HIGHP),
+
+	PRECMASK_ALL			= PRECMASK_MEDIUMP | PRECMASK_HIGHP
