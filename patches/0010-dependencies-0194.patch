index 0000000000000000000000000000000000000000..5e15696ee1b8e2dde278434e03ba7746248f5831
--- /dev/null
+++ b/third_party/webrtc/common_audio/vad/vad_filterbank.c
@@ -0,0 +1,330 @@
+/*
