+function persp(fovy, aspect, n, f) {
+  var dz = f - n;
+  var rad = fovy / 2.0 * 3.14159265 / 180;
+
+  var s = Math.sin(rad);
+  if (dz == 0 || s == 0 || aspect == 0)
+    return;
+
+  var cot = Math.cos(rad) / s;
+
+  return [
+    cot / aspect,
+    0.0,
+    0.0,
+    0.0,
+
+    0.0,
+    cot,
+    0.0,
+    0.0,
+
+    0.0,
+    0.0,
+    -(f + n) / dz,
+    -1.0,
+
+    0.0,
+    0.0,
+    -2.0 * f * n / dz,
+    0.0
+  ];
+}
