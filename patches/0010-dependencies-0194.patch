+  rtc::Thread* const network_thread_;
+  cricket::FakeMediaEngine* media_engine_;
+  std::unique_ptr<cricket::ChannelManager> channel_manager_;
+  std::unique_ptr<webrtc::MediaControllerInterface> media_controller_;
