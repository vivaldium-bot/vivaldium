+  v3:    { typeCode: "v4", order: 2 },
+  v4:    { typeCode: "m2", order: 3 },
+  m2:    { typeCode: "m3", order: 4 },
+  m3:    { typeCode: "m4", order: 5 },
+  m4:    { typeCode: "s",  order: 6 },
