index 0000000000000000000000000000000000000000..6163f5a9586e837834ff8bb24fcbe7a1e7ee459b
--- /dev/null
+++ b/third_party/webrtc/api/androidtests/src/org/webrtc/Camera1CapturerUsingByteBufferTest.java
@@ -0,0 +1,172 @@
+/*
+ *  Copyright 2016 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
