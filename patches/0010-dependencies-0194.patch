+  "$(errorBound)",
+
+  "varying vec4 vColor;",
+
+  "void main() {",
+  "  $(argsList)",
+
+  "  $(type) v = $(type)($(argsConstr));",
+
+  "  if ($(checkCompVals))",
+  "    vColor = green;",
+  "  else",
+  "    vColor = red;",
+
+  "  gl_Position = vPosition;",
+  "}"
