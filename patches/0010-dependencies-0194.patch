index 0000000000000000000000000000000000000000..31abe501120eb4c06ff54ccfac4d11676683e496
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.3/conformance/resources/iterable-test.js
@@ -0,0 +1,173 @@
+/*
