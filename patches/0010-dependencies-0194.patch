+  virtual ~FakeTaskRunner() {}
+
+  virtual void WakeTasks() { RunTasks(); }
+
+  virtual int64_t CurrentTime() {
+    // Implement if needed.
+    return current_time_++;
+  }
+
+  int64_t current_time_;
+};
