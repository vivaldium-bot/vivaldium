index 0000000000000000000000000000000000000000..7cc06312d8c93687ca674ce6e32b66d4cfc57e21
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.3/conformance/resources/oes-texture-float-and-half-float-linear.js
@@ -0,0 +1,183 @@
+/*
+** Copyright (c) 2013 The Khronos Group Inc.
+**
+** Permission is hereby granted, free of charge, to any person obtaining a
+** copy of this software and/or associated documentation files (the
+** "Materials"), to deal in the Materials without restriction, including
+** without limitation the rights to use, copy, modify, merge, publish,
