+  switch (typeCode) {
+    case "s":  return [1, 1];
+    case "v2": return [1, 2];
+    case "v3": return [1, 3];
+    case "v4": return [1, 4];
+    case "m2": return [2, 2];
+    case "m3": return [3, 3];
+    case "m4": return [4, 4];
