+        @Override
+        public void onError(int error, android.hardware.Camera camera) {
+          String errorMessage;
+          if (error == android.hardware.Camera.CAMERA_ERROR_SERVER_DIED) {
+            errorMessage = "Camera server died!";
+          } else {
+            errorMessage = "Camera error: " + error;
+          }
