+
+TEST(AudioSendStreamTest, GetStats) {
+  ConfigHelper helper;
+  internal::AudioSendStream send_stream(
+      helper.config(), helper.audio_state(), helper.worker_queue(),
+      helper.congestion_controller(), helper.bitrate_allocator(),
+      helper.event_log());
