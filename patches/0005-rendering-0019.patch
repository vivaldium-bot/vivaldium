+
+  def fullname
+    benchmarkSuite.name + "/" + name
+  end
+
+  def to_s
+    fullname
+  end
+end
+
+class SunSpiderBenchmark
+  include Benchmark
+
+  def initialize(name)
+    @name = name
+  end
+
+  def emitRunCode(plan)
+    emitBenchRunCode(fullname, plan, nil, ensureFile("SunSpider-#{@name}", "#{SUNSPIDER_PATH}/#{@name}.js"))
+  end
+end
