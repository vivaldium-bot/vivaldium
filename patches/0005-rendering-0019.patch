+public:
+    StringTypeAdapter<Vector<char>>(const Vector<char>& buffer)
+        : m_buffer(buffer)
+    {
+    }
+
+    size_t length() { return m_buffer.size(); }
+
+    bool is8Bit() { return true; }
+
+    void writeTo(LChar* destination);
+
+    void writeTo(UChar* destination);
