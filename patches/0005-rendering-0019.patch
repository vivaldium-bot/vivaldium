+    char* ptr3 = reinterpret_cast<char*>(partitionAlloc(allocator.root(), kTestAllocSize));
+    EXPECT_TRUE(ptr3);
+    diff = ptr3 - ptr1;
+    EXPECT_EQ(static_cast<ptrdiff_t>(kRealAllocSize * 2), diff);
