+def fail(reason)
+  if reason.respond_to? :backtrace
+    puts "FAILED: #{reason}"
+    puts "Stack trace:"
+    puts reason.backtrace.join("\n")
+  else
+    puts "FAILED: #{reason}"
+  end
+  smallUsage
+end
