+    template<typename T, size_t inlineCapacity, typename Allocator>
+    inline void Deque<T, inlineCapacity, Allocator>::clear()
+    {
+        destroyAll();
+        m_start = 0;
+        m_end = 0;
+        m_buffer.deallocateBuffer(m_buffer.buffer());
+        m_buffer.resetBufferPointer();
