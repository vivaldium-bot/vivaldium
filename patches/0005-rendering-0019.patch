+PassRefPtr<StringImpl> StringImpl::removeCharacters(CharacterMatchFunctionPtr findMatch)
+{
+    if (is8Bit())
+        return removeCharacters(characters8(), findMatch);
+    return removeCharacters(characters16(), findMatch);
+}
