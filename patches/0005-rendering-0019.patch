+    inputArgs => ["/usr/bin/non-existent-command"],
+    expectedReturn => {
+        exitStatus => ENOENT
+    }
+}
+);
+
+my $testCasesCount = @testCaseHashRefs;
+plan(tests => $testCasesCount); # Total number of assertions.
