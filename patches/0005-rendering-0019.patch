+using WTF::nullAtom;
+using WTF::emptyAtom;
+using WTF::starAtom;
+using WTF::xmlAtom;
+using WTF::xmlnsAtom;
+using WTF::xlinkAtom;
+
+#include "wtf/text/StringConcatenate.h"
+#endif // AtomicString_h
