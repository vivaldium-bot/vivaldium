index 0000000000000000000000000000000000000000..547a9271767c29b7eb90a118daeacfa5c831bcfd
--- /dev/null
+++ b/third_party/WebKit/Source/wtf/RefCounted.h
@@ -0,0 +1,197 @@
+/*
