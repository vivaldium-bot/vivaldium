+namespace WTF {
+
+ArrayBufferView::ArrayBufferView(PassRefPtr<ArrayBuffer> buffer,
+                       unsigned byteOffset)
+        : m_byteOffset(byteOffset)
+        , m_isNeuterable(true)
+        , m_buffer(buffer)
+        , m_prevView(0)
+        , m_nextView(0)
+{
+    m_baseAddress = m_buffer ? (static_cast<char*>(m_buffer->data()) + m_byteOffset) : 0;
+    if (m_buffer)
+        m_buffer->addView(this);
+}
+
+ArrayBufferView::~ArrayBufferView()
+{
+    if (m_buffer)
+        m_buffer->removeView(this);
+}
+
+void ArrayBufferView::neuter()
+{
+    m_buffer = nullptr;
+    m_byteOffset = 0;
+}
+
+const char* ArrayBufferView::typeName()
+{
+    switch (type()) {
+    case TypeInt8:
+        return "Int8";
+        break;
+    case TypeUint8:
+        return "UInt8";
+        break;
+    case TypeUint8Clamped:
+        return "UInt8Clamped";
+        break;
+    case TypeInt16:
+        return "Int16";
+        break;
+    case TypeUint16:
+        return "UInt16";
+        break;
+    case TypeInt32:
+        return "Int32";
+        break;
+    case TypeUint32:
+        return "Uint32";
+        break;
+    case TypeFloat32:
+        return "Float32";
+        break;
+    case TypeFloat64:
+        return "Float64";
+        break;
+    case TypeDataView:
+        return "DataView";
+        break;
+    }
+    ASSERT_NOT_REACHED();
+    return "Unknown";
+}
+
