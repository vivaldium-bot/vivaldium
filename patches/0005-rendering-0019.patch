+  def vm
+    plan.vm
+  end
+
+  def outerIndex
+    plan.iteration
+  end
+
+  def self.parse(plans, string)
+    if string =~ /([a-zA-Z0-9\/-]+): ([a-zA-Z0-9_# ]+): ([0-9]+): ([0-9]+): Time: /
+      benchFullname = $1
+      vmName = $2
+      outerIndex = $3.to_i
+      innerIndex = $4.to_i
+      time = $~.post_match.to_f
+      ParsedResult.new(planForDescription(plans, benchFullname, vmName, outerIndex), innerIndex, time)
+    else
+      nil
+    end
+  end
+end
