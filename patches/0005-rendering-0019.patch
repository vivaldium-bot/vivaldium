+    unsigned length() { return 1; }
+
+    bool is8Bit() { return m_buffer <= 0xff; }
+
+    void writeTo(LChar* destination)
+    {
+        ASSERT(is8Bit());
+        *destination = static_cast<LChar>(m_buffer);
+    }
+
+    void writeTo(UChar* destination) { *destination = m_buffer; }
