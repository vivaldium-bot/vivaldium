+{
+    RefPtr<StringImpl> a = StringImpl::create("a");
+    RefPtr<StringImpl> b = StringImpl::create("b");
+    // FIXME: Instead of explicitly casting to RefPtr<StringImpl>&& here, we should use std::move, but that
