+    template<typename T, size_t inlineCapacity, typename Allocator>
+    inline Deque<T, 0, Allocator>& Deque<T, inlineCapacity, Allocator>::operator=(const Deque& other)
+    {
+        Deque<T> copy(other);
+        swap(copy);
+        return *this;
+    }
