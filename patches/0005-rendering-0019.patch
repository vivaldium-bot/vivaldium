+template<size_t inlineCapacity>
+bool equalIgnoringNullity(const Vector<UChar, inlineCapacity>& a, StringImpl* b)
+{
+    if (!b)
+        return !a.size();
+    if (a.size() != b->length())
+        return false;
+    if (b->is8Bit())
+        return equal(a.data(), b->characters8(), b->length());
+    return equal(a.data(), b->characters16(), b->length());
+}
