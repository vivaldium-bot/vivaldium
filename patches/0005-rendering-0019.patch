+
+# The array of test cases.
+my @testCaseHashRefs = (
+{
+    # New test
+    testName => "Simple",
+    inputArgs => ["echo", "hello"],
+    expectedReturn => {
+        exitStatus => 0,
+        stdout => "hello\n"
+    }
+},
+{
+    # New test
+    testName => "Multiple commands",
+    inputArgs => ["echo", "first-command;echo second-command"],
+    expectedReturn => {
+        exitStatus => 0,
+        stdout => "first-command;echo second-command\n"
+    }
+},
+{
+    # New test
