-        if (testName) {
-            steps.push(async_test(testName).step_func(function() {
-                stepFunctions[i]();
-                this.done();
-                if (i == stepFunctions.length - 1)
-                    done();
-            }));
-        } else {
-            steps.push(function() {
-                stepFunctions[i]();
-                if (i == stepFunctions.length - 1)
-                    done();
-            });
-        }
-    }
-}
