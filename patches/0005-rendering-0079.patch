-var outer = document.getElementById("outer");
-var inner = document.getElementById("inner");
-
-var inner_over = 0;
-var inner_out = 0;
-
-var outer_own_over = 0;
-var outer_own_out = 0;
-var outer_over = 0;
-var outer_out = 0;
-
-
-inner.addEventListener("mouseover", t.step_func(function(e) {
