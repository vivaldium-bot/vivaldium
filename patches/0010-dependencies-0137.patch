+class CPDF_SimpleFont : public CPDF_Font {
+ public:
+  CPDF_SimpleFont();
+  ~CPDF_SimpleFont() override;
+
+  // CPDF_Font
+  int GetCharWidthF(uint32_t charcode) override;
+  FX_RECT GetCharBBox(uint32_t charcode) override;
