+  return PATH;
+}
+
+void CPDF_PathObject::Transform(const CFX_Matrix& matrix) {
+  m_Matrix.Concat(matrix);
+  CalcBoundingBox();
+  SetDirty(true);
+}
+
+bool CPDF_PathObject::IsPath() const {
+  return true;
+}
