+	def printBody(self, api):
+		for [name, number] in api.categoryIterate():
+			if number != None:
+				preamble = '\n    /* %3u. %s */\n' % (int(number), name)
+			else:
+				preamble = '\n    /* %s */\n' % (name)
+
+			for func in api.functionIterateByCategory(name):
+				if func.client_supported_for_indirect():
+					if preamble:
+						print preamble
+						preamble = None
