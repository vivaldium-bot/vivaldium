+            pdman.setMatrix3f(fViewMatrixUniform, viewMatrix);
+        }
+
+        if (ce.color() != fColor) {
+            float c[4];
+            GrColorToRGBAFloat(ce.color(), c);
+            pdman.set4fv(fColorUniform, 1, c);
+            fColor = ce.color();
