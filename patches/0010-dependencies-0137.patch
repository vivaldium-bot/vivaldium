+
+void x86SP_FFT_CToC_FC32_Inv_Radix4_ms(
+    const OMX_F32 *in,
+    OMX_F32 *out,
+    const OMX_F32 *twiddle,
+    OMX_INT n,
+    OMX_INT sub_size,
+    OMX_INT sub_num) {
+  OMX_INT set;
+  OMX_INT grp;
+  OMX_INT step = sub_num >> 1;
+  OMX_INT set_count = sub_num >> 2;
+  OMX_INT n_by_4 = n >> 2;
