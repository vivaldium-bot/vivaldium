+        "move            $t8,       %[width]                     \n\t"
+        "addiu           %[height], %[height],     -1            \n\t"
+    "2:                                                          \n\t"
+        "beqz            $t8,       4f                           \n\t"
+        " addiu          $t0,       $t8,           -4            \n\t"
+        "bltz            $t0,       3f                           \n\t"
+        " nop                                                    \n\t"
+        "addiu           $t8,       $t8,           -4            \n\t"
+        "lhu             $t0,       0(%[device])                 \n\t"
+        "lhu             $t1,       2(%[device])                 \n\t"
+        "lhu             $t2,       4(%[device])                 \n\t"
+        "lhu             $t3,       6(%[device])                 \n\t"
+        "lbu             $t4,       0(%[alpha])                  \n\t"
+        "lbu             $t5,       1(%[alpha])                  \n\t"
+        "lbu             $t6,       2(%[alpha])                  \n\t"
+        "lbu             $t7,       3(%[alpha])                  \n\t"
+        "replv.ph        $t0,       $t0                          \n\t"
+        "replv.ph        $t1,       $t1                          \n\t"
+        "replv.ph        $t2,       $t2                          \n\t"
+        "replv.ph        $t3,       $t3                          \n\t"
+        "addiu           %[s0],     $t4,           1             \n\t"
+        "addiu           %[s1],     $t5,           1             \n\t"
+        "addiu           %[s2],     $t6,           1             \n\t"
+        "addiu           %[s3],     $t7,           1             \n\t"
+        "srl             %[s0],     %[s0],         3             \n\t"
+        "srl             %[s1],     %[s1],         3             \n\t"
+        "srl             %[s2],     %[s2],         3             \n\t"
+        "srl             %[s3],     %[s3],         3             \n\t"
+        "and             $t0,       $t0,           $t9           \n\t"
+        "and             $t1,       $t1,           $t9           \n\t"
+        "and             $t2,       $t2,           $t9           \n\t"
+        "and             $t3,       $t3,           $t9           \n\t"
+        "subu            $t4,       %[expanded32], $t0           \n\t"
+        "subu            $t5,       %[expanded32], $t1           \n\t"
