+}
+
+TEST_F(IndirectAPI, EXT_texture_array)
+{
+   EXPECT_EQ((_glapi_proc) __indirect_glFramebufferTextureLayerEXT, table[_glapi_get_proc_offset("glFramebufferTextureLayerEXT")]);
+}
