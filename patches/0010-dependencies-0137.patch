+  m_pRootDict->SetNewFor<CPDF_Name>("Type", "Catalog");
+
+  CPDF_Dictionary* pPages = NewIndirect<CPDF_Dictionary>();
+  pPages->SetNewFor<CPDF_Name>("Type", "Pages");
+  pPages->SetNewFor<CPDF_Number>("Count", 0);
+  pPages->SetNewFor<CPDF_Array>("Kids");
