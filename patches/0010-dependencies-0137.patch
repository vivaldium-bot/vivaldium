+
+class CPDF_Creator {
+ public:
+  explicit CPDF_Creator(CPDF_Document* pDoc,
+                        const RetainPtr<IFX_WriteStream>& archive);
+  ~CPDF_Creator();
+
+  void RemoveSecurity();
+  bool Create(uint32_t flags);
