+    v_tw3.real = _mm_set_ps(tw3[18], tw3[12], tw3[6], tw3[0]);
+    v_tw3.imag = _mm_set_ps(
+        tw3[18 + n_mul_2],
+        tw3[12 + n_mul_2],
+        tw3[6 + n_mul_2],
+        tw3[n_mul_2]);
+
+    VC_LOAD_MATRIX_TRANSPOSE(&v_t0, &v_t1, &v_t2, &v_t3, in0, in1, in2, in3, n);
