+void aes_decrypt_nb_8(CRYPT_aes_context* ctx, unsigned int* block) {
+  int i;
+  const int C1 = 8 - 1, C2 = 8 - 3, C3 = 8 - 4, Nb = 8;
+  unsigned int* keysched = ctx->invkeysched;
+  unsigned int newstate[8];
+  for (i = 0; i < ctx->Nr - 1; i++) {
+    ADD_ROUND_KEY_8;
+    MAKEWORD(0);
+    MAKEWORD(1);
+    MAKEWORD(2);
+    MAKEWORD(3);
+    MAKEWORD(4);
+    MAKEWORD(5);
+    MAKEWORD(6);
+    MAKEWORD(7);
+    MOVEWORD(0);
+    MOVEWORD(1);
+    MOVEWORD(2);
+    MOVEWORD(3);
+    MOVEWORD(4);
+    MOVEWORD(5);
