index 0000000000000000000000000000000000000000..2677b130736037bee2e72bbc694c13bbd6b6d0ea
--- /dev/null
+++ b/third_party/skia/src/images/SkImageDecoder_libgif.cpp
@@ -0,0 +1,541 @@
+/*
