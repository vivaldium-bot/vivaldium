+++ b/third_party/mesa/src/src/mesa/drivers/dri/common/xmlconfig.c
@@ -0,0 +1,1044 @@
+/*
+ * XML DRI client-side driver configuration
+ * Copyright (C) 2003 Felix Kuehling
+ *
