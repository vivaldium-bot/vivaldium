+/**
+ * Extract the major and minor version numbers from a version string.
+ */
+static void
+version_from_string(const char *ver, int *major_version, int *minor_version)
+{
+   const char *end;
+   long major;
+   long minor;
+
+   major = strtol(ver, (char **) &end, 10);
+   minor = strtol(end + 1, NULL, 10);
+   *major_version = major;
+   *minor_version = minor;
+}
