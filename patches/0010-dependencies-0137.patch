index 0000000000000000000000000000000000000000..1782714652258a17e230e7abedbd3f544ddca444
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/drivers/dri/nouveau/nouveau_bufferobj.c
@@ -0,0 +1,177 @@
+/*
