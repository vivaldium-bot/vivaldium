+#ifndef CORE_FPDFAPI_PAGE_CPDF_SHADINGPATTERN_H_
+#define CORE_FPDFAPI_PAGE_CPDF_SHADINGPATTERN_H_
+
+#include <memory>
+#include <vector>
+
