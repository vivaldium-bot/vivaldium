+CPDF_CIDFont::CPDF_CIDFont()
+    : m_pCID2UnicodeMap(nullptr),
+      m_bCIDIsGID(false),
+      m_bAnsiWidthsFixed(false),
+      m_bAdobeCourierStd(false) {
+  for (size_t i = 0; i < FX_ArraySize(m_CharBBox); ++i)
+    m_CharBBox[i] = FX_RECT(-1, -1, -1, -1);
+}
