+                                      (uint8x16_t)vcvtq_u32_f32(b.fVec)).val[0],
+                             vuzpq_u8((uint8x16_t)vcvtq_u32_f32(c.fVec),
+                                      (uint8x16_t)vcvtq_u32_f32(d.fVec)).val[0]).val[0]);
+}
+
+template<> inline Sk4h SkNx_cast<uint16_t, uint8_t>(const Sk4b& src) {
