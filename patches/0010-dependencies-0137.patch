+  CRYPT_MD5Start(&ctx);
+
+  const uint32_t length = 10 * 1024 * 1024 + 1;
+  std::unique_ptr<uint8_t[]> data(new uint8_t[length]);
+
+  for (uint32_t i = 0; i < length; ++i)
+    data[i] = i & 0xFF;
+
+  uint32_t total = 0;
+  while (total < length) {
+    uint32_t len = 4097;  // intentionally not 2^k.
+    if (len > length - total)
+      len = length - total;
+
+    CRYPT_MD5Update(&ctx, data.get() + total, len);
+    total += len;
+  }
