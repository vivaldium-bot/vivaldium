+void aes_decrypt_nb_4(CRYPT_aes_context* ctx, unsigned int* block) {
+  int i;
+  const int C1 = 4 - 1, C2 = 4 - 2, C3 = 4 - 3, Nb = 4;
+  unsigned int* keysched = ctx->invkeysched;
+  unsigned int newstate[4];
+  for (i = 0; i < ctx->Nr - 1; i++) {
+    ADD_ROUND_KEY_4;
+    MAKEWORD(0);
+    MAKEWORD(1);
+    MAKEWORD(2);
+    MAKEWORD(3);
+    MOVEWORD(0);
+    MOVEWORD(1);
+    MOVEWORD(2);
