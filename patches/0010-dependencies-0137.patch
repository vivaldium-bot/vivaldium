+
+  ByteString GetUserPassword(const ByteString& owner_password,
+                             int32_t key_len) const;
+  bool CheckPassword(const ByteString& user_password,
+                     bool bOwner,
+                     uint8_t* key,
+                     int key_len);
+
+  CPDF_CryptoHandler* GetCryptoHandler() const {
+    return m_pCryptoHandler.get();
+  }
+
+ private:
