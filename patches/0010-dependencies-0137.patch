+#if defined (SK_SFNTLY_SUBSETTER)
+static void sk_delete_array(const void* ptr, void*) {
+    // Use C-style cast to cast away const and cast type simultaneously.
+    delete[] (unsigned char*)ptr;
+}
+#endif
