+	template <typename T, precision P>
+	GLM_FUNC_QUALIFIER typename tmat2x4<T, P>::col_type operator* 
+	(
+		tmat2x4<T, P> const & m, 
+		typename tmat2x4<T, P>::row_type const & v
+	)
+	{
+		return typename tmat2x4<T, P>::col_type(
+			m[0][0] * v.x + m[1][0] * v.y,
+			m[0][1] * v.x + m[1][1] * v.y,
+			m[0][2] * v.x + m[1][2] * v.y,
+			m[0][3] * v.x + m[1][3] * v.y);
+	}
