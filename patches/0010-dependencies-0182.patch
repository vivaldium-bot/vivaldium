+	GLM_FUNC_QUALIFIER tmat3x4<T, P>::tmat3x4
+	(
+		tmat3x3<T, P> const & m
+	)
+	{
+		this->value[0] = col_type(m[0], T(0));
+		this->value[1] = col_type(m[1], T(0));
+		this->value[2] = col_type(m[2], T(0));
+	}
