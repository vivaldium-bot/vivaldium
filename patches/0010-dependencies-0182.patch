+	)
+	{
+		GLM_STATIC_ASSERT(
+			std::numeric_limits<T>::is_iec559,
+			"'step' only accept floating-point inputs");
+
+		return mix(vecType<T, P>(1), vecType<T, P>(0), glm::lessThan(x, vecType<T, P>(edge)));
+	}
