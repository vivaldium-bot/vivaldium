+///////////////////////////////////////////////////////////////////////////////////
+
+#ifndef GLM_GTX_io
+#define GLM_GTX_io
+
+// Dependency:
+#include "../detail/setup.hpp"
+#include "../gtc/quaternion.hpp"
+
+#if(defined(GLM_MESSAGES) && !defined(GLM_EXT_INCLUDED))
+#	pragma message("GLM: GLM_GTX_io extension included")
+#endif
