index 0000000000000000000000000000000000000000..6ddb9b098fb43641f40193e85f5136a0eb32c62a
--- /dev/null
+++ b/third_party/vulkan-validation-layers/src/loader/extension_manual.c
@@ -0,0 +1,586 @@
+/*
+ * Copyright (c) 2015-2017 The Khronos Group Inc.
+ * Copyright (c) 2015-2017 Valve Corporation
+ * Copyright (c) 2015-2017 LunarG, Inc.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
