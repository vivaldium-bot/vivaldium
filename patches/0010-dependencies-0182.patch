+	template <typename genType> 
+	GLM_FUNC_DECL typename genType::value_type compAdd(
+		genType const & v);
+
+	/// Multiply all vector components together. 
+	/// @see gtx_component_wise
+	template <typename genType> 
+	GLM_FUNC_DECL typename genType::value_type compMul(
+		genType const & v);
