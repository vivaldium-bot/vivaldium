+                #    continue
+                print "Found heading %s" % (tag.tag)
+                prev_heading = "".join(tag.itertext())
+                # Insert a space between heading number & title
+                sh_list = prev_heading.rsplit('.', 1)
+                prev_heading = '. '.join(sh_list)
