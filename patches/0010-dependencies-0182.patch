+                        ValidateObject(device, pDescriptorCopies[idx0].dstSet, VK_DEBUG_REPORT_OBJECT_TYPE_DESCRIPTOR_SET_EXT,
+                                       false, VALIDATION_ERROR_00972, VALIDATION_ERROR_00973);
+                }
+                if (pDescriptorCopies[idx0].srcSet) {
