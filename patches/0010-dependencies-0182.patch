+	///
+	/// @see <a href="http://www.opengl.org/registry/doc/GLSLangSpec.4.20.8.pdf">GLSL 4.20.8 specification, section 4.1.6 Matrices</a>
+	typedef highp_dmat4x4		dmat4x4;
+
+#endif//GLM_PRECISION
+	
+	/// @}
+}//namespace glm
+
+#endif//glm_core_type_mat
