+		GLM_STATIC_ASSERT(std::numeric_limits<genType>::is_integer, "'bitRotateRight' only accept integer values");
+
+		std::size_t BitSize = sizeof(genType) * 8;
+		return (In << Shift) | (In >> (BitSize - Shift));
+	}
