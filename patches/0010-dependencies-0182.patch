index 0000000000000000000000000000000000000000..de765cdd73c411f2cf49190501a73be3eca7dbfe
--- /dev/null
+++ b/third_party/vulkan-validation-layers/src/libs/vkjson/vkjson_unittest.cc
@@ -0,0 +1,101 @@
+///////////////////////////////////////////////////////////////////////////////
+//
+// Copyright (c) 2015-2016 The Khronos Group Inc.
+// Copyright (c) 2015-2016 Valve Corporation
+// Copyright (c) 2015-2016 LunarG, Inc.
+// Copyright (c) 2015-2016 Google, Inc.
