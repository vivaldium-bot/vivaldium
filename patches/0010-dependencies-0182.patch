+		GLM_FUNC_DECL tmat2x4(
+			T const & x0, T const & y0, T const & z0, T const & w0,
+			T const & x1, T const & y1, T const & z1, T const & w1);
+		GLM_FUNC_DECL tmat2x4(
+			col_type const & v0, 
