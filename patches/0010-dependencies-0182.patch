+		GLM_FUNC_DECL part_type const & operator[](int i) const;
+		
+		// Operators
+		GLM_FUNC_DECL tdualquat<T, P> & operator*=(T const & s);
+		GLM_FUNC_DECL tdualquat<T, P> & operator/=(T const & s);
