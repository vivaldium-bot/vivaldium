+			X2 const & x2, Y2 const & y2, Z2 const & z2, W2 const & w2);
+
+		template <typename U, typename V>
+		GLM_FUNC_DECL tmat2x4(
+			tvec4<U, P> const & v1,
+			tvec4<V, P> const & v2);
+
+		//////////////////////////////////////
