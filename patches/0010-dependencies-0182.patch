+	{
+		GLM_STATIC_ASSERT(std::numeric_limits<T>::is_iec559, "'outerProduct' only accept floating-point inputs");
+		return detail::compute_outerProduct<vecTypeA, vecTypeB, T, P>::call(c, r);
