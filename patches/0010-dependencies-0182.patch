+GLM_FUNC_QUALIFIER detail::fvec4SIMD step
+(
+	detail::fvec4SIMD const & edge, 
+	detail::fvec4SIMD const & x
+)
+{
+	__m128 cmp0 = _mm_cmpngt_ps(x.Data, edge.Data);
+	return _mm_max_ps(_mm_min_ps(cmp0, _mm_setzero_ps()), detail::one);
+}
