+static const VkLayerProperties globalLayerProps = {"VK_LAYER_GOOGLE_unique_objects",
+                                                   VK_LAYER_API_VERSION,  // specVersion
+                                                   1,                     // implementationVersion
+                                                   "Google Validation Layer"};
