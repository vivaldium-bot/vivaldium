+	// Float vectors
+
+	template <precision P>
+	GLM_FUNC_QUALIFIER std::string to_string
+	(
+		detail::tvec2<float, P> const & v
+	)
+	{
+		return detail::format("fvec2(%f, %f)", v.x, v.y);
