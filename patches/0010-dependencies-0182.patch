+		template <typename U, precision Q>
+		GLM_FUNC_DECL explicit tmat2x4(tmat2x4<U, Q> const & m);
+
+		GLM_FUNC_DECL explicit tmat2x4(tmat2x2<T, P> const & x);
+		GLM_FUNC_DECL explicit tmat2x4(tmat3x3<T, P> const & x);
