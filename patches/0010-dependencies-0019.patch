+
+  <div id="scroller" relative>
+    <content></content>
+  </div>
+
+</template>
+<script>
+
+  Polymer({
+
+    publish: {
+      transition: 'paper-dropdown-transition'
+    },
+
+    ready: function() {
+      this.super();
+      this.sizingTarget = this.$.scroller;
+    }
+
+  });
+
+</script>
+</polymer-element>
