+def get_ts(ts=None):
+    if not ts:
+        ts = time.gmtime()
+    return time.strftime(ISO8601, ts)
+
+
+def parse_ts(ts):
+    with setlocale('C'):
+        ts = ts.strip()
+        try:
+            dt = datetime.datetime.strptime(ts, ISO8601)
+            return dt
+        except ValueError:
+            try:
+                dt = datetime.datetime.strptime(ts, ISO8601_MS)
+                return dt
+            except ValueError:
+                dt = datetime.datetime.strptime(ts, RFC1123)
+                return dt
+
