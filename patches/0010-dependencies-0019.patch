+            tag = long_to_bytes(tag)
+        elif enc_alg in ["A128CBC-HS256", "A192CBC-HS384", "A256CBC-HS512"]:
+            assert enc_alg in SUPPORTED["enc"]
+            ctxt, tag = aes_cbc_hmac_encrypt(key, iv, auth_data, msg)
+        else:
+            raise NotSupportedAlgorithm(enc_alg)
