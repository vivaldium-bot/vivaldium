+                                  jwe.b64_protected_header(),
+                                  jwe.initialization_vector(),
+                                  jwe.authentication_tag())
+        if flag is False:
+            raise DecryptionFailed()
+
+        if "zip" in jwe.headers and jwe.headers["zip"] == "DEF":
+            msg = zlib.decompress(msg)
+
+        return msg
