+def regions():
+    """
+    Get all available regions for the SDB service.
+
+    :rtype: list
+    :return: A list of :class:`boto.sdb.regioninfo.RegionInfo` instances
+    """
+    return get_regions(
+        'sdb',
+        region_cls=SDBRegionInfo
+    )
