+def aes_enc(key, txt):
+    pbuf = io.StringIO(txt)
+    cbuf = io.StringIO()
+    ciphertext = cipher_filter(key, pbuf, cbuf)
+    pbuf.close()
+    cbuf.close()
+    return ciphertext
+
+
+def aes_dec(key, ciptxt):
+    pbuf = io.StringIO()
+    cbuf = io.StringIO(ciptxt)
+    plaintext = cipher_filter(key, cbuf, pbuf)
+    pbuf.close()
+    cbuf.close()
+    return plaintext
