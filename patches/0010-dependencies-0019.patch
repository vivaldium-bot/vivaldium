+  def testMessageFieldDocsAndArrayRef(self):
+    """Descriptions for MessageFields and a reference in an array."""
+
+    class B(messages.Message):
+      """A description of B."""
+      pass
+
+    class A(messages.Message):
+      b = messages.MessageField(B, 1, repeated=True)
