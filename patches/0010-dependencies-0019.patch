+    def testNumberAttribute(self):
+        """Test setting the number attribute."""
+        def action(field_class):
+            # Check range.
+            self.assertRaises(messages.InvalidNumberError,
+                              field_class,
+                              0)
+            self.assertRaises(messages.InvalidNumberError,
+                              field_class,
+                              -1)
