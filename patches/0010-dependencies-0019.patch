+                        <member><Value>One</Value></member>
+                        <member><Value>Two</Value>
+                                <Error>Four</Error>
+                        </member>
+                        <member><Value>Six</Value></member>
+                  </Item>
+                  </Test6Result></Test6Response>"""
+        obj = self.check_issue(Test6Result, text)
+        self.assertSequenceEqual(
