+    # Then try to read auth token from query.
+    parameters = urlparse.parse_qs(environ.get("QUERY_STRING", ""))
+    if _ACCESS_TOKEN_PARAM_NAME in parameters:
+        auth_token, = parameters[_ACCESS_TOKEN_PARAM_NAME]
+        return auth_token
