+    def _set_md5(self, value):
+        if value:
+            self.local_hashes['md5'] = binascii.a2b_hex(value)
+        elif 'md5' in self.local_hashes:
+            self.local_hashes.pop('md5', None)
+
+    md5 = property(_get_md5, _set_md5);
+
+    def _get_base64md5(self):
