+    def __str__(self):
+        doc = self.__doc__ and self.__doc__.strip() + "\n" or ''
+        return '{1.__name__}: {0.reason} {2}\n{3}' \
+               '{0.message}'.format(self, self.__class__,
+                                    self.retry and '(Retriable)' or '', doc)
