+            ['1', '2', '3'],
+        )
+        self.assertEqual(item[-1].List[1].Simple, [])
+        self.assertSequenceEqual(
+            [e.Value for e in obj._result.Item],
+            ['One', 'Two', 'Six'],
+        )
