+                              field_class,
+                              messages.FIRST_RESERVED_FIELD_NUMBER)
+            self.assertRaises(messages.InvalidNumberError,
+                              field_class,
+                              messages.LAST_RESERVED_FIELD_NUMBER)
+            self.assertRaises(messages.InvalidNumberError,
+                              field_class,
