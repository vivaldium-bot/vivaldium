+              </spotPriceHistorySet>
+              <nextToken>q5GwEl5bMGjKq6YmhpDLJ7hEwyWU54jJC2GQ93n61vZV4s1+fzZ674xzvUlTihrl</nextToken>
+            </DescribeSpotPriceHistoryResponse>
