+        message.string_value = [u'a string\u044f', u'another string']
+        message.bytes_value = [b'a bytes\xff\xfe', b'another bytes']
+        message.enum_value = [RepeatedMessage.SimpleEnum.VAL2,
+                              RepeatedMessage.SimpleEnum.VAL1]
