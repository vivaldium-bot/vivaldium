+    def testNullValues(self):
+        """Test that null values overwrite existing values."""
+        self.assertEquals(MyMessage(),
+                          protojson.decode_message(MyMessage,
+                                                   ('{"an_integer": null,'
+                                                    ' "a_nested": null,'
+                                                    ' "an_enum": null'
+                                                    '}')))
+
+    def testEmptyList(self):
