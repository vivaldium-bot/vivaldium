+                          self.vault_name
+        self.vault_info = {u'CreationDate': u'2012-03-16T22:22:47.214Z',
+                           u'LastInventoryDate': u'2012-03-21T22:06:51.218Z',
+                           u'NumberOfArchives': 2,
+                           u'SizeInBytes': 12334,
