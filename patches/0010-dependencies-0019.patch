+def _hash_input(cmk, enc, label, rond=1, length=128, hashsize=256,
+                epu="", epv=""):
+    r = [0, 0, 0, rond]
+    r.extend(cmk)
+    r.extend([0, 0, 0, length])
+    r.extend([ord(c) for c in enc])
+    r.extend(party_value(epu))
+    r.extend(party_value(epv))
+    r.extend(label)
+    return r
