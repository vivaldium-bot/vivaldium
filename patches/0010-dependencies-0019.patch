+<!doctype html>
+<meta charset="utf-8">
+<style>
+.target {
+    border: 3px solid skyblue;
+    width: 100px;
+    height: 100px;
+    background-image: linear-gradient(to right, coral, coral);
+    background-size: 20px 20px;
+    background-repeat: no-repeat;
+    display: inline-block;
+}
+
+.replica {
+    margin-right: 10px;
+}
