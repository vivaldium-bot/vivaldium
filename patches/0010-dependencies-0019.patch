+def _extract_auth_token(environ):
+    # First try to extract auth token from HTTP authorization header.
+    auth_header = environ.get("HTTP_AUTHORIZATION")
+    if auth_header:
+        if auth_header.startswith(_BEARER_TOKEN_PREFIX):
