+                 x5c=None, x5t="", x5u="", k="", mtrl="", **kwargs):
+        Key.__init__(self, kty, alg, use, kid, as_bytes(key), x5c, x5t, x5u, **kwargs)
+        self.k = k
+        if not self.key and self.k:
+            if isinstance(self.k, str):
+                self.k = self.k.encode("utf-8")
+            self.key = b64d(bytes(self.k))
