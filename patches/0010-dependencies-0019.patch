+
+    def testEncodeDateTime(self):
+        for datetime_string, datetime_vals in (
+                ('2012-09-30T15:31:50.262000',
+                 (2012, 9, 30, 15, 31, 50, 262000)),
+                ('2012-09-30T15:31:50.262123',
