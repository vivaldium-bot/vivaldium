index 0000000000000000000000000000000000000000..4825ed5e3e297a4852ea142869fe186a878d517f
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_kerndeint.c
@@ -0,0 +1,319 @@
+/*
+ * Copyright (c) 2012 Jeremy Tran
+ * Copyright (c) 2004 Tobias Diedrich
+ * Copyright (c) 2003 Donald A. Graft
+ *
+ * This file is part of FFmpeg.
+ *
