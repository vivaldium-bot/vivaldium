index 0000000000000000000000000000000000000000..266a8e85acd6a3fcb49014ae29632aaaf4a7302a
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/aadec.c
@@ -0,0 +1,314 @@
+/*
+ * Audible AA demuxer
+ * Copyright (c) 2015 Vesselin Bontchev
+ *
+ * Header parsing is borrowed from https://github.com/jteeuwen/audible project.
+ * Copyright (c) 2001-2014, Jim Teeuwen
