+
+// Alphabetical order for binary search
+extern const int kNameToEntitySize = 265;
+extern const CharIntPair kNameToEntity[kNameToEntitySize] = {
+  {"AElig",   198},
+  {"AMP",      38},
+  {"Aacute",  193},
