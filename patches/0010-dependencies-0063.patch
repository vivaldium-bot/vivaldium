+/**
+ * @file
+ * drawtext filter, based on the original vhook/drawtext.c
+ * filter by Gustavo Sverzut Barbieri
+ */
+
+#include "config.h"
+
+#if HAVE_SYS_TIME_H
+#include <sys/time.h>
+#endif
+#include <sys/types.h>
+#include <sys/stat.h>
