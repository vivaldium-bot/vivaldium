+#define ID_ANIM       MKTAG('A','N','I','M')
+
+#define ID_FORM       MKTAG('F','O','R','M')
+#define ID_FRM8       MKTAG('F','R','M','8')
+#define ID_ANNO       MKTAG('A','N','N','O')
