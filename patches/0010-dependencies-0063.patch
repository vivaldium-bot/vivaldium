index 0000000000000000000000000000000000000000..8e43986846dc507a380f98c511530bd0b40b1c2a
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_boxblur.c
@@ -0,0 +1,413 @@
+/*
