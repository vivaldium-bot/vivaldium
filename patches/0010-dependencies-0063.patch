--- /dev/null
+++ b/third_party/ffmpeg/libavformat/dvenc.c
@@ -0,0 +1,455 @@
+/*
+ * General DV muxer/demuxer
+ * Copyright (c) 2003 Roman Shaposhnik
+ *
