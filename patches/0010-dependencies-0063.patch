index 0000000000000000000000000000000000000000..9c6202aa187b7221aef952acb7ac8f3471a8c05f
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/window_func.c
@@ -0,0 +1,122 @@
+/*
