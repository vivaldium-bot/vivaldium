new file mode 100644
index 0000000000000000000000000000000000000000..4fa944766e721a3abfe3b302bf0c0dc242efe1f7
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/avf_concat.c
@@ -0,0 +1,426 @@
