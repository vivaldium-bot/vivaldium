index 0000000000000000000000000000000000000000..a92367c97a3913906b8349478972ba5888c5ee86
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_flanger.c
@@ -0,0 +1,246 @@
+/*
+ * Copyright (c) 2006 Rob Sykes <robs@users.sourceforge.net>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
