index 0000000000000000000000000000000000000000..01c46924d10a08a21d74cfbc607cf459a0fba855
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/avdevice.c
@@ -0,0 +1,271 @@
+/*
