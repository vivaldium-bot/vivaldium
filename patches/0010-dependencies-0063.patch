+                update(target, max, intensity);
+
+                c1_data += c1_linesize;
+                c2_data += c2_linesize;
+                d1_data += d1_linesize;
+                d2_data += d2_linesize;
+            }
+        }
+    } else {
+        const uint8_t *c1_data = in->data[(plane + 1) % s->ncomp];
