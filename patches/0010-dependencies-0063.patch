--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/alsa_enc.c
@@ -0,0 +1,174 @@
+/*
+ * ALSA input and output
+ * Copyright (c) 2007 Luca Abeni ( lucabe72 email it )
+ * Copyright (c) 2007 Benoit Fouet ( benoit fouet free fr )
+ *
+ * This file is part of FFmpeg.
+ *
