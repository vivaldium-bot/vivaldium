diff --git a/third_party/ffmpeg/libavformat/filmstripdec.c b/third_party/ffmpeg/libavformat/filmstripdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..cdbb93b11a022d6188a127a80e9bdeb28f0b6ebb
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/filmstripdec.c
@@ -0,0 +1,116 @@
+/*
+ * Adobe Filmstrip demuxer
+ * Copyright (c) 2010 Peter Ross
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
