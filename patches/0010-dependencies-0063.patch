index 0000000000000000000000000000000000000000..e9af24fad33d47c211713d7666330d4d2a640234
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_gradfun.c
@@ -0,0 +1,265 @@
+/*
