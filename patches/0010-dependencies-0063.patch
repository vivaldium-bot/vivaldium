index 0000000000000000000000000000000000000000..1b98e1ddb5b66cc8c994ac7de713f7490d4516dd
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/aacdec.c
@@ -0,0 +1,115 @@
+/*
+ * raw ADTS AAC demuxer
+ * Copyright (c) 2008 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (c) 2009 Robert Swain ( rob opendot cl )
+ *
+ * This file is part of FFmpeg.
+ *
