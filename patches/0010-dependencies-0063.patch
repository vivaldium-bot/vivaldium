+typedef struct OutputStream {
+    AVFormatContext *ctx;
+    int ctx_inited;
+    uint8_t iobuf[32768];
+    URLContext *out;
+    int packets_written;
+    char initfile[1024];
+    int64_t init_start_pos;
+    int init_range_length;
+    int nb_segments, segments_size, segment_index;
+    Segment **segments;
+    int64_t first_pts, start_pts, max_pts;
+    int64_t last_dts;
+    int bit_rate;
+    char bandwidth_str[64];
+
+    char codec_str[100];
+} OutputStream;
