index 0000000000000000000000000000000000000000..3fb69fc09d399f4fcdf64214f7c92d99d2c0d6b1
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_hqdn3d.c
@@ -0,0 +1,374 @@
+/*
