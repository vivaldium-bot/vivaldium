index 0000000000000000000000000000000000000000..ac9d4c31fe996fd7b5bcd66bb2b4443677808d97
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_scale.c
@@ -0,0 +1,782 @@
+/*
