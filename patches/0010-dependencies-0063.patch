index 0000000000000000000000000000000000000000..870dd688410e5821e4043aeb68472a8bc4ca5a20
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_ocr.c
@@ -0,0 +1,151 @@
+/*
