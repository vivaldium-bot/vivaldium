diff --git a/third_party/ffmpeg/libavfilter/vf_alphamerge.c b/third_party/ffmpeg/libavfilter/vf_alphamerge.c
new file mode 100644
index 0000000000000000000000000000000000000000..a8a8d568249aab66b29d1a3834d554178f58f1ab
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_alphamerge.c
@@ -0,0 +1,217 @@
+/*
