index 0000000000000000000000000000000000000000..2380cdca071c7024c241df3e6cbb15b21d4f36c7
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_convolution.c
@@ -0,0 +1,336 @@
