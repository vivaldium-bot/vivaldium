index 0000000000000000000000000000000000000000..802b8d025673a1f4265db0d724fb9f0c9929fa7b
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_apulsator.c
@@ -0,0 +1,257 @@
+/*
