index 0000000000000000000000000000000000000000..328e25ba84ebbcae2cf17df23db7d5256b53f26a
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_agate.c
@@ -0,0 +1,440 @@
+/*
