+    + Back.RED + 'red, '
+    + Back.RESET + 'normal, '
+    , end='')
+print(Style.DIM + 'dim, '
+    + Style.BRIGHT + 'bright, '
+    + Style.NORMAL + 'normal'
+    , end=' ')
+print()
+
