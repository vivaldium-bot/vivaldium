index 0000000000000000000000000000000000000000..b4da58e345a345f7ed2d203db3baff49323cb778
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/cavsvideodec.c
@@ -0,0 +1,69 @@
+/*
+ * RAW Chinese AVS video demuxer
+ * Copyright (c) 2009  Stefan Gehrer <stefan.gehrer@gmx.de>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
