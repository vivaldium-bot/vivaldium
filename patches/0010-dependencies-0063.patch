index 0000000000000000000000000000000000000000..55f7462676c40c0bca42ffa96ced38d6bd44c171
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/avf_ahistogram.c
@@ -0,0 +1,411 @@
