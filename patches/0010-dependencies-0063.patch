index 0000000000000000000000000000000000000000..540607aa74b40f352aad5107914789aae597d94b
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/xsubdec.c
@@ -0,0 +1,177 @@
+/*
+ * XSUB subtitle decoder
+ * Copyright (c) 2007 Reimar Döffinger
+ *
