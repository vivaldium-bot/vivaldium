+
+typedef struct FSPPContext {
+    AVClass *class;
+    uint64_t threshold_mtx_noq[8 * 2];
+    uint64_t threshold_mtx[8 * 2];        //used in both C & MMX (& later SSE2) versions
+
+    int log2_count;
+    int strength;
+    int hsub;
+    int vsub;
+    int temp_stride;
+    int qp;
+    int qscale_type;
+    int prev_q;
+    uint8_t *src;
+    int16_t *temp;
+    uint8_t *non_b_qp_table;
+    int non_b_qp_alloc_size;
