+};
diff --git a/third_party/ffmpeg/libavfilter/vf_selectivecolor.c b/third_party/ffmpeg/libavfilter/vf_selectivecolor.c
new file mode 100644
index 0000000000000000000000000000000000000000..e59009494380805ae659cdea7488efe596d1d660
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_selectivecolor.c
@@ -0,0 +1,458 @@
