+    REPLAYGAIN_IGNORE,
+    REPLAYGAIN_TRACK,
+    REPLAYGAIN_ALBUM,
+};
+
+typedef struct VolumeContext {
+    const AVClass *class;
+    AVFloatDSPContext *fdsp;
+    int precision;
+    int eval_mode;
+    const char *volume_expr;
