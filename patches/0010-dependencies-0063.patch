+group custom "Custom loop tests"
+
+	case continue_in_fragment_for_loop
+		version 300 es
+		vertex ""
+			#version 300 es
+			${VERTEX_DECLARATIONS}
+			void main()
+			{
+				${VERTEX_OUTPUT}
+			}
+		""
+		fragment ""
+			#version 300 es
+			${FRAGMENT_DECLARATIONS}
+			void main()
+			{
+				int count1 = 0;
+				for(int i=0;i<4;i++)
+				{
+					if (count1 == 2)
+						continue;
+				}
+				${FRAG_COLOR} = vec4(1.0);
+			}
+		""
+	end
+
+end # custom
diff --git a/third_party/deqp/src/data/gles3/shaders/negative.test b/third_party/deqp/src/data/gles3/shaders/negative.test
