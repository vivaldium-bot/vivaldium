index 0000000000000000000000000000000000000000..94b92a5853409523d36a78d347eaae4fd019fee9
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_removelogo.c
@@ -0,0 +1,587 @@
+/*
