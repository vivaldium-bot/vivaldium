index 0000000000000000000000000000000000000000..3f540e2dff20fa9183da3ac5e6384ce89d119011
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_sidechaincompress.c
@@ -0,0 +1,450 @@
