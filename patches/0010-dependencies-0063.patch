index 0000000000000000000000000000000000000000..ded25449ddfe76b7ead36dc7d300b40887367d81
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_rubberband.c
@@ -0,0 +1,271 @@
+/*
