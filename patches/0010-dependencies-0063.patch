index 0000000000000000000000000000000000000000..82d2bcda10b8e1e181dd8f816f6418ce969d807e
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/src_movie.c
@@ -0,0 +1,615 @@
+/*
+ * Copyright (c) 2010 Stefano Sabatini
+ * Copyright (c) 2008 Victor Paesa
+ *
