index 0000000000000000000000000000000000000000..dd8f264812f8994cdf5650e7bfe261fff62cf31b
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_ssim.c
@@ -0,0 +1,402 @@
+/*
+ * Copyright (c) 2003-2013 Loren Merritt
+ * Copyright (c) 2015 Paul B Mahol
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
