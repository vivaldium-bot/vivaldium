diff --git a/third_party/ffmpeg/libavfilter/deshake_opencl_kernel.h b/third_party/ffmpeg/libavfilter/deshake_opencl_kernel.h
new file mode 100644
index 0000000000000000000000000000000000000000..dd45d6f60bab2c3283033e1d7f284a2c068f9a6c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/deshake_opencl_kernel.h
@@ -0,0 +1,225 @@
+/*
+ * Copyright (C) 2013 Wei Gao <weigao@multicorewareinc.com>
+ * Copyright (C) 2013 Lenny Wang
+ *
+ *
+ * This file is part of FFmpeg.
+ *
