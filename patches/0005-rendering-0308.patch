+void Relocatable::PostGarbageCollectionProcessing(Isolate* isolate) {
+  Relocatable* current = isolate->relocatable_top();
+  while (current != nullptr) {
+    current->PostGarbageCollection();
+    current = current->prev_;
+  }
+}
