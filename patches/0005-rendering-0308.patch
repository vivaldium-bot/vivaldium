+Handle<DescriptorArray> DescriptorArray::Allocate(Isolate* isolate,
+                                                  int number_of_descriptors,
+                                                  int slack,
+                                                  PretenureFlag pretenure) {
+  DCHECK_LE(0, number_of_descriptors);
