+IGNITION_HANDLER(TestNull, InterpreterAssembler) {
+  Node* object = GetAccumulator();
+  Node* result = SelectBooleanConstant(WordEqual(object, NullConstant()));
+  SetAccumulator(result);
+  Dispatch();
+}
