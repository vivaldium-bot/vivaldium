+AllocationResult Heap::CopyFeedbackVector(FeedbackVector* src) {
+  int len = src->length();
+  HeapObject* obj = nullptr;
+  {
+    AllocationResult allocation = AllocateRawFeedbackVector(len, NOT_TENURED);
+    if (!allocation.To(&obj)) return allocation;
