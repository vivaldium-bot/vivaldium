+          reinterpret_cast<byte*>(string) + ExternalString::kResourceOffset -
+          kHeapObjectTag);
+
+  // Dispose of the C++ object if it has not already been disposed.
+  if (*resource_addr != nullptr) {
+    (*resource_addr)->Dispose();
+    *resource_addr = nullptr;
+  }
