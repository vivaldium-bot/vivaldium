+Response V8DebuggerAgentImpl::resume() {
+  if (!isPaused()) return Response::Error(kDebuggerNotPaused);
+  m_session->releaseObjectGroup(kBacktraceObjectGroup);
+  m_debugger->continueProgram(m_session->contextGroupId());
+  return Response::OK();
+}
