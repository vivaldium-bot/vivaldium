+void MacroAssembler::SmiLoadUntag(Register dst, MemOperand src) {
+  if (SmiValuesAre32Bits()) {
+    Lw(dst, UntagSmiMemOperand(src.rm(), src.offset()));
+  } else {
+    Lw(dst, src);
+    SmiUntag(dst);
+  }
+}
