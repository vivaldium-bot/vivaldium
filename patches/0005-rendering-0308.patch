+    StringStream accumulator(&allocator);
+    String::cast(name())->StringShortPrint(&accumulator, false);
+    os << accumulator.ToCString().get();
+  } else {
+    os << " (" << PrivateSymbolToName() << ")";
+  }
+  os << ">";
+}
