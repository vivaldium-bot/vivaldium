+  Code* unchecked_code() const override;
+
+  // Garbage collection support.
+  void Iterate(RootVisitor* v) const override;
+
+  static EntryFrame* cast(StackFrame* frame) {
+    DCHECK(frame->is_entry());
+    return static_cast<EntryFrame*>(frame);
+  }
