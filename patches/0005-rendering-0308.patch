+// Print 9-bit unsigned immediate value.
+void Decoder::PrintUImm9(Instruction* instr) {
+  int32_t imm = instr->Imm9Value();
+  out_buffer_pos_ += SNPrintF(out_buffer_ + out_buffer_pos_, "%u", imm);
