+bool JSFunction::IsMarkedForOptimization() {
+  return has_feedback_vector() && feedback_vector()->optimization_marker() ==
+                                      OptimizationMarker::kCompileOptimized;
+}
+
+
+bool JSFunction::IsMarkedForConcurrentOptimization() {
