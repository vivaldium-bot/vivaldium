+
+Address IC::address() const {
+  // Get the address of the call.
+  return Assembler::target_address_from_return_address(pc());
+}
+
+
+Address IC::constant_pool() const {
+  if (FLAG_enable_embedded_constant_pool) {
+    return raw_constant_pool();
+  } else {
+    return nullptr;
+  }
+}
