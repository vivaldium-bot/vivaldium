+void MarkCompactCollector::RecordLiveSlotsOnPage(Page* page) {
+  EvacuateRecordOnlyVisitor visitor(heap());
+  LiveObjectVisitor::VisitBlackObjectsNoFail(page, non_atomic_marking_state(),
+                                             &visitor,
+                                             LiveObjectVisitor::kKeepMarking);
