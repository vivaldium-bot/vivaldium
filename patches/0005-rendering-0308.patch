+bool InList(Handle<ArrayList> types, Handle<String> type) {
+  for (int i = 0; i < types->Length(); i++) {
+    Object* obj = types->Get(i);
+    if (String::cast(obj)->Equals(*type)) {
+      return true;
+    }
+  }
+  return false;
+}
