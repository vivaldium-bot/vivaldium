+
+enum BreakLocationType {
+  kCallBreakLocation,
+  kReturnBreakLocation,
+  kDebuggerStatementBreakLocation,
+  kCommonBreakLocation
+};
+
+class V8_EXPORT_PRIVATE BreakLocation : public Location {
+ public:
