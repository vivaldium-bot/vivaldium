+#ifndef V8_MAP_UPDATER_H_
+#define V8_MAP_UPDATER_H_
+
+#include "src/elements-kind.h"
+#include "src/field-type.h"
+#include "src/globals.h"
+#include "src/handles.h"
+#include "src/objects/map.h"
