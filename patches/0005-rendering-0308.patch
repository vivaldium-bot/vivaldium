+    v->VisitExternalReference(Foreign::cast(obj),
+                              reinterpret_cast<Address*>(HeapObject::RawField(
+                                  obj, kForeignAddressOffset)));
+  }
+
+  static inline int SizeOf(Map* map, HeapObject* object) { return kSize; }
+};
