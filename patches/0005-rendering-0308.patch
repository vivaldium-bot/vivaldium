+                  DONT_ENUM);
+
+
+macro SETUP_TYPED_ARRAY(NAME, ELEMENT_SIZE)
+  %SetCode(GlobalNAME, NAMEConstructor);
+endmacro
+
+TYPED_ARRAYS(SETUP_TYPED_ARRAY)
+
+})
