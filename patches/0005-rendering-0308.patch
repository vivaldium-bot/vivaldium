+  return %FunctionGetSourceCode(f);
+};
+
+
+Debug.sourcePosition = function(f) {
+  if (!IS_FUNCTION(f)) throw %make_type_error(kDebuggerType);
+  return %FunctionGetScriptSourcePosition(f);
+};
+
