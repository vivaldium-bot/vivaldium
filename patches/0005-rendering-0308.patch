+bool FeedbackVectorSpec::HasTypeProfileSlot() const {
+  FeedbackSlot slot =
+      FeedbackVector::ToSlot(FeedbackVectorSpec::kTypeProfileSlotIndex);
+  if (slots() <= slot.ToInt()) {
+    return false;
+  }
+  return GetKind(slot) == FeedbackSlotKind::kTypeProfile;
+}
