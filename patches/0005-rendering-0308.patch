+
+// Print 9-bit signed immediate value.
+void Decoder::PrintSImm9(Instruction* instr) {
+  int32_t imm = ((instr->Imm9Value()) << 23) >> 23;
+  out_buffer_pos_ += SNPrintF(out_buffer_ + out_buffer_pos_, "%d", imm);
+}
