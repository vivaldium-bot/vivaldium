+
+void Assembler::aluipc(Register rs, int16_t imm16) {
+  DCHECK_EQ(kArchVariant, kMips64r6);
+  DCHECK(rs.is_valid());
+  uint32_t imm21 = ALUIPC << kImm16Bits | (imm16 & kImm16Mask);
+  GenInstrImmediate(PCREL, rs, imm21);
+}
