+    beginInt = MathMax(0, srcLength + beginInt);
+  } else {
+    beginInt = MathMin(beginInt, srcLength);
+  }
+
+  if (endInt < 0) {
+    endInt = MathMax(0, srcLength + endInt);
+  } else {
+    endInt = MathMin(endInt, srcLength);
+  }
