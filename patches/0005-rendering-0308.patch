+    void AddNonPatternForRewriting(RewritableExpressionT expr, bool* ok) {
+      non_patterns_to_rewrite_.Add(expr, scope_->zone());
+      if (non_patterns_to_rewrite_.length() >=
+          std::numeric_limits<uint16_t>::max()) {
+        *ok = false;
+      }
+    }
