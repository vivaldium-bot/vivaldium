+#define STACK_FRAME_TYPE_LIST(V)                                          \
+  V(ENTRY, EntryFrame)                                                    \
+  V(CONSTRUCT_ENTRY, ConstructEntryFrame)                                 \
+  V(EXIT, ExitFrame)                                                      \
+  V(OPTIMIZED, OptimizedFrame)                                            \
+  V(WASM_COMPILED, WasmCompiledFrame)                                     \
