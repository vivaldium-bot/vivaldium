+static base::RandomNumberGenerator* ensure_rng_exists(
+    base::RandomNumberGenerator** rng, int seed) {
+  if (*rng == nullptr) {
+    if (seed != 0) {
+      *rng = new base::RandomNumberGenerator(seed);
+    } else {
+      *rng = new base::RandomNumberGenerator();
+    }
+  }
+  return *rng;
+}
