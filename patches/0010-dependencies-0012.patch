+            "batch_size": self.batch_size,
+            "oversplit_factor": self.oversplit_factor,
+            "model_class_path": self.model_class_path,
+            "app": self.app,
+            "ns": self.ns}
+
+  @classmethod
+  def from_json(cls, json):
