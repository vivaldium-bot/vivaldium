+ * before sending certificates to the peer. This flag is set (and the feature
+ * disabled) by default.
+ * TODO(davidben): Remove this behavior. https://crbug.com/boringssl/42. */
+#define SSL_MODE_NO_AUTO_CHAIN 0x00000008L
