diff --git a/third_party/catapult/third_party/polymer/components/core-animation/demo.html b/third_party/catapult/third_party/polymer/components/core-animation/demo.html
new file mode 100644
index 0000000000000000000000000000000000000000..ddbbc75658caa579d64cd667152a07f524386662
