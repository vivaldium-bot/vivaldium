+
+  def testPost_MigratesStoppageAlerts(self):
+    testing_common.AddTests(['Master'], ['b'], {'suite': {'foo': {}}})
+    test_path = 'Master/b/suite/foo'
+    test_key = utils.TestKey(test_path)
