+      if (key != 'default') {
+        outputNames.push(key);
+      }
+    });
+    outputNames.sort();
+    outputNames.unshift('default');
+
+    $.each(outputNames, function(index, key) {
+      outputContinerDiv.append(renderParam(
+            key, {'type': 'slot', 'slotKey': infoMap.outputs[key]}));
+    });
