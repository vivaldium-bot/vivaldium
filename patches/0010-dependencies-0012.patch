+  BATCH_SIZE_PARAM = "batch_size"
+  KEY_RANGE_PARAM = "key_range"
+  NAMESPACE_RANGE_PARAM = "namespace_range"
+  CURRENT_KEY_RANGE_PARAM = "current_key_range"
