+    self._util_stubs.sys.platform = 'win32'
+    self._browser_finder_stubs.sys.platform = 'win32'
+    self._path_stubs.os.local_app_data = 'c:\\Users\\Someone\\AppData\\Local'
+    self._files.append('c:\\tmp\\vivaldi.exe')
