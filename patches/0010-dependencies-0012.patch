+    cloud_url = cloud_storage.Insert(
+        bucket=self.browser_options.logs_cloud_bucket,
+        remote_path=remote_path,
+        local_path=self.log_file_path)
+    sys.stderr.write('Uploading browser log to %s\n' % cloud_url)
