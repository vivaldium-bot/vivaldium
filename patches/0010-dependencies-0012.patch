+    GenerateBreakpadSymbols(minidump, arch_name, os_name,
+                            symbols_path, self._browser_directory)
+
+    return subprocess.check_output([stackwalk, minidump, symbols_path],
+                                   stderr=open(os.devnull, 'w'))
