+  def testTimeout(self):
+
+    def test():
+      return False
+
+    self.assertRaises(exceptions.TimeoutException,
+                      lambda: util.WaitFor(test, 0.1))
+
+  def testCallable(self):
+    """Test methods and anonymous functions, functions are tested elsewhere."""
+
+    class Test(object):
+
+      def Method(self):
