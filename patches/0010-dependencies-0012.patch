diff --git a/third_party/catapult/telemetry/telemetry/android/shared_android_state.py b/third_party/catapult/telemetry/telemetry/android/shared_android_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5a4e6903723856e8aefb134450a79ddbb6e50fb
--- /dev/null
