+      with open(self._log_path, 'r') as f:
+        log_output = json.loads(f.read() + ']')
+        self.assertEquals(len(log_output), 5)
+        meta_data = log_output[0]
+        one_open = log_output[1]
+        two_open = log_output[2]
+        two_close = log_output[3]
