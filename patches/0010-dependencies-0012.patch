+
+  def testCollectTracingDataFromStreamJSONContainer(self):
+    self._inspector_socket.AddEvent(
+        'Tracing.tracingComplete', {'stream': '42'}, 1)
+    self._inspector_socket.AddAsyncResponse(
+        'IO.read', {'data': '{"traceEvents": [{},{},{}],'}, 2)
