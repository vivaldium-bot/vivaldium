+    if (bio == NULL) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_BUF_LIB);
+      return 0;
+    }
+    BIO_set_fd(bio, fd, BIO_NOCLOSE);
+    SSL_set0_wbio(ssl, bio);
+  } else {
