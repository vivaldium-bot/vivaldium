+    self.config = project_config.ProjectConfig(
+        top_level_dir=top_level_dir,
+        benchmark_dirs=[os.path.join(top_level_dir, 'testdata')])
+
+  @mock.patch('sys.exit')
+  def testIndependentStoryIsIndependent(self, exit_mock):
+    with mock.patch.object(
