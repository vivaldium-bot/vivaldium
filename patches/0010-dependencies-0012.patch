+        'p': '*/mac/dromaeo/*'})
+    self.assertEqual(['Chromium/mac/dromaeo/dom'], json.loads(response.body))
+
+
+  def testGetDescendants(self):
+    self._AddSampleData()
+    self.assertEqual(
