+
+    expected_types = set(
+        android_browser_finder.FindAllBrowserTypes(self.finder_options))
+    possible_browsers = android_browser_finder._FindAllPossibleBrowsers(
+        self.finder_options, self.fake_platform)
+    self.assertEqual(
+        expected_types,
