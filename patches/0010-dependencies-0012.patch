+    def testVerifyObjectWithCompleteReplay(self):
+        """Mox should replay and verify all objects it created."""
+        mock_obj = self.mox.CreateMock(TestClass)
+        mock_obj.ValidCall()
+        mock_obj.ValidCallWithArgs(mox.IsA(TestClass))
+        self.mox.ReplayAll()
