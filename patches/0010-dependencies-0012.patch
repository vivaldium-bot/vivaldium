+
+  credentials = client.SignedJwtAssertionCredentials(
+      service_account_name=account_details['client_email'],
+      private_key=account_details['private_key'],
+      scope=EMAIL_SCOPE)
+
+  http = httplib2.Http()
+  credentials.authorize(http)
+  return http
