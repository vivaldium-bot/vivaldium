+    self.assertEquals(set(types),
+                      set(['debug', 'release',
+                           'content-shell-debug', 'content-shell-release',
+                           'system', 'canary']))
+
+  def testFindAllWithExact(self):
+    if not self.CanFindAvailableBrowsers():
