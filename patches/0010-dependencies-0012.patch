+
+      is: 'speed-releasing-page',
+      properties: {
+        loading: {
+          type: Boolean,
+          value: false,
+          notify: true
+        },
+        error: {
+          type: String,
+          value: '',
+          notify: true
+        },
+        xsrfToken: {
+          type: String,
+          value: ''
+        },
+      },
+
+      ready: function() {
+        var params = {};
+        simple_xhr.send('/speed_releasing', params,
+            function(response) {
+              this.xsrfToken = response['xsrf_token'];
+              this.loading = false;
+            }.bind(this),
+            function(msg) {
+              this.error = msg;
+              this.loading = false;
+            }.bind(this));
+      }
+
+    });
+  </script>
+</dom-module>
