+
+
+class TracingUnsupportedException(Exception):
+  pass
+
+
+class TracingTimeoutException(Exception):
+  pass
+
+
+class TracingUnrecoverableException(Exception):
+  pass
+
+
+class TracingHasNotRunException(Exception):
+  pass
+
