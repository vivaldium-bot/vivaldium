+-->
+<html>
+<head>
+  <meta charset="UTF-8">
+  <title>core-selector-activate-event</title>
+
+  <script src="../../webcomponentsjs/webcomponents.js"></script>
+  <script src="../../web-component-tester/browser.js"></script>
+
+  <link rel="import" href="../core-selector.html">
+
