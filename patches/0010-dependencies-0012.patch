+            start_revision=10037, end_revision=10041, sheriff_name='sheriff',
+            internal_only=False, units='ms', absolute_delta=500))
+
+  @mock.patch.object(
+      find_anomalies.find_change_points, 'FindChangePoints',
+      mock.MagicMock(return_value=[
