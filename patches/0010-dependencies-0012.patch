+    platform = self.tab.browser.platform
+    if not platform.tracing_controller.is_tracing_running:
+      logging.warning('Tracing is off. No memory dumps are being recorded.')
+      return None
+    if deterministic_mode:
+      self.Wait(_DUMP_WAIT_TIME)
