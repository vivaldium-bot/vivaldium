+PASS inlineRe.toString() is evalFromExplicitRe.toString()
+PASS inlineRe.exec(sample)[0] is 'bm⠠p'
+PASS evalInlineRe.exec(sample)[0] is 'bm⠠p'
+PASS explicitRe.exec(sample)[0] is 'bm⠠p'
