-<script>
-var events = [];
-function logLoadEvent(event) {
-  events.push(event.target.id);
-}
-function reparentAndLogLoadEvent(event) {
-  logLoadEvent(event);
-  var element = event.target;
-  var newParent = element.parentNode.previousSibling.previousSibling;
