+                "([^:@]*)" + /* user */
+                ":?" +
+                "([^:@]*)" + /* password */
+            ")?" +
+            "@" +
+        ")" +
+    ")?"
+);
+shouldBe("regexp28.exec('file:///Users/Someone/Desktop/HelloWorld/index.html')", "['file:','file',undefined,undefined,undefined,undefined,undefined]");
