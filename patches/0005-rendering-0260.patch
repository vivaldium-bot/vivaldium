-<script>
-  description("Tests that HTMLIFrameElement, HTMLEmbedElement and HTMLObjectElement expose a getSVGDocument accessor");
-
-  window.jsTestIsAsync = true;
-  if (window.testRunner)
-    testRunner.waitUntilDone();
-
-  var iframe;
-  var embed;
-  var object;
