+"This page tests handling of malformed escape sequences."
+);
+
+var regexp;
+
+regexp = /\ug/gm;
+debug("\nTesting regexp: " + regexp);
+shouldBeTrue("regexp.test('ug')");
+shouldBe("regexp.lastIndex", "2");
+
+regexp = /\xg/gm;
+debug("\nTesting regexp: " + regexp);
+shouldBeTrue("regexp.test('xg')");
+shouldBe("regexp.lastIndex", "2");
+
+regexp = /\c_/gm;
