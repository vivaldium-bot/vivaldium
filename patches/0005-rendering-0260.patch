+{
+    return f(a, b, c)[2];
+}
+
+function tear_off_equal_access_4(a, b, c)
+{
+    return f(a, b, c)[3];
+}
+
+function tear_off_equal_access_5(a, b, c)
+{
+    return f(a, b, c)[4];
+}
+
