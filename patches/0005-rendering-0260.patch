+description("KDE JS Test");
+var b = new Boolean();
+b.x = 11;
+
+with (b) {
+  f = function(a) { return a*x; } // remember scope chain
+}
+
+shouldBe("f(2)", "22");
+
+var OBJECT = new MyObject( "hello" );
+function MyObject(value) {
+    this.value = value;
+    this.toString = new Function( "return this.value+''" );
