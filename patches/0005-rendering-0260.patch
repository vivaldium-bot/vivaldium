+'use strict';
+description('Test Promise.prototype.catch.');
+
+var reject;
+var result;
+var thisInInit;
+var thisInOnFulfilled;
+
+var firstPromise = new Promise(function(_, newReject) {
+  thisInInit = this;
+  reject = newReject;
+});
+
+var secondPromise = firstPromise.catch(function(localResult) {
