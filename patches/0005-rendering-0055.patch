-}
-
-function testFrameLoaded()
-{
-    if (frame) {
-        newChildWindow = frame.contentWindow;
-        for (var i = 0; i < propertiesToVerify.length; ++i)
-            shouldBe(propertiesToVerify[i].property, propertiesToVerify[i].expected);
-        finishJSTest();
-    }
-}
