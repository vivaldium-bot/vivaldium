-  <link rel="match" href="multicol-zero-height-001-ref.xht" />
-  <meta name="flags" content="" />
-  <style type="text/css"><![CDATA[
-  div#multi-column
-  {
-  height: 0;
-  orphans: 1;
-  widows: 1;
-  width: 200px;
-  border-bottom:1px solid red;
-
-  column-count: 10;
-  column-gap: 0;
-  }
-
-  div > div
-  {
-  background-color: lime;
-  float: left;
-  height: 10px;
-  width: 100%;
-  }
-  ]]></style>
- </head>
- <body>
-  <div id="multi-column">
-    <div></div>
-  </div>
- </body>
-</html>
