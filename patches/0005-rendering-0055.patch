-  each outer column box which depends on number of line boxes
-  in each inner column box.
-
-  N == 3;
-
-  W == max(0, (available-width - ((N - 1) * column-gap)) / N);
-  W == max(0, (5em - ((3 - 1) * 1em)) / 3);
-  W == max(0, (5em - (2 * 1em)) / 3);
-  W == max(0, (5em - 2em) / 3);
-  W == max(0, 3em / 3);
-  W == max(0, 1em);
-  W == 1em;
-
-  */
