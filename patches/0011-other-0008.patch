+
+  for arch in ARCHES:
+    for name in ['irt.h', 'irt_dev.h']:
+      src = os.path.join(NATIVE_CLIENT, 'src', 'untrusted', 'irt', name)
+      dst = GetBionicBuildPath(arch, '$NACL-nacl', 'include')
+      dst = ReplaceArch(dst, arch)
