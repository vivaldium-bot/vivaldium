+  found_inst = reader_.GetNextInstruction(&found_size_, &found_mode_);
+  EXPECT_EQ(VCD_ADD, found_inst);
+  EXPECT_EQ(257, found_size_);
+  EXPECT_EQ(0, found_mode_);
+}
