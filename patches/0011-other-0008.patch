+TEST_F(JSONWriterTest, Add) {
+  coder_.Add("123", 3);
+  coder_.Output(&output_string_);
+  coder_.FinishEncoding(&output_string_);
+  EXPECT_EQ("[\"123\"]", out_);
+}
+
+TEST_F(JSONWriterTest, Copy) {
+  coder_.Copy(3, 5);
+  coder_.Output(&output_string_);
+  coder_.FinishEncoding(&output_string_);
+  EXPECT_EQ("[3,5]", out_);
+}
+
+TEST_F(JSONWriterTest, Run) {
+  coder_.Run(3, 'a');
+  coder_.Output(&output_string_);
+  coder_.FinishEncoding(&output_string_);
+  EXPECT_EQ("[\"aaa\"]", out_);
+}
