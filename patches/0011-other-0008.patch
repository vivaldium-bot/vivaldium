+  ExpectDataByte('m');
+  // Instructions and sizes
+  if (!ExpectAddCopyInstruction(kBlockSize, (3 * kBlockSize) - 1,
+                                VCD_SELF_MODE)) {
+    ExpectCopyInstruction((3 * kBlockSize) - 1, VCD_SELF_MODE);
+  }
+  ExpectAddInstruction(1);
+  ExpectCopyInstruction((6 * kBlockSize) - 1, VCD_SELF_MODE);
