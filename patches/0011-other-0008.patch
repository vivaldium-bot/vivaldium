+
+def ReplaceText(text, maplist):
+  for m in maplist:
+    for key in m:
+      text = text.replace(key, m[key])
+  return text
+
+
+def ReplaceArch(text, arch, subarch=None):
+  NACL_ARCHES = {
+    'arm': 'arm',
+    'x86': 'x86_64',
+    'pnacl': 'pnacl'
+  }
+  GCC_ARCHES = {
+    'arm': 'arm',
+    'x86': 'i686',
+    'pnacl': 'pnacl'
+  }
+  CPU_ARCHES = {
+    'arm': 'arm',
+    'x86': 'amd64',
+    'pnacl': 'pnacl'
+  }
+  VERSION_MAP = {
+    'arm': toolchain_build.GCC_VERSION,
+    'x86': '4.4.3',
+  }
+  REPLACE_MAP = {
+    '$NACL': NACL_ARCHES[arch],
+    '$GCC': GCC_ARCHES[arch],
+    '$CPU': CPU_ARCHES[arch],
+    '$SUB': subarch or '',
+    '$ARCH': arch,
+    '$VER': VERSION_MAP[arch]
+  }
+  return ReplaceText(text, [REPLACE_MAP])
+
+
+def Clobber(fast=False):
