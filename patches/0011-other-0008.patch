+TEST_F(OutputStringTest, Size) {
+  EXPECT_EQ(string_.size(), output_string_.size());
+  string_.push_back('c');
+  EXPECT_EQ(string_.size(), output_string_.size());
+  string_.clear();
+  EXPECT_EQ(string_.size(), output_string_.size());
+}
