+    attributes=['x86-32', 'O0f', 'O0b_sz'],
+    TRANSLATE_FLAGS = '-translate-fast --use-sz')
+
+######################################################################
+# PNACL + SEL_LDR [X8664]
+######################################################################
+
+TOOLCHAIN_CONFIGS['llvm_pnacl_x86-64_O0'] = ToolchainConfig(
+    desc='pnacl llvm [x8664]',
+    attributes=['x86-64', 'O0f', 'O2b'],
