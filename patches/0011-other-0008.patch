+TEST_F(VCDiffAddressCacheTest, HereModeAddressTooLarge) {
+  ManualEncodeVarint(0x10001);  // here_address + 1
+  BeginDecode();
+  EXPECT_EQ(RESULT_ERROR, cache_.DecodeAddress(0x10000,
+                                         VCD_HERE_MODE,
+                                         &decode_position_,
+                                         decode_position_end_));
