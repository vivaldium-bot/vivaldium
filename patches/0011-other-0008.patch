+          while IFS= read -r line ; do
+            if [[ "$line" != "while read f; do" ]] ; then
+              printf "%s\n" "$line"
+            else
+              echo "while read f; do if [ \"x\$f\" = \"x\" ] ; then break ; fi"
+            fi
+          done < "$file".tmp > "$file"
+          touch -r "$file".tmp "$file"
+          rm "$file".tmp
+        fi
