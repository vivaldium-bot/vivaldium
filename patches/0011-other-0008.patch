+fill_filetype_info() {
+  local IFS="
+"
+  # Corner cases: files created by post-install scripts, mistakes, etc
+  filetype=([Cygwin.ico]="file"
+            [bin]="directory"
+            [usr/bin]="directory"
+            [lib]="directory"
+            [usr/lib]="directory"
+            [bin/exim.exe]="file"
