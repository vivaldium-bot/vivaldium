+//
+// Unit tests for the class VCDiffCodeTableWriter, found in encodetable.h.
+
+#include <config.h>
+#include <string.h>  // strlen
+#include <algorithm>
+#include <string>
+#include "addrcache.h"  // VCDiffAddressCache::kDefaultNearCacheSize
+#include "checksum.h"
