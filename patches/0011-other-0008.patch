+const char VCDiffStandardDecoderTest::kWindowHeader[] = {
+    VCD_SOURCE,  // Win_Indicator: take source from dictionary
+    FirstByteOfStringLength(kDictionary),  // Source segment size
+    SecondByteOfStringLength(kDictionary),
