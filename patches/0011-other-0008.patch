+    case VCD_ADD:
+      return "ADD";
+    case VCD_RUN:
+      return "RUN";
+    case VCD_COPY:
+      return "COPY";
+    default:
+      VCD_ERROR << "Unexpected instruction type " << inst << VCD_ENDL;
+      return "";
