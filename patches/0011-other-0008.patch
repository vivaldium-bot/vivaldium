+class VCDiffStandardWindowDecoderTest : public VCDiffDecoderTest {
+ protected:
+  static const size_t kWindow2Size = 61;
+
+  VCDiffStandardWindowDecoderTest();
+  virtual ~VCDiffStandardWindowDecoderTest() {}
+
+ private:
+  static const char kWindowBody[];
+};
