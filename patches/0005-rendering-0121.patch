-checkNotOverflow('2010-01-27', '0000-01-01'); // Too small max value.
-
-// Overflow cases
-checkOverflow('2010-01-27', '2010-01-26');
-checkOverflow('9999-01-01', '2010-12-31');
-input.min = '2010-01-28';  // value < min && value > max
-checkOverflow('2010-01-27', '2010-01-26');
