-
-test(function () {
-  assert_throws('SYNTAX_ERR', function () { navigator.registerProtocolHandler('mailtoo' + String.fromCharCode(8), location.href + '/%a', 'foo') } );
-}, 'a protocol argument containing a backspace character should throw SYNTAX_ERR');
-
-test(function () {
