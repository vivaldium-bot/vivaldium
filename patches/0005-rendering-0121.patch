-
-        function onGotComputedFonts(response)
-        {
-            collectResults(response);
-            testNextPageElement();
-        }
-    }
-
-    function collectResults(response)
-    {
-        var usedFonts = response.fonts;
-        usedFonts.sort(function(a, b) {
-            return b.glyphCount - a.glyphCount;
