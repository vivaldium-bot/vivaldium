-        { url: '/abe.png', type: "Image" },
-        { url: '/test.wav', type: "Media" },
-        { url: '/test.ogv', type: "Media" },
-        { url: '/simple-captions.vtt', type: "TextTrack" },
-        { url: '/greenbox.png', type: "XHR" }
-    ];
-    var resourcesLeft = resources.length;
-
-    function onResponseReceived(event)
