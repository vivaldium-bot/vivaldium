-            if (resource.responseAvailable)
-                description += ", responseEncoded: " + resource.responseEncoded;
-            InspectorTest.log(description);
-        }
-        InspectorTest.completeTest();
-    }
-
-    enableNetwork();
-}
-</script>
-</head>
