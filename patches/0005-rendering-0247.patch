+    return binary_operation_slot_;
+  }
+
+  void AssignFeedbackVectorSlots(Isolate* isolate, FeedbackVectorSpec* spec,
+                                 FeedbackVectorSlotCache* cache);
+  FeedbackVectorSlot CountSlot() const { return slot_; }
