+bool WebLocalFrameImpl::snapshotPage(SkBitmap& bitmap,
+                                     bool full_page,
+                                     float width,
+                                     float height) {
+  if (!frame()->document() || frame()->document()->layoutViewItem().isNull())
+    return false;
+
+  frame()->view()->updateAllLifecyclePhasesExceptPaint();
+
+  if (!frame()->document() || frame()->document()->layoutViewItem().isNull())
+    return false;
+
+  LayoutViewItem view = frame()->document()->layoutViewItem();
+  IntRect documentRect = view.documentRect();
+  FloatSize pageSize;
+  WebRect fullVisibleSize = visibleContentRect();
+
+  if (full_page) {
+    pageSize = frame()->resizePageRectsKeepingRatio(
+      FloatSize(documentRect.width(), documentRect.height()),
+      FloatSize(documentRect.width(), documentRect.height()));
+    pageSize.setHeight(std::min(pageSize.height(), height));
+  } else {
+    pageSize.setWidth(fullVisibleSize.width);
+    pageSize.setHeight(fullVisibleSize.height);
+  }
+  float pageWidth = pageSize.width();
+  float pageHeight = pageSize.height();
+  IntRect pageRect(FloatRect(0, 0, pageWidth, pageHeight));
+  SkPictureBuilder pictureBuilder(pageRect);
+  GraphicsContext& context = pictureBuilder.context();
+  {
+    SkBitmap bitmap_in;
+
+    // TODO: Check if setInfo is enough here.
+    bitmap_in.allocN32Pixels(pageWidth, pageHeight);
+
+    std::unique_ptr<WebCanvas> canvas(new WebCanvas(bitmap_in));
+
+    context.setShouldAntialias(false);
+
+    // Avoids re-sampling of the bitmap when it thinks it's printing.
+    context.setPrinting(true);
+
+    frame()->view()->paintContents(context, GlobalPaintFlattenCompositingLayers,
+                                   pageRect);
+
+    pictureBuilder.endRecording()->playback(canvas.get());
+
+    bitmap.setInfo(SkImageInfo::MakeN32Premul(pageWidth, pageHeight));
+    canvas->readPixels(&bitmap, 0, 0);
+  }
+  return true;
+}
+
 }  // namespace blink
