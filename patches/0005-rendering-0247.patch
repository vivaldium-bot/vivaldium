+
+void AstPrinter::VisitBlock(Block* node) {
+  const char* block_txt =
+      node->ignore_completion_value() ? "BLOCK NOCOMPLETIONS" : "BLOCK";
+  IndentedScope indent(this, block_txt, node->position());
+  PrintStatements(node->statements());
+}
