+
+int Assembler::GetBranchOffset(Instr instr) {
+  DCHECK(IsBranch(instr));
+  // Take the jump offset in the lower 24 bits, sign extend it and multiply it
+  // with 4 to get the offset in bytes.
+  return ((instr & kImm24Mask) << 8) >> 6;
+}
