+    CpuFeatureScope scope(this, ARMv7);
+    ubfx(dst, src, kSmiTagSize, num_least_bits);
+  } else {
+    SmiUntag(dst, src);
+    and_(dst, dst, Operand((1 << num_least_bits) - 1));
+  }
