-	</defs>
-</svg>
-<div id=log></div>
-<script>
-
-// test length values
-var EPSILON = Math.pow(2, -24); // float epsilon
-var whitespace = [ "", " ", "   ", "\r\n\t ", "\f" ];
-var garbage = [ "a", "e", "foo", ")90" ];
