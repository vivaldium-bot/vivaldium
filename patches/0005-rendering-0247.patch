-    close FILE;
-}
-
-my @tests = ();
-my @categories = ();
-my %uniqueCategories = ();
-
-sub loadTestsList()
-{
-    open TESTLIST, "<", "${suitePath}/LIST" or die "Can't find ${suitePath}/LIST";
-    while (<TESTLIST>) {
-        chomp;
-        next unless !$testsPattern || /$testsPattern/;
-        
-        push @tests, $_;
-        my $category = $_;
-        $category =~ s/-.*//;
-        if (!$uniqueCategories{$category}) {
-            push @categories, $category;
-            $uniqueCategories{$category} = $category;
-        }
-    }
-    close TESTLIST;
