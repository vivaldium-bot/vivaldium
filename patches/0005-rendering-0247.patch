+MaybeLocal<Function> Function::New(Local<Context> context,
+                                   FunctionCallback callback, Local<Value> data,
+                                   int length, ConstructorBehavior behavior) {
+  i::Isolate* isolate = Utils::OpenHandle(*context)->GetIsolate();
