+Scope::Scope(Zone* zone)
+    : zone_(zone),
+      outer_scope_(nullptr),
+      variables_(zone),
+      locals_(4, zone),
+      decls_(4, zone),
+      scope_type_(SCRIPT_SCOPE) {
