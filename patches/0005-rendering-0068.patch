-
-gEasingTests.forEach(params => {
-  const linearEquivalentEasings = [ 'cubic-bezier(0, 0, 0, 0)',
-                                    'cubic-bezier(1, 1, 1, 1)' ];
-  test(function(t) {
-    linearEquivalentEasings.forEach(linearEquivalentEasing => {
-      const timing = { duration: 1000,
