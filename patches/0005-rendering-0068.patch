-shouldBeEqualToString('stepDown("20:13", null, null, 11)', '20:02');
-shouldBeEqualToString('stepUp("20:13", "4", null, 2)', '20:13:08');
-shouldBeEqualToString('stepDown("20:13", "4", null, 3)', '20:12:48');
