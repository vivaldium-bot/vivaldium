diff --git a/third_party/WebKit/LayoutTests/external/wpt/upgrade-insecure-requests/support/testharness-helper.sub.js b/third_party/WebKit/LayoutTests/external/wpt/upgrade-insecure-requests/support/testharness-helper.sub.js
