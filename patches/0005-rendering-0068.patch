-    <div>I</div>
-    <div class="fakeAfter">a</div>
-  </div>
-
-  <!-- ...but now the normal item "I" has its order increased, so it'll go
-       at the end. -->
-  <div class="flexContainer">
-    <div class="fakeBefore">b</div>
-    <div style="order: 1">I</div>
-    <div class="fakeAfter">a</div>
-  </div>
