-description('Check stepUp() and stepDown() behavior for type=time.');
-
-var input = document.createElement('input');
-
-function setInputAttributes(min, max, step, value) {
-    input.min = min;
-    input.max = max;
-    input.step = step;
-    input.value = value;
-}
-
-function stepUp(value, step, max, optionalStepCount) {
