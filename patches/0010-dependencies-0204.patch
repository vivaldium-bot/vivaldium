+TEST(DtxControllerTest, TurnOnDtxForLowUplinkBandwidth) {
+  auto controller = CreateController(false);
+  CheckDecision(controller.get(), rtc::Optional<int>(kDtxEnablingBandwidthBps),
+                true);
+}
