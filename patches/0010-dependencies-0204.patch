+  // Adapat the frame rate.
+  request_format.interval *= 2;
+  adapter_.OnOutputFormatRequest(request_format);
+
+  for (int i = 0; i < 20; ++i)
+    capturer_->CaptureFrame();
+
+  // Verify frame drop after adaptation.
+  EXPECT_GT(listener_->GetStats().dropped_frames, 0);
