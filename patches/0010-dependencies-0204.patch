+// A helper function to compare the FakeVoiceMediaChannel::DtmfInfo.
+inline bool CompareDtmfInfo(const FakeVoiceMediaChannel::DtmfInfo& info,
+                            uint32_t ssrc,
+                            int event_code,
+                            int duration) {
+  return (info.duration == duration && info.event_code == event_code &&
+          info.ssrc == ssrc);
+}
