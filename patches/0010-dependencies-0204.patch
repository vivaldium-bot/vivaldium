+cricket::VideoCodec WebRtcVideoEngine2Test::GetEngineCodec(
+    const std::string& name) {
+  for (const cricket::VideoCodec& engine_codec : engine_.codecs()) {
+    if (CodecNamesEq(name, engine_codec.name))
+      return engine_codec;
