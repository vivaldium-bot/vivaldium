+  // Adding another stream should enable playout on the new stream only.
+  EXPECT_TRUE(AddRecvStream(kSsrc2));
+  SetSend(true);
+  EXPECT_TRUE(GetSendStream(kSsrc1).IsSending());
+
+  // Make sure only the new stream is played out.
