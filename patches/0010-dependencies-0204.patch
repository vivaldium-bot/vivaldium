diff --git a/third_party/webrtc/modules/audio_coding/codecs/ilbc/lsf_to_lsp.c b/third_party/webrtc/modules/audio_coding/codecs/ilbc/lsf_to_lsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..cfab013ab7eaf24ca90dbef8ed684c79c9957203
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/lsf_to_lsp.c
@@ -0,0 +1,61 @@
+/*
