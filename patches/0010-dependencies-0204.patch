index 0000000000000000000000000000000000000000..272b49a71c9b54c332d47d7d81a124ce6bef385f
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/get_cd_vec.c
@@ -0,0 +1,126 @@
+/*
