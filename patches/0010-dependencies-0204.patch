+bool HdFormatInList(const std::vector<cricket::VideoFormat>& formats) {
+  for (std::vector<cricket::VideoFormat>::const_iterator found =
+           formats.begin(); found != formats.end(); ++found) {
+    if (found->height >= kMinHdHeight) {
+      return true;
+    }
+  }
+  return false;
+}
