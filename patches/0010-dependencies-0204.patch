diff --git a/third_party/webrtc/media/base/adaptedvideotracksource.cc b/third_party/webrtc/media/base/adaptedvideotracksource.cc
new file mode 100644
index 0000000000000000000000000000000000000000..38735d489a896b6b3c06531349e316c9c96755fa
--- /dev/null
+++ b/third_party/webrtc/media/base/adaptedvideotracksource.cc
@@ -0,0 +1,118 @@
+/*
