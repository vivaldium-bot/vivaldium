+
+#ifndef WEBRTC_MEDIA_ENGINE_WEBRTCVIDEOCAPTURER_H_
+#define WEBRTC_MEDIA_ENGINE_WEBRTCVIDEOCAPTURER_H_
+
+#include <memory>
