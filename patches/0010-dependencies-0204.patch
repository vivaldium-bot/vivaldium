+    size_t last_packet = NumRtpPackets() - 1;
+    std::unique_ptr<const rtc::CopyOnWriteBuffer>
+        p(GetRtpPacket(static_cast<int>(last_packet)));
+    ParseRtpPacket(p.get(), NULL, NULL, NULL, NULL, &ssrc, NULL);
+    EXPECT_EQ(kSsrc, ssrc);
