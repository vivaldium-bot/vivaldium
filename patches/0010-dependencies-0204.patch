+      config->rtp.extensions.push_back(
+          RtpExtension(kExtensionNames[i], prng->Rand<int>()));
+    }
+  }
+}
+
+void GenerateAudioSendConfig(uint32_t extensions_bitvector,
+                             AudioSendStream::Config* config,
+                             Random* prng) {
