+  wtu.glErrorShouldBe(gl, gl.NO_ERROR, "Should be no errors from setup");
+  wtu.clearAndDrawUnitQuad(gl);
+  checkPixelRange(middle, center, [   15, 121,   0, 255], 10);
+  wtu.glErrorShouldBe(gl, gl.NO_ERROR, "Should be no errors");
+
+  debug("");
