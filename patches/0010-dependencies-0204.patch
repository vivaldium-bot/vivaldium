index 0000000000000000000000000000000000000000..362610a1c442dda4d5d838fef876727eb370a898
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/isac/fix/source/transform.c
@@ -0,0 +1,213 @@
+/*
+ *  Copyright (c) 2011 The WebRTC project authors. All Rights Reserved.
+ *
