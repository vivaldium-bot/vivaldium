+    cricket::VideoSendParameters parameters = send_parameters_;
+    parameters.extensions.push_back(RtpExtension(ext_uri, id));
+    EXPECT_TRUE(channel_->SetSendParameters(parameters));
+    FakeVideoSendStream* send_stream =
