index 0000000000000000000000000000000000000000..c19818ee37e288a8d7303ec748be57a7bb49ab50
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/cb_construct.c
@@ -0,0 +1,71 @@
+/*
