+      if (!registered_rtx_ssrc_[header.ssrc])
+        return SEND_PACKET;
+
+      EXPECT_LE(header.headerLength + header.paddingLength, length);
+      const bool packet_is_redundant_payload =
+          header.headerLength + header.paddingLength < length;
