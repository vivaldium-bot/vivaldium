+    m_errorMonitor->VerifyFound();
+    uint32_t pDynOff[2] = {512, 756};
+    // Now cause error b/c too many dynOffsets in array for # of dyn descriptors
+    m_errorMonitor->SetDesiredFailureMsg(VK_DEBUG_REPORT_ERROR_BIT_EXT,
