+    std::set<uint32_t> expected_send_ssrcs_;
+    std::string expected_cname_;
+
+    rtc::Event check_stats_event_;
+    ReceiveStreamRenderer receive_stream_renderer_;
+  } test;
+
+  RunBaseTest(&test);
+}
