+    EXPECT_EQ(video_codec_type_, config->codecType);
+    VerifyCodecSpecifics(*config);
+    ++num_initializations_;
+    init_encode_event_.Set();
+    return FakeEncoder::InitEncode(config, number_of_cores, max_payload_size);
