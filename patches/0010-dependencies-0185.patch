+#define GET_DEVICE_PROC_ADDR(dev, entrypoint)                                            \
+    {                                                                                    \
+        fp##entrypoint = (PFN_vk##entrypoint)vkGetDeviceProcAddr(dev, "vk" #entrypoint); \
