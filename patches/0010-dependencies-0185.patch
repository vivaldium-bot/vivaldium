+  int16_t output[kAllocatedOuputSizeSamples];
+  AudioDecoderIsacFix dec(kSampleRateHz);
+  FuzzAudioDecoder(DecoderFunctionType::kNormalDecode, data, size, &dec,
+                   kSampleRateHz, sizeof(output), output);
+}
+}  // namespace webrtc
