+	}
+
+	template <typename T, precision P> 
+	GLM_FUNC_QUALIFIER detail::tmat3x3<T, P> colMajor3(
+		const detail::tmat3x3<T, P>& m)
+	{
+		return detail::tmat3x3<T, P>(m);
