+	// powerOfTwoNearest
+	template <typename genType>
+	GLM_FUNC_QUALIFIER genType powerOfTwoNearest
+	(
+		genType const & value
+	)
+	{
+		if(isPowerOfTwo(value))
+			return value;
+
+		genType prev = highestBitValue(value);
+		genType next = prev << 1;
+		return (next - value) < (value - prev) ? next : prev;
+	}
