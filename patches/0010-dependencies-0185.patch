+#else
+#		pragma message("GLM: yaw function returning degrees is deprecated. #define GLM_FORCE_RADIANS before including GLM headers to remove this message.")
+		return glm::degrees(asin(T(-2) * (q.x * q.z - q.w * q.y)));
+#endif
