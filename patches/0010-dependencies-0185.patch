+GLM_FUNC_QUALIFIER fvec4SIMD& fvec4SIMD::operator=(fvec4SIMD const & v)
+{
+	this->Data = v.Data;
+	return *this;
+}
+
+GLM_FUNC_QUALIFIER fvec4SIMD& fvec4SIMD::operator+=(float const & s)
+{
+	this->Data = _mm_add_ps(Data, _mm_set_ps1(s));
+	return *this;
+}
