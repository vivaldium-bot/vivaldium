+class LayerFilteringTransport : public test::DirectTransport {
+ public:
+  LayerFilteringTransport(const FakeNetworkPipe::Config& config,
+                          Call* send_call,
+                          uint8_t vp8_video_payload_type,
+                          uint8_t vp9_video_payload_type,
