+      '../../build/config/',
+      '../../third_party/instrumented_libraries/instrumented_libraries.isolate',
+      '<(PRODUCT_DIR)/test_support_unittests_apk/',
+      '<(PRODUCT_DIR)/bin/run_test_support_unittests',
+      'test_support_unittests.isolate',
+    ]
+  }
+}
