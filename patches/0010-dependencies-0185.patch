+                            table += '\n    // ---- %s extension commands\n' % cur_cmd.ext_name
+                        cur_extension_name = cur_cmd.ext_name
+
+                    # Remove 'vk' from proto name
+                    base_name = cur_cmd.name[2:]
+
+                    if cur_cmd.protect is not None:
