diff --git a/third_party/webrtc/test/testsupport/packet_reader.cc b/third_party/webrtc/test/testsupport/packet_reader.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e27ec22f16aa8c91c7dd6b15afdf504694599081
--- /dev/null
