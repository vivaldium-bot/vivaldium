+//
+// Parse either a .conf file provided by the user or the default string above.
+//
+void VkTestFramework::ProcessConfigFile() {
+    char **configStrings = 0;
+    char *config = 0;
+    if (ConfigFile.size() > 0) {
+        configStrings = ReadFileData(ConfigFile.c_str());
+        if (configStrings)
+            config = *configStrings;
+        else {
+            printf(
+                "Error opening configuration file; will instead use the "
+                "default configuration\n");
+        }
+    }
+
+    if (config == 0) {
+        config = (char *)alloca(strlen(DefaultConfig) + 1);
+        strcpy(config, DefaultConfig);
+    }
+
+    const char *delims = " \t\n\r";
+    const char *token = strtok(config, delims);
+    while (token) {
+        const char *valueStr = strtok(0, delims);
+        if (valueStr == 0 || !(valueStr[0] == '-' || (valueStr[0] >= '0' && valueStr[0] <= '9'))) {
+            printf(
+                "Error: '%s' bad .conf file.  Each name must be followed by "
+                "one number.\n",
+                valueStr ? valueStr : "");
