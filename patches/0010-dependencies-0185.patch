+  				if(length(*curr) > char_offset && (length(*curr) <= (nextOffset + 1) || getchar((*curr), nextOffset) != getchar((*first), nextOffset))) {
+  					done = true;
+  					break;
+  				}
+  			} while(++curr != finish);
+  			if(!done)
+  				++nextOffset;
+  		} 
+  		char_offset = nextOffset;
+  	}
