+/// 
+/// glUniform3fv(uniformLoc, 1, glm::value_ptr(aVector));
+/// glUniformMatrix4fv(uniformMatrixLoc, 1, GL_FALSE, glm::value_ptr(someMatrix));
+/// @endcode
+/// 
+/// <glm/gtc/type_ptr.hpp> need to be included to use these functionalities.
