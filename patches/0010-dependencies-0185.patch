+int fopen_s(FILE **pFile, const char *filename, const char *mode) {
+    if (!pFile || !filename || !mode) {
+        return EINVAL;
+    }
+
+    FILE *f = fopen(filename, mode);
+    if (!f) {
+        if (errno != 0) {
+            return errno;
+        } else {
+            return ENOENT;
+        }
+    }
+    *pFile = f;
