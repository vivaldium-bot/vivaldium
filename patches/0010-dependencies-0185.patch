+    GLM_FUNC_QUALIFIER
+    format_guard::~format_guard()
+    {
+      cr()    = cr_;
+      order() = order_;
+    }
+
+    GLM_FUNC_QUALIFIER unsigned& precision()
+    {
+      static unsigned p(3);
+
+      return p;
+    }
+    
+    GLM_FUNC_QUALIFIER unsigned& value_width()
