+	
+	/// Generate a random 3D vector which coordinates are regulary distributed within the volume of a ball of a given radius
+	/// 
+	/// @param Radius
+	/// @see gtc_random
+	template <typename T>
+	GLM_FUNC_DECL detail::tvec3<T, defaultp> ballRand(
+		T const & Radius);
+	
+	/// @}
+}//namespace glm
