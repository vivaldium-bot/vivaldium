+	template <typename T, precision P> 
+	GLM_FUNC_DECL detail::tvec3<T, P> triangleNormal(
+		detail::tvec3<T, P> const & p1, 
+		detail::tvec3<T, P> const & p2, 
+		detail::tvec3<T, P> const & p3);
