-        consoleWrite(ex);
-        return;
-    }
-
-    if (comparison === undefined)
-        comparison = '==';
-
-    var success = false;
-    switch (comparison)
-    {
-        case '<':   success = observed <  expected; break;
-        case '<=': success = observed <= expected; break;
-        case '>':   success = observed >  expected; break;
-        case '>=': success = observed >= expected; break;
-        case '!=':  success = observed != expected; break;
-        case '==': success = observed == expected; break;
-        case '===': success = observed === expected; break;
