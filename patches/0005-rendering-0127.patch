-    plugin.setAttribute("onNew", "loadedSecond()");
-    document.getElementById("plugins").appendChild(plugin);
-    window.setTimeout(done, 5);
-}
-
-function loadedSecond()
-{
-    log("FAIL: second plugin loaded");
-}
