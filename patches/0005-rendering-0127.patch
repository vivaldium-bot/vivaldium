-function secToMilli(seconds)
-{
-    return seconds * 1000.;
-}
-
-function milliToSecs(milliseconds)
-{
-    return milliseconds / 1000;
-}
-
-function nowInSecs()
-{
-    return milliToSecs(window.performance.now());
