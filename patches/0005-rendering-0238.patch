-    function is_shared_worker(worker) {
-        return 'SharedWorker' in self && worker instanceof SharedWorker;
-    }
-
-    function is_service_worker(worker) {
-        return 'ServiceWorker' in self && worker instanceof ServiceWorker;
-    }
