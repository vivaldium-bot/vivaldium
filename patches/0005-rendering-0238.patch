-            return Markup._SELECTION_ANCHOR;
-    } else if (index == sel.focusOffset && node == sel.focusNode)
-        return Markup._SELECTION_FOCUS;
-
-    return '';
-}
-
-window.addEventListener('load', Markup.notifyDone, false);
