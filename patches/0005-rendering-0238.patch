-<tr><td>Row 4</td></tr>
-<tr><td>Row 5</td></tr>
-</table>
-<input type=text name=from value=2 size=1>
-<input type=text name=to value=4 size=1>
-<input type=button name=go value=go onclick="moveRow(-1,-1);">
-</body>
-</html>
