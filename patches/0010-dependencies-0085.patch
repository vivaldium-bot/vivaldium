diff --git a/third_party/icu/source/i18n/regextxt.cpp b/third_party/icu/source/i18n/regextxt.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2156756a49141106a631a052616fc5e07fd8f19d
--- /dev/null
