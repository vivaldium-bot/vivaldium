--- /dev/null
+++ b/third_party/grpc/src/csharp/Grpc.Core/GrpcEnvironment.cs
@@ -0,0 +1,373 @@
+#region Copyright notice and license
+
+// Copyright 2015, Google Inc.
+// All rights reserved.
+//
