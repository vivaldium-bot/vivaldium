+VideoFrame* WebRtcVideoFrameFactory::CreateAliasedFrame(
+    const CapturedFrame* aliased_frame, int width, int height) const {
+  rtc::scoped_ptr<WebRtcVideoFrame> frame(new WebRtcVideoFrame());
