+class FakeTiming : public rtc::Timing {
+ public:
+  FakeTiming() : now_(0.0) {}
+
+  virtual double TimerNow() {
+    return now_;
+  }
+
+  void set_now(double now) {
+    now_ = now;
+  }
+
+ private:
+  double now_;
+};
