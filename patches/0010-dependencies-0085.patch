+      RTCPair* pair =
+          [[RTCPair alloc] initWithKey:@(it.second->display_name())
+                                 value:@(it.second->ToString().c_str())];
+      [values addObject:pair];
+    }
+    _values = values;
+  }
+  return self;
+}
