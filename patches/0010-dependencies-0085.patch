+#ifndef __GNOMEFONTINSTANCE_H
+#define __GNOMEFONTINSTANCE_H
+
+#include <gnome.h>
+#include <ft2build.h>
+#include FT_FREETYPE_H
+#include FT_GLYPH_H
+#include <cairo.h>
+
