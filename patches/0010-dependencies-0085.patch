+bool ContainsMatchingCodec(const std::vector<C>& codecs, const C& codec) {
+  typename std::vector<C>::const_iterator it;
+  for (it = codecs.begin(); it != codecs.end(); ++it) {
+    if (it->Matches(codec)) {
