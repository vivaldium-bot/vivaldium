+  mediastream_signaling_.SendAudioVideoStream1();
+  SessionDescriptionInterface* offer = CreateOffer();
+
+  cricket::MediaSessionOptions options;
+  SessionDescriptionInterface* answer = CreateRemoteAnswer(offer, options);
