+    webrtc::VideoCodecVP8 vp8;
+    webrtc::VideoCodecVP9 vp9;
+  } vpx_settings_;
+  int num_swapped_frames_;
+  webrtc::VideoFrame last_frame_;
+  webrtc::VideoSendStream::Stats stats_;
+};
