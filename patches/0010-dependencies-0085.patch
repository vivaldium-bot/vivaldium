+  options_.cpu_overuse_detection.Get(&signal_cpu_adaptation_);
+  webrtc::Call::Config config(this);
+  config.overuse_callback = this;
+  if (voice_engine != NULL) {
+    config.voice_engine = voice_engine->voe()->engine();
