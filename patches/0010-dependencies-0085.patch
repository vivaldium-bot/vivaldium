+          neteq_fast_accelerate(false) {
+      memset(&send_codec, 0, sizeof(send_codec));
+      memset(&rx_agc_config, 0, sizeof(rx_agc_config));
+    }
+    bool external_transport;
+    bool send;
+    bool playout;
+    float volume_scale;
+    float volume_pan_left;
+    float volume_pan_right;
+    bool file;
+    bool vad;
+    bool codec_fec;
