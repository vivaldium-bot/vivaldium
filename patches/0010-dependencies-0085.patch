+
+- (void)setMaxRetransmits:(NSInteger)maxRetransmits {
+  _dataChannelInit.maxRetransmits = maxRetransmits;
+}
+
+- (NSString*)protocol {
+  return NSStringFromStdString(_dataChannelInit.protocol);
+}
