+            long remainder = args.Dividend % args.Divisor;
+            return new DivReply { Quotient = quotient, Remainder = remainder };
+        }
+
+        static IEnumerable<Num> FibInternal(long n)
+        {
+            long a = 1;
+            yield return new Num { Num_ = a };
+
