index 0000000000000000000000000000000000000000..8a2c0a908657e4d69dd361aed2a807fc9e1996db
--- /dev/null
+++ b/third_party/grpc/src/core/lib/support/slice.c
@@ -0,0 +1,350 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
+ *
