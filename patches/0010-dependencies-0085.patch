diff --git a/third_party/grpc/test/core/http/httpcli_test.c b/third_party/grpc/test/core/http/httpcli_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..6c27ea2651e8d75561519ff25dee223005c7b68b
--- /dev/null
+++ b/third_party/grpc/test/core/http/httpcli_test.c
@@ -0,0 +1,202 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
