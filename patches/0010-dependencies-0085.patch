+                                          AudioTrackInterface* audio_track,
+                                          uint32 ssrc) {
+  stream_handler_container_->AddLocalAudioTrack(stream, audio_track, ssrc);
+  stats_->AddLocalAudioTrack(audio_track, ssrc);
+}
