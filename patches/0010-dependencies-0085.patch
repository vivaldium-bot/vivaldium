+    LOG(LS_WARNING) << "UpdateAspectRatio ignored invalid ratio: "
+                    << ratio_w << "x" << ratio_h;
+    return;
+  }
+  ratio_w_ = ratio_w;
+  ratio_h_ = ratio_h;
+}
