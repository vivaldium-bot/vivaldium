+      Implemented as an automaton.
+
+      Example:
+        With text = '\\001python2.7\\001-c\\001print(\\"hi\\")\\0', the
+        function will return ['python2.7', '-c', 'print("hi")]
+      """
+      if not text.endswith('\\0'):
+        raise ValueError('String is not null terminated: %r' % text, text)
+      text = text[:-2]
+
