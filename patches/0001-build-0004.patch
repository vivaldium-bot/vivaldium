+  def test_match_configs(self):
+    expectations = [
+        (
+          ('OS=="win"', ('OS',), [('win',), ('mac',), ('linux',)]),
+          [('win',)],
+        ),
+        (
+          (
+            '(foo==1 or foo==2) and bar=="b"',
+            ['foo', 'bar'],
+            [(1, 'a'), (1, 'b'), (2, 'a'), (2, 'b')],
+          ),
+          [(1, 'b'), (2, 'b')],
+        ),
+        (
+          (
+            'bar=="b"',
+            ['foo', 'bar'],
+            [(1, 'a'), (1, 'b'), (2, 'a'), (2, 'b')],
