+def collect(url, task_ids):
+  """Simplifies the call to swarming.collect()."""
+  return swarming.collect(
+    swarming=url,
+    task_ids=task_ids,
+    timeout=10,
+    decorate=True,
+    print_status_updates=True,
+    task_summary_json=None,
+    task_output_dir=None)
