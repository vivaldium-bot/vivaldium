+//        is_nothrow_default_constructible<key_compare>::value &&
+//        is_nothrow_copy_constructible<key_compare>::value);
+
+// This tests a conforming extension
+
+// UNSUPPORTED: c++98, c++03
+
+#include <unordered_set>
