+        'root': {
+          'children': [],
+          'command': command,
+          'executable': filepath,
+          'files': files,
+          'initial_cwd': initial_cwd,
+          'pid': self._ROOT_PID,
+        }
+      }
+      if not files:
+        expected['root']['command'] = None
+        expected['root']['executable'] = None
+      self.assertContext(lines, initial_cwd, expected, False)
