+      help='Seconds to allow the task to complete.')
+  parser.task_group.add_option(
+      '--io-timeout', type='int', default=20*60,
+      help='Seconds to allow the task to be silent.')
+  parser.task_group.add_option(
+      '--raw-cmd', action='store_true', default=False,
