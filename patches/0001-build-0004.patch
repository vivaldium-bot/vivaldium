+          ],
+          'ForceSymbolReferences': [
+            '?x@@YAHXZ',
+            '?y@@YAHXZ',
+          ],
+        },
+      },
+      'sources': ['hello.cc'],
+      'dependencies': [
+        'test_force_reference_lib',
+      ],
+    },
+  ]
+}
