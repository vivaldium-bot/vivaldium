+    # Trigger a ridiculous amount of tasks, and abort the remaining.
+    with threading_utils.ThreadPool(2, 2, 0) as pool:
+      # Allow 10 tasks to run initially.
+      sem = threading.Semaphore(10)
+
+      def grab_and_return(x):
