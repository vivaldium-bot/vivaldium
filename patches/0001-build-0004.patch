+def get_results(keys, output_collector=None):
+  """Simplifies the call to yield_results().
+
+  The timeout is hard-coded to 10 seconds.
+  """
+  return list(
+      swarming.yield_results(
+          'https://host:9001', keys, 10., None, True, output_collector))
