+    accessed through any symlink which points to the same directory.
+    """
+    # Resolve any symlink
+    root = fs.realpath(root)
+    root = (
+        file_path.get_native_path_case(root).rstrip(os.path.sep) + os.path.sep)
+    logging.debug('strip_root(%s)' % root)
