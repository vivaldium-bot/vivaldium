+class SymLink(str):
+  """Used as a marker to create a symlink instead of a file."""
+
+
+def umask():
+  """Returns current process umask without modifying it."""
+  global _UMASK
+  if _UMASK is None:
+    _UMASK = os.umask(0777)
+    os.umask(_UMASK)
+  return _UMASK
