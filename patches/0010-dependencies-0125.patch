index 0000000000000000000000000000000000000000..693f2895aad9232a21fb7152fb5c1cb0ae0d664f
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_flatshade.c
@@ -0,0 +1,282 @@
+/**************************************************************************
