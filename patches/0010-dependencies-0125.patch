+#ifndef PP_PROGRAM_H
+#define PP_PROGRAM_H
+
+#include "pipe/p_state.h"
+
+/**
+*	Internal control details.
+*/
+struct program
+{
+   struct pipe_screen *screen;
+   struct pipe_context *pipe;
+   struct cso_context *cso;
+
+   struct pipe_blend_state blend;
+   struct pipe_depth_stencil_alpha_state depthstencil;
+   struct pipe_rasterizer_state rasterizer;
+   struct pipe_sampler_state sampler;   /* bilinear */
+   struct pipe_sampler_state sampler_point;     /* point */
+   struct pipe_viewport_state viewport;
+   struct pipe_framebuffer_state framebuffer;
+   struct pipe_vertex_element velem[2];
+
+   union pipe_color_union clear_color;
+
+   void *passvs;
+
+   struct pipe_resource *vbuf;
+   struct pipe_surface surf;
+   struct pipe_sampler_view *view;
+
+   struct blit_state *blitctx;
+};
+
+
+#endif
diff --git a/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_run.c b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_run.c
