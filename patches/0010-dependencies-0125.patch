index 0000000000000000000000000000000000000000..47defc62b96a8ade23be458d69bf1edfeddb1658
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_split_tmp.h
@@ -0,0 +1,176 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.9
+ *
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * Copyright (C) 2010 LunarG Inc.
+ *
