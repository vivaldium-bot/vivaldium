+specialize qw/vpx_h_predictor_4x4 neon dspr2 msa/, "$sse2_x86inc";
+
+add_proto qw/void vpx_he_predictor_4x4/, "uint8_t *dst, ptrdiff_t y_stride, const uint8_t *above, const uint8_t *left";
