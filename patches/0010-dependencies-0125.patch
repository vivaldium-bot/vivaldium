+Import('*')
+
+env = env.Clone()
+
+galahad = env.ConvenienceLibrary(
+	target = 'galahad',
+	source = [
+		'glhd_context.c',
+		'glhd_objects.c',
+		'glhd_screen.c',
+	])
+
+env.Alias('galahad', galahad)
+
+Export('galahad')
