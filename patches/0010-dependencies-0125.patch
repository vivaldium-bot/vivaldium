--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_mlaa.c
@@ -0,0 +1,308 @@
+/**
+ * Copyright (C) 2010 Jorge Jimenez (jorge@iryoku.com)
+ * Copyright (C) 2010 Belen Masia (bmasia@unizar.es)
