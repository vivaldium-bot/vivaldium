+        unsigned flags = 0;
+        if (kSoft_ClipEdgeStyle == edgeStyle) {
+            flags = kClip_HasAntiAlias_DrawOpFlag;
+        }
+        this->writeOp(kClipRect_DrawOp, flags, rgnOp);
+        fWriter.writeRect(rect);
+    }
