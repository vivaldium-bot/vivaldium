+
+enum {
+   dct_End_of_Block = 0xFF,
+   dct_Escape = 0xFE,
+   dct_DC = 0xFD,
+   dct_AC = 0xFC
+};
+
+struct dct_coeff
+{
+   uint8_t length;
+   uint8_t run;
+   int16_t level;
+};
+
+struct dct_coeff_compressed
+{
+   uint32_t bitcode;
+   struct dct_coeff coeff;
+};
