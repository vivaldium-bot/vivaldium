index 0000000000000000000000000000000000000000..03d7453f303b19bd8db93dcce5d5d27df2f5f146
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/indices/u_indices.c
@@ -0,0 +1,253 @@
+/*
