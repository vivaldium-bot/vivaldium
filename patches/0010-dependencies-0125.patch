+#ifndef vl_mpeg12_decoder_h
+#define vl_mpeg12_decoder_h
+
+#include "pipe/p_video_decoder.h"
+
+#include "vl_mpeg12_bitstream.h"
+#include "vl_zscan.h"
+#include "vl_idct.h"
+#include "vl_mc.h"
