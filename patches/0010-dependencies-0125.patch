+    source/convert_argb.o      \
+    source/convert_from.o      \
+    source/convert_from_argb.o \
+    source/convert_to_argb.o   \
+    source/convert_to_i420.o   \
+    source/cpu_id.o            \
+    source/planar_functions.o  \
+    source/rotate.o            \
+    source/rotate_any.o        \
+    source/rotate_argb.o       \
+    source/rotate_common.o     \
