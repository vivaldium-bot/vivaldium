index 0000000000000000000000000000000000000000..101aac7474d2aa579e78e1ef3440af75c7c11f84
--- /dev/null
+++ b/third_party/skia/src/utils/SkFloatUtils.h
@@ -0,0 +1,173 @@
+/*
