+
+SkDrawBitmapCommand::SkDrawBitmapCommand(const SkBitmap& bitmap, SkScalar left, SkScalar top,
+                                         const SkPaint* paint)
+    : INHERITED(kDrawBitmap_OpType) {
+    fBitmap = bitmap;
