index 0000000000000000000000000000000000000000..cd10c411ceaf5ec0e33e58da7bbbf61c4cc2f08e
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vpx/src/vpx_encoder.c
@@ -0,0 +1,401 @@
+/*
