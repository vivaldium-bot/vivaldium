+struct lp_type;
+struct lp_build_context;
+
+
+LLVMValueRef
+lp_build_compare(struct gallivm_state *gallivm,
+                 const struct lp_type type,
+                 unsigned func,
+                 LLVMValueRef a,
+                 LLVMValueRef b);
+
