+vl_matrix_filter_cleanup(struct vl_matrix_filter *filter);
+
+
+void
+vl_matrix_filter_render(struct vl_matrix_filter *filter,
+                        struct pipe_sampler_view *src,
+                        struct pipe_surface *dst);
+
+
+#endif /* vl_matrix_filter_h */
