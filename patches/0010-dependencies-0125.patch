+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_vs_exec.c
@@ -0,0 +1,241 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
