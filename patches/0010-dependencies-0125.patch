+struct SkOpAngle {
+    enum IncludeType {
+        kUnaryWinding,
+        kUnaryXor,
+        kBinarySingle,
+        kBinaryOpp,
+    };
+
+    bool after(SkOpAngle* test);
+    int allOnOneSide(const SkOpAngle* test);
