new file mode 100644
index 0000000000000000000000000000000000000000..1835b36a93cae7d283d57bdf97d8a43be1bc7e3f
--- /dev/null
+++ b/third_party/libwebm/source/sample_muxer.cc
@@ -0,0 +1,657 @@
+// Copyright (c) 2011 The WebM project authors. All Rights Reserved.
