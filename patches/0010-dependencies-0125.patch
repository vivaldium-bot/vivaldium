+
+struct galahad_context;
+
+
+struct galahad_resource
+{
+   struct pipe_resource base;
+
+   struct pipe_resource *resource;
+
+   int map_count;
+};
+
+
+struct galahad_sampler_view
+{
+   struct pipe_sampler_view base;
+
+   struct pipe_sampler_view *sampler_view;
+};
+
+
