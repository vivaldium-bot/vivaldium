index 0000000000000000000000000000000000000000..cc4a74bd260b1a4e9693f12d233d0678801c38f4
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vpx_dsp/intrapred.c
@@ -0,0 +1,870 @@
+/*
