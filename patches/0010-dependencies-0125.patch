+static struct tgsi_immediate
+tgsi_build_immediate(
+   struct tgsi_header *header,
+   unsigned type )
+{
+   struct tgsi_immediate immediate;
+
+   immediate = tgsi_default_immediate();
+   immediate.DataType = type;
+
+   header_bodysize_grow( header );
+
+   return immediate;
+}
