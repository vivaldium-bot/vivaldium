+  bool output_frame_stats;
+  bool output_vp9_level;
+};
+
+Options::Options()
+    : output_video(true),
+      output_audio(true),
+      output_size(false),
+      output_offset(false),
+      output_seconds(true),
+      output_ebml_header(true),
