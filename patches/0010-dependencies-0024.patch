+    else:
+      error_msg = 'Invalid response %s.' % resp.status
+      try:
+        d = json.loads(content)
+        if 'error' in d:
+          error_msg = d['error']
+      except (TypeError, ValueError):
+        pass
+      raise TokenRevokeError(error_msg)
