+  </test-fixture>
+
+  <!--
+  NOTE(cdata): Enable test-fixture when polymer/polymer#2495 is resolved
+  -->
+  <!--<test-fixture id="repeatedItems">
+    <template>-->
+      <iron-selector multi id="repeatedItems">
+        <template is="dom-repeat" items='["foo", "bar", "baz"]'>
+          <div>[[item]]</div>
