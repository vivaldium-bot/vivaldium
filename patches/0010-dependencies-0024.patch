+        user-select: none;
+        cursor: pointer;
+      }
+
+      :host([disabled]) {
+        opacity: 0.3;
+        pointer-events: none;
+      }
+
+      :host([active]),
+      :host([pressed]) {
+        background-color: #3367D6;
+        box-shadow: inset 0 3px 5px rgba(0,0,0,.2);
+      }
+    </style>
+    
+    <content></content>
+
+  </template>
+
+  <script>
+
+    Polymer({
+
+      behaviors: [
+        Polymer.IronControlState,
+        Polymer.IronButtonState
+      ],
+
+      hostAttributes: {
+        role: 'button'
+      }
+    });
+
+  </script>
+
+</dom-module>
