+    </demo-snippet>
+
+    <h4>Justification, center justified</h4>
+    <demo-snippet>
+      <template>
+        <style is="custom-style">
+          .flex-center-justified {
+            @apply(--layout-horizontal);
+            @apply(--layout-center-justified);
+          }
+        </style>
+
+        <div class="container flex-center-justified">
