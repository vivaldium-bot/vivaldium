+
+    <h4>Flexible children</h4>
+    <demo-snippet>
+      <template>
+        <style is="custom-style">
+          .flex-horizontal {
+            @apply(--layout-horizontal);
+          }
+          .flexchild {
+            @apply(--layout-flex);
+          }
+        </style>
+
+        <div class="container flex-horizontal">
+          <div>one</div>
+          <div class="flexchild">two (flex)</div>
+          <div>three</div>
+        </div>
