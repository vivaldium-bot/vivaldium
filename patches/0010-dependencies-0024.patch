+<body>
+
+  <test-fixture id="test">
+    <template>
+      <iron-selector multi>
+        <div>Item 0</div>
+        <div>Item 1</div>
+        <div>Item 2</div>
+        <div>Item 3</div>
+        <div>Item 4</div>
