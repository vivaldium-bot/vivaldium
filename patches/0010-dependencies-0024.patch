+  color: blue;
+  font-weight: normal;
+}
+.disclosure:hover,
+.status-links a:hover,
+.detail-link a:hover {
+  text-decoration: underline;
+}
+#sidebar .detail-link {
+  word-wrap: break-word;
+}
+.detail-link a {
