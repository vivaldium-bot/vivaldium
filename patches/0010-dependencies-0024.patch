+        s = scope.$.selector;
+        t = scope.$.t;
+        t.items = [{ id: 0, name:'item0'}, {id: 1, name: 'item1'}, {id: 2, name: 'item2'}];
+      });
+
+      teardown(function() {
+        t.items = [];
+      });
+
+      test('select a value of zero', function() {
+        t.render();
+        s.selected = 1;
+        assert.equal(s.selected, '1');
