-        + ' (threshold = ' + this.maxAllowedError + ')'
-      );
-      this.success = false;
-    }
-  };
-
-
-  Test.prototype.finish = function () {
-    if (this.success)
-      testPassed(this.description + ': passed.');
-    else
-      testFailed(this.description + ': failed.');
-  };
-
-
-  Test.prototype.run = function (done) {
-
-    this.init();
