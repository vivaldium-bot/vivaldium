-        );
-      }
-      this.success = false;
-    }
-
-    if (this.maxErrorL <= this.maxAllowedError) {
-      testPassed('Left channel gain values are correct.');
-    } else {
-      testFailed('Left channel gain values are incorrect.  Max error = '
