-        for (i=0; i < populate; ++i)
-            arr[i] = 0;
-        arr[target] = 0;
-    } catch(e) {
-        var expect_name = "Error";
-        var expect_message = "Out of memory";
-        if ((e.name == expect_name) && (e.message == expect_message))
-            document.write("<p>SUCCESS</p>");
