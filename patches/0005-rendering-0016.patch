+        : m_mailbox(mailbox)
+    { }
+
+    bool operator==(const TextureMailboxWrapper& other) const
+    {
+        return !memcmp(m_mailbox.name, other.m_mailbox.name, sizeof(m_mailbox.name));
+    }
+
+    bool operator!=(const TextureMailboxWrapper& other) const
+    {
+        return !(*this == other);
