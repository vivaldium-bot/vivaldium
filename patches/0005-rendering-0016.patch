+    int ages[numberOfGenerationsToTrack];
+    AgeCounts() { std::fill(ages, ages + numberOfGenerationsToTrack, 0); }
+};
+typedef HashMap<String, AgeCounts> ClassAgeCountsMap;
+#endif
