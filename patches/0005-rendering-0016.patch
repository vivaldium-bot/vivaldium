+private:
+    WebRTCICECandidatePrivate(const WebString& candidate, const WebString& sdpMid, unsigned short sdpMLineIndex);
+
+    WebString m_candidate;
+    WebString m_sdpMid;
+    unsigned short m_sdpMLineIndex;
+};
