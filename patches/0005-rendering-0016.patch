+DisplayItemList* GraphicsLayer::displayItemList()
+{
+    if (!RuntimeEnabledFeatures::slimmingPaintEnabled())
+        return 0;
+    if (!m_displayItemList)
+        m_displayItemList = DisplayItemList::create();
+    return m_displayItemList.get();
+}
