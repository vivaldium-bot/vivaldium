-  block-size: 100px;
-  min-block-size: 50px;
-  max-block-size: 100px;
-  inline-size: 100px;
-  background-color: blue;
-}
-#table3_cell {
-  block-size: 120px;
-  min-block-size: 50px;
-  max-block-size: 100px;
-  inline-size: 100px;
-  background-color: green;
-}
-#ref_table1_cell {
-  width: 40px;
-  min-width: 50px;
