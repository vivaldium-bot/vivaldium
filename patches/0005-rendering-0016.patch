+        m_client->didFinalizeFrame();
+}
+
+void ImageBuffer::finalizeFrame(const FloatRect &dirtyRect)
+{
+    m_surface->finalizeFrame(dirtyRect);
+    didFinalizeFrame();
+}
+
+bool ImageBuffer::restoreSurface() const
+{
+    return m_surface->isValid() || m_surface->restore();
+}
