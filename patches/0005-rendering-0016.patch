-
-<style>
-div {
-  border: 1px solid #000;
-  writing-mode: vertical-lr;
-}
-#div1 {
-  block-size: 40px;
-  min-block-size: 50px;
-  max-block-size: 100px;
-}
-#div2 {
-  block-size: 100px;
-  min-block-size: 50px;
-  max-block-size: 100px;
-}
-#div3 {
-  block-size: 120px;
-  min-block-size: 50px;
-  max-block-size: 100px;
-}
