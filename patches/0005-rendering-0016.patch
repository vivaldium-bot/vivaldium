+void GraphicsContext::rotate(float angleInRadians)
+{
+    if (contextDisabled())
+        return;
+    ASSERT(m_canvas);
+
+    m_canvas->rotate(WebCoreFloatToSkScalar(angleInRadians * (180.0f / 3.14159265f)));
