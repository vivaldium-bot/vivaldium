+    ScrollableArea* scrollableArea() const { return m_scrollableArea; }
+
+    WebContentLayer* contentLayer() const { return m_layer.get(); }
+
+    static void registerContentsLayer(WebLayer*);
+    static void unregisterContentsLayer(WebLayer*);
+
