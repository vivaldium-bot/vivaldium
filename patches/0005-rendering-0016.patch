+void BaseHeap::prepareForSweep()
+{
+    ASSERT(threadState()->isInGC());
+    ASSERT(!m_firstUnsweptPage);
+
+    // Move all pages to a list of unswept pages.
+    m_firstUnsweptPage = m_firstPage;
+    m_firstPage = nullptr;
+}
