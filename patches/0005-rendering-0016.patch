+            break;
+        default:
+            ASSERT_NOT_REACHED();
+        }
+        break;
+    case GL_UNSIGNED_SHORT_4_4_4_4:
+        dstFormat = WebGLImageConversion::DataFormatRGBA4444;
+        break;
+    case GL_UNSIGNED_SHORT_5_5_5_1:
