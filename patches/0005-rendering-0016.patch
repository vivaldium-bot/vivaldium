+TEST_F(DisplayItemListTest, Scope)
+{
+    TestDisplayItemClient multicol("multicol");
+    TestDisplayItemClient content("content");
+    GraphicsContext context(&displayItemList());
+
+    FloatRect rect1(100, 100, 50, 50);
