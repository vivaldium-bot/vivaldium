+class OneKiloByteObject : public GarbageCollectedFinalized<OneKiloByteObject> {
+public:
+    ~OneKiloByteObject() { s_destructorCalls++; }
+    char* data() { return m_data; }
+    DEFINE_INLINE_TRACE() { }
