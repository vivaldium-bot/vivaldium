+TEST(HeapTest, StackGrowthDirection)
+{
+    // The implementation of marking probes stack usage as it runs,
+    // and has a builtin assumption that the stack grows towards
+    // lower addresses.
+    EXPECT_EQ(GrowsTowardsLower, stackGrowthDirection());
+}
