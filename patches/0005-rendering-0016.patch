-  writing-mode: vertical-lr;
-}
-#p1 {
-  block-size: 100px;
-  width: 50px;
-}
-#p2 {
-  width: 50px;
-  block-size: 100px;
-}
-#ref_p1 {
-  width: 50px;
-}
-#ref_p2 {
-  width: 100px;
-}
-
-.table {
-  border: 1px solid #000;
-  display: table;
-  writing-mode: vertical-lr;
-}
