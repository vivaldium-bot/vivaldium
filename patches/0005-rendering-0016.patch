+    TestSpecificUChar32RangeIdeograph(0xF900, 0xFAFF);
+    // CJK Unified Ideographs Extension B.
+    TestSpecificUChar32RangeIdeograph(0x20000, 0x2A6DF);
+    // CJK Unified Ideographs Extension C.
