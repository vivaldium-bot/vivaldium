+        this->SkCanvas::onClipPath(path, op, edgeStyle);
+    }
+
+    void onClipRegion(const SkRegion& region, SkRegion::Op op) override
+    {
+        Interceptor interceptor(this);
+        this->SkCanvas::onClipRegion(region, op);
