+        0x02135, 0x0213F,
+        0x02145, 0x0214A,
+        0x0214C, 0x0214D,
+        0x0214F, 0x0218F,
+        // Mathematical Operators (Part of)
+        0x0221E, 0x0221E,
+        0x02234, 0x02235,
