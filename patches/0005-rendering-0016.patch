+size_t ThreadState::SnapshotInfo::getClassTag(const GCInfo* gcInfo)
+{
+    ClassTagMap::AddResult result = classTags.add(gcInfo, classTags.size());
+    if (result.isNewEntry) {
+        liveCount.append(0);
+        deadCount.append(0);
+        liveSize.append(0);
+        deadSize.append(0);
+        generations.append(GenerationCountsVector());
