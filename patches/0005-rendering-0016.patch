+        values[i] = value;
+    }
+    bool areAllValuesEqualTo(size_t value) const
+    {
+        for (size_t i = 1; i < kLongCountForLongSimpleDerivedElement; i++) {
+            if (values[i] != values[0])
+                return false;
+        }
+        return true;
+    }
