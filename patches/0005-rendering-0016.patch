+        zapMagic();
+#endif
+    }
+
+    Address address() { return reinterpret_cast<Address>(this); }
+
+    NO_SANITIZE_ADDRESS
+    void unlink(FreeListEntry** prevNext)
+    {
+        *prevNext = m_next;
+        m_next = nullptr;
+    }
+
+    NO_SANITIZE_ADDRESS
+    void link(FreeListEntry** prevNext)
+    {
+        m_next = *prevNext;
+        *prevNext = this;
+    }
+
+    NO_SANITIZE_ADDRESS
+    FreeListEntry* next() const { return m_next; }
+
+    NO_SANITIZE_ADDRESS
+    void append(FreeListEntry* next)
+    {
+        ASSERT(!m_next);
