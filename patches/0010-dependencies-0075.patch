+	void					initPrograms				(SourceCollections&	programCollection) const
+	{
+		ostringstream buffer;
+		buffer	<< "layout(set = 0, binding = 0, std430) buffer Output\n"
+				<< "{\n"
+				<< "	int result[];\n"
+				<< "} sb_out;\n";
