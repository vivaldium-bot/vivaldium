+    POOL_ALLOCATOR_NEW_DELETE(GetThreadPoolAllocator())
+
+    TConstUnion() : iConst(0), type(EbtInt) { }
+
+    void setIConst(int i)
+    { 
+        iConst = i; 
+        type = EbtInt;
+    }
+
+    void setUConst(unsigned int u)
