+    int i;
+    float f;
+    lunarStruct1 s1_1;
+};
+
+
+uniform lunarStruct1 foo;
+uniform lunarStruct2 foo2[5];
+uniform lunarStruct3 foo3;
+uniform int Count;
+
+void main()
+{
+    float scale;
+    int iLocal = Count;
+
+    if (foo3.s2_1[1].i > 0)
+        scale = foo2[foo3.s2_1[foo.i].i + 2 + ++iLocal].s1_1.f;
+    else
+        scale = foo3.s2_1[0].s1_1.f;
