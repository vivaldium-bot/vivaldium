--- /dev/null
+++ b/third_party/glslang/src/glslang/MachineIndependent/Scan.h
@@ -0,0 +1,265 @@
+//
+//Copyright (C) 2002-2005  3Dlabs Inc. Ltd.
+//Copyright (C) 2013 LunarG, Inc.
+//
+//All rights reserved.
+//
+//Redistribution and use in source and binary forms, with or without
