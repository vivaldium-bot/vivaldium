+struct ShaderParameters {
+	float		bias;				//!< User-supplied bias.
+	float		ref;				//!< Reference value for shadow lookups.
+	tcu::Vec2	padding;			//!< Shader uniform padding.
+	tcu::Vec4	colorScale;			//!< Scale for texture color values.
