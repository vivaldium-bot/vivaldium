+bool is_positive_infinity(double x) {
+#ifdef _MSC_VER
+  return _fpclass(x) == _FPCLASS_PINF;
+#elif defined __ANDROID__ || defined __linux__ || __MINGW32__ || __MINGW64__
+  return std::isinf(x) && (x >= 0);
+#else
+  return isinf(x) && (x >= 0);
+#endif
+}
