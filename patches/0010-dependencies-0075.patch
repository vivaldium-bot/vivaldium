index 0000000000000000000000000000000000000000..7888e570a3179b223eb0a46435e34376f7ec514d
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/resample.c
@@ -0,0 +1,565 @@
+/*
+ * audio resampling
+ * Copyright (c) 2004-2012 Michael Niedermayer <michaelni@gmx.at>
+ * bessel function: Copyright (c) 2006 Xiaogang Zhang
+ *
+ * This file is part of FFmpeg.
