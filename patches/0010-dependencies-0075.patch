+struct TransferInfo
+{
+	VkCommandBuffer					commandBuffer;
+	deUint32						width;
+	deUint32						height;
+	VkImage							image;
+	VkBuffer						buffer;
+	VkDeviceSize					size;
+	deUint32						mipLevel;
