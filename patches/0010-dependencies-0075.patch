index 0000000000000000000000000000000000000000..f51a5f149f046e8f53e106a70612488614de7a8e
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/arm/rgb2yuv_neon_32.S
@@ -0,0 +1,119 @@
+/*
+ * Copyright (C) 2013 Xiaolei Yu <dreifachstein@gmail.com>
+ *
