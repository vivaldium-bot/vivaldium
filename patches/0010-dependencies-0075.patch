diff --git a/third_party/flac/src/libFLAC/include/private/lpc.h b/third_party/flac/src/libFLAC/include/private/lpc.h
new file mode 100644
index 0000000000000000000000000000000000000000..2cb139b4bfde3425e8b953e5501afce1bcf2a18a
--- /dev/null
+++ b/third_party/flac/src/libFLAC/include/private/lpc.h
@@ -0,0 +1,214 @@
+/* libFLAC - Free Lossless Audio Codec library
+ * Copyright (C) 2000,2001,2002,2003,2004,2005,2006,2007  Josh Coalson
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
+ * - Redistributions of source code must retain the above copyright
+ * notice, this list of conditions and the following disclaimer.
+ *
