+			"%cnull             = OpConstantNull %a4_v4f32\n",
+			"%v                 = OpVariable %fp_a4_v4f32 Function %cnull\n"
+			"%f                 = OpAccessChain %fp_v4f32 %v %c_u32_0\n"
