+		beginCommandBuffer(vk, *cmdBuffer);
+
+		m_writeOp->recordCommands(*cmdBuffer);
+
+		if (m_resource->getType() == RESOURCE_TYPE_BUFFER || isIndirectBuffer(m_resource->getType()))
