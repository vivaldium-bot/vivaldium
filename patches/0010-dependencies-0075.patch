+
+	VK_CHECK(vk.queueSubmit(queue, 1u, &submitInfo, *fence));
+	if (VK_SUCCESS != vk.waitForFences(device, 1u, &fence.get(), DE_TRUE, LONG_FENCE_WAIT))
