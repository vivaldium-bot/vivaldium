+
+FATE_FILTER-$(call FILTERDEMDECENCMUX, ATRIM, WAV, PCM_S16LE, PCM_S16LE, WAV) += $(FATE_ATRIM)
+
+FATE_FILTER_CHANNELMAP += fate-filter-channelmap-one-int
