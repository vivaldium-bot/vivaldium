diff --git a/third_party/fontconfig/src/conf.d/65-nonlatin.conf b/third_party/fontconfig/src/conf.d/65-nonlatin.conf
new file mode 100644
index 0000000000000000000000000000000000000000..9306f74922ff79e4797dfa57afc9ab4f7214f1cb
--- /dev/null
+++ b/third_party/fontconfig/src/conf.d/65-nonlatin.conf
@@ -0,0 +1,196 @@
+<?xml version="1.0"?>
+<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
+<fontconfig>
+	<alias>
+		<family>serif</family>
+		<prefer>
+			<family>Artsounk</family> <!-- armenian -->
+			<family>BPG UTF8 M</family> <!-- georgian -->
+			<family>Kinnari</family> <!-- thai -->
+			<family>Norasi</family> <!-- thai -->
+			<family>Frank Ruehl</family> <!-- hebrew -->
+			<family>Dror</family>  <!-- hebrew -->
