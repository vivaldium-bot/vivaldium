diff --git a/third_party/ffmpeg/libswresample/arm/audio_convert_init.c b/third_party/ffmpeg/libswresample/arm/audio_convert_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..ec9e62ede7294fbbb4d4b1bb1a463bdab728b5cc
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/arm/audio_convert_init.c
@@ -0,0 +1,67 @@
