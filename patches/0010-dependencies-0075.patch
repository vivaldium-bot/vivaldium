index 0000000000000000000000000000000000000000..4989aa69915d0ede44a4db8185de204dfb0c6e1f
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/x86/resample.asm
@@ -0,0 +1,605 @@
+;******************************************************************************
