+                                    CFSTR("kTISPropertyUnicodeKeyLayoutData"));
+      GTM_TISCopyCurrentKeyboardLayoutInputSource
+        = CFBundleGetFunctionPointerForName(hiToolbox,
+                             CFSTR("TISCopyCurrentKeyboardLayoutInputSource"));
