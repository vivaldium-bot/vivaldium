diff --git a/third_party/ffmpeg/libswresample/dither.c b/third_party/ffmpeg/libswresample/dither.c
new file mode 100644
index 0000000000000000000000000000000000000000..08c793d4cf8cad84252208b51c849326d29fb242
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/dither.c
@@ -0,0 +1,152 @@
+/*
+ * Copyright (C) 2012-2013 Michael Niedermayer (michaelni@gmx.at)
+ *
+ * This file is part of libswresample
+ *
+ * libswresample is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
