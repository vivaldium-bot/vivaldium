+    //for (int i = 0; i < iLocal; ++i) {
+    //	scale += foo2[i].f;
+    //}
+
+    gl_FragColor =  scale * texture2D(sampler, coord);
+
+    vec2[3] constructed = vec2[3](coord, vec2(scale), vec2(1.0, 2.0));
+    gl_FragColor += vec4(constructed[foo.i], constructed[foo.i]);
