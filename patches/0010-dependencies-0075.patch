index 0000000000000000000000000000000000000000..5907e03286ab94ac2ddd40f5e1acab305158dbfc
--- /dev/null
+++ b/third_party/fontconfig/src/config/config-subst
@@ -0,0 +1,10 @@
+#!/bin/sh
+script=config-subst.$$
+trap "rm $script" 0
+rm -f $script
+for i in ${1+"$@"}; do
+	var="`echo "$i" | sed 's/=.*$//'`"
+	val="`echo "$i" | sed 's/^[^=]*=//'`"
+	echo "s;@$var@;$val;" >> $script
+done
+sed -f $script
