new file mode 100755
index 0000000000000000000000000000000000000000..b50357bfc52e504a926c3dd089eb4572eca130d1
--- /dev/null
+++ b/third_party/gnu_binutils/setup_env.bat
@@ -0,0 +1,8 @@
+:: This script must not rely on any external tools or PATH values.
+@echo OFF
+
+:: Let advanced users checkout the tools in just one P4 enlistment
+if "%SETUP_ENV_GNU_BINUTILS%"=="done" goto :EOF
+set  SETUP_ENV_GNU_BINUTILS=done
+
+set PATH=%PATH%;%~dp0\files
diff --git a/third_party/google_toolbox_for_mac/src/AddressBook/GTMABAddressBook.h b/third_party/google_toolbox_for_mac/src/AddressBook/GTMABAddressBook.h
