+enum Constants
+{
+	NUM_PER_PATCH_BLOCKS		= 2,
+	NUM_PER_PATCH_ARRAY_ELEMS	= 3,
+	NUM_OUTPUT_VERTICES			= 5,
+	NUM_TESS_LEVELS				= 6,
