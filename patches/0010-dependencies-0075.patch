+
+		{
+			// BASE_LEVEL
+			for (int minFilter = 0; minFilter < DE_LENGTH_OF_ARRAY(minFilterModes); minFilter++)
+			{
+				TextureCubeMipmapTestCaseParameters	testParameters;
+				testParameters.minFilter = minFilterModes[minFilter].mode;
