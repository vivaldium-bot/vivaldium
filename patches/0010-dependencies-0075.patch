index 0000000000000000000000000000000000000000..ebe4dd04bedc00b6c8fcecbb580601a8bafea4db
--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/AppKit/GTMFadeTruncatingTextFieldCell.m
@@ -0,0 +1,237 @@
+//  GTMFadeTruncatingTextFieldCell.m
+//
+//  Copyright 2009 Google Inc.
+//
