+  }
+
+  return errors;
+}
+
+assertEquals(0, test_shr(1));
+%OptimizeFunctionOnNextCall(test_shr);
+for (var i = 5; i >= -5; i--) {
+  assertEquals(0, test_shr(i));
+}
diff --git a/v8/test/mjsunit/compiler/short-circuit.js b/v8/test/mjsunit/compiler/short-circuit.js
