+
+// Flags: --allow-natives-syntax
+
+function test_function(o) {
+  if (%_ClassOf(o) === "Function") {
+    return true;
+  } else {
+    return false;
+  }
+}
+
+var non_callable = new Proxy({}, {});
+var callable = new Proxy(function(){}.__proto__, {});
+var constructable = new Proxy(function(){}, {});
