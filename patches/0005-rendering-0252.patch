+  assertEquals("NaN", String(Math.sqrt(-Infinity, -0.5)));
+  assertEquals("NaN", String(Math.sqrt(NaN, 0.5)));
+});
+
+test(function mathAbs() {
+  assertEquals(1.5, Math.abs(1.5));
