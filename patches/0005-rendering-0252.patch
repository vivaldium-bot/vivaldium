+for (var i = 0; i < 10000; i++) "x".replace(re, replaceCallback);
+
+Debug.setListener(listener);
+debugger;                                       // Break 0.
+var result = "x".replace(re, replaceCallback);  // Break 1.
+Debug.setListener(null);                        // Break 4.
+
+assertNull(exception);
