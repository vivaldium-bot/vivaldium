index 0000000000000000000000000000000000000000..a812daa44a63f95a56359cf67c2c9a32f7fd6110
--- /dev/null
+++ b/v8/test/mjsunit/compiler/regress-gap.js
@@ -0,0 +1,130 @@
+// Copyright 2010 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
