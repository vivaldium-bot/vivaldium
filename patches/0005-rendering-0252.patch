+assertEquals(2, f2(a2_b, 1));
+assertEquals(0.5, f2(a2_b, 0));
diff --git a/v8/test/mjsunit/elide-double-hole-check-10.js b/v8/test/mjsunit/elide-double-hole-check-10.js
