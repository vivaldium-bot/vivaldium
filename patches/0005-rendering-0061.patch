-      height: 50px;
-      width: 300px;
-      margin-bottom: 2px;
-      background: lightgray;
-    }
-    div.withBefore::before {
-      display: table-row;
-      content: 'b';
-      background: yellow;
-      /* If these "align-self" & "order" properties impact the rendering (as
-         they should), that verifies we're being treated as a flex item. */
-      align-self: center;
-      order: 1;
