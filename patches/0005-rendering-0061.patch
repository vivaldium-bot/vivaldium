-
-test (t => {
-  // Tokenizing `name`: initial window features separators are ignored
-  // Each of these variants should tokenize to ('noopener', '')
-  var featureVariants = [
-    ' noopener',
-    '=noopener',
-    ',,noopener',
-    ',=, noopener',
-    '\n=noopener=',
-    '\tnoopener',
-    '\r,,,=noopener',
-    '\u000Cnoopener'
-  ];
