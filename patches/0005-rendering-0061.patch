-    'no\nopener', //    => ('no', ''), ('opener', '')
-    'no,opener', //     => ('no', ''), ('opener', '')
-    '\0noopener', //    => ('\0noopener', '')
-    'noopener\u0000=yes', // => ('noopener\0', 'yes')
