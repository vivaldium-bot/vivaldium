-  {
-    valueToReturn: "",
-    expectCancelation: true,
-    setReturnValue: "foo",
-    expectedReturnValue: "foo"
-  },
-  {
-    valueToReturn: false,
-    expectCancelation: true,
-    setReturnValue: "foo",
-    expectedReturnValue: "foo"
-  },
-  {
-    valueToReturn: true,
-    expectCancelation: true,
-    setReturnValue: "foo",
-    expectedReturnValue: "foo"
-  },
-  {
