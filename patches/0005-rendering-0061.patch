-  checkDefine(C, 'parent');
-  checkDefine(C, 'location');
-  checkDefine(C, 'document');
-  checkDefine(C, 'foopy');
-  checkDefine(C.location, 'href');
-  checkDefine(C.location, 'replace');
-  checkDefine(C.location, 'port');
-  checkDefine(C.location, 'foopy');
