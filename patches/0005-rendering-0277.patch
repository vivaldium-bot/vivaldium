+
+// TODO(svenpanne) Start with IndentedScope.
+void AstPrinter::VisitVariableDeclaration(VariableDeclaration* node) {
+  PrintLiteralWithModeIndented("VARIABLE", node->proxy()->var(),
+                               node->proxy()->name());
