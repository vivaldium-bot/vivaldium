+  void VisitUnaryOperation(UnaryOperation* expr) {
+    RECURSE(Visit(expr->expression()));
+    switch (expr->op()) {
+      case Token::NOT: {
+        DCHECK_EQ(kWasmI32, TypeOf(expr->expression()));
+        current_function_builder_->Emit(kExprI32Eqz);
+        break;
+      }
+      default:
+        UNREACHABLE();
+    }
+  }
