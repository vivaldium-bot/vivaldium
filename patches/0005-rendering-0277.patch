+std::ostream& operator<<(std::ostream& os, AccessMode access_mode) {
+  switch (access_mode) {
+    case AccessMode::kLoad:
+      return os << "Load";
+    case AccessMode::kStore:
+      return os << "Store";
+    case AccessMode::kStoreInLiteral:
+      return os << "StoreInLiteral";
+  }
+  UNREACHABLE();
+  return os;
+}
