+size_t FrameStateDescriptor::GetJSFrameCount() const {
+  size_t count = 0;
+  for (const FrameStateDescriptor* iter = this; iter != nullptr;
+       iter = iter->outer_state_) {
+    if (FrameStateFunctionInfo::IsJSFunctionType(iter->type_)) {
+      ++count;
+    }
+  }
+  return count;
