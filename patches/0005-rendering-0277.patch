+Scope::Scope(Zone* zone, const AstRawString* catch_variable_name,
+             MaybeAssignedFlag maybe_assigned, Handle<ScopeInfo> scope_info)
+    : zone_(zone),
+      outer_scope_(nullptr),
+      variables_(zone),
+      scope_info_(scope_info),
+      scope_type_(CATCH_SCOPE) {
