+Handle<Code> CodeStub::GetCodeCopy(const FindAndReplacePattern& pattern) {
+  Handle<Code> ic = GetCode();
+  ic = isolate()->factory()->CopyCode(ic);
+  ic->FindAndReplace(pattern);
+  RecordCodeGeneration(ic);
+  return ic;
+}
