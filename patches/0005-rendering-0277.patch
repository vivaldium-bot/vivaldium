+  V(kAllocatingNonEmptyPackedArray, "Allocating non-empty packed array")       \
+  V(kAllocationIsNotDoubleAligned, "Allocation is not double aligned")         \
+  V(kAPICallReturnedInvalidObject, "API call returned invalid object")         \
