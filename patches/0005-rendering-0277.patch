+void AstPrinter::VisitIfStatement(IfStatement* node) {
+  IndentedScope indent(this, "IF", node->position());
+  PrintIndentedVisit("CONDITION", node->condition());
+  PrintIndentedVisit("THEN", node->then_statement());
