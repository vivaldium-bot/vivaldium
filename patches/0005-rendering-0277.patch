+    if (mode != kMode_None) {                                           \
+      size_t first_index = (fi);                                        \
+      mem = i.MemoryOperand(&mode, &first_index);                       \
+      ret = first_index;                                                \
+    } else {                                                            \
+      mem = i.InputStackSlot(fi);                                       \
+    }                                                                   \
+    return mem;                                                         \
+  })(ret)
