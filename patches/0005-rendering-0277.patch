+namespace {
+bool ValidAsmIdentifier(Handle<String> name) {
+  static const char* kInvalidAsmNames[] = {"eval", "arguments"};
+
+  for (size_t ii = 0; ii < arraysize(kInvalidAsmNames); ++ii) {
+    if (strcmp(name->ToCString().get(), kInvalidAsmNames[ii]) == 0) {
+      return false;
+    }
+  }
+  return true;
+}
