+#define GET_MEMOPERAND32(ret, fi)                                       \
+  ([&](int& ret) {                                                      \
+    AddressingMode mode = AddressingModeField::decode(instr->opcode()); \
+    MemOperand mem(r0);                                                 \
+    if (mode != kMode_None) {                                           \
+      size_t first_index = (fi);                                        \
+      mem = i.MemoryOperand(&mode, &first_index);                       \
+      ret = first_index;                                                \
+    } else {                                                            \
+      mem = i.InputStackSlot32(fi);                                     \
+    }                                                                   \
+    return mem;                                                         \
+  })(ret)
