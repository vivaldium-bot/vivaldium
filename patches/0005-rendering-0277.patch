+      expr->pattern(), expr->flags(),
+      FeedbackVector::GetIndex(expr->literal_slot()));
+  Node* literal = NewNode(op, closure);
+  PrepareFrameState(literal, expr->id(), ast_context()->GetStateCombine());
+  ast_context()->ProduceValue(expr, literal);
+}
