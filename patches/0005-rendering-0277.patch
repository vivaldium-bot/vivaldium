+                   i.InputRegister(1), i.InputRegister(2));
+      } else {
+        uint32_t imm = i.InputOperand(2).immediate();
+        __ SarPair(i.OutputRegister(0), second_output, i.InputRegister(0),
+                   i.InputRegister(1), imm);
+      }
