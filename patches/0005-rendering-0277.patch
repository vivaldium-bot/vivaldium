+                                    graph()->start());
+    Node* overflow = graph()->NewNode(jsgraph()->common()->Projection(1), trunc,
+                                      graph()->start());
+    ZeroCheck64(wasm::kTrapFloatUnrepresentable, overflow, position);
+    return result;
+  }
