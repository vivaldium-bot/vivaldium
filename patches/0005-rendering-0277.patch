+
+void AstPrinter::VisitCaseClause(CaseClause* clause) {
+  if (clause->is_default()) {
+    IndentedScope indent(this, "DEFAULT", clause->position());
+    PrintStatements(clause->statements());
+  } else {
+    IndentedScope indent(this, "CASE", clause->position());
+    Visit(clause->label());
+    PrintStatements(clause->statements());
+  }
