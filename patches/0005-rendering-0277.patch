+void MacroAssembler::Neg(const Register& rd,
+                         const Operand& operand) {
+  DCHECK(allow_macro_instructions_);
+  DCHECK(!rd.IsZero());
+  if (operand.IsImmediate()) {
+    Mov(rd, -operand.ImmediateValue());
+  } else {
+    Sub(rd, AppropriateZeroRegFor(rd), operand);
+  }
+}
