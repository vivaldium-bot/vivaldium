+  static bool IsAllowed(Isolate* isolate);
+
+ private:
+  class DataBit;
+
+  Isolate* isolate_;
+  uint32_t old_data_;
+
+  DISALLOW_COPY_AND_ASSIGN(PerIsolateAssertScope);
+};
