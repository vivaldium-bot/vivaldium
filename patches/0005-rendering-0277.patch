+  // 9.a Return RejectPromise(promise, then.[[Value]]).
+  BIND(&if_rejectpromise);
+  {
+    // Don't cause a debug event as this case is forwarding a rejection.
+    InternalPromiseReject(context, promise, var_reason.value(), false);
+    Goto(&out);
+  }
+
+  BIND(&out);
