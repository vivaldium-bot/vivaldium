+
+size_t FrameStateDescriptor::GetFrameCount() const {
+  size_t count = 0;
+  for (const FrameStateDescriptor* iter = this; iter != nullptr;
+       iter = iter->outer_state_) {
+    ++count;
+  }
+  return count;
+}
