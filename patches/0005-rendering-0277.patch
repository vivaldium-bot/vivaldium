+
+  // Addresses always have 64 bits, so we shouldn't encounter NONE32.
+  DCHECK(rmode != RelocInfo::NONE32);
+
+  if (rmode == RelocInfo::NONE64) {
+    return kCallSizeWithoutRelocation;
+  } else {
+    return kCallSizeWithRelocation;
+  }
+}
