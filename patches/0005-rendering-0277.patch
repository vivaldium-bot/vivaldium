+void BinaryOpICStub::GenerateAheadOfTime(Isolate* isolate,
+                                         const BinaryOpICState& state) {
+  if (FLAG_minimal) return;
+  BinaryOpICStub stub(isolate, state);
+  stub.GetCode();
+}
