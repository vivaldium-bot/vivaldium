+  }
+  Node* WordNotEqual(Node* a, Node* b) {
+    return Word32BinaryNot(WordEqual(a, b));
+  }
+  Node* WordNot(Node* a) {
+    if (machine()->Is32()) {
+      return Word32Not(a);
+    } else {
+      return Word64Not(a);
+    }
+  }
+
+  Node* Word32And(Node* a, Node* b) {
+    return AddNode(machine()->Word32And(), a, b);
+  }
+  Node* Word32Or(Node* a, Node* b) {
