+
+void AstPrinter::VisitSwitchStatement(SwitchStatement* node) {
+  IndentedScope indent(this, "SWITCH", node->position());
+  PrintLabelsIndented(node->labels());
+  PrintIndentedVisit("TAG", node->tag());
