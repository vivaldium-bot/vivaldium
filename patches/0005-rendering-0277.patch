+  AsmType* ValidateBlockStatement(Block* block);
+  // 6.5.2 ExpressionStatement
+  AsmType* ValidateExpressionStatement(ExpressionStatement* expr);
+  // 6.5.3 EmptyStatement
+  AsmType* ValidateEmptyStatement(EmptyStatement* empty);
