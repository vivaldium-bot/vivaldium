+  BIND(&report_unhandledpromise);
+  {
+    GotoIf(PromiseHasHandler(promise), &fulfill);
+    CallRuntime(Runtime::kReportPromiseReject, context, promise, value);
+    Goto(&fulfill);
+  }
+
+  BIND(&fulfill);
+  PromiseFulfill(context, promise, value, v8::Promise::kRejected);
+}
