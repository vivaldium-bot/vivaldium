+  Node* node = nullptr;
+  if (Node* simplified =
+          TryBuildSimplifiedStoreNamed(op, object, value, feedback.slot())) {
+    if (environment() == nullptr) return;
+    node = simplified;
+  } else {
+    node = NewNode(op, object, value);
