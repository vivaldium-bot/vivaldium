diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2008-01-02-hoist-fp-add.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2008-01-02-hoist-fp-add.ll
