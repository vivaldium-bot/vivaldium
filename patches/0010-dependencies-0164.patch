+}
+
+TEST_F(FilterTest, ExponentialSmoothingConstantArray) {
+  int64_t exp_smoothed[kNumElements];
+  ExponentialSmoothingConstantArray(exp_smoothed);
+  for (int i = 0; i < kNumElements; ++i) {
