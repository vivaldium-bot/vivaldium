+#ifndef WEBRTC_MODULES_RTP_RTCP_SOURCE_BITRATE_H_
+#define WEBRTC_MODULES_RTP_RTCP_SOURCE_BITRATE_H_
+
+#include <stdio.h>
+
+#include <list>
+
+#include "webrtc/base/scoped_ptr.h"
