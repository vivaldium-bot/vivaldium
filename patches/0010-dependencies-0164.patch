+/*
+ * The core AEC algorithm, SSE2 version of speed-critical functions.
+ */
+
+#include <emmintrin.h>
+#include <math.h>
+#include <string.h>  // memset
+
+extern "C" {
+#include "webrtc/common_audio/signal_processing/include/signal_processing_library.h"
+}
