diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2009-07-17-CrossRegClassCopy.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2009-07-17-CrossRegClassCopy.ll
