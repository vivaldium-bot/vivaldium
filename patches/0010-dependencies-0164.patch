diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch-on-const-select.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch-on-const-select.ll
