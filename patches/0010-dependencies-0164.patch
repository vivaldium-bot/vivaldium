+int WebRtcAec_GetDelayMetrics(void* handle,
+                              int* median,
+                              int* std,
+                              float* fraction_poor_delays) {
+  Aec* self = reinterpret_cast<Aec*>(handle);
+  if (median == NULL) {
+    return AEC_NULL_POINTER_ERROR;
+  }
+  if (std == NULL) {
+    return AEC_NULL_POINTER_ERROR;
+  }
+  if (self->initFlag != initCheck) {
