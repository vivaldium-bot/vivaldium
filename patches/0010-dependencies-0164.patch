+// ----------------------------------------------------------------------------
+//  ClearSpeakerState II (II)
+// ----------------------------------------------------------------------------
+
+void AudioMixerManager::ClearSpeakerState()
+{
+    for (int i = 0; i < MAX_NUMBER_MIXER_DEVICES; i++)
+    {
+        ClearSpeakerState(i);
+    }
+}
