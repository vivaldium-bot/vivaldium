+  if (WebRtcAec_GetDelayMetricsCore(self->aec, median, std,
+                                    fraction_poor_delays) == -1) {
+    // Logging disabled.
+    return AEC_UNSUPPORTED_FUNCTION_ERROR;
+  }
+
+  return 0;
+}
