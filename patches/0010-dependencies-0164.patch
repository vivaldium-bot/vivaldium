+; CHECK:   %fabs = call double @fabs(double %sqrt) nounwind readonly
+; CHECK:   %1 = fcmp oeq double %x, 0xFFF0000000000000
+; CHECK:   %retval = select i1 %1, double 0x7FF0000000000000, double %fabs
+; CHECK:   ret double %retval
+; CHECK: }
