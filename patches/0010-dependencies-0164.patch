+declare x86_fp80 @fabsl(x86_fp80 %f)
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/intervening-inst.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/intervening-inst.ll
new file mode 100644
index 0000000000000000000000000000000000000000..e1eb0d694fad6b863de3c2de790ffdb3396faafc
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/intervening-inst.ll
@@ -0,0 +1,17 @@
+; This function contains intervening instructions which should be moved out of the way
+; RUN: opt < %s -tailcallelim -S | not grep call
+
+define i32 @Test(i32 %X) {
+entry:
+	%tmp.1 = icmp eq i32 %X, 0		; <i1> [#uses=1]
+	br i1 %tmp.1, label %then.0, label %endif.0
+then.0:		; preds = %entry
+	%tmp.4 = add i32 %X, 1		; <i32> [#uses=1]
+	ret i32 %tmp.4
+endif.0:		; preds = %entry
+	%tmp.10 = add i32 %X, -1		; <i32> [#uses=1]
