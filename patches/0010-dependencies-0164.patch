+	call void @llvm.memcpy.i32( i8* %L2, i8* %tmp13, i32 2, i32 1 )
+	%tmp5 = load i8* %L2		; <i8> [#uses=1]
+	%tmp56 = sext i8 %tmp5 to i32		; <i32> [#uses=1]
+	ret i32 %tmp56
+}
