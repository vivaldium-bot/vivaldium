+      EXPECT_NEAR(apm_->noise_suppression()->speech_probability(),
+                  fapm->noise_suppression()->speech_probability(),
+                  0.01);
+
+      // Reset in case of downmixing.
+      frame_->num_channels_ = static_cast<size_t>(test->num_input_channels());
+    }
+    rewind(far_file_);
+    rewind(near_file_);
+  }
