index 0000000000000000000000000000000000000000..1c3ebe4abb5901ba7b44bf329b6087adc249f864
--- /dev/null
+++ b/third_party/webrtc/modules/audio_processing/echo_cancellation_impl.cc
@@ -0,0 +1,510 @@
+/*
