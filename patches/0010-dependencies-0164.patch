new file mode 100644
index 0000000000000000000000000000000000000000..571f35d184f4971dbd0b3a7bafdb452cee2f5b7c
--- /dev/null
+++ b/third_party/webrtc/modules/pacing/packet_router.cc
@@ -0,0 +1,134 @@
+/*
