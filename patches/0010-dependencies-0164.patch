index 0000000000000000000000000000000000000000..03e99bc9bf6aa11739ee8e717d2f3c973133bfbc
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailDup/2008-06-11-AvoidDupLoopHeader.ll
@@ -0,0 +1,27 @@
+; RUN: opt < %s -tailduplicate -taildup-threshold=3 -stats -disable-output |& not grep tailduplicate
+; XFAIL: *
+
+define i32 @foo(i32 %l) nounwind  {
+entry:
+	%cond = icmp eq i32 %l, 1		; <i1> [#uses=1]
+	br i1 %cond, label %bb, label %bb9
+
+bb:		; preds = %entry
+	br label %bb9
+
+bb5:		; preds = %bb9
+	%tmp7 = call i32 (...)* @bar( i32 %x.0 ) nounwind 		; <i32> [#uses=1]
