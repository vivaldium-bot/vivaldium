+	%tmp.2 = bitcast i32* %tmp.1 to i8*		; <i8*> [#uses=1]
+	%tmp.3 = getelementptr i8* %tmp.2, i32 3		; <i8*> [#uses=1]
+	%tmp.2.upgrd.1 = load i8* %tmp.3		; <i8> [#uses=1]
