+TEST_F(RtcpFormatRembTest, TestRembStatus) {
+  EXPECT_FALSE(rtcp_sender_->REMB());
+  rtcp_sender_->SetREMBStatus(true);
+  EXPECT_TRUE(rtcp_sender_->REMB());
+  rtcp_sender_->SetREMBStatus(false);
+  EXPECT_FALSE(rtcp_sender_->REMB());
