+	ret i32 %tmp2
+}
+
+define i32 @test_and(i32 %arg) {
+	%tmp1 = and i32 14, %arg		; <i32> [#uses=1]
+	%tmp2 = and i32 %tmp1, 14		; <i32> [#uses=1]
+	ret i32 %tmp2
+}
+
+define i32 @test_or(i32 %arg) {
+	%tmp1 = or i32 14, %arg		; <i32> [#uses=1]
+	%tmp2 = or i32 %tmp1, 14		; <i32> [#uses=1]
+	ret i32 %tmp2
