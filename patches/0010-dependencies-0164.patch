diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/TailDup/2008-06-11-AvoidDupLoopHeader.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailDup/2008-06-11-AvoidDupLoopHeader.ll
