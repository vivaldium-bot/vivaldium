diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/SPARC/2011-01-19-DelaySlot.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/SPARC/2011-01-19-DelaySlot.ll
