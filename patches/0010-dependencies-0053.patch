+        const sourceHist = histograms.createHistogram(
+            'source', tr.b.Unit.byName.count, [sample], {
+              binBoundaries: boundaries,
+              diagnostics: new Map([
+                [tr.v.d.RESERVED_NAMES.BENCHMARKS,
+                  new tr.v.d.GenericSet(['bench' + j])],
