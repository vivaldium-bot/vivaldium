+  unsigned char c = lsrc[0];
+  if (static_cast<signed char>(c) >= 0) {           // one byte
+    e = Tbl[c];
+    *src += 1;
+    *srclen -= 1;
+  } else if (((c & 0xe0) == 0xc0) && (*srclen >= 2)) {     // two bytes
+    e = Tbl[c];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[1]];
+    *src += 2;
+    *srclen -= 2;
+  } else if (((c & 0xf0) == 0xe0) && (*srclen >= 3)) {     // three bytes
+    e = Tbl[c];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[1]];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[2]];
+    *src += 3;
+    *srclen -= 3;
+  }else if (((c & 0xf8) == 0xf0) && (*srclen >= 4)) {     // four bytes
+    e = Tbl[c];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[1]];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[2]];
+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[3]];
+    *src += 4;
+    *srclen -= 4;
