index 0000000000000000000000000000000000000000..977abb6939f466537a0713dac7d6e0a69e85c20b
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/mpegaudiodsp_fixed_armv6.S
@@ -0,0 +1,143 @@
