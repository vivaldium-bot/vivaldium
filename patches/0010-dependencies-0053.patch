diff --git a/third_party/ffmpeg/doc/libavutil.texi b/third_party/ffmpeg/doc/libavutil.texi
new file mode 100644
index 0000000000000000000000000000000000000000..7a1c332b81743413d521ce35e0aadf569ac05f4a
--- /dev/null
