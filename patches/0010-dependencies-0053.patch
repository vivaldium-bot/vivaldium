+//   odd_byte=1                    [0+]    [3] [4]     [4]   [0]
+// 92   E28099 C3A2E282ACE284A2    C3->A2->E2->xx->xx->E2->xx->xx
+//   odd_byte=0                    [0]     [3]         [4] [0]   [0]
