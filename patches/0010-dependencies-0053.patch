+  const CHART_PADDING_RIGHT = 30;
+  const CHART_PADDING_BOTTOM = 35;
+  const CHART_PADDING_TOP = 20;
+  const AXIS_PADDING_LEFT = 55;
+  const AXIS_PADDING_RIGHT = 30;
+  const AXIS_PADDING_BOTTOM = 35;
