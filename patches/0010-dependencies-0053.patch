index 0000000000000000000000000000000000000000..34a5f61e1d0060beae46a3df7149be67ae539833
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/mlpdsp_init_arm.c
@@ -0,0 +1,146 @@
+/*
+ * Copyright (c) 2014 RISC OS Open Ltd
+ * Author: Ben Avison <bavison@riscosopen.org>
+ *
