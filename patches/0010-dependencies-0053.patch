index 0000000000000000000000000000000000000000..0426dc6f46e32b6729eb8e36ccd77bdbd04b09f5
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aarch64/dcadsp_neon.S
@@ -0,0 +1,109 @@
+/*
