+        typeNames: ['cc::Picture', 'cc::LayeredPicture'],
+        showInstances: false
+      });
+
+  return {
+    PictureSnapshotView,
+  };
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/ui/extras/chrome/cc/raster_task_selection.html b/third_party/catapult/tracing/tracing/ui/extras/chrome/cc/raster_task_selection.html
