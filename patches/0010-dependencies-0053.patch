+    if (have_neon(cpu_flags))
+        s->synth_filter_float = ff_synth_filter_float_neon;
+}
diff --git a/third_party/ffmpeg/libavcodec/arm/dcadsp_neon.S b/third_party/ffmpeg/libavcodec/arm/dcadsp_neon.S
