+
+static const uint8_t aic_c_ext_scan[192] = {
+     16,  24,  17,  18,  25,  32,  40,  33,
+     26,  19,  27,  34,  41,  42,  35,  43,
+      0,   4,   1,   2,   5,   8,  12,   9,
