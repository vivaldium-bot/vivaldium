+    const a = new tr.v.d.GenericSet([{a: 1, b: 2}]);
+    const b = new tr.v.d.GenericSet([{b: 2, a: 1}]);
+    const ab = a.clone();
+    assert.strictEqual(tr.b.getOnlyElement(a), tr.b.getOnlyElement(ab));
+    ab.addDiagnostic(b);
+    assert.lengthOf(ab, 1);
+    assert.strictEqual(tr.b.getOnlyElement(a), tr.b.getOnlyElement(ab));
+  });
+});
