--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ass.c
@@ -0,0 +1,225 @@
+/*
+ * SSA/ASS common functions
+ * Copyright (c) 2010  Aurelien Jacobs <aurel@gnuage.org>
+ *
