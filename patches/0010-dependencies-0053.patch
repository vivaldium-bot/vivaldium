index 0000000000000000000000000000000000000000..1fd199c972e8e5e43d2a22784a129dac72208ea3
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aarch64/mdct_neon.S
@@ -0,0 +1,323 @@
+/*
+ * AArch64 NEON optimised MDCT
+ * Copyright (c) 2009 Mans Rullgard <mans@mansr.com>
