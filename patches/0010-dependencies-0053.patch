--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aac.h
@@ -0,0 +1,372 @@
+/*
+ * AAC definitions and structures
+ * Copyright (c) 2005-2006 Oded Shimon ( ods15 ods15 dyndns org )
+ * Copyright (c) 2006-2007 Maxim Gavrilov ( maxim.gavrilov gmail com )
