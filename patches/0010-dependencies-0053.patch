index 0000000000000000000000000000000000000000..20a8f5a8574acb1fdca32a3d9c4dbece49dc6f87
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aacenc.c
@@ -0,0 +1,1056 @@
+/*
+ * AAC encoder
+ * Copyright (C) 2008 Konstantin Shishkov
+ *
