+        add             r7,  r2,  r12,  lsl #1
+        mov             r12, #-16
+        sub             r7,  r7,  #16
+
+        vld2.32         {d16-d17},[r7,:128],r12 @ d16=x,n1 d17=x,n0
+        vld2.32         {d0-d1},  [r2,:128]!    @ d0 =m0,x d1 =m1,x
+        vrev64.32       d17, d17
