diff --git a/third_party/ffmpeg/libavcodec/arm/cabac.h b/third_party/ffmpeg/libavcodec/arm/cabac.h
new file mode 100644
index 0000000000000000000000000000000000000000..fdbf86b45e741fc6a8bf4728cdf00b5fefe1e08c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/cabac.h
@@ -0,0 +1,108 @@
+/*
