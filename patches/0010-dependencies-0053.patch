+
+  addKeyDownHotKeys_() {
+    const addBinding = function(dict) {
+      dict.eventType = 'keydown';
+      dict.useCapture = false;
+      dict.thisArg = this;
+      const binding = new tr.ui.b.HotKey(dict);
+      this.$.hotkey_controller.addHotKey(binding);
