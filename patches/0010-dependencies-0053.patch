diff --git a/third_party/ffmpeg/libavcodec/aac_adtstoasc_bsf.c b/third_party/ffmpeg/libavcodec/aac_adtstoasc_bsf.c
new file mode 100644
index 0000000000000000000000000000000000000000..9c117c600549d82e05a21604f8a0dc0e34961168
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aac_adtstoasc_bsf.c
@@ -0,0 +1,123 @@
+/*
+ * MPEG-2/4 AAC ADTS to MPEG-4 Audio Specific Configuration bitstream filter
+ * Copyright (c) 2009 Alex Converse <alex.converse@gmail.com>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
