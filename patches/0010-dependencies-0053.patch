+		StatusCode: 200,
+		Header:     responseHeader,
+		Body:       ioutil.NopCloser(bytes.NewReader([]byte("<html></html>")))}
+	transformer.Transform(&req, &resp)
+	body, err := ioutil.ReadAll(resp.Body)
