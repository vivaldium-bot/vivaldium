index 0000000000000000000000000000000000000000..425040748c393c6f8fa17a01f466417cc7c5c7a7
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aacenc_quantization.h
@@ -0,0 +1,283 @@
+/*
+ * AAC encoder quantizer
+ * Copyright (C) 2015 Rostislav Pehlivanov
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
