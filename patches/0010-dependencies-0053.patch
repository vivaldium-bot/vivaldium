+        if (sel) {
+          this.brushingStateController.changeSelectionFromTimeline(sel);
+          this.panToSelection();
+        } else {
+          this.queueSmoothPan_(this.viewWidth_ * 0.3, 0);
+        }
+        e.preventDefault();
+        e.stopPropagation();
