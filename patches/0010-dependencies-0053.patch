+      CompactEncDet::QUERY_CORPUS, true, &bytes_consumed, &confidence);
+
+  if (FLAGS_enc_detect_detail) {
+    fprintf(stderr, "() end-detail\n\n");
+  }
+
+  EXPECT_EQ(UTF8, encoding);
