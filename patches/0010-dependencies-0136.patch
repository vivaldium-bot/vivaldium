index 0000000000000000000000000000000000000000..3434fde62926026b8a0d9bbf8aab07bebcd75c7f
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/loop_unroll.cpp
@@ -0,0 +1,253 @@
+/*
