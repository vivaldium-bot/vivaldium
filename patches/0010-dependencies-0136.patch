+linker_warning(gl_shader_program *prog, const char *fmt, ...)
+   PRINTFLIKE(2, 3);
diff --git a/third_party/mesa/src/src/glsl/ralloc.c b/third_party/mesa/src/src/glsl/ralloc.c
