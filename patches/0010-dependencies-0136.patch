+    for (int32_t i = 0 ; i < 64; i++) {
+      pInput[0][i] = WELS_CLIP3 (pInput[0][i], -4080, 4080);
+    }
+    memcpy ((uint8_t*)pInput[1], (uint8_t*)pInput[0], 128);
+
+    const int16_t* pMF = g_kiQuantMF[uiQp];
