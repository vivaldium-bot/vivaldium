+            # before we can get the peername, hence ENOTCONN (see issue
+            # #100) while EINVAL can occur on OSX (see issue #143).
+            self.connected = False
+            if err.args[0] in (errno.ENOTCONN, errno.EINVAL):
+                self.close()
+            else:
+                self.handle_error()
+            return
