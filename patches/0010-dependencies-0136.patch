index 0000000000000000000000000000000000000000..51d7d49d02a5e7cba9245295eba6aa26bc2bee7e
--- /dev/null
+++ b/third_party/opus/src/silk/fixed/solve_LS_FIX.c
@@ -0,0 +1,249 @@
+/***********************************************************************
