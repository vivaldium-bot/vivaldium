+void EraseOneInList (CWelsList<int>& cTestList, int* pPointer) {
+  int iPrevSize = cTestList.size();
+  EXPECT_TRUE (cTestList.erase (pPointer));
+  EXPECT_TRUE (cTestList.size() == (iPrevSize - 1));
+}
