+   if (!disp->Extensions.KHR_image_base)
+      RETURN_EGL_EVAL(disp, EGL_FALSE);
+   if (!img)
+      RETURN_EGL_ERROR(disp, EGL_BAD_PARAMETER, EGL_FALSE);
+
+   _eglUnlinkImage(img);
+   ret = drv->API.DestroyImageKHR(drv, disp, img);
+
+   RETURN_EGL_EVAL(disp, ret);
+}
