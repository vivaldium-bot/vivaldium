diff --git a/third_party/mesa/src/doxygen/Makefile b/third_party/mesa/src/doxygen/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..2bea0b3e920e3097c9428ab722bb3e8444c62b22
--- /dev/null
+++ b/third_party/mesa/src/doxygen/Makefile
@@ -0,0 +1,34 @@
+
+default: full
+
+all: full subset
+
+%.tag: %.doxy
+	doxygen $<
+
+FULL = \
+	main.doxy \
+	math.doxy \
+	vbo.doxy \
+	glapi.doxy \
+	glsl.doxy \
+	shader.doxy \
+	swrast.doxy \
+	swrast_setup.doxy \
+	tnl.doxy \
+	tnl_dd.doxy \
+	gbm.doxy
+
+full: $(FULL:.doxy=.tag)
+	$(foreach FILE,$(FULL),doxygen $(FILE);)
+
+SUBSET = \
+	main.doxy \
+	math.doxy
+
+subset: $(SUBSET:.doxy=.tag)
+	$(foreach FILE,$(SUBSET),doxygen $(FILE);)
+
+clean:
+	-rm -rf $(FULL:.doxy=) $(SUBSET:.doxy=)
+	-rm -rf *.tag
diff --git a/third_party/mesa/src/doxygen/README b/third_party/mesa/src/doxygen/README
new file mode 100644
index 0000000000000000000000000000000000000000..9b820041d1ba471f8a549e7dad161ebd9d9cf26b
