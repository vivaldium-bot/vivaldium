+  int32_t lambda[2] = {iLambda << 2, iLambda}; \
+  int32_t iPredMode = rand() % 3; \
+  if (ASM) {\
+    int32_t iCpuCores = 0; \
+    uint32_t m_uiCpuFeatureFlag = WelsCPUFeatureDetect (&iCpuCores); \
