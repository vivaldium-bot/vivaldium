+)
+
+# e_ident[EI_OSABI] in the ELF header
+ENUM_EI_OSABI = dict(
+    ELFOSABI_SYSV=0,
+    ELFOSABI_HPUX=1,
+    ELFOSABI_NETBSD=2,
