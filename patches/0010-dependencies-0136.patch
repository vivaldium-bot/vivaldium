+static void UpdateHashFromPlane (SHA1Context* ctx, const uint8_t* plane,
+                                 int width, int height, int stride) {
+  for (int i = 0; i < height; i++) {
+    SHA1Input (ctx, plane, width);
+    plane += stride;
+  }
+}
