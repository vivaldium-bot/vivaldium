+#-------------------------------------------------------------------------------
+# elftools: elf/enums.py
+#
+# Mappings of enum names to values
+#
+# Eli Bendersky (eliben@gmail.com)
+# This code is in the public domain
+#-------------------------------------------------------------------------------
+from ..construct import Pass
+
+
+# e_ident[EI_CLASS] in the ELF header
+ENUM_EI_CLASS = dict(
+    ELFCLASSNONE=0,
+    ELFCLASS32=1,
