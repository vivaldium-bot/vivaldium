+#define GENERATE_DATA_DEBLOCKING(pBase, pRef, iWidth) \
+if (iNum==0) { \
+  iAlpha = 255; \
+  iBeta = 18; \
+  iTc[0] = iTc[1] = iTc[2] = iTc[3] = 25; \
