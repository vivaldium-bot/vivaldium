+
+ private:
+  void DecodeFrame (const uint8_t* src, size_t sliceSize, Callback* cbk);
+
+  std::ifstream file_;
+  BufferedData buf_;
+  enum {
+    OpenFile,
+    Decoding,
+    EndOfStream,
+    End
+  } decodeStatus_;
+};
+
+#endif //__BASEDECODERTEST_H__
