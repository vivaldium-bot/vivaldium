+#define DEF_HALFPEL_MCTESTS(cpu_flags, name_suffix) \
+    DEF_HALFPEL_MCTEST( 4 , 4, cpu_flags, name_suffix) \
+    DEF_HALFPEL_MCTEST( 4,  8, cpu_flags, name_suffix) \
+    DEF_HALFPEL_MCTEST( 8,  4, cpu_flags, name_suffix) \
