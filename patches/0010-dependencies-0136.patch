+    sha512 = hashlib.sha512
+    md5 = hashlib.md5
+except ImportError:
+    try:
+        import sha
+        sha1 = sha.new
+    except ImportError:
+        pass
+    try:
+        import md5
+        md5 = md5.new
+    except ImportError:
+        pass
+
+try:
+    enumerate
+except NameError:
+    def enumerate(iter):
+        L = list(iter)
+        return zip(range(0, len(L)), L)
+
+def is_bytearray_available():
+    if isinstance(__builtins__, dict):
+        return ('bytearray' in __builtins__)
+    return ('bytearray' in __builtins__.__dict__)
