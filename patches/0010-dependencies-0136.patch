index 0000000000000000000000000000000000000000..e803ef0fceb04b3ca15264cb3a5edd8e971887b9
--- /dev/null
+++ b/third_party/opus/src/silk/fixed/mips/warped_autocorrelation_FIX_mipsr1.h
@@ -0,0 +1,165 @@
