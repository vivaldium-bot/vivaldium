+void CSliceBufferReallocatTest::UnInitParamForTestCase (int32_t iLayerIdx) {
+  int32_t iRet = m_pEncoder->Uninitialize();
+  ASSERT_TRUE (cmResultSuccess == iRet);
+
+  UnInitFrameBsBuffer();
+  UnInitLayerSliceBuffer (iLayerIdx);
+  UnInitParam();
+}
