index 0000000000000000000000000000000000000000..b8440a8247a31ce4cf768f6f148dd4a9e75f3533
--- /dev/null
+++ b/third_party/opus/src/silk/fixed/find_pitch_lags_FIX.c
@@ -0,0 +1,145 @@
+/***********************************************************************
