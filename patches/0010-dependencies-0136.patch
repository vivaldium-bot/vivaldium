+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_pstipple.c
@@ -0,0 +1,817 @@
+/**************************************************************************
+ * 
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
