index 0000000000000000000000000000000000000000..a371afc14c2385ea387bf6764db1e2a1177594d9
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/lower_mat_op_to_vec.cpp
@@ -0,0 +1,428 @@
+/*
