index 0000000000000000000000000000000000000000..1fa1ea379bdd8a4979e6f19dd74ab9af69942cec
--- /dev/null
+++ b/third_party/opus/src/silk/NLSF_stabilize.c
@@ -0,0 +1,142 @@
