+class TestFtpRetrieveData(unittest.TestCase):
+    "Test RETR, REST, TYPE"
+    server_class = FTPd
+    client_class = ftplib.FTP
+
+    def setUp(self):
+        self.server = self.server_class()
+        self.server.start()
