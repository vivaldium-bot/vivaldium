index 0000000000000000000000000000000000000000..98da9cfb999c8dd25abe484c19735c1716ba3082
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_wide_line.c
@@ -0,0 +1,228 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
