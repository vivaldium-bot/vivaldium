index 0000000000000000000000000000000000000000..d80167cf30978a2cd596ca4e62d8f7c8b8e80361
--- /dev/null
+++ b/third_party/openmax_dl/dl/sp/src/test/aligned_ptr.c
@@ -0,0 +1,32 @@
+/*
