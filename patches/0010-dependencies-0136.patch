+};
+
+const char *tgsi_fs_coord_origin_names[2] =
+{
+   "UPPER_LEFT",
+   "LOWER_LEFT"
+};
+
+const char *tgsi_fs_coord_pixel_center_names[2] =
+{
+   "HALF_INTEGER",
+   "INTEGER"
+};
