+        case gl.R32UI: return 'gl.R32UI';
+        // case gl.R16: return 'gl.R16';
+        // case gl.R16_SNORM: return 'gl.R16_SNORM';
+        case gl.R16F: return 'gl.R16F';
+        case gl.R16I: return 'gl.R16I';
