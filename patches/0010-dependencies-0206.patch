+case texture2d_bias_in_vertex
+	expect compile_fail
+	values {}
+
+	vertex ""
+		${VERTEX_DECLARATIONS}
+		uniform lowp sampler2D s;
+
+		void main()
+		{
+			vec4 r = texture2D(s, vec2(1.0), 1.0);
+			${VERTEX_OUTPUT}
+		}
+	""
+	fragment ""
+		void main()
+		{
+			gl_FragColor = vec4(1.0);
+		}
+	""
+end
+
+case texturecube_bias_in_vertex
+	expect compile_fail
+	values {}
+
+	vertex ""
+		${VERTEX_DECLARATIONS}
+		uniform lowp samplerCube s;
+
+		void main()
+		{
+			vec4 r = textureCube(s, vec3(1.0), 1.0);
+			${VERTEX_OUTPUT}
+		}
+	""
+	fragment ""
