+    /**
+    * @param {tcuTexture.ConstPixelBufferAccess} level0
+    * @param {tcuTexture.ConstPixelBufferAccess} level1
+    * @param {tcuTexture.Sampler} sampler
+    * @param {tcuTexLookupVerifier.LookupPrecision} prec
