+		vertex ""
+			void main()
+			{
+				gl_Position = vec4(1.0);
+			}
+		""
+		fragment ""
+			attribute mediump float val;
+			void main()
+			{
+				gl_FragColor = vec4(1.0);
+			}
+		""
+	end
