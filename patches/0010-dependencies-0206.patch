+    var pixelSize = this.m_format.getPixelSize();
+    var offset = z * this.m_slicePitch + y * this.m_rowPitch + x * pixelSize;
+    var pixelPtr = this.getDataPtr();
+    var pixelPtrOffset = offset / pixelPtr.BYTES_PER_ELEMENT;
