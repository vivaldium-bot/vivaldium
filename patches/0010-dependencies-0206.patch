+            str += gluVarType.getInterpolationName(this.interpolation) + ' ';
+
+        if (typeof this.storage !== 'undefined')
+            str += gluVarType.getStorageName(this.storage) + ' ';
+
+        str += gluVarType.declareVariable(this.varType, this.name);
+
+        return str;
+    };
+
+});
