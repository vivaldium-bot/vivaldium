+        for (var bitNdx = 0; (1 << bitNdx) & gluVarType.MemoryAccessQualifier.MEMORYACCESSQUALIFIER_MASK; ++bitNdx)
+            if (this.memoryAccessQualifierBits & (1 << bitNdx))
+                str += gluVarType.getMemoryAccessQualifierName((1 << bitNdx)) + ' ';
