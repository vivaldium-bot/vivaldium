+    numChannels = numChannels || 4;
+    var offset = y * this.stride + x * this.pixelSize;
+    /* Always return a vec4 */
+    var result = [0, 0, 0, 255];
+    for (var i = 0; i < numChannels; i++)
+        result[i] = this.data[offset + i];
+    return result;
+};
+
+/**
+ * Read a pixel into a Uint32
+ * @param {number} x
+ * @param {number} y
+ * @return {number}
+ */
