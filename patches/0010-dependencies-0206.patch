+
+//     if (format.order == tcuTexture.ChannelOrder.D || format.order == tcuTexture.ChannelOrder.DS)
+//         return TYPE_SAMPLER_1D;
+
+//     if (format.order == tcuTexture.ChannelOrder.S)
+//         return TYPE_LAST;
+
