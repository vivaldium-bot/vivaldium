diff --git a/third_party/webgl/src/sdk/tests/deqp/framework/referencerenderer/rrMultisamplePixelBufferAccess.js b/third_party/webgl/src/sdk/tests/deqp/framework/referencerenderer/rrMultisamplePixelBufferAccess.js
