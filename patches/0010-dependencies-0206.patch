+				}
+			""
+		end
+
+		case light_struct_highp
+			version 300 es
+			desc "Complex Light struct from use case tests."
+			values {
+				uniform float val.constantAttenuation = 1.0;
+				uniform float val.quadraticAttenuation = 1.0;
+				output float out0 = 2.0;
+			}
+			vertex ""
+				#version 300 es
+				struct Light
+				{
+					mediump vec3	color;
