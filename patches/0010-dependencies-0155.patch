+//
+// Create loop nodes.
+//
+TIntermNode* TIntermediate::addLoop(TLoopType type, TIntermNode* init, TIntermTyped* cond, TIntermTyped* expr, TIntermNode* body, const TSourceLoc &line)
+{
+	TIntermNode* node = new TIntermLoop(type, init, cond, expr, body);
+	node->setLine(line);
+
+	return node;
+}
