+  }
+  if (voe_dtmf_) {
+    voe_dtmf_->Release();
+    voe_dtmf_ = NULL;
+  }
+  if (voe_rtp_rtcp_) {
+    voe_rtp_rtcp_->Release();
+    voe_rtp_rtcp_ = NULL;
+  }
+  if (voe_apm_) {
+    voe_apm_->Release();
