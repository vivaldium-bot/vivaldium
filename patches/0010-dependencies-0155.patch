+void TransmitMixer::PlayFileEnded(int32_t id)
+{
+    WEBRTC_TRACE(kTraceStream, kTraceVoice, VoEId(_instanceId, -1),
+                 "TransmitMixer::PlayFileEnded(id=%d)", id);
