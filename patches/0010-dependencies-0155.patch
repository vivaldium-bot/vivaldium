+MINIMAL_SHADER = '#version 140\nvoid main() {}'
+EMPTY_SHADER_IN_CURDIR = Directory('.', [File('shader.vert', MINIMAL_SHADER)])
+EMPTY_SHADER_IN_SUBDIR = Directory('subdir',
+                                   [File('shader.vert', MINIMAL_SHADER)])
