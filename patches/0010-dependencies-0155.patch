+                }
+                firstPtSet = lastPtSet = false;
+                break;
+            default:
+                SkDEBUGFAIL("bad verb");
+                return;
+        }
+    }
+    if (firstPtSet && lastPtSet && firstPt != lastPt) {
+        SkDebugf("{{%1.9g,%1.9g}, {%1.9g,%1.9g}},\n", lastPt.fX, lastPt.fY,
+                firstPt.fX, firstPt.fY);
+    }
+}
