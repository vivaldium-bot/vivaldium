+  webrtc::VoEFile*            voe_file_;
+  webrtc::VoEVideoSync*       voe_vsync_;
+  webrtc::VoEHardware*        voe_hardware_;
+  webrtc::VoEExternalMedia*   voe_xmedia_;
+  webrtc::VoENetEqStats*      voe_neteq_stats_;
+  webrtc::Config              config_;
+};
