+    if (count >= 8) {
+        // Load 8 pixels.
+        uint8x8x4_t rgba = vld4_u8((const uint8_t*) src);
+
+        // Swap r and b.
+        SkTSwap(rgba.val[0], rgba.val[2]);
+
+        // Store 8 pixels.
+        vst4_u8((uint8_t*) dst, rgba);
