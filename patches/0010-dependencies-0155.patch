+         "            break;\n"
+         "        case 1:\n"
+         "            x = 1.0;\n"
+         "            break;\n"
+         "        default:\n"
+         "            x = 2.0;\n"
+         "    }\n"
+         "    sk_FragColor = vec4(x);\n"
+         "}\n");
+    // dead code inside of switch
+    test(r,
+         "void main() {"
+         "    float x;"
+         "    switch (int(sqrt(2))) {"
+         "        case 0:"
+         "            x = 0.0;"
+         "        case 1:"
