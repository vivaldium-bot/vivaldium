+    }
+}
+
+DEF_TEST(PathOpsSimplifyRectsThreaded, reporter) {
+    initializeTests(reporter, "testLine");
+    PathOpsThreadedTestRunner testRunner(reporter);
+    for (int a = 0; a < 8; ++a) {  // outermost
+        for (int b = a ; b < 8; ++b) {
+            for (int c = b ; c < 8; ++c) {
+                for (int d = c; d < 8; ++d) {
