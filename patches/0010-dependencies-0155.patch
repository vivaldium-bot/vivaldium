+class CirclesBench : public Benchmark {
+protected:
+    SkString            fName;
+    Flags               fFlags;
+
+public:
+    CirclesBench(Flags flags) : fFlags(flags) {
+        fName.printf("circles_%s", fFlags & kStroke_Flag ? "stroke" : "fill");
+    }
