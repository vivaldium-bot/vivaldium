+    Json::Value toJSON(UrlDataManager& urlDataManager) const override;
+    static SkSaveLayerCommand* fromJSON(Json::Value& command, UrlDataManager& urlDataManager);
+    void vizExecute(SkCanvas* canvas) const override;
