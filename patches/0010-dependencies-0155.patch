+
+		return Direct3DBaseTexture9::GetLevelCount();
+	}
+
+	unsigned long Direct3DCubeTexture9::GetLOD()
+	{
+		CriticalSection cs(device);
+
+		TRACE("");
+
+		return Direct3DBaseTexture9::GetLOD();
+	}
