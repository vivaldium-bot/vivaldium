diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/ARM/MCTargetDesc/ARMAddressingModes.h b/third_party/swiftshader/third_party/LLVM/lib/Target/ARM/MCTargetDesc/ARMAddressingModes.h
