+ */
+public class SmallGlyphMetrics extends GlyphMetrics {
+
+  static enum Offset {
+    metricsLength(5), height(0), width(1), BearingX(2), BearingY(3), Advance(4);
+
+    final int offset;
+
+    private Offset(int offset) {
+      this.offset = offset;
+    }
+  }
+  
+  private SmallGlyphMetrics(ReadableFontData data) {
