diff --git a/third_party/skia/tests/PathOpsQuadLineIntersectionTest.cpp b/third_party/skia/tests/PathOpsQuadLineIntersectionTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6a9e497b9118abc5960382a302bb5ccaa238a7d4
--- /dev/null
