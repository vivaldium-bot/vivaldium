+
+    public Builder() {
+      super();
+    }
+
+    @Override
+    protected void initFields() {
+      setField(COVERAGE_INDEX, COVERAGE_DEFAULT);
+      setField(DELTA_GLYPH_ID_INDEX, DELTA_GLYPH_ID_DEFAULT);
+    }
+
+    @Override
+    protected int fieldCount() {
+      return FIELD_COUNT;
+    }
