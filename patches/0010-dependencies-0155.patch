+  void TearDown() {
+    EXPECT_EQ(0, voe_network_->DeRegisterExternalTransport(second_channel_));
+    voe_base_->DeleteChannel(second_channel_);
+    delete transport_;
+  }
+
+  int second_channel_;
+  LoopBackTransport* transport_;
+};
