+#ifndef COMPILER_PREPROCESSOR_TOKEN_H_
+#define COMPILER_PREPROCESSOR_TOKEN_H_
+
+#include <ostream>
+#include <string>
+
+#include "SourceLocation.h"
+
+namespace pp
+{
+
+struct Token
+{
+	enum Type
+	{
+		LAST = 0,  // EOF.
+
+		IDENTIFIER = 258,
+
+		CONST_INT,
+		CONST_FLOAT,
