--- /dev/null
+++ b/third_party/skia/third_party/libsdl/sdl.gypi
@@ -0,0 +1,50 @@
+# Copyright 2015 Google Inc.
+#
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+{
+  'targets': [
+    {
+      'target_name': 'sdl',
+      'product_name': 'sdl',
+      'type': 'static_library',
+      'include_dirs': [
+        '<(base_dir)/<(skia_os)',
+        '<(src_dir)/include',
+      ],
+      'direct_dependent_settings': {
+        'include_dirs': [
+          '<(src_dir)/include',
+          '<(src_dir)/src',
+        ]
+      },
+      'cflags': [
+        '-g',
+        '-w',
+      ],
+      'conditions': [
+        ['skia_os == "linux"', {
+          'includes': [
+            'linux/sdl_linux.gypi',
+          ]
+        }],
+        ['skia_os == "android"', {
+          'includes': [
+            'android/sdl_android.gypi',
+          ]
+        }],
+        ['skia_os == "mac"', {
+          'includes': [
+            'mac/sdl_mac.gypi',
+          ]
+        }],
+        ['skia_os == "win"', {
+          'includes': [
+            'win/sdl_win.gypi',
+          ]
+        }],
+      ],
+    },
+  ],
+}
diff --git a/third_party/skia/third_party/libsdl/win/README b/third_party/skia/third_party/libsdl/win/README
