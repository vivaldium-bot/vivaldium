+static void DumpID(int id) {
+    SkDebugf("} ");
+    if (id >= 0) {
+        SkDebugf("id=%d", id);
+    }
+    SkDebugf("\n");
+}
+
+void SkDConic::dump() const {
+    dumpInner();
+    SkDebugf("},\n");
+}
