+        } while (last.asSkPoint() != quad[1].asSkPoint());
+        float p1 = SkDoubleToScalar(line[1].fX * last.fY);
+        float p2 = SkDoubleToScalar(line[1].fY * last.fX);
+        int p1Bits = SkFloatAs2sCompliment(p1);
