+	long Direct3DDevice8::DeleteVertexShader(unsigned long handle)
+	{
+		TRACE("");
+
+		unsigned int index = handle >> 16;
+
+		if(index >= vertexShader.size() || !vertexShader[index])
+		{
+			return INVALIDCALL();
+		}
+
+		vertexShader[index]->Release();
+		vertexShader[index] = 0;
+
+		return D3D_OK;
+	}
