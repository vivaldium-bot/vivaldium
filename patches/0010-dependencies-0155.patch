+        fM0.setDouble(0, 1, 2.1);
+        fM0.setDouble(0, 2, -3.1);
+        fM0.setDouble(0, 3, 4.1);
+        fM0.setDouble(1, 0, 5.1);
+        fM0.setDouble(1, 1, -6.1);
+        fM0.setDouble(1, 2, 7.1);
+        fM0.setDouble(1, 3, 8.1);
+        fM0.setDouble(2, 0, -9.1);
