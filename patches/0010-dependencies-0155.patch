+			vertexShader->Release();
+		}
+
+		device->GetVertexShaderConstantF(0, vertexShaderConstantF[0], MAX_VERTEX_SHADER_CONST);
+		device->GetVertexShaderConstantI(0, vertexShaderConstantI[0], 16);
