+	}
+
+	unsigned long Direct3DCubeTexture8::GetPriority()
+	{
+		TRACE("");
+
+		return Direct3DBaseTexture8::GetPriority();
+	}
+
+	D3DRESOURCETYPE Direct3DCubeTexture8::GetType()
+	{
+		TRACE("");
+
+		return Direct3DBaseTexture8::GetType();
+	}
