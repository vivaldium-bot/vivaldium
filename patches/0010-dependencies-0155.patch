+  // Dump routines
+  private static Set<Integer> codepointsFromStr(String s) {
+    Set<Integer> list = new HashSet<Integer>();
+    for (int cp, i = 0; i < s.length(); i += Character.charCount(cp)) {
+      cp = s.codePointAt(i);
+      list.add(cp);
+    }
+    return list;
+  }
