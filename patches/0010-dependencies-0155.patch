new file mode 100644
index 0000000000000000000000000000000000000000..40e227114df6f8df164b88c06fa8064f42d9f52a
--- /dev/null
+++ b/third_party/skia/src/shaders/gradients/SkLinearGradient.cpp
@@ -0,0 +1,222 @@
+/*
