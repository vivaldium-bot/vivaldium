+TEST_P(OpSelectionMergeTest, AnySingleSelectionControlMask) {
+  const std::string input = "OpSelectionMerge %1 " + GetParam().name();
+  EXPECT_THAT(
+      CompiledInstructions(input),
+      Eq(MakeInstruction(SpvOpSelectionMerge, {1, GetParam().value()})));
+}
