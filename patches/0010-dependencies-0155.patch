+BlackfinInstrInfo::BlackfinInstrInfo(BlackfinSubtarget &ST)
+  : BlackfinGenInstrInfo(BF::ADJCALLSTACKDOWN, BF::ADJCALLSTACKUP),
+    RI(ST, *this),
+    Subtarget(ST) {}
