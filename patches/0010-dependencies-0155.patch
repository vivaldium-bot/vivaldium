+	long Direct3DStateBlock8::GetDevice(IDirect3DDevice8 **device)
+	{
+		TRACE("");
+
+		if(!device)
+		{
+			return INVALIDCALL();
+		}
+
+		this->device->AddRef();
+		*device = this->device;
+
+		return D3D_OK;
+	}
