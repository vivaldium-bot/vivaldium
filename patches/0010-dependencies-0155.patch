+void SkPDFObjNumMap::addObjectRecursively(SkPDFObject* obj) {
+    if (obj && !fObjectNumbers.find(obj)) {
+        fObjectNumbers.set(obj, fObjectNumbers.count() + 1);
+        fObjects.emplace_back(sk_ref_sp(obj));
+        obj->addResources(this);
+    }
+}
