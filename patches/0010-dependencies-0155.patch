+    REPORTER_ASSERT(reporter, configs[1]->asConfigGpu());
+    REPORTER_ASSERT(reporter, !configs[2]->asConfigGpu());
+    REPORTER_ASSERT(reporter, !configs[3]->asConfigGpu());
+#endif
+}
