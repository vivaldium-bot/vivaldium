+                cubic1[3].fX, cubic1[3].fY,
+                cubic2[0].fX, cubic2[0].fY,  cubic2[1].fX, cubic2[1].fY, cubic2[2].fX, cubic2[2].fY,
+                cubic2[3].fX, cubic2[3].fY);
+    #endif
+        SkDRect rect1, rect2;
+        SkDCubic c1, c2;
+        c1.debugSet(cubic1.fPts);
+        c2.debugSet(cubic2.fPts);
+        rect1.setBounds(c1);
