+
+template <>
+class SkNx<8, uint16_t> {
+public:
+    AI SkNx(const uint16x8_t& vec) : fVec(vec) {}
+
+    AI SkNx() {}
+    AI SkNx(uint16_t val) : fVec(vdupq_n_u16(val)) {}
