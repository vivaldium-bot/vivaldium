+defm BF561 : CoreTeton<"bf561">;
+
+//===----------------------------------------------------------------------===//
+// Declare the target which we are implementing
+//===----------------------------------------------------------------------===//
+
+def Blackfin : Target {
+  // Pull in Instruction Info:
+  let InstructionSet = BlackfinInstrInfo;
+}
diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/Blackfin/BlackfinAsmPrinter.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/Blackfin/BlackfinAsmPrinter.cpp
