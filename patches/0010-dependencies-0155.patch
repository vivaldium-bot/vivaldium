+    void init(GrContext*, sk_sp<GrDrawContext>);
+
+    GrResourceProvider* resourceProvider() { return fContext->resourceProvider(); }
+
+private:
+    SkAutoTUnref<GrContext>                 fContext;
+    sk_sp<GrDrawContext>                    fDrawContext;
+};
+
+#endif
