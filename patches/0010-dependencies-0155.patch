+		TRACE("unsigned int level = %d, D3DLOCKED_RECT *lockedRect = 0x%0.8p, const RECT *rect = 0x%0.8p, unsigned long flags = %d", level, lockedRect, rect, flags);
+
+		if(!lockedRect || level >= GetLevelCount() || !surfaceLevel[level])
+		{
+			return INVALIDCALL();
+		}
