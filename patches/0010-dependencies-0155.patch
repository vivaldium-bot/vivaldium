+static void test_peephole() {
+    SkRandom rand;
+
+    SkPictureRecorder recorder;
+
+    for (int j = 0; j < 100; j++) {
+        SkRandom rand2(rand); // remember the seed
+
+        SkCanvas* canvas = recorder.beginRecording(100, 100);
