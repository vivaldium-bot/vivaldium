+					renderer->setStageOperation(stage, sw::TextureStage::STAGE_LERP);
+					break;
+				default:
+					ASSERT(false);
+				}
+				break;
+			case D3DTSS_COLORARG1:
+				switch(value & D3DTA_SELECTMASK)
+				{
+				case D3DTA_DIFFUSE:
+					renderer->setFirstArgument(stage, sw::TextureStage::SOURCE_DIFFUSE);
