+    }
+  } else {
+    source_set(target_name) {
+      forward_variables_from(invoker,
+                             "*",
+                             [
+                               "public_defines",
+                               "deps",
+                               "libs",
+                               "sources",
+                               "sources_when_disabled",
+                               "configs_to_remove",
+                             ])
