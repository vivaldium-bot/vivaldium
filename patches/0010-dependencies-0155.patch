+func loadJson(flag *string, defaultFlag string, val interface{}) {
+	if *flag == "" {
+		*flag = defaultFlag
+	}
+	b, err := ioutil.ReadFile(*flag)
+	if err != nil {
+		glog.Fatal(err)
+	}
+	if err := json.Unmarshal(b, val); err != nil {
+		glog.Fatal(err)
+	}
+}
