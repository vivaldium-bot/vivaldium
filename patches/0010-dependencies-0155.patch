+        const SkScalar dy = SK_Scalar1 * 10;
+
+        path->moveTo(x, y);
+        for (int i = 0; i < 32; i++) {
+            x += dx;
+            path->lineTo(x, y - dy);
+            x += dx;
+            path->lineTo(x, y + dy);
+        }
+        path->lineTo(x, y + 2 * dy);
+        path->lineTo(x0, y + 2 * dy);
+        path->close();
+    }
