+  if (!_shared->audio_device()->Recording()) {
+    if (_shared->audio_device()->InitRecording() != 0) {
+      WEBRTC_TRACE(kTraceError, kTraceVoice, VoEId(_shared->instance_id(), -1),
+                   "StartRecordingMicrophone() failed to initialize recording");
+      return -1;
