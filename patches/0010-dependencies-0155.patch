+    'Test-Android-GCC-Nexus9-GPU-TegraK1-Arm64-Debug',
+    'Test-Android-GCC-NexusPlayer-CPU-SSSE3-x86-Release',
+    'Test-Android-GCC-NVIDIA_Shield-GPU-TegraX1-Arm64-Release',
