+            float xs[3] = { prev(pt.fX), pt.fX, next(pt.fX) };
+            float ys[3] = { prev(pt.fY), pt.fY, next(pt.fY) };
+            for (int xIdx = 0; xIdx < 3; ++xIdx) {
