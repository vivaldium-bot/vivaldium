+                                 &psnr_result_, &ssim_result_));
+  EXPECT_EQ(kEmptyFileReturnCode,
+              I420MetricsFromFiles(video_file_.c_str(), empty_file_.c_str(),
+                                   kWidth, kHeight,
+                                   &psnr_result_, &ssim_result_));
+}
