+struct LibX11exports
+{
+	LibX11exports(void *libX11, void *libXext);
+
+	Display *(*XOpenDisplay)(char *display_name);
+	Status (*XGetWindowAttributes)(Display *display, Window w, XWindowAttributes *window_attributes_return);
