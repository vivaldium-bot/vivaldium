diff --git a/third_party/webrtc/voice_engine/statistics.cc b/third_party/webrtc/voice_engine/statistics.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3787e671224faaaa05b199163fb1fce2a9b9ac53
--- /dev/null
