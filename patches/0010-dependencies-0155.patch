+#endif // #ifndef WEBRTC_VOICE_ENGINE_DTMF_INBAND_H_
diff --git a/third_party/webrtc/voice_engine/dtmf_inband_queue.cc b/third_party/webrtc/voice_engine/dtmf_inband_queue.cc
