+		if(!description || level >= GetLevelCount() || !volumeLevel[level])
+		{
+			return INVALIDCALL();
+		}
+
+		volumeLevel[level]->GetDesc(description);
+
+		return D3D_OK;
+	}
+
+	Direct3DVolume8 *Direct3DVolumeTexture8::getInternalVolumeLevel(unsigned int level)
+	{
+		return volumeLevel[level];
+	}
+}
