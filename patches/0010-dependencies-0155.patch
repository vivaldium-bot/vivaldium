+
+namespace webrtc {
+
+class VideoFrame;
+
+class VideoRenderer {
+ public:
+  // This function should return as soon as possible and not block until it's
+  // time to render the frame.
+  // TODO(mflodman) Remove time_to_render_ms when VideoFrame contains NTP.
