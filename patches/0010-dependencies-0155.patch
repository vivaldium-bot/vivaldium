+	long Direct3DDevice9::GetClipPlane(unsigned long index, float *plane)
+	{
+		CriticalSection cs(this);
+
+		TRACE("unsigned long index = %d, float *plane = 0x%0.8p", index, plane);
+
+		if(!plane || index >= 6)
+		{
+			return INVALIDCALL();
+		}
+
