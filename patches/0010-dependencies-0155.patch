diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/Mips/MipsMCSymbolRefExpr.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/Mips/MipsMCSymbolRefExpr.cpp
