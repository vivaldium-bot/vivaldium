+{
+	// See Blink::Source/platform/graphics/gpu/WebGLImageConversion.cpp::convertFloatToHalfFloat() and http://crbug.com/491784
+
+	unsigned temp = *((unsigned *)(&f));
+	unsigned signexp = (temp >> 23) & 0x1ff;
