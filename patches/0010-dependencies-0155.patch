+    fTextOut = true;
+    TextParser::Save save(this);
+    if (!parseFiddles()) {
+        return false;
+    }
+    this->lf(1);
+    this->writeString("}");
+    this->lf(2);
+    this->writeString("var pngs = {");
+    fTextOut = false;
+    fPngOut = true;
+    save.restore();
+    fContinuation = false;
+    return parseFiddles();
+}
+
+bool Catalog::pngOut(Definition* example) {
+    string result;
+    if (!example->exampleToScript(&result, Definition::ExampleOptions::kPng)) {
+        return false;
+    }
+    if (result.length() > 0) {
+        if (fContinuation) {
+            this->writeString(",");
+            this->lf(1);
+        } else {
+            fContinuation = true;
+        }
+        this->writeBlock(result.size(), result.c_str());
+    }
+    return true;
+}
+
+bool Catalog::textOut(Definition* example, const char* stdOutStart,
+    const char* stdOutEnd) {
+    string result;
+    if (!example->exampleToScript(&result, Definition::ExampleOptions::kText)) {
+        return false;
+    }
+    if (result.length() > 0) {
+        if (fContinuation) {
+            this->writeString(",");
+            this->lf(1);
+        } else {
+            fContinuation = true;
+        }
+        fIndent = 8;
+        this->writeBlock(result.size(), result.c_str());
+        this->lf(1);
+        this->writeString("\"stdout\": \"");
+        size_t pos = 0;
+        size_t len = stdOutEnd - stdOutStart;
+        string example;
+        while ((size_t) pos < len) {
+            example += '"' == stdOutStart[pos] ? "\\\"" :
+                '\\' == stdOutStart[pos] ? "\\\\" :
+                string(&stdOutStart[pos], 1);
+            ++pos;
+        }
+        this->writeBlock(example.length(), example.c_str());
+        this->writeString("\"");
+        this->lf(1);
+        fIndent = 4;
+        this->writeString("}");
+    }
+    return true;
+}
