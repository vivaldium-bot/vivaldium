+
+class ColorFilterBlueBench : public ColorFilterBaseBench {
+
+public:
+    ColorFilterBlueBench(bool small) : INHERITED(small) { }
+
+protected:
+    const char* onGetName() override {
+        return this->isSmall() ? "colorfilter_blue_small" : "colorfilter_blue_large";
