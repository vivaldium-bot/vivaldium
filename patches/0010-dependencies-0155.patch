+	long Direct3D9Ex::QueryInterface(const IID &iid, void **object)
+	{
+		TRACE("const IID &iid = 0x%0.8p, void **object = 0x%0.8p", iid, object);
+
+		if(iid == IID_IDirect3D9Ex ||
+		   iid == IID_IDirect3D9 ||
+		   iid == IID_IUnknown)
+		{
+			AddRef();
+			*object = this;
+
+			return S_OK;
+		}
+
+		*object = 0;
+
+		return NOINTERFACE(iid);
+	}
