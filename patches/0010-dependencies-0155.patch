+
+			SetSamplerState(i, D3DSAMP_ADDRESSU, D3DTADDRESS_WRAP);
+			SetSamplerState(i, D3DSAMP_ADDRESSV, D3DTADDRESS_WRAP);
+			SetSamplerState(i, D3DSAMP_ADDRESSW, D3DTADDRESS_WRAP);
