+	long Direct3DDevice8::SetPaletteEntries(unsigned int paletteNumber, const PALETTEENTRY *entries)
+	{
+		TRACE("");
+
+		if(paletteNumber > 0xFFFF || !entries)
+		{
+			return INVALIDCALL();
+		}
+
+		for(int i = 0; i < 256; i++)
+		{
+			palette[paletteNumber].entry[i] = entries[i];
+		}
+
+		if(paletteNumber == currentPalette)
