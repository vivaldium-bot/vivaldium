diff --git a/third_party/webrtc/test/mac/run_test.mm b/third_party/webrtc/test/mac/run_test.mm
new file mode 100644
index 0000000000000000000000000000000000000000..4e0093a9b6e40f6c13b52ede10e0bdd0cc100bd7
--- /dev/null
