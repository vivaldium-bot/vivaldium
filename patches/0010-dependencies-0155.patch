+   public:
+    CNameObserver() : SendTest(kDefaultTimeoutMs) {}
+
+   private:
+    Action OnSendRtcp(const uint8_t* packet, size_t length) override {
+      RTCPUtility::RTCPParserV2 parser(packet, length, true);
