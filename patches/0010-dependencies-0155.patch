+static void coincidentTest(skiatest::Reporter* reporter) {
+    for (int testIndex = 0; testIndex < coincidentTestSetCount - 1; testIndex += 2) {
+        coincidentTestOne(reporter, testIndex, testIndex + 1);
+    }
+}
