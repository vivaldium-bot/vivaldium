+
+        // Missing SOF segment.
+        data = SkData::MakeWithoutCopy(goodJpeg, 89);
+        REPORTER_ASSERT(r, !SkIsJFIF(data.get(), &info));
+    }
+    {
+        // JFIF tag missing.
+        static const char jpeg[] =
+            "\377\330\377\340\0\20JFIX\0\1\1\0\0\1\0\1\0\0\377\333\0C\0\10\6\6\7"
