+#define TRY(expr)                                      \
+  do {                                                 \
+    if (!(expr)) {                                     \
+      DEBUG_LOG1("FAIL at " __FILE__ ":%d", __LINE__); \
+      return false;                                    \
+    }                                                  \
+  } while (0)
