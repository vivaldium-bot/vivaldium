+	}
+#else
+	#define NOTAVAILABLE() D3DERR_NOTAVAILABLE
+#endif
+
+#ifndef NDEBUG
+	inline long NOTFOUND()
+	{
+		trace("\t! D3DERR_NOTFOUND\n");
+
+		return D3DERR_NOTFOUND;
+	}
+#else
+	#define NOTFOUND() D3DERR_NOTFOUND
+#endif
+
+#ifndef NDEBUG
