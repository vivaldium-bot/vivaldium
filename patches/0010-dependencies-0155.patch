+        shader, ":3: error: 'return' : void function cannot return a value\n",
+        '1 warning and 1 error generated.\n']
+
+
+@inside_glslc_testsuite('OptionCapD')
+class TestDashCapDWithDashStdAndVersionAndComments(expect.ErrorMessage):
