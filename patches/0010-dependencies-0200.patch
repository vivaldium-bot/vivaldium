+  rtc::Thread* const worker_thread_;
+  rtc::Thread* const network_thread_;
+  rtc::AsyncInvoker invoker_;
+
+  const std::string content_name_;
+  std::unique_ptr<ConnectionMonitor> connection_monitor_;
