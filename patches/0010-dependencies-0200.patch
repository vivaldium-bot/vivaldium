+
+const DataContentDescription* GetFirstDataContentDescription(
+    const SessionDescription* sdesc) {
+  return static_cast<const DataContentDescription*>(
+      GetFirstMediaContentDescription(sdesc, MEDIA_TYPE_DATA));
+}
+
+//
