+     function-style rather than predicate-style. The default rule is to leave
+     the type unchanged. */ \
+  template<typename FromType> \
+  class SmartUnwrapper { \
+   public: \
+    typedef FromType ToType; \
+    static FORCE_INLINE ToType Unwrap(FromType from) { \
+      return from; \
+    } \
+  }; \
+\
+  }
