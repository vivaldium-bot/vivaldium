+  rtc::Thread* thread_;
+  std::string nonce_key_;
+  std::string realm_;
+  std::string software_;
+  TurnAuthInterface* auth_hook_;
+  TurnRedirectInterface* redirect_hook_;
+  // otu - one-time-use. Server will respond with 438 if it's
