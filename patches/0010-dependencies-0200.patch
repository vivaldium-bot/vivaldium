diff --git a/third_party/webrtc/test/fuzzers/rtp_header_fuzzer.cc b/third_party/webrtc/test/fuzzers/rtp_header_fuzzer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..914a8fb9494bc2e701d658ec5c1e55414b6a0586
--- /dev/null
