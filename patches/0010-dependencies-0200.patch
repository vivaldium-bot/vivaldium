+  class SmartWrapper<wrappedType, unwrappedType> { \
+   public: \
+    static FORCE_INLINE wrappedType Wrap(unwrappedType var) { \
+      return wrapCode; \
+    } \
+  }; \
+\
+  template<> \
+  class SmartUnwrapper<wrappedType> { \
+   public: \
+    typedef unwrappedType ToType; \
