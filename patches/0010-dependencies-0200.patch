+  void TestOnReadyToSendWithRtcpMux() {
+    CreateChannels(RTCP, RTCP);
+    typename T::Content content;
+    CreateContent(0, kPcmuCodec, kH264Codec, &content);
+    // Both sides agree on mux. Should no longer be a separate RTCP channel.
