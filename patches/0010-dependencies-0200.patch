+  OptionMap options_;
+  IceParameters ice_parameters_;
+  std::vector<IceParameters> remote_ice_parameters_;
+  IceMode remote_ice_mode_;
+  IceRole ice_role_;
+  uint64_t tiebreaker_;
+  IceGatheringState gathering_state_;
