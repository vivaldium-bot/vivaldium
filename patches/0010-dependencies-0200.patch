+  }
+
+  std::unique_ptr<PortAllocatorSession> CreateSession(
+      const std::string& sid,
+      const std::string& content_name,
+      int component) {
+    return CreateSession(sid, content_name, component, kIceUfrag0, kIcePwd0);
