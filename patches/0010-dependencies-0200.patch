diff --git a/third_party/webrtc/stats/rtcstats_unittest.cc b/third_party/webrtc/stats/rtcstats_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6cb8817969698bf3c9aa4cf9911cc149c65ab4dc
