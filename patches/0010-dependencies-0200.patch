+class QuicTransport : public Transport {
+ public:
+  QuicTransport(const std::string& name,
+                PortAllocator* allocator,
+                const rtc::scoped_refptr<rtc::RTCCertificate>& certificate);
+
+  ~QuicTransport() override;
