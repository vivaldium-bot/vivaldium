diff --git a/third_party/pdfium/third_party/freetype/src/cff/cf2glue.h b/third_party/pdfium/third_party/freetype/src/cff/cf2glue.h
new file mode 100644
index 0000000000000000000000000000000000000000..a24da39e93cad080f4ee5f9cccecf3ff5e950a07
--- /dev/null
+++ b/third_party/pdfium/third_party/freetype/src/cff/cf2glue.h
@@ -0,0 +1,144 @@
+/***************************************************************************/
+/*                                                                         */
+/*  cf2glue.h                                                              */
+/*                                                                         */
+/*    Adobe's code for shared stuff (specification only).                  */
+/*                                                                         */
