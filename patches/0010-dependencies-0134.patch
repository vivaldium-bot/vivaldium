+void CPWL_Wnd::PWLtoWnd(const CFX_FloatPoint& point,
+                        int32_t& x,
+                        int32_t& y) const {
+  CFX_Matrix mt = GetWindowMatrix();
+  CFX_FloatPoint pt = point;
+  mt.Transform(pt.x, pt.y);
+  x = (int32_t)(pt.x + 0.5);
+  y = (int32_t)(pt.y + 0.5);
