+
+    mov             ebp,    [psqsum16x16]
+    pshufd  xmm6,   xmm5,   14 ;00001110
+    paddd   xmm6,   xmm5
+    pshufd  xmm5,   xmm6,   1  ;00000001
+    paddd   xmm5,   xmm6
