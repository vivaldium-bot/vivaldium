+    psrlq       mm4, 20h
+    movd        [r0+12], mm4
+
+    movd        [r0], mm1
+    psrlq       mm1, 10h
+    movd        [r0+4], mm1
+    psrlq       mm1, 10h
+    movd        [r0+8], mm1
+    WELSEMMS
+    ret
