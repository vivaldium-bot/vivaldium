+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    WELS_SAD_SUM_SQSUM_16x1_SSE2 esi,edi,ebx
+    paddd xmm7,           xmm6
+    movd  [edx+8],        xmm6
+    psrldq        xmm6,           8
+    movd  [edx+12],       xmm6
+
+    mov           ebp,    [psum16x16]
+    movdqa        xmm1,   xmm5
+    psrldq        xmm1,   8
