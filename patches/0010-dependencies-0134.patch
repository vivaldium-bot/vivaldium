@@ -0,0 +1,287 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ftpatent.c                                                             */
+/*                                                                         */
+/*    FreeType API for checking patented TrueType bytecode instructions    */
+/*    (body).                                                              */
+/*                                                                         */
+/*  Copyright 2007-2015 by                                                 */
+/*  David Turner.                                                          */
+/*                                                                         */
