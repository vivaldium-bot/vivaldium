diff --git a/third_party/pdfium/skia/ext/google_logging.cc b/third_party/pdfium/skia/ext/google_logging.cc
new file mode 100644
index 0000000000000000000000000000000000000000..99061672e723d65401818f5abeac9d988394d73f
