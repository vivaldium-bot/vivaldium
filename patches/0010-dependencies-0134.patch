+  v8::Local<v8::Value> hPropValue =
+      v8::Local<v8::Value>::New(m_pIsolate, lpPropValue->DirectGetValue());
+  return (FX_BOOL)hObject.As<v8::Object>()->Set(uPropIdx, hPropValue);
