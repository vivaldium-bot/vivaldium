+
+#include "fpdfsdk/pdfwindow/PWL_Utils.h"
+
+#include <algorithm>
+
+#include "core/fpdfdoc/include/cpvt_word.h"
+#include "core/fxge/include/cfx_graphstatedata.h"
+#include "core/fxge/include/cfx_pathdata.h"
