+void FilteringEdgeLumaH (DeblockingFunc* pfDeblocking, SDeblockingFilter* pFilter, uint8_t* pPix, int32_t iStride,
+                         uint8_t* pBS) {
+  int32_t iIdexA;
+  int32_t iAlpha;
+  int32_t iBeta;
