+    case PWL_ICONTYPE_RIGHTPOINTER:
+      GetGraphics_RightPointer(sPath, path, rect, PWLPT_PATHDATA);
+      break;
+    case PWL_ICONTYPE_STAR:
+      GetGraphics_Star(sPath, path, rect, PWLPT_PATHDATA);
