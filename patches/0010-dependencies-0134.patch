+    int32_t    iBgdHeight;
+    int32_t    iStride[3];
+    SBackgroundOU*   pOU_array;
+    int8_t*    pBackgroundMbFlag;
+    SVAACalcResult*  pCalcRes;
+  } m_BgdParam;
+
+  int32_t     m_iLargestFrameSize;
