+  if (bScrollingDetection) {
+    pFuncList->pfSCDPSkipDecision = WelsMdInterJudgeSCDPskip;
+  } else {
+    pFuncList->pfSCDPSkipDecision = WelsMdInterJudgeSCDPskipFalse;
+  }
+}
