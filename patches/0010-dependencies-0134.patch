index 0000000000000000000000000000000000000000..af32a75e767beab4cac812be8b8c06adcdfd552e
--- /dev/null
+++ b/third_party/openh264/src/codec/processing/src/arm/vaa_calc_neon.S
@@ -0,0 +1,755 @@
+/*!
