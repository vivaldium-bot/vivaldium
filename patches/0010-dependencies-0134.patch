+    urshr   v2.8h, v2.8h, #1
+    urshr   v3.8h, v3.8h, #1
+    urhadd  v0.8h, v0.8h, v2.8h
+    urhadd  v1.8h, v1.8h, v3.8h
+    xtn     v0.8b, v0.8h
+    xtn     v1.8b, v1.8h
+    st1     {v0.8b, v1.8b}, [x0], #16
+
+    sub     w6, w6, #1
+    cbnz    w6, comp_ds_bilinear_w_x32_loop1
+
+    add     x2, x7, w9, sxtw
+    add     x0, x0, w1, sxtw
+    sub     w5, w5, #1
+    cbnz    w5, comp_ds_bilinear_w_x32_loop0
+WELS_ASM_AARCH64_FUNC_END
