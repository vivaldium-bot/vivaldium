+                *length = strlen(name);
+            }
+        }
+
+        *size = uniform->elementCount();
+        *type = uniform->type;
+    }
+    else
+    {
+        if (bufsize > 0)
+        {
+            name[0] = '\0';
+        }
+
+        if (length)
+        {
+            *length = 0;
