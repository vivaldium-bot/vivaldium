+
+    if (display->testDeviceLost())
+    {
+        thread->setError(EglContextLost());
+        return EGL_FALSE;
+    }
+
+    UNIMPLEMENTED();  // FIXME
+
+    thread->setError(NoError());
+    return 0;
+}
