+        return compileTestShader(GL_FRAGMENT_SHADER, SH_GLES2_SPEC, SH_GLSL_COMPATIBILITY_OUTPUT,
+                                 shaderString, &mCode, nullptr);
+    }
+
+    bool foundInCode(const char* stringToFind)
+    {
+        return mCode.find(stringToFind) != std::string::npos;
+    }
+
+  private:
+    std::string mCode;
+};
