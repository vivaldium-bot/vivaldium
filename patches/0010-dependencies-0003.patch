+        }
+
+        mVertexShader->release();
+        mVertexShader = nullptr;
+    }
+    else if (shader->getType() == GL_FRAGMENT_SHADER)
+    {
+        if (mFragmentShader != shader)
+        {
+            return false;
+        }
