+gl::Error TextureD3D::getNativeTexture(TextureStorage **outStorage)
+{
+    // ensure the underlying texture is created
+    gl::Error error = initializeStorage(false);
+    if (error.isError())
+    {
+        return error;
+    }
+
+    if (mTexStorage)
+    {
+        error = updateStorage();
+        if (error.isError())
+        {
+            return error;
+        }
+    }
+
+    ASSERT(outStorage);
+
+    *outStorage = mTexStorage;
+    return gl::Error(GL_NO_ERROR);
+}
