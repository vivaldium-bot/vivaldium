+        "   gl_FragData[1] = vec4(0.0);\n"
+        "}\n";
+    compile(shaderString);
+    ASSERT_TRUE(foundInCode("GL_NV_draw_buffers"));
+    ASSERT_FALSE(foundInCode("GL_EXT_draw_buffers"));
+}
diff --git a/third_party/angle/src/tests/compiler_tests/Pack_Unpack_test.cpp b/third_party/angle/src/tests/compiler_tests/Pack_Unpack_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a6333e78eaf91f9621b76da9e25caf8818ee0034
--- /dev/null
