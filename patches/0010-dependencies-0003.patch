+        EGL_NONE,
+    };
+
+    result = eglCreateStreamProducerD3DTextureNV12ANGLE(display, stream, producerAttributes);
+    ASSERT_EGL_TRUE(result);
+    ASSERT_EGL_SUCCESS();
