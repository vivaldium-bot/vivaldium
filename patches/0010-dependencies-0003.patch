+DisplayEGL::DisplayEGL(const egl::DisplayState &state)
+    : DisplayGL(state),
+      mEGL(nullptr),
+      mConfig(EGL_NO_CONFIG),
+      mContext(EGL_NO_CONTEXT),
+      mFunctionsGL(nullptr)
+{
