+        "    if (b)\n"
+        "    {\n"
+        "        return foo(0.0);\n"
+        "    }\n"
+        "    else\n"
+        "    {\n"
+        "        return foo(1.0);\n"
+        "    }\n"
+        "}\n"
+        "void main()\n"
+        "{\n"
