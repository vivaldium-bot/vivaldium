+
+namespace angle
+{
+
+class ClientArraysTest : public ANGLETest
+{
+  protected:
+    ClientArraysTest()
+    {
+        setWindowWidth(128);
+        setWindowHeight(128);
+        setConfigRedBits(8);
+        setConfigGreenBits(8);
