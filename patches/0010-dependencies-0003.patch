+ContextVk::ContextVk(const gl::ContextState &state, RendererVk *renderer)
+    : ContextImpl(state), mRenderer(renderer), mCurrentDrawMode(GL_NONE)
+{
+}
+
+ContextVk::~ContextVk()
+{
+    invalidateCurrentPipeline();
+}
+
+gl::Error ContextVk::initialize()
+{
+    return gl::NoError();
+}
