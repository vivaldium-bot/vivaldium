+
+    gl::Error packPixels(ID3D11Texture2D *srcTexure, UINT srcSubresource, const PackPixelsParams &params);
+
+  private:
+    gl::Error flushQueuedPackCommand();
+
+    ID3D11Texture2D *mStagingTexture;
