+                return;
+            }
+            break;
+          default:
+              context->handleError(Error(GL_INVALID_ENUM));
+            return;
+        }
+
+        Program *programObject = GetValidProgram(context, program);
+        if (!programObject)
+        {
+            return;
+        }
+
+        programObject->setTransformFeedbackVaryings(count, varyings, bufferMode);
+    }
