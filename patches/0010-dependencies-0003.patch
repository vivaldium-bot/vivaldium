+            {
+                ANGLE_VALIDATION_ERR(context, InvalidEnum(), InvalidPname);
+                return false;
+            }
+            break;
+        default:
+            ANGLE_VALIDATION_ERR(context, InvalidEnum(), InvalidPname);
+            return false;
+    }
