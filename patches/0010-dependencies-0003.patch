+
+class DebugShaderPrecisionTest : public MatchOutputCodeTest
+{
+  public:
+    DebugShaderPrecisionTest() : MatchOutputCodeTest(GL_FRAGMENT_SHADER, 0, SH_ESSL_OUTPUT)
