+
+#include "tcuDefs.hpp"
+#include "egluNativeDisplay.hpp"
+#include "eglwDefs.hpp"
+
+namespace tcu
+{
+
+class EventState
+{
+  public:
+    EventState()
+        : mQuit(false)
+    {
+    }
+    bool quitSignaled() const { return mQuit; };
+    void signalQuitEvent() { mQuit = true; };
+
+  private:
+    bool mQuit;
+};
