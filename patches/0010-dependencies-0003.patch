+// imageformats.h: Defines image format types with functions for mip generation
+// and copying.
+
+#ifndef LIBANGLE_RENDERER_D3D_IMAGEFORMATS_H_
+#define LIBANGLE_RENDERER_D3D_IMAGEFORMATS_H_
