+    ":angle_internal_gmock",
+    ":angle_internal_gtest",
+  ]
+
+  config("angle_internal_gtest_config") {
+    include_dirs = [
+      "//third_party/googletest/src/googletest",
+      "//third_party/googletest/src/googletest/include",
+    ]
