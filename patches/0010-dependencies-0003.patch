+import("../../gni/angle.gni")
+import("//build/config/chromecast_build.gni")
+import("//testing/test.gni")
+
+unittests_gypi = exec_script("//build/gypi_to_gn.py",
+                             [
+                               rebase_path("angle_unittests.gypi"),
+                               "--replace=<(angle_path)=.",
+                             ],
+                             "scope",
