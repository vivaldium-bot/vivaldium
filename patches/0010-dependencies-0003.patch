+            bufferFormatID          = angle::Format::ID::R8_SINT;
+            vkBufferFormat          = VK_FORMAT_R8_SINT;
+            dataInitializerFunction = nullptr;
+            break;
+        }
+
+        case angle::Format::ID::R8_SNORM:
