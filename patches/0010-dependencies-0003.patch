+                           GLenum mode,
+                           GLsizei count,
+                           GLenum type,
+                           const void *indices) override;
+    gl::Error drawElementsInstanced(const gl::Context *context,
+                                    GLenum mode,
+                                    GLsizei count,
+                                    GLenum type,
+                                    const void *indices,
+                                    GLsizei instances) override;
+    gl::Error drawRangeElements(const gl::Context *context,
+                                GLenum mode,
+                                GLuint start,
+                                GLuint end,
+                                GLsizei count,
