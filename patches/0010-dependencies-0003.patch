+                            ClearCommandType clearCommandType,
+                            GLbitfield mask,
+                            GLenum buffer,
+                            GLint drawbuffer,
+                            const uint8_t *values,
+                            GLfloat depth,
+                            GLint stencil);
+    void genericClear(ClearCommandType clearCommandType,
+                      GLbitfield mask,
+                      GLenum buffer,
+                      GLint drawbuffer,
+                      const uint8_t *values,
+                      GLfloat depth,
+                      GLint stencil);
+
+    const FunctionsGL *mFunctions;
+    StateManagerGL *mStateManager;
+
+    GLuint mFramebuffer;
+};
