+        EXPECT_GL_NO_ERROR();
+
+        const GLsizei imageSize = 8;
+
+        glCompressedTexImage2D(GL_TEXTURE_2D, 1, GL_COMPRESSED_RGB8_LOSSY_DECODE_ETC2_ANGLE, 4, 4,
+                               0, imageSize, pixel);
