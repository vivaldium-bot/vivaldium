+class EGLPresentPathD3D11 : public testing::TestWithParam<PlatformParameters>
+{
+  protected:
+    EGLPresentPathD3D11()
+        : mDisplay(EGL_NO_DISPLAY),
+          mContext(EGL_NO_CONTEXT),
+          mSurface(EGL_NO_SURFACE),
+          mOffscreenSurfaceD3D11Texture(nullptr),
