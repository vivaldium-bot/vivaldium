+
+using namespace sh;
+
+class NVDrawBuffersTest : public MatchOutputCodeTest
+{
+  public:
+    NVDrawBuffersTest() : MatchOutputCodeTest(GL_FRAGMENT_SHADER, 0, SH_ESSL_OUTPUT)
+    {
