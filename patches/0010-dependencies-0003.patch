+TEST_F(BufferVariablesTest, ShaderStorageBlockWithMemoryQualifier)
+{
+    const std::string &source =
+        "#version 310 es\n"
+        "layout(binding = 3) writeonly buffer buf {\n"
+        "    int b1;\n"
+        "    buffer int b2;\n"
+        "};\n"
+        "void main()\n"
