+        "void main() {\n"
+        "   const int i = 0xFFFFFFFF;\n"
+        "   my_Vec = vec4(i * inInt);\n"
+        "}\n";
+    compileAssumeSuccess(shaderString);
+    ASSERT_TRUE(constantFoundInAST(-1));
+}
