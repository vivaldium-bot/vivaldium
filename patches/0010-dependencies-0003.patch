+void ExpectFramebufferCompleteOrUnsupported(GLenum binding)
+{
+    GLenum status = glCheckFramebufferStatus(binding);
+    EXPECT_TRUE(status == GL_FRAMEBUFFER_COMPLETE || status == GL_FRAMEBUFFER_UNSUPPORTED);
+}
