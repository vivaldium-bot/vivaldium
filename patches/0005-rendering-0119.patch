-    var y = spanToDrag.offsetTop + spanToDrag.offsetHeight / 2;
-
-    eventSender.mouseMoveTo(x, y);
-    eventSender.mouseDown();
-    eventSender.mouseUp();
-    eventSender.mouseDown();
-    eventSender.mouseUp();
