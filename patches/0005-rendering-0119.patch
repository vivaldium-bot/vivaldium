-
-test(function () {
-    assert_throws({'name': 'TypeError'}, function () {
-        document.createElement('div').attachShadow({})
-    }, 'attachShadow must throw a TypeError when mode is omitted');
-
-    assert_throws({'name': 'TypeError'}, function () {
-        document.createElement('div').attachShadow({mode: true})
