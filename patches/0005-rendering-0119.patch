-                    break;
-
-                // Delete the next key
-                case 510:
-                    store.delete(511);
-                    break;
-
-                // Delete randomly
-                case 512:
-                    store.delete(611);
-                    store.delete(499);
-                    store.delete(500);
-                    break;
-
-                // Delete and add a new key
-                case 520:
-                    store.delete(521);
