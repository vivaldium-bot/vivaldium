-    var reversed = newHeader.classList.contains('reversed');
-    var sortArrow = reversed ? TableSorter._backwardArrow : TableSorter._forwardArrow;
-    newHeader.innerHTML = TableSorter._sortedContents(newHeader, sortArrow);
