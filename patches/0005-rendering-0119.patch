-s.src = get_host_info(). HTTP_REMOTE_ORIGIN + "/html/dom/documents/dom-tree-accessors/cross-domain.js"
-s.onload = function() {
-  verify('cross-origin')
-  finish('cross-origin');
-}
-document.body.appendChild(s);
-
