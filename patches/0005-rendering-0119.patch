-  convertToMap: function(o) {
-    if ("actual" in o)
-      return o;
-    else {
-      let map = new Map();
-      var keys = Object.keys(o).sort((a, b) => {
-        let a_isTest = "actual" in o[a];
-        let b_isTest = "actual" in o[b];
-        if (a_isTest == b_isTest)
-          return a < b ? -1 : +(a > b);
-        return a_isTest ? -1 : 1;
-      });
-      for (let p of keys)
-        map.set(p, GUI.convertToMap(o[p]));
-      return map;
-    }
