-        if (window.testRunner)
-            window.testRunner.notifyDone();
-
-    }, false);
-
-    // Open the target window and it will begin to send us messages.
-    target = window.open('https://127.0.0.1:8443/cache/resources/max-age-resource.html');
-    </script>
