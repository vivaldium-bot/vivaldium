-      if (link.relList.supports('serviceworker') == false) throw Error("link rel=serviceworker not supported");
-
-      link.rel = 'serviceworker';
-      link.href = scriptUrl;
-      link.scope = opts.scope;
-
-      if (opts.updateViaCache) {
-        link.updateViaCache = opts.updateViaCache;
