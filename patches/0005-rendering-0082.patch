-      link.onload = async () => {
-        const fullScope = new URL(opts.scope, window.location).href;
-
-        const regs = await navigator.serviceWorker.getRegistrations();
-        const reg = regs.find(r => r.scope == fullScope && (r.installing || r.waiting || r.active));
