-description("Tests that ImageBitmap is transferable and that the pixel data survives the trip, as well as createImageBitmap(ImageBitmap) works on worker thread");
-
-var imageWidth = 3;
-var imageHeight = 2;
-var bitmapWidth;
-var bitmapHeight;
