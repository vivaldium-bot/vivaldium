-                  }
-
-                  img = ctx.getImageData(0, 0, 1, 1).data;
-                  debugString += img[0] + "," + img[1] + "," + img[2] + "," + img[3] + "\n";
-                  img = ctx.getImageData(12, 12, 1, 1).data;
-                  debugString += img[0] + "," + img[1] + "," + img[2] + "," + img[3] + "\n";
-                  img = ctx.getImageData(24, 24, 1, 1).data;
-                  debugString += img[0] + "," + img[1] + "," + img[2] + "," + img[3] + "\n";
-              }
-          }
-      }
