-        ctx3.fillRect(0, 0, 100, 100);
-        ctx3.save();
-        ctx3.beginPath();
-        ctx3.moveTo(10, 10);
-        ctx3.lineTo(90, 50);
-        ctx3.lineTo(10, 90);
-        ctx3.clip();
-        ctx3.save();
-        ctx3.beginPath();
-        ctx3.rect(50, 0, 50, 100);
