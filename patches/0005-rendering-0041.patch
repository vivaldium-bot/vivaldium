-        +
-            0px : padding-left
-        +
-            0px : width (shrink-to-fit)
-        +
-            0px : padding-right
-        +
-           75px : border-right-width
-        +
-            0px : margin-right
-        +
-            8px : right
-        ====================
-                : width of containing block (width of Initial Containing Block)
