-  bitmapWidth = newImageBitmap.width;
-  bitmapHeight = newImageBitmap.height;
-
-  // Getting the ImageBitmap back from the worker thread
-  shouldBe("bitmapWidth", "imageWidth");
-  shouldBe("bitmapHeight", "imageHeight");
