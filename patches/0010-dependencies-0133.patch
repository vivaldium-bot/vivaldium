+I915_DBG(unsigned flags, const char *fmt, ...)
+{
+   if (I915_DBG_ON(flags)) {
+      va_list  args;
+
+      va_start(args, fmt);
+      debug_vprintf(fmt, args);
+      va_end(args);
+   }
+}
