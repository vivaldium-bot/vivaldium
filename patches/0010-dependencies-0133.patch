+Instruction *
+BuildUtil::mkTex(operation op, TexTarget targ, uint8_t tic, uint8_t tsc,
+                 Value **def, Value **src)
+{
+   TexInstruction *tex = new_TexInstruction(func, op);
+
+   for (int d = 0; d < 4 && def[d]; ++d)
+      tex->setDef(d, def[d]);
+   for (int s = 0; s < 4 && src[s]; ++s)
+      tex->setSrc(s, src[s]);
+
+   tex->setTexture(targ, tic, tsc);
+
+   return tex;
+}
