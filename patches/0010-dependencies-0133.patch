+%undef           p_ref
+%undef           i_xcnt
+%undef           i_ycnt
+%undef           i_stride
+%undef           i_stride3
+%undef           r_tmp
+%undef           xcnt_unit
+%undef           mm_sadframe
+%undef           mm_zero
+%undef           saveregs
+%undef           p_sadframe
+%undef           p_sad8x8
+%undef           p_sum16x16
+%undef           p_sqsum16x16
