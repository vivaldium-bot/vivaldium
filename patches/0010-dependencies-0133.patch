+    pmulhuw xmm2,   xmm3    ; mul u(1-u)u(1-u) on xmm2
+    pmaddwd     xmm2,   xmm1
+    pshufd  xmm1,   xmm2,   00000001b
+    paddd   xmm2,   xmm1
+    movdqa  xmm1,   [add_extra_half]
+    paddd   xmm2,   xmm1
+    psrld   xmm2,   15
+
+    packuswb    xmm2,   xmm0
+    movd    ebx,    xmm2
+    mov     [r0],  bl
+    inc     r0
+
