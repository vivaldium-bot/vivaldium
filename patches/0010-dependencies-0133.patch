index 0000000000000000000000000000000000000000..8dfda378374c746c4f3c219c5e9a41f4b5de5645
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/nvc0/nvc0_query.c
@@ -0,0 +1,524 @@
