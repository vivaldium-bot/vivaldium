index 0000000000000000000000000000000000000000..786889f8b571ca3642b0d960bc2c14024ac8ab34
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/nvc0/nvc0_shader_state.c
@@ -0,0 +1,278 @@
+/*
