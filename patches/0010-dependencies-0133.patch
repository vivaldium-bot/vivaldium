+    SAD_VAR_16 \arg0, \arg1, \arg2, q7
+    SAD_VAR_16 \arg0, \arg1, \arg2, q7
+    SAD_VAR_16 \arg0, \arg1, \arg2, q7
+    SAD_VAR_16 \arg0, \arg1, \arg2, q7
