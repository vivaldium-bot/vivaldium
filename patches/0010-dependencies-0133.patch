+    movd    xmm5,       r12d
+    pshuflw xmm5,       xmm5,       01000100b   ; 32768 32767 32768 32767
+
+FAST_DOWNSAMPLE:
+    sub     r1, r2                   ; stride - width
+    dec     r3
+    mov     r14,16384
+
+    pshuflw xmm4,       xmm5,   01010000b
+    psrlw   xmm4,       1               ; initial v to 16384 16384 16383 16383
+
+FAST_HEIGHT:
+    mov     r12, r14
+    shr     r12,    15
