index 0000000000000000000000000000000000000000..d743d7689ae473d55f9c85ca0c7407232dee043e
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/llvmpipe/lp_rast.c
@@ -0,0 +1,966 @@
+/**************************************************************************
+ *
