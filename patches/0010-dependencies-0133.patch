diff --git a/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_run.c b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_run.c
new file mode 100644
index 0000000000000000000000000000000000000000..d2f7aa6dafba27ef2e33dd396103a95e067807fa
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_run.c
@@ -0,0 +1,199 @@
+/**************************************************************************
+ *
+ * Copyright 2011 Lauri Kasanen
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including
