+%macro PUSHM 1-*
+    %rep %0
+        push           %1
+        %rotate 1
+    %endrep
+    %assign push_num push_num + %0
+%endmacro
+
+%macro POPM 1-*
+    %rep %0
+        %rotate -1
+        pop            %1
+    %endrep
+    %assign push_num push_num - %0
+%endmacro
