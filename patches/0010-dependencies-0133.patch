+              'SK_SUPPORT_LEGACY_CLIPTOLAYERFLAG',
+            ],
+          }],
+          [ 'skia_profile_enabled == 1', {
+            'cflags': ['-g', '-fno-omit-frame-pointer', '-marm', '-mapcs'],
+          }],
+        ],
+      },
+    ],
+
+    [ 'skia_moz2d', {
+      'defines': [
+        # add flags here (e.g. SK_SUPPORT_LEGACY_...) needed by moz2d
+      ],
+    }],
+
+    [ 'skia_command_buffer and skia_os == "linux"', {
