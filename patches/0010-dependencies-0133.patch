+    and     r12d,   65535
+    mov     r13d,   r12d
+    neg     r13d
+    and     r13d,   65535
+    movd    xmm1,   r12d                     ; uinc(uiScaleX mod 65536)
+    movd    xmm2,   r13d                     ; -uinc
+    psllq   xmm1,   32
