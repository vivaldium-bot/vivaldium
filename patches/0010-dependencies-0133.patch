--- /dev/null
+++ b/third_party/mesa/src/src/egl/main/eglcurrent.c
@@ -0,0 +1,335 @@
+/**************************************************************************
+ *
+ * Copyright 2009-2010 Chia-I Wu <olvaffe@gmail.com>
