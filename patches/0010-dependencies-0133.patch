+nv30_screen_create(struct nouveau_device *);
+
+extern struct pipe_screen *
+nv50_screen_create(struct nouveau_device *);
+
+extern struct pipe_screen *
+nvc0_screen_create(struct nouveau_device *);
+
+#endif
