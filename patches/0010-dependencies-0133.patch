+    jg      FAST_HEIGHT
+
+
+FAST_LAST_ROW:
+    shr     r14, 15
+    imul    r14, r5
+    add     r4, r14
+    mov     r15, 32768
+
+FAST_LAST_ROW_WIDTH:
