+              'VCCLCompilerTool': {
+                'DebugInformationFormat': '4', # editAndContiue (/ZI)
+                'Optimization': '0',           # optimizeDisabled (/Od)
+                'PreprocessorDefinitions': ['_DEBUG'],
+                'RuntimeLibrary': '3',         # rtMultiThreadedDebugDLL (/MDd)
+                'RuntimeTypeInfo': 'false',      # /GR-
