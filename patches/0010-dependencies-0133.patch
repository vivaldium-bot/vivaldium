+    sub           esi,    eax
+    sub           edi,    eax
+    add           esi,    16
+    add           edi,    16
+
+    dec           ecx
+    jnz           width_loop
+
+    pop           edi
+    pop           esi
+    add           esi,    eax
+    add           edi,    eax
+
+    dec   dword [iPicHeight]
+    jnz           height_loop
+
+    mov           edx,    [psadframe]
+    movdqa        xmm5,   xmm7
+    psrldq        xmm7,   8
+    paddd xmm7,   xmm5
+    movd  [edx],  xmm7
+
+%undef          cur_data
+%undef          ref_data
+%undef          iPicWidth
+%undef          iPicHeight
+%undef          iPicStride
+%undef          psadframe
