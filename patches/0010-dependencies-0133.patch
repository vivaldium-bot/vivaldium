+bgd_height_loop:
+    ;mov            ecx,    dword [iPicWidth]
+    push r2
+    %assign push_num push_num+1
+    mov             r10,    r15
+    mov             r11,    r1
+bgd_width_loop:
+    pxor    xmm7,   xmm7            ; pSad8x8
+    pxor    xmm6,   xmm6            ; sum_cur_8x8
+    pxor    xmm5,   xmm5            ; sum_ref_8x8
+    pxor    xmm4,   xmm4            ; pMad8x8
