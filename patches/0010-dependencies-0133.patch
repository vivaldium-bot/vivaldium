index 0000000000000000000000000000000000000000..e01f16e715ce9035bed822439b6b8f5cf051b0c6
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/i915/i915_state_derived.c
@@ -0,0 +1,220 @@
+/**************************************************************************
+ * 
+ * Copyright 2003 Tungsten Graphics, Inc., Cedar Park, Texas.
