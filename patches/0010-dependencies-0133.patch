+                '-fsanitize=<(skia_sanitizer)',                     # Turn on sanitizers.
+                '-fno-sanitize-recover=<(skia_sanitizer)',          # Make any failure fatal.
+                '-fsanitize-blacklist=<(skia_sanitizer_blacklist)', # Compile in our blacklist.
