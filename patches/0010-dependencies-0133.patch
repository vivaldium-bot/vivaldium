+void CWelsH264SVCEncoder::InitEncoder (void) {
+
+  m_pWelsTrace = new welsCodecTrace();
+  if (m_pWelsTrace == NULL) {
+    return;
+  }
+  m_pWelsTrace->SetCodecInstance (this);
+}
