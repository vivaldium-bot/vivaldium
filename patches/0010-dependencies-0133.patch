+	$(ENCODER_SRCDIR)/core/arm64/reconstruct_aarch64_neon.S\
+	$(ENCODER_SRCDIR)/core/arm64/svc_motion_estimation_aarch64_neon.S\
+
+ENCODER_OBJSARM64 += $(ENCODER_ASM_ARM64_SRCS:.S=.$(OBJ))
+ifeq ($(ASM_ARCH), arm64)
+ENCODER_OBJS += $(ENCODER_OBJSARM64)
+endif
