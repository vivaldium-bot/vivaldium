--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/nv30/nvfx_shader.h
@@ -0,0 +1,525 @@
+#ifndef __NVFX_SHADER_H__
+#define __NVFX_SHADER_H__
+
