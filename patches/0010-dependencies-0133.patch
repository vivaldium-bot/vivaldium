+    %undef  p_sum16x16
+    %undef  p_sqsum16x16
+    %undef  p_sqdiff16x16
+    %define p_sad8x8 r12
+    %define p_sum16x16 r13
+    %define p_sqsum16x16 r14
+    %define p_sqdiff16x16 r15
+    %define i_stride3 rbx
