+
+        SkColor colors[] = { SK_ColorRED, SK_ColorGREEN, SK_ColorGREEN, SK_ColorRED };
+        SkScalar pos[] = { 0, 0.01f, 0.99f, SK_Scalar1 };
+        SkPoint c0;
