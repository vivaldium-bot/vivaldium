diff --git a/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_emit.c b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_emit.c
new file mode 100644
index 0000000000000000000000000000000000000000..942ddc4d7bc9278c427230ed65250d7c03b1079c
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_emit.c
@@ -0,0 +1,295 @@
+/**************************************************************************
+ *
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
