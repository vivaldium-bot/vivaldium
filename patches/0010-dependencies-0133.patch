index 0000000000000000000000000000000000000000..e276fd13907677983f2295c5d71deb5e2420cbb5
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/cso_cache/cso_cache.c
@@ -0,0 +1,322 @@
+/**************************************************************************
+ *
