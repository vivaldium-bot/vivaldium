+    ;mov                     r14,            [p_mad8x8]
+    WELS_MAX_REG_SSE2       xmm4
+
+    movhlps         xmm1,   xmm4
+    movd            r0d,    xmm4
+    mov                     [r14],  r0b
+    movd            r0d,    xmm1
+    mov                     [r14+1],r0b
+    add                     r14,    2
+    mov                     p_mad8x8,       r14
