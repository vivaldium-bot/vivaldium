+	screen->resource_get_handle = noop_resource_get_handle;
+	screen->resource_destroy = noop_resource_destroy;
+	screen->flush_frontbuffer = noop_flush_frontbuffer;
+        screen->get_timestamp = noop_get_timestamp;
