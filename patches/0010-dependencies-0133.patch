+    sar            r3, 4                       ; iPicHeight / 16
+    jle            .done                       ; bail if iPicHeight < 16
+    shr            r2, 2                       ; iPicWidth / 4
+
+%define p_cur     r0
+%define p_ref     r1
+%define i_xcnt    r2
+%define i_ycnt    ptrword arg4
+%define i_stride  r4
+%define r_tmp     r6
+%define xcnt_unit 4
+%ifdef X86_32
+    mov            i_ycnt, r3
+    %define i_stride3 r3
+%else
+    mov            rbp, p_sad8x8
+    mov            r12, p_sd8x8
+    mov            r13, p_mad8x8
+    %undef  p_sad8x8
+    %undef  p_sd8x8
+    %undef  p_mad8x8
+    %define p_sad8x8 rbp
+    %define p_sd8x8 r12
+    %define p_mad8x8 r13
+    %define i_stride3 rbx
+%endif
+    lea            i_stride3, [3 * i_stride]
+
