+; sad=%1 pCur=%2 pRef=%3 tmp=%4 accumulate_results=%5
+%macro AVX2_Sad 5
+    vmovdqu        %4, [%2]
+    AVX2_Sadbdw    %1, %4, [%3], %4, %5
