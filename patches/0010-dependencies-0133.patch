+%macro AVX2_StoreRemainingSingleMad 4
+    test           %1, 32 / xcnt_unit
+    jz             %%skip
+    mov            r_tmp, p_mad8x8
+    vmovdqa        y%2, prev_mad
+    AVX2_Maxubq    y%2, y%2, y%3
+    AVX2_Store8x8Accb r_tmp + i_xcnt - 8, y, %2, %3, %4
