index 0000000000000000000000000000000000000000..f9ac33d2623283de37e9a7b3ac6aa90c77e79f2c
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/nv50/nv50_query.c
@@ -0,0 +1,394 @@
+/*
