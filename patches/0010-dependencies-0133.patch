+; x/y-mm_prefix=%1 mm_clobber=%2,%3,%4,%5,%6,%7,%8 b_second_blocks=%9
+%macro AVX2_CalcSadBgd_8Lines 9
+%define mm_tmp0    %2
+%define mm_tmp1    %3
+%define mm_tmp2    %8
+%define mm_mad     %4
+%define mm_sumcur  %5
+%define mm_sumref  %6
+%define mm_sad     %7
+%define b_second_blocks %9
+    ; Unroll for better performance on Haswell.
