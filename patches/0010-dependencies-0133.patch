+WELS_ASM_AARCH64_FUNC_BEGIN GeneralBilinearAccurateDownsampler_AArch64_neon
+    mov     w10, #32767
+    and     w8, w6, w10
+    mov     w11, #-1
+    mul     w12, w11, w8
