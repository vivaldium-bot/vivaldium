index 0000000000000000000000000000000000000000..1c578d07842c7cdf5fd5e524e0e5c5ed8fe22fb2
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/rbug/rbug_connection.c
@@ -0,0 +1,168 @@
+/*
