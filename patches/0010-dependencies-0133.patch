+
+static void
+emit_epilogue(struct ppc_function *func)
+{
+   ppc_comment(func, -4, "Epilogue:");
+   ppc_return(func);
+   /* XXX restore prev stack frame */
+#if 0
+   debug_printf("PPC: Emitted %u instructions\n", func->num_inst);
+#endif
+}
