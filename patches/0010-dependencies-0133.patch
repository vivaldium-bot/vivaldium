+lp_build_alloca(struct gallivm_state *gallivm,
+                LLVMTypeRef type,
+                const char *name);
+
+LLVMValueRef
+lp_build_array_alloca(struct gallivm_state *gallivm,
+                      LLVMTypeRef type,
+                      LLVMValueRef count,
+                      const char *name);
