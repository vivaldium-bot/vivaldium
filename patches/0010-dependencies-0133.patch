+    paddd   xmm1,                           xmm2
+    movd    edx,                            xmm1
+    add             [tmp_sadframe],         edx                     ; iFrameSad
+
+    mov             edx,            [psum16x16]
+    movdqa  xmm1,           xmm6
+    pshufd  xmm2,           xmm1,           00001110b
+    paddd   xmm1,           xmm2
+    movd    [edx],          xmm1                            ; sum
