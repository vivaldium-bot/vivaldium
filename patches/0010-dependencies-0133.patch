+.macro SAD_VAR_16x16 arg0, arg1, arg2
+    //for one 8x16
+    SAD_VAR_16_RESET_16x16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+    SAD_VAR_16 \arg0, \arg1, \arg2, q6
+
+    vpaddl.u16 q6, q6
