+
+		if (bc->chip_class >= EVERGREEN) {
+			switch (cf->inst) {
+			case EG_V_SQ_CF_ALU_WORD1_SQ_CF_INST_ALU:
+			case EG_V_SQ_CF_ALU_WORD1_SQ_CF_INST_ALU_POP_AFTER:
+			case EG_V_SQ_CF_ALU_WORD1_SQ_CF_INST_ALU_POP2_AFTER:
