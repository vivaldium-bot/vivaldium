+static EGLBoolean
+GLX_eglWaitNative(_EGLDriver *drv, _EGLDisplay *dpy, EGLint engine)
+{
+   struct GLX_egl_driver *GLX_drv = GLX_egl_driver(drv);
+
+   (void) dpy;
