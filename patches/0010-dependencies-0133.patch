+    mov            r_tmp, i_xcnt
+    and            r_tmp, 64 / xcnt_unit - 1
+    sub            p_mad8x8, r_tmp
+    shl            r_tmp, 2
+    sub            p_sad8x8, r_tmp
+    sub            p_sd8x8, r_tmp
+
+.height_loop:
+    push           i_xcnt
+%assign push_num push_num + 1
+%define i_xcnt_load ptrword [r7]
