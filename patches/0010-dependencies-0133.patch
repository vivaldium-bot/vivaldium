+static INLINE struct galahad_transfer *
+galahad_transfer(struct pipe_transfer *_transfer)
+{
+   if(!_transfer)
+      return NULL;
+   (void)galahad_resource(_transfer->resource);
+   return (struct galahad_transfer *)_transfer;
+}
