diff --git a/third_party/mesa/src/docs/RELNOTES-3.2.1 b/third_party/mesa/src/docs/RELNOTES-3.2.1
new file mode 100644
index 0000000000000000000000000000000000000000..d34efcc8673bd31384581f9acbe5048d219b6638
