+                                       GrTexture* permutationsTexture, GrTexture* gradientTexture,
+                                       const SkMatrix& matrix) {
+        return new GrImprovedPerlinNoiseEffect(octaves, z, paintingData, permutationsTexture,
+                                               gradientTexture, matrix);
