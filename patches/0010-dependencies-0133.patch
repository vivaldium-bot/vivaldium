index 0000000000000000000000000000000000000000..52d85ef8b705e4739d718f2873ee55a155b355a0
--- /dev/null
+++ b/third_party/mesa/src/src/egl/main/eglsurface.c
@@ -0,0 +1,530 @@
+/**************************************************************************
+ *
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * Copyright 2009-2010 Chia-I Wu <olvaffe@gmail.com>
+ * Copyright 2010 LunarG, Inc.
+ * All Rights Reserved.
