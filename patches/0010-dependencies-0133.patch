--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_stipple.c
@@ -0,0 +1,261 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
