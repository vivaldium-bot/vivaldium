+	struct r600_bytecode_tex *tex = NULL;
+
+	unsigned i, id;
+	uint32_t literal[4];
+	unsigned nliteral;
+	char chip = '6';
+
+	switch (bc->chip_class) {
+	case R700:
+		chip = '7';
+		break;
+	case EVERGREEN:
+		chip = 'E';
+		break;
+	case CAYMAN:
+		chip = 'C';
+		break;
+	case R600:
+	default:
