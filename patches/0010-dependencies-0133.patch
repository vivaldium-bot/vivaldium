+    vpmaddwd       %4, %4, %4
+    vpaddd         %1, %1, %4
+%endmacro
+
+; res=%1 src=%2 zero=%3 tmp=%4 add_to_res=%5
+%macro AVX2_Sumbdw 5
+%if %5
+    vpsadbw        %4, %2, %3
+    vpaddd         %1, %1, %4
+%else
+    vpsadbw        %1, %2, %3
+%endif
+%endmacro
