+            'ldflags': [
+              '-march=armv7-a',
+            ],
+            'conditions': [
+              [ 'arm_neon == 1', {
+                'defines': [
+                  'SK_ARM_HAS_NEON',
+                ],
+                'cflags': [
+                  '-mfpu=neon',
+                ],
+              }],
+              [ 'arm_neon_optional == 1', {
+                'defines': [
+                  'SK_ARM_HAS_OPTIONAL_NEON',
+                ],
+              }],
+              [ 'skia_os != "chromeos" and skia_os != "linux"', {
+                'cflags': [
+                  '-mfloat-abi=softfp',
+                ],
+              }],
+            ],
+          }],
+          [ '"mips" in skia_arch_type', {
+            'cflags': [ '-EL' ],
+            'conditions': [
+              [ 'mips_arch_variant == "mips32r2"', {
+                'cflags': [ '-march=mips32r2' ],
+                'conditions': [
+                  [ 'mips_dsp == 1', { 'cflags': [ '-mdsp'   ] }],
+                  [ 'mips_dsp == 2', { 'cflags': [ '-mdspr2' ] }],
+                ],
