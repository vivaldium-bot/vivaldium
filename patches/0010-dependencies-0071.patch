+#ifndef _VKTSPARSERESOURCESBUFFERMEMORYALIASING_HPP
+#define _VKTSPARSERESOURCESBUFFERMEMORYALIASING_HPP
+/*------------------------------------------------------------------------
+ * Vulkan Conformance Tests
