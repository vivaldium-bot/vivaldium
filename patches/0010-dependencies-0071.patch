+		   << ", offset = " << entry.offset
+		   << ", arraySize = " << entry.arraySize
+		   << ", arrayStride = " << entry.arrayStride
+		   << ", matrixStride = " << entry.matrixStride
+		   << ", topLevelArraySize = " << entry.topLevelArraySize
+		   << ", topLevelArrayStride = " << entry.topLevelArrayStride
