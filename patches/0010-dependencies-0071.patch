+#define VSCALE_FUNC(size, opt) \
+void ff_yuv2plane1_ ## size ## _ ## opt(const int16_t *src, uint8_t *dst, int dstW, \
+                                        const uint8_t *dither, int offset)
+#define VSCALE_FUNCS(opt1, opt2) \
