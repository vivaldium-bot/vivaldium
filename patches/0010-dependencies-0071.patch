+		for (deUint32 i = 0; i < DE_LENGTH_OF_ARRAY(testParams); i++)
+			computeTests->addChild(newTestCase<ComputeCacheTest>(testCtx, &testParams[i]));
+
+		cacheTests->addChild(computeTests.release());
