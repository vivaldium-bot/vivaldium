index 0000000000000000000000000000000000000000..a120e8793b3862bc7a3a21edf5e7c4fee813ed43
--- /dev/null
+++ b/third_party/ffmpeg/libavresample/arm/audio_convert_neon.S
@@ -0,0 +1,363 @@
+/*
+ * Copyright (c) 2008 Mans Rullgard <mans@mansr.com>
