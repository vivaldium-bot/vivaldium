+	deMemset(&inheritanceInfo, 0xcd, sizeof(inheritanceInfo));
+	inheritanceInfo.sType						= VK_STRUCTURE_TYPE_COMMAND_BUFFER_INHERITANCE_INFO;
+	inheritanceInfo.pNext						= DE_NULL;
