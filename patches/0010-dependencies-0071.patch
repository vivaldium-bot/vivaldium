+		VK_COMPARE_OP_LESS,												// VkCompareOp								depthCompareOp;
+		VK_FALSE,														// VkBool32									depthBoundsTestEnable;
+		VK_FALSE,														// VkBool32									stencilTestEnable;
+		stencilOpState,													// VkStencilOpState							front;
