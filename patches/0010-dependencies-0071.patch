+template<typename T>
+T divRoundUp (const T& a, const T& b)
+{
+	return (a / b) + (a % b == 0 ? 0 : 1);
+}
+
+template<typename T>
+T roundDownToMultiple (const T& a, const T& b)
+{
+	return b * (a / b);
+}
+
+template<typename T>
+T roundUpToMultiple (const T& a, const T& b)
+{
+	return b * (a / b + (a % b != 0 ? 1 : 0));
+}
