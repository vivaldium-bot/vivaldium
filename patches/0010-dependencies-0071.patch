+                                  2, 16, 8, "NEON",
+                                  ff_conv_fltp_to_s16_2ch_neon);
+    }
+}
diff --git a/third_party/ffmpeg/libavresample/arm/audio_convert_neon.S b/third_party/ffmpeg/libavresample/arm/audio_convert_neon.S
