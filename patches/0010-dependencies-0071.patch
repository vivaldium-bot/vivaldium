+class BufferSparseBindingCase : public TestCase
+{
+public:
+					BufferSparseBindingCase	(tcu::TestContext&	testCtx,
+											 const std::string&	name,
+											 const std::string&	description,
+											 const deUint32		bufferSize);
+
