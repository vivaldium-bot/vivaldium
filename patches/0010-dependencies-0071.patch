+		DE_NULL,														// const void*								pNext;
+		0,																// VkPipelineRasterizationStateCreateFlags	flags;
+		false,															// VkBool32									depthClipEnable;
+		false,															// VkBool32									rasterizerDiscardEnable;
+		VK_POLYGON_MODE_FILL,											// VkFillMode								fillMode;
