+		"layout(std430) buffer;\n"
+		"layout(binding = 0) readonly buffer Input0\n"
+		"{\n"
+		"  vec4 elements[];\n"
+		"} input_data0;\n"
+		"layout(binding = 1) writeonly buffer Output\n"
+		"{\n"
+		"  vec4 elements[];\n"
+		"} output_data;\n"
+		"void main()\n"
+		"{\n"
+		"  uint ident = gl_GlobalInvocationID.x;\n"
