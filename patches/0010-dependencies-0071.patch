+								GraphicsPipelineBuilder	(void) : m_renderSize			(0, 0)
+															   , m_shaderStageFlags		(0u)
+															   , m_cullModeFlags		(vk::VK_CULL_MODE_NONE)
+															   , m_frontFace			(vk::VK_FRONT_FACE_COUNTER_CLOCKWISE)
+															   , m_patchControlPoints	(1u)
