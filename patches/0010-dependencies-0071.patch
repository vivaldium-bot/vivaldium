+ExprP<Matrix<float, Rows, Cols> >	operator* (const ExprP<Matrix<float, Rows, Cols> >&	left,
+											   const ExprP<float>&						right);
+template<int Rows, int Cols>
+ExprP<Matrix<float, Rows, Cols> >	operator+ (const ExprP<Matrix<float, Rows, Cols> >&	left,
+											   const ExprP<Matrix<float, Rows, Cols> >&	right);
