+int calcUnnormalizedDim (const ImgDim dim)
+{
+	if (dim == IMG_DIM_1D)
+	{
+	    return 1;
+	}
+	else if (dim == IMG_DIM_2D || dim == IMG_DIM_CUBE)
+	{
+	    return 2;
+	}
+	else
+	{
+	    return 3;
+	}
+}
