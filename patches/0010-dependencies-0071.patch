+                      : "+&a"(p) : "r"(v));
+}
+
+#define AV_RB32 AV_RB32
+static av_always_inline uint32_t AV_RB32(const void *p)
+{
+    uint32_t v;
+    __asm__ ("loadacc,   (%1+) \n\t"
+             "rol8             \n\t"
+             "rol8             \n\t"
+             "rol8             \n\t"
+             "storeacc,  %0    \n\t"
+             "loadacc,   (%1+) \n\t"
