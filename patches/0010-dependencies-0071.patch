+#ifndef AVFORMAT_RTSPCODES_H
+#define AVFORMAT_RTSPCODES_H
+
+#include "libavutil/common.h"
+#include "libavformat/http.h"
+
+/** RTSP handling */
+enum RTSPStatusCode {
