new file mode 100644
index 0000000000000000000000000000000000000000..04f8667a668d920f6fe58febc13980d0ce948094
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/wc3movie.c
@@ -0,0 +1,311 @@
+/*
