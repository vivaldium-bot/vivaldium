index 0000000000000000000000000000000000000000..b6dc517073770090aaadbbed31628b57c101ba75
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/tedcaptionsdec.c
@@ -0,0 +1,366 @@
+/*
+ * TED Talks captions format decoder
+ * Copyright (c) 2012 Nicolas George
+ *
