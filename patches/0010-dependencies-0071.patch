new file mode 100644
index 0000000000000000000000000000000000000000..60e24adb1c6630eb03585df4df1fb802491e375e
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/aarch64/audio_convert_init.c
@@ -0,0 +1,67 @@
