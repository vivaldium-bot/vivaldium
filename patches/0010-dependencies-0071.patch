diff --git a/third_party/ffmpeg/libavresample/arm/resample_init.c b/third_party/ffmpeg/libavresample/arm/resample_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..10af09cb918a70c44dc0eb3bd1fb78990036d52d
--- /dev/null
+++ b/third_party/ffmpeg/libavresample/arm/resample_init.c
@@ -0,0 +1,74 @@
+/*
