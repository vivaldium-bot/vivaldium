+			// [1|0|0|0.5] [x] = x + 0.5
+			// [0|1|0|0.5] [y] = y + 0.5
+			// [0|0|1|0.5] [z] = z + 0.5
+			// [0|0|0|1  ] [1] = 1
+			"matrix",
+
+			"%mat4x4_f32          = OpTypeMatrix %v4f32 4\n"
+		    "%v4f32_1_0_0_0       = OpConstantComposite %v4f32 %c_f32_1 %c_f32_0 %c_f32_0 %c_f32_0\n"
