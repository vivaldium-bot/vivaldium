+template<typename T>
+void removeFirstEqual (vector<T>& vec, const T& val)
+{
+	for (size_t ndx = 0; ndx < vec.size(); ndx++)
+	{
+		if (vec[ndx] == val)
+		{
+			vec[ndx] = vec.back();
+			vec.pop_back();
+			return;
+		}
+	}
+}
