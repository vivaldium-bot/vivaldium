index 0000000000000000000000000000000000000000..fee4ff710bf982011307228a601a7fcd2dcf368f
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/spdif.h
@@ -0,0 +1,65 @@
+/*
+ * IEC 61937 common header
+ * Copyright (c) 2009 Bartlomiej Wolowiec
+ *
