+	computeSrc << "#version 450\n"
+			   << "layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;\n"
+			   << "layout(std140, set = 0, binding = 0) writeonly buffer Output {\n"
+			   << "  vec4 elements[];\n"
+			   << "} outData;\n"
+			   << "layout(push_constant) uniform Material{\n"
+			   << "  vec4 element;\n"
+			   << "} matInst;\n"
