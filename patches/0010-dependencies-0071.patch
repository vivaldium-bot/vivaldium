+		0u,									// uint32_t                       signalSemaphoreCount;
+		DE_NULL,							// const VkSemaphore*             pSignalSemaphores;
+	};
+	VK_CHECK(vk.queueSubmit(queue, 1u, &submitInfo, *fence));
+	VK_CHECK(vk.waitForFences(device, 1u, &fence.get(), DE_TRUE, ~0ull));
+}
