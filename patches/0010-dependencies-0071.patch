+// TextureBinding
+
+TextureBinding::TextureBinding (const tcu::Archive&	archive,
+								const char*			filename,
+								const Type			type,
+								const tcu::Sampler&	sampler)
+	: m_type	(type)
+	, m_sampler	(sampler)
+{
+	switch(m_type)
+	{
+		case TYPE_2D: m_binding.tex2D = loadTexture2D(archive, filename).release(); break;
+		default:
+			DE_FATAL("Unsupported texture type");
+	}
+}
+
