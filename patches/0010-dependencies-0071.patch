index 0000000000000000000000000000000000000000..575dd133287d9dbf37d67c75a8d4e86c596996a9
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/vorbiscomment.c
@@ -0,0 +1,76 @@
+/*
+ * VorbisComment writer
+ * Copyright (c) 2009 James Darnley
+ *
