+		{
+			"float",
+			makeVector(SpecConstant(1u, "layout(constant_id = ${ID}) const float sc0 = 7.5;")),
+			4,
+			"    float r0;\n",
+			"",
+			"    sb_out.r0 = sc0;\n",
+			makeVector(OffsetValue(4, 0, makeValueFloat32(7.5f))),
+			(FeatureFlags)0,
+		},
+		{
+			"double",
+			makeVector(SpecConstant(1u, "layout(constant_id = ${ID}) const double sc0 = 2.75LF;")),
+			8,
+			"    double r0;\n",
+			"",
+			"    sb_out.r0 = sc0;\n",
