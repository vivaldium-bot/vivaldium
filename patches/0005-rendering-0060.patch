-test(function() {
-assert_equals(document.getElementById('box').offsetWidth, 100);
-}, "A character encoding set in the HTTP header has lower precedence than the UTF-8 signature.");
-</script>
-
-<div id='log'></div>
-
-</body>
-</html>
