-                                              components[0] + ":" +
-                                              components[1]);
-  } else {
-     container_elem = document.createElement(container);
-  }
-  container_elem.innerHTML = input_string;
-  var serialized_dom = test_serializer(container_elem);
-  current_tests[iframe.id].actual = serialized_dom;
