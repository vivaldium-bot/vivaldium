-                     var container = x[3];
-                   }
-                   test_func(iframe, t, test_id, string_uri_encoded_input, string_escaped_expected,
-                             container);
-                 });
-         }, 0);
-  }
-
-  onload = function() {
-    Array.prototype.forEach.call(document.getElementsByTagName("iframe"),
-    function(iframe) {
-      if (tests_started<order.length) {
-        test_next(iframe);
-      }
-    });
-  };
-}
