-      test_id:test_id,
-      input:uri_encoded_input,
-      expected:expected,
-      actual:null,
-      container:container
-  };
-
-  var components = container.split(" ");
-  var container_elem = null;
-  if (components.length > 1) {
-    var namespace = namespaces[components[0]];
