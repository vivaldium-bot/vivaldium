-                    createShadowRoot(
-                        createDOM('style', {},
-                            document.createTextNode('div > span { border: 1px solid yellow; }')),
-                        createDOM('div', {},
-                            createDOM('span', {'id': 'target'},
-                                document.createTextNode('Geen border')))))))));
-
-borderColorShouldBe('host/host2/target', 'rgb(0, 128, 0)');
-
-cleanUp();
-
