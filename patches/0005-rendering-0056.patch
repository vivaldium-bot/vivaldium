-        createDOM('p', {'id': 'target'})));
-
-borderColorShouldBe('target', 'rgb(0, 128, 0)');
-
-cleanUp();
-
-// Rules declared in outer treescope should win.
-sandbox.appendChild(
-    createDOM('div', {},
-        createDOM('style', {},
-            document.createTextNode('div /deep/ span { border: 1px solid green; }')),
-        createDOM('div', {'id': 'host'},
