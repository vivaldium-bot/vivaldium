+      registryPath = "{{registry_path|escape}}";
+      servicePath = "{{service_path|escape}}";
+      methodName = "{{method_name|escape}}";
+
+      $(function() {
+        {% block call %}
+        {% endblock %}
+      });
+
+  </script>
+  <style type="text/css">
+    .error-messages {
+        color: RED;
+    }
+  </style>
+  </head>
+
+  <body>
+    {% block top %}Need top{% endblock %}</h1>
+
+    <div class="error-messages" id="error-messages"></div>
+
+    {% block body %}Need body{% endblock %}
+
+  </body>
+</html>
