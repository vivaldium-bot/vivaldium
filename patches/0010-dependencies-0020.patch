+  def testDocstring(self):
+    """Test that docstring is supported ok."""
+    class NotImportant(messages.Enum):
+      """I have a docstring."""
+
+      VALUE1 = 1
+
+    self.assertEquals('I have a docstring.', NotImportant.__doc__)
