+    self.assertEqual(util.HumanReadableToBytes('1T'), 1024 ** 4)
+    self.assertEqual(util.HumanReadableToBytes('1TB'), 1024 ** 4)
+    self.assertEqual(util.HumanReadableToBytes('1TiB'), 1024 ** 4)
