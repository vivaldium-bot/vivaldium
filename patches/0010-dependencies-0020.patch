+class JWe(JWx):
+    @staticmethod
+    def _generate_key_and_iv(encalg, cek="", iv=""):
+        if cek and iv:
+            return cek, iv
+
+        try:
+            _key = Random.get_random_bytes(ENCALGLEN1[encalg])
+            _iv = Random.get_random_bytes(12)
