+
+    value = datetime.datetime(2013, 1, 3, 11, 36, 30, 123000,
+                              util.TimeZoneOffset(8 * 60))
+    message = MyMessage(value=value)
+    decoded = self.PROTOLIB.decode_message(
+        MyMessage, self.PROTOLIB.encode_message(message))
