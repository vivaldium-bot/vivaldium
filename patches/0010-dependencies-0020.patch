+    tt = time.time() - t
+
+    def test(tcount, bits=256):
+        n = rsa.get_prime(bits / 8, 20)
+        p = rsa.random.randint(1, n)
+        p1 = (rsa.random.randint(1, n), rsa.random.randint(1, n))
