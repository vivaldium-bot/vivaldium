+  def setUp(self):
+    """Creates base configuration for integration tests."""
+    super(GsUtilIntegrationTestCase, self).setUp()
+    self.bucket_uris = []
+
+    # Set up API version and project ID handler.
+    self.api_version = boto.config.get_value(
+        'GSUtil', 'default_api_version', '1')
+
