+  def testStr(self):
+    """Test converting to string."""
+    self.assertEquals('RED', str(Color.RED))
+    self.assertEquals('ORANGE', str(Color.ORANGE))
+
+  def testInt(self):
+    """Test converting to int."""
+    self.assertEquals(20, int(Color.RED))
+    self.assertEquals(2, int(Color.ORANGE))
