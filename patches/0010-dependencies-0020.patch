+def der_cert2rsa(der):
+    """
+    Extract an RSA key from a DER certificate
+
+    @param der: DER-encoded certificate
+    @return: RSA instance
+    """
+    pem = re.sub(r'[^A-Za-z0-9+/]', '', der)
+    return der2rsa(base64.b64decode(pem))
