+            ctxt, tag = gcm.encrypt(bytes_to_long(iv), msg, auth_data)
+            tag = long_to_bytes(tag)
+        elif enc_alg in ["A128CBC-HS256", "A192CBC-HS384", "A256CBC-HS512"]:
