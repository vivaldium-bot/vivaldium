+  property: 'margin-left',
+  from: 'calc(50% - 25px)',
+  to: 'calc(100% - 10px)'
+}, [
+  {at: -0.25, is: '-10px'},
+  {at: 0, is: '0px'},
+  {at: 0.25, is: '10px'},
+  {at: 0.5, is: '20px'},
+  {at: 0.75, is: '30px'},
+  {at: 1, is: '40px'},
+  {at: 1.25, is: '50px'}
+]);
