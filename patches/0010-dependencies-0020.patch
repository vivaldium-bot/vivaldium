+
+        msg = self._decrypt(
+            jwe.headers["enc"], cek, jwe.ciphertext(),
+            jwe.b64_protected_header(),
+            jwe.initialization_vector(), jwe.authentication_tag())
+
+        if "zip" in self and self["zip"] == "DEF":
+            msg = zlib.decompress(msg)
+
+        return msg
