+    # should return None.
+    rewrite_params_hash2 = HashRewriteParameters(
+        src_obj2_metadata, dst_obj_metadata, 'full')
+
+    self.assertIsNone(ReadRewriteTrackerFile(tracker_file_name,
+                                             rewrite_params_hash2))
+    DeleteTrackerFile(tracker_file_name)
