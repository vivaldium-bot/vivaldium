+  def test_credentials_refresh_with_storage(self):
+    private_key = datafile('privatekey.%s' % self.format)
+    credentials = SignedJwtAssertionCredentials(
+        'some_account@example.com',
+        private_key,
+        scope='read+write',
+        sub='joe@example.org')
