+    self.assertEqual(pi1.proxy_port, pi2.proxy_port)
+    self.assertEqual(pi1.proxy_rdns, pi2.proxy_rdns)
+    self.assertEqual(pi1.proxy_user, pi2.proxy_user)
+    self.assertEqual(pi1.proxy_pass, pi2.proxy_pass)
