+                      contents='.OBJ2')
+    self.CreateObject(bucket_uri=bucket2_uri, object_name='obj4',
+                      contents='obj4')
+    self.CreateObject(bucket_uri=bucket2_uri, object_name='subdir/obj5',
+                      contents='subdir/obj5')
