+            'Received token response with no refresh_token. Consider '
+            "reauthenticating with approval_prompt='force'.")
+      token_expiry = None
+      if 'expires_in' in d:
+        token_expiry = datetime.datetime.utcnow() + datetime.timedelta(
+            seconds=int(d['expires_in']))
+
