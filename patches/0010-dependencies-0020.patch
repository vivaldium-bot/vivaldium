+class FloatField(Field):
+  """Field definition for float values."""
+
+  VARIANTS = frozenset([Variant.FLOAT,
+                        Variant.DOUBLE,
+                       ])
+
+  DEFAULT_VARIANT = Variant.DOUBLE
+
+  type = float
