+  // object
+  // will not be modified.
+  entry = shallowCloneObject(entry);
+  entry.params = shallowCloneObject(entry.params);
+
+  // Convert headers to an array.
+  var headers = [];
+  for (var key in entry.params.headers)
+    headers.push(key + ': ' + entry.params.headers[key]);
