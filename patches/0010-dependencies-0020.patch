+    stdout = self.RunGsUtil(['ls', '-L', suri(object_uri)], return_stdout=True)
+    self.assertRegexpMatches(stdout, r'Content-Type:\s+%s' % ct)
+    self.assertRegexpMatches(stdout, r'xyz:\s+abc')
