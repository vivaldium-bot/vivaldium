+
+    self.assertEquals(0, int(NotImportant.VALUE))
+
+  def testTooLargeInt(self):
+    """Test that numbers too large are rejected."""
+    self.assertRaises(messages.EnumDefinitionError,
+                      messages.Enum.def_enum,
