diff --git a/third_party/catapult/third_party/gsutil/third_party/pyasn1-modules/pyasn1_modules/rfc1902.py b/third_party/catapult/third_party/gsutil/third_party/pyasn1-modules/pyasn1_modules/rfc1902.py
