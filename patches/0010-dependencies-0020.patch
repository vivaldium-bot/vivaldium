+
+def PrintMessage(heading, eol='\n'):
+  sys.stdout.write('%s%s' % (heading, eol))
+  sys.stdout.flush()
+
+
+def WaitForEnter(timeout):
+  select.select([sys.stdin], [], [], timeout)
+
+
+def EnableTestMode():
+  def NoOp(*_, **__):  # pylint: disable=unused-argument
