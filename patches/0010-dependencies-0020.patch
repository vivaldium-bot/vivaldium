+    cors_out = self.RunGsUtil(self._get_cors_command + [suri(bucket_uri)],
+                              return_stdout=True)
+    self.assertEqual(json.loads(cors_out), self.cors_json_obj)
+
+    self.RunGsUtil(self._set_lifecycle_command + [lifecycle_path,
+                                                  suri(bucket_uri)])
+    cors_out = self.RunGsUtil(self._get_cors_command + [suri(bucket_uri)],
