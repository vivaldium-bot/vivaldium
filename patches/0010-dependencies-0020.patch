+assertInterpolation({
+  property: 'line-height',
+  from: '4vw',
+  to: '14vw'
+}, [
+  {at: -1, is: '0'},
+  {at: -0.3, is: '1vw'},
+  {at: 0, is: '4vw'},
+  {at: 0.3, is: '7vw'},
+  {at: 0.6, is: '10vw'},
+  {at: 1, is: '14vw'},
+  {at: 1.5, is: '19vw'},
+]);
