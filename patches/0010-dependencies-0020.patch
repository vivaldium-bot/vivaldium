+class PadStringTest(test_util.TestCase):
+
+  def testPadEmptyString(self):
+    self.assertEquals(' ' * 512, util.pad_string(''))
+
+  def testPadString(self):
+    self.assertEquals('hello' + (507 * ' '), util.pad_string('hello'))
