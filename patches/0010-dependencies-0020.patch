+                     'adb -s AG8404EC0444AGC shell ls /data/local/tmp')
+
+    command = util.construct_adb_shell_command(ATRACE_ARGS, DEVICE_SERIAL)
+    self.assertEqual(' '.join(command),
+                     'adb -s AG8404EC0444AGC shell atrace -z -t 10 -b 4096')
