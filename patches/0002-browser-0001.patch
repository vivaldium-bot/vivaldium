+- (void)swipeWithEvent:(NSEvent*)event {
+  CGFloat deltaX = [event deltaX];
+  unsigned int command = 0;
+  if (deltaX > 0.5) {
+    command = IDC_BACK;
+  } else if (deltaX < -0.5) {
+    command = IDC_FORWARD;
+  }
