+// Assumes all lowercase
+unichar NSFunctionKeyFromString(std::string& string) {
+  // NSXXXFunctionKeys are defined in NSEvent.h
+  unichar keyValue = 0;
+  size_t length = string.length();
+  if (length >= 2 && string[0] == 'f') {
