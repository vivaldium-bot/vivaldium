+<?xml version="1.0" ?><!DOCTYPE translationbundle><translationbundle lang="sw">
+<translation id="1001534784610492198">Kumbukumbu ya kisanidi imevurugika au ni batili. Tafadhali pakua Google Chrome tena.</translation>
