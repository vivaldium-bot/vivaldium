-    "$GNOME_DFL_APPS" \
-    "^[ 	]*<web-browsers>[ 	]*$" \
-    "@@INSTALLDIR@@/default-app-block"
-fi
+update_defaults_list "@@USR_BIN_SYMLINK_NAME@@.desktop"
