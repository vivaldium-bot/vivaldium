+    const SkPaint* saveLayerPaint1 = saveLayer1->paint();
+
+    if ((saveLayerPaint0 && !is_simple(*saveLayerPaint0)) ||
+        (saveLayerPaint1 && !is_simple(*saveLayerPaint1))) {
+        return false;
+    }
