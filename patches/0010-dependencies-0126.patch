diff --git a/third_party/mesa/src/src/gallium/state_trackers/egl/common/native_wayland_drm_bufmgr_helper.c b/third_party/mesa/src/src/gallium/state_trackers/egl/common/native_wayland_drm_bufmgr_helper.c
