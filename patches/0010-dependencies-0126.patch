index 0000000000000000000000000000000000000000..59cc4813fa5281c142fb331af4afcd62df6766cb
--- /dev/null
+++ b/third_party/skia/src/views/SkViewInflate.cpp
@@ -0,0 +1,145 @@
+
+/*
