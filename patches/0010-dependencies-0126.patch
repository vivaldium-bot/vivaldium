+    cbnz x8, _expand_picture_luma_loop2
+    //for the top and bottom expand
+    add x2, x2, #64
+    sub x0, x0, #32
+    madd x4, x1, x3, x0
+    sub x4, x4, x1
+_expand_picture_luma_loop0:
+    mov x5, #32
+    msub x5, x5, x1, x0
+    add x6, x4, x1
+    ld1 {v0.16b}, [x0], x10
+    ld1 {v1.16b}, [x4], x10
