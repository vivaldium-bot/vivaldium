+	D3D11_RECT scissor_rects[D3D11_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE];
+	D3D11_PRIMITIVE_TOPOLOGY primitive_topology;
+	DXGI_FORMAT index_format;
+	unsigned index_offset;
+	uint32_t strip_cut_index;
