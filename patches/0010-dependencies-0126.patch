+static void si_bind_vertex_elements(struct pipe_context *ctx, void *state)
+{
+	struct r600_context *rctx = (struct r600_context *)ctx;
+	struct si_vertex_element *v = (struct si_vertex_element*)state;
+
+	rctx->vertex_elements = v;
+}
