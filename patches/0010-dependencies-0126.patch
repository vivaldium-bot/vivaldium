diff --git a/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_ocspcertid.c b/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_ocspcertid.c
