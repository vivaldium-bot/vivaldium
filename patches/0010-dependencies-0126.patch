+        fInvalEventIsPending = false;
+        const SkIRect& r = this->getDirtyBounds();
+        [(SkUIView*)fHWND postInvalWithRect:&r];
+        return true;
+    }
+    if ([(SkUIView*)fHWND onHandleEvent:evt]) {
+        return true;
+    }
+    return this->INHERITED::onEvent(evt);
