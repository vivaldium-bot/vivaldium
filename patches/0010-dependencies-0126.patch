+    paint.setImageFilter(xfermodeNoBg);
+    canvas->drawSprite(bitmap, 0, 0, &paint);
+    canvas->readPixels(info, &pixel, 4, 0, 0);
+    REPORTER_ASSERT(reporter, pixel == SK_ColorGREEN);
+
+    paint.setImageFilter(xfermodeNoFgNoBg);
+    canvas->drawSprite(bitmap, 0, 0, &paint);
