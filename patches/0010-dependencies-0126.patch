diff --git a/third_party/nss/nss/lib/pkcs7/p7create.c b/third_party/nss/nss/lib/pkcs7/p7create.c
new file mode 100644
index 0000000000000000000000000000000000000000..983b7b541f00d286c14676172dbbd41d462ad92e
--- /dev/null
+++ b/third_party/nss/nss/lib/pkcs7/p7create.c
