+++ b/third_party/mesa/src/src/gallium/drivers/softpipe/sp_texture.c
@@ -0,0 +1,509 @@
+/**************************************************************************
+ * 
+ * Copyright 2006 Tungsten Graphics, Inc., Cedar Park, Texas.
