+{
+    this->setText(text, strlen(text));
+}
+
+void SkStaticTextView::setText(const char text[], size_t len)
+{
+    if (!fText.equals(text, len))
+    {
+        fText.set(text, len);
+        this->computeSize();
+        this->inval(NULL);
+    }
+}
+
+void SkStaticTextView::getPaint(SkPaint* paint) const
+{
+    if (paint)
+        *paint = fPaint;
+}
