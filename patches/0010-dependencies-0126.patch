+WELS_EXTERN DeblockLumaLt4V_ssse3
+    push        rbp
+    mov         r11,[rsp + 16 + 20h]  ; pTC
+    PUSH_XMM 16
+    sub         rsp,1B0h
+    lea         rbp,[rsp+20h]
+    movd        xmm4,r8d
+    movd        xmm2,r9d
+    mov         qword [rbp+180h],r12
