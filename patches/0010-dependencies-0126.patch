+
+void inflate_paint(const SkDOM& dom, const SkDOM::Node* node, SkPaint* paint)
+{
+    SkASSERT(paint);
+
+    SkAnimator    anim;
+    SkCanvas    canvas;
+
+    if (!anim.decodeDOM(dom, node))
+    {
+        SkDEBUGF(("inflate_paint: decoding dom failed\n"));
+        SkDEBUGCODE(dom.dump(node);)
+        sk_throw();
+    }
+    anim.draw(&canvas, paint, 0);
