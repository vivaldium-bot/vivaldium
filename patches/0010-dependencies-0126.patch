+void init_skin_paint(SkinEnum se, SkPaint* paint)
+{
+    SkASSERT(paint);
+
+    SkAnimator    anim;
+    SkCanvas    canvas;
+
+    init_skin_anim(se, &anim);
+    anim.draw(&canvas, paint, 0);
