diff --git a/third_party/mesa/src/src/gallium/drivers/softpipe/sp_fs_exec.c b/third_party/mesa/src/src/gallium/drivers/softpipe/sp_fs_exec.c
new file mode 100644
index 0000000000000000000000000000000000000000..3793d9b3613d1c57d75899d427e04a6ca00864d1
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/softpipe/sp_fs_exec.c
@@ -0,0 +1,207 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including
+ * without limitation the rights to use, copy, modify, merge, publish,
