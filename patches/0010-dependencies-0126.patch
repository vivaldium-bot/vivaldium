+struct c_string
+{
+	const char* p;
+	c_string(const char* p)
+	: p(p)
+	{}
+
+	operator const char*() const
+	{
+		return p;
+	}
+};
+
+static inline bool operator ==(const c_string& a, const c_string& b)
+{
+	return !strcmp(a.p, b.p);
+}
+
+static inline bool operator !=(const c_string& a, const c_string& b)
+{
