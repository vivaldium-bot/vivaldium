+# it for Chromium.
+
+# Make the script exit as soon as something fails.
+set -ex
+
+# We only need the nss/lib directory, but hg requires us to check out the
+# complete nss source tree.
+rm -rf nss
+hg clone -u NSS_3_23_RTM https://hg.mozilla.org/projects/nss
