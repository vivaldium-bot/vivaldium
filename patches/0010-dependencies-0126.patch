+static void assert_count(skiatest::Reporter* reporter, const SkClipStack& stack,
+                         int count) {
+    SkClipStack::B2TIter iter(stack);
+    int counter = 0;
+    while (iter.next()) {
+        counter += 1;
+    }
+    REPORTER_ASSERT(reporter, count == counter);
+}
