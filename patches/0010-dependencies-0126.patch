+static void oneOff(skiatest::Reporter* reporter, int outer, int inner) {
+    const SkDCubic& cubic1 = testSet[outer];
+    const SkDCubic& cubic2 = testSet[inner];
+    oneOff(reporter, cubic1, cubic2, false);
+}
