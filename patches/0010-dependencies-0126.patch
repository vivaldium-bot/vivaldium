+    intersectionFinder(0, 1, 0.855895664, 0.864850875, t1Step, t2Step);
+    intersectionFinder(0, 1, 0.865207906, 0.865207887, t1Step, t2Step);
+    intersectionFinder(0, 1, 0.865213351, 0.865208087, t1Step, t2Step);
+}
