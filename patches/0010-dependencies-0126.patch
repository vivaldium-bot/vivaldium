+%macro SSE41_GetX38x4SatdH  3
+    movq        xmm0,   [r6+%3+8*%1]
+    punpcklqdq  xmm0,   xmm0
+    psubsw      xmm0,   xmm7
+    pabsw       xmm0,   xmm0
+    paddw       xmm5,   xmm0
+    pabsw       xmm1,   xmm1
+    pabsw       xmm2,   xmm2
