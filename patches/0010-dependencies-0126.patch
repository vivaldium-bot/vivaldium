--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/egl/gdi/native_gdi.c
@@ -0,0 +1,429 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.9
+ *
