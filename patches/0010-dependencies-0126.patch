+    mov x9, x2
+    mov x11, #15
+    bic x2, x2, x11
+    //
+    sub x0, x0, #16
+    madd x4, x1, x3, x0
+    sub x4, x4, x1
+_expand_picture_chroma_loop0:
+    mov x5, #16
+    msub x5, x5, x1, x0
+    add x6, x4, x1
+    ld1 {v0.16b}, [x0], x10
+    ld1 {v1.16b}, [x4], x10
+
+    mov x8, #16
+_expand_picture_chroma_loop1:
+    st1 {v0.16b}, [x5], x1
+    st1 {v1.16b}, [x6], x1
+    sub x8, x8, #1
+    cbnz x8, _expand_picture_chroma_loop1
+
+    sub x2, x2, #16
+    cbnz x2, _expand_picture_chroma_loop0
+
+    and x9, x9, #15
+    sub x9, x9, #8
+    cbnz x9, _expand_picture_chroma_end
+    mov x5, #16
+    msub x5, x5, x1, x0
+    add x6, x4, x1
+    ld1 {v0.8b}, [x0]
+    ld1 {v1.8b}, [x4]
+
+    mov x8, #16
+_expand_picture_chroma_loop3:
+    st1 {v0.8b}, [x5], x1
+    st1 {v1.8b}, [x6], x1
+    sub x8, x8, #1
+    cbnz x8, _expand_picture_chroma_loop3
+_expand_picture_chroma_end:
+
+WELS_ASM_AARCH64_FUNC_END
