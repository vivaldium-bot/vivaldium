+    vst1.u8 d6, [r2], r3
+
+    vmull.u8        q3, d2, d28         //(src[x] * A)
+    vmlal.u8        q3, d3, d29         //+=(src[x+1] * B)
+    vmlal.u8        q3, d4, d30         //+=(src[x+stride] * C)
+    vmlal.u8        q3, d5, d31         //+=(src[x+stride+1] * D)
+    vrshrn.u16      d6, q3, #6
+    vst1.u8 d6, [r2], r3
+
+    vmov        q0, q2
+    sub         r5, #2
+    cmp         r5, #0
+    bne         w8_mc_chroma_loop
+
+    pop     {r4, r5}
