+static INLINE struct trace_transfer *
+trace_transfer(struct pipe_transfer *transfer)
+{
+   if(!transfer)
+      return NULL;
+   (void)trace_resource(transfer->resource);
+   return (struct trace_transfer *)transfer;
+}
+
+
+struct pipe_resource *
