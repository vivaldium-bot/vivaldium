+                IntersectData& data = dataArray[index2 + index3];
+                SkPoint* temp = (SkPoint*) SkOpTAllocator<FourPoints>::Allocate(&allocator);
+                for (int idx2 = 0; idx2 < data.fPtCount; ++idx2) {
+                    temp[idx2] = data.fPts.fPts[idx2].asSkPoint();
