+  uiPixelFilterT[7] = ((pPred[6 - kiStride] + pPred[7 - kiStride] * 3 + 2) >> 2);
+  for (i = 8; i < 16; i++) {
+    uiPixelFilterT[i] = pPred[7 - kiStride];
+  }
+
+  for (i = 0; i < 8; i++) { // y
+    for (j = 0; j < 8; j++) { // x
