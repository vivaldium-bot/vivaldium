+WELS_ASM_AARCH64_FUNC_BEGIN ExpandPictureChroma_AArch64_neon
+    //Save the dst
+    mov x7, x0
+    mov x8, x3
+    mov x10, #16
+    add x4, x7, x2
+    sub x4, x4, #1
+    //For the left and right expand
+_expand_picture_chroma_loop2:
+    sub x5, x7, #16
+    add x6, x4, #1
+
+    ld1r {v0.16b}, [x7], x1
+    ld1r {v1.16b}, [x4], x1
+
+    st1 {v0.16b}, [x5]
+    st1 {v1.16b}, [x6]
+    sub x8, x8, #1
+    cbnz x8, _expand_picture_chroma_loop2
