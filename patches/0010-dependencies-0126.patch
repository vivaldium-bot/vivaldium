+    void onCopyOnWrite(ContentChangeMode mode) override {
+        if (mode == SkSurface::kDiscard_ContentChangeMode) {
+            fCOWDiscardCount++;
+        } else {
+            fCOWRetainCount++;
+        }
+    }
+
+    void onDiscard() override {
+        fDiscardCount++;
+    }
