+/*
+ * make known fixed PKCS #11 key types to their sizes in bytes
+ */	
+unsigned long
+sftk_MapKeySize(CK_KEY_TYPE keyType) 
+{
+    switch (keyType) {
+    case CKK_CDMF:
+	return 8;
+    case CKK_DES:
+	return 8;
+    case CKK_DES2:
+	return 16;
+    case CKK_DES3:
+	return 24;
+    /* IDEA and CAST need to be added */
+    default:
+	break;
+    }
+    return 0;
+}
