+    SkAutoTDelete<SkStream> stream(SkStream::NewFromFile(path));
+    if (!stream.get()) {
+        SkDEBUGF(("init_skin_anim: loading skin failed <%s>\n", path));
+        sk_throw();
+    }
+
+    if (!anim->decodeStream(stream)) {
+        SkDEBUGF(("init_skin_anim: decoding skin failed <%s>\n", path));
+        sk_throw();
