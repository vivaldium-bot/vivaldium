+%macro SSE41_I16X16GetX38x4SatdDC 0
+    pxor        xmm0,   xmm0
+    movq2dq     xmm0,   mm4
+    punpcklqdq  xmm0,   xmm0
+    psubsw      xmm0,   xmm7
+    pabsw       xmm0,   xmm0
