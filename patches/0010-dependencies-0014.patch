+    def testEquailtyInListInvalid(self):
+        o1 = self.AlwaysComparesTrue()
+        o2 = self.AlwaysComparesTrue()
+        isa_list = [mox.Is(o1), mox.Is(o2)]
+        mixed_list = [o2, o1]
