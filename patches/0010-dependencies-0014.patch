--- /dev/null
+++ b/third_party/boringssl/src/third_party/googletest/Makefile.am
@@ -0,0 +1,339 @@
+# Automake file
+
+ACLOCAL_AMFLAGS = -I m4
+
+# Nonstandard package files for distribution
+EXTRA_DIST = \
+  CHANGES \
