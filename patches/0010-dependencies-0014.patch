+import collections
+import mock
+import unittest
+
+from telemetry.internal.backends import android_app_backend
+from devil.android.sdk import intent as intent_module
+
+
+_FakeAndroidProcess = collections.namedtuple(
+    'AndroidProcess', ['app_backend', 'pid', 'name'])
