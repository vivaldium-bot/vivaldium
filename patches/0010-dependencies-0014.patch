+// BN_* compatability wrappers
+
+static int BN_to_fe(fe out, const BIGNUM *bn) {
+  uint8_t tmp[NBYTES];
+  if (!BN_bn2le_padded(tmp, NBYTES, bn)) {
+    return 0;
+  }
+  fe_frombytes(out, tmp);
+  return 1;
+}
+
+static BIGNUM *fe_to_BN(BIGNUM *out, const fe in) {
+  uint8_t tmp[NBYTES];
+  fe_tobytes(tmp, in);
+  return BN_le2bn(tmp, NBYTES, out);
+}
