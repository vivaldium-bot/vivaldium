+    this.referenceIndex = referenceIndex;
+    this.useLargeLinePlots = useLargeLinePlots;
+    this.children = [];
+
+    this.tableRow = $('<tr class="highlight">' +
+                            '<td class="test collapsed" >' +
+                                this.test.name() +
+                            '</td>' +
+                            '<td class="unit">' +
+                                this.test.unit() +
+                            '</td>' +
+                      '</tr>');
+
+    var runIndex = 0;
+    var results = this.test.results();
+    var referenceResult = undefined;
+
+    this.resultIndexMap = {};
