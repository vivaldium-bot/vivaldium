+         '--test-launcher-print-test-stdio=always '
+         '--enable-gpu'),
+        bisect_bot='winx64nvidia_perf_bisect',
+        suite='performance_browser_tests')
+
+  def testGuessMetric_SummaryMetricWithNoTIRLabel(self):
