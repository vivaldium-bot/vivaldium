+    self.filesystem.CreateDirectory(full_dirname)
+    self.os.chdir(dir1)
+    self.os.chdir(dir2)
+    self.assertEqual(self.os.getcwd(), self.os.path.sep + full_dirname)
+
+  def testBackwardsChdir(self):
+    """chdir into '..' should behave appropriately."""
+    rootdir = self.os.getcwd()
