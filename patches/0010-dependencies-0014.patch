+  EXPECT_FALSE(ConnectClientAndServer(&client, &server, ssl3_ctx.get(),
+                                      tls_ctx.get()));
+  err = ERR_get_error();
+  EXPECT_EQ(ERR_LIB_SSL, ERR_GET_LIB(err));
