+                 [348198, 22847], [348224, 25224]],
+        'color': 0,
+        'id': 'bottom_0',
+        'lines': {
+          'fill': 0.2,
+          'lineWidth': 0,
+          'show': true
+        }
+      },
+      {
+        'fillBetween': 'line_0',
