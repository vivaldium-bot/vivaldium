+
+def AdjustFdLimit(new_soft_limit, new_hard_limit):
+  """Sets a new soft and hard limit for max number of fds."""
+  import resource
+  resource.setrlimit(resource.RLIMIT_NOFILE, (new_soft_limit, new_hard_limit))
