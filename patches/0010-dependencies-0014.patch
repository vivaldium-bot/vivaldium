+    else:
+      self.assertEqual(1, len(sheriffs))
+      self.assertEqual('external', sheriffs[0].key.string_id())
+      self.assertEqual('foo@chromium.org', sheriffs[0].email)
+
+  def testQuery_NoUser_InternalOnlyNotFetched(self):
