+          const req = simple_xhr.send(
+              '/graph_json',
+              {'graphs': JSON.stringify(params)},
+              function(json) {
+                if (this.jsonHasData(json)) {
+                  this.updateJson(json, isSelected);
+                } else if (isSelected) {
+                  this.addWarnings('No data available.');
+                  this.checkForInternalUser();
+                  this.updateChart();
+                }
