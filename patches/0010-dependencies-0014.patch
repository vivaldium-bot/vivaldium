+    self.assertIsNone(agent.trace_config_file)
+    # robust to multiple file removal
+    agent._RemoveTraceConfigFile()
+    self.assertFalse(os.path.exists(config_file_path))
+    self.assertIsNone(agent.trace_config_file)
