+def _MakeStorySet():
+  ps = story.StorySet(base_dir=os.path.dirname(__file__))
+  ps.AddStory(page_module.Page('http://www.foo.com/', ps, ps.base_dir))
+  ps.AddStory(page_module.Page('http://www.bar.com/', ps, ps.base_dir))
+  return ps
