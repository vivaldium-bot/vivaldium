+            '_winapi',
+            'msvcrt',
+            'winreg',
+            '_subprocess',
+         ])
+
+    if not sys.platform == 'riscos':
+        excludes.update([
+             'riscosenviron',
+             #'riscospath',
+             'rourl2path',
