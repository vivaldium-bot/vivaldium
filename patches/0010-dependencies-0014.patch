+       */
+      function getDateDisplay(rev) {
+        const timestampSecondsRegex = /^[\d]{10}$/;
+        const timestampMillisecondsRegex = /^[\d]{13}$/;
+        let d = null;
+        if (timestampSecondsRegex.test(rev)) {
+          d = new Date(rev * 1000);
+        } else if (timestampMillisecondsRegex.test(rev)) {
+          d = new Date(rev);
+        }
+        if (d) {
+          return d.toLocaleString();
+        }
+        return null;
+      }
