+            if (rowA.sortValue === rowB.sortValue) {
+                // Sort identical values by name to keep the sort stable,
+                // always keep name alphabetical (even if a & b sort values
+                // are invalid)
+                return rowA.test.name() > rowB.test.name() ? 1 : -1;
+            }
