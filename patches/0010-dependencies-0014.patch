+                '[  FAILED  ]  http://www.baz.com/\n\n'
+                '2 FAILED TESTS\n\n' % (exception_trace, exception_trace))
+    self.assertEquals(expected, ''.join(self._output_stream.output_data))
+
+  def testStreamingResults(self):
