+        data = p.communicate()[0]
+        if sys.version_info[0] != 2:
+            data = data.decode('UTF-8')
+        data = data.strip()
+
+        if data.endswith(' refs]'):
+            # with --with-pydebug builds
+            data = data.rsplit('\n', 1)[0].strip()
+
+        sts = p.wait()
+
+        if sts != 0:
+            print (data)
