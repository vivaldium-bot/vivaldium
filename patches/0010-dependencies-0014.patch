+		}
+
+		okm := hkdfExpand(tt.hash.New, tt.prk, tt.info, len(tt.okm))
+		if !bytes.Equal(okm, tt.okm) {
+			t.Errorf("%d. got hkdfExpand(%x, %x, %d) = %x; wanted %x", i+1, tt.prk, tt.info, len(tt.okm), okm, tt.okm)
+		}
+	}
