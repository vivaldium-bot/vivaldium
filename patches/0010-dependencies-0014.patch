+      def RunStory(self, results):
+        self._current_story.Run(self)
+
+      def DidRunStory(self, results):
+        pass
+
+      def CanRunStory(self, story):
+        return True
+
+      def TearDownState(self):
+        pass
+
+      def DumpStateUponFailure(self, story, results):
+        pass
