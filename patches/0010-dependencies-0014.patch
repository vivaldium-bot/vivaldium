+class AndroidPowerMonitorControllerTest(unittest.TestCase):
+  @mock.patch.object(battery_utils, 'BatteryUtils')
+  def testComposition(self, _):
+
+    class P1(power_monitor.PowerMonitor):
+      def StartMonitoringPower(self, browser):
