+    self.assertEqual('download_path2', cs_info._download_path)
+    self.assertEqual('cs_remote_path2', cs_info._cs_remote_path)
+
+    dep_info1.Update(dep_info3)
+    self.assertEqual('dep1', dep_info1.dependency)
