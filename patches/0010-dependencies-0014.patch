+void ssl_get_current_time(const SSL *ssl, struct OPENSSL_timeval *out_clock) {
+  // TODO(martinkr): Change callers to |ssl_ctx_get_current_time| and drop the
+  // |ssl| arg from |current_time_cb| if possible.
