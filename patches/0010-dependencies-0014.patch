+
+  def testStartTracingWithoutCollection(self):
+    self._inspector_socket.AddResponseHandler('Tracing.start', lambda req: {})
+    self._inspector_socket.AddEvent(
+        'Tracing.dataCollected', {'value': [{'ph': 'B'}]}, 1)
