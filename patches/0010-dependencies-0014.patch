+    self.assertIn('Chrome Performance Dashboard', response.body)
+
+  def testGet_OldUri(self):
+    expected_state = {
+        'charts': [
+            [['ChromiumGPU/linux/scrolling/num_layers', ['num_layers']]],
+            [['ChromiumGPU/linux/scrolling/num_layers/about.com',
