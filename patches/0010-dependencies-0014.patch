+    vtune_profiler.subprocess = mock_subprocess
+
+    try:
+      # pylint: disable=protected-access
+      profiler = vtune_profiler.VTuneProfiler(self._browser._browser_backend,
+                                              self._browser._platform_backend,
+                                              'tmp',
