+
+    def importModule(self, name):
+        if '.' in name:
+            script = textwrap.dedent("""\
+                try:
+                    import %s
+                except ImportError:
+                    import %s
+                print (%s.__name__)
+            """) %(name, name.rsplit('.', 1)[0], name)
+        else:
+            script = textwrap.dedent("""\
+                import %s
+                print (%s.__name__)
+            """) %(name, name)
+
+        p = subprocess.Popen([sys.executable, '-c', script],
+                stdout=subprocess.PIPE,
