+  def __init__(self, package):
+    super(ChromeBackendSettings, self).__init__(
+        activity='com.google.android.apps.chrome.Main',
+        cmdline_file=None,
+        package=package,
+        pseudo_exec_name='chrome',
+        supports_tab_control=True)
