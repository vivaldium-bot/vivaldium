index 0000000000000000000000000000000000000000..9ab08d881c552877090315192d30629210a9d759
--- /dev/null
+++ b/third_party/catapult/telemetry/third_party/web-page-replay/third_party/dns/rdtypes/IN/IPSECKEY.py
@@ -0,0 +1,159 @@
+# Copyright (C) 2006, 2007, 2009, 2010 Nominum, Inc.
+#
+# Permission to use, copy, modify, and distribute this software and its
+# documentation for any purpose with or without fee is hereby granted,
+# provided that the above copyright notice and this permission notice
+# appear in all copies.
+#
