+  def GetPsOutput(self, columns, pid=None):
+    assert columns == ['pid', 'name'] or columns == ['pid'], \
+        'Only know how to return pid and name. Requested: ' + columns
+    cmd = ['ps']
+    if pid:
+      cmd.extend(['-p', str(pid)])
+    ps = self._device.RunShellCommand(cmd, large_output=True)[1:]
+    output = []
+    for line in ps:
+      data = line.split()
+      curr_pid = data[1]
+      curr_name = data[-1]
+      if columns == ['pid', 'name']:
+        output.append([curr_pid, curr_name])
+      else:
+        output.append([curr_pid])
