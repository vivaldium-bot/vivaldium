+  // Test changing the write FD partway through.
+  ssl.reset(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  EXPECT_TRUE(SSL_set_fd(ssl.get(), 1));
+  EXPECT_TRUE(SSL_set_wfd(ssl.get(), 2));
