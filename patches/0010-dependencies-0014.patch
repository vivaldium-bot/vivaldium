+      return
+
+    self._files.append(
+        'C:\\Program Files(x86)\\Vivaldi\\Vivaldi\\Application\\vivaldi.exe')
+    self._path_stubs.os.program_files_x86 = 'C:\\Program Files(x86)'
+    self.assertIn('system', self.DoFindAllTypes())
