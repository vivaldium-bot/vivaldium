+      <template is="dom-if" if="[[error]]">
+        <p class="error">[[error]]
+      </template>
+      <template is="dom-if" if="[[!error]]">
+        <div>
+          <slot></slot>
+        </div>
+      </template>
+    </div>
+  </template>
+
+  <script>
+    'use strict';
+    Polymer({
+      is: 'loading-wrapper',
+
+      properties: {
+        loading: {
+          type: Boolean,
+          value: true,
+        },
+
+        error: {
+          type: String,
+          value: '',
+        },
+
+        xsrfToken: {
+          type: String,
+          value: ''
+        }
+      },
+
+      async load(url, params) {
+        this.loading = true;
+        try {
+          const response = await simple_xhr.asPromise(url, params);
+          this.xsrfToken = response.xsrf_token;
+          return response;
+        } catch (err) {
+          this.error = err;
+        } finally {
+          this.loading = false;
+        }
+      }
+    });
+  </script>
+</dom-module>
