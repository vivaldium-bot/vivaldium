+
+
+class TestGPUInfo(unittest.TestCase):
+
+  def testConstruction(self):
+    data = {
+        'devices': [
+            {'vendor_id': 1000, 'device_id': 2000,
+             'vendor_string': 'a', 'device_string': 'b'},
+            {'vendor_id': 3000, 'device_id': 4000,
+             'vendor_string': 'k', 'device_string': 'l'}
+        ],
+        'aux_attributes': {
