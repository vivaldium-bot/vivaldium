+        description: {
+          notify: true,
+          type: String,
+        },
+        direction: {
+          notify: true,
+          type: String,
+        },
+        path: {
+          notify: true,
+          type: String,
+        },
+        units: {
+          notify: true,
+          type: String,
+        },
+      },
+
+      openTooltip(event) {
+        this.$.tooltip.positionTarget = event.target;
+        this.$.tooltip.open();
+      },
+    });
