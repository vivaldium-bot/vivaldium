+class LinuxFindTest(fake_filesystem_unittest.TestCase):
+
+  def setUp(self):
+    if not platform.GetHostPlatform().GetOSName() == 'linux':
+      self.skipTest('Not running on Linux')
+    self.setUpPyfakefs()
