+  iAncMvp[1] = sDqLayer.pMv[0][LEFT_MB_IDX][LEFT_MB_BLK][1];
+  TEST_SKIP_MV_PRED;
+  //CASE 4.1.1.2: All I
+  for (i = 0; i < iTotalMbNum; ++i) {
+    sDqLayer.pMbType[i] = MB_TYPE_INTRA16x16;
+  }
+  //CASE 4.1.1.2.1: left P, expect mvp = left mv
