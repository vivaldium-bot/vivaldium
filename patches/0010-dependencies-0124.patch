+++ b/third_party/mesa/src/src/mesa/state_tracker/st_draw_feedback.c
@@ -0,0 +1,273 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
