+   switch (format) {
+      case GL_DEPTH24_STENCIL8_EXT:
+      case GL_DEPTH_STENCIL_EXT:
+      case GL_DEPTH32F_STENCIL8:
+         return GL_TRUE;
+      default:
+         return GL_FALSE;
+   }
+}
