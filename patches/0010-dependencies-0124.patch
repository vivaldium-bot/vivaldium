+#define TEST_SKIP_MV_PRED \
+  PredPSkipMvFromNeighbor (&sDqLayer, iWelsMvp); \
+  bOK = ((iWelsMvp[0] == iAncMvp[0]) && (iWelsMvp[1] == iAncMvp[1])); \
+  EXPECT_EQ (bOK, true);
