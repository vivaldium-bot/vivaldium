index 0000000000000000000000000000000000000000..f62d09b3769012f4878ba8e3e14712401e7a8703
--- /dev/null
+++ b/third_party/openh264/src/test/processing/ProcessUT_VaaCalc.cpp
@@ -0,0 +1,847 @@
+#include <gtest/gtest.h>
+#include "cpu.h"
+#include "cpu_core.h"
+#include "util.h"
+#include "macros.h"
