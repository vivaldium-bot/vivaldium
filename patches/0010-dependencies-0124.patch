+++ b/third_party/mesa/src/src/mesa/main/es_generator.py
@@ -0,0 +1,765 @@
+#*************************************************************************
+# Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+# All Rights Reserved.
+#
