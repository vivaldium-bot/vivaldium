new file mode 100644
index 0000000000000000000000000000000000000000..abb3baebd84b3dc841fef48c05fb7f92631dfce1
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vpxenc.c
@@ -0,0 +1,2263 @@
+/*
