+  const uint8_t kuiHD8 = (1 + kuiL2 + kuiL3) >> 1;
+  const uint8_t kuiHD9 = (2 + kuiL1 + (kuiL2 << 1) + kuiL3) >> 2;
+  ENFORCE_STACK_ALIGN_1D (uint8_t, uiV, 16, 16) // TobeCont'd about assign opt as follows
+  uiV[0] = uiV[6] = kuiHD0;
+  uiV[1] = uiV[7] = kuiHD1;
+  uiV[2] = kuiHD2;
+  uiV[3] = kuiHD3;
+  uiV[4] = uiV[10] = kuiHD4;
+  uiV[5] = uiV[11] = kuiHD5;
+  uiV[8] = uiV[14] = kuiHD6;
