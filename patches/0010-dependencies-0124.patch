+  sDqLayer.iMbXyIndex = sDqLayer.iMbY * sDqLayer.iMbWidth + sDqLayer.iMbX;
+  for (i = 0; i < iTotalMbNum; ++i) {  // All I MB
+    sDqLayer.pMbType[i] = MB_TYPE_INTRA16x16;
