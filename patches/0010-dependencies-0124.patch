+  EXPECT_FLOAT_EQ(muxer_mm.g()->x(), parser_mm->g->x);
+  EXPECT_FLOAT_EQ(muxer_mm.g()->y(), parser_mm->g->y);
+  EXPECT_FLOAT_EQ(muxer_mm.b()->x(), parser_mm->b->x);
