index 0000000000000000000000000000000000000000..580f95df3ee6b61cbd81c1e31bb34839efbf31a0
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/tnl/t_vertex.c
@@ -0,0 +1,565 @@
+/*
