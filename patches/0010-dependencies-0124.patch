+SkImageGenerator* SkImageGenerator::NewFromEncoded(SkData* data) {
+    if (NULL == data) {
+        return NULL;
+    }
+    if (gFactory) {
+        if (SkImageGenerator* generator = gFactory(data)) {
+            return generator;
+        }
+    }
+    return SkImageGenerator::NewFromEncodedImpl(data);
+}
