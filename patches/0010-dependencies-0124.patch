index 0000000000000000000000000000000000000000..8a38308052d5bc772dc91df426d220a1886eafb4
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/vbo/vbo_split_inplace.c
@@ -0,0 +1,295 @@
+
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5
+ *
+ * Copyright (C) 1999-2006  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
