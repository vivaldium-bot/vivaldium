+void MotionEstimateTest::DoLineTest (PLineFullSearchFunc func, bool vertical) {
+  const int32_t kiMaxBlock16Sad = 72000;//a rough number
+  SWelsFuncPtrList sFuncList;
+  SWelsME sMe;
+
+  const uint8_t kuiQp = rand() % 52;
