+  const char* table1 = "inpos_pass0.ctb";
+  const char* table2 = "inpos_pass0.ctb,inpos_pass1.ctb";
+  const char* table3 = "inpos_pass0.ctb,inpos_pass1.ctb,inpos_pass2.ctb";
