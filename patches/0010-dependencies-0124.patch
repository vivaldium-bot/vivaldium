index 0000000000000000000000000000000000000000..a3d032f4a0f106ff7bc59e4dbf5aa0a39b330481
--- /dev/null
+++ b/third_party/skia/src/gpu/effects/GrConvexPolyEffect.cpp
@@ -0,0 +1,374 @@
+/*
