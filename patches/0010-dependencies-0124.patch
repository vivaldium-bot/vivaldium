+/* Mesa version */
+#define MESA_MAJOR 9
+#define MESA_MINOR 0
+#define MESA_PATCH 3
+#define MESA_VERSION_STRING "9.0.3"
+
+/* To make version comparison easy */
+#define MESA_VERSION(a,b,c) (((a) << 16) + ((b) << 8) + (c))
+#define MESA_VERSION_CODE MESA_VERSION(MESA_MAJOR, MESA_MINOR, MESA_PATCH)
+
+
