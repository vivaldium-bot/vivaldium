diff --git a/third_party/mesa/src/src/mesa/swrast_setup/ss_context.c b/third_party/mesa/src/src/mesa/swrast_setup/ss_context.c
new file mode 100644
index 0000000000000000000000000000000000000000..9c013a45400e32ac8103950e59d716305710ee65
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast_setup/ss_context.c
@@ -0,0 +1,302 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
+ * Copyright (C) 1999-2007  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
