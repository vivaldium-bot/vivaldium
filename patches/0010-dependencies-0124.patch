+   GLenum Target;               /**< GL_TEXTURE_1D, GL_TEXTURE_2D, etc. */
+
+   struct gl_sampler_object Sampler;
+
+   GLenum DepthMode;		/**< GL_ARB_depth_texture */
+
+   GLfloat Priority;		/**< in [0,1] */
