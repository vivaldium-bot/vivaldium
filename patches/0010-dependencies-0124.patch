new file mode 100644
index 0000000000000000000000000000000000000000..3aa50c9d4d65c8bd59839222025d716bc898c769
--- /dev/null
+++ b/third_party/skia/src/gpu/GrAutoLocaleSetter.h
@@ -0,0 +1,64 @@
+/*
