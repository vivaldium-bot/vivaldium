index 0000000000000000000000000000000000000000..e413aee61ed42ddf139436d3bd42ff5f8acd1b08
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/x86/x86_cliptest.S
@@ -0,0 +1,407 @@
+
