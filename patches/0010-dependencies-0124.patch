+#include "SkData.h"
+#include "SkTRegistry.h"
+#include "SkTypes.h"
+#include <stdlib.h>
+
+class Fuzz : SkNoncopyable {
+public:
+    explicit Fuzz(SkData*);
+
+    uint8_t  nextB();
+    uint32_t nextU();
+    float    nextF();
+
+private:
