+      iSumSad += abs (pPixA[j] - pPixB[j + 1]); \
+      iSumSad += abs (pPixA[j] - pPixB[j - m_iStrideB]); \
+      iSumSad += abs (pPixA[j] - pPixB[j + m_iStrideB]); \
+    } \
+    pPixA += m_iStrideA; \
+    pPixB += m_iStrideB; \
+  } \
+  func (m_pPixSrcA, m_iStrideA, m_pPixSrcB + m_iStrideB, m_iStrideB, m_pSad); \
+  EXPECT_EQ (m_pSad[0] + m_pSad[1] + m_pSad[2] + m_pSad[3], iSumSad); \
