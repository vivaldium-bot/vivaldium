index 0000000000000000000000000000000000000000..a1d8ee67dbea3d2369a3e4532701409e4137cddf
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/x86/gen_matypes.c
@@ -0,0 +1,241 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5.1
+ *
+ * Copyright (C) 1999-2006  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
