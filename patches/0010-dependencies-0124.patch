+  eRet = (CM_RETURN) m_pDec->GetOption (DECODER_OPTION_DATAFORMAT, &iOutput);
+  EXPECT_EQ (eRet, cmResultSuccess);
+  EXPECT_EQ ((int32_t) videoFormatI420, iOutput);
+
+  //Uninitialize, no GetOption can be done
+  m_pDec->Uninitialize();
