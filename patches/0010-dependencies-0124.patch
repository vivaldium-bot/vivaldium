index 0000000000000000000000000000000000000000..71281d57589a940eef23b74409c81f72fc14e077
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/math/m_vector.h
@@ -0,0 +1,92 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.3
