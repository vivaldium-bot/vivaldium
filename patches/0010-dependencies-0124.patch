+int32_t SkNextColorCubeUniqueID() {
+    static int32_t gColorCubeUniqueID;
+    // do a loop in case our global wraps around, as we never want to return a 0
+    int32_t genID;
+    do {
+        genID = sk_atomic_inc(&gColorCubeUniqueID) + 1;
+    } while (0 == genID);
