+++ b/third_party/liblouis/src/tools/lou_checkhyphens.c
@@ -0,0 +1,238 @@
+/* liblouis Braille Translation and Back-Translation Library
+
+   Based on the Linux screenreader BRLTTY, copyright (C) 1999-2006 by
