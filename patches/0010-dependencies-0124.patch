+   const GLuint unit = ctx->Array.ActiveTexture;
+   ASSERT_OUTSIDE_BEGIN_END_AND_FLUSH(ctx);
+
+   update_array(ctx, "glTexCoordPointer", VERT_ATTRIB_TEX(unit),
+                legalTypes, sizeMin, 4,
+                size, type, stride, GL_FALSE, GL_FALSE,
+                ptr);
+}
