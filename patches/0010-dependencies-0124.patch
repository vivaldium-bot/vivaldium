+static void GLAPIENTRY
+vbo_exec_MultiDrawElementsBaseVertex(GLenum mode,
+				     const GLsizei *count, GLenum type,
+				     const GLvoid * const *indices,
+				     GLsizei primcount,
+				     const GLsizei *basevertex)
+{
