index 0000000000000000000000000000000000000000..4ed485a7bfdf7b89a5c23efc2355af58e480c121
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/tnl/t_vb_rendertmp.h
@@ -0,0 +1,486 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5
+ *
