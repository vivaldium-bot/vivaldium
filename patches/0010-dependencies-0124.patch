+  else
+    k = startHash;
+  for (; k < HASHNUM; k++)
+    if (table->charToDots[k])
+      {
+	printf ("Hash=%d\n", k);
+	nextChar = table->charToDots[k];
+	while (nextChar)
+	  {
+	    thisChar = (CharOrDots *) & table->ruleArea[nextChar];
+	    printf ("Char: %s ", showString (&thisChar->lookFor, 1));
+	    printf ("dots=%s\n", showDots (&thisChar->found, 1));
+	    printf ("=> ");
+	    getInput ();
+	    if (*inputBuffer == 'h')
+	      break;
+	    if (*inputBuffer == 'e')
+	      return 1;
+	    nextChar = thisChar->next;
+	  }
+      }
+  return 1;
