+static void
+part_paramLetters ()
+{
+  printf ("show particular hash chains.\n");
+  printf
+    ("show-(f)orward-rules, show-(b)ackward-rules, show-(c)haracters, \n");
+  printf ("show-(d)ot-patterns, show-(C)har-to-dots, show-(D)ots-tochar\n");
+  printf ("(z)-compdots, (h)elp, e(x)it\n");
+}
