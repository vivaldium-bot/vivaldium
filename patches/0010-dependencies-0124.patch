+namespace i18n {
+namespace phonenumbers {
+
+class Lock {
+ public:
+  Lock() {}
+
+  void Acquire() const {
+    DCHECK(thread_checker_.CalledOnValidThread());
+    IGNORE_UNUSED(thread_checker_);
+  }
+
+  void Release() const {
+    DCHECK(thread_checker_.CalledOnValidThread());
+    IGNORE_UNUSED(thread_checker_);
