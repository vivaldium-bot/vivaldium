+bool LoadCompiledInMetadata(PhoneMetadataCollection* metadata) {
+  if (!metadata->ParseFromArray(metadata_get(), metadata_size())) {
+    LOG(ERROR) << "Could not parse binary data.";
+    return false;
+  }
