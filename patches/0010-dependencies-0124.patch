+/**
+ * Unpack rgba colors, returning as GLfloat values.
+ */
+void
+_mesa_unpack_rgba_row(gl_format format, GLuint n,
+                      const void *src, GLfloat dst[][4])
+{
+   unpack_rgba_func unpack = get_unpack_rgba_function(format);
+   unpack(src, dst, n);
+}
