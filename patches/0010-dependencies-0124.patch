+    {
+      'target_name': 'libpng',
+      'type': 'none',
+      'conditions': [
+        [ 'skia_android_framework', {
+            'dependencies':              [ 'android_deps.gyp:png' ],
+            'export_dependent_settings': [ 'android_deps.gyp:png' ],
+        },{
