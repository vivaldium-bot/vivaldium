+};
+
+///////////////////////////////////////////////////////////////////////////////
+
+GrColorCubeEffect::GrColorCubeEffect(GrTexture* colorCube)
+    : fColorCubeAccess(colorCube, "bgra", GrTextureParams::kBilerp_FilterMode) {
+    this->initClassID<GrColorCubeEffect>();
+    this->addTextureAccess(&fColorCubeAccess);
+}
