--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_atom_pixeltransfer.c
@@ -0,0 +1,326 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
