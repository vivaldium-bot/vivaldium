@@ -0,0 +1,25 @@
+#include <stdlib.h>
+#include <stdio.h>
+#include <assert.h>
+#include "brl_checks.h"
+
+int main(int argc, char **argv)
+{
+  int ret = 0;
+  char *tables = "da-dk-g26.ctb";
+  char *word = "achena";
+  char * hyphens = calloc(8, sizeof(char));
+
