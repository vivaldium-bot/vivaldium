index 0000000000000000000000000000000000000000..61ad3c7533a8e50e8878ec1ca5a87a51e4bd4721
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/math/m_xform.c
@@ -0,0 +1,122 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  5.1
+ *
+ * Copyright (C) 1999-2003  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
