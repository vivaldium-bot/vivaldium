+ */
+
+#include "gm.h"
+
+#include "SkPaint.h"
+#include "SkPicture.h"
+#include "SkPictureRecorder.h"
+#include "SkShader.h"
+
+static const SkScalar kPictureSize = SK_Scalar1;
+static const SkScalar kFillSize = 100;
+static const unsigned kRowSize = 6;
+
+static const struct {
+    SkScalar x, y, w, h;
+    SkScalar offsetX, offsetY;
+} tiles[] = {
+    {      0,      0,    1,    1,      0,    0 },
+    {  -0.5f,  -0.5f,    1,    1,      0,    0 },
+    {   0.5f,   0.5f,    1,    1,      0,    0 },
+
+    {      0,      0, 1.5f, 1.5f,      0,    0 },
