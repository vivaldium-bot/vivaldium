diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/X86/Utils/X86ShuffleDecode.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/X86/Utils/X86ShuffleDecode.cpp
