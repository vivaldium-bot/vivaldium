+//===----------------------------------------------------------------------===//
+// MBlaze instruction itineraries for five stage pipeline.
+//===----------------------------------------------------------------------===//
+include "MBlazeSchedule5.td"
diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/MBlaze/MBlazeSchedule3.td b/third_party/swiftshader/third_party/LLVM/lib/Target/MBlaze/MBlazeSchedule3.td
