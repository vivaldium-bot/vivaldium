diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/X86/InstPrinter/X86IntelInstPrinter.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/X86/InstPrinter/X86IntelInstPrinter.cpp
