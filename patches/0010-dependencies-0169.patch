diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2010-12-08-tpsoft.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2010-12-08-tpsoft.ll
