diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/MBlaze/MBlazeTargetObjectFile.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/MBlaze/MBlazeTargetObjectFile.cpp
