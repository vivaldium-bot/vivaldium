+
+      // Floating Point Rounding
+      FPRound,
+
+      // Return
+      Ret,
+
+      // MAdd/Sub nodes
+      MAdd,
+      MAddu,
+      MSub,
+      MSubu,
+
+      // DivRem(u)
+      DivRem,
+      DivRemU,
+
+      BuildPairF64,
+      ExtractElementF64,
+
+      WrapperPIC,
+
+      DynAlloc,
+
+      Sync,
+
+      Ext,
+      Ins
