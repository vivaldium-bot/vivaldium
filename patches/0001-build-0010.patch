+                      | std::ctype_base::upper | std::ctype_base::lower);
+    test_w(L"w", std::ctype_base::alnum
+                      | std::ctype_base::upper | std::ctype_base::lower, true);
+    test_w(L"W", std::ctype_base::alnum
+                      | std::ctype_base::upper | std::ctype_base::lower, true);
+
+    test(L"s", std::ctype_base::space);
