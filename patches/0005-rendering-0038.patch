-
-var inWorker = false;
-try {
-  inWorker = !(self instanceof Window);
-} catch (e) {
-  inWorker = true;
-}
-
-if (!inWorker)
-  STALLED_REQUEST_URL = "resources/" + STALLED_REQUEST_URL;
-
