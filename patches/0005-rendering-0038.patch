-var TIME_REGULAR_TIMEOUT = 2000;
-var TIME_SYNC_TIMEOUT = 1000;
-var TIME_DELAY = 1000;
-
-/*
- * This should point to a resource that responds with a text/plain resource after a delay of TIME_XHR_LOAD milliseconds.
- */
