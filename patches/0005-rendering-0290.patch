+let {session, contextGroup, Protocol} = InspectorTest.start('Return break locations within function');
+
+contextGroup.addScript(`
+function fib(x) {
+  if (x < 0) return;
+  if (x === 0) return 1;
+  if (x === 1) return fib(0);
+  return x > 2 ? fib(x - 1) + fib(x - 2) : fib(1) + fib(0);
+}
