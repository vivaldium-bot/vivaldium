+  }
+  with({}) {
+    return;
+  }
+}
+
+function testForLoop() {
+  for (var i = 0; i < 1; ++i) {}
+  for (var i = 0; i < 1; ++i) i;
+  for (var i = 0; i < 0; ++i) {}
