+listenerCalled = false;
+exception = false;
+
+function listener(event, exec_state, event_data, data) {
+  try {
+    if (event == Debug.DebugEvent.Exception) {
+      // The expected backtrace is
+      // 1: g
+      // 0: [anonymous]
