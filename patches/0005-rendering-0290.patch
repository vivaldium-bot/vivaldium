+doTest('letterA', '0', NaN);
+doTest('letterA', '"a"', 0);
+doTest('0', '"a"', NaN);
+doTest('letterA', 'letterA', 0);
+doTest('0', 'letterA', NaN);
+doTest('"a"', 'letterA', 0);
+doTest('0', 'letterA', NaN);
