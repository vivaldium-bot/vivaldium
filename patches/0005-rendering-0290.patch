+
+contextGroup.addScript(`
+function fooTop() {
+  eval(\`
+    function foo() {
+      eval("({})")
+    }
+    foo() //# sourceURL=second-frame.js\`);
+}
+//# sourceURL=top-frame.js`, 8, 26);
