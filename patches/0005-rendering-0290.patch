+    for (var i = 0; i < array.length; ++i)
+        result += array[i];
+    return result;
+}
+
+var array = [1, 2, 3];
+for (var i = 0; i < 200; ++i)
+    shouldBe("foo(array)", "6");
+
+array = [1, , 3];
+array.__defineGetter__(1, function() { return 6; });
+for (var i = 0; i < 1000; ++i)
+    shouldBe("foo(array)", "10");
+
+var w = this;
+w[0] = 1;
+w.length = 1;
+shouldBe("foo(w)", "1");
