+contextGroup.addScript(`
+function fooTopFail() {
+  eval(\`
+    function fooFail() {
+      eval("({}")
+    }
+    fooFail() //# sourceURL=second-frame-fail.js\`);
+}
+//# sourceURL=top-frame-fail.js`, 18, 26);
