+doTest('0', '1', -1);
+doTest('0', '0', 0);
+doTest('1', '0', 1);
+doTest('Zero', '1', -1);
+doTest('Zero', '0', 0);
+doTest('1', 'Zero', 1);
+doTest('0', 'One', -1);
+doTest('One', '0', 1);
