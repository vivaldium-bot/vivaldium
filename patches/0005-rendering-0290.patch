-}
-TABLE.test3 TR:unknown {
-	BORDER-TOP-STYLE: none
-}
-TABLE.test3 TD {
-	FONT-WEIGHT: bolder; WIDTH: 3em; TEXT-ALIGN: center
-}
-</STYLE>
