+
+#include "test_macros.h"
+
+template <class T>
+void test_lvalue_ref()
+{
+    static_assert(!std::is_void<T>::value, "");
+#if TEST_STD_VER > 11
+    static_assert(!std::is_null_pointer<T>::value, "");
+#endif
