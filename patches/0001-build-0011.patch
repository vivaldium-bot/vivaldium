diff --git a/buildtools/third_party/libc++/trunk/test/std/utilities/function.objects/unord.hash/pointer.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/utilities/function.objects/unord.hash/pointer.pass.cpp
