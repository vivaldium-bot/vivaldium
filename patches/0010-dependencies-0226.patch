+@HAVE_PYTHON_BINDINGS_TRUE@	echo "sources=${libyasm_a_SOURCES} ${nodist_libyasm_a_SOURCES}" >> python-setup.txt
+@HAVE_PYTHON_BINDINGS_TRUE@	echo "srcdir=${srcdir}" >> python-setup.txt
