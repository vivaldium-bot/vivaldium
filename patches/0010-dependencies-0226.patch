+++ b/third_party/yasm/source/patched-yasm/libyasm/coretype.h
@@ -0,0 +1,393 @@
+/**
+ * \file libyasm/coretype.h
+ * \brief YASM core types and utility functions.
+ *
+ * \license
+ *  Copyright (C) 2001-2007  Peter Johnson
+ *
