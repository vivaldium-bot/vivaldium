+@HAVE_PYTHON_BINDINGS_TRUE@	$(PYTHON) -c "from Cython.Compiler.Main import main; main(command_line=1)" \
+@HAVE_PYTHON_BINDINGS_TRUE@		-o $@ yasm.pyx
