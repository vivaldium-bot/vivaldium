+; but it is far better don't remove the string in the binary!
+    db     0dh,0ah,"asm686 with masm, optimised assembly code from Brian Raiter, written 1998, converted to amd 64 by Gilles Vollant 2005",0dh,0ah,0
+%if 0
+longest_match   ENDP
+%endif
+
+match_init:	; PROC
+  ret 0
+ %if 0
+match_init ENDP
+%endif
+
+END
