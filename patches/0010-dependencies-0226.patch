index 0000000000000000000000000000000000000000..88e41a7c5dd1beb52f58384dc8aea30d01024e0a
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/valparam.c
@@ -0,0 +1,385 @@
+/*
+ * Value/Parameter type functions
+ *
+ *  Copyright (C) 2001-2007  Peter Johnson
