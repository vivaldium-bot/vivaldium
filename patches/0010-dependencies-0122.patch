+          cpi->prob_skip_false = 1;
+        }
+      }
+
+#if 0
+
+            if (cpi->pass != 1)
+            {
+                FILE *f = fopen("skip.stt", "a");
+                fprintf(f, "%d, %d, %4d ", cpi->common.refresh_golden_frame, cpi->common.refresh_alt_ref_frame, cpi->prob_skip_false);
+                fclose(f);
+            }
+
+#endif
+    }
+
+    if (cm->frame_type == KEY_FRAME) {
+      if (resize_key_frame(cpi)) {
