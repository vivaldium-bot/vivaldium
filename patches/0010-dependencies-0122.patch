index 0000000000000000000000000000000000000000..0ab08b649ad7b379782e70dc3bce9e2b61341263
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/decoder/ec_types.h
@@ -0,0 +1,51 @@
+/*
