+#ifndef SRC_VIRTUAL_BLOCK_PARSER_H_
+#define SRC_VIRTUAL_BLOCK_PARSER_H_
+
+#include <cassert>
+#include <cstdint>
+
+#include "src/block_header_parser.h"
+#include "src/element_parser.h"
