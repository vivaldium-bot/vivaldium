+          <leadingDigits>
+            2[0-79]|
+            [13-5]
+          </leadingDigits>
+          <format>$1 $2</format>
+        </numberFormat>
+        <numberFormat pattern="(\d)(\d{7})">
+          <leadingDigits>
+            24|
+            [67]
+          </leadingDigits>
+          <format>$1 $2</format>
+        </numberFormat>
+        <numberFormat pattern="(\d{2})(\d{5,7})">
+          <leadingDigits>
+            15|
+            28|
+            6[1-35-9]|
+            799|
+            9[2-9]
+          </leadingDigits>
+          <format>$1 $2</format>
+        </numberFormat>
+        <numberFormat pattern="(90\d)(\d{3})(\d{3})">
+          <leadingDigits>90</leadingDigits>
+          <format>$1 $2 $3</format>
+        </numberFormat>
+      </availableFormats>
