+TEST_F(SignedIntParserTest, SignedValidPositiveInt) {
+  ParseAndVerify();
+  EXPECT_EQ(0, parser_.value());
+
+  SetReaderData({0x7f});
+  ParseAndVerify();
+  EXPECT_EQ(0x7f, parser_.value());
+
+  SetReaderData({0x12, 0xD6, 0x87});
