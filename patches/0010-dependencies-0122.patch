+
+    Cluster cluster{};
+    EXPECT_CALL(callback_, OnClusterBegin(metadata_, cluster, NotNull()))
+        .Times(1);
+
+    EXPECT_CALL(callback_, OnBlockGroupBegin(_, NotNull()))
