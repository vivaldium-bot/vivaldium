+      </mobile>
+      <voip>
+        <!-- Telespazio S.p.A., Thuraya and Bebbicell VOIP numbers. -->
+        <nationalNumberPattern>
+          1(?:
+            3(?:
+              0[0347]|
+              [13][0139]|
+              2[035]|
+              4[013568]|
+              6[0459]|
+              7[06]|
+              8[15678]|
+              9[0689]
+            )\d{4}|
+            6\d{5,10}
+          )|
+          345\d{7}
+        </nationalNumberPattern>
+        <possibleNumberPattern>\d{7,12}</possibleNumberPattern>
+      </voip>
+      <voicemail>
+        <nationalNumberPattern>348[57]\d{7}</nationalNumberPattern>
+        <possibleNumberPattern>\d{11}</possibleNumberPattern>
+      </voicemail>
+    </territory>
+
+    <territory id="001" countryCode="883">
+      <references>
+        <!-- bandwidth.com -->
+        <sourceUrl>http://www.itu.int/oth/T02020000FB/en</sourceUrl>
+        <!-- SipMe -->
+        <sourceUrl>http://www.itu.int/oth/T02020000FC/en</sourceUrl>
+        <!-- Voxbone -->
+        <sourceUrl>http://www.itu.int/oth/T02020000F3/en</sourceUrl>
