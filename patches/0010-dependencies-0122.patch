+  usShortNumber.setCountryCode(1);
+  usShortNumber.setNationalNumber(911);
+  assertEquals('911',
+      phoneUtil.formatNumberForMobileDialing(usShortNumber,
+          RegionCode.US, false));
+  assertEquals('',
+      phoneUtil.formatNumberForMobileDialing(usShortNumber,
+          RegionCode.CA, false));
