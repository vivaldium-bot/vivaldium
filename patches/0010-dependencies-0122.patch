+         (!cpi->use_svc ||  // Add spatial svc base layer case here
+          (is_two_pass_svc(cpi) && cpi->svc.spatial_layer_id == 0 &&
+           cpi->svc.layer_context[0].gold_ref_idx >= 0 &&
+           cpi->oxcf.ss_enable_auto_arf[0]));
+}
