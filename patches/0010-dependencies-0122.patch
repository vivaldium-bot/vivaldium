index 0000000000000000000000000000000000000000..f8b653a9a7b5e54e44a041846b7e6a309e8775d1
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/encoder/mips/msa/denoising_msa.c
@@ -0,0 +1,568 @@
+/*
