+  if (!cpi->oxcf.error_resilient_mode && cm->refresh_golden_frame) {
+    cm->copy_buffer_to_arf = 2;
+  } else {
+    cm->copy_buffer_to_arf = 0;
+  }
+
+  cm->frame_to_show = &cm->yv12_fb[cm->new_fb_idx];
+
