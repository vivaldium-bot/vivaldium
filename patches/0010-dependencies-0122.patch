+                              const uint16_t indices[], int indexCount,
+                              const SkPaint&) override;
+
+    void onClipRect(const SkRect&, SkRegion::Op, ClipEdgeStyle) override;
+    void onClipRRect(const SkRRect&, SkRegion::Op, ClipEdgeStyle) override;
