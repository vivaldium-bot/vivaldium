+  Element<std::string> doc_type{"matroska"};
+
+  /**
+   A parsed \WebMID{DocTypeVersion} element.
+   */
+  Element<std::uint64_t> doc_type_version{1};
+
+  /**
+   A parsed \WebMID{DocTypeReadVersion} element.
