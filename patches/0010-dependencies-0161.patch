index 0000000000000000000000000000000000000000..1bd004c1cb491425e7383b11eeeeffa39bdcd490
--- /dev/null
+++ b/third_party/spirv-tools-angle/src/source/text_handler.h
@@ -0,0 +1,246 @@
+// Copyright (c) 2015-2016 The Khronos Group Inc.
+//
