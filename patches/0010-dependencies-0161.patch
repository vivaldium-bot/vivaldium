+; 64-NEXT:   ('sh_entsize', 0x0000000000000001)
+
+; 64: (('sh_name', 0x00000041) # '.rodata.cst8'
+; 64-NEXT:   ('sh_type', 0x00000001)
+; 64-NEXT:   ('sh_flags', 0x0000000000000012)
+; 64-NEXT:   ('sh_addr',
+; 64-NEXT:   ('sh_offset',
