+//----------------------------------------------------------------------------
+
+template < typename hashtype >
+void test ( hashfunc<hashtype> hash, HashInfo * info )
+{
+  const int hashbits = sizeof(hashtype) * 8;
+
+  printf("-------------------------------------------------------------------------------\n");
+  printf("--- Testing %s (%s)\n\n",info->name,info->desc);
