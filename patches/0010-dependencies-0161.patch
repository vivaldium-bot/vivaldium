+                         vector<string>{"ImageGatherExtended"}),
+               make_pair(ImageOperandsTemplate("Sample|MinLod %izero %fzero"),
+                         vector<string>{"MinLod"}),
+               make_pair(ImageOperandsTemplate("Lod|Sample %fzero %izero"),
