+
+				switch(value & ~D3DTA_SELECTMASK)
+				{
+				case 0:
+					renderer->setThirdModifierAlpha(stage, sw::TextureStage::MODIFIER_COLOR);
+					break;
+				case D3DTA_COMPLEMENT:
+					renderer->setThirdModifierAlpha(stage, sw::TextureStage::MODIFIER_INVCOLOR);
