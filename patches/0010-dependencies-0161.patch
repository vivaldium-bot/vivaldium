+    sources += [
+      "FrameBufferDD.cpp",
+      "FrameBufferGDI.cpp",
+      "FrameBufferWin.cpp",
+    ]
+  }
+
+  if (is_win) {
+    configs -= [ "//build/config/win:unicode" ]
+    libs = [ "dxguid.lib" ]  # For FrameBufferDD
+  }
+
+  configs += [ ":swiftshader_main_private_config" ]
+
+  include_dirs = [
+    "..",
+    "../Common",
+  ]
+
+  if (is_mac) {
+    include_dirs += [ "../../include" ]
+    libs = [
+      "Quartz.framework",
+      "Cocoa.framework",
+    ]
+  }
+}
