+struct Trace
+{
+	Trace(const char *format, ...)
+	{
+		if(false)
+		{
+			FILE *file = fopen("debug.txt", "a");
+
+			if(file)
+			{
+				for(int i = 0; i < indent; i++) fprintf(file, " ");
+
+				va_list vararg;
+				va_start(vararg, format);
+				vfprintf(file, format, vararg);
+				va_end(vararg);
+
+				fclose(file);
+			}
+		}
+
+		indent++;
+	}
+
+	~Trace()
+	{
+		indent--;
+	}
+
+	static int indent;
+};
