+			}
+		}
+
+		if(pixelShaderCaptured)
+		{
+			device->SetPixelShader(pixelShader);
+		}
+
+		if(vertexShaderCaptured)
+		{
+			device->SetVertexShader(vertexShader);
+		}
+
+		if(viewportCaptured)
