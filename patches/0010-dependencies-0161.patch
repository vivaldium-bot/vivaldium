+
+    function drawTop() {
+        init(tests[testIndex]);
+        redraw();
+    }
+
+    function redraw() {
+        if (focus_on_selection > 0) {
+            var focusXmin = focusYmin = Infinity;
+            var focusXmax = focusYmax = -Infinity;
+            var choice = 0;
+            for (var curves in tests[testIndex]) {
+                if (++choice != focus_on_selection) {
