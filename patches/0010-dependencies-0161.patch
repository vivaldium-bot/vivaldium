+                redraw();
+                break;
+        }
+    }
+
+    function doKeyDown(evt) {
+        var char = evt.keyCode;
+        var preventDefault = false;
+        switch (char) {
+            case 37: // left arrow
+                if (evt.shiftKey) {
+                    testIndex -= 9;
+                }
+                if (--testIndex < 0)
