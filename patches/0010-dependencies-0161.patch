diff --git a/third_party/webrtc/base/proxydetect_unittest.cc b/third_party/webrtc/base/proxydetect_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ca0b428fcec8c6d186e25aba9737a0c695a0a0b3
--- /dev/null
+++ b/third_party/webrtc/base/proxydetect_unittest.cc
@@ -0,0 +1,164 @@
+/*
+ *  Copyright 2010 The WebRTC Project Authors. All rights reserved.
+ *
