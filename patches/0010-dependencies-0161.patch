+                                               const GrVkBuffer::Desc& descriptor) override;
+
+    GrVkUniformBuffer(GrVkGpu* gpu, const GrVkBuffer::Desc& desc,
+                      const GrVkUniformBuffer::Resource* resource)
+        : INHERITED(desc, resource) {}
+
+    typedef GrVkBuffer INHERITED;
+};
