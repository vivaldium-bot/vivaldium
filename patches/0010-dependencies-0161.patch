+
+INSTANTIATE_TEST_CASE_P(
+    TextToBinaryExecutionModeV11, OpExecutionModeTest,
+    Combine(Values(SPV_ENV_UNIVERSAL_1_1),
+            ValuesIn(std::vector<EnumCase<SpvExecutionMode>>{
