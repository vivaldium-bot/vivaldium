+  const char str[] = R"(
+            OpCapability Kernel
+            OpCapability Matrix
+            OpMemoryModel Logical OpenCL
+%f32      = OpTypeFloat 32
+%vec3     = OpTypeVector %f32 3
+%mat33    = OpTypeMatrix %vec3 3
