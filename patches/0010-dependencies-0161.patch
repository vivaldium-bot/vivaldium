diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/ArgumentPromotion/aggregate-promote.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/ArgumentPromotion/aggregate-promote.ll
