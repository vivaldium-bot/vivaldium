+declare noalias i8* @_Znam(i32)
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/unaligned_load_store.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/unaligned_load_store.ll
