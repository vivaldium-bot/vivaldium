diff --git a/third_party/webrtc/base/proxyserver.cc b/third_party/webrtc/base/proxyserver.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8f12a99f98ab33d35d78556e6c5cfad1ab5af2fb
--- /dev/null
+++ b/third_party/webrtc/base/proxyserver.cc
@@ -0,0 +1,150 @@
+/*
