+				default:
+					ASSERT(false);
+				}
+				break;
+			case D3DTSS_ALPHAARG0:
+				switch(value & D3DTA_SELECTMASK)
+				{
+				case D3DTA_DIFFUSE:
+					renderer->setThirdArgumentAlpha(stage, sw::TextureStage::SOURCE_DIFFUSE);
+					break;
+				case D3DTA_CURRENT:
+					renderer->setThirdArgumentAlpha(stage, sw::TextureStage::SOURCE_CURRENT);
