diff --git a/third_party/webrtc/base/bind_unittest.cc b/third_party/webrtc/base/bind_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ed8dd5cf2d226a93b24512069bc9324aa9c91619
--- /dev/null
+++ b/third_party/webrtc/base/bind_unittest.cc
@@ -0,0 +1,67 @@
+/*
