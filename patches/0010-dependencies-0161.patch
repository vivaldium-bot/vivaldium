+
+#include "GrGLGpu.h"
+
+GrGLSemaphore::GrGLSemaphore(const GrGLGpu* gpu, bool isOwned)
+    : INHERITED(gpu), fSync(0), fIsOwned(isOwned) {
+}
+
+GrGLSemaphore::~GrGLSemaphore() {
