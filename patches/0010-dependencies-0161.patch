+			if(stateRecorder[i])
+			{
+				stateRecorder[i]->unbind();
+				stateRecorder[i] = 0;
+			}
+		}
+
+		palette.clear();
+
+		delete cursor;
+		DestroyCursor(nullCursor);
+	}
