diff --git a/third_party/swiftshader/src/D3D9/Direct3DIndexBuffer9.cpp b/third_party/swiftshader/src/D3D9/Direct3DIndexBuffer9.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d48efdf8de0a1626a4bb31ced10b5b694019da9d
--- /dev/null
+++ b/third_party/swiftshader/src/D3D9/Direct3DIndexBuffer9.cpp
@@ -0,0 +1,237 @@
+// Copyright 2016 The SwiftShader Authors. All Rights Reserved.
+//
