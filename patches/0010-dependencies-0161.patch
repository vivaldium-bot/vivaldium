+// These examples are taken from <mach-o/x86_64/reloc.h>.
+
+        .data
+        .long 0
+
+        .text
+_foo:
+        ret
+
+_baz:
+        call _foo
+ 	call _foo+4
+ 	movq _foo@GOTPCREL(%rip), %rax
+ 	pushq _foo@GOTPCREL(%rip)
+ 	movl _foo(%rip), %eax
+ 	movl _foo+4(%rip), %eax
+ 	movb  $0x12, _foo(%rip)
+ 	movl  $0x12345678, _foo(%rip)
+ 	.quad _foo
+_bar:
+ 	.quad _foo+4
+ 	.quad _foo - _bar
+ 	.quad _foo - _bar + 4
+ 	.long _foo - _bar
+ 	leaq L1(%rip), %rax
+ 	leaq L0(%rip), %rax
+        addl $6,L0(%rip)
+        addw $500,L0(%rip)
+        addl $500,L0(%rip)
+
+_prev:
+        .space 12,0x90
+ 	.quad L1
+L0:
+        .quad L0
+L_pc:
+ 	.quad _foo - L_pc
+ 	.quad _foo - L1
+L1:
+ 	.quad L1 - _prev
+
+        .data
+.long	_foobar@GOTPCREL+4
+.long	_foo@GOTPCREL+4
+
+        .section	__DWARF,__debug_frame,regular,debug
+        .quad L1
+        .quad _ext_foo
+
+// Make sure local label which overlaps with non-local one is assigned to the
+// right atom.
+        .text
+_f2:
+L2_0:
+        addl $0, %eax
+L2_1:        
+_f3:
+        addl L2_1 - L2_0, %eax
+        
+        .data
+L4:     
+        .long 0
+        .text
+        movl L4(%rip), %eax
+
+        .section __TEXT,__literal8,8byte_literals
+	.quad 0
+L5:     
+	.quad 0
+f6:
+        .quad 0
+L6:
