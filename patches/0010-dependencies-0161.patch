+	Direct3D8::~Direct3D8()
+	{
+		delete[] displayMode;
+		displayMode = 0;
+
+		if(d3d8)
+		{
+			d3d8->Release();
+			d3d8 = 0;
+		}
+
+		if(d3d8Lib)
+		{
+			FreeLibrary(d3d8Lib);
+			d3d8Lib = 0;
+		}
+	}
