+
+    function ptInWControl() {
+        var e = window.event;
+        var tgt = e.target || e.srcElement;
+        var left = tgt.offsetLeft;
+        var top = tgt.offsetTop;
+        var x = (e.clientX - left);
+        var y = (e.clientY - top);
