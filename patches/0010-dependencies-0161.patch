new file mode 100644
index 0000000000000000000000000000000000000000..6bbc53eb13f67c74a0cabe15e599e8c4876768a6
--- /dev/null
+++ b/third_party/webrtc/base/diskcache.cc
@@ -0,0 +1,348 @@
+/*
