diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/CPP/2009-05-01-Long-Double.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/CPP/2009-05-01-Long-Double.ll
