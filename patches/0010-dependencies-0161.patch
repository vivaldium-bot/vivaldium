+
+		for(int i = 0; i < 16; i++)
+		{
+			if(vertexShaderConstantB[i] != 0x80000000)
+			{
+				device->SetVertexShaderConstantB(i, &vertexShaderConstantB[i], 1);
+			}
+		}
+
+		for(int index = 0; index < 6; index++)
+		{
