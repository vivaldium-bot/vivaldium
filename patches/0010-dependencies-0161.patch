diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/peephole-bitcast.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/peephole-bitcast.ll
new file mode 100644
index 0000000000000000000000000000000000000000..e670a5be3bca675a744f62c74abe09ffaa1dcc74
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/peephole-bitcast.ll
@@ -0,0 +1,26 @@
+; RUN: llc < %s -march=arm -mcpu=cortex-a8 -regalloc=linearscan | FileCheck %s
+
+; vmov s0, r0 + vmov r0, s0 should have been optimized away.
+; rdar://9104514
+
+; Peephole leaves a dead vmovsr instruction behind, and depends on linear scan
+; to remove it.
+
+define void @t(float %x) nounwind ssp {
+entry:
+; CHECK:     t:
+; CHECK-NOT: vmov
+; CHECK:     bl
+  %0 = bitcast float %x to i32
+  %cmp = icmp ult i32 %0, 2139095039
+  br i1 %cmp, label %if.then, label %if.end
+
+if.then:                                          ; preds = %entry
+  tail call void @doSomething(float %x) nounwind
+  br label %if.end
+
+if.end:                                           ; preds = %if.then, %entry
+  ret void
+}
+
+declare void @doSomething(float)
