+SkPDFDevice::SkPDFDevice(SkISize pageSize, SkPDFDocument* doc)
+    : INHERITED(SkImageInfo::MakeUnknown(pageSize.width(), pageSize.height()),
+                SkSurfaceProps(0, kUnknown_SkPixelGeometry))
