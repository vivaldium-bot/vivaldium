+                                                  {"%Q8", true},
+                                                  {"%R_S", true},
+                                                  {"%T_10_U", true},
+                                                  {"%V_11", true},
+                                                  {"%W_X_13", true},
+                                                  {"%_A", true},
+                                                  {"%_", true},
+                                                  {"%__", true},
+                                                  {"%A_", true},
+                                                  {"%_A_", true},
+
+                                                  {"%@", false},
+                                                  {"%!", false},
+                                                  {"%ABC!", false},
+                                                  {"%__A__@", false},
