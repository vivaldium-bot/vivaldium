diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Blackfin/2009-08-15-LiveIn-SubReg.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Blackfin/2009-08-15-LiveIn-SubReg.ll
