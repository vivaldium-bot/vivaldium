+    fCommands.addCommand('c', "Modes", "Cycle color mode", [this]() {
+        switch (fColorMode) {
+            case ColorMode::kLegacy:
+                this->setColorMode(ColorMode::kColorManagedSRGB8888_NonLinearBlending);
+                break;
+            case ColorMode::kColorManagedSRGB8888_NonLinearBlending:
