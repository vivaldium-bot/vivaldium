+; RUN: llc < %s -mtriple=arm-linux-gnueabi -mattr=+vfp2 | FileCheck %s -check-prefix=ELF
+; RUN: llc < %s -mtriple=arm-apple-darwin -mattr=+vfp2 | FileCheck %s -check-prefix=DARWIN
+
+define i32 @f1(i32 %a, i64 %b) {
+; ELF: f1:
+; ELF: mov r0, r2
+; DARWIN: f1:
+; DARWIN: mov r0, r1
+        %tmp = call i32 @g1(i64 %b)
