+    uint32_t fMask[SkJumper_kMaxStride];
+    float    fCoeffA,
+             fInvCoeffA,
+             fR0,
+             fDR;
+};
+
+struct SkJumper_UniformColorCtx {
+    float r,g,b,a;
+    uint32_t rgba;
+};
+
+struct SkJumper_ColorLookupTableCtx {
+    const float* table;
+    int limits[4];
+};
