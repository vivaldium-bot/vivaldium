+    STAGE(move_src_dst) { dst = src; }
+    STAGE(move_dst_src) { src = dst; }
+
+    STAGE(black_color) { src.u32 = 0xff000000; }
+    STAGE(white_color) { src.u32 = 0xffffffff; }
