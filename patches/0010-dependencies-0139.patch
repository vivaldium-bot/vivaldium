+void CPDF_TextPage::GetRect(int rectIndex,
+                            FX_FLOAT& left,
+                            FX_FLOAT& top,
+                            FX_FLOAT& right,
+                            FX_FLOAT& bottom) const {
+  if (!m_bIsParsed)
+    return;
