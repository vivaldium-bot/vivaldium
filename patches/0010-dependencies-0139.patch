new file mode 100644
index 0000000000000000000000000000000000000000..97d02e85f5edbfd9dd09ddf706b92eab521a759f
--- /dev/null
+++ b/third_party/pdfium/fpdfsdk/fpdf_sysfontinfo.cpp
@@ -0,0 +1,221 @@
+// Copyright 2014 PDFium Authors. All rights reserved.
