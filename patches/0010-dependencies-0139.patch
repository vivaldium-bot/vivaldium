+void CPWL_Wnd::RemoveChild(CPWL_Wnd* pWnd) {
+  for (int32_t i = m_aChildren.GetSize() - 1; i >= 0; i--) {
+    if (CPWL_Wnd* pChild = m_aChildren.GetAt(i)) {
