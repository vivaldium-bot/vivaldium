+  /* SZP2[]:       Set Zone Pointer 2                                      */
+  /* Opcode range: 0x15                                                    */
+  /* Stack:        uint32 -->                                              */
+  /*                                                                       */
+  static void
+  Ins_SZP2( TT_ExecContext  exc,
+            FT_Long*        args )
+  {
+    switch ( (FT_Int)args[0] )
+    {
+    case 0:
+      exc->zp2 = exc->twilight;
