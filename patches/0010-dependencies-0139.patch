+bool CFFL_FormFiller::OnLButtonDown(CPDFSDK_PageView* pPageView,
+                                    CPDFSDK_Annot* pAnnot,
+                                    uint32_t nFlags,
+                                    const CFX_PointF& point) {
+  CPWL_Wnd* pWnd = GetPDFWindow(pPageView, true);
