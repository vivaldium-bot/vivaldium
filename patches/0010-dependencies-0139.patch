+
+  CFX_FxgeDevice device;
+  CFX_DIBitmap* pBitmap = CFXBitmapFromFPDFBitmap(bitmap);
+  device.Attach(pBitmap, false, nullptr, false);
+  if (!pBitmap->HasAlpha())
+    color |= 0xFF000000;
+  FX_RECT rect(left, top, left + width, top + height);
+  device.FillRect(&rect, color);
