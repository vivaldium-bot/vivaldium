+VGfloat vegaGetParameterf(VGHandle object,
+                          VGint paramType)
+{
+   struct vg_context *ctx = vg_current_context();
+
+   if (object == VG_INVALID_HANDLE) {
+      vg_set_error(ctx, VG_BAD_HANDLE_ERROR);
