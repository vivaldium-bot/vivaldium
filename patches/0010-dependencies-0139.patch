+
+  return TRUE;
+}
+
+FX_BOOL CPDFSDK_WidgetHandler::OnKillFocus(CPDFSDK_Annot::ObservedPtr* pAnnot,
+                                           uint32_t nFlag) {
+  if (!(*pAnnot)->IsSignatureWidget() && m_pFormFiller)
+    return m_pFormFiller->OnKillFocus(pAnnot, nFlag);
+
+  return TRUE;
+}
