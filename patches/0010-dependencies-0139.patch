+  if (!m_pDocument->GetPermissions(FPDFPERM_EXTRACT_ACCESS)) {
+    sError = JSGetStringFromID(IDS_STRING_JSBADOBJECT);
+    return FALSE;
+  }
+  return FALSE;
+}
