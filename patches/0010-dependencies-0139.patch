+  CFX_WideStringC def(L"\x1001qq");  // Comes after despite endianness.
+
+  EXPECT_FALSE(empty < empty);
+  EXPECT_FALSE(a < a);
+  EXPECT_FALSE(abc < abc);
+  EXPECT_FALSE(def < def);
