+opj_mqc_t* opj_mqc_create(void) {
+	opj_mqc_t *mqc = (opj_mqc_t*)opj_malloc(sizeof(opj_mqc_t));
+#ifdef MQC_PERF_OPT
+	if (mqc) {
+		mqc->buffer = NULL;
+	}
+#endif
+	return mqc;
