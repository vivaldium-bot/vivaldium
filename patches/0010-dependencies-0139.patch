+void CPDFXFA_DocEnvironment::InvalidateRect(CXFA_FFPageView* pPageView,
+                                            const CFX_RectF& rt) {
+  if (!m_pContext->GetXFADoc() || !m_pContext->GetFormFillEnv())
+    return;
+
+  if (m_pContext->GetFormType() != FormType::kXFAFull)
+    return;
