+	-rm -f $(OBJECTS) *~ *.so $(SYMLINKS)
+	-rm -f depend depend.bak
+
+install: default
+	$(INSTALL) -d $(DESTDIR)$(XVMC_LIB_INSTALL_DIR)
+	$(MINSTALL) -m 755 $(TOP)/$(LIB_DIR)/gallium/$(XVMC_LIB_GLOB) $(DESTDIR)$(XVMC_LIB_INSTALL_DIR)
+
+include depend
diff --git a/third_party/mesa/src/src/gallium/targets/SConscript.dri b/third_party/mesa/src/src/gallium/targets/SConscript.dri
