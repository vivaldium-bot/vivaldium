+ */
+void renderer_set_constants(struct xa_context *r,
+			    int shader_type, const float *params,
+			    int param_bytes);
+
+void renderer_draw_yuv(struct xa_context *r,
+		       float src_x,
+		       float src_y,
+		       float src_w,
+		       float src_h,
+		       int dst_x,
+		       int dst_y, int dst_w, int dst_h,
