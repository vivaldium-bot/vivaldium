+   constbuf1 = screen->resource_create(screen, &templat);
+   if (constbuf1 == NULL)
+      exit(4);
+   constbuf2 = screen->resource_create(screen, &templat);
+   if (constbuf2 == NULL)
+      exit(4);
+
+   {
+      u_box_2d(0,0,sizeof(constants1),1, &box);
+
+      ctx->transfer_inline_write(ctx,
