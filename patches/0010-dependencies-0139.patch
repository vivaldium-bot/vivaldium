+# -*-makefile-*-
+
+
+ifeq ($(MESA_LLVM),1)
+LDFLAGS += $(LLVM_LDFLAGS)
+DRIVER_EXTRAS = $(LLVM_LIBS)
+endif
+
+MESA_MODULES = \
+	$(TOP)/src/mesa/libmesagallium.a \
