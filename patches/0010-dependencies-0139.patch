+  int32_t nStride = pImage->stride();
+  int32_t nStride2 = nStride << 1;
+  int32_t nLineBytes = ((GBW + 7) >> 3) - 1;
+  int32_t nBitsLeft = GBW - (nLineBytes << 3);
