+  //Parse real bitstream
+  void DecodeBs (const char* sFileName);
+  //Scalinglist
+  void TestScalingList();
+  //Do whole tests here
+  void DecoderParseSyntaxTestAll();
+
+
+ public:
+  ISVCDecoder* m_pDec;
+  SDecodingParam m_sDecParam;
+  SBufferInfo m_sBufferInfo;
+  SParserBsInfo m_sParserBsInfo;
+  uint8_t* m_pData[3];
