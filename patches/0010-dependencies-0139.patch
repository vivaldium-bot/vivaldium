+void GetValidEncParamBase (SEncParamBase* pEncParamBase) {
+  pEncParamBase->iUsageType = CAMERA_VIDEO_REAL_TIME;
+  pEncParamBase->iPicWidth = 2 + ((rand() % ((MAX_WIDTH >> 1) - 1)) << 1);
+  pEncParamBase->iPicHeight = 2 + ((rand() % ((MAX_HEIGHT >> 1) - 1)) << 1);
