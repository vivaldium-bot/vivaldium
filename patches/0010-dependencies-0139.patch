+
+FX_BOOL event::willCommit(IJS_Context* cc,
+                          CJS_PropValue& vp,
+                          CFX_WideString& sError) {
+  if (!vp.IsGetting())
+    return FALSE;
+
+  CJS_Context* pContext = (CJS_Context*)cc;
+  CJS_EventHandler* pEvent = pContext->GetEventHandler();
+
+  if (pEvent->WillCommit())
+    vp << TRUE;
+  else
+    vp << FALSE;
+  return TRUE;
+}
