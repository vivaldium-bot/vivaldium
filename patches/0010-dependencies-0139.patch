+      return;
+   }
+   image_set_pixels(dx, dy, handle_to_image(src), sx, sy, width,
+                    height);
+}
+
+void vegaGetPixels(VGImage dst, VGint dx, VGint dy,
+                   VGint sx, VGint sy,
