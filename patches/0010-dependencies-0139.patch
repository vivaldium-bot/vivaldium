+
+  CFX_ByteString bstrURL = CFX_WideString(url).UTF16LE_Encode();
+  FPDF_WIDESTRING wsURL =
+      (FPDF_WIDESTRING)bstrURL.GetBuffer(bstrURL.GetLength());
