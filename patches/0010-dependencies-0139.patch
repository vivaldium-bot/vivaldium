+CFX_WideString CFX_ByteString::UTF8Decode() const {
+  CFX_UTF8Decoder decoder;
+  for (FX_STRSIZE i = 0; i < GetLength(); i++) {
+    decoder.Input((uint8_t)m_pData->m_String[i]);
+  }
+  return CFX_WideString(decoder.GetResult());
+}
