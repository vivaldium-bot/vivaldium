index 0000000000000000000000000000000000000000..f9b90044ac541fe2183e4e7fbaeb01a235787e17
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/winsys/sw/android/android_sw_winsys.cpp
@@ -0,0 +1,264 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.12
