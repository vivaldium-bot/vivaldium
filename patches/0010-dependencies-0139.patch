+    ToJSContext(pThis, nullptr)->ThrowParamCountMismatchException(L"Len");
+    return;
+  }
+
+  std::unique_ptr<CFXJSE_Value> argOne = GetSimpleValue(pThis, args, 0);
+  if (ValueIsNull(pThis, argOne.get())) {
+    args.GetReturnValue()->SetNull();
+    return;
