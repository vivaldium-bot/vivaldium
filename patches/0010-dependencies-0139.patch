+
+bool CPWL_Wnd::SetVisible(bool bVisible) {
+  if (!IsValid())
+    return true;
+
+  ObservedPtr thisObserved(this);
+
+  for (auto* pChild : m_Children) {
+    if (pChild) {
+      pChild->SetVisible(bVisible);
+      if (!thisObserved)
+        return false;
+    }
+  }
+
+  if (bVisible != m_bVisible) {
+    m_bVisible = bVisible;
+    if (!RePosChildWnd())
+      return false;
+
+    if (!InvalidateRect(nullptr))
+      return false;
+  }
+  return true;
+}
