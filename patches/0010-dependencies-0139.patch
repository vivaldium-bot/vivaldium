+
+  float nRate = ValueToFloat(pThis, argOne.get());
+  float nFutureValue = ValueToFloat(pThis, argTwo.get());
+  float nInitAmount = ValueToFloat(pThis, argThree.get());
+  if ((nRate <= 0) || (nFutureValue <= 0) || (nInitAmount <= 0)) {
