+  bool ResolveDollar(CFXJSE_ResolveNodeData& rnd);
+  bool ResolveExcalmatory(CFXJSE_ResolveNodeData& rnd);
+  bool ResolveNumberSign(CFXJSE_ResolveNodeData& rnd);
