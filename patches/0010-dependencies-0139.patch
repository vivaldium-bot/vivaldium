+                      FXARGB_MAKE(0xff, src_pos[2], src_pos[1], src_pos[0]));
+                }
+              }
+            }
+            dest_pos += destBpp;
+          }
+        }
+      }
+    }
+  }
+  m_Storer.Replace(std::move(pTransformed));
+  return FALSE;
+}
