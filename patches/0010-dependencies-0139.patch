+      if (!swJS.IsEmpty()) {
+        IJS_Runtime* pRuntime = pDocument->GetJsRuntime();
+        pRuntime->SetReaderDocument(pDocument);
+
+        IJS_Context* pContext = pRuntime->NewContext();
+        pContext->OnLink_MouseUp(pDocument);
