+                      FXARGB_MAKE(r_pos_a_r, r_pos_red_y_r, r_pos_green_m_r,
+                                  r_pos_blue_c_r));
+                }
+              } else {
+                r_pos_k_r = 0xff;
+                if (transformF == FXDIB_Cmyka) {
+                  r_pos_k_r =
+                      bicubic_interpol(stretch_buf, stretch_pitch, pos_pixel,
+                                       u_w, v_w, res_x, res_y, Bpp, 3);
