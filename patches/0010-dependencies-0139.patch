+void CPDFXFA_App::GetAppName(CFX_WideString& wsName) {
+  CPDFSDK_FormFillEnvironment* pEnv = m_pEnvList.GetAt(0);
+  if (pEnv) {
+    wsName = pEnv->FFI_GetAppName();
+  }
+}
