+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include "util/u_memory.h"
+#include "util/u_math.h"
+#include "util/u_format.h"
+#include "pipe/p_compiler.h"
+#include "util/u_inlines.h"
+#include "state_tracker/xlib_sw_winsys.h"
+#include "util/u_debug.h"
