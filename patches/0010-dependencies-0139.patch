+                  XFA_LAYOUTMODEL_HWXY layoutModel);
+  std::vector<CXFA_Node*> GetObjArray(CXFA_LayoutProcessor* pDocLayout,
+                                      int32_t iPageNo,
+                                      const WideString& wsType,
