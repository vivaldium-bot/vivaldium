--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/xvmc/context.c
@@ -0,0 +1,340 @@
+/**************************************************************************
+ *
+ * Copyright 2009 Younes Manton.
+ * All Rights Reserved.
+ *
