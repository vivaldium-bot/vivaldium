+
+  void SetAt(const CFX_ByteString& space,
+             const CFX_ByteString& name,
+             const CFX_WideString& value);
+
+  std::unique_ptr<std::vector<CXML_AttrItem>> m_pMap;
+};
+
+class CXML_Content {
+ public:
+  CXML_Content() : m_bCDATA(FALSE), m_Content() {}
