+  OutputImageMask(pGraphics, bMonoDevice, pBitmap, dest_left, dest_top,
+                  dest_width, dest_height, argb, pClipRect);
+  CallFunc(GdipDeleteGraphics)(pGraphics);
+  return TRUE;
