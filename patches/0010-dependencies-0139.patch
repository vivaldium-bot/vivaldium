+  sAppStream << fLineWidth << " w " << rect.left << " " << fY << " m "
+             << rect.right << " " << fY << " l S\n";
+
+  CPDF_Dictionary* pExtGStateDict =
+      GenerateExtGStateDict(*pAnnotDict, sExtGSDictName, "Normal");
