+
+  bool bFlags = false;
+  std::unique_ptr<CFXJSE_Value> argOne = GetSimpleValue(pThis, args, 0);
+  std::vector<std::unique_ptr<CFXJSE_Value>> parameterValues;
+  unfoldArgs(pThis, args, &parameterValues, 1);
