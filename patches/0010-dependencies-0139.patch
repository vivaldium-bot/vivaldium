+    if (iColorType == COLORTYPE_TRANSPARENT)
+      crRet = CPWL_Color(COLORTYPE_TRANSPARENT);
+
+    color::ConvertPWLColorToArray(pRuntime, crRet, &crArray);
+    vp << crArray;
+  }
+  return TRUE;
