+  CPDFSDK_XFAWidget* pWidget = reinterpret_cast<CPDFSDK_XFAWidget*>(pAnnot);
+  CPDFSDK_InterForm* pInterForm = pWidget->GetInterForm();
+  pInterForm->RemoveXFAMap(pWidget->GetXFAWidget());
