+    m_pTimer = pdfium::MakeUnique<CPWL_Timer>(this, GetSystemHandler());
+
+  m_pTimer->SetPWLTimer(nElapse);
+}
+
+void CPWL_TimerHandler::EndTimer() {
+  if (m_pTimer)
+    m_pTimer->KillPWLTimer();
+}
