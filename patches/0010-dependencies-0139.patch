index 0000000000000000000000000000000000000000..7f1d9aa59507aabf03b7c84d6239635c947b42a7
--- /dev/null
+++ b/third_party/pdfium/third_party/freetype/src/psaux/psaux.c
@@ -0,0 +1,34 @@
+/***************************************************************************/
+/*                                                                         */
+/*  psaux.c                                                                */
+/*                                                                         */
+/*    FreeType auxiliary PostScript driver component (body only).          */
+/*                                                                         */
+/*  Copyright 1996-2015 by                                                 */
