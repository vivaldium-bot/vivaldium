+#ifdef PDF_ENABLE_XFA
+  FX_BOOL GetValueByName(const CFX_ByteStringC& utf8Name,
+                         CFXJSE_Value* pValue) override;
+  FX_BOOL SetValueByName(const CFX_ByteStringC& utf8Name,
+                         CFXJSE_Value* pValue) override;
