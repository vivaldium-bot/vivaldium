--- /dev/null
+++ b/third_party/pdfium/third_party/libtiff/tif_tile.c
@@ -0,0 +1,322 @@
+/* $Id: tif_tile.c,v 1.24 2015-06-07 22:35:40 bfriesen Exp $ */
+
+/*
