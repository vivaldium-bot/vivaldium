+CFX_ByteString CFX_ByteString::Right(FX_STRSIZE nCount) const {
+  if (!m_pData)
+    return CFX_ByteString();
+
+  nCount = std::max(nCount, 0);
+  if (nCount >= m_pData->m_nDataLength)
+    return *this;
+
+  CFX_ByteString dest;
+  AllocCopy(dest, nCount, m_pData->m_nDataLength - nCount);
+  return dest;
+}
