+    case 3:
+      cFormat = "999999999";
+      break;
+  }
+
+  std::vector<CJS_Value> params2;
+  params2.push_back(CJS_Value(CJS_Runtime::FromContext(cc), cFormat));
+  return AFSpecial_KeystrokeEx(cc, params2, vRet, sError);
+}
