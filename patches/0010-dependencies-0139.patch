index 0000000000000000000000000000000000000000..3aef8daa423bda440b20dc36b93410d47de49b16
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/winsys/sw/xlib/xlib_sw_winsys.c
@@ -0,0 +1,479 @@
+/**************************************************************************
