+void CPWL_EditImpl::SetContentChanged() {
+  if (m_pNotify) {
+    CFX_FloatRect rcContent = m_pVT->GetContentRect();
+    if (rcContent.Width() != m_rcOldContent.Width() ||
+        rcContent.Height() != m_rcOldContent.Height()) {
+      m_rcOldContent = rcContent;
+    }
+  }
+}
