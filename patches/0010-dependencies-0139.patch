+
+ifneq ($(findstring wayland, $(EGL_PLATFORMS)),)
+SUBDIRS += wayland
+endif
+
+default install clean:
+	@for dir in $(SUBDIRS) ; do \
+		if [ -d $$dir ] ; then \
+			(cd $$dir && $(MAKE) $@) || exit 1; \
+		fi \
+	done
diff --git a/third_party/mesa/src/src/gallium/winsys/sw/android/android_sw_winsys.cpp b/third_party/mesa/src/src/gallium/winsys/sw/android/android_sw_winsys.cpp
