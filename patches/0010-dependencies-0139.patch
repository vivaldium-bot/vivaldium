+  TimerObj* pTimerObj = static_cast<TimerObj*>(pJS_TimerObj->GetEmbedObject());
+  pTimerObj->SetTimer(timerRef);
+
+  vRet = CJS_Value(pRuntime, pRetObj);
+  return TRUE;
