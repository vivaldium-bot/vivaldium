index 0000000000000000000000000000000000000000..519929ec8f6ae47525c52cd89f697f9578a67cf6
--- /dev/null
+++ b/third_party/mesa/src/src/gbm/backends/dri/gbm_dri.c
@@ -0,0 +1,653 @@
+/*
