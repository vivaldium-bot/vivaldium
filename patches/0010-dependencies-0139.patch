+void CPDFXFA_App::Beep(uint32_t dwType) {
+  CPDFSDK_FormFillEnvironment* pEnv = m_pEnvList.GetAt(0);
+  if (pEnv) {
+    pEnv->JS_appBeep(dwType);
+  }
+}
