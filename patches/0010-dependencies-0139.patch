+TEST_F(CFXJSE_FormCalcContextEmbedderTest, TranslateEmpty) {
+  ASSERT_TRUE(OpenDocument("simple_xfa.pdf"));
+
+  const char input[] = "";
+  EXPECT_TRUE(Execute(input));
+  // TODO(dsinclair): This should probably throw as a blank formcalc script
+  // is invalid.
+}
