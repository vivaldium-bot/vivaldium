+      return;
+   }
+
+   vg_validate_state(ctx);
+   image_draw(handle_to_image(image),
+         &ctx->state.vg.image_user_to_surface_matrix);
+}
+
+void vegaSetPixels(VGint dx, VGint dy,
+                   VGImage src, VGint sx, VGint sy,
