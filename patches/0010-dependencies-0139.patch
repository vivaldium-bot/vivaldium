+  CPVT_WordPlace wpStart = m_pEdit->WordIndexToWordPlace(nStartChar);
+  CPVT_WordPlace wpEnd = m_pEdit->WordIndexToWordPlace(nEndChar);
+  return m_pEdit->GetRangeText(CPVT_WordRange(wpStart, wpEnd));
+}
