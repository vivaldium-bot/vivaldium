+	if (! opj_procedure_list_add_procedure(jp2->m_validation_list, (opj_procedure)opj_jp2_default_validation, p_manager)) {
+		return OPJ_FALSE;
+	}
+	/* DEVELOPER CORNER, add your custom validation procedure */
+	
+	return OPJ_TRUE;
+}
