+	long Direct3DDevice8::CreateStateBlock(D3DSTATEBLOCKTYPE type, unsigned long *token)
+	{
+		TRACE("");
+
+		if(!token)
+		{
+			return INVALIDCALL();
+		}
+
+		Direct3DStateBlock8 *stateBlock = new Direct3DStateBlock8(this, type);
+		stateBlock->bind();
