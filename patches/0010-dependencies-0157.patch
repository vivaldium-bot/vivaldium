+	}
+
+	void branch(RValue<Bool> cmp, BasicBlock *bodyBB, BasicBlock *endBB)
+	{
+		Nucleus::createCondBr(cmp.value, bodyBB, endBB);
+		Nucleus::setInsertBlock(bodyBB);
+	}
+
+	RValue<Long> Ticks()
+	{
+		assert(false && "UNIMPLEMENTED"); return RValue<Long>(V(nullptr));
+	}
+}
