+			int(*callable)(void*) = (int(*)(void*))routine->getEntry();
+			callable(&out);
+
+			for(int i = 0; i < 256; i++)
+			{
+				EXPECT_EQ(out.f[i][0], float((i >> 0) & 0x03) + 1.0f);
+				EXPECT_EQ(out.f[i][1], float((i >> 2) & 0x03) + 1.0f);
+				EXPECT_EQ(out.f[i][2], float((i >> 4) & 0x03) + 1.0f);
+				EXPECT_EQ(out.f[i][3], float((i >> 6) & 0x03) + 1.0f);
