+    </xsl:apply-templates>
+  </xsl:copy>
+  </xsl:when><xsl:otherwise>
+  <xsl:text> </xsl:text>
+  </xsl:otherwise></xsl:choose>
+</xsl:template>
+
+<xsl:template match="ol[@id='ratified-by-name']">
