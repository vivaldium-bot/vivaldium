+	void Device::setRenderTarget(int index, egl::Image *renderTarget)
+	{
+		if(renderTarget)
+		{
+			renderTarget->addRef();
+		}
+
+		if(this->renderTarget[index])
+		{
+			this->renderTarget[index]->release();
+		}
+
+		this->renderTarget[index] = renderTarget;
+
+		Renderer::setRenderTarget(index, renderTarget);
+	}
