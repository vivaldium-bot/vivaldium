+	unsigned long Direct3DBaseTexture9::getInternalLevelCount() const
+	{
+		return levels;
+	}
+
+	unsigned long Direct3DBaseTexture9::getUsage() const
+	{
+		return usage;
+	}
+
+	D3DFORMAT Direct3DBaseTexture9::getFormat() const
+	{
+		return format;
+	}
+}
