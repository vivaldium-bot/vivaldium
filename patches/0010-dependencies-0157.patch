+                    fXformer->apply(paint), constraint);
+        }
+
+        fTarget->drawImageRect(fXformer->apply(bitmap).get(),
+                               src ? *src : SkRect::MakeIWH(bitmap.width(), bitmap.height()), dst,
+                               fXformer->apply(paint), constraint);
+    }
+    void onDrawBitmapNine(const SkBitmap& bitmap,
