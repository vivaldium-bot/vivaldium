+	RValue<Int2> UnpackLow(RValue<Short4> x, RValue<Short4> y)
+	{
+		int shuffle[8] = {0, 8, 1, 9, 2, 10, 3, 11};   // Real type is v8i16
+		return As<Int2>(Nucleus::createShuffleVector(x.value, y.value, shuffle));
