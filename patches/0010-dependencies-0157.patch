+Image *Texture2D::getRenderTarget(GLenum target, unsigned int level)
+{
+	ASSERT(target == GL_TEXTURE_2D);
+	ASSERT(level < IMPLEMENTATION_MAX_TEXTURE_LEVELS);
+
+	if(image[level])
+	{
+		image[level]->addRef();
+	}
+
+	return image[level];
+}
