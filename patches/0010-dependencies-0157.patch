+TIntermSwitch *TIntermediate::addSwitch(TIntermTyped *init, TIntermAggregate *statementList, const TSourceLoc &line)
+{
+	TIntermSwitch *node = new TIntermSwitch(init, statementList);
+	node->setLine(line);
+
+	return node;
+}
