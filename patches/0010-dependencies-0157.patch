+// Returns the shared globals
+static SkGlyphCache_Globals& get_globals() {
+    static SkOnce once;
+    static SkGlyphCache_Globals* globals;
+
+    once([]{ globals = new SkGlyphCache_Globals; });
+    return *globals;
+}
