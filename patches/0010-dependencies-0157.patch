+	{
+		TRACE("");
+
+		if(!plane || index > 6)
+		{
+			return INVALIDCALL();
+		}
+
+		if(!recordState)
+		{
+			this->plane[index][0] = plane[0];
+			this->plane[index][1] = plane[1];
+			this->plane[index][2] = plane[2];
+			this->plane[index][3] = plane[3];
+
+			renderer->setClipPlane(index, plane);
+		}
+		else
+		{
+			stateRecorder.back()->setClipPlane(index, plane);
+		}
+
+		return D3D_OK;
+	}
