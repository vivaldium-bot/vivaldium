+	long Direct3D8::RegisterSoftwareDevice(void *initializeFunction)
+	{
+		TRACE("");
+
+		loadSystemD3D8();
+
+		if(d3d8)
+		{
+			return d3d8->RegisterSoftwareDevice(initializeFunction);
+		}
+		else
+		{
+			return INVALIDCALL();
+		}
+	}
+
+	void Direct3D8::loadSystemD3D8()
+	{
+		if(d3d8)
+		{
+			return;
+		}
