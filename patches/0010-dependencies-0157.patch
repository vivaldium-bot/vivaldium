+			return true;
+		case GL_STENCIL_INDEX8:
+		case GL_RGBA4:
+		case GL_RGB5_A1:
+		case GL_RGB565:
+		case GL_RGB8_EXT:
+		case GL_RGBA8_EXT:
+			return false;
+		default:
+			UNIMPLEMENTED();
+		}
+
+		return false;
+	}
