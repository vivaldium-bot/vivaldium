+			UNIMPLEMENTED();
+		}
+
+		if(face == GL_FRONT || face == GL_FRONT_AND_BACK)
+		{
+			context->setStencilParams(func, ref, mask);
+		}
+
+		if(face == GL_BACK || face == GL_FRONT_AND_BACK)
+		{
+			context->setStencilBackParams(func, ref, mask);
