new file mode 100644
index 0000000000000000000000000000000000000000..7dff657c5210cfb1537965ab8757350895ce17d4
--- /dev/null
+++ b/third_party/skia/src/effects/SkLayerDrawLooper.cpp
@@ -0,0 +1,425 @@
+/*
