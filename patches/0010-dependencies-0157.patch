+					}
+					else
+					{
+						return BLENDOP_INVSUB;
+					}
+				}
+			case BLENDOP_MIN:
+				return BLENDOP_MIN;
+			case BLENDOP_MAX:
+				return BLENDOP_MAX;
+			default:
+				ASSERT(false);
