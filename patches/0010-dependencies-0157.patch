+    set_target_properties(libGLES_CM PROPERTIES
+        INCLUDE_DIRECTORIES "${OPENGL_INCLUDE_DIR}"
+        FOLDER "OpenGL"
+        COMPILE_DEFINITIONS "GL_GLEXT_PROTOTYPES; EGLAPI=; GL_API=; GL_APICALL=;"
+        PREFIX ""
+    )
