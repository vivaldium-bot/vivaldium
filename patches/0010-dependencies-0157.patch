+	es2::Context *context = es2::getContext();
+
+	if(context)
+	{
+		es2::FenceSync *fenceSyncObject = context->getFenceSync(sync);
+
+		if(fenceSyncObject)
+		{
+			fenceSyncObject->serverWait(flags, timeout);
