+                               sk_sp<GrTextureProxy>, const GrSamplerParams&, uint32_t flags,
+                               bool usesLocalCoords);
+
+    GrColor          fColor;
+    SkMatrix         fViewMatrix;
+    TextureSampler   fTextureSampler;
+    uint32_t         fFlags;
