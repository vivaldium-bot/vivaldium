+void SkBitmap::freePixels() {
+    if (fPixelRef) {
+        if (fPixelLockCount > 0) {
+            fPixelRef->unlockPixels();
+        }
+        fPixelRef = nullptr;
+        fPixelRefOrigin.setZero();
+    }
+    fPixelLockCount = 0;
+    fPixels = nullptr;
+    fColorTable = nullptr;
