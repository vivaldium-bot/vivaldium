+            , fPaintingData(paintingData) {
+        this->initClassID<GrPerlinNoiseEffect>();
+        this->addTextureSampler(&fPermutationsSampler);
+        this->addTextureSampler(&fNoiseSampler);
+        this->addCoordTransform(&fCoordTransform);
