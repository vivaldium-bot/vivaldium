+        case DRAW_BITMAP_MATRIX: {
+            const SkPaint* paint = fPictureData->getPaint(reader);
+            const SkImage* image = fPictureData->getBitmapAsImage(reader);
+            SkMatrix matrix;
+            reader->readMatrix(&matrix);
+            BREAK_ON_READ_ERROR(reader);
+
