+#include "GrTexture.h"
+#include "GrTextureProxy.h"
+#include "SkGr.h"
+#endif
+
+SkMaskFilter::NinePatch::~NinePatch() {
+    if (fCache) {
+        SkASSERT((const void*)fMask.fImage == fCache->data());
+        fCache->unref();
+    } else {
+        SkMask::FreeImage(fMask.fImage);
+    }
+}
+
