+///////////////////////////////////////////////////////////////////////////////
+
+void SkColorMatrixFilterRowMajor255::flatten(SkWriteBuffer& buffer) const {
+    SkASSERT(sizeof(fMatrix)/sizeof(SkScalar) == 20);
+    buffer.writeScalarArray(fMatrix, 20);
+}
