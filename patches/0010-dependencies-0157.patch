+sk_sp<GrFragmentProcessor> SkTable_ColorFilter::asFragmentProcessor(GrContext* context,
+                                                                    SkColorSpace*) const {
+    SkBitmap bitmap;
+    this->asComponentTable(&bitmap);
+
+    return ColorTableEffect::Make(context, bitmap, fFlags);
+}
