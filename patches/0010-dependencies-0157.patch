+  }
+
+  Folder.prototype.enableTest = function(re) {
+    if (this.name.match(re)) {
+      this.enableUp_();
+    }
+    for (var name in this.subFolders) {
+      this.subFolders[name].enableTest(re);
+    }
+    for (var ii = 0; ii < this.pages.length; ++ii) {
+      this.pages[ii].enableTest(re);
