+		Type_v8i8 =  Ice::IceType_v16i8 | EmulatedV8,
+		Type_v4i8 =  Ice::IceType_v16i8 | EmulatedV4,
+		Type_v2f32 = Ice::IceType_v4f32 | EmulatedV2,
+	};
