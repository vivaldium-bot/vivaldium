diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2010-11-22-EpilogueBug.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2010-11-22-EpilogueBug.ll
