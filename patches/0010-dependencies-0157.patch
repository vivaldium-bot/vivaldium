+string forwardKernelNonDominantParameterBaseCode(string name = string()) {
+  string op_name;
+  if (name.empty()) {
+    op_name = "";
+  } else {
+    op_name = "\nOpName %" + name + " \"" + name + "\"\n";
+  }
+  string out = kHeader + op_name + kBasicTypes + kKernelTypesAndConstants +
+               kKernelDefinition +
+               R"(
+                %main   = OpFunction %voidt None %vfunct
+                %mainl  = OpLabel
+                )" +
+               kKernelSetup;
+  return out;
+}
