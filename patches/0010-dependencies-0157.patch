+
+	switch(texture)
+	{
+	case GL_TEXTURE0:
+	case GL_TEXTURE1:
+		break;
+	default:
+		UNIMPLEMENTED();
+		UNREACHABLE(texture);
+	}
+
+	gl::Context *context = gl::getContext();
+
+	if(context)
+	{
+		context->clientActiveTexture(texture);
+	}
+}
