+				EXPECT_EQ(out.f[256 + i][1], float((i >> 2) & 0x03) + 1.0f);
+				EXPECT_EQ(out.f[256 + i][2], float((i >> 4) & 0x03) + 5.0f);
+				EXPECT_EQ(out.f[256 + i][3], float((i >> 6) & 0x03) + 5.0f);
+			}
