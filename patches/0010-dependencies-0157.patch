+        imgData.data[1] = red[1];
+        imgData.data[2] = red[2];
+        imgData.data[3] = 255;
+        imgData.data[4] = green[0];
+        imgData.data[5] = green[1];
+        imgData.data[6] = green[2];
+        imgData.data[7] = 255;
+        imgCtx.putImageData(imgData, 0, 0);
