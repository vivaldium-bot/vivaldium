+	int face = CubeFaceIndex(target);
+
+	if(!mFaceProxies[face])
+	{
+		mFaceProxies[face] = new Renderbuffer(name, new RenderbufferTextureCubeMap(this, target, level));
+	}
+	else
+	{
+		mFaceProxies[face]->setLevel(level);
