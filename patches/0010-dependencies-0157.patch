+	// Helper struct representing a single shader uniform
+	struct Uniform
+	{
+		struct BlockInfo
+		{
+			BlockInfo(const glsl::Uniform& uniform, int blockIndex);
+
+			int index;
+			int offset;
+			int arrayStride;
+			int matrixStride;
+			bool isRowMajorMatrix;
+		};
