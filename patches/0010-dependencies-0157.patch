+	if(context)
+	{
+		es1::Texture *texture;
+
+		switch(target)
+		{
+		case GL_TEXTURE_2D:
+			texture = context->getTexture2D();
+			break;
+		default:
+			return error(GL_INVALID_ENUM);
+		}
+
+		if(texture->isCompressed(target, 0) || texture->isDepth(target, 0))
+		{
+			return error(GL_INVALID_OPERATION);
+		}
+
+		texture->generateMipmaps();
+	}
+}
