+// Returns true on successful filter state update (valid enum parameter)
+bool Texture::setMagFilter(GLenum filter)
+{
+	switch(filter)
+	{
+	case GL_NEAREST:
+	case GL_LINEAR:
+		mMagFilter = filter;
