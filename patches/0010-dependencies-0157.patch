+	unsigned int Direct3DDevice9::GetAvailableTextureMem()
+	{
+		CriticalSection cs(this);
+
+		TRACE("void");
+
+		int availableMemory = textureMemory - Direct3DResource9::getMemoryUsage();
+		if(availableMemory < 0) availableMemory = 0;
