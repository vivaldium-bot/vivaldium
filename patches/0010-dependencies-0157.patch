+			float *dest = reinterpret_cast<float*>(static_cast<unsigned char*>(buffer) + (y + yoffset) * getPitch() + xoffset * 16);
+
+			for(int x = 0; x < width; x++)
+			{
+				dest[4 * x + 0] = source[x];
