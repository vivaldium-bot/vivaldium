+	template<>
+	void LoadImageRow<SRGB>(const unsigned char *source, unsigned char *dest, GLint xoffset, GLsizei width)
+	{
+		dest += xoffset * 4;
+
+		for(int x = 0; x < width; x++)
+		{
+			for(int rgb = 0; rgb < 3; ++rgb)
+			{
+				*dest++ = sw::sRGB8toLinear8(*source++);
+			}
+			*dest++ = 255;
+		}
+	}
