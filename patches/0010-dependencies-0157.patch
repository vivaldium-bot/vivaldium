+				default:
+					ASSERT(false);
+				}
+				break;
+			case D3DTSS_COLORARG0:
+				switch(value & D3DTA_SELECTMASK)
+				{
+				case D3DTA_CURRENT:
+					renderer->setThirdArgument(stage, sw::TextureStage::SOURCE_CURRENT);
+					break;
+				case D3DTA_DIFFUSE:
