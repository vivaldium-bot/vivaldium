+    GrRenderTargetContext* accessRenderTargetContext() override;
+
+    void drawPaint(const SkPaint& paint) override;
+    void drawPoints(SkCanvas::PointMode mode, size_t count, const SkPoint[],
+                    const SkPaint& paint) override;
