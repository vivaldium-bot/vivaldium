diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2011-09-28-CMovCombineBug.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2011-09-28-CMovCombineBug.ll
