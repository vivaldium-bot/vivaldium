+int Texture3D::getLevelCount() const
+{
+	ASSERT(isSamplerComplete());
+	int levels = 0;
+
+	while(levels < IMPLEMENTATION_MAX_TEXTURE_LEVELS && image[levels])
+	{
+		levels++;
+	}
+
+	return levels;
