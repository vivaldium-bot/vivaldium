+		else
+		{
+			int swizzle[8] = {0, 8, 1, 9, 2, 10, 3, 11};
+			Value *c = Nucleus::createShuffleVector(cast.value, Short8(0, 0, 0, 0, 0, 0, 0, 0).loadValue(), swizzle);
+			*this = As<Int4>(c);
+		}
