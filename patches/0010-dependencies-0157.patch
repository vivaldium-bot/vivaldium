+		FrameBufferAndroid(ANativeWindow* window, int width, int height);
+
+		~FrameBufferAndroid() override;
+
+		void flip(void *source, Format sourceFormat, size_t sourceStride) override {blit(source, 0, 0, sourceFormat, sourceStride);};
