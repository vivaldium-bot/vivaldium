+bool GrSpecularLightingEffect::onIsEqual(const GrFragmentProcessor& sBase) const {
+    const GrSpecularLightingEffect& s = sBase.cast<GrSpecularLightingEffect>();
+    return INHERITED::onIsEqual(sBase) &&
+           this->ks() == s.ks() &&
