+class ColorTableEffect : public GrFragmentProcessor {
+public:
+    static sk_sp<GrFragmentProcessor> Make(GrContext* context,
+                                           const SkBitmap& bitmap,
+                                           unsigned flags);
+
+    ~ColorTableEffect() override;
+
+    const char* name() const override { return "ColorTable"; }
+
