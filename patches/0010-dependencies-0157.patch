+	Renderer/SetupProcessor.cpp \
+	Renderer/Surface.cpp \
+	Renderer/TextureStage.cpp \
+	Renderer/Vector.cpp \
+	Renderer/VertexProcessor.cpp \
+
+COMMON_SRC_FILES += \
