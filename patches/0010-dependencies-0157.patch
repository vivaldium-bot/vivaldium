diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2003-08-03-CallArgLiveRanges.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2003-08-03-CallArgLiveRanges.ll
