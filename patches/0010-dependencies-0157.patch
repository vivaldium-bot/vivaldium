+	long __stdcall Direct3DVolume9::QueryInterface(const IID &iid, void **object)
+	{
+		CriticalSection cs(device);
+
+		TRACE("");
+
+		if(iid == IID_IDirect3DVolume9 ||
+		   iid == IID_IUnknown)
+		{
+			AddRef();
+			*object = this;
