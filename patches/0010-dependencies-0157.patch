+	egl::Context *context = static_cast<egl::Context*>(ctx);
+
+	if(!validateContext(display, context))
+	{
+		return EGL_FALSE;
+	}
+
+	if(ctx == EGL_NO_CONTEXT)
+	{
+		return error(EGL_BAD_CONTEXT, EGL_FALSE);
+	}
+
+	display->destroyContext(context);
+
+	return success(EGL_TRUE);
+}
