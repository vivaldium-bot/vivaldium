+public:
+    static constexpr int kNumColors = 6;
+
+    static sk_sp<SkOverdrawColorFilter> Make(const SkPMColor colors[kNumColors]) {
+        return sk_sp<SkOverdrawColorFilter>(new SkOverdrawColorFilter(colors));
