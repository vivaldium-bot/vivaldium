+
+inline bool IsShadowSampler(TBasicType type)
+{
+	switch(type)
+	{
+	case EbtSampler2DShadow:
+	case EbtSamplerCubeShadow:
+	case EbtSampler2DArrayShadow:
+		return true;
+	case EbtISampler2D:
