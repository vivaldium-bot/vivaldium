+				break;
+			case D3DRS_EMISSIVEMATERIALSOURCE:
+				switch(value)
+				{
+				case D3DMCS_MATERIAL:
+					renderer->setEmissiveMaterialSource(sw::MATERIAL_MATERIAL);
