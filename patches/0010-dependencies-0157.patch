+void Texture2D::setSharedImage(egl::Image *sharedImage)
+{
+	if(sharedImage == image[0])
+	{
+		return;
+	}
+
+	sharedImage->addRef();
+
+	if(image[0])
+	{
+		image[0]->release();
+	}
+
+	image[0] = sharedImage;
+}
