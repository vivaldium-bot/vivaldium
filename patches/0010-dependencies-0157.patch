+		Direct3DStateBlock9 *stateRecorder;
+
+		unsigned long renderState[D3DRS_BLENDOPALPHA + 1];
+		unsigned long textureStageState[8][D3DTSS_CONSTANT + 1];
+		unsigned long samplerState[16 + 4][D3DSAMP_DMAPOFFSET + 1];
+		bool init;
+
