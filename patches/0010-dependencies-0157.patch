diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2010-11-15-SpillEarlyClobber.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/ARM/2010-11-15-SpillEarlyClobber.ll
