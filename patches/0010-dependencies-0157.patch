+const GrXPFactory* GrPorterDuffXPFactory::TestGet(GrProcessorTestData* d) {
+    SkBlendMode mode = SkBlendMode(d->fRandom->nextULessThan((int)SkBlendMode::kLastCoeffMode));
+    return GrPorterDuffXPFactory::Get(mode);
+}
