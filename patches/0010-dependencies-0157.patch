--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.3/extra/webgl-drawelements-validation.html
@@ -0,0 +1,163 @@
+<!--
+
+/*
+** Copyright (c) 2014 The Khronos Group Inc.
+**
