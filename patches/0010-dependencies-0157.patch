+    struct WebPDemuxer;
+    void WebPDemuxDelete(WebPDemuxer* dmux);
+}
+
+static const size_t WEBP_VP8_HEADER_SIZE = 30;
+
+class SkWebpCodec final : public SkCodec {
+public:
+    // Assumes IsWebp was called and returned true.
+    static SkCodec* NewFromStream(SkStream*);
