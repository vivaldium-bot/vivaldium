-// Calls requestDevice() in a context that's 'allowed to show a popup'.
-function requestDeviceWithKeyDown() {
-  let args = arguments;
-  return callWithKeyDown(() => navigator.bluetooth.requestDevice.apply(navigator.bluetooth, args));
-}
