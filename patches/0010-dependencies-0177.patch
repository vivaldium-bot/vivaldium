+
+                break;
+            }
+
+            case gl.TEXTURE_3D: {
+                vertexArrays = [
+                    gluDrawUtil.vabFromBindingPointAndArrayPointer(
+                        gluDrawUtil.bindingPointFromName('a_position'),
+                        new gluDrawUtil.VertexArrayPointer(
