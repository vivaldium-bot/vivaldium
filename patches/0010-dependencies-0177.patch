+        // The number of reverse channels used for processing to is always 1.
+        EXPECT_EQ(1u, apm_->num_reverse_channels());
+      } else {
+        TestChangingForwardChannels(i, j,
+                                    AudioProcessing::kBadNumberChannelsError);
+      }
+    }
+  }
+}
