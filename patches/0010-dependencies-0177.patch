+    glsBufferTestUtil.fetchVtxColor = function(ptr, vtxNdx) {
+        return new tcuRGBA.RGBA([
+            ptr[vtxNdx * 3 + 0],
+            ptr[vtxNdx * 3 + 1],
+            ptr[vtxNdx * 3 + 2],
+            255]).toVec();
+    };
