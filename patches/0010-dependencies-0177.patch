+        var rnd = new deRandom.Random(0xabc231);
+
+        var dst = [];
+
+        for (var i = 0; i < numColors; ++i) {
+            dst[3 * i] = rnd.getFloat(minVal, maxVal);
+            dst[3 * i + 1] = rnd.getFloat(minVal, maxVal);
+            dst[3 * i + 2] = rnd.getFloat(minVal, maxVal);
+        }
+
+        return dst;
+    };
