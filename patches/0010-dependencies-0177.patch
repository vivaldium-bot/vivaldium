+}
+
+AudioTransportImpl::~AudioTransportImpl()
+{
+    _playFile.Flush();
+    _playFile.CloseFile();
+    delete &_playFile;
+
+    for (AudioPacketList::iterator iter = _audioList.begin();
+         iter != _audioList.end(); ++iter) {
