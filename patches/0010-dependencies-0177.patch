+void ActivityMonitor::PrintStatistics() {
+  printf("\n");
+  printf("kEmptyFrame       %u\n", counter_[kEmptyFrame]);
+  printf("kAudioFrameSpeech %u\n", counter_[kAudioFrameSpeech]);
+  printf("kAudioFrameCN     %u\n", counter_[kAudioFrameCN]);
