+            /** @type {number} */ var baseNdx = ((y * gridSize) + x) * 6;
+            this.m_indices[baseNdx + 0] = v10;
+            this.m_indices[baseNdx + 1] = v00;
+            this.m_indices[baseNdx + 2] = v01;
