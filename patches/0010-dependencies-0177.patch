+
+  bool _playing;
+  bool _recording;
+  uint64_t _lastCallPlayoutMillis;
+  uint64_t _lastCallRecordMillis;
+
+  FileWrapper& _outputFile;
+  FileWrapper& _inputFile;
+  std::string _outputFilename;
+  std::string _inputFilename;
+
+  Clock* _clock;
+};
+
