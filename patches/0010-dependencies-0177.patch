+        }
+
+        if (_ptrDeviceIn == NULL)
+        {
+            return -1;
+        }
+    }
+
+    HRESULT hr = S_OK;
+    float fLevel(0.0f);
+    volume = 0;
+    _volumeMutex.Enter();
+    hr = _ptrCaptureVolume->GetMasterVolumeLevelScalar(&fLevel);
+    _volumeMutex.Leave();
+    EXIT_ON_ERROR(hr);
+
+    // scale input volume range [0.0,1.0] to valid output range
+    volume = static_cast<uint32_t> (fLevel*MAX_CORE_MICROPHONE_VOLUME);
+
+    return 0;
+
+Exit:
+    _TraceCOMError(hr);
+    return -1;
+}
