index 0000000000000000000000000000000000000000..20b8dcd4721e10af282c2e0d1d373687f0bd09e7
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/deqp/modules/shared/glsRandomUniformBlockCase.js
@@ -0,0 +1,282 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
