+        case gluShaderUtil.DataType.FLOAT:
+        case gluShaderUtil.DataType.INT:
+        case gluShaderUtil.DataType.UINT:
+        case gluShaderUtil.DataType.BOOL: return 1 * deMath.INT32_SIZE;
