+<div id="header">
+
+<table>
+  <tr style="height: 300px;">
+    <td>
+      <table id="toparea">
+        <tr>
+          <td style="width: 300px">
+            <div id="info">
+              <img src="resources/webgl-logo.png" /><br />
+              WebGL Conformance Test Runner<br/>
