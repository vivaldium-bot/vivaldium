+void AudioTransportImpl::SetFullDuplex(bool enable)
+{
+    _fullDuplex = enable;
+
+    for (AudioPacketList::iterator iter = _audioList.begin();
+         iter != _audioList.end(); ++iter) {
+            delete *iter;
+    }
+    _audioList.clear();
+}
