--- /dev/null
+++ b/third_party/webrtc/modules/audio_processing/aec/aec_resampler.cc
@@ -0,0 +1,207 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
