+// ----------------------------------------------------------------------------
+//  ValidSpeakers
+//
+//  Counts number of valid speaker destinations for all mixer devices.
+// ----------------------------------------------------------------------------
+
+UINT AudioMixerManager::ValidSpeakers() const
+{
+    UINT nSpeakers(0);
