+                /** @type {number} */ var sfx = ix + 0.5;
+                /** @type {number} */ var sfy = iy + 0.5;
+                /** @type {number} */ var fx1 = deMath.clamp((sfx - sx0) * oosx, 0.0, 1.0);
+                /** @type {number} */ var fy1 = deMath.clamp((sfy - sy0) * oosy, 0.0, 1.0);
