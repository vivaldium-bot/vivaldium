+int32_t AudioTransportImpl::SetFilePlayout(bool enable, const char* fileName)
+{
+    _playFromFile = enable;
+    if (enable)
+    {
+        return (_playFile.OpenFile(fileName, true, true, false));
+    } else
+    {
+        _playFile.Flush();
+        return (_playFile.CloseFile());
+    }
+}
+;
