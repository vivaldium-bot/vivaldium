index 0000000000000000000000000000000000000000..299682f60d44b260bf5a5e99fb8eb9ff5c8cb583
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/neteq/merge.cc
@@ -0,0 +1,378 @@
+/*
