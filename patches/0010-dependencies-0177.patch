index 0000000000000000000000000000000000000000..4058ff999488dc421a8ec5ae119be8539bb4cded
--- /dev/null
+++ b/third_party/webrtc/modules/audio_device/android/opensles_player.h
@@ -0,0 +1,206 @@
+/*
