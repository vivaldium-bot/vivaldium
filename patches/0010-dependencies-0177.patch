+        var s = gluStrUtil.getPixelFormatName(format.format).substr(3).toLowerCase();
+
+        if (format.unsizedType != gl.NONE)
+            s += '_' + gluStrUtil.getTypeName(format.unsizedType).substr(3).toLowerCase();
+
+        return s;
