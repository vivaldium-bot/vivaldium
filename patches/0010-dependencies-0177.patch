+            var formats = this.m_ctx.getMinFormats().getFormats(flags);
+            if (formats.length) {
+                var format = formats[0];
+                att = glsFboCompletenessTests.makeAttachment(this.m_params.depthKind, format, 64, 64, builder, gl);
