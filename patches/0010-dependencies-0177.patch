+
+  var cot = Math.cos(rad) / s;
+
+  return [
+    cot / aspect,
+    0.0,
+    0.0,
+    0.0,
+
+    0.0,
+    cot,
+    0.0,
+    0.0,
+
+    0.0,
+    0.0,
+    -(f + n) / dz,
+    -1.0,
+
+    0.0,
+    0.0,
+    -2.0 * f * n / dz,
+    0.0
