+  function checkInput(el, ix, arr) {
+    var typeCode = el.trim();
+    if (!(typeCode in typeCodeIncrementer) && typeCode !== "first") {
+      wtu.error("GLSLConstructorTestsGenerator.convertCsvToArray(), unknown type code" + typeCode);        
+      debugger;      
+    }
