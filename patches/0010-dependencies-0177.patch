index 0000000000000000000000000000000000000000..c86ff6eea58e837c7ce7718ee6338f7c25951714
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/extra/simulated-attrib-0-bug-test.html
@@ -0,0 +1,57 @@
+<!--
+
+/*
