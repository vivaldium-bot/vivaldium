+    DWORD dwValue(0);
+
+    // Retrieve one unsigned control value for a specified volume-control identifier
+    //
+    if (!GetUnsignedControlValue(mixerID, dwControlID, dwValue))
+    {
+        return -1;
+    }
+
+    volume = dwValue;
+
+    return 0;
+}
