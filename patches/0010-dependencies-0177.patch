+int32_t AudioDeviceLinuxALSA::RecordingDelay(uint16_t& delayMS) const
+{
+    // Adding 10ms adjusted value to the record delay due to 10ms buffering.
+    delayMS = (uint16_t)(10 + _recordingDelay * 1000 / _recordingFreq);
+    return 0;
+}
