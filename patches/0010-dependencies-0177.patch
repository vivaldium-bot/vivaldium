+
+    gl.useProgram(null);
+
+    glsLifetimeTests.readRectangle(viewport, dst);
+    bufferedLogToConsole('Copied viewport to output image');
+
+    gl.detachShader(program, vtxShader.getShader());
+    bufferedLogToConsole('Removed temporary vertex shader');
