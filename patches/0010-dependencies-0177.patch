+int AudioProcessingImpl::StopDebugRecording() {
+  // Run in a single-threaded manner.
+  rtc::CritScope cs_render(&crit_render_);
+  rtc::CritScope cs_capture(&crit_capture_);
+
+#ifdef WEBRTC_AUDIOPROC_DEBUG_DUMP
