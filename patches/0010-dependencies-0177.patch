+bool APITest::APIRunB() {
+  _apiEventB->Wait(50);
+  bool randomTest;
+  {
+    ReadLockScoped rl(_apiTestRWLock);
+    randomTest = _randomTest;
+  }
+  //_apiEventB->Wait(2000);
+  if (randomTest) {
+    RunTest('B');
+  }
+
+  return true;
+}
