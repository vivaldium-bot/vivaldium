+        case gluShaderUtil.DataType.FLOAT_VEC2:
+        case gluShaderUtil.DataType.INT_VEC2:
+        case gluShaderUtil.DataType.UINT_VEC2:
+        case gluShaderUtil.DataType.BOOL_VEC2: return 2 * deMath.INT32_SIZE;
