+#endif  // WEBRTC_MODULES_AUDIO_PROCESSING_NS_MAIN_SOURCE_NSX_CORE_H_
diff --git a/third_party/webrtc/modules/audio_processing/ns/nsx_core_c.c b/third_party/webrtc/modules/audio_processing/ns/nsx_core_c.c
