+            /** @type {number} */ var stride = gridSize + 1;
+            /** @type {number} */ var v00 = (y * stride) + x;
+            /** @type {number} */ var v01 = (y * stride) + x + 1;
+            /** @type {number} */ var v10 = ((y + 1) * stride) + x;
+            /** @type {number} */ var v11 = ((y + 1) * stride) + x + 1;
