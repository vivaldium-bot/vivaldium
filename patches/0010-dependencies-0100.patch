+static Locale _canonicalize(int32_t selector, /* 0==createFromName, 1==createCanonical, 2==Locale ct */
+                            const char* localeID) {
+    switch (selector) {
+    case 0:
+        return Locale::createFromName(localeID);
+    case 1:
+        return Locale::createCanonical(localeID);
+    case 2:
+        return Locale(localeID);
+    default:
+        return Locale("");
+    }
+}
