+       *bi2clone == *bi1clone )
+        errln((UnicodeString)"ERROR: RBBI's clone() method failed");
+
+    delete bi1clone;
+    delete bi2clone;
+    delete bi1;
+    delete bi3;
+    delete bi2;
+    delete biequal;
+}
