+    0x39,   // '9' for AN
+    0x2c,   // ',' for CS
+    0x2f,   // '/' for B
+    0x5f,   // '_' for S
+    0x20,   // ' ' for WS
+    0x3d,   // '=' for ON
+    0x65,   // 'e' for LRE
+    0x6f,   // 'o' for LRO
+    0x41,   // 'A' for AL
+    0x45,   // 'E' for RLE
+    0x4f,   // 'O' for RLO
+    0x2a,   // '*' for PDF
+    0x60,   // '`' for NSM
+    0x7c,   // '|' for BN
+    // new in Unicode 6.3/ICU 52
+    0x53,   // 'S' for FSI
+    0x69,   // 'i' for LRI
+    0x49,   // 'I' for RLI
+    0x2e    // '.' for PDI
+};
