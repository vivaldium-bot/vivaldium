+void 
+DateFormatRoundTripTest::runIndexedTest( int32_t index, UBool exec, const char* &name, char* par )
+{
+    optionv = (par && *par=='v');
+    switch (index) {
+        CASE(0,TestDateFormatRoundTrip)
+        CASE(1, TestCentury)
+        default: name = ""; break;
+    }
