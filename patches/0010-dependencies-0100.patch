+  // Now the iterative decomposition methods...
+  logln("Iterative decomposition...");
+  Normalizer* norm = new Normalizer("", UNORM_NFD);
+  iterateTest(norm, hangulCanon, ARRAY_LENGTH(hangulCanon), 1);
+  norm->setMode(UNORM_NFKD);
