+        errln("StringPiece::npos!=0x7fffffff");
+    }
+    // substr() method with pos, using len=npos.
+    sp=abcd.substr(-1);
+    if(sp.empty() || sp.data()!=abcdefg_chars || sp.length()!=4 || sp.size()!=4) {
+        errln("abcd.substr(-1) failed");
