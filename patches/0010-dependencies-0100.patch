+        UErrorCode errorCode=U_ZERO_ERROR;
+        if(!(
+                USCRIPT_COMMON==uscript_getScript(0x0640, &errorCode) &&
+                USCRIPT_INHERITED==uscript_getScript(0x0650, &errorCode) &&
+                USCRIPT_ARABIC==uscript_getScript(0xfdf2, &errorCode)) ||
