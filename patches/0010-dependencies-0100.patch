+        const int TUPLE_WIDTH = 3;
+        const int TUPLE_COUNT = (int)(sizeof(tuples)/sizeof(tuples[0]))/TUPLE_WIDTH;
+        for (int i = 0; i < TUPLE_COUNT; ++i) {
