+     TEST_SETUP("((.)+\\2)+x", "aaaaaaaaaaaaaaaaaaab", 0)
+     callBackContext cbInfo = {4, 0, 0};
+     const void     *pContext   = &cbInfo;
+     URegexMatchCallback    *returnedFn = &TestCallbackFn;
