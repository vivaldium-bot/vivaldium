+    NSAssert(NO, @"nil arguments not allowed");
+    self = nil;
+    return nil;
+  }
+  if (self = [super init]) {
+    _mediaTrack = mediaTrack;
+    label = @(mediaTrack->id().c_str());
+    _observer.reset(new webrtc::RTCMediaStreamTrackObserver(self));
+    _mediaTrack->RegisterObserver(_observer.get());
+  }
+  return self;
+}
