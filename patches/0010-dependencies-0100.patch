+    {
+        log_err("String does not match. %s\n", gNuConvTestName);
+        log_verbose("String does not match. %s\n", gNuConvTestName);
+        log_err("Got:      ");
+        printUSeqErr(junkout, expectlen);
+        log_err("Expected: ");
+        printUSeqErr(expect, expectlen);
+        log_err("\n");
+        return FALSE;
+    }
