+    UDate date = -9896080848000.0;
+    SimpleDateFormat fmt("EEEE, dd MMMM yyyy h:mm:ss a", Locale("el", "", ""), ec);
+    if (U_FAILURE(ec)) {
+        dataerrln("Fail construct SimpleDateFormat: %s", u_errorName(ec));
+        return;
+    }
+    UnicodeString str;
+    fmt.format(date, str);
+    ParsePosition pos(0);
+    UDate d2 = fmt.parse(str, pos);
