+    switch (index) {
+
+        case 0: name = "TestToASCII"; if (exec) TestToASCII(); break;
+        case 1: name = "TestToUnicode"; if (exec) TestToUnicode(); break;
+        case 2: name = "TestIDNToASCII"; if (exec) TestIDNToASCII(); break;
