+                                + " for locale: " + locale + " index: "+ loc 
+                                + " to id "+ kData[i].to
+                                + " from id " + kData[i].from);
+                        }
+                    }
+                }
+            }
+        } else {
+            fromName.remove();
+            toName.remove();
+            from->getDisplayName(fromName);
+            to->getDisplayName(toName);
+            if(fromName.compare(toName) != 0) {
+                errln("Fail: Expected "+toName+" but got " + fromName);
+            }
+        }
+        delete from;
+        delete to;
+    }
+}
