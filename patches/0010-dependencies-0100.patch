+
+public class AsyncTestCaseTest extends AsyncTestCase {
+
+  public void testSuccess() {
+    delayTestFinish(1000);
+    AsyncCallback.execute(500, new Runnable() {
+      @Override
+      public void run() {
+        finishTest();
+      }
