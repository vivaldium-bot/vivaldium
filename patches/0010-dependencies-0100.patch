+        status = U_ZERO_ERROR;
+        uregex_setText(re, text1, -1, &status);
+        memset(buf, -1, sizeof(buf));
+        resultSize = uregex_replaceAll(re, replText, -1, buf, expectedResultSize, &status);
+        TEST_ASSERT(status == U_STRING_NOT_TERMINATED_WARNING);
