+void TransliteratorTest::TestNullInverse() {
+    UParseError pe;
+    UErrorCode ec = U_ZERO_ERROR;
+    Transliterator *t = Transliterator::createInstance("Null", UTRANS_FORWARD, pe, ec);
+    if (t == 0 || U_FAILURE(ec)) {
+        errln("FAIL: createInstance");
+        return;
