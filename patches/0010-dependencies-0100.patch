+
+#define TEST_SUCCESS(status) \
+{ if (U_FAILURE(status)) {errln("Test #%d failure in file %s at line %d. Error = \"%s\"\n", \
+       gTestNum, __FILE__, __LINE__, u_errorName(status)); \
+       gFailed = TRUE;\
+   }}
