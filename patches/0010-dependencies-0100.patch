+              "office box. Please use a street"
+              " or building address.",
+              localization.GetErrorMessage(
+                  address, *it, USES_P_O_BOX, true, false));
+    EXPECT_EQ("This address line appears to contain a post "
+              "office box. Please use a street"
+              " or building address.",
+              localization.GetErrorMessage(
