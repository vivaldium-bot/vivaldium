+        }
+    }
+    {
+        UScriptCode code= USCRIPT_INVALID_CODE;
+        UErrorCode  status = U_ZERO_ERROR;
+        int32_t err = 0;
+
+        for(i = 0; i<=0x10ffff; i++){
+            code =  uscript_getScript(i,&status);
+            if(code == USCRIPT_INVALID_CODE){
+                err++;
