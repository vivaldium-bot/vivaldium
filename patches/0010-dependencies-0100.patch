+int32_t getInt(UnicodeString str)
+{
+    char buffer[20];
+    int len=str.length();
+    if(len>=20) {
+        len=19;
+    }
+    str.extract(0, len, buffer, "");
+    buffer[len]=0;
+    return atoi(buffer);
+}
