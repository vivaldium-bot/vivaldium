+        UnicodeString expected=UnicodeString(pair.expected, -1, US_INV).unescape();
+        UnicodeString result=customNorm2->normalize(input, errorCode);
+        if(result!=expected) {
+            errln("custom compose Normalizer2 did not normalize input %d as expected", i);
+        }
