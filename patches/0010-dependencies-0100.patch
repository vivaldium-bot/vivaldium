+            logln("OK: invalid index values handled correctly");
+        else
+            errln("FAIL: invalid index values didn't throw U_ILLEGAL_ARGUMENT_ERROR throw" + (UnicodeString)u_errorName(status));
+    }
+
+    delete t;
