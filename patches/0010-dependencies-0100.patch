+    UnicodeString  pattern;
+    pattern.setTo(temp);
+
+#if !UCONFIG_NO_BREAK_ITERATION
+    if (breaker != NULL) {
+        breaker->setText(text);
+    }
+#endif
+    collator->setStrength(getECollationStrength(search->strength));
