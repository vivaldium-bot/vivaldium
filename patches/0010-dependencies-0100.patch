+    exp.applyPattern("[{ab}b-kmo-z]", status);
+    if (U_FAILURE(status)) { errln("FAIL"); return; }
+    if (set != exp) { errln("FAIL: complementAll(\"alan\")"); return; }
+
+    exp.applyPattern("[a-z]", status);
