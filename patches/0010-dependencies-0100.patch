+    UChar32 c;
+    uint32_t posixResults;
+} posixData[]={
+    { 0x0008,                                                        ISCN },    /* backspace */
+    { 0x0009,                                              ISSP|ISBL|ISCN },    /* TAB */
+    { 0x000a,                                              ISSP|     ISCN },    /* LF */
