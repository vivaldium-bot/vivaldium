+
+UBool checkEqual(const PluralRules &test, char *result, int32_t max) {
+    UnicodeString key;
+    UBool isEqual = TRUE;
+    for (int32_t i=0; i<max; ++i) {
+        key= test.select(i);
+        if ( key.charAt(0)!=result[i] ) {
+            isEqual = FALSE;
+        }
+    }
+    return isEqual;
+}
