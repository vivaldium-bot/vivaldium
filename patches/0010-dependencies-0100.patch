+		       errln((UnicodeString)"Lenient parse failed for \"" + (UnicodeString) strictFailureTestCases[t] + (UnicodeString) "\"");
+		       status = U_ZERO_ERROR;
+	       }
+       }
+
+       delete nFormat;
+   }
