+
+    @SuppressWarnings("unchecked")
+    public AddressSpinnerInfo(Spinner view, AddressField id, AddressField parentId) {
+      this.view = view;
+      this.id = id;
+      this.parentId = parentId;
+      this.adapter = (ArrayAdapter<String>) view.getAdapter();
