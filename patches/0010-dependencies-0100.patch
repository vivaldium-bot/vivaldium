+
+    if(strcmpResult <= 0) {
+      log_err("ERR: expected strcmp(\"9f 00\", \"61 00\") to be >=0 (GREATER).. got %d. Calling strcmp() for sortkeys may not work! \n",
+              strcmpResult);
