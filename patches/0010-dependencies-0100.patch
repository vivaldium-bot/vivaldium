+
+/* set some interesting overlapping ranges */
+static const SetRange
+setRanges2[]={
+    {0x21,   0x7f,       0x5555, TRUE},
+    {0x2f800,0x2fedc,    0x7a,   TRUE},
+    {0x72,   0xdd,       3,      TRUE},
