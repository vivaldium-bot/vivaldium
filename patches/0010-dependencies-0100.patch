+/************************************************************************
+*   Tests for the UText and UTextIterator text abstraction classses
+*
+************************************************************************/
+
+
+#ifndef UTXTTEST_H
+#define UTXTTEST_H
+
+#include "unicode/utypes.h"
+#include "unicode/unistr.h"
+#include "unicode/utext.h"
+
