+    "\x0047\x0052\x004f\x0055\x0050",
+    "\x0049\x004e\x0054\x0045\x0052\x0041\x0043\x0054\x0049\x0056\x0045",  
+    "\x004e\x0045\x0054\x0057\x004f\x0052\x004b", 
+    "\x004f\x0057\x004e\x0045\x0052",
+};
