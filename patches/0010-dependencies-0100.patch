+  int                   _min_hash_value;
+  /* Maximum hash value for all keywords. */
+  int                   _max_hash_value;
+  /* Size of alphabet. */
+  unsigned int const    _alpha_size;
+  /* Value associated with each character. */
+  const int * const     _asso_values;
+};
