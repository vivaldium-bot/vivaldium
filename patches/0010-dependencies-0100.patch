+    public void setSpinnerList(List<RegionData> list, String defaultKey) {
+      currentRegions = list;
+      adapter.clear();
+      for (RegionData item : list) {
+        adapter.add(item.getDisplayName());
+      }
+      adapter.sort(Collator.getInstance(Locale.getDefault()));
