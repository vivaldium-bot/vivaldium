+char * StringSearchTest::toCharString(const UnicodeString &text)
+{
+    static char   result[1024];
+           int    index  = 0;
+           int    count  = 0;
+           int    length = text.length();
+
+    for (; count < length; count ++) {
+        UChar ch = text[count];
+        if (ch >= 0x20 && ch <= 0x7e) {
+            result[index ++] = (char)ch;
+        }
+        else {
+            sprintf(result+index, "\\u%04x", ch);
+            index += 6; /* \uxxxx */
+        }
+    }
+    result[index] = 0;
+
+    return result;
+}
