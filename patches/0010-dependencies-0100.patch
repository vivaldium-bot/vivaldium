+        {17, 16, 17, 17},   //invalid since START>LIMIT valid:-0<=START<=LIMIT
+        {-1, 16, 14, 16},   //invalid since START<0
+        {3,  50, 2,  50}    //invalid since LIMIT>text.length()
+    };
