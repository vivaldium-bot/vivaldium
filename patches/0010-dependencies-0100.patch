+install : all force
+	$(MKINSTALLDIRS) $(DESTDIR)$(bindir)
+	$(INSTALL_PROGRAM) $(TARGETPROG) $(DESTDIR)$(bindir)/$(TARGETPROG)
+
+installdirs : force
+	$(MKINSTALLDIRS) $(DESTDIR)$(bindir)
+
+uninstall : force
+	$(RM) $(DESTDIR)$(bindir)/$(TARGETPROG)
