+        /*1*/{ 1, NULL, "en", ULOC_ACCEPT_VALID },
+        /*2*/{ 2, NULL, "en", ULOC_ACCEPT_FALLBACK },
+        /*3*/{ 3, NULL, "", ULOC_ACCEPT_FAILED },
+        /*4*/{ 4, NULL, "es", ULOC_ACCEPT_VALID },
