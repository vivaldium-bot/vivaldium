+    expect2(new DecimalFormat("##0.####E0", US, status),
+           (int32_t) 12345,
+           "12.345E3", status);
+    expect2(NumberFormat::createScientificInstance(Locale::getFrance(), status),
+           12345.678901,
+           "1,2345678901E4", status);
+    expect(new DecimalFormat("##0.####E0", US, status),
