+    expect(*t, "abc",
+           UNICODE_STRING_SIMPLE("\\u0061 LATIN SMALL LETTER A \\u0062 LATIN SMALL LETTER B \\u0063 LATIN SMALL LETTER C "));
+    delete t;
+
+ FAIL:
+    for (i=0; i<4; ++i) {
+        _TUFUnreg(i);
+    }
