+    for (i=0; i<paraCount; i++) {
+        ubidi_getParagraphByIndex(pBidi, i, &paraStart, &paraLimit, NULL, &errorCode);
+        if ((paraStart!=paraBounds[i]) || (paraLimit!=paraBounds[i+1])) {
