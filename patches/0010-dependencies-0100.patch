+CollPerf2Test::~CollPerf2Test()
+{
+    ucol_close(coll);
+    delete collObj;
+
+    delete data16;
+    delete data8;
+    delete modData16;
+    delete modData8;
+    delete sortedData16;
+    delete sortedData8;
+    delete randomData16;
+    delete randomData8;
+}
