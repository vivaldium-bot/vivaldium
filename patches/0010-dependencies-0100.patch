+    }
+    {
+        digitList.set(1000.00);
+        digitList.getSmallestInterval(result);
+        result.expandToContainDigit(0);
+        verifyInterval(result, 0, 4);
+    }
+    {
+        digitList.set(1000.00);
+        digitList.getSmallestInterval(result);
+        result.expandToContainDigit(-1);
