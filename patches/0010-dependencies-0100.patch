+#if !UCONFIG_NO_FORMATTING
+
+#include "unicode/compactdecimalformat.h"
+#include "unicode/unum.h"
+#include "cmemory.h"
+
+typedef struct ExpectedResult {
+  double value;
+  const char *expected;
+} ExpectedResult;
+
+static const char *kShortStr = "Short";
+static const char *kLongStr = "Long";
+
