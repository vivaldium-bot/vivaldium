+        IDS_LIBADDRESSINPUT_MISMATCHING_VALUE_ZIP_URL,
+        IDS_LIBADDRESSINPUT_MISMATCHING_VALUE_ZIP,
+        IDS_LIBADDRESSINPUT_PO_BOX_FORBIDDEN_VALUE));
