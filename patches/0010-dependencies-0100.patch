+    {0x3042, 0x0000},
+    {0x30A2, 0x0000},
+    {0x3042, 0x3042, 0x0000},
+    {0x30A2, 0x30FC, 0x0000},
+    {0x30A2, 0x30FC, 0x30C8, 0x0000}                               /*  6 */
+};
+
+const static UChar testTargetCases[][MAX_TOKEN_LEN] = {
+    {0xFF9F, 0x0000},
+    {0x30A2, 0x0000},
+    {0x3042, 0x3042, 0x0000},
+    {0x30A2, 0x30FC, 0x0000},
+    {0x30A2, 0x30FC, 0x30C8, 0x0000},
