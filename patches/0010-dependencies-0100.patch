+        temp[i] = (UChar)i;
+    }
+    u_memmove(temp + 1, temp, 7);
+    if(temp[0] != 0) {
+        log_err("an error occured in u_memmove()\n");
+    }
+    for (i = 1; i <= 7; i++) {
+        if(temp[i] != (i - 1)) {
+            log_err("an error occured in u_memmove()\n");
+        }
+    }
+
+    log_verbose("Testing u_strcpy() and u_strcmp()\n");
+
+    for(i=0;i<3;++i)
