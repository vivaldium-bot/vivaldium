+    int i=2;
+    const UChar *temp = sourceLimit;
+    UErrorCode errorCode=U_ZERO_ERROR;
+    uBuf =  (UChar*)malloc(uBufSize * sizeof(UChar)*5);
+    cBuf =(char*)malloc(uBufSize * sizeof(char) * 10);
+
+    ucnv_reset(cnv);
