+
+    osortklen = sortklen;
+    sortklen=ucol_getSortKey(col, test2, u_strlen(test3),  NULL, 0);
+    sortk3=(uint8_t*)malloc(sizeof(uint8_t) * (sortklen+1));
+    memset(sortk3,0xFE, sortklen);
