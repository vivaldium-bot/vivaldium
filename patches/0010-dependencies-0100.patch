+UnicodeString&
+CollatorInfo::getDisplayName(const Locale& displayLocale, UnicodeString& name) const {
+  if (displayNames) {
+    UnicodeString* val = (UnicodeString*)displayNames->get(displayLocale.getName());
+    if (val) {
+      name = *val;
+      return name;
+    }
+  }
+
+  return locale.getDisplayName(displayLocale, name);
+}
