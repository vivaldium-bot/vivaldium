+           "                         handled are currently C++, ANSI-C, C, and KR-C. The\n"
+           "                         default is C.\n");
+  fprintf (stream, "\n");
+  fprintf (stream,
+           "Details in the output code:\n");
+  fprintf (stream,
+           "  -K, --slot-name=NAME   Select name of the keyword component in the keyword\n"
+           "                         structure.\n");
+  fprintf (stream,
+           "  -F, --initializer-suffix=INITIALIZERS\n"
