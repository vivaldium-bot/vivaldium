+    CASE(1,TestGregorian);
+    CASE(2,TestBuddhist);
+    CASE(3,TestJapanese);
+    CASE(4,TestBuddhistFormat);
+    CASE(5,TestJapaneseFormat);
+    CASE(6,TestJapanese3860);
+    CASE(7,TestPersian);
+    CASE(8,TestPersianFormat);
+    CASE(9,TestTaiwan);
+    default: name = ""; break;
+    }
+}
