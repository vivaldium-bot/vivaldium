+    REGEX_ASSERT(*pat1c == *pat1);
+    REGEX_ASSERT(*pat1c != *pat2);
+
+    delete pat1c;
+    delete pat1a;
+    delete pat1;
+    delete pat2;
+
+    utext_close(&re1);
+    utext_close(&re2);
