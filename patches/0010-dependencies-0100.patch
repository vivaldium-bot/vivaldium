+        msg = message;
+    } else {
+        msg = UnicodeString("[DATA] " + message);
+    }
+
+    if (!no_err_msg) {
+      if ( errCount == 1) {
+          LL_message( msg + " - (Are you missing data?)", TRUE ); // only show this message the first time
+      } else {
+          LL_message( msg , TRUE );
+      }
+    }
+}
