+        case 0x68: //'h': // Hiragana-Katakana
+            expect(*hk, h, k);
+            break;
+        case 0x6B: //'k': // Katakana-Hiragana
+            expect(*kh, k, h);
+            break;
+        case 0x62: //'b': // both
+            expect(*hk, h, k);
+            expect(*kh, k, h);
+            break;
+        }
+    }
+    delete hk;
+    delete kh;
+}
