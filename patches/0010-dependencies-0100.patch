+            CONFIRM_EQ(u_errorName(err), u_errorName(U_INDEX_OUTOFBOUNDS_ERROR));
+            //reset the iterator
+            err = U_ZERO_ERROR;
+            bundle.resetIterator();
+         /*  The following code is causing a crash
