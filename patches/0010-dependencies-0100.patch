+    {
+        UChar    text1[80];
+        UChar    buf[80];
+        UBool    result;
+        int32_t  resultSz;
+        u_uastrncpy(text1, "noise abc interior def, and this is off the end",  UPRV_LENGTHOF(text1));
+
+        status = U_ZERO_ERROR;
+        re = uregex_openC("abc(.*?)def", 0, NULL, &status);
