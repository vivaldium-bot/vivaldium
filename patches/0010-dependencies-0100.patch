+class RTCMediaStreamTrackObserver : public ObserverInterface {
+ public:
+  RTCMediaStreamTrackObserver(RTCMediaStreamTrack* track) { _track = track; }
+
+  void OnChanged() override {
+    [_track.delegate mediaStreamTrackDidChange:_track];
