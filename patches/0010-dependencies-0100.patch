+    }
+
+    logln("Testing pow");
+    // pow
+    LLAssert(llong(0, 0).pow(0) == llong(0, 0));
+    LLAssert(llong(0, 0).pow(2) == llong(0, 0));
+    LLAssert(llong(0, 2).pow(0) == llong(0, 1));
