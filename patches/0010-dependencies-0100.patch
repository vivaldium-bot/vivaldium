+        fmt.format(*cal,result,pos);
+        if (result != info[4]) {
+            errln(info[0] + ";" + info[1] + ";" + info[2] + ";" + info[3] + " expected: '" +
+                  info[4] + "' but got: '" + result + "'");
+        }
+    }
