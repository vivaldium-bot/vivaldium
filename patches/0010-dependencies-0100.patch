+
+    UConverter *cnv;
+
+#define NAME_LMBCS_1 "LMBCS-1"
+#define NAME_LMBCS_2 "LMBCS-2"
+
+
+   /* Some basic open/close/property tests on some LMBCS converters */
+    {
+
+      char expected_subchars[] = {0x3F};   /* ANSI Question Mark */
