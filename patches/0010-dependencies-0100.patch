+    { "ZM" , 894, "014", URGN_TERRITORY, "002" },
+    { "ZR" , 180, "017", URGN_TERRITORY, "002" },
+    { "ZW" , 716, "014", URGN_TERRITORY, "002" },
+    { "ZZ" , 999, NULL , URGN_UNKNOWN, NULL },
+    { NULL ,   0, NULL , URGN_UNKNOWN, NULL } /* terminator */
+    };
