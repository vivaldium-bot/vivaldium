+    if (u_strcspn(testString, fg) != u_strlen(testString)) {
+        log_err("u_strcspn didn't return NULL for \"fg\".\n");
+    }
+    if (u_strcspn(testString, gf) != u_strlen(testString)) {
+        log_err("u_strcspn didn't return NULL for \"gf\".\n");
