+    if ((pp == 0) || (!fmt_arr)) {
+        errln("*** MSG parse (ustring, parsepos., count) error.");
+    }else{
+        logln("MSG parse -- count: %d", count);
+        if (count != 2) {
+            errln("*** MSG parse (ustring, parsepos., count) count err.");
