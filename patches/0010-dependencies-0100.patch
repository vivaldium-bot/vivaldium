+static void TestDoubleAttribute(void)
+{
+    double mydata[] = { 1.11, 22.22, 333.33, 4444.44, 55555.55, 666666.66, 7777777.77, 88888888.88, 999999999.99};
+    double dvalue;
+    int i;
