+int32_t TestCollator::getSortKey(const UChar*source, int32_t sourceLength, 
+                                 uint8_t*result, int32_t resultLength) const
+{
+    UnicodeString str(source, sourceLength);
+    return getSortKey(str, result, resultLength);
