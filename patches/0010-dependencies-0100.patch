+    iter5.next(status);
+    if (U_FAILURE(status) || *iter4 != iter5) {
+        errln("collation iterator equal");
+    }
+    CollationElementIterator iter6(*iter4);
+    if (*iter4 != iter6) {
+        errln("collation iterator equal");
+    }
+    iter4->next(status);
+    if (U_FAILURE(status) || *iter4 == iter5) {
+        errln("collation iterator not equal");
+    }
+    iter5.next(status);
+    if (U_FAILURE(status) || *iter4 != iter5) {
+        errln("collation iterator equal");
+    }
+    iter4->next(status);
+    if (U_FAILURE(status) || *iter4 == iter5) {
+        errln("collation iterator not equal");
+    }
+    iter5.next(status);
+    if (U_FAILURE(status) || *iter4 != iter5) {
