+void setupResult(const int32_t testSource[], char result[], int32_t* max) {
+    int32_t i=0;
+    int32_t curIndex=0;
+
+    do {
+        while (curIndex < testSource[i]) {
+            result[curIndex++]=0x6F; //'o' other
+        }
+        result[curIndex++]=0x61; // 'a'
+
+    } while(testSource[++i]>0);
+    *max=curIndex;
+}
