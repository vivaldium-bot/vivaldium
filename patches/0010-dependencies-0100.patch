+}
+
+BytesTrieTest::BytesTrieTest() : builder_(NULL) {
+    IcuTestErrorCode errorCode(*this, "BytesTrieTest()");
+    builder_=new BytesTrieBuilder(errorCode);
+}
+
+BytesTrieTest::~BytesTrieTest() {
+    delete builder_;
+}
+
