+void UCharsTrieTest::checkData(const StringAndValue data[], int32_t dataLength, UStringTrieBuildOption buildOption) {
+    LocalPointer<UCharsTrie> trie(buildTrie(data, dataLength, buildOption));
+    if(trie.isNull()) {
