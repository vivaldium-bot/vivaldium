+static const CheckRange
+checkRanges1[]={
+    {0,      0},      /* dummy start range to make _testEnumRange() simpler */
+    {0x20,   0},
+    {0xa7,   0x1234},
+    {0x3400, 0},
+    {0x9fa6, 0x6162},
+    {0xda9e, 0x3132},
+    {0xdada, 0},
