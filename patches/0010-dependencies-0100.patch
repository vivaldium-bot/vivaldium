+#define TEST_SETUP {  \
+    UErrorCode status = U_ZERO_ERROR; \
+    USpoofChecker *sc;     \
+    sc = uspoof_open(&status);  \
+    TEST_ASSERT_SUCCESS(status);   \
+    if (U_SUCCESS(status)){
+
+#define TEST_TEARDOWN  \
+    }  \
+    TEST_ASSERT_SUCCESS(status);  \
+    uspoof_close(sc);  \
