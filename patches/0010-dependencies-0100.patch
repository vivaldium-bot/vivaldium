+UBool 
+DateFormatRoundTripTest::failure(UErrorCode status, const char* msg, const UnicodeString& str)
+{
+    if(U_FAILURE(status)) {
+        UnicodeString escaped;
+        escape(str,escaped);
+        errln(UnicodeString("FAIL: ") + msg + " failed, error " + u_errorName(status) + ", str=" + escaped);
+        return TRUE;
+    }
+
+    return FALSE;
