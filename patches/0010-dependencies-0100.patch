+/********************************************************************
+ * COPYRIGHT:
+ * Copyright (c) 1997-2013, International Business Machines Corporation and
+ * others. All Rights Reserved.
+ ********************************************************************/
+
+#include "unicode/utypes.h"
+
+#if !UCONFIG_NO_FORMATTING
+
