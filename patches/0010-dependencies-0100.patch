+
+void TestConstruction1()
+{
+    UResourceBundle *test1 = 0, *test2 = 0;
+    const UChar *result1, *result2;
+    int32_t resultLen;
+    UChar temp[7];
+
+    UErrorCode   err = U_ZERO_ERROR;
