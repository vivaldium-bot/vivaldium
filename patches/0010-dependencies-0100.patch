+UnicodeSetTest::expectPairs(const UnicodeSet& set, const UnicodeString& expectedPairs) {
+    if (getPairs(set) != expectedPairs) {
+        errln(UnicodeString("FAIL: Expected pair list \"") +
+              escape(expectedPairs) + "\", got \"" +
+              escape(getPairs(set)) + "\"");
