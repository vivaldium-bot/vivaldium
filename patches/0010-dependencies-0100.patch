+            const llong rhs = *tuples[i*TUPLE_WIDTH+1];
+            const llong ans = *tuples[i*TUPLE_WIDTH+2];
+
+            llong n = lhs;
+            if (!((n %= rhs) == ans)) {
+                errln("fail: (n %= rhs) == ans");
