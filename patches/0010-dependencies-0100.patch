+int32_t TestCollator::getSortKey(const UnicodeString& source, uint8_t* result, 
+                                 int32_t resultLength) const
+{
+    UErrorCode status = U_ZERO_ERROR;
+    int32_t length = source.extract((char *)result, resultLength, NULL, 
+                                    status);
+    result[length] = 0;
+    return length;
+}
