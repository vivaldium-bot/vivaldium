+        log_err("u_strcspn couldn't find d or c.\n");
+    }
+    if (u_strcspn(testString, cd) != 2) {
+        log_err("u_strcspn couldn't find c or d.\n");
+    }
+    if (u_strcspn(testString, cdh) != 2) {
+        log_err("u_strcspn couldn't find c, d or h.\n");
