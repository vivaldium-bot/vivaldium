+UBool 
+CalendarRegressionTest::failure(UErrorCode status, const char* msg)
+{
+    if(U_FAILURE(status)) {
+        errcheckln(status, UnicodeString("FAIL: ") + msg + " failed, error " + u_errorName(status));
+        return TRUE;
+    }
+
+    return FALSE;
