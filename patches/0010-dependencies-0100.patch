+char* Char32ToEscapedChars(UChar32 ch, char* buffer) {
+    if (ch <= 0xFFFF) {
+        sprintf(buffer, "\\u%04x", (int)ch);
+    } else {
+        sprintf(buffer, "\\U%08x", (int)ch);
+    }
+    return buffer;
+}
