+TEST(AddressDataTest, GetFieldValueInvalid) {
+  AddressData address;
+  ASSERT_DEATH(address.GetFieldValue(STREET_ADDRESS), "ssertion.*failed");
+}
+
+TEST(AddressDataTest, GetVectorFieldValueInvalid) {
