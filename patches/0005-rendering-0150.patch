-var result = [];
-function recordEvent(e) {
-    var kind = e.target instanceof XMLHttpRequest ? 'load' : 'upload';
-    result.push(kind, e.type);
-}
-
-var abortAfterSendLoadend = async_test("Progress event delivery on abort(), post-send() (async)");
