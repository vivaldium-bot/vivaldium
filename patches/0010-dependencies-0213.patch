+    size_(size),
+    handle_(handle),
+    id_(id) {
+}
+
+}  // namespace webrtc
diff --git a/third_party/webrtc/modules/desktop_capture/shared_memory.h b/third_party/webrtc/modules/desktop_capture/shared_memory.h
new file mode 100644
