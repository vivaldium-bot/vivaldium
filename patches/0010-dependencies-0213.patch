+                        size_t payload_size);
+  void IncomingFeedback(int64_t arrival_time_ms,
+                        int64_t send_time_ms,
+                        uint16_t sequence_number,
+                        size_t payload_size,
+                        const PacedPacketInfo& pacing_info);
+
+  // Generates a frame of packets belonging to a stream at a given bitrate and
