+    @"iPad2,4": @(RTCDeviceTypeIPad2Wifi2),
+    @"iPad2,5": @(RTCDeviceTypeIPadMiniWifi),
+    @"iPad2,6": @(RTCDeviceTypeIPadMiniGSM),
