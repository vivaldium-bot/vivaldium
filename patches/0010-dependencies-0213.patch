index 0000000000000000000000000000000000000000..567d81f610a93c73d6151e83707544e0c6bccae4
--- /dev/null
+++ b/third_party/webrtc/modules/bitrate_controller/send_side_bandwidth_estimation_unittest.cc
@@ -0,0 +1,168 @@
+/*
