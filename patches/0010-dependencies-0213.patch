index 0000000000000000000000000000000000000000..5c276fc254aa73f79f618d95899903ddd588ebbe
--- /dev/null
+++ b/third_party/webrtc/sdk/objc/Framework/Classes/RTCAVFoundationVideoCapturerInternal.mm
@@ -0,0 +1,500 @@
+/*
