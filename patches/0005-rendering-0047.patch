-  body
-    {
-      font-size: 16px;
-      line-height: 1.25; /* therefore, each line box is 20px tall */
-      margin-bottom: 0px;
-      margin-top: 0px;
-    }
-
-  div#sized-400px-htb-containing-block
-    {
-      height: 400px;
-    }
-
-  div#ortho-block-vlr
-    {
-      border: blue solid 3px;
-      height: auto;
-      writing-mode: vertical-lr;
-    }
-  ]]></style>
-
- </head>
