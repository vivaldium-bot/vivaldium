-keyDown('ArrowDown'); //  -> Week [52], yyyy
-keyDown('ArrowUp'); //    -> Week [53], yyyy
-keyDown('ArrowDown'); //  -> Week [52], yyyy
-keyDown('ArrowRight'); // -> Week 52, [yyyy]
