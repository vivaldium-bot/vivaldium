-  assert_equals(document.createElementNS(SVGNS, "s:SVG").tagName, "s:SVG")
-}, "tagName should not upper-case for SVG elements in HTML documents.")
-
-test(function() {
-  if ("DOMParser" in window) {
-    var xmlel = new DOMParser()
