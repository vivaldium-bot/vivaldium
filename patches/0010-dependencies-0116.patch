index 0000000000000000000000000000000000000000..a16821970577be1059318a02a395d7b06b06e364
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/arm/neon/loopfiltersimplehorizontaledge_neon.c
@@ -0,0 +1,104 @@
