+void CPWL_Wnd::SetVisible(FX_BOOL bVisible) {
+  if (IsValid()) {
+    for (int32_t i = 0, sz = m_aChildren.GetSize(); i < sz; i++) {
+      if (CPWL_Wnd* pChild = m_aChildren.GetAt(i)) {
+        pChild->SetVisible(bVisible);
+      }
+    }
+
+    if (bVisible != m_bVisible) {
+      m_bVisible = bVisible;
+      RePosChildWnd();
+      InvalidateRect();
+    }
+  }
+}
