+      m_pEdit->SelectNone();
+      m_pEdit->PaintSetProps(m_eProps, m_wrPlace);
+      m_pEdit->SetSel(m_wrPlace.BeginPos, m_wrPlace.EndPos);
+    }
+  }
+}
+
+void CFXEU_SetWordProps::Undo() {
+  if (m_pEdit) {
+    m_pEdit->SetWordProps(m_eProps, m_wpPlace, &m_OldWordProps, m_wrPlace,
+                          FALSE);
+    if (IsFirst()) {
+      m_pEdit->SelectNone();
+      m_pEdit->PaintSetProps(m_eProps, m_wrPlace);
+      m_pEdit->SetSel(m_wrPlace.BeginPos, m_wrPlace.EndPos);
+    }
+  }
+}
