--- /dev/null
+++ b/third_party/libsrtp/srtp/srtp/ekt.c
@@ -0,0 +1,279 @@
+/*
+ * ekt.c
+ *
+ * Encrypted Key Transport for SRTP
+ * 
+ * David McGrew
