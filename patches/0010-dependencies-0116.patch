+                                                            void** ppvObject) {
+  if (iid == IID_IUnknown || iid == __uuidof(IDWriteFontFileStream)) {
+    *ppvObject = this;
+    AddRef();
+    return S_OK;
+  }
+  *ppvObject = NULL;
+  return E_NOINTERFACE;
