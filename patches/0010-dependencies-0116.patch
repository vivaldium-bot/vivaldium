+                   int length,
+                   FPDF_BOOL bUI,
+                   FPDF_WIDESTRING To,
+                   FPDF_WIDESTRING Subject,
+                   FPDF_WIDESTRING CC,
+                   FPDF_WIDESTRING BCC,
