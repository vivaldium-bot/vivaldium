+CPDFSDK_AnnotHandlerMgr::~CPDFSDK_AnnotHandlerMgr() {
+  for (int i = 0; i < m_Handlers.GetSize(); i++) {
+    IPDFSDK_AnnotHandler* pHandler = m_Handlers.GetAt(i);
+    delete pHandler;
+  }
+  m_Handlers.RemoveAll();
+  m_mapType2Handler.clear();
