+#define PWL_CARET_FLASHINTERVAL 500
+
+CPWL_Caret::CPWL_Caret()
+    : m_bFlash(FALSE),
+      m_ptHead(0, 0),
+      m_ptFoot(0, 0),
+      m_fWidth(0.4f),
+      m_nDelay(0) {}
+
