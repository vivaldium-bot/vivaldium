+   EXPECT_EQ(1, __glFogfv_size(GL_FOG_MODE));
+   EXPECT_EQ(1, __glFogfv_size(GL_FOG_OFFSET_VALUE_SGIX));
+   EXPECT_EQ(1, __glFogfv_size(GL_FOG_DISTANCE_MODE_NV));
+   EXPECT_EQ(4, __glFogfv_size(GL_FOG_COLOR));
+}
