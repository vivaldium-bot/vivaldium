+int FXSYS_stricmp(const char* dst, const char* src) {
+  int f, l;
+  do {
+    if (((f = (unsigned char)(*(dst++))) >= 'A') && (f <= 'Z')) {
+      f -= ('A' - 'a');
+    }
+    if (((l = (unsigned char)(*(src++))) >= 'A') && (l <= 'Z')) {
+      l -= ('A' - 'a');
+    }
+  } while (f && (f == l));
+  return (f - l);
+}
+int FXSYS_wcsicmp(const FX_WCHAR* dst, const FX_WCHAR* src) {
+  FX_WCHAR f, l;
+  do {
+    if (((f = (FX_WCHAR)(*(dst++))) >= 'A') && (f <= 'Z')) {
+      f -= ('A' - 'a');
