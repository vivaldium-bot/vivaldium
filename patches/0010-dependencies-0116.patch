+      CPWL_PathData(
+          CPWL_Point(tail.x + fWidth / 30.0f, -fWidth / 30.0f / k + tail.y),
+          PWLPT_MOVETO),
+      CPWL_PathData(CPWL_Point(tail.x + fWidth / 30.0f - fWidth * 0.18f,
+                               -k * fWidth * 0.18f - fWidth / 30 / k + tail.y),
