+  pArray->AddNumber((FX_FLOAT)FXSYS_GetRValue(color) / 255.0f);
+  pArray->AddNumber((FX_FLOAT)FXSYS_GetGValue(color) / 255.0f);
+  pArray->AddNumber((FX_FLOAT)FXSYS_GetBValue(color) / 255.0f);
+  m_pAnnot->GetAnnotDict()->SetAt("C", pArray);
+}
