+      m_pSubstFont);
+#if _FXM_PLATFORM_ == _FXM_PLATFORM_APPLE_
+  if (m_pSubstFont->m_ExtHandle) {
+    m_pPlatformFont = m_pSubstFont->m_ExtHandle;
+    m_pSubstFont->m_ExtHandle = NULL;
+  }
+#endif
+  if (m_Face) {
