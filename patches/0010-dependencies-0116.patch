+FX_BOOL CPSPrinterDriver::StartDIBits(const CFX_DIBSource* pBitmap,
+                                      int bitmap_alpha,
+                                      FX_DWORD color,
+                                      const CFX_Matrix* pMatrix,
+                                      FX_DWORD render_flags,
+                                      void*& handle,
+                                      int alpha_flag,
+                                      void* pIccTransform,
