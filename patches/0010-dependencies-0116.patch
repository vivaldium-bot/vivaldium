index 0000000000000000000000000000000000000000..0f8ff7d6d7c02a03c56335a0f2733abc0e1a4ba3
--- /dev/null
+++ b/third_party/pdfium/public/fpdf_dataavail.h
@@ -0,0 +1,273 @@
