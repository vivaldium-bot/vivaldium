+    "srtp/crypto/hash/sha1.c",
+    "srtp/crypto/kernel/alloc.c",
+    "srtp/crypto/kernel/crypto_kernel.c",
+    "srtp/crypto/kernel/err.c",
+    "srtp/crypto/kernel/key.c",
+    "srtp/crypto/math/datatypes.c",
