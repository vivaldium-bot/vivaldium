+    case PCS_SQUARE:
+      return GetAppStream_Square(ScaleRect(rcCenter, 2.0f / 3.0f), crText);
+    case PCS_STAR:
+      return GetAppStream_Star(ScaleRect(rcCenter, 2.0f / 3.0f), crText);
+  }
