+                                        const PWL_PATH_TYPE type) {
+  FX_FLOAT fWidth = crBBox.right - crBBox.left;
+  FX_FLOAT fHeight = crBBox.top - crBBox.bottom;
+
+  CPWL_PathData PathArray[] = {
+      CPWL_PathData(
+          CPWL_Point(crBBox.left + fWidth / 10, crBBox.bottom + fHeight / 10),
+          PWLPT_MOVETO),
