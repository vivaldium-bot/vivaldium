--- /dev/null
+++ b/third_party/mesa/src/src/glx/apple/appledri.c
@@ -0,0 +1,450 @@
+/* $XFree86: xc/lib/GL/dri/XF86dri.c,v 1.12 2001/08/27 17:40:57 dawes Exp $ */
+/**************************************************************************
+
+Copyright 1998-1999 Precision Insight, Inc., Cedar Park, Texas.
