+FX_BOOL CPWL_IconList_Content::OnLButtonDown(const CPDF_Point& point,
+                                             FX_DWORD nFlag) {
+  SetFocus();
+
+  SetCapture();
+  m_bMouseDown = TRUE;
+
+  int32_t nItemIndex = FindItemIndex(point);
+  SetSelect(nItemIndex);
+  ScrollToItem(nItemIndex);
+
+  return TRUE;
+}
