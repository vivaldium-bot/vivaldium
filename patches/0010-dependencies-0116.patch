+FX_BOOL event::changeEx(IJS_Context* cc,
+                        CJS_PropValue& vp,
+                        CFX_WideString& sError) {
+  if (!vp.IsGetting())
+    return FALSE;
+
+  CJS_Context* pContext = (CJS_Context*)cc;
+  CJS_EventHandler* pEvent = pContext->GetEventHandler();
+
+  vp << pEvent->ChangeEx();
+  return TRUE;
+}
