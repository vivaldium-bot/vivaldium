+class CFX_SkiaDeviceDriver : public IFX_RenderDeviceDriver {
+ public:
+  CFX_SkiaDeviceDriver(CFX_DIBitmap* pBitmap,
+                       int dither_bits,
+                       FX_BOOL bRgbByteOrder,
+                       CFX_DIBitmap* pOriDevice,
