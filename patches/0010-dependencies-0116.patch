+FX_BOOL CPWL_FontMap::KnowWord(int32_t nFontIndex, FX_WORD word) {
+  if (nFontIndex >= 0 && nFontIndex < m_aData.GetSize()) {
+    if (m_aData.GetAt(nFontIndex)) {
+      return CharCodeFromUnicode(nFontIndex, word) >= 0;
+    }
+  }
+
+  return FALSE;
