--- /dev/null
+++ b/third_party/libsrtp/srtp/tables/aes_tables.c
@@ -0,0 +1,350 @@
+/*
+ * aes_tables.c
+ * 
+ * generate tables for the AES cipher
+ * 
+ * David A. McGrew
