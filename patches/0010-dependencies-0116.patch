index 0000000000000000000000000000000000000000..4314efa76d402e12ed3ed293521b126da2d894fc
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/ir_clone.cpp
@@ -0,0 +1,446 @@
+/*
