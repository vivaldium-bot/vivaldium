+                     CFX_Int32Array& classes,
+                     FX_BOOL bWS = FALSE);
+#define FX_BIDIMAXLEVEL 61
+#define FX_BidiGreaterEven(a) (FX_IsOdd(a) ? ((a) + 1) : ((a) + 2))
+#define FX_BidiGreaterOdd(a) (FX_IsOdd(a) ? ((a) + 2) : ((a) + 1))
+int32_t FX_BidiResolveExplicit(int32_t iBaseLevel,
