index 0000000000000000000000000000000000000000..f62ce570e3512822ee281072b874b23540b044f4
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/hash/hmac_ossl.c
@@ -0,0 +1,302 @@
+/*
+ * hmac_ossl.c
+ *
+ * Implementation of hmac auth_type_t that leverages OpenSSL
+ *
+ * John A. Foley
+ * Cisco Systems, Inc.
+ */
+/*
+ *
+ * Copyright(c) 2013, Cisco Systems, Inc.
+ * All rights reserved.
