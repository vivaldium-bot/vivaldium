+CPWL_Color CPWL_Wnd::GetBorderLeftTopColor(int32_t nBorderStyle) const {
+  CPWL_Color color;
+
+  switch (nBorderStyle) {
+    case PBS_SOLID:
+      break;
+    case PBS_DASH:
+      break;
+    case PBS_BEVELED:
+      color = CPWL_Color(COLORTYPE_GRAY, 1);
+      break;
+    case PBS_INSET:
+      color = CPWL_Color(COLORTYPE_GRAY, 0.5f);
+      break;
+    case PBS_UNDERLINED:
+      break;
+  }
+
+  return color;
+}
+
+CPWL_Color CPWL_Wnd::GetBorderRightBottomColor(int32_t nBorderStyle) const {
+  CPWL_Color color;
+
+  switch (nBorderStyle) {
+    case PBS_SOLID:
+      break;
+    case PBS_DASH:
+      break;
+    case PBS_BEVELED:
+      color = CPWL_Utils::DevideColor(GetBackgroundColor(), 2);
+      break;
+    case PBS_INSET:
+      color = CPWL_Color(COLORTYPE_GRAY, 0.75f);
+      break;
+    case PBS_UNDERLINED:
+      break;
+  }
+
+  return color;
+}
