+  FX_DWORD* GetPalette() const { return m_pPalette; }
+
+  FX_DWORD* GetColorLut() const { return m_cLut; }
+  FX_DWORD* GetAmountLut() const { return m_aLut; }
+  int32_t Getlut() const { return m_lut; }
+
