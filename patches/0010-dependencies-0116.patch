+void CPDF_Stream::InitStream(uint8_t* pData,
+                             FX_DWORD size,
+                             CPDF_Dictionary* pDict) {
+  InitStreamInternal(pDict);
+  m_GenNum = kMemoryBasedGenNum;
+  m_pDataBuf = FX_Alloc(uint8_t, size);
+  if (pData) {
+    FXSYS_memcpy(m_pDataBuf, pData, size);
+  }
+  m_dwSize = size;
