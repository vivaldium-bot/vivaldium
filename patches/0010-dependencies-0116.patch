+
+  if (m_Alpha == 255 && cover_scan == 255) {
+    FXSYS_memset(dest_scan, m_Color, (col_end - col_start) << 2);
+    return;
+  }
+  if (cover_scan == 255) {
+    int dst_color = (0x00ffffff & m_Color) | (m_Alpha << 24);
