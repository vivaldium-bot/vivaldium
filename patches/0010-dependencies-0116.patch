+                               int32_t iNest = 0);
+#define FX_BidiDirection(a) (FX_IsOdd(a) ? FX_BIDICLASS_R : FX_BIDICLASS_L)
+enum FX_BIDIWEAKSTATE {
+  FX_BIDIWEAKSTATE_xa = 0,
+  FX_BIDIWEAKSTATE_xr,
+  FX_BIDIWEAKSTATE_xl,
