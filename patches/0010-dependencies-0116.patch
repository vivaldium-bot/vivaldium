+  if (GetType() == CPDF_FormField::RadioButton ||
+      GetType() == CPDF_FormField::CheckBox) {
+    if (ToArray(FPDF_GetFieldAttr(m_pField->m_pDict, "Opt"))) {
+      int iIndex = m_pField->GetControlIndex(this);
+      csOn.Format("%d", iIndex);
+    }
