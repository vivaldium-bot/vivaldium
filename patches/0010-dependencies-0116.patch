+CPDF_Rect CFFL_FormFiller::FFLtoPWL(const CPDF_Rect& rect) {
+  CFX_Matrix mt;
+  mt.SetReverse(GetCurMatrix());
+
+  CPDF_Rect temp = rect;
+  mt.TransformRect(temp);
+
+  return temp;
+}
+
+CPDF_Rect CFFL_FormFiller::PWLtoFFL(const CPDF_Rect& rect) {
+  CFX_Matrix mt = GetCurMatrix();
+
+  CPDF_Rect temp = rect;
+  mt.TransformRect(temp);
+
+  return temp;
+}
