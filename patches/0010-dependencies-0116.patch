+FX_BOOL CPDFSDK_InterForm::ExportFormToFDFTextBuf(CFX_ByteTextBuf& textBuf) {
+  CFDF_Document* pFDF = m_pInterForm->ExportToFDF(m_pDocument->GetPath());
+  if (!pFDF)
+    return FALSE;
+
+  FX_BOOL bRet = pFDF->WriteBuf(textBuf);
+  delete pFDF;
+
+  return bRet;
+}
