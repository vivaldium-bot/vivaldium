+FX_WORD CPDF_CIDFont::CIDFromCharCode(FX_DWORD charcode) const {
+  if (!m_pCMap) {
+    return (FX_WORD)charcode;
+  }
+  return m_pCMap->CIDFromCharCode(charcode);
+}
