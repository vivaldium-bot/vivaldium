+  if (is_clang) {
+    cflags = [ "-Wno-implicit-function-declaration" ]
+  }
+
+  if (use_srtp_boringssl) {
+    deps = [
+      "//third_party/boringssl:boringssl",
+    ]
+    public_deps = [
+      "//third_party/boringssl:boringssl",
