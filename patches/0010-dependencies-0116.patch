+void CPWL_Wnd::EnableWindow(FX_BOOL bEnable) {
+  if (m_bEnabled != bEnable) {
+    for (int32_t i = 0, sz = m_aChildren.GetSize(); i < sz; i++) {
+      if (CPWL_Wnd* pChild = m_aChildren.GetAt(i)) {
+        pChild->EnableWindow(bEnable);
+      }
+    }
+
+    m_bEnabled = bEnable;
+
+    if (bEnable)
+      OnEnabled();
+    else
+      OnDisabled();
+  }
+}
