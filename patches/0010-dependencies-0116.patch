+
+{
+}
+
+TestData::~TestData() {
+  if(fInfo != NULL) {
+    delete fInfo;
+  }
+  if(fCurrSettings != NULL) {
+    delete fCurrSettings;
+  }
+  if(fCurrCase != NULL) {
+    delete fCurrCase;
