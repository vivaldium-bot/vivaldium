+CPDF_Point CFFL_FormFiller::FFLtoPWL(const CPDF_Point& point) {
+  CFX_Matrix mt;
+  mt.SetReverse(GetCurMatrix());
+
+  CPDF_Point pt = point;
+  mt.Transform(pt.x, pt.y);
+
+  return pt;
+}
