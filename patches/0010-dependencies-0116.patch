+U_CDECL_BEGIN
+
+static UBool U_CALLCONV
+enumRangeHandler(const void *context, UChar32 start, UChar32 end, uint32_t value) {
+    return ((Normalizer2DBEnumerator *)context)->rangeHandler(start, end, value);
+}
