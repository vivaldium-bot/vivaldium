+          CPWL_Point(crBBox.left + fWidth / 10, crBBox.bottom + fHeight / 10),
+          PWLPT_LINETO)};
+
+  if (type == PWLPT_STREAM)
+    sPathData = GetAppStreamFromArray(PathArray, 4);
+  else
+    GetPathDataFromArray(path, PathArray, 4);
+}
