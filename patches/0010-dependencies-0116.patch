+FX_BOOL CPDFXFA_App::Initialize() {
+#ifdef PDF_ENABLE_XFA
+  BC_Library_Init();
+  FXJSE_Initialize();
+
+  m_hJSERuntime = FXJSE_Runtime_Create();
+  if (!m_hJSERuntime)
+    return FALSE;
+
+  m_pXFAApp = IXFA_App::Create(this);
+  if (!m_pXFAApp)
+    return FALSE;
+
+  m_pFontMgr = IXFA_FontMgr::CreateDefault();
+  if (!m_pFontMgr)
+    return FALSE;
+
+  m_pXFAApp->SetDefaultFontMgr(m_pFontMgr);
+#endif
+  return TRUE;
+}
