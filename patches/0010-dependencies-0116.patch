+      CPVT_Word word;
+      CPVT_Line line;
+      if (pIterator->GetWord(word)) {
+        m_ptCaret.x = word.ptWord.x + word.fWidth;
+        m_ptCaret.y = word.ptWord.y;
+      } else if (pIterator->GetLine(line)) {
+        m_ptCaret.x = line.ptLine.x;
+        m_ptCaret.y = line.ptLine.y;
+      }
+    }
+  }
