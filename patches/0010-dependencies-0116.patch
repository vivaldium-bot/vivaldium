+DLLEXPORT void STDCALL FORM_DoDocumentJSAction(FPDF_FORMHANDLE hHandle) {
+  CPDFSDK_Document* pSDKDoc = FormHandleToSDKDoc(hHandle);
+  if (pSDKDoc && ((CPDFDoc_Environment*)hHandle)->IsJSInitiated())
+    pSDKDoc->ProcJavascriptFun();
+}
