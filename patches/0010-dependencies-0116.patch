+CFX_ArchiveLoader& CFX_ArchiveLoader::operator>>(uint8_t& i) {
+  if (m_LoadingPos >= m_LoadingSize) {
+    return *this;
+  }
+  i = m_pLoadingBuf[m_LoadingPos++];
+  return *this;
