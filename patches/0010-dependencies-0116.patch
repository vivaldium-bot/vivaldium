+      m_pContext(pContext),
+      m_pDevice(pDevice),
+      m_pOptions(pOptions),
+      m_LayerIndex(0),
+      m_ObjectIndex(0),
+      m_ObjectPos(nullptr),
+      m_PrevLastPos(nullptr) {
+}
