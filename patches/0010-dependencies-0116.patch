diff --git a/third_party/icu/source/samples/uresb/readme.txt b/third_party/icu/source/samples/uresb/readme.txt
new file mode 100644
index 0000000000000000000000000000000000000000..e75eae7875acc2926f3bedd197422316d5760f66
--- /dev/null
