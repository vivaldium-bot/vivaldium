+FX_BOOL CPDFXFA_App::AddFormFillEnv(CPDFDoc_Environment* pEnv) {
+  if (!pEnv)
+    return FALSE;
+
+  m_pEnvList.Add(pEnv);
+  return TRUE;
+}
+
+FX_BOOL CPDFXFA_App::RemoveFormFillEnv(CPDFDoc_Environment* pEnv) {
+  if (!pEnv)
+    return FALSE;
+
+  int nFind = m_pEnvList.Find(pEnv);
+  if (nFind != -1) {
+    m_pEnvList.RemoveAt(nFind);
+    return TRUE;
+  }
+
+  return FALSE;
+}
