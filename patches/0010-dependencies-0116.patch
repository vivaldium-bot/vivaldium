+void CPDFXFA_Document::InvalidateRect(IXFA_PageView* pPageView,
+                                      const CFX_RectF& rt,
+                                      FX_DWORD dwFlags /* = 0 */) {
+  if (!m_pXFADoc || !m_pSDKDoc)
+    return;
+
+  if (m_iDocType != DOCTYPE_DYNAMIC_XFA)
+    return;
+
+  CPDF_Rect rcPage;
+  FXRect2PDFRect(rt, rcPage);
