+    {0x779ce19d, 0xc8d2e345}, {0x7cc9510b, 0x59b9f8f1},
+    {0x83746053, 0xbbeeec72}, {0xaaa60c03, 0xbbeeec72},
+    {0xbf85ff26, 0xe1633081}, {0xc04fe601, 0xbbeeec72},
+    {0xca3812d5, 0x59b9f8f1}, {0xca383e15, 0x59b9f8f1},
