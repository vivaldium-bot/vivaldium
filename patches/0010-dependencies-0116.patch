+_X_EXPORT const char *
+glXGetClientString(Display * dpy, int name)
+{
+   (void) dpy;
+
+   switch (name) {
+   case GLX_VENDOR:
+      return (__glXGLXClientVendorName);
+   case GLX_VERSION:
+      return (__glXGLXClientVersion);
+   case GLX_EXTENSIONS:
+      return (__glXGetClientExtensions());
