+/* Used for GL_ARB_transpose_matrix */
+static void
+TransposeMatrixf(GLfloat m[16])
+{
+   int i, j;
+   for (i = 0; i < 4; i++) {
+      for (j = 0; j < i; j++) {
+         GLfloat tmp = m[i * 4 + j];
+         m[i * 4 + j] = m[j * 4 + i];
+         m[j * 4 + i] = tmp;
+      }
+   }
+}
