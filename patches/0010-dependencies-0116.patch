+    if (CPWL_Wnd* pChild = m_aChildren.GetAt(nIndex)) {
+      ASSERT(pChild->GetClassName() == "CPWL_NoteItem");
+      CPWL_NoteItem* pItem = (CPWL_NoteItem*)pChild;
