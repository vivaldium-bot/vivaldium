+static FX_FLOAT RGB_Conversion(FX_FLOAT colorComponent) {
+  if (colorComponent > 1) {
+    colorComponent = 1;
+  }
+  if (colorComponent < 0) {
+    colorComponent = 0;
+  }
+  int scale = (int)(colorComponent * 1023);
+  if (scale < 0) {
+    scale = 0;
+  }
+  if (scale < 192) {
+    colorComponent = (g_sRGBSamples1[scale] / 255.0f);
+  } else {
+    colorComponent = (g_sRGBSamples2[scale / 4 - 48] / 255.0f);
+  }
+  return colorComponent;
+}
