-        });
-
-        var handler = function(e) {
-            resolve(e);
-            e.notification.close();
-            self.removeEventListener('notificationclick', handler);
-        };
-
-        self.addEventListener('notificationclick', handler);
-    });
-
-    return promise;
-}
