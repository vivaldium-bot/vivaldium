+};
+
+/* image draw modes */
+static const struct shader_asm_info shaders_image_asm[] = {
+   {VEGA_IMAGE_NORMAL_SHADER, image_normal,
+    VG_TRUE,  0, 0, 3, 1, 0, 2},
+   {VEGA_IMAGE_MULTIPLY_SHADER, image_multiply,
