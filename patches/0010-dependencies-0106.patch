--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/egl/fbdev/native_fbdev.c
@@ -0,0 +1,553 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.9
+ *
