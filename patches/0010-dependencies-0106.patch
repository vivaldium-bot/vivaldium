--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/texstore.c
@@ -0,0 +1,4527 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.5
+ *
+ * Copyright (C) 1999-2008  Brian Paul   All Rights Reserved.
+ * Copyright (c) 2008-2009  VMware, Inc.
