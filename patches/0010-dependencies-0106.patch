index 0000000000000000000000000000000000000000..3a11cd47aaed38c4ed395da4807be980882b0542
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/include/state_tracker/st_api.h
@@ -0,0 +1,509 @@
+/**********************************************************
