index 0000000000000000000000000000000000000000..1fa64c378298c534ec58d5e693f6b8240f4a506d
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_drawpix.c
@@ -0,0 +1,710 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
