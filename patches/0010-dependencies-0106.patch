+++ b/third_party/mesa/src/src/mesa/main/shaderobj.c
@@ -0,0 +1,432 @@
+/*
+ * Mesa 3-D graphics library
+ *
+ * Copyright (C) 2004-2008  Brian Paul   All Rights Reserved.
+ * Copyright (C) 2009-2010  VMware, Inc.  All Rights Reserved.
