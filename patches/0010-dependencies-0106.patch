index 0000000000000000000000000000000000000000..c06a4ab7e38bfa5af50f86678eee6a36c506a219
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/texgetimage.c
@@ -0,0 +1,981 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.7
+ *
+ * Copyright (C) 1999-2008  Brian Paul   All Rights Reserved.
+ * Copyright (c) 2009 VMware, Inc.
+ *
