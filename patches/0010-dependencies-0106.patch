index 0000000000000000000000000000000000000000..df05e83c2d48fc87624bf7f21c24e50c9d168fa2
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_atom_texture.c
@@ -0,0 +1,430 @@
+/**************************************************************************
+ *
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
