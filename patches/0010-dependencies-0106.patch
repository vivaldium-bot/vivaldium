diff --git a/third_party/mesa/src/src/gallium/state_trackers/vega/text.c b/third_party/mesa/src/src/gallium/state_trackers/vega/text.c
new file mode 100644
index 0000000000000000000000000000000000000000..27d461ce6601d32382499d724b01fef0426d9e0e
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/vega/text.c
@@ -0,0 +1,249 @@
+/**************************************************************************
+ *
