index 0000000000000000000000000000000000000000..cb319213249160fd0a99f57c3913ac101d525071
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/tnl/t_vb_render.c
@@ -0,0 +1,348 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5
+ *
+ * Copyright (C) 1999-2005  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
