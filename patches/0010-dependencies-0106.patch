+   case GL_LUMINANCE_ALPHA16UI_EXT:
+   case GL_RGBA8UI_EXT:
+   case GL_RGB8UI_EXT:
+   case GL_RG8UI:
+   case GL_R8UI:
+   case GL_ALPHA8UI_EXT:
