@@ -0,0 +1,13 @@
+#!/bin/bash
+for i in "$@"; do
+	n=$(basename "$i" .txt|sed -e 's/s$//')
+	if test "$n" == "shortfile"; then continue; fi
+	echo "enum sm4_$n"
+	echo "{"
+	while read j; do
+		echo $'\t'"SM4_${n}_$j",
+	done < "$i" |tr '[a-z]' '[A-Z]'|tr ' ' '_'
+	echo $'\t'"SM4_${n}_COUNT"|tr '[a-z]' '[A-Z]'
+	echo "};"
+	echo
+done
diff --git a/third_party/mesa/src/src/gallium/state_trackers/d3d1x/d3d1xshader/gen-text.sh b/third_party/mesa/src/src/gallium/state_trackers/d3d1x/d3d1xshader/gen-text.sh
new file mode 100755
index 0000000000000000000000000000000000000000..4663f635d432b2346afd3c947a13c2578d3bee6e
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/d3d1x/d3d1xshader/gen-text.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+for i in "$@"; do
+	n=$(basename "$i" .txt|sed -e 's/s$//')
+	echo "const char* sm4_${n}_names[] ="
+	echo "{"
+	while read j; do
+		echo $'\t'"\"$j\"",
+	done < "$i"
+	echo "};"
