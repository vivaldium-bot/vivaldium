+            pattern="(\d{2})(\d{5})(\d{4})"
+            carrierCodeFormattingRule="$NP $CC ($FG)">
+          <leadingDigits>
+            (?:
+              1[1-9]|
+              2[12478]|
+              9[1-9]
+            )9
+          </leadingDigits>
+          <format>$1 $2-$3</format>
+        </numberFormat>
+        <numberFormat nationalPrefixFormattingRule="($FG)"
+            pattern="(\d{2})(\d{4})(\d{4})"
+            carrierCodeFormattingRule="$NP $CC ($FG)">
+          <leadingDigits>[1-9][1-9]</leadingDigits>
+          <format>$1 $2-$3</format>
+        </numberFormat>
+        <numberFormat pattern="([34]00\d)(\d{4})">
