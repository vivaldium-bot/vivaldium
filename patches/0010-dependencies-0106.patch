+	UTIL_CHECK_CAP(OCCLUSION_QUERY),
+	UTIL_CHECK_CAP(TWO_SIDED_STENCIL),
+	UTIL_CHECK_CAP(TEXTURE_MIRROR_CLAMP),
+	UTIL_CHECK_CAP(BLEND_EQUATION_SEPARATE),
