new file mode 100644
index 0000000000000000000000000000000000000000..b42616226722b401754f3b1031b8275c64ae7e34
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/renderbuffer.c
@@ -0,0 +1,178 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5
