index 0000000000000000000000000000000000000000..90130e3dbbbd674bf34eec64ee90985a5cd5dcaa
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/hint.c
@@ -0,0 +1,166 @@
+
+/*
+ * Mesa 3-D graphics library
+ * Version:  4.1
+ *
+ * Copyright (C) 1999-2002  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
