+#include <string>
+
+#include <unicode/unistr.h>
+
+namespace i18n {
+namespace phonenumbers {
+
+class StringByteSink : public icu::ByteSink {
+ public:
+  // Constructs a ByteSink that will append bytes to the dest string.
+  explicit StringByteSink(std::string* dest);
