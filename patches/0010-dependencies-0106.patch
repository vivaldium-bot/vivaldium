index 0000000000000000000000000000000000000000..ea59de1602007515d1c46da98df88967e3308b6e
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_fog.c
@@ -0,0 +1,244 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5.2
+ *
+ * Copyright (C) 1999-2006  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
