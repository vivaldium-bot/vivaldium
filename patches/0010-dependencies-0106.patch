+struct radeon_hw_info {
+    /* apply to r6, eg */
+    uint32_t                        group_bytes;
+    uint32_t                        num_banks;
+    uint32_t                        num_pipes;
+    /* apply to eg */
+    uint32_t                        row_size;
+    unsigned                        allow_2d;
