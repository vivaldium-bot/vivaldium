index 0000000000000000000000000000000000000000..84ac4ffbc06f44b422228acc9a021410d937220d
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_cb_bitmap.c
@@ -0,0 +1,887 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
