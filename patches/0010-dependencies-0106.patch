new file mode 100755
index 0000000000000000000000000000000000000000..0cf76a0af6e6aad712c4a3e840ff0c98f8e6519d
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/d3d1x/tools/fxc
@@ -0,0 +1,16 @@
+#!/bin/bash
+dir="$(dirname "$0")/../mstools"
+(cd "$dir"; ./download-mstools)
+
+arch="$(uname -m)"
+if test "$arch" == i386 || test "$arch" == i486 || test "$arch" == i586 || test "$arch" == i686 || test "$arch" == x86_64; then
+	emu="wine"
+else
+	emu="qemu-i386 wine"
+fi
+exe="$dir/fxc.exe"
+if test "$#" == 0 || test "$1" == "--help"; then
+	exec $emu "$exe" "/?"
+else
+	exec $emu "$exe" "$@"
+fi
