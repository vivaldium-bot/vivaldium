+   enum pipe_format   format;
+   struct pipe_surface *surface;
+   struct pipe_resource *texture;
+   VGint width, height;
+};
+
+struct st_framebuffer {
+   VGint width, height;
+   struct st_renderbuffer *strb;
+   struct st_renderbuffer *dsrb;
