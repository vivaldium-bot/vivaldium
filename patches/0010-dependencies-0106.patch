+  result.reserve(s1.Length() + s2.Length() + s3.Length() + s4.Length() + 1);
+
+  result += s1;
+  result += s2;
+  result += s3;
+  result += s4;
+
+  return result;
+}
+
+string StrCat(const StringHolder& s1, const StringHolder& s2,
+              const StringHolder& s3, const StringHolder& s4,
