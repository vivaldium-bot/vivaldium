diff --git a/third_party/mesa/src/src/gallium/state_trackers/Makefile b/third_party/mesa/src/src/gallium/state_trackers/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..d5162c17507e25a8af17adf38c25439eaacb2bf4
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/Makefile
@@ -0,0 +1,29 @@
+TOP = ../../..
+include $(TOP)/configs/current
+
+
+SUBDIRS = $(GALLIUM_STATE_TRACKERS_DIRS)
+
+
+default: subdirs
+
+
+subdirs:
+	@for dir in $(SUBDIRS) ; do \
+		if [ -d $$dir ] ; then \
+			(cd $$dir && $(MAKE)) || exit 1 ; \
+		fi \
+	done
+
+
+clean:
+	rm -f `find . -regex '.*\.l?[oa]'`
+	rm -f `find . -name depend`
+
+
+install:
+	@for dir in $(SUBDIRS) ; do \
+		if [ -d $$dir ] ; then \
+			(cd $$dir && $(MAKE) $@) || exit 1 ; \
+		fi \
+	done
