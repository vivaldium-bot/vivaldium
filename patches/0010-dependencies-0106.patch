+    "RECIPIENT"
+  };
+  COMPILE_ASSERT(COUNTRY == 0, bad_base);
+  COMPILE_ASSERT(RECIPIENT == arraysize(kFieldNames) - 1, bad_length);
+
+  if (field < 0 || static_cast<size_t>(field) >= arraysize(kFieldNames)) {
+    o << "[INVALID ENUM VALUE " << static_cast<int>(field) << "]";
+  } else {
+    o << kFieldNames[field];
+  }
+  return o;
+}
