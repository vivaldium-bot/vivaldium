index 0000000000000000000000000000000000000000..02a48ba60a65a08ceab460abefb1b6f30bde5d89
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/shader_query.cpp
@@ -0,0 +1,402 @@
+/*
