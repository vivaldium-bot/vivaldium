+#define SET_SHADER_EXTRA_ARGS , \
+	ID3D11ClassInstance *const *ppClassInstances, \
+	unsigned count
+#define GET_SHADER_EXTRA_ARGS , \
+		ID3D11ClassInstance **ppClassInstances, \
+		unsigned *out_count
+#else
+#define SET_SHADER_EXTRA_ARGS
+#define GET_SHADER_EXTRA_ARGS
+#endif
