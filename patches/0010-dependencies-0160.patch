+++ b/third_party/webgl/src/sdk/tests/deqp/framework/opengl/simplereference/sglrGLContext.js
@@ -0,0 +1,184 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
+ *
