+  case 'TEXTURE_WRAP_S':
+  case 'TEXTURE_WRAP_T':
+  case 'TEXTURE_MAG_FILTER':
+  case 'TEXTURE_MIN_FILTER':
+  case 'TEXTURE_COMPARE_FUNC':
+  case 'TEXTURE_COMPARE_MODE':
