+        }
+
+        return texture;
+    }
+
+    function runTest()
+    {
+        var ctx = wtu.create3DContext();
+        var canvas = ctx.canvas;
+
+        var cases = [
+            { sub: false, flipY: true, init: setCanvasToMin },
+            { sub: false, flipY: false },
+            { sub: true,  flipY: true },
