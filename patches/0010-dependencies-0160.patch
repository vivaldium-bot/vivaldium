+    t = (t & mask1) + ((t >> 2) & mask1);
+    t = (t & mask2) + ((t >> 4) & mask2);
+    t = (t & mask3) + ((t >> 8) & mask3);
+    t = (t & mask4) + (t >> 16);
+    return t;
+};
