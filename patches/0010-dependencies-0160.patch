+</head>
+<body onload="generateTOC(document.getElementById('toc'))">
+    <!--begin-logo-->
+    <div class=head>
+        <p>
+            <a href="http://khronos.org/">
+                <img alt=Khronos height=60 src="../../../resources/KhronosGroup-3D.png" width=220>
+            </a>
+        </p>
+    </div>
