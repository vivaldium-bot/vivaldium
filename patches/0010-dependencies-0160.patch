+  error = testCase.expectedError;
+  wtu.glErrorShouldBe(gl, error, msg);
+}
+
+function testCopyFromInternalFBO(testCase) {
+  var target = gl.TEXTURE_2D;
+  var level = 0;
+  var x = 0;
+  var y = 0;
+  var width = 16;
+  var height = 16;
+  var xoffset = 0;
+  var yoffset = 0;
