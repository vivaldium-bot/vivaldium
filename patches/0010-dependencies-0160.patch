index 0000000000000000000000000000000000000000..36f0031103055af65154ace853e50e284ad38037
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/extra/canvas-compositing-test.html
@@ -0,0 +1,109 @@
+<!--
+
+/*
