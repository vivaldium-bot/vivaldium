+     elementSizeInBytes: 1,
+     testValues:     [ 0, 255,  -1, 256 ],
+     expectedValues: [ 0, 255,   0, 255 ]
+    },
+    {name: "Uint16Array",
+     unsigned: true,
+     integral: true,
