+			void main()
+			{
+				gl_FragColor = vec4(1.0);
+			}
+		""
+	end
+
+	case uniform_in_fragment_main
+		expect compile_fail
+		vertex ""
+			void main()
+			{
+				gl_Position = vec4(1.0);
+			}
+		""
+		fragment ""
+			void main()
