+			}
+
+			void main()
+			{
+				out0 = func(in0);
+				${OUTPUT}
+			}
+		""
+	end
+
+	case float_mat2
+		values
+		{
+			input mat2 in0		= mat2(0.5, -1.0, 0.2, -1.0);
+			output float out0	= 0.5;
+		}
+
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
