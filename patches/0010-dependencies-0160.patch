+bool GrRectBlurEffect::onIsEqual(const GrFragmentProcessor& sBase) const {
+    const GrRectBlurEffect& s = sBase.cast<GrRectBlurEffect>();
+    return this->getSigma() == s.getSigma() && this->getRect() == s.getRect();
+}
