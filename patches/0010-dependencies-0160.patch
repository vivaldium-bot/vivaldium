+                                                                const SkImageInfo&,
+                                                                int sampleCount,
+                                                                GrSurfaceOrigin,
+                                                                const SkSurfaceProps*);
+
+    friend class GrAtlasTextContext;
+    friend class SkSurface_Gpu;      // for access to surfaceProps
+    typedef SkClipStackDevice INHERITED;
+};
+
+#endif
