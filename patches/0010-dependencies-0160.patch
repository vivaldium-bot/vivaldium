+                           gluShaderUtil.DataType.INT_VEC4,
+                           gluShaderUtil.DataType.UINT,
+                           gluShaderUtil.DataType.UINT_VEC2,
+                           gluShaderUtil.DataType.UINT_VEC3,
+                           gluShaderUtil.DataType.UINT_VEC4
