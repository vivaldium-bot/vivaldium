+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<!-- Prevents Chrome from offering to translate tests which generate
+     random characters for things like attribute names -->
+<meta name="google" value="notranslate">
+<title>WebGL Conformance Tests</title>
+<style>
+  body {
+    border: 0;
