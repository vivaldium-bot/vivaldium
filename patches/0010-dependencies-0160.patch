+                    glsShaderLibraryCase.setUniformValue(gl, pipelineProgramIDs, valueName1, val1, arrayNdx);
+                    assertMsgOptions(gl.getError() === gl.NO_ERROR, 'set uniforms', false, true);
+                }
+            }
