+            // Clear.
+            gl.clearColor(0.125, 0.25, 0.5, 1);
+            gl.clear(gl.COLOR_BUFFER_BIT);
+            assertMsgOptions(gl.getError() === gl.NO_ERROR, 'clear buffer', false, true);
