+            rrVertexAttrib.read(dst, vertexAttrib.type, vertexAttrib.size, new Uint8Array(vertexAttrib.pointer).subarray(byteOffset));
+        } else {
+            dst = new Uint32Array(/** @type {Array<number>} */ (vertexAttrib.generic));
+        }
+
+        return dst;
+    };
