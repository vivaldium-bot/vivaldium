+        GET_PROC_SUFFIX(NamedBufferData, EXT);
+        GET_PROC_SUFFIX(NamedBufferSubData, EXT);
+        GET_PROC_SUFFIX(ProgramUniform1f, EXT);
+        GET_PROC_SUFFIX(ProgramUniform2f, EXT);
+        GET_PROC_SUFFIX(ProgramUniform3f, EXT);
