+# Generic invalid cases that don't fall into other categories
+
+group c_cast "C-style casts"
+
+	case float_0
+		expect compile_fail
+		version 300 es
+		both ""
+			#version 300 es
+			precision highp float;
+			${DECLARATIONS}
+			void main ()
+			{
+				float a = 0.0;
+				float b = (float)a;
+				${POSITION_FRAG_COLOR} = vec4(0.0);
+			}
+		""
