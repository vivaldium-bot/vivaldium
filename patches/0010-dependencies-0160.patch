+        } else if (gluShaderUtil.isDataTypeIntOrIVec(a.type)) {
+            for (var i = 0; i < size; i++)
+                if (a.val[i] != b.val[i])
+                    return false;
+        } else if (gluShaderUtil.isDataTypeUintOrUVec(a.type)) {
+            for (var i = 0; i < size; i++)
