+    es3fFragmentOutputTests.createRandomCase = function(minRenderTargets, maxRenderTargets, seed) {
+
+        /** @type {Array<gluShaderUtil.DataType>} */
+        var outputTypes = [
+                           gluShaderUtil.DataType.FLOAT,
+                           gluShaderUtil.DataType.FLOAT_VEC2,
