+    gl.copyTexSubImage2D(target, level, xoffset, yoffset, x, y, width, height);
+  } else {
+    wtu.glErrorShouldBe(gl, gl.NO_ERROR);
+    gl.copyTexImage2D(target, level, testCase.internalFormat, x, y, width, height, border);
