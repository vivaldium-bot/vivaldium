+				gl_FragColor = vec4(1.0);
+			}
+		""
+	end
+
+	case varying_in_vertex_main
+		expect compile_fail
+		vertex ""
+			void main()
+			{
+				varying mediump float val;
+				gl_Position = vec4(1.0);
+			}
+		""
+		fragment ""
+			varying mediump float val;
