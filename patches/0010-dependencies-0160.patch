+ * @throws {Error}
+ */
+gluTextureUtil.getInternalFormat = function(texFormat) {
+
+    var stringify = function(order, type) {
+        return '' + order + ' ' + type;
+    };
+
+    switch (stringify(texFormat.order, texFormat.type)) {
