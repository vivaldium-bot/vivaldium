+function generateTest(pixelFormat, pixelType, pathToTestRoot, prologue) {
+    var wtu = WebGLTestUtils;
+    var gl = null;
+    var successfullyParsed = false;
+    var imgCanvas;
+    var red = [255, 0, 0];
+    var green = [0, 255, 0];
+
+    var init = function()
