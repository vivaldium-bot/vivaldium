+                          gluShaderUtil.precision.PRECISION_LOWP,
+                          gluShaderUtil.precision.PRECISION_MEDIUMP,
+                          gluShaderUtil.precision.PRECISION_HIGHP
+                          ];
+
+        /** @type {Array<WebGLRenderingContextBase.GLenum>} */
+        var floatFormats = [
+                            gl.RGBA32F,
+                            gl.RGBA16F,
+                            gl.R11F_G11F_B10F,
+                            gl.RG32F,
+                            gl.RG16F,
