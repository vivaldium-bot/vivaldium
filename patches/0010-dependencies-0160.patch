+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			# define VALUE(a)
+
+			void main()
+			{
+				out0 = VALUE(2.0) - 1.0;
+				${OUTPUT}
+			}
+		""
+	end
+
+
+	case empty_directive
+		values { output float out0 = 1.0; }
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			#
+
+			void main()
+			{
