+		values { output bool out0 = true; }
+		both ""
+			#version 300 es
+			precision highp int;
+			${DECLARATIONS}
+
+			void main()
+			{
+				const bool a = (false == false) && (true != false) && (1 < 2) && (3 <= 3) && ((1 > 1) != (1 >= 1));
+				out0 = a;
+				${OUTPUT}
+			}
+		""
+	end
+
+	case selection
