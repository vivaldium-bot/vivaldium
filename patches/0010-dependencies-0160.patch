+            case gl.RGBA16UI:
+            case gl.RGBA8:
+            case gl.RGBA8I:
+            case gl.RGBA8UI:
+            case gl.SRGB8_ALPHA8:
+            case gl.RGB10_A2:
+            case gl.RGB10_A2UI:
+            case gl.RGBA4:
+            case gl.RGB5_A1:
+            case gl.RGB8:
+            case gl.RGB565:
+            case gl.RG32I:
+            case gl.RG32UI:
+            case gl.RG16I:
+            case gl.RG16UI:
+            case gl.RG8:
+            case gl.RG8I:
+            case gl.RG8UI:
+            case gl.R32I:
+            case gl.R32UI:
+            case gl.R16I:
+            case gl.R16UI:
+            case gl.R8:
+            case gl.R8I:
+            case gl.R8UI:
