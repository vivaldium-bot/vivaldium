+				out0 = a;
+				${OUTPUT}
+			}
+		""
+	end
+
+	case logical
+		version 300 es
+		values { output bool out0 = true; }
+		both ""
+			#version 300 es
+			precision highp int;
+			${DECLARATIONS}
+
+			void main()
