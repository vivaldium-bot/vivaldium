index 0000000000000000000000000000000000000000..2a37af1e7b2d1719f1849bf92a2963de8e070354
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/js/tests/gl-get-tex-parameter.js
@@ -0,0 +1,200 @@
+/*
+** Copyright (c) 2015 The Khronos Group Inc.
+**
