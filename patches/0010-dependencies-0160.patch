+        return ret;
+    };
+
+    /**
+    * @param {glsFboUtil.ImageFormat} format
+    * @param {number} fallback
+    * @return {number}
+    */
+    glsFboUtil.FormatDB.prototype.getFormatInfo = function(format, fallback) {
+        return this.m_map.lookupDefault(format, fallback);
+    };
