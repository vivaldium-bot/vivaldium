+
+			void main()
+			{
+				mediump int 1xyz = 1;
+			}
+		""
+	end
+
+	case null_directive
+		values { output float out0 = 0.0; }
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			#
+		# // comment
+	/*sfd*/		# /* */
+
+			void main()
+			{
