+        var random = deRandom.deRandom_getInt(rnd, [0, index - 1]);
+        index -= 1;
+        var elem = elements[index];
+        elements[index] = elements[random];
+        elements[random] = elem;
+    }
+    return elements;
+};
+
+/**
