+        /** @type {Array<number>} */ var p10 = src.read(i1, j0, NumChannels);
+        /** @type {Array<number>} */ var p01 = src.read(i0, j1, NumChannels);
+        /** @type {Array<number>} */ var p11 = src.read(i1, j1, NumChannels);
+        /** @type {number} */ var dst = 0;
+
