+
+			void main()
+			{
+				const int a = 25%7 + 2*3 - 9/3;
+				out0 = a;
+				${OUTPUT}
+			}
+		""
+	end
+
+	case math_ivec
+		version 300 es
+		values { output int out0 = 21; }
+		both ""
+			#version 300 es
+			precision highp int;
+			${DECLARATIONS}
+
+			void main()
+			{
+				const ivec3 a = ivec2(25%7, 4).xxy + ivec4(1*3, 9/3, 1+2, 8/4).xyz;
+				out0 = a.x + a.y + a.z;
+				${OUTPUT}
+			}
+		""
+	end
+
+	case math_mat
