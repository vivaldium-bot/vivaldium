index 0000000000000000000000000000000000000000..93624b7bc9c77d940e2ad51f609ee17eb0bc8c21
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/extra/buffer-gc-stress.html
@@ -0,0 +1,176 @@
+<!--
+
+/*
