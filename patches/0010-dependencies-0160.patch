+        GrGLenum                fGLTarget;
+        GrGpuResource::UniqueID fBoundBufferUniqueID;
+        bool                    fBufferZeroKnownBound;
+
+        void invalidate() {
+            fBoundBufferUniqueID.makeInvalid();
+            fBufferZeroKnownBound = false;
+        }
+    }                                       fHWBufferState[kGrBufferTypeCount];
+
