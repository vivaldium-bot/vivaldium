+                    gluShaderUtil.isDataTypeSampler(elemBasicType) ? es3fUniformApiTests.generateRandomVarValue(elemBasicType, rnd, samplerUnitCounter++) :
+                                                        es3fUniformApiTests.generateRandomVarValue(elemBasicType, rnd);
