+end # operators
+
+group complex_types "Arrays & Structs"
+
+	case struct
+		version 300 es
+		values { output float out0 = 260.922; }
+		both ""
+			#version 300 es
+			precision highp float;
+			${DECLARATIONS}
+
+			struct S
+			{
+				vec4 a;
+				int  b;
+			};
+
+			void main()
+			{
+				const S s = S(vec4(1.5), 123);
