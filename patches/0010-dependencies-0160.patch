+    return src * 255 / 15;
+};
+
+var extend5To8 = function(src) {
+    return src * 255 / 31;
+};
+
+var extend6To8 = function(src) {
+    return src * 255 / 63;
+};
+
+var extend7To8 = function(src) {
+    return src * 255 / 127;
+};
