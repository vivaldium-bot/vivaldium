+        TriState        fEnabled;
+
+        void invalidate() {
+            fEquation = static_cast<GrBlendEquation>(-1);
+            fSrcCoeff = static_cast<GrBlendCoeff>(-1);
+            fDstCoeff = static_cast<GrBlendCoeff>(-1);
+            fConstColorValid = false;
+            fEnabled = kUnknown_TriState;
