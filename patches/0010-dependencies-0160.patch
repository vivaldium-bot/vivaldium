--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/extra/webgl-drawelements-validation.html
@@ -0,0 +1,163 @@
+<!--
+
+/*
+** Copyright (c) 2014 The Khronos Group Inc.
+**
