+TEST(XfaUtilsImp, XFA_MapRotation) {
+  struct TestCase {
+    int input;
+    int expected_output;
+  } TestCases[] = {{-1000000, 80}, {-361, 359}, {-360, 0},  {-359, 1},
+                   {-91, 269},     {-90, 270},  {-89, 271}, {-1, 359},
+                   {0, 0},         {1, 1},      {89, 89},   {90, 90},
