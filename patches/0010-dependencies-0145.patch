+        int accum = 0;
+
+        if (fUsePortable) {
+            for (int j = 0; j < loops; ++j) {
+                for (int i = 0; i < ARRAY; ++i) {
+                    accum += SkCLZ_portable(fData[i]);
+                }
+                this->process(accum);
+            }
+        } else {
+            for (int j = 0; j < loops; ++j) {
+                for (int i = 0; i < ARRAY; ++i) {
+                    accum += SkCLZ(fData[i]);
+                }
+                this->process(accum);
+            }
+        }
+    }
+
+    const char* onGetName() override {
+        return fName;
+    }
+
+private:
