+          'GCC_CW_ASM_SYNTAX':                         'NO',   # remove -fasm-blocks
+          'GCC_ENABLE_PASCAL_STRINGS':                 'NO',   # remove -mpascal-strings
+          'WARNING_CFLAGS': [
+            '-Wall',
+            '-Wextra',
+            '-Winit-self',
+            '-Wpointer-arith',
+            '-Wsign-compare',
+            '-Wvla',
+
+            '-Wno-unused-parameter',
+          ],
+        },
+      },
+    ],
+
+    [ 'skia_os == "ios"',
+      {
