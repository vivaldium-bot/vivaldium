+
+class FailImageFilter : public SkImageFilter {
+public:
+    class Registrar {
+    public:
+        Registrar() {
+            SkFlattenable::Register("FailImageFilter",
+                                    FailImageFilter::CreateProc,
+                                    FailImageFilter::GetFlattenableType());
+        }
+    };
