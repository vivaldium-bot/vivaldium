+  CXFA_FFImage::UnloadWidget();
+}
+FX_BOOL CXFA_FFImage::IsLoaded() {
+  return !!GetDataAcc()->GetImageImage();
+}
+FX_BOOL CXFA_FFImage::LoadWidget() {
+  if (GetDataAcc()->GetImageImage()) {
+    return TRUE;
+  }
+  GetDataAcc()->LoadImageImage();
+  return CXFA_FFDraw::LoadWidget();
+}
