+    SkISize ia;
+    ia.set(ix, iy);
+    a.set(x, y);
+    REPORTER_ASSERT(reporter, a.toRound() == ia);
+}
diff --git a/third_party/skia/tests/Sk4x4fTest.cpp b/third_party/skia/tests/Sk4x4fTest.cpp
