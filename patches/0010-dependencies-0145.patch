+      int32_t fA, fB;
+      fA = FXSYS_wtoi(wsWideNarrowRatio.Left(ptPos).c_str());
+      fB = FXSYS_wtoi(wsWideNarrowRatio.Mid(ptPos + 1).c_str());
+      if (fB)
+        fRatio = (FX_FLOAT)fA / fB;
+    }
+    val = fRatio;
+    return TRUE;
+  }
+  return FALSE;
