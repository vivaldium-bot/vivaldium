+        path->moveTo(SkIntToScalar(gCoord[0]), SkIntToScalar(gCoord[1]));
+        path->lineTo(SkIntToScalar(gCoord[2]), SkIntToScalar(gCoord[3]));
+        path->lineTo(SkIntToScalar(gCoord[4]), SkIntToScalar(gCoord[5]));
