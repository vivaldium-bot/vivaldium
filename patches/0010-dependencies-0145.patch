+
+    typedef Benchmark INHERITED;
+};
+
+///////////////////////////////////////////////////////////////////////////////
+
+class NormalizeBench : public Benchmark {
+    enum {
+        ARRAY =1000,
+    };
+    SkVector fVec[ARRAY];
+
+public:
+    NormalizeBench() {
+        SkRandom rand;
+        for (int i = 0; i < ARRAY; ++i) {
