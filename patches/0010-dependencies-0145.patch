+	// so will y since it is raised to an odd power, and the shader spec
+	// does not support pow(-x, y) where y is not a compile time constant
+	z = abs((x - 1.0) / (x + 1.0));
+	float p = z;
+	for(int i = 1; i <= 101; i += 2)
+	{
+		y += p / float(i);
+		p *= z * z;
+	}
+	y *= -2.0 / ln2;
+
+	gl_FragColor = vec4(y / -8.0, 0.0, 0.0, 1.0);
+}
