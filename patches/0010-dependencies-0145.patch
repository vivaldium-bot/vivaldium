+CXFA_Node::~CXFA_Node() {
+  ASSERT(!m_pParent);
+  RemoveMapModuleKey();
+  CXFA_Node* pNode = m_pChild;
+  while (pNode) {
+    CXFA_Node* pNext = pNode->m_pNext;
+    pNode->m_pParent = nullptr;
+    delete pNode;
+    pNode = pNext;
+  }
+  if (m_pXMLNode && IsOwnXMLNode())
+    m_pXMLNode->Release();
