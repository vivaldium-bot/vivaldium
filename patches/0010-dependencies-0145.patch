+
+  std::unique_ptr<CFXJSE_Value> argOne = GetSimpleValue(pThis, args, 0);
+  if (argOne->IsNull()) {
+    args.GetReturnValue()->SetNull();
+    return;
+  }
+
+  int32_t count = std::max(0, ValueToInteger(pThis, argOne.get()));
+  CFX_ByteTextBuf spaceString;
+  int32_t index = 0;
+  while (index < count) {
+    spaceString.AppendByte(' ');
