+      pWidgetAcc->ExecuteScript(CXFA_Script(pScript), &EventParam, &pRetValue);
+  if (iRet == XFA_EVENTERROR_Success && pRetValue) {
+    bRet = pRetValue->ToBoolean();
+    delete pRetValue;
+  }
