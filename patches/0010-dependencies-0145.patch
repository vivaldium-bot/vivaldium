+  *pData++ = ArgbEncode(255, 255, 255, 255),
+  *pData++ = ArgbEncode(255, 255, 240, 207),
+  *pData++ = ArgbEncode(255, 248, 179, 48),
+  *pData++ = ArgbEncode(255, 176, 176, 167),
+  *pData++ = ArgbEncode(255, 241, 239, 239),
+  *pData++ = ArgbEncode(255, 255, 255, 255),
+  *pData++ = ArgbEncode(255, 255, 255, 255),
+  *pData++ = ArgbEncode(255, 220, 220, 215),
+  *pData++ = ArgbEncode(255, 255, 255, 255),
+  *pData++ = ArgbEncode(255, 255, 240, 207),
+  *pData++ = ArgbEncode(255, 248, 179, 48),
+  *pData++ = ArgbEncode(255, 176, 176, 167),
+  *pData++ = ArgbEncode(255, 241, 239, 239),
+  *pData++ = ArgbEncode(255, 255, 255, 255),
