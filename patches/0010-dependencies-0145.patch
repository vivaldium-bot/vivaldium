+	if(x < 3.0-ERROR_EPSILON || x > 3.0+ERROR_EPSILON) cols = false;
+	x = b[1][0] + b[1][1];
+	if(x < 12.0-ERROR_EPSILON || x > 12.0+ERROR_EPSILON) cols = false;
