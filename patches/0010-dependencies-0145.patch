+        '../debugger/QT/SkDebuggerGUI.cpp',
+        '../debugger/QT/SkDebuggerGUI.h',
+        '../debugger/QT/SkDrawCommandGeometryWidget.h',
+        '../debugger/QT/SkDrawCommandGeometryWidget.cpp',
+        '../debugger/QT/SkCanvasWidget.cpp',
