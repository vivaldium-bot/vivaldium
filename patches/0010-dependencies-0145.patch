+	const mat3 a = mat3( 1.0,   2.0,   4.0,   // 1.0  8.0  64.0
+	                     8.0,  16.0,  32.0,   // 2.0 16.0 128.0
+	                    64.0, 128.0, 256.0);  // 4.0 32.0 256.0
+
+	// Check each element.
+	bool elms = true;
+	if(a[0][0] !=   1.0) elms = false;
+	if(a[0][1] !=   2.0) elms = false;
+	if(a[0][2] !=   4.0) elms = false;
