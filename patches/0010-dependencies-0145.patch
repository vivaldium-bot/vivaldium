+}
+
+DEF_TEST(SkNx_abs, r) {
+    auto fs = Sk4f(0.0f, -0.0f, 2.0f, -4.0f).abs();
+    REPORTER_ASSERT(r, fs[0] == 0.0f);
+    REPORTER_ASSERT(r, fs[1] == 0.0f);
