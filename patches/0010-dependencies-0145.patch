+
+// TODO deprecate imageblur
+
+#define WIDTH 500
+#define HEIGHT 500
+
+constexpr float kBlurSigmas[] = {
+        0.0, 0.3f, 0.5f, 2.0f, 32.0f, 80.0f };
+
+const char* kTestStrings[] = {
+        "The quick`~",
+        "brown fox[]",
