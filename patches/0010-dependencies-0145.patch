+FX_BOOL CXFA_FFListBox::OnKillFocus(CXFA_FFWidget* pNewFocus) {
+  if (!ProcessCommittedData())
+    UpdateFWLData();
+  CXFA_FFField::OnKillFocus(pNewFocus);
+  return TRUE;
+}
