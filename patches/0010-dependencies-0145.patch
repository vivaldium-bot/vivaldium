+TEST(string_piece, begin_end) {
+  const char* my_string = "my really long string";
+  string_piece p(my_string);
+  size_t pos = 0;
+  for (auto it = p.begin(); it != p.end(); ++it) {
+    EXPECT_EQ(my_string[pos++], *it);
