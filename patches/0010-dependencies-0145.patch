+      'includes': [
+        # TODO: merge this back in here?
+        'freetype.gypi',
+      ],
+      'conditions': [
+        [ 'skia_os == "android"', {
+          # These flags are used by the Android OS.  They are probably overkill
+          # for Skia, but we add them for consistency.
+          'cflags': [
+            '-W',
+            '-Wall',
+            '-fPIC',
+            '-DPIC',
+            '-DDARWIN_NO_CARBON',
+            '-DFT2_BUILD_LIBRARY',
+            '-O2',
+          ],
+        }],
+        [ 'skia_clang_build == 1', {
+          'cflags':[
+            '-w',
+          ],
+        }],
+      ],
+    },
+  ],
+}
