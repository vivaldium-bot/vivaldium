+CXFA_FFField::CXFA_FFField(CXFA_FFPageView* pPageView, CXFA_WidgetAcc* pDataAcc)
+    : CXFA_FFWidget(pPageView, pDataAcc), m_pNormalWidget(nullptr) {
+  m_rtUI.Set(0, 0, 0, 0);
+  m_rtCaption.Set(0, 0, 0, 0);
+}
