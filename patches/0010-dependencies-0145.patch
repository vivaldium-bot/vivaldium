+                   {100000, 280}};
+
+  for (size_t i = 0; i < FX_ArraySize(TestCases); ++i) {
+    EXPECT_EQ(TestCases[i].expected_output,
+              XFA_MapRotation(TestCases[i].input));
+  }
+}
