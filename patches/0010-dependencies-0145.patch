+  if (!dValueRet) {
+    pContext->ThrowException(XFA_IDS_ARGUMENT_MISMATCH);
+    return;
+  }
+
+  uint8_t uPrecision = 0;
+  if (argc > 1) {
+    std::unique_ptr<CFXJSE_Value> argTwo = args.GetValue(1);
+    if (argTwo->IsNull()) {
+      args.GetReturnValue()->SetNull();
