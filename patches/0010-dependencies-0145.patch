+precision mediump float;
+#endif
+varying vec4 color;
+
+void main (void)
+{
+	float x = (color.r + 0.01) / 1.01;
+	float y = 0.0;
+	float z;   // x-1 / x+1
+	int n = 50;
+
+	// ln(x) = 2[x-1 + 1 (x-1)^3 + 1 (x-1)^5 + ...] for x > 0
+	//          [x+1   3 (x+1)     5 (x+1)        ]
