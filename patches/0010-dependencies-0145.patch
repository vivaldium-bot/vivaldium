+const char* platform_extra_config(const char* config) {
+    for (int index = 0; index < FLAGS_key.count(); index += 2) {
+        if (!strcmp("extra_config", FLAGS_key[index]) && !strcmp(config, FLAGS_key[index + 1])) {
+            return config;
+        }
+    }
+    return "";
+}
