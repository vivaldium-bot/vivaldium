+    case 2:
+      RangeRecordTable array = table.fmt2Table();
+      Map<Integer, GlyphGroup> map = extract(array);
+      Collection<GlyphGroup> groups = map.values();
+      GlyphList result = new GlyphList();
+      for (GlyphGroup glyphIds : groups) {
