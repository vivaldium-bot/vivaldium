+    CFX_WideString wsName = CFX_WideString::FromUTF8(bsName.AsStringC());
+    CFDE_XMLNode* pXMLNode = GetXMLMappingNode();
+    if (pXMLNode && pXMLNode->GetType() == FDE_XMLNODE_Element) {
