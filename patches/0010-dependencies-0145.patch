+function Animate(path, now, dur) {
+    if (path.start == null) {
+        path.start = now;
+//        console.log("start=" + now);
+    }
+    if (now - path.start < dur) {
+        requestAnimationFrame(path.animate);
+        return true;
+    }
+    return false;
+}
