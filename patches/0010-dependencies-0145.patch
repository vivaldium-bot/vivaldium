+  CXML_Element* pNumberSymbols =
+      m_pLocaleData->GetElement(bsSpace.AsStringC(), "dateTimeSymbols");
+  if (!pNumberSymbols) {
+    return;
+  }
+  wsDtSymbol = pNumberSymbols->GetContent(0);
+}
