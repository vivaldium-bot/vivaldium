+#include "../Request.h"
+#include "../Response.h"
+
+using namespace Response;
+
+bool RootHandler::canHandle(const char* method, const char* url) {
+    return 0 == strcmp(method, MHD_HTTP_METHOD_GET) &&
+           0 == strcmp(url, "/");
