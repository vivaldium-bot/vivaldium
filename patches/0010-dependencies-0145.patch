+	float phi = color.b * 2.0 * M_PI;
+	v1.x = cos(theta) * sin(phi);
+	v1.y = sin(theta) * sin(phi);
+	v1.z = cos(phi);
+
+	vec3 result;
+	float eta = 0.5;
+	float k = 1.0 - eta * eta * (1.0 - dot(v1, v2) * dot(v1, v2));
