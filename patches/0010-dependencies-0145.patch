+FWL_Error CXFA_FWLAdapterWidgetMgr::RepaintWidget(IFWL_Widget* pWidget,
+                                                  const CFX_RectF* pRect) {
+  if (!pWidget)
+    return FWL_Error::Indefinite;
+
+  CXFA_FFWidget* pFFWidget =
+      static_cast<CXFA_FFWidget*>(pWidget->GetLayoutItem());
+  if (!pFFWidget)
