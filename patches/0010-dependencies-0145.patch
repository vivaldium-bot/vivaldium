+    RuleSegment[] others = new RuleSegment[] {other.input, other.subst, other.backtrack, other.lookAhead};
+    for (int i = 0; i < these.length; i++) {
+      RuleSegment thisSeg = these[i];
+      RuleSegment otherSeg = others[i];
+      if (thisSeg != null) {
