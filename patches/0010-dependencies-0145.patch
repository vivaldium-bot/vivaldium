+
+/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
+
+class Via : public Sink {
+public:
+    explicit Via(Sink* sink) : fSink(sink) {}
+    const char* fileExtension() const override { return fSink->fileExtension(); }
