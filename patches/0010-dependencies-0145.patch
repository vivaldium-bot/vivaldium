+        return FX_LOCALECATEGORY_Num;
+      case XFA_VT_TEXT:
+        return FX_LOCALECATEGORY_Text;
+      case XFA_VT_DATE:
+        return FX_LOCALECATEGORY_Date;
+      case XFA_VT_TIME:
+        return FX_LOCALECATEGORY_Time;
+      case XFA_VT_DATETIME:
