+            },
+            'defines': [ 'NDEBUG' ],
+          },
+        },
+        'xcode_settings': {
+          'ARCHS': ['armv7'],
+          'CODE_SIGNING_REQUIRED': 'NO',
+          'IPHONEOS_DEPLOYMENT_TARGET': '<(ios_sdk_version)',
