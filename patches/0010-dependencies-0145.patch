+    for (int i = 0; i < table.subTableCount(); i++) {
+      List<Rule> subRules = extract(table.subTableAt(i));
+      subRules = Rule.prependToInput(prefixChars.get(i), subRules);
+      allRules.addAll(subRules);
+    }
+    return allRules;
+  }
