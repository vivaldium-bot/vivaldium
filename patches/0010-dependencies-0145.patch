+
+///////////////////////////////////////////////////////////////////////////////
+
+class FixedMathBench : public Benchmark {
+    enum {
+        N = 1000,
+    };
+    float fData[N];
+    SkFixed fResult[N];
+public:
+
+    FixedMathBench()  {
