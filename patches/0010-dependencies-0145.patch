+++ b/third_party/shaderc/src/libshaderc/src/shaderc_cpp_test.cc
@@ -0,0 +1,942 @@
+// Copyright 2015 The Shaderc Authors. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
