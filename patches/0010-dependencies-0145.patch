+        'configurations': {
+          'Debug': {
+            'msvs_settings': {
+              'VCCLCompilerTool': {
+                'DebugInformationFormat': '4', # editAndContiue (/ZI)
+                'Optimization': '0',           # optimizeDisabled (/Od)
