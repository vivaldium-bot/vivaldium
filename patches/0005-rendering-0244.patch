+    var b = 102;  // ... to make the debugger ...
+    var c = 103;  // ... inspect them during break.
+    if (i > 0) {
+      debugme();
+      i = 23;
+    } else {
+      thrower();
+      i = 42;
+    }
+    return i|0;
+  }
+  return { foo: foo };
+}
+
+var m = Module(stdlib, foreign, buffer);
