diff --git a/buildtools/third_party/libc++/trunk/test/std/utilities/variant/variant.variant/variant.assign/T.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/utilities/variant/variant.variant/variant.assign/T.pass.cpp
