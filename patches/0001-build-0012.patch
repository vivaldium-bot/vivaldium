+        assert(p1.second == 4);
+    }
+    {
+        typedef std::pair<std::unique_ptr<int>, short> P1;
+        P1 p1 = std::make_pair(nullptr, static_cast<short>(4));
+        assert(p1.first == nullptr);
+        assert(p1.second == 4);
+    }
+#endif
+#if TEST_STD_VER >= 14
+    {
