+
+#include <utility>
+#include <memory>
+#include <cassert>
+
+#include "test_macros.h"
+
+int main()
+{
+    {
+        typedef std::pair<int, short> P1;
+        P1 p1 = std::make_pair(3, static_cast<short>(4));
+        assert(p1.first == 3);
+        assert(p1.second == 4);
