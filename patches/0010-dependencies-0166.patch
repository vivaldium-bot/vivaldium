+  else if (OSName.startswith("linux"))
+    return Linux;
+  else if (OSName.startswith("lv2"))
+    return Lv2;
+  else if (OSName.startswith("macosx"))
+    return MacOSX;
+  else if (OSName.startswith("mingw32"))
+    return MinGW32;
+  else if (OSName.startswith("netbsd"))
+    return NetBSD;
+  else if (OSName.startswith("openbsd"))
