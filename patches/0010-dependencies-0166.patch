diff --git a/third_party/wayland/src/tests/list-test.c b/third_party/wayland/src/tests/list-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..21ca4ecbd324ee39c04ce8a193fb887b59e20495
--- /dev/null
+++ b/third_party/wayland/src/tests/list-test.c
@@ -0,0 +1,166 @@
+/*
+ * Copyright © 2012 Intel Corporation
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining
+ * a copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including
+ * without limitation the rights to use, copy, modify, merge, publish,
