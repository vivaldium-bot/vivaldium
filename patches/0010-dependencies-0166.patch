+  // instead of putting complex code in your constructor/destructor.
+  virtual void Initialize();
+  virtual void Shutdown();
+
+  RTC_DISALLOW_COPY_AND_ASSIGN(TestSuite);
+
+ private:
+  rtc::scoped_ptr<TraceToStderr> trace_to_stderr_;
+};
+
