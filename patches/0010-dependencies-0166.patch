+        network_("network", "unittest",
+                 rtc::IPAddress(INADDR_LOOPBACK), 8),
+        port_(), running_(false),
+        port_config_count_(0) {
+    network_.AddIP(rtc::IPAddress(INADDR_LOOPBACK));
