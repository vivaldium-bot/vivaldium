+  ReportResult("ramp-up-rtx-packets-sent",
+               rtx_media_packets_sent_,
+               "packets");
+  ReportResult("ramp-up-time",
+               ramp_up_finished_ms_ - test_start_ms_,
+               "milliseconds");
+  test_done_->Set();
+}
