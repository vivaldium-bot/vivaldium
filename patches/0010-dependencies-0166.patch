+}
+
+bool PlatformSoundSystemFactory::SetupInstance() {
+  if (!instance_.get()) {
+    instance_.reset(CreatePlatformSoundSystem());
+  }
+  if (!instance_->Init()) {
+    LOG(LS_ERROR) << "Can't initialize platform's sound system";
+    return false;
+  }
+  return true;
+}
