+      argType$j]]>::Call( \
+          CAST_FUNCTION_( \
+              &function, \
+              SmartFunctionWrapper$i< \
+                  ruleSet::SmartWrapper, \
+                  ruleSet::SmartUnwrapper, \
+                  toType$for j [[, \
