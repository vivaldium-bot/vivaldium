+
+  // The expected video codecs are the common video codecs from the first
+  // offer/answer exchange plus the video codecs only |f2_| offer, sorted in
+  // preference order.
+  const VideoCodec kUpdatedVideoCodecOffer[] = {
+    kVideoCodecsAnswer[0],
+    kVideoCodecs2[1],
+  };
