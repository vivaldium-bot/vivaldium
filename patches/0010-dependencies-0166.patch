+ChannelManager::ChannelManager(MediaEngineInterface* me,
+                               DataEngineInterface* dme,
+                               CaptureManager* cm,
+                               rtc::Thread* worker_thread) {
+  Construct(me, dme, cm, worker_thread);
+}
