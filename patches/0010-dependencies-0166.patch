+
+  virtual void StartGettingPorts() {
+    if (!port_) {
+      port_.reset(TestUDPPort::Create(worker_thread_, factory_, &network_,
+                                      network_.GetBestIP(), 0, 0, username(),
+                                      password(), std::string(), false));
+      AddPort(port_.get());
+    }
+    ++port_config_count_;
+    running_ = true;
