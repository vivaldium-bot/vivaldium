+    DataLog::InsertCell(DataLog::Combine("table", 3), "arrival",
+                        static_cast<int32_t>(i));
+    DataLog::InsertCell(DataLog::Combine("table", 4), "size",
+                        static_cast<int32_t>(1200 + 10 * i));
