+/// SPUTargetMachine
+///
+class SPUTargetMachine : public LLVMTargetMachine {
+  SPUSubtarget        Subtarget;
+  const TargetData    DataLayout;
+  SPUInstrInfo        InstrInfo;
+  SPUFrameLowering    FrameLowering;
+  SPUTargetLowering   TLInfo;
+  SPUSelectionDAGInfo TSInfo;
