+    if (result) {
+      channel1_->Enable(true);
+      result = channel2_->SetRemoteContent(&remote_media_content1_,
+                                           CA_OFFER, NULL);
+      if (result) {
+        transport_controller1_.Connect(&transport_controller2_);
+
+        result = channel2_->SetLocalContent(&local_media_content2_,
+                                            CA_ANSWER, NULL);
+      }
+    }
+    return result;
+  }
