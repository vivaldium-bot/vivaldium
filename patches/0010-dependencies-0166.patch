+bool UdpSocketWrapper::StartReceiving(const uint32_t /*receiveBuffers*/) {
+  return StartReceiving();
+}
+
+bool UdpSocketWrapper::StopReceiving()
+{
+    _wantsIncoming = false;
+    return true;
+}
