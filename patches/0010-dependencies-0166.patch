diff --git a/third_party/wds/src/mirac_network/network-test.cpp b/third_party/wds/src/mirac_network/network-test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..02ecf15aba3fe224d5726527ca67a3f427b8f1a3
--- /dev/null
+++ b/third_party/wds/src/mirac_network/network-test.cpp
@@ -0,0 +1,179 @@
+/*
+ * This file is part of Wireless Display Software for Linux OS
+ *
+ * Copyright (C) 2014 Intel Corporation.
+ *
+ * Contact: Jussi Laako <jussi.laako@linux.intel.com>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
