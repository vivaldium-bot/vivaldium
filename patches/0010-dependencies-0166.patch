+  EXPECT_EQ(20U, mi_attr2->length());
+  EXPECT_EQ(
+      0, memcmp(mi_attr2->bytes(), kCalculatedHmac2, sizeof(kCalculatedHmac2)));
+
+  rtc::ByteBuffer buf3;
