+int32_t UdpTransportImpl::SetSendIP(const char* ipaddr)
+{
+    if(!IsIpAddressValid(ipaddr,IpV6Enabled()))
+    {
+        return kIpAddressInvalid;
+    }
+    CriticalSectionScoped cs(_crit);
+    strncpy(_destIP, ipaddr,kIpAddressVersion6Length);
+    BuildRemoteRTPAddr();
+    BuildRemoteRTCPAddr();
+    return 0;
+}
