index 0000000000000000000000000000000000000000..3266bb7945bbba8caa070e64bff6bc4e4764f1ce
--- /dev/null
+++ b/third_party/webrtc/test/testsupport/perf_test.cc
@@ -0,0 +1,177 @@
+/*
