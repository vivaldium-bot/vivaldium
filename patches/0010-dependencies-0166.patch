+          .move_by_offset(100 - 2540, 1525 - 75) \
+          .click() \
+          .perform()
+        expectedEvents += " Third"
+        wait.until(expectedEventsFired)
+
+        # Move to element with id 'r4' at (220,180) to (320, 230).
+        ActionChains(self.driver) \
+          .move_by_offset(270 - 100, 205 - 1525) \
