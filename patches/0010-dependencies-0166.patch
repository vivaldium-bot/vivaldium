+                 "Channel::RegisterExternalMediaProcessing()");
+
+    CriticalSectionScoped cs(&_callbackCritSect);
+
+    if (kPlaybackPerChannel == type)
+    {
+        if (_outputExternalMediaCallbackPtr)
