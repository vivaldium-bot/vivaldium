diff --git a/third_party/wds/src/p2p/information-element.cpp b/third_party/wds/src/p2p/information-element.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ea91274735b6ceb988a35ecd08a37fd44bff4fe8
--- /dev/null
+++ b/third_party/wds/src/p2p/information-element.cpp
@@ -0,0 +1,171 @@
+/*
