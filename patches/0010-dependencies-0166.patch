diff --git a/third_party/wayland/src/cursor/convert_font.c b/third_party/wayland/src/cursor/convert_font.c
new file mode 100644
index 0000000000000000000000000000000000000000..45b6ac6b0d9dc880d2ec8d66c7bbd4af00dcc348
--- /dev/null
+++ b/third_party/wayland/src/cursor/convert_font.c
@@ -0,0 +1,542 @@
+/*
