+UdpTransportImpl::~UdpTransportImpl()
+{
+    CloseSendSockets();
+    CloseReceiveSockets();
+    delete _crit;
+    delete _critFilter;
+    delete _critPacketCallback;
+    delete _cachLock;
+    delete _socket_creator;
+
+    WEBRTC_TRACE(kTraceMemory, kTraceTransport, _id, "%s deleted",
+                 __FUNCTION__);
+}
