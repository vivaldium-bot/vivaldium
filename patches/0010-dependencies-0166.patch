+#include "Windows.h"
+#include <psapi.h>
+#include <malloc.h>
+#include <io.h>
+#include <direct.h>
+
+#ifdef __MINGW32__
+ #if (HAVE_LIBPSAPI != 1)
+  #error "libpsapi.a should be present"
+ #endif
+#else
+ #pragma comment(lib, "psapi.lib")
