+void Loopback() {
+  test::Loopback::Config config{flags::Width(),
+                                flags::Height(),
+                                flags::Fps(),
+                                flags::MinBitrate(),
+                                flags::StartBitrate(),
+                                flags::MaxBitrate(),
+                                flags::MinTransmitBitrate(),
+                                flags::Codec(),
