diff --git a/third_party/webrtc/typedefs.h b/third_party/webrtc/typedefs.h
new file mode 100644
index 0000000000000000000000000000000000000000..3034c7e74ae9fcc005a08884722d12b434405e42
--- /dev/null
+++ b/third_party/webrtc/typedefs.h
@@ -0,0 +1,122 @@
+/*
