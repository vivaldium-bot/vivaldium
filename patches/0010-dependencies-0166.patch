+int32_t UdpTransportImpl::SetSendPorts(uint16_t rtpPort, uint16_t rtcpPort)
+{
+    CriticalSectionScoped cs(_crit);
+    _destPort = rtpPort;
+    if(rtcpPort == 0)
+    {
+        _destPortRTCP = _destPort+1;
+    } else
+    {
+        _destPortRTCP = rtcpPort;
+    }
+    BuildRemoteRTPAddr();
+    BuildRemoteRTCPAddr();
+    return 0;
+}
