+
+	b = any(lessThan(v, uv4));
+	b = (b && any(lessThanEqual(v, uv4)));
+    b = (b && any(greaterThan(v, uv4)));
+    b = (b && any(greaterThanEqual(v, uv4)));
+    b = (b && any(equal(ub41, ub42)));
+    b = (b && any(notEqual(ub41, ub42)));
+    b = (b && any(ub41));
+    b = (b && all(ub41));
+    b = (b && any(not(ub41)));
+	
+	i = ((i + ui) * i - ui) / i;
+	i = i % ui;
+	if (i == ui || i != ui && i == ui ^^ i != 2)
+	    ++i;
+	
+	f = ((uf + uf) * uf - uf) / uf;
