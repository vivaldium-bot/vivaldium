+CFU_FILES=$(BUILDDIR)/$(CFU_FILES_SHORT)
+
+## UCM files
+-include $(UCMSRCDIR)/ucmcore.mk
+-include $(UCMSRCDIR)/ucmfiles.mk
+-include $(UCMSRCDIR)/ucmebcdic.mk
+-include $(UCMSRCDIR)/ucmlocal.mk
+# Chromium: Drop 2 ibm encodings not necessary.
