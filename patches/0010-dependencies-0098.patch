+PhoneNumberUtil::ErrorType PhoneNumberUtil::Parse(const string& number_to_parse,
+                                                  const string& default_region,
+                                                  PhoneNumber* number) const {
+  DCHECK(number);
+  return ParseHelper(number_to_parse, default_region, false, true, number);
+}
