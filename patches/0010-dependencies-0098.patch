new file mode 100644
index 0000000000000000000000000000000000000000..3cec027fe34595e5b75e1f2850d206b62a94ef87
--- /dev/null
+++ b/third_party/icu/source/common/utrie.h
@@ -0,0 +1,795 @@
+/*
