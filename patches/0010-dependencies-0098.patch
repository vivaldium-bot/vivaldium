+
+    v += mix(v,v,bv4);
+    v += intBitsToFloat(ivec4(i));
+    v += uintBitsToFloat(uv4);
+    v += fma(v,v,v);
+    v += frexp(v);
+    v += ldexp(v);
+    v += unpackUnorm2x16(v);
+    v += unpackUnorm4x8(v);
+    v += unpackSnorm4x8(v);
