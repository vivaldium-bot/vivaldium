+          </sequential>
+          <sequential>
+          	<ant target='dayPeriods'/>
+          </sequential>
+        </parallel>
+     </target>
+
+    <target name="locales" depends="init,setup" description="builds locale files in ICU text format">
+        <cldr-build toolName="org.unicode.cldr.icu.NewLdml2IcuConverter" srcFile=".*xml" destFile=".*txt">
