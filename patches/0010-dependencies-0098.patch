+            <ant target='locales' />
+          </sequential>
+          <sequential>
+            <ant target='collation'>
+            </ant>
+          </sequential>
+          <sequential>
+            <ant target='rbnf'>
+            </ant>
+          </sequential>
+          <ant target='supplementalData'>
+          </ant>
+          <sequential>
+            <ant target='brkitr'>
+            </ant>
+          </sequential>
+          <sequential>
+            <ant target='translit'>
+            </ant>
+            <!--<ant target='trnsfiles'></ant> Not ANT-built - see
