+            <run>
+                <args>
+                    <arg name="--sourcedir"       value="${env.CLDR_DIR}/common/main" />
+                    <arg name="--destdir"         value="${env.ICU4C_DIR}/source/data/locales"/>
+                    <arg name="--specialsdir"     value="${env.ICU4C_DIR}/source/data/xml/main"/>
