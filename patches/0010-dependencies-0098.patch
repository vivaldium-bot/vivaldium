+
+    v += ceil(v);
+    v += fract(v);
+    v += mod(v, v);
+	v += mod(v, v.x);
+
+
+    v += modf(v, v);
+
+
+    v += min(v, uv4);
+    v += max(v, uv4);
+    v += clamp(v, uv4, uv4);
+    v += mix(v,v,v);
