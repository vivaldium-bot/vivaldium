diff --git a/third_party/glslang/src/Test/recurse1.frag b/third_party/glslang/src/Test/recurse1.frag
new file mode 100644
index 0000000000000000000000000000000000000000..66b4c3fea09d71a2fa6cfa1ce0d1bbd80b2df10e
--- /dev/null
+++ b/third_party/glslang/src/Test/recurse1.frag
@@ -0,0 +1,48 @@
+#version 330 core
+
+// cross-unit recursion
+
+void main() {}
+
+// two-level recursion
+
+float cbar(int);
+
+void cfoo(float)
+{
+	cbar(2);
+}
+
+// four-level, out of order
+
+void CB();
+void CD();
+void CA() { CB(); }
+void CC() { CD(); }
+
+// high degree
+
+void CBT();
+void CDT();
+void CAT() { CBT(); CBT(); CBT(); }
+void CCT() { CDT(); CDT(); CBT(); }
+
+// not recursive
+
+void norA() {}
+void norB() { norA(); }
+void norC() { norA(); }
+void norD() { norA(); }
+void norE() { norB(); }
+void norF() { norB(); }
+void norG() { norE(); }
+void norH() { norE(); }
+void norI() { norE(); }
+
+// not recursive, but with a call leading into a cycle if ignoring direction
+
+void norcA() { }
+void norcB() { norcA(); }
+void norcC() { norcB(); }
+void norcD() { norcC(); norcB(); } // head of cycle
+void norcE() { norcD(); } // lead into cycle
diff --git a/third_party/glslang/src/Test/recurse1.vert b/third_party/glslang/src/Test/recurse1.vert
new file mode 100644
index 0000000000000000000000000000000000000000..e2dbce00e6a87ef0ddce6cc436d31cc68ee779bb
--- /dev/null
+++ b/third_party/glslang/src/Test/recurse1.vert
@@ -0,0 +1,44 @@
+#version 330 core
+
+void main() {}
+
+float bar(int);
+
+// direct recursion
+
+void self()
+{
+    self();
+}
+
+// two-level recursion
+
