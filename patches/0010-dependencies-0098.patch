+              [389][1-9]
+            )|
+            3(?:
+              [0-8]|
+              9[1-9]
+            )
+          </leadingDigits>
+          <format>$1 $2 $3</format>
+        </numberFormat>
+        <numberFormat pattern="([1-3]\d)(\d{2})(\d{2})(\d{3})">
