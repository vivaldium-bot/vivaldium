+    v += step(v,v);
+    v += smoothstep(v,v,v);
+    v += step(uf,v);
+    v += smoothstep(uf,uf,v);
+    v += normalize(v);
+    v += faceforward(v, v, v);
+    v += reflect(v, v);
+    v += refract(v, v, uf);
+    v += dFdx(v);
+    v += dFdy(v);
+    v += fwidth(v);
+	//noise*(v);
+
+
+	// signed integer
+	i += abs(ui);
+	i += sign(i);
+	i += min(i, ui);
+	i += max(i, ui);
+	i += clamp(i, ui, ui);
+
+	floatsBitsToInt(v);
+	packUnorm2x16(v);
+	packUnorm4x8(v);
+	packSnorm4x8(v);
+
+	// unsigned integer
+    u = abs(uui);
+    u += sign(u);
+    u += min(u, uui);
+    u += max(u, uui);
+    u += clamp(u, uui, uui);
+    u += floatsBitToInt(v);
+    u += packUnorm2x16(v);
+    u += packUnorm4x8(v);
+    i += uui & i;          // ERRORs, no int/uint conversions before 400
+    i += uui ^ i;
+    i += i | uui;
+
+	// bool
