+		<remapper>
+		  <remap sourcePath="/CurrencyMap" targetDir="curr" />
+		  <remap sourcePath="/CurrencyMeta" targetDir="curr" />
+		</remapper>
+            </run>
+        </cldr-build>
+    </target>
+    <target name="metadata" depends="init,setup" description="builds metadata.txt from supplementalMetadata.xml">
