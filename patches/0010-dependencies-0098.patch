+          <format>$1 $2 $3</format>
+        </numberFormat>
+        <!-- Commonly used mobile formatting pattern. -->
+        <numberFormat pattern="(9\d)(\d{3})(\d{4})">
+          <leadingDigits>9</leadingDigits>
+          <format>$1 $2 $3</format>
+        </numberFormat>
+        <numberFormat pattern="(\d{2})(\d{3})(\d{2})(\d{2})">
+          <leadingDigits>
+            2[12]|
+            9
+          </leadingDigits>
+          <format>$1 $2 $3 $4</format>
