+        <numberFormat pattern="(1599)(\d{6})">
+          <leadingDigits>15</leadingDigits>
+          <format>$1-$2</format>
+        </numberFormat>
+        <!-- These are 4-digit star numbers which are only accessible within Israel and must be
+             dialed with a star in front of the number. -->
