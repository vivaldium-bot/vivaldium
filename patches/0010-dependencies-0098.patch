+   echo "   ${UCONFIG_CPPFLAGS}"
+   echo
+   echo 'The recommended way to do this is to prepend the following lines to source/common/unicode/uconfig.h or #include them near the top of that file.'
+   echo "Creating the file ${HDRFILE}"
+   echo
+   echo '---------------   ' "${HDRFILE}"
