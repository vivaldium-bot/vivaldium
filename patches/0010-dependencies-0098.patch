+          \echo >> "${HDRFILE}"
+          ;;
+        -D*)
+           \echo "${flag}" | sed -n 's%-D\([^=]*\)%#define \1 %p' >> "${HDRFILE}"
+          \echo >> "${HDRFILE}"
+          ;;
+        *)
+          \echo "/*  Not sure how to handle this argument: ${flag} */" >> "${HDRFILE}"
+          \echo >> "${HDRFILE}"
+          ;;
+        esac
