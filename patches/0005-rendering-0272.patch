+  // Set a break point and call to invoke the debug event listener.
+  const breakid = Debug.setBreakPoint(testFunction, 1, 0);
+  testFunction();
+  Debug.clearBreakPoint(breakid);
+  assertNull(exception);
+  assertEquals(3, state);
+}
