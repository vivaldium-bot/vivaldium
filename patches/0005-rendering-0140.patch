-
-// FIXME: Make this smaller. crbug.com/414283.
-var floatPrecision = 0.01;
-
-function testScroll(scrollOffset, expectedScrollOffset) {
-
-    debug('Scrolling DIV with scrollTop/scrollLeft');
-    scroller.scrollTop = scrollOffset;
