+
+  test('addHistogramsValid', function() {
+    let hist0 = new tr.v.Histogram('', unitlessNumber, TEST_BOUNDARIES);
+    let hist1 = new tr.v.Histogram('', unitlessNumber, TEST_BOUNDARIES);
