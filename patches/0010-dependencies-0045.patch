diff --git a/third_party/ffmpeg/libavcodec/aarch64/autorename_libavcodec_aarch64_h264cmc_neon.S b/third_party/ffmpeg/libavcodec/aarch64/autorename_libavcodec_aarch64_h264cmc_neon.S
