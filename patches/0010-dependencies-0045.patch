index 0000000000000000000000000000000000000000..f6643f67ef2a02dd770d5b2b9e8541ca9e7e493b
--- /dev/null
+++ b/third_party/ffmpeg/doc/examples/decoding_encoding.c
@@ -0,0 +1,665 @@
+/*
