diff --git a/third_party/ffmpeg/compat/getopt.c b/third_party/ffmpeg/compat/getopt.c
new file mode 100644
index 0000000000000000000000000000000000000000..41a641f7c8a9b0fd5cc5f2837dde3c0fb54ed260
--- /dev/null
+++ b/third_party/ffmpeg/compat/getopt.c
@@ -0,0 +1,84 @@
