--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/idctdsp_init_arm.c
@@ -0,0 +1,89 @@
+/*
+ * ARM-optimized IDCT functions
+ * Copyright (c) 2001 Lionel Ulmer
+ *
