+
+    assert.equal(hist0.getBinForValue(0).count, 4);
+    assert.deepEqual(
+        hist0.getBinForValue(0).diagnosticMaps.map(dmd => dmd.get('foo').value),
+        ['b0', 'c0', 'b1', 'c1']);
+
+    assert.equal(hist0.getBinForValue(500).count, 1);
+    assert.deepEqual(
+        hist0.getBinForValue(500).diagnosticMaps.map(dmd =>
+          dmd.get('foo').value),
