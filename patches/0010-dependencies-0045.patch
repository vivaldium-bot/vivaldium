+<script>
+'use strict';
+Polymer({
+  is: 'tr-v-ui-merged-buildbot-info-span',
+
+  ready() {
+    this.diagnostic_ = undefined;
+    this.$.table.showHeader = false;
+    this.$.table.tableColumns = [
+      {value: row => row[0]},
+      {value: row => row[1]},
+    ];
