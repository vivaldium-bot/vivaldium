+    GetBitContext pre_gb;          ///< ac/dc prefix
+    GetBitContext gb;
+    GetByteContext g;
+    GetByteContext g2;
+    int mv[256];
+    VLC pre_vlc;
+    int last_dc;
+    DECLARE_ALIGNED(16, int16_t, block)[6][64];
+    void *bitstream_buffer;
+    unsigned int bitstream_buffer_size;
