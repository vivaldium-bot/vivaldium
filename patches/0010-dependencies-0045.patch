+        tr.v.HistogramBinBoundaries.createLinear(0, 1e3, 10));
+    hist0.customizeSummaryOptions({
+      nans: true,
+      percentile: [0.1, 0.9],
+    });
+    new tr.v.d.TelemetryInfo({
+      storyGroupingKeys: {
+        storyGroupingKey0: 'sgk0',
