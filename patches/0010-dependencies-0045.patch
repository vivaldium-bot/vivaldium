diff --git a/third_party/ffmpeg/libavcodec/aacadtsdec.c b/third_party/ffmpeg/libavcodec/aacadtsdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..d0814ac27e149c5236afa0b14f53def63913b2f9
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aacadtsdec.c
@@ -0,0 +1,70 @@
+/*
+ * Audio and Video frame extraction
+ * Copyright (c) 2003 Fabrice Bellard
+ * Copyright (c) 2003 Michael Niedermayer
+ * Copyright (c) 2009 Alex Converse
+ *
