+<link rel="import" href="/tracing/value/histogram_set.html">
+<link rel="import" href="/tracing/value/ui/histogram_set_table_row.html">
+
+<dom-module id="tr-v-ui-histogram-set-table">
+  <template>
+    <style>
+    :host {
+      display: block;
+    }
+
+    #container {
