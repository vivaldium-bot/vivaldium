index 0000000000000000000000000000000000000000..7736d09b5673f76d112f7fcf21d3e3f304a6080b
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/adxenc.c
@@ -0,0 +1,182 @@
+/*
+ * ADX ADPCM codecs
+ * Copyright (c) 2001,2003 BERO
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
