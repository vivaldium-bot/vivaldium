index 0000000000000000000000000000000000000000..4f9aa485fd21aabff582423703197dc0d05173dc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/mlpdsp_armv5te.S
@@ -0,0 +1,662 @@
+/*
