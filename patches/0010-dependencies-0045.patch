+      benchmarkStartMs: 0,
+      storysetRepeatCounter: 0,
+      label: 'label A',
+    }).addToHistogram(hist0);
+    for (let i = 0; i <= 1e3; i += 10) {
+      hist0.addSample(i);
+    }
+    hist0.addSample(NaN);
+
+    let hist1 = new tr.v.Histogram('hist1', tr.b.Unit.byName.sigma);
+    hist0.customizeSummaryOptions({
+      std: false,
+      count: false,
+      sum: false,
+      min: false,
+      max: false,
