diff --git a/third_party/ffmpeg/libavcodec/arm/startcode_armv6.S b/third_party/ffmpeg/libavcodec/arm/startcode_armv6.S
new file mode 100644
index 0000000000000000000000000000000000000000..a46f00937519395ca22dd11dfd6ee92c8186409d
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/startcode_armv6.S
@@ -0,0 +1,253 @@
+/*
+ * Copyright (c) 2013 RISC OS Open Ltd
+ * Author: Ben Avison <bavison@riscosopen.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
