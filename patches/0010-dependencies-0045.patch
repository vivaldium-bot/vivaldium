+    hist.addSample(0, {foo: new tr.v.d.Generic('c')});
+    hist.addSample(500, {foo: new tr.v.d.Generic('c')});
+    hist.addSample(999, {foo: new tr.v.d.Generic('d')});
+    hist.addSample(1000, {foo: new tr.v.d.Generic('d')});
