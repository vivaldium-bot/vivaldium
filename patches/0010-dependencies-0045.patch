diff --git a/third_party/ffmpeg/libavcodec/ac3enc_fixed.c b/third_party/ffmpeg/libavcodec/ac3enc_fixed.c
new file mode 100644
index 0000000000000000000000000000000000000000..9d39026dd5859476a187f093a31055714447236a
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ac3enc_fixed.c
@@ -0,0 +1,160 @@
+/*
+ * The simplest AC-3 encoder
+ * Copyright (c) 2000 Fabrice Bellard
+ * Copyright (c) 2006-2010 Justin Ruggles <justin.ruggles@gmail.com>
+ * Copyright (c) 2006-2010 Prakash Punnoor <prakash@punnoor.de>
+ *
+ * This file is part of FFmpeg.
