+def RegisterDiagnosticTypes(baseclass=Diagnostic):
+  for subclass in baseclass.__subclasses__():  # pylint: disable=no-member
+    Diagnostic.REGISTRY[subclass.__name__] = subclass
+    RegisterDiagnosticTypes(subclass)
