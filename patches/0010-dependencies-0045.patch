diff --git a/third_party/ffmpeg/compat/os2threads.h b/third_party/ffmpeg/compat/os2threads.h
new file mode 100644
index 0000000000000000000000000000000000000000..5b6ca5579df3bc51d546c993bd452efb771a7c9e
--- /dev/null
+++ b/third_party/ffmpeg/compat/os2threads.h
@@ -0,0 +1,166 @@
+/*
