+  test('createScalarSpan', function() {
+    // No config.
+    let span = tr.v.ui.createScalarSpan(
+        new Scalar(Unit.byName.powerInWatts, 3.14));
+    assert.strictEqual(Polymer.dom(span.$.content).textContent, '3.140 W');
