index 0000000000000000000000000000000000000000..733fc8406b03fd9eb27cc24225fd464c60c4f8f4
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aarch64/mpegaudiodsp_neon.S
@@ -0,0 +1,226 @@
+/*
