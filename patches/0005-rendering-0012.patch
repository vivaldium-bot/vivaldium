+    : Event(eventType, false /*canBubble*/, false /*cancelable*/)
+    , m_oldVersion(oldVersion)
+    , m_newVersion(newVersion)
+    , m_dataLoss(dataLoss)
+    , m_dataLossMessage(dataLossMessage)
+{
