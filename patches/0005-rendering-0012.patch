+#ifndef IDBRequest_h
+#define IDBRequest_h
+
+#include "bindings/core/v8/ScriptState.h"
+#include "bindings/core/v8/ScriptValue.h"
+#include "core/dom/ActiveDOMObject.h"
+#include "core/dom/DOMError.h"
