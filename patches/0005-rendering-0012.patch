diff --git a/third_party/WebKit/LayoutTests/css3/flexbox/mozilla/flexbox-items-as-stacking-contexts-2.html b/third_party/WebKit/LayoutTests/css3/flexbox/mozilla/flexbox-items-as-stacking-contexts-2.html
