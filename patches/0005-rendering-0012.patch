+#ifndef FetchRequestData_h
+#define FetchRequestData_h
+
+#include "platform/heap/Handle.h"
+#include "platform/weborigin/KURL.h"
+#include "platform/weborigin/Referrer.h"
+#include "public/platform/WebServiceWorkerRequest.h"
