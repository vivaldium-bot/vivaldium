+    ScriptPromise deriveKey(ScriptState*, const AlgorithmIdentifier&, CryptoKey*, const AlgorithmIdentifier&, bool extractable, const Vector<String>&);
+
+    DEFINE_INLINE_TRACE() { }
+
+private:
+    SubtleCrypto();
+};
