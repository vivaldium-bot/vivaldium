-flexitem.style.flex = 'none';
-flexitem.style.flex = '-2'; // Invalid, return previous value.
-shouldBeEqualToString('flexitem.style.flex', '0 0 auto');
-shouldBeEqualToString('getComputedStyle(flexitem).flex', '0 0 auto');
