+        readingThread()->postTask(FROM_HERE, new Task(threadSafeBind(&Self::resetReader, this)));
+        readingThread()->postTask(FROM_HERE, new Task(threadSafeBind(&Self::signalDone, this)));
+    }
+
+    OwnPtr<CompositeDataConsumerHandle> m_handle;
+};
