+#ifndef MediaKeySession_h
+#define MediaKeySession_h
+
+#include "bindings/core/v8/ScriptPromiseProperty.h"
+#include "core/dom/ActiveDOMObject.h"
+#include "core/dom/DOMArrayPiece.h"
