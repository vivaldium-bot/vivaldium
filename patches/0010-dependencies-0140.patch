+CXFA_TextTabstopsContext::CXFA_TextTabstopsContext()
+    : m_iTabCount(0),
+      m_iTabIndex(-1),
+      m_bTabstops(false),
+      m_fTabWidth(0),
+      m_fLeft(0) {}
