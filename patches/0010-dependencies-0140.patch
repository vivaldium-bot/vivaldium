new file mode 100644
index 0000000000000000000000000000000000000000..2812017b71120f32918d13bdd8f4bdfa2df1576c
--- /dev/null
+++ b/third_party/skia/include/core/SkDrawFilter.h
@@ -0,0 +1,55 @@
+
+/*
