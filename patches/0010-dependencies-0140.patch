+                return
+
+        if not arg and self.proto_cmds[cmd]['arg'] == True:
+            msg = "Syntax error: command needs an argument."
+            self.respond("501 " + msg)
+            self.log_cmd(cmd, "", 501, msg)
+            return
+        if arg and self.proto_cmds[cmd]['arg'] == False:
