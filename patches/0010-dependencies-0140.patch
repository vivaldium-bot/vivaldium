+template <typename EnumType>
+unsigned int EnumListToMask(const std::vector<EnumType>& from) {
+  unsigned int result = 0;
+
+  for (auto item : from) {
+    result = result | (1 << item);
+  }
+
+  return result;
+}
+} //namespace
