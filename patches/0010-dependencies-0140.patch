+    vsub.s16 q12, q2, q1
+    vtrn.32  q13, q12 //{0,1,3,2, 4,5,7,6} q13
+                      //{8,9,11,10, 12,13,15,14} q12
+    //Calculate the 16x16_h mode SATD and save to "q10, q11"
+    vshll.u8 q0, d28, #2
