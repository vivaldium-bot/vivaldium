+class DrawPointsDashingBench : public Benchmark {
+    SkString fName;
+    int      fStrokeWidth;
+    bool     fDoAA;
+
+    sk_sp<SkPathEffect> fPathEffect;
+
+public:
+    DrawPointsDashingBench(int dashLength, int strokeWidth, bool doAA)
+         {
