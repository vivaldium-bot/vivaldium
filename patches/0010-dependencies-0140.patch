+ *
+ * \file    encoder_context.h
+ *
+ * \brief   Main pData to be operated over Wels encoder all modules
+ *
+ * \date    2/4/2009 Created
+ *
+ *************************************************************************************
+ */
+#ifndef WELS_ENCODER_CONTEXT_H__
+#define WELS_ENCODER_CONTEXT_H__
+
+#include <stdio.h>
+#include "typedefs.h"
+#include "param_svc.h"
+#include "nal_encap.h"
