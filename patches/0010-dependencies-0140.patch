+%token <sval> WFD_GENERIC_PROPERTY
+%token <sval> WFD_HEADER
+%token WFD_CSEQ
+%token WFD_RESPONSE_METHODS
+%token WFD_TAG
+%token WFD_SUPPORT_CHECK
+%token <sval> WFD_REQUEST_URI
+%token WFD_CONTENT_TYPE
+%token <sval> WFD_MIME
