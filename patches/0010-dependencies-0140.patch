+    javascript.AppendChar(L'\"');
+    FX_WCHAR oneChar;
+    for (int16_t i = 1; i < tempStr.GetLength() - 1; i++) {
+      oneChar = tempStr[i];
+      switch (oneChar) {
+        case L'\"': {
+          i++;
+          javascript << FX_WSTRC(L"\\\"");
+        } break;
+        case 0x0d:
+          break;
+        case 0x0a: {
+          javascript << FX_WSTRC(L"\\n");
+        } break;
+        default: { javascript.AppendChar(oneChar); } break;
+      }
+    }
+    javascript.AppendChar(L'\"');
+  } else {
+    javascript << tempStr;
+  }
+}
