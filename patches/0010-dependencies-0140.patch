+static inline void MeEndIntepelSearch (SWelsME* pMe) {
+  /* -> qpel mv */
+  pMe->sMv.iMvX *= (1 << 2);
+  pMe->sMv.iMvY *= (1 << 2);
+  pMe->uiSatdCost = pMe->uiSadCost;
+}
