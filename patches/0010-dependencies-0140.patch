+
+WELS_ASM_AARCH64_FUNC_BEGIN WelsI4x4LumaPredDcTop_AArch64_neon
+    SIGN_EXTENSION x2,w2
+    sub     x3, x1, x2
+    sub     v0.8b, v0.8b, v0.8b
