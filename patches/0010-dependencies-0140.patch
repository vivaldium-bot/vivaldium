+CXFA_FMForeachExpression::CXFA_FMForeachExpression(
+    uint32_t line,
+    const CFX_WideStringC& wsIdentifier,
+    CFX_ArrayTemplate<CXFA_FMSimpleExpression*>* pAccessors,
+    CXFA_FMExpression* pList)
