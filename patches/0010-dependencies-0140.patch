+    ld1     {v0.16b, v1.16b}, [x2], #32
+    ld1     {v2.16b, v3.16b}, [x7], #32
+    uaddlp  v0.8h, v0.16b
+    uaddlp  v1.8h, v1.16b
+    uaddlp  v2.8h, v2.16b
+    uaddlp  v3.8h, v3.16b
+    urshr   v0.8h, v0.8h, #1
+    urshr   v1.8h, v1.8h, #1
+    urshr   v2.8h, v2.8h, #1
+    urshr   v3.8h, v3.8h, #1
+    urhadd  v0.8h, v0.8h, v2.8h
+    urhadd  v1.8h, v1.8h, v3.8h
