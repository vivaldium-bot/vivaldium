+                                              unsigned short* buffer,
+                                              int buflen);
+
+// Function: FPDFLink_CountRects
+//          Count number of rectangular areas for the link.
+// Parameters:
+//          link_page   -   Handle returned by FPDFLink_LoadWebLinks.
+//          link_index  -   Zero-based index for the link.
