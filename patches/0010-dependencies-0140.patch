+    def get_nonexistent_user(self):
+        # return a user which does not exist on the system
+        users = self.get_users()
+        letters = string.ascii_lowercase
+        while 1:
+            user = ''.join([random.choice(letters) for i in range(10)])
+            if user not in users:
+                return user
