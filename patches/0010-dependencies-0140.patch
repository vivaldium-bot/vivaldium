+    paddw  xmm7,   xmm0
+    movdqu xmm1,   [r2+r3]
+    MOVDQ  xmm2,   [r0+r1]
+    psadbw xmm1,   xmm2
+    paddw  xmm7,   xmm1
+    movdqu xmm1,   [r2+2*r3]
+    MOVDQ  xmm2,   [r0+2*r1];[eax] must aligned 16
+    psadbw xmm1,   xmm2
+    paddw  xmm7,   xmm1
+    movdqu xmm1,   [r2+r5]
+    MOVDQ  xmm2,   [r0+r4]
+    psadbw xmm1,   xmm2
+    paddw  xmm7,   xmm1
