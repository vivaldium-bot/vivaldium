+%macro SSEReg2MMX 3
+    movdq2q     %2, %1
+    movhlps     %1, %1
+    movdq2q     %3, %1
+%endmacro
+%macro MMXReg2SSE 4
+    movq2dq     %1, %3
+    movq2dq     %2, %4
+    punpcklqdq  %1, %2
+%endmacro
+;for reduce the code size of WelsIntraChroma8x8Combined3Satd_sse41
