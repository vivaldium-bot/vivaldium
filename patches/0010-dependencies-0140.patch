+    movq   xmm3,   [r2+r3]
+    lea    r2,     [r2+2*r3]
+    movhps xmm2,   [r2]
+    movhps xmm3,   [r2+r3]
+    psadbw xmm0,   xmm2
+    psadbw xmm1,   xmm3
+    paddw  xmm6,   xmm0
+    paddw  xmm6,   xmm1
+%endmacro
