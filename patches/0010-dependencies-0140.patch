+
+WL_EXPORT void
+wl_display_run(struct wl_display *display)
+{
+	display->run = 1;
+
+	while (display->run) {
+		wl_display_flush_clients(display);
+		wl_event_loop_dispatch(display->loop, -1);
+	}
