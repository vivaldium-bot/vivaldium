+bool GstSinkMediaManager::IsPaused() const {
+  return gst_pipeline_->IsPaused();
+}
+
+std::pair<int,int> GstSinkMediaManager::GetLocalRtpPorts() const {
+  return std::pair<int,int>(gst_pipeline_->sink_udp_port(), 0);
+}
+
