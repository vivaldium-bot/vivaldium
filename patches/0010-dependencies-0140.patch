index 0000000000000000000000000000000000000000..260b415a800af318f5a7e1a8fa04ae657eda376b
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/hir_field_selection.cpp
@@ -0,0 +1,102 @@
+/*
