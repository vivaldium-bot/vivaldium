+%macro SSE2_SumWHorizon1 2
+    movdqa      %2, %1
+    psrldq      %2, 8
+    paddusw     %1, %2
+    movdqa      %2, %1
+    psrldq      %2, 4
+    paddusw     %1, %2
+    movdqa      %2, %1
+    psrldq      %2, 2
+    paddusw     %1, %2
+%endmacro
+
+%macro SSE2_HDMTwo4x4 5 ;in: xmm1,xmm2,xmm3,xmm4  pOut: xmm4,xmm2,xmm1,xmm3
