index 0000000000000000000000000000000000000000..e7d274e2a881db0e967da87d7bf823238b4e025f
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/tests/uniform_initializer_utils.cpp
@@ -0,0 +1,233 @@
+/*
