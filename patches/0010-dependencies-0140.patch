+
+// Exported Functions
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Function: FPDF_InitLibrary
+//          Initialize the FPDFSDK library
+// Parameters:
+//          None
+// Return value:
+//          None.
+// Comments:
