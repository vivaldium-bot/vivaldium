+  virtual void EndofUpdateRefList() = 0;
+  virtual void AfterBuildRefList() = 0;
+
+ protected:
+  virtual void Init (sWelsEncCtx* pCtx) = 0;
+};
+
+class  CWelsReference_TemporalLayer : public IWelsReferenceStrategy {
