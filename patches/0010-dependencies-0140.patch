index 0000000000000000000000000000000000000000..6462a7a8c28097b6eeb9e09eadaccaf7a7affba7
--- /dev/null
+++ b/third_party/openh264/src/codec/decoder/core/inc/dec_golomb.h
@@ -0,0 +1,341 @@
+/*!
+ * \copy
+ *     Copyright (c)  2009-2013, Cisco Systems
+ *     All rights reserved.
+ *
+ *     Redistribution and use in source and binary forms, with or without
+ *     modification, are permitted provided that the following conditions
