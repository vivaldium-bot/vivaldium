+    return;
+  }
+  CFX_WideString content = GetScriptContent(true);
+  if (content.IsEmpty()) {
+    pValue->SetNull();
+  } else {
+    pValue->SetString(
+        FX_UTF8Encode(content.c_str(), content.GetLength()).AsStringC());
+  }
+}
