+  CFX_WideString wsFilePath;
+  bool bXDP = true;
+  if (iLength >= 1) {
+    CFX_ByteString bsFilePath = pArguments->GetUTF8String(0);
+    wsFilePath = CFX_WideString::FromUTF8(bsFilePath.AsStringC());
+  }
