new file mode 100644
index 0000000000000000000000000000000000000000..bb9862b5640a1d97e66a94746d4de2fe1ffbd70b
--- /dev/null
+++ b/third_party/pdfium/skia/config/SkUserConfig.h
@@ -0,0 +1,269 @@
+/*
