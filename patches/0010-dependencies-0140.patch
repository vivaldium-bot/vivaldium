+int32_t PredIntra4x4Mode (int8_t* pIntraPredMode, int32_t iIdx4) {
+  int8_t iTopMode = pIntraPredMode[iIdx4 - 8];
+  int8_t iLeftMode = pIntraPredMode[iIdx4 - 1];
+  int8_t iBestMode;
+
+  if (-1 == iLeftMode || -1 == iTopMode) {
+    iBestMode = 2;
+  } else {
+    iBestMode = WELS_MIN (iLeftMode, iTopMode);
+  }
+  return iBestMode;
+}
