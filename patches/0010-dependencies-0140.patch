+    p_clock_(p_clock),
+    h_(h),
+    hb_(hb),
+    hspol_hsoff_(hspol_hsoff),
+    hsw_(hsw),
+    v_(v),
+    vb_(vb),
+    vspol_vsoff_(vspol_vsoff),
