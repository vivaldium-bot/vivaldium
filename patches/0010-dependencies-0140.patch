+    add     x6, x6, w3, sxtw #1
+    mov     x2, x6
+    add     x7, x2, w3, sxtw
+    add     x8, x8, w1, sxtw
+    mov     x0, x8
+    sub     w5, w5, #1
+
+    cbnz    w5, comp_ds_bilinear_loop0
+
+    //restore   the tailer for the unasigned size
+    st1     {v4.16b}, [x0]
+
