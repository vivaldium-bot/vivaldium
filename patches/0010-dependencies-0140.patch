+else:
+    def to_unicode(i):
+        return chr(i)
+o = sys.stdout
+o.write(to_unicode(0xFEFF))
+pack = array.array('I', zlib.decompress(
+    base64.b64decode(valid_codepoint_data)))
+i = 0
+last_row = -1
+plist = pack.tolist()
+for increment in plist:
+    i += increment + 1
+    row = i - (i & 63)
+    if last_row != row:
+        if row:
+            o.write('\n' if row % 1024 else '\n\n')
+        o.write('U+%06x ' % row)
+        last_row = row
+    o.write(' ' + to_unicode(i))
+o.write('\n')
diff --git a/third_party/skia/experimental/tools/mskp_parser.py b/third_party/skia/experimental/tools/mskp_parser.py
