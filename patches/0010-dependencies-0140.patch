+class Global;
+
+class Path2DBuilder : SkNoncopyable {
+public:
+    Path2DBuilder() : fSkPath() {}
+    virtual ~Path2DBuilder() {}
+
+    const SkPath& getSkPath() { return fSkPath; }
+
+    // The JS Path2DBuilder constuctor implementation.
