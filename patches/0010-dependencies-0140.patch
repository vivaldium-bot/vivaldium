+           uiCpuFeatureFlags,
+           (uiCpuFeatureFlags & WELS_CPU_HTT) ? 'Y' : 'N',
+           (uiCpuFeatureFlags & WELS_CPU_MMX) ? 'Y' : 'N',
+           (uiCpuFeatureFlags & WELS_CPU_MMXEXT) ? 'Y' : 'N',
+           (uiCpuFeatureFlags & WELS_CPU_SSE) ? 'Y' : 'N',
