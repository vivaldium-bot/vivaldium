+void CXFA_Node::Script_InstanceManager_MoveInstance(
+    CFXJSE_Arguments* pArguments) {
+  int32_t argc = pArguments->GetLength();
+  if (argc != 2) {
+    pArguments->GetReturnValue()->SetUndefined();
+    return;
