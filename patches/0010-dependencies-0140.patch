+#!/bin/sh
+
+set -e
+
+BRANCH=$(git branch | grep \* | cut -d" "  -f 2)
+CLEAN=${CLEAN-clean}
+SAMPLES=100
+
+if [ "$BRANCH" = "$CLEAN" ]; then
+    echo "Comparing $BRANCH to itself."
+    exit 1
+fi
+
+if [ ! -f $CLEAN.log ]; then
+    git checkout $CLEAN
+    python gyp_skia >/dev/null
+    ninja -C out/Release nanobench
