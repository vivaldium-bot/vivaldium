+BenchLogger::BenchLogger()
+: fFileStream(nullptr) {}
+
+BenchLogger::~BenchLogger() {
+    if (fFileStream) {
+        delete fFileStream;
+    }
+}
+
+bool BenchLogger::SetLogFile(const char *file) {
+    fFileStream = new SkFILEWStream(file);
+    return fFileStream->isValid();
+}
