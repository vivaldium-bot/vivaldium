+    PUSH_XMM 8
+    SIGN_EXTENSION r1, r1d
+    SIGN_EXTENSION r3, r3d
+    pxor   xmm6,   xmm6
+    pxor   xmm7,   xmm7
+    SSE2_GetSatd8x8
+    psrlw   xmm6,  1
+    SSE2_SumWHorizon   xmm6,xmm4,xmm7
+    movd    retrd,   xmm6
+    POP_XMM
+    LOAD_4_PARA_POP
+    ret
+
+ ;***********************************************************************
+ ;
+ ;int32_t WelsSampleSatd8x16_sse2( uint8_t *, int32_t, uint8_t *, int32_t, );
+ ;
+ ;***********************************************************************
+WELS_EXTERN WelsSampleSatd8x16_sse2
+    %assign  push_num 0
+    LOAD_4_PARA
+    PUSH_XMM 8
+    SIGN_EXTENSION r1, r1d
+    SIGN_EXTENSION r3, r3d
+    pxor   xmm6,   xmm6
+    pxor   xmm7,   xmm7
+
+    SSE2_GetSatd8x8
+    lea    r0,    [r0+2*r1]
+    lea    r2,    [r2+2*r3]
+    SSE2_GetSatd8x8
+
+    psrlw   xmm6,  1
+    SSE2_SumWHorizon   xmm6,xmm4,xmm7
+    movd    retrd,   xmm6
+    POP_XMM
+    LOAD_4_PARA_POP
+    ret
+
+;***********************************************************************
+;
+;int32_t WelsSampleSatd16x8_sse2( uint8_t *, int32_t, uint8_t *, int32_t, );
+;
+;***********************************************************************
+WELS_EXTERN WelsSampleSatd16x8_sse2
+    %assign  push_num 0
+    LOAD_4_PARA
+    PUSH_XMM 8
+    SIGN_EXTENSION r1, r1d
+    SIGN_EXTENSION r3, r3d
+    push r0
+    push r2
+    pxor   xmm6,   xmm6
+    pxor   xmm7,   xmm7
+
+    SSE2_GetSatd8x8
+
+    pop r2
+    pop r0
+    add    r0,    8
+    add    r2,    8
+    SSE2_GetSatd8x8
+
+    psrlw   xmm6,  1
+    SSE2_SumWHorizon   xmm6,xmm4,xmm7
+    movd    retrd,   xmm6
+    POP_XMM
+    LOAD_4_PARA_POP
+    ret
