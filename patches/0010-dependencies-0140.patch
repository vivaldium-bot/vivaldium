+  bool ProcessBookendLeaderOrTrailer(CXFA_Node* pBookendNode,
+                                     bool bLeader,
+                                     CXFA_Node*& pBookendAppendNode);
+  CXFA_LayoutItem* FindOrCreateLayoutItem(CXFA_Node* pFormNode);
+
+ protected:
