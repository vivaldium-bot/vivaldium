+    void Play();
+    void Pause();
+    bool IsPaused() const;
+    void Teardown();
+
+    int sink_udp_port();
+
+private:
+    bool IsInState(GstState state) const;
+    GstElement* gst_elem;
+    guint bus_watch_id;
+};
+
+#endif
