index 0000000000000000000000000000000000000000..8aa26e5d018f4239e8e44154bf92e41c80679b41
--- /dev/null
+++ b/third_party/mesa/src/src/glsl/ir_print_visitor.cpp
@@ -0,0 +1,530 @@
+/*
