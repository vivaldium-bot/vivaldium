+} SSceneChangeResult;
+
+typedef struct {
+  unsigned char* pCurY;             // Y data of current frame
+  unsigned char* pRefY;             // Y data of pRef frame for diff calc
+  int (*pSad8x8)[4];                // sad of 8x8, every 4 in the same 16x16 get together
