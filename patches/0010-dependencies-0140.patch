+ME_FULL    = 0x10,  // FULL
+
+// derived ME methods combination
+ME_DIA_CROSS    = (ME_DIA | ME_CROSS),   // DIA+CROSS
+ME_DIA_CROSS_FME  = (ME_DIA_CROSS | ME_FME)  // DIA+CROSS+FME
+};
