+    ext     v0.8b, v1.8b, v2.8b, #1
+    st1     {v0.S}[0], [x0], 4
+    ext     v0.8b, v1.8b, v2.8b, #2
+    st1     {v0.S}[0], [x0], 4
+    ext     v0.8b, v1.8b, v2.8b, #3
+    st1     {v0.S}[0], [x0]
