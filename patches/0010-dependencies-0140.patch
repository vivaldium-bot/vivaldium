+CXFA_TextLayout::CXFA_TextLayout(CXFA_TextProvider* pTextProvider)
+    : m_bHasBlock(false),
+      m_pTextProvider(pTextProvider),
+      m_pTextDataNode(nullptr),
+      m_bRichText(false),
+      m_iLines(0),
+      m_fMaxWidth(0),
+      m_bBlockContinue(true) {
+  ASSERT(m_pTextProvider);
+}
