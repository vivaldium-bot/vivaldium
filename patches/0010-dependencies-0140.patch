+const FXJSE_CLASS_DESCRIPTOR GlobalClassDescriptor = {
+    "Root",   // name
+    nullptr,  // constructor
+    nullptr,  // properties
+    nullptr,  // methods
+    0,        // property count
+    0,        // method count
+    CXFA_ScriptContext::GlobalPropTypeGetter,
+    CXFA_ScriptContext::GlobalPropertyGetter,
+    CXFA_ScriptContext::GlobalPropertySetter,
