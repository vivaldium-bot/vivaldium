+           (uiCpuFeatureFlags & WELS_CPU_FMA) ? 'Y' : 'N',
+           (uiCpuFeatureFlags & WELS_CPU_FPU) ? 'Y' : 'N',
+           (uiCpuFeatureFlags & WELS_CPU_3DNOW) ? 'Y' : 'N',
