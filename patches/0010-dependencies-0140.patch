diff --git a/third_party/skia/experimental/iOSSampleApp/Shared/SkUIView.mm b/third_party/skia/experimental/iOSSampleApp/Shared/SkUIView.mm
new file mode 100644
index 0000000000000000000000000000000000000000..df55619e4c54eb7b5f9dc6fdc580b7d88ff998ad
--- /dev/null
