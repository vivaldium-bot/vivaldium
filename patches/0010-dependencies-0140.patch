index 0000000000000000000000000000000000000000..ea88afbb57912803e65ebf8f62af958528ffc8ec
--- /dev/null
+++ b/third_party/wayland/src/tests/resources-test.c
@@ -0,0 +1,168 @@
+/*
+ * Copyright © 2013 Marek Chalupa
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining
