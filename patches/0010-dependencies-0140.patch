diff --git a/third_party/skia/debugger/QT/Icons/.qrc b/third_party/skia/debugger/QT/Icons/.qrc
new file mode 100644
index 0000000000000000000000000000000000000000..dc9075a9fdf88cd88d0cc3ec876adc39ff5d2fbb
