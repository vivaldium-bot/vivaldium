+        # since many ftp clients don't do it correctly we check the
+        # last 4 characters only.
+        if not cmd in self.proto_cmds:
+            if cmd[-4:] in ('ABOR', 'STAT', 'QUIT'):
+                cmd = cmd[-4:]
+            else:
