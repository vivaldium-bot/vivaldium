+
+const uint8_t g_kNonZeroScanIdxC[4] = { //pNonZeroCount cache for chroma, 4*4 block as basic unit
+  4, 5,
+  7, 8
+};
+
+const uint8_t g_kuiScan8[24] = {        // [16 + 2*4]
+  9, 10, 17, 18,        // 1+1*8, 2+1*8, 1+2*8, 2+2*8,
+  11, 12, 19, 20,       // 3+1*8, 4+1*8, 3+2*8, 4+2*8,
