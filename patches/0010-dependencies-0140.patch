+WELS_ASM_AARCH64_FUNC_BEGIN WelsI4x4LumaPredDc_AArch64_neon
+    SIGN_EXTENSION x2,w2
+    sub     x3, x1, x2
+    sub     x4, x1, #1
+    ldr     s0, [x3]
+    ld1     {v0.b}[4], [x4], x2
+    ld1     {v0.b}[5], [x4], x2
+    ld1     {v0.b}[6], [x4], x2
+    ld1     {v0.b}[7], [x4]
