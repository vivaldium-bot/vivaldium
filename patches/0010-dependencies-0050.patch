+class StringMetricTest(TestBase):
+
+  def test_populate_value(self):
+    pb = metrics_pb2.MetricsData()
+    m = metrics.StringMetric('test')
+    m._populate_value(pb, 'foo', 1234)
+    self.assertEquals(pb.string_value, 'foo')
