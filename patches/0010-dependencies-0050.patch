+class CounterMetricTest(TestBase):
+
+  def test_populate_value(self):
+    pb = metrics_pb2.MetricsData()
+    m = metrics.CounterMetric('test')
+    m._populate_value(pb, 1, 1234)
+    self.assertEquals(pb.counter, 1)
