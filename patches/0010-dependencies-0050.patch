+
+        toBeCrossOriginOnPage: function() {
+          return {
+            compare: function(actual, expected) {
+              var ajaxUrl = actual;
+              var ajaxHost = parseUrlOrigin(ajaxUrl);
+              var curPageHost = parseUrlOrigin(expected);
+
+              return {
+                pass: isCrossOrigin(curPageHost, ajaxHost)
+              };
+
+            }
+          };
+        }
+      });
+   });
+});
