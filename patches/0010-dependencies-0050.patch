+    const diagnostic = new tr.v.d.RelatedEventSet();
+    tr.c.TestUtils.newModel(function(model) {
+      const proc = model.getOrCreateProcess(1);
+      const thread = proc.getOrCreateThread(2);
+      const event = tr.c.TestUtils.newSliceEx(
