+//------------------------------------------------------------------------------
+// Offline: used by mapreduce or table construction
+//------------------------------------------------------------------------------
+
+// Find top two langs and scores for one word; underpins delta tables
+void DoWordScore(const char* isrc, int srclen, ULScript ulscript,
