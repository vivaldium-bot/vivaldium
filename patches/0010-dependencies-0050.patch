+                 (actualUrlParsed.port == expected.port);
+
+               if (!result.pass) {
+                 result.message = 'expected ' + actual
+                   + ' to parse to ' + JSON.stringify(expected)
+                   + ' but got ' + JSON.stringify(actualUrlParsed);
