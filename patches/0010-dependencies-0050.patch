+  });
+
+  xdescribe('unknown event types', function() {
+
+    it('can be added and fired', function() {
+      var spy1 = jasmine.createSpy('xyzzy callback');
+      var spy2 = jasmine.createSpy('end of universe callback');
+
+      var setUp = function(){
+        oboeInstance
