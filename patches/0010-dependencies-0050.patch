+
+  test('merge_unmergeable', async function() {
+    const histograms = new tr.v.HistogramSet([
+      newHistogram('foo', {telemetry: {storyDisplayName: 'A', label: 'Value'}}),
+      newHistogram('foo', {
+        boundaries: tr.v.HistogramBinBoundaries.createLinear(0, 1e3, 21),
