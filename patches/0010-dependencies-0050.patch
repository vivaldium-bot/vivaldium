+  def test_set(self):
+    m = metrics.StringMetric('test')
+    m.set('hello world')
+    self.assertEquals(m.get(), 'hello world')
+
+  def test_non_string_raises(self):
+    m = metrics.StringMetric('test')
+    with self.assertRaises(errors.MonitoringInvalidValueTypeError):
+      m.set(object())
+
+  def test_is_cumulative(self):
+    m = metrics.StringMetric('test')
