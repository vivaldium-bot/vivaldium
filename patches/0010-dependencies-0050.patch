+              if( typeof maybeErr != 'object' ) {
+                return {passed: false};
+              }
+
+              if( maybeErr instanceof Error ) {
+                return {passed: true};
+              }
+
+              // instanceof Error doesn't always work in Safari (tested v6.0.5)
