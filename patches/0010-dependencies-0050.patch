+
+  /**
+   * @typedef {Object} HypothesisTestResult
+   * @property {number} p
+   * @property {number} U
+   * @property {!tr.b.math.Statistics.Significance} significance
+   */
+
+  /**
+   * @param {!Array.<number>} a
