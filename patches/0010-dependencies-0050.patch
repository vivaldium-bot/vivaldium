+    // The maximum of (countClosed(k, i-1)/N - length(k, i-1)) for any k < i-1.
+    let maxDiff = 0;
+    // The minimum of (countOpen(k, i-1)/N - length(k, i-1)) for any k < i-1.
+    let minDiff = 0;
