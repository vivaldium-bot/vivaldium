+    if (samples.length <= count) {
+      return samples;
+    }
+    while (samples.length > count) {
+      const i = parseInt(Math.random() * samples.length);
+      samples.splice(i, 1);
+    }
+    return samples;
+  };
+
+  /**
+   * A mechanism to uniformly sample elements from an arbitrary long stream.
+   *
