+  cld_generated_cjk_delta_bi_4.cc generated_distinct_bi_0.cc  \
+  cld2_generated_quadchrome_16.cc cld2_generated_deltaoctachrome.cc \
+  cld2_generated_distinctoctachrome.cc  cld_generated_score_quad_octa_2.cc  \
