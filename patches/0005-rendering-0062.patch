-<script>
-
-// Valid custom property names, before and after CSS escaping.
-var valid_names = [
-  ["--a", "--a"],
-  ["--a;b", "--a\\;b"],
-  ["---", "---"],
-  ["--\\", "--\\\\"],
-  ["--ab", "--\\61 b"],
