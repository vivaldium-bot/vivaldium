-    })
-  }, ".supports() must throw TypeError" + desc);
-
-  // length attribute
-
-  function checkLength(value, length) {
-    test(function() {
-      setClass(e, value);
-      assert_equals(e.classList.length, length);
-    }, "classList.length when " +
-    (value === null ? "removed" : "set to " + format_value(value)) + desc);
-  }
-
-  checkLength(null, 0);
-  checkLength("", 0);
-  checkLength("   \t  \f", 0);
