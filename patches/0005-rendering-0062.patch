-      isArray = false;
-    }
-    if (field instanceof Function) {
-      field = field();
-    } else if (field === undefined) {
-      if (isArray) {
-        field = new Array();
-      } else {
-        field = null;
-      }
-    }
-    if (isArray) {
-      assert_array_equals(mr1[property], field, property + " didn't match");
-    } else {
-      assert_equals(mr1[property], field, property + " didn't match");
