-      }));
-      var win = window.open(prefixedMessage.url(windowURL), '', featureString);
-    }, `features "${feature}" should NOT set "width=404"`);
-  });
-
-  // Negative values for `innerheight` should result in a window with minimum
-  // valid allowed height
