-//
-// Helper Functions for NavigationTiming W3C tests
-//
-
-var performanceNamespace = window.performance;
-var timingAttributes = [
-    'connectEnd',
-    'connectStart',
-    'domComplete',
-    'domContentLoadedEventEnd',
-    'domContentLoadedEventStart',
-    'domInteractive',
-    'domLoading',
-    'domainLookupEnd',
