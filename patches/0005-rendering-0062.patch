-  eventSender.mouseDown(1, [], "pen", 0);
-
-  debug("- move non-primary pen into target & press -");
-  eventSender.mouseMoveTo(x2+2, y2+2, [], "pen", 1);
-  eventSender.mouseDown(1, [], "pen", 1);
-
-  debug("- jiggle mouse in target -");
