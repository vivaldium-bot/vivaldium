-  mouseEventList.forEach(function(eventName) {
-    targetDiv.addEventListener(eventName, function(event) {
-      debug(++seqNo + ". target received " + event.type);
-    });
-  });
-
-  pointerEventList.forEach(function(eventName) {
-    targetDiv.addEventListener(eventName, function(event) {
-      var preventDefaultMsg = "";
