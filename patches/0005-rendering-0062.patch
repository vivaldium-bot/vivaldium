-    { x : 74, y : 49, expected : "hit" },
-    { x : 49, y : 88, expected : null },
-    { x : 13, y : 65, expected : null },
-    { x : 66, y : 76, expected : "hit" },
-    { x : 76, y : 23, expected : null },
-    { x : 38, y : 76, expected : "hit" },
-    { x : 28, y : 47, expected : "hit" },
