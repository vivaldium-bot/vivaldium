+void InspectorDebuggerAgent::stepIntoAsync(ErrorString* errorString)
+{
+    if (!assertPaused(errorString))
+        return;
+    if (!trackingAsyncCalls()) {
+        *errorString = "Can only perform operation if async call stacks are enabled.";
+        return;
