+        return false;
+    TextPosition position(OrdinalNumber::fromZeroBasedInt(lineNumber), OrdinalNumber::fromZeroBasedInt(columnNumber));
+    *offset = position.toOffset(*endings).zeroBasedInt();
+    return true;
