+
+TEST_F(OverflowModelTest, AddContentsVisualOverflowFirstCall)
+{
+    m_overflow.addContentsVisualOverflow(LayoutRect(0, 0, 10, 10));
+    EXPECT_EQ(LayoutRect(0, 0, 10, 10), m_overflow.contentsVisualOverflowRect());
