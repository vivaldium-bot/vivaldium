+void LayoutBlockFlow::paintFloats(const PaintInfo& paintInfo, const LayoutPoint& paintOffset, bool preservePhase)
+{
+    BlockFlowPainter(*this).paintFloats(paintInfo, paintOffset, preservePhase);
+}
