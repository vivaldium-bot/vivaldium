+LayoutUnit LayoutBoxModelObject::computedCSSPadding(const Length& padding) const
+{
+    LayoutUnit w = 0;
+    if (padding.hasPercent())
+        w = containingBlockLogicalWidthForContent();
+    return minimumValueForLength(padding, w);
