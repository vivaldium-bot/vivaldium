+    ScriptDebugListener* getDebugListenerForContext(v8::Local<v8::Context>) override;
+    void runMessageLoopOnPause(v8::Local<v8::Context>) override;
+    void quitMessageLoopOnPause() override;
+
+    static WTF::Mutex& creationMutex();
