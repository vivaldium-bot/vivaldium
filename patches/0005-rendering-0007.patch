+class LayoutListItem final : public LayoutBlockFlow {
+public:
+    explicit LayoutListItem(Element*);
+
+    int value() const
+    {
+        if (!m_isValueUpToDate) {
+            updateValueNow();
+        }
+        return m_value;
+    }
