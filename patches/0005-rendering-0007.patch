+LayoutObject* LayoutObject::lastLeafChild() const
+{
+    LayoutObject* r = slowLastChild();
+    while (r) {
+        LayoutObject* n = nullptr;
+        n = r->slowLastChild();
+        if (!n)
+            break;
+        r = n;
+    }
+    return r;
+}
