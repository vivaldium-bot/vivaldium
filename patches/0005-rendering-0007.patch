+private:
+    virtual ~LayoutThemeAndroid();
+
+    static const RGBA32 defaultTapHighlightColor = 0x6633b5e5;
+    static const RGBA32 defaultActiveSelectionBackgroundColor = 0x6633b5e5;
+};
+
+} // namespace blink
+
+#endif // LayoutThemeAndroid_h
