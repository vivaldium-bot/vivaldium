+
+TEST_F(OverflowModelTest, AddVisualOverflowDoesNotAffectContentsVisualOverflow)
+{
+    m_overflow.addVisualOverflow(LayoutRect(300, 300, 300, 300));
+    EXPECT_TRUE(m_overflow.contentsVisualOverflowRect().isEmpty());
