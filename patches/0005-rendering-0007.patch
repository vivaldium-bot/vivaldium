+LayoutMultiColumnSet::LayoutMultiColumnSet(LayoutFlowThread* flowThread)
+    : LayoutBlockFlow(nullptr)
+    , m_fragmentainerGroups(*this)
+    , m_flowThread(flowThread)
+{
+}
