+    m_lineBottom += blockDirectionDelta;
+    m_lineTopWithLeading += blockDirectionDelta;
+    m_lineBottomWithLeading += blockDirectionDelta;
+    m_selectionBottom += blockDirectionDelta;
+    if (hasEllipsisBox())
+        ellipsisBox()->move(delta);
+}
