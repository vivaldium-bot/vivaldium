+struct LayoutTextInfo {
+    LayoutTextInfo()
+        : m_text(nullptr)
+        , m_font(nullptr)
+    {
+    }
+
+    LayoutText* m_text;
+    LazyLineBreakIterator m_lineBreakIterator;
+    const Font* m_font;
+};
+
+} // namespace blink
+
+#endif // LayoutTextInfo_h
