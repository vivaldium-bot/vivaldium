+    LayoutText* m_buttonText;
+    LayoutBlock* m_innerBlock;
+
+    bool m_optionsChanged : 1;
+    bool m_isEmpty : 1;
+    bool m_hasUpdatedActiveOption : 1;
+    bool m_popupIsVisible : 1;
+    int m_optionsWidth;
+
+    int m_lastActiveIndex;
