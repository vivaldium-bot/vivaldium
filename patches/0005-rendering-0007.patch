+    m_scheduledDebuggerStep = StepInto;
+    m_steppingFromFramework = isTopCallFrameBlackboxed();
+    m_injectedScriptManager->releaseObjectGroup(InspectorDebuggerAgent::backtraceObjectGroup);
+    debugger().stepIntoStatement();
+}
