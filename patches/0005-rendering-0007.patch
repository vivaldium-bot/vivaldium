index 0000000000000000000000000000000000000000..f3b0da9e341bb315903930170c89be4222fd2234
--- /dev/null
+++ b/third_party/WebKit/Source/core/layout/CounterNode.cpp
@@ -0,0 +1,390 @@
+/*
