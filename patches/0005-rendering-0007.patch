@@ -1,48 +0,0 @@
-<!DOCTYPE html>
-<html>
-<head>
-  <script src="../resources/run-after-layout-and-paint.js"></script>
-  <style>
-    #indicator {
-      position: absolute;
-      top: 0px;
-      left: 0px;
-      height: 100px;
-      width: 100px;
-      background-color: red;
-    }
-    #clipper {
-      transform:translateZ(0);
-      position: absolute;
-      top: 0px;
-      left: 0px;
-      height: 100px;
-      width: 100px;
-      background-color: green;
-      clip: rect(25px, 75px, 75px, 25px);
