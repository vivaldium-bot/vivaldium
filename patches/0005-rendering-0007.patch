+bool LayoutFlexibleBox::hasOrthogonalFlow(LayoutBox& child) const
+{
+    // FIXME: If the child is a flexbox, then we need to check isHorizontalFlow.
+    return isHorizontalFlow() != child.isHorizontalWritingMode();
