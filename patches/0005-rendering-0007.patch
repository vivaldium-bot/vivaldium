+PageConsoleAgent::~PageConsoleAgent()
+{
+#if !ENABLE(OILPAN)
+    m_inspectorDOMAgent = nullptr;
+    m_instrumentingAgents->setPageConsoleAgent(nullptr);
+#endif
+}
