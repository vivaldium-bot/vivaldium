+}
+
+v8::Local<v8::Value> V8Debugger::collectionEntries(v8::Local<v8::Object>& object)
+{
+    if (!enabled()) {
+        ASSERT_NOT_REACHED();
+        return v8::Local<v8::Value>::New(m_isolate, v8::Undefined(m_isolate));
+    }
+    v8::Local<v8::Value> argv[] = { object };
