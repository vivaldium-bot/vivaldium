+function veryLongString() {
+  return "Lorem ipsum dolor sit amet, consectetur adipiscing elit." +
+         "Nam vulputate metus est. Maecenas quis pellentesque eros," +
+         "ac mattis augue. Nam porta purus vitae tincidunt blandit." +
