+
+// Flags: --allow-natives-syntax
+
+var boom = { valueOf: function() { throw "boom" } };
+
+function mult_left_plain(x) {
+  try {
+    return 2 * x;
+  } catch (e) {
+    return e;
+  }
+}
+
+%OptimizeFunctionOnNextCall(mult_left_plain);
