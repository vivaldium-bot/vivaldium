+assertEquals("1,2,3,4,,3,4,", a1.join());
+
+a1 = [];
+a2 = [a1];
+a1.push(a2);
+assertEquals("", a1.toString());
+assertEquals("", a1.toLocaleString());
+assertEquals("", a1.join());
diff --git a/v8/test/mjsunit/cyrillic.js b/v8/test/mjsunit/cyrillic.js
