+assertEquals(0.6, Math.tanh(Math.LN2));
+assertEquals(-0.6, Math.tanh(-Math.LN2));
+// Case  1 < |x| < 22
+assertEquals(15/17, Math.tanh(2 * Math.LN2));
+assertEquals(-15/17, Math.tanh(-2 * Math.LN2));
+// Case |x| > 22
+assertEquals(1, Math.tanh(100));
+assertEquals(-1, Math.tanh(-100));
+// Test against overflow
+assertEquals(1, Math.tanh(1e300));
+assertEquals(-1, Math.tanh(-1e300));
