+
+[Math.log10, Math.log2].forEach( function(fun) {
+  assertTrue(isNaN(fun(NaN)));
+  assertTrue(isNaN(fun(fun)));
+  assertTrue(isNaN(fun({ toString: function() { return NaN; } })));
+  assertTrue(isNaN(fun({ valueOf: function() { return -1; } })));
