+
+// Test direct constructor call
+assertThrows(function() { SharedArrayBuffer(); }, TypeError);
+for(i = 0; i < typedArrayConstructors.length; i++) {
+  assertThrows(function(i) { typedArrayConstructors[i](); }.bind(this, i),
