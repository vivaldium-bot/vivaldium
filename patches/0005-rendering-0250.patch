+  class DerivedDerived extends Derived {
+    constructor() {
+      let r = super();
+      assertEquals(this, r);
+      derivedDerivedCalled++;
+    }
+  }
+
+  baseCalled = 0;
+  derivedCalled = 0;
+  derivedDerivedCalled = 0;
+  new DerivedDerived();
+  assertEquals(1, baseCalled);
+  assertEquals(1, derivedCalled);
+  assertEquals(1, derivedDerivedCalled);
+
+  class Base2 {
+    constructor(v) {
+      this.fromBase = v;
+    }
