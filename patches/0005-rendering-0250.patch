+}
+
+for (var n in this) {
+  if (n.substr(0, 4) != 'test') {
+    continue;
+  }
+  state = 1;
+  this[n]();
+  if (exception) throw exception;
+  assertEquals(4, state);
+}
+
+// Get rid of the debug event listener.
+Debug.setListener(null);
