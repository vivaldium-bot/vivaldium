+
+//
+// Test thisArg
+//
+(function() {
+  // Test String as a thisArg
+  var index = [1, 2, 3].findIndex(function(val, key) {
+    return this.charAt(Number(key)) === String(val);
+  }, "321");
+  assertEquals(1, index);
