+
+//
+// Test predicate is called for holes
+//
+(function() {
+  var a = new Array(30);
+  a[11] = 21;
+  a[7] = 10;
+  a[29] = 31;
+
+  var count = 0;
+  a.findIndex(function() { count++; return false; });
+  assertEquals(30, count);
+})();
