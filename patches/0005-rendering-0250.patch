+  },
+  getOwnPropertyDescriptor2: function(k) {
+    key = k;
+    return {enumerable: k < "z", configurable: true}
+  },
+})
+
+TestIsEnumerable({
+  getOwnPropertyDescriptor: function(t, k) {
+    key = k;
+    return {get enumerable() { return k < "z" }, configurable: true}
+  },
+})
+
