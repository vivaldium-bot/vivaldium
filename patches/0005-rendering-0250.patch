+
+  gc();
+})();
+
+
+(function() {
+  class A extends RegExp {
+    constructor(...args) {
+      assertFalse(new.target === undefined);
+      super(...args);
+      this.a = 42;
+      this.d = 4.2;
+      this.o = {foo:153};
+    }
+  }
+
+  var o = new A("o(..)h", "g");
+  assertTrue(o instanceof Object);
+  assertTrue(o instanceof RegExp);
+  assertTrue(o instanceof A);
+  assertEquals("object", typeof o);
