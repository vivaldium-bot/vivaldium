+
+
+//
+// Test array modifications
+//
+(function() {
+  var a = [1, 2, 3];
+  a.findIndex(function(val) { a.push(val); return false; });
+  assertArrayEquals([1, 2, 3, 1, 2, 3], a);
+  assertEquals(6, a.length);
+
+  a = [1, 2, 3];
