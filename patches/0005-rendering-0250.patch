+  assertEquals(void 0, O.sum(...[]));
+  assertEquals(void 0, O.sum(...new Set));
+  assertEquals(void 0, O.sum(...(function*() { })()));
+
+  assertEquals("test", O.sum(..."test"));
+  assertEquals(10, O.sum(...[1, 2, 3, 4]));
+  assertEquals(10, O.sum(...[1, 2, 3], 4));
+  assertEquals(10, O.sum(1, ...[2, 3], 4));
