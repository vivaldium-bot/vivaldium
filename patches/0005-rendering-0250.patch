+
+(function testRestrictedPropertiesSloppy() {
+  function* generator() {}
+  assertFalse(generator.hasOwnProperty("arguments"));
+  assertThrows(function() { return generator.arguments; }, TypeError);
+  assertThrows(function() { return generator.arguments = {}; }, TypeError);
