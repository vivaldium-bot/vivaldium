+  assertEquals(O, O.returnThis(..."test"));
+  assertEquals(O, O["returnThis"](..."test"));
+  assertEquals(O.nested, O.nested.returnThis(..."test"));
+  assertEquals(O.nested, O.nested["returnThis"](..."test"));
