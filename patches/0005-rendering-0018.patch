diff --git a/third_party/WebKit/Source/web/tests/data/push_state.html b/third_party/WebKit/Source/web/tests/data/push_state.html
new file mode 100644
index 0000000000000000000000000000000000000000..3e0e985172d712a3b299ea94d0fd6185fccaf2eb
--- /dev/null
+++ b/third_party/WebKit/Source/web/tests/data/push_state.html
@@ -0,0 +1,16 @@
+<body onload="sendXHR()">
+<script>
+// We need to test pushState after the load event has finished.
+// Do so on an XHR callback to ensure that it's after the load event,
+// but WebFrameTest has a pending task to wait for.
+function sendXHR() {
+   var xhr = new XMLHttpRequest();
+   xhr.onreadystatechange = function() {
+       if (xhr.readyState == 4)
+          history.pushState("test", "", "#1");
+   }
+   xhr.open("GET", "push_state.html", true);
+   xhr.send();
+}
+</script>
+</body>
