+    this._selection = dayOrWeekOrMonth;
+    this.calendarTableView.setNeedsUpdateCells(true);
+};
+
+/**
+ * Select the specified date, commit it, and close the popup.
+ * @param {?DateType} dayOrWeekOrMonth
