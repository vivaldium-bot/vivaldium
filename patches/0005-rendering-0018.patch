+    if (!dayOrWeekOrMonth && !this._highlight)
+        return;
+    if (this._highlight && this._highlight.equals(dayOrWeekOrMonth))
+        return;
+    this._highlight = dayOrWeekOrMonth;
+    this.calendarTableView.setNeedsUpdateCells(true);
+};
