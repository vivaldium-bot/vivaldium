+
+void WebViewImpl::setImagesEnabled(const bool images_enabled)
+{
+  // Visibility, boxes are not collapsed.
+  m_webSettings->setImagesEnabled(images_enabled);
+
+  Document* document = m_page->mainFrame()->isLocalFrame() ? m_page->deprecatedLocalMainFrame()->document() : 0;
+
+  if (document) {
+    document->fetcher()->setImagesEnabled(images_enabled);
+
+    // andre@vivaldi.com: Are we sure these are _all_ the images in the document?
+    // seems like some images in certain style classes are not.
+    RefPtrWillBeRawPtr<HTMLCollection> images = document->images();
+    size_t sourceLength = images->length();
+    for (size_t i = 0; i < sourceLength; ++i) {
+        Element* element = images->item(i);
+        if (element) {
+
+          HTMLImageElement& imageElement = toHTMLImageElement(*element);
+
+          if(images_enabled)
+          {
+            imageElement.setAttribute(srcAttr, element->imageSourceURL());
+          }
+          else
+          {
+            SkBitmap bitmap;
+            bitmap.allocN32Pixels(10, 10, true);
+            bitmap.eraseColor(0xFFFFFFFF);
+
+            imageElement.setImageResource(new ImageResource(BitmapImage::create(bitmap).get()));
+          }
+
+        }
+    }
+
+  }
+
+}
