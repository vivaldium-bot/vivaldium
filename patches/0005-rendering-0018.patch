+
+    CompositedDeprecatedPaintLayerMapping* compositedDeprecatedPaintLayerMapping = box->layer()->compositedDeprecatedPaintLayerMapping();
+    ASSERT_TRUE(compositedDeprecatedPaintLayerMapping->hasScrollingLayer());
