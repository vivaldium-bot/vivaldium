diff --git a/third_party/WebKit/Source/web/tests/data/pageserializer/frames/blank_frames.html b/third_party/WebKit/Source/web/tests/data/pageserializer/frames/blank_frames.html
new file mode 100644
index 0000000000000000000000000000000000000000..a4b45b66ee55eb3cab58140ae229e0e9e711e058
--- /dev/null
+++ b/third_party/WebKit/Source/web/tests/data/pageserializer/frames/blank_frames.html
@@ -0,0 +1,36 @@
+<!-- This page is used to test that blank frames with dynamic contents are 
+     correctly serialized by the PageSerializer.
+-->
+<html>
+<script>
+  function onload() {
+    var frame = document.createElement("iframe");
+    var div = document.getElementById("myDiv1");
+    div.appendChild(frame);
+
+    frame.contentDocument.body.innerHTML +=
+      "Some text<br>An image <img src='blue_background.png'.><br><b>Some more text</b>"
+
+    frame = document.createElement("iframe");
+    div = document.getElementById("myDiv2");
+    div.appendChild(frame);
+
+    frame.contentDocument.body.innerHTML +=
+      "Some text<br>An image <img src='red_background.png'.><br><b>Some more text</b>"
+
+    frame = document.createElement("iframe");
+    div = document.getElementById("myDiv3");
+    div.appendChild(frame);
+
+    frame.contentDocument.body.innerHTML +=
+      "Some text<br>An image <img src='orange_background.png'.><br><b>Some more text</b>"
+
+  }
+</script>
+<body onload="onload()">
+  This page creates empty iframes and adds content to them dynamically.<br><br>
+  <div id="myDiv1"></div>
+  <div id="myDiv2"></div>
+  <div id="myDiv3"></div>
+</body>
+</html>
