new file mode 100644
index 0000000000000000000000000000000000000000..5a6399b7826dafb436df2d768b682eed5e33b02f
--- /dev/null
+++ b/third_party/libyuv/util/ssim.cc
@@ -0,0 +1,336 @@
+/*
