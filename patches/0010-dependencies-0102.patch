+#endif  // VPX_VPX_INTEGER_H_
diff --git a/third_party/libvpx_new/source/libvpx/vpx_dsp/arm/avg_neon.c b/third_party/libvpx_new/source/libvpx/vpx_dsp/arm/avg_neon.c
