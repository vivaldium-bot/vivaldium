+DeclarationScope::DeclarationScope(Zone* zone, ScopeType scope_type,
+                                   Handle<ScopeInfo> scope_info)
+    : Scope(zone, scope_type, scope_info),
+      function_kind_(scope_info->function_kind()),
+      params_(0, zone),
