+                                 IntPtrConstant(String::kEmptyHashField),
+                                 MachineType::PointerRepresentation());
+  StoreObjectFieldNoWriteBarrier(result, SlicedString::kParentOffset, parent,
+                                 MachineRepresentation::kTagged);
