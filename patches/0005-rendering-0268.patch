+TF_BUILTIN(MathSign, CodeStubAssembler) {
+  // Convert the {x} value to a Number.
+  Node* x = Parameter(1);
+  Node* context = Parameter(4);
+  Node* x_value = TruncateTaggedToFloat64(context, x);
