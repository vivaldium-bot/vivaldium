+#undef DECLARE_TYPE_ENUM
+
+  void* operator new(size_t size, Zone* zone) { return zone->New(size); }
+
+  NodeType node_type() const { return NodeTypeField::decode(bit_field_); }
+  int position() const { return position_; }
+
+#ifdef DEBUG
