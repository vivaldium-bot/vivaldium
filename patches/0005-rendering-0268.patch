+    case IrOpcode::kChangeInt32ToInt64:
+      return MarkAsWord64(node), VisitChangeInt32ToInt64(node);
+    case IrOpcode::kChangeUint32ToUint64:
+      return MarkAsWord64(node), VisitChangeUint32ToUint64(node);
