+  Node* context = Parameter(2);
+
+  Return(StrictEqual(kDontNegateResult, lhs, rhs, context));
+}
+
+TF_BUILTIN(StrictNotEqual, CodeStubAssembler) {
+  Node* lhs = Parameter(0);
+  Node* rhs = Parameter(1);
+  Node* context = Parameter(2);
+
