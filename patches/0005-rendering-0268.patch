+  // ICs must mirror BytecodeGenerator::VisitClassLiteral.
+  if (FunctionLiteral::NeedsHomeObject(constructor())) {
+    home_object_slot_ = spec->AddStoreICSlot(language_mode);
+  }
+
+  if (NeedsProxySlot()) {
+    proxy_slot_ = spec->AddStoreICSlot(language_mode);
