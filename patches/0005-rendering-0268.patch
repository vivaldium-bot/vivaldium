index 0000000000000000000000000000000000000000..054928db16f8f2613ee24072349b0b141318f61b
--- /dev/null
+++ b/v8/benchmarks/richards.js
@@ -0,0 +1,539 @@
+// Copyright 2006-2008 the V8 project authors. All rights reserved.
