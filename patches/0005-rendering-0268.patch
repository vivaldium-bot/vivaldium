+  bool needsSpace =
+      op == Token::DELETE || op == Token::TYPEOF || op == Token::VOID;
+  Print("(");
+  Print(Token::String(op));
+  if (needsSpace) Print(" ");
+  Find(node->expression(), true);
+  Print(")");
+}
