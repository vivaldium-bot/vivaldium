+      MakeAccessorInfo(name, getter, setter, data, settings, attribute,
+                       signature, is_special_data_property, replace_on_access);
+  if (obj.is_null()) return false;
+  i::ApiNatives::AddNativeDataProperty(isolate, info, obj);
+  return true;
