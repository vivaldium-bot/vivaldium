+}
+
+double CompilerDispatcherTracer::EstimateCompileInMs(
+    size_t ast_size_in_bytes) const {
+  base::LockGuard<base::Mutex> lock(&mutex_);
+  return Estimate(compile_events_, ast_size_in_bytes);
+}
