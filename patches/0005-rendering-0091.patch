-        assert_equals(
-            response.type, options.expected_type,
-            'The response type of response in CacheStorage must match. ' +
-            'URL: ' + options.url);
-        assert_equals(
-            response.redirected, options.expected_redirected,
-            'The redirected flag of response in CacheStorage must match. ' +
