-                  response: response,
-                  originalURL: originalURL
-                });
-              })
-            .catch(function(e) {
-                return Promise.resolve({fetchResult: 'error'});
-              });
-        })
-      .catch(function(e) {
-          return Promise.resolve({fetchResult: 'rejected'});
-        });
-  } catch (e) {
-    return Promise.resolve({fetchResult: 'error'});
-  }
-}
