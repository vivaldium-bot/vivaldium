-          if (event.data.type === 'error') {
-            reject(event.data.reason);
-          }
-
-          resolve();
-        };
-
-      worker.postMessage(
-        {action: action, port: messageChannel.port2},
-        [messageChannel.port2]);
-    });
-}
-
-promise_test(function(t) {
