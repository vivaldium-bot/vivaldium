index 0000000000000000000000000000000000000000..26ae5dfcff268929a8f7ac7af6bd2f8773f14ffa
--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/UnitTesting/GTMUnitTestingBindingTest.m
@@ -0,0 +1,116 @@
+//
+//  GTMUnitTestingBindingTest.m
+//
+//  Copyright 2008 Google Inc.
