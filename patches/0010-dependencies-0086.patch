+-$MidNumLet          = [\p{Word_Break = MidNumLet}];
++# Remove two full stop characters from $MidNumLet and add them to $MidNum
++# to break a hostname into its components at the cost of breaking
++# 'e.g.' and 'i.e.' as well.
