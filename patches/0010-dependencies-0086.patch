+#if GTM_CONTAINERS_VALIDATE && GTM_CONTAINERS_VALIDATION_FAILED_LOG && !GTM_CONTAINERS_VALIDATION_FAILED_ASSERT
+  [GTMUnitTestDevLog expectString:@"nil class"];
+  GTMKindOfClassValidator *validator;
