+// Utility functions for GTMAssert* Macros. Don't use them directly
+// but use the macros below instead
+BOOL GTMIsObjectImageEqualToImageNamed(id object, 
+                                       NSString *filename, 
+                                       NSString **error);
+BOOL GTMIsObjectStateEqualToStateNamed(id object, 
