+  const char *target = (const char *)sqlite3_value_text(argv[1]);
+  if (!pattern || !target) {
+    // COV_NF_START
+    sqlite3_result_error(context,
+                         "LIKE CF implementation missing pattern or value", -1);
+    return;
+    // COV_NF_END
+  }
