+  e = [[filterAway objectEnumerator]
+    gtm_filteredEnumeratorByTarget:target
+             performOnEachSelector:@selector(containsObject:)];
+  STAssertNil([e nextObject],
+              @"shouldn't have gotten anything from first advance of "
+              @"enumerator");
+}
