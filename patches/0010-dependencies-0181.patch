+; IASM-NEXT: .LtestVcvtDoubleToFloat$entry:
+
+  %res = fptrunc double %v to float
+; ASM-NEXT:    vcvt.f32.f64    s0, d0
+; DIS-NEXT:   10:	eeb70bc0
+; IASM-NEXT: 	.byte 0xc0
