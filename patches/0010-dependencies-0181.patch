+; MIPS32-LABEL: testSwitchSmall64
+; MIPS32: 	li	[[REG:.*]],0
+; MIPS32: 	bne	{{.*}},[[REG]],198 <.LtestSwitchSmall64$local$__0>
+; MIPS32: 	nop
+; MIPS32: 	li	[[REG:.*]],123
