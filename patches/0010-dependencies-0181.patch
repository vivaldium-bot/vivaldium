diff --git a/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/struct-arith.pnacl.ll b/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/struct-arith.pnacl.ll
