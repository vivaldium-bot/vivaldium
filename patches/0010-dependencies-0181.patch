+static void AppDevInitFormats(struct AppDev *dev) {
+    VkFormat f;
+
+    for (f = 0; f < VK_FORMAT_RANGE_SIZE; f++) {
+        const VkFormat fmt = f;
+
+        vkGetPhysicalDeviceFormatProperties(dev->gpu->obj, fmt, &dev->format_props[f]);
+    }
+}
