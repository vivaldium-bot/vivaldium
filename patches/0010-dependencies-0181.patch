+; MIPS32: 	move
+; MIPS32: 	move
+; MIPS32: 	move
+; MIPS32: 	jal
+; MIPS32: 	move
+; MIPS32: 	move
+; MIPS32: 	move
+; MIPS32: 	move
+; MIPS32: 	jal
+; MIPS32: 	move
+; MIPS32: 	move
