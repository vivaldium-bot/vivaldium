diff --git a/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/bool-folding.ll b/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/bool-folding.ll
