+  store double %value, double* %__2, align 8
+  ret void
+}
+; CHECK-LABEL: storeDouble
+; CHECK: movsd
+; CHECK: movsd
+
+; MIPS32-LABEL: storeDouble
+; MIPS32: sdc1 $f{{.*}},0{{.*}}
+; MIPS32O2-LABEL: storeDouble
+; MIPS32O2: mtc1 a2,$f{{.*}}
+; MIPS32O2: mtc1 a3,$f{{.*}}
