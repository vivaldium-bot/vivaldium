+; DIS-LABEL: 00000000 <mulAddFloat>:
+
+  %v1 = fmul float %f1, 1.5
+  %v2 = fadd float %f2, %v1
+
+; ASM:  vmla.f32        s21, s20, s22
+; DIS:   10:    ee4aaa0b
+; IASM-NOT: vmla
+
+  ret float %v2
+}
+
+define internal double @mulAddDouble(double %f1, double %f2) {
+; ASM-LABEL: mulAddDouble:
