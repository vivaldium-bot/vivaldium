diff --git a/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/assembler/x86/immediate_encodings.ll b/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/assembler/x86/immediate_encodings.ll
