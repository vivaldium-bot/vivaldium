+; ASM:          ldrexh  r1, [r2]
+; DIS:     84:  e1f21f9f
+; IASM:         .byte 0x9f
+; IASM-NEXT:    .byte 0x1f
+; IASM-NEXT:    .byte 0xf2
+; IASM-NEXT:    .byte 0xe1
+
+; ***** Example of strexh *****
+; ASM:          strexh  r4, r3, [r2]
+; DIS:     8c:  e1e24f93
+; IASM:         .byte 0x93
+; IASM-NEXT:    .byte 0x4f
+; IASM-NEXT:    .byte 0xe2
+; IASM-NEXT:    .byte 0xe1
+
+  %retval = zext i16 %v to i32
+  ret i32 %retval
+}
+
+define internal i32 @testI32Form(i32 %ptr, i32 %a) {
+; ASM-LABEL:testI32Form:
