+  %b = trunc i32 %b.i32 to i8
+  %res = srem i8 %a, %b
+  %res.i32 = zext i8 %res to i32
+  ret i32 %res.i32
+; CHECK-LABEL: srem_i8
+; CHECK: cbw
+; CHECK: idiv
+; MIPS32-LABEL: srem_i8
+; MIPS32: 	div
+; MIPS32: 	teq
+; MIPS32: 	mfhi
+; MIPS32: 	andi	{{.*}},0xff
