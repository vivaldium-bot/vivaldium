+; MIPS32: teq [[REG]],zero,0x7
+; MIPS32: mflo
+
+define internal i32 @Urem(i32 %a, i32 %b) {
+entry:
+  %rem = urem i32 %a, %b
+  ret i32 %rem
+}
+; CHECK-LABEL: Urem
+; CHECK: div e
+;
+; ARM32-LABEL: Urem
+; ARM32: tst [[DENOM:r.*]], [[DENOM]]
+; ARM32: bne
+; ARM32: bl {{.*}} __umodsi3
+; ARM32HWDIV-LABEL: Urem
+; ARM32HWDIV: tst
+; ARM32HWDIV: bne
+; ARM32HWDIV: udiv
+; ARM32HWDIV: mls
+
+; MIPS32-LABEL: Urem
+; MIPS32: divu zero,{{.*}},[[REG:.*]]
