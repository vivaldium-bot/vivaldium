+define internal void @test_far_backward2(i32 %iptr, i32 %val) {
+entry:
+  br label %next
+next:
+  %ptr = inttoptr i32 %iptr to i32*
+  %tmp = call i32 @llvm.nacl.atomic.load.i32(i32* %ptr, i32 6)
+  %tmp2 = call i32 @llvm.nacl.atomic.load.i32(i32* %ptr, i32 6)
