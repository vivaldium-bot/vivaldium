+; CHECK-NOT: and {{.*}},0x1
+; ARM32-LABEL: testZextTrue
+; ARM32: mov{{.*}}, #1
+; ARM32: and {{.*}}, #1
+; MIPS32-LABEL: testZextTrue
+; MIPS32: 	li	{{.*}},1
+; MIPS32: 	andi	{{.*}},0x1
