diff --git a/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/div_legalization.ll b/third_party/swiftshader/third_party/pnacl-subzero/tests_lit/llvm2ice_tests/div_legalization.ll
