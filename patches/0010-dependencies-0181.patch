+  %a0 = mul i32 %idx, 4
+  %a1 = add i32 %a0, %base
+  %a2 = add i32 %a1, %a
+  %a3 = add i32 %a2, 12
+  %a4 = inttoptr i32 %a3 to i32*
+  %b = load i32, i32* %a4, align 1
+  ret i32 %b
