+; CHECK-NEXT:   %v8 = fadd float inf, 0.000000e+00
+
+  ; Generated from -INFINITY in <math.h>
+  %v9 = fadd float 0xFFF0000000000000, 0.0
+; CHECK-NEXT:   %v9 = fadd float -inf, 0.000000e+00
+
+  ; Generated from FLT_MIN in <float.h>
