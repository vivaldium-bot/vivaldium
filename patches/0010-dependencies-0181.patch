+}
+; CHECK-LABEL: test_returning32_arg2
+; CHECK-NEXT: mov eax,{{.*}} [esp+0xc]
+; CHECK-NEXT: ret
+; ARM32-LABEL: test_returning32_arg2
+; ARM32-NEXT: mov r0, r2
+; ARM32-NEXT: bx lr
+; MIPS32-LABEL: test_returning32_arg2
+; MIPS32: move v0,a2
+; MIPS32-NEXT: jr       ra
+
