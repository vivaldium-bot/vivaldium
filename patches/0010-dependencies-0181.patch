+    if m is not None:
+      dest = os.path.join(directory, m.groupdict().get('base') + 'jpg')
+      if os.path.isfile(dest):
+        os.remove(dest)
+      command = 'convert "{0}" -set colorspace sRGB -quality {1:d} "{2}"'.format(file, quality, dest)
