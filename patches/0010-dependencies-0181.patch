+    ASSERT_EQ((uint64_t(-1) & ~Mask##Size) | Value, test.Dst##q())             \
+        << "(" #Dst ", " #Src ", " #Size ")";                                  \
+    reset();                                                                   \
+  } while (0)
+
+#define TestImplRegAddr(Dst, Suffix, Size)                                     \
+  do {                                                                         \
+    const uint32_t T0 = allocateDqword();                                      \
