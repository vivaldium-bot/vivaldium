+
+  %v7 = add i32 -20, 0
+; CHECK-NEXT:   %v7 = add i32 -20, 0
+
+  %v8 = add i64 30, 0
+; CHECK-NEXT:   %v8 = add i64 30, 0
+
+  %v9 = add i64 -30, 0
