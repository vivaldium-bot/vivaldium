+; IASM-NEXT:    .byte 0xb2
+; IASM-NEXT:    .byte 0x30
+; IASM-NEXT:    .byte 0x93
+; IASM-NEXT:    .byte 0xe1
+
+  %ret = sext i16 %v16 to i32
+  ret i32 %ret
+}
