+    vkGetPhysicalDeviceProperties(demo->gpu, &demo->gpu_props);
+
+    /* Call with NULL data to get count */
+    vkGetPhysicalDeviceQueueFamilyProperties(demo->gpu,
+                                             &demo->queue_family_count, NULL);
+    assert(demo->queue_family_count >= 1);
