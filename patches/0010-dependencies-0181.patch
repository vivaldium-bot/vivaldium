+    static constexpr bool IsDouble = FloatSize == 64;                          \
+    using Type = std::conditional<IsDouble, double, float>::type;              \
+    const uint32_t T0 = allocateQword();                                       \
+    const Type V0 = Value0;                                                    \
+    const uint32_t T1 = allocateQword();                                       \
+    const Type V1 = Value1;                                                    \
