+; CHECK: movss
+
+; MIPS32-LABEL: storeFloatConst
+; MIPS32: lui {{.*}},{{.*}}
+; MIPS32: lwc1 $f{{.*}},{{.*}}
+; MIPS32: swc1 $f{{.*}},0{{.*}}
