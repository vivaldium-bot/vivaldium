+; RUN:    -nop-insertion-percentage=90 -max-nops-per-instruction=1 \
+; RUN:    | FileCheck %s --check-prefix=PROB90
+; RUN: %p2i -i %s --filetype=asm -a -sz-seed=1 -nop-insertion \
