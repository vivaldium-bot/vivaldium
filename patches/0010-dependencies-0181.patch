+; IASM-NEXT:    .byte 0x1f
+; IASM-NEXT:    .byte 0x92
+; IASM-NEXT:    .byte 0xe1
+
+; ***** Example of strex *****
+; ASM:          strex   r4, r3, [r2]
+; DIS:     e4:  e1824f93
+; IASM:         .byte 0x93
+; IASM-NEXT:    .byte 0x4f
+; IASM-NEXT:    .byte 0x82
+; IASM-NEXT:    .byte 0xe1
+
+  ret i32 %v
+}
