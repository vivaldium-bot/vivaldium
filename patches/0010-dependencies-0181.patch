+  %gep3.i16ptr = inttoptr i32 %gep3 to i16*
+  %v16 = load i16, i16* %gep3.i16ptr, align 1
+
+; ASM-NEXT:     add     r3, r3, #4
+; DIS-NEXT:  1c:        e2833004
+; IASM-NEXT:    .byte 0x4
+; IASM-NEXT:    .byte 0x30
+; IASM-NEXT:    .byte 0x83
+; IASM-NEXT:    .byte 0xe2
