+
+  %v5 = fsub double undef, 6.000000e+00
+; CHECK-NEXT:   %v5 = fsub double undef, 6.000000e+00
+
+  ; Test special floating point constants. Note: LLVM assembly appears
+  ; to use 64-bit integer constants for both float and double.
