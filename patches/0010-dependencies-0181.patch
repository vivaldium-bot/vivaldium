+  store i32 %v1, i32* %Len.asptr3, align 1
+
+; ASM-NEXT:     str     r4, [r1]
+; DIS-NEXT:  18:        e5814000
+; IASM-NEXT:    .byte 0x0
+; IASM-NEXT:    .byte 0x40
+; IASM-NEXT:    .byte 0x81
+; IASM-NEXT:    .byte 0xe5
+
