+void main(void) {
+    vec4 pos        = gtf_ModelViewMatrix * gtf_Vertex_Color;
+    Position        = vec3(gtf_Vertex);
+    vec3 tnorm      = normalize(gtf_NormalMatrix * gtf_Normal);
+    vec3 lightVec   = normalize(LightPosition - vec3(pos));
