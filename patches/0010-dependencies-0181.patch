+; DIS-LABEL:<testI64Form>:
+; IASM-LABEL:testI64Form:
+
+entry:
+  %ptr.asptr = inttoptr i32 %ptr to i64*
+  %v = call i64 @llvm.nacl.atomic.rmw.i64(i32 1, i64* %ptr.asptr,
+                                          i64 %a, i32 6)
+
+; ***** Example of ldrexd *****
+; ASM:          ldrexd  r4, r5, [r6]
+; DIS:     13c: e1b64f9f
+; IASM:         .byte 0x9f
+; IASM-NEXT:    .byte 0x4f
+; IASM-NEXT:    .byte 0xb6
+; IASM-NEXT:    .byte 0xe1
+
+; ***** Example of strexd *****
+; ASM:          strexd  r4, r0, r1, [r6]
+; DIS:     158: e1a64f90
+; IASM:         .byte 0x90
+; IASM-NEXT:    .byte 0x4f
+; IASM-NEXT:    .byte 0xa6
+; IASM-NEXT:    .byte 0xe1
+
+  ret i64 %v
+}
