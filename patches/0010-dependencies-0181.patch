+  %call = call i32 @ignore64BitArgNoInline(i64 %a, i32 123, i64 %b)
+  %call1 = call i32 @ignore64BitArgNoInline(i64 %c, i32 123, i64 %d)
+  %call2 = call i32 @ignore64BitArgNoInline(i64 %e, i32 123, i64 %f)
