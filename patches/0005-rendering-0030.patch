-
-            function testPassed(msg)
-            {
-                debug('<span class="pass">PASS</span> ' + msg + '</span>');
-            }
-
-            function testFailed(msg)
-            {
-                debug('<span class="fail">FAIL</span> ' + msg + '</span>');
-            }
-
-            function testEquals(a, b)
-            {
-                if (a == b) {
-                    testPassed(escapeHTML(a) + " <b>is</b> " + escapeHTML(b));
