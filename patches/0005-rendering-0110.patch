-shouldBe('valueAsNumberFor("nan")', '50');
-shouldBe('valueAsNumberFor("Inf")', '50');
-shouldBe('valueAsNumberFor("inf")', '50');
-shouldBe('valueAsNumberFor("Infinity")', '50');
-shouldBe('valueAsNumberFor("infinity")', '50');
-
-debug('Too huge exponent to support');
-shouldBe('valueAsNumberFor("1.2E65535")', '50');
