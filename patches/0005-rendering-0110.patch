-  +
-      0px : padding-left
-  +
-      0px : border-left-width
-  +
-      0px : margin-left
-  +
-  (solve) : left: auto
-    =====================
-    320px : width of containing block
-
-gives us:
-
-     80px : right: auto: set to static position
-  +
-      0px : margin-right
-  +
-      0px : border-right-width
-  +
-      0px : padding-right
-  +
