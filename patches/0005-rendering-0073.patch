-<!doctype html>
-<meta charset=utf-8>
-<meta name="timeout" content="long">
-<title>Cross-origin behavior of Window and Location</title>
-<link rel="author" title="Bobby Holley (:bholley)" href="bobbyholley@gmail.com">
