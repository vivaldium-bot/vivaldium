index 0000000000000000000000000000000000000000..3eba5b13cae1bfe0965847422687d80e59fb3175
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_atom_sampler.c
@@ -0,0 +1,290 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
