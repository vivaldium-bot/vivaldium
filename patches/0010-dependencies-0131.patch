diff --git a/third_party/minizip/src/CMakeLists.txt b/third_party/minizip/src/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..cfd91b10f8a2081a84c598693c3b1f619245f906
--- /dev/null
