diff --git a/third_party/openh264/src/build/platform-ios.mk b/third_party/openh264/src/build/platform-ios.mk
new file mode 100644
index 0000000000000000000000000000000000000000..f04b5c5df9d643385577ac156aa9d343d46ee227
--- /dev/null
+++ b/third_party/openh264/src/build/platform-ios.mk
@@ -0,0 +1,15 @@
+ARCH = armv7
+include $(SRC_PATH)build/platform-darwin.mk
+CXX = clang++
+CC = clang
+ifneq ($(filter %86 x86_64, $(ARCH)),)
+SDKTYPE = iPhoneSimulator
+else
+SDKTYPE = iPhoneOS
+endif
+SDK_MIN = 5.1
+
+SDKROOT := $(shell xcrun --sdk $(shell echo $(SDKTYPE) | tr A-Z a-z) --show-sdk-path)
+CFLAGS += -arch $(ARCH) -isysroot $(SDKROOT) -miphoneos-version-min=$(SDK_MIN) -DAPPLE_IOS -fembed-bitcode
+LDFLAGS += -arch $(ARCH) -isysroot $(SDKROOT) -miphoneos-version-min=$(SDK_MIN)
+
