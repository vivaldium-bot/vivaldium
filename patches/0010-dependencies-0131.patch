index 0000000000000000000000000000000000000000..5abd5a25de5c080a197d3cc8e87e4799a7ff929f
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/x86-64/xform4.S
@@ -0,0 +1,483 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
