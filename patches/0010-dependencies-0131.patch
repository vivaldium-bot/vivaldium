+    {
+        if (diskFilename[i] != _T('.')) 
+            continue;
+        _sntprintf(&diskFilename[i], iowin->filenameLength - i, _T(".z%02d"), number_disk + 1);
+        break;
+    }
+    if (i >= 0)
+        ret = win32_open_file_func(opaque, (char*)diskFilename, mode);
