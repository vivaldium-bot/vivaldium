index 0000000000000000000000000000000000000000..8791630a43bddca611873b0710003266d9f162f5
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_logic.c
@@ -0,0 +1,218 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5.2
+ *
