index 0000000000000000000000000000000000000000..2b971bb45719a2d7f49f550e0718a2f4d4604bea
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_texcombine.c
@@ -0,0 +1,791 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.5
+ *
+ * Copyright (C) 1999-2008  Brian Paul   All Rights Reserved.
+ * Copyright (C) 2009  VMware, Inc.   All Rights Reserved.
