+/**
+ * Is the given dispatch table using the no-op functions?
+ */
+GLboolean
+_mesa_using_noop_vtxfmt(const struct _glapi_table *dispatch)
+{
+   return GET_Begin((struct _glapi_table *) dispatch) == _mesa_noop_Begin;
+}
