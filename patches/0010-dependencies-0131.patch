index 0000000000000000000000000000000000000000..cbd8dfc967f9b17bf6e2391a71217cebabcbfd9e
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/tnl/t_vb_fog.c
@@ -0,0 +1,276 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  6.5
