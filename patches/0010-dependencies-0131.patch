index 0000000000000000000000000000000000000000..980725ef5184dd4c0047b941121bcebfce62df05
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/x86/x86_xform2.S
@@ -0,0 +1,574 @@
+
+/*
+ * Mesa 3-D graphics library
+ * Version:  3.5
+ *
+ * Copyright (C) 1999-2001  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
