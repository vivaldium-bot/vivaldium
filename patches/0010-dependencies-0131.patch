index 0000000000000000000000000000000000000000..00f92d463c33f1626313b4d47d94e56dd4c7af98
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_feedback.c
@@ -0,0 +1,138 @@
+/*
