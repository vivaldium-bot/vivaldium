index 0000000000000000000000000000000000000000..cf9feb86f2aba9137a1689e2813b498e3fbe7b58
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/swrast/s_zoom.c
@@ -0,0 +1,450 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
