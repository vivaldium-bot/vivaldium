index 0000000000000000000000000000000000000000..9b85a39beddf62ca0e94d9caf020f48620ce05d4
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/state_tracker/st_cb_feedback.c
@@ -0,0 +1,309 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ * 
