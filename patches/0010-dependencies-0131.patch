+#ifndef UTIL_H
+#define UTIL_H
+
+#define MAX(A, B) ((A) > (B) ? (A) : (B))
+#define ARRAY_SIZE(A) (sizeof(A) / sizeof(*(A)))
+#define PUBLIC __attribute__((visibility("default")))
