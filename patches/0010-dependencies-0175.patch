+
+    switch (intn->type) {
+        case INTNUM_L:
+            n->val.l = intn->val.l;
+            break;
+        case INTNUM_BV:
+            n->val.bv = BitVector_Clone(intn->val.bv);
+            break;
+    }
+    n->type = intn->type;
+
+    return n;
+}
