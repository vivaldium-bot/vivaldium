+#
+mm0,	REG,	X86_MMXREG,	0,	0
+mm1,	REG,	X86_MMXREG,	1,	0
+mm2,	REG,	X86_MMXREG,	2,	0
+mm3,	REG,	X86_MMXREG,	3,	0
