diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/extractelement-shuffle.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/extractelement-shuffle.ll
new file mode 100644
index 0000000000000000000000000000000000000000..d1ba9a845800df3f960eee7e1afcd7d15d7f7472
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/extractelement-shuffle.ll
@@ -0,0 +1,13 @@
+; RUN: llc < %s
+
+; Examples that exhibits a bug in DAGCombine.  The case is triggered by the
+; following program.  The bug is DAGCombine assumes that the bit convert
+; preserves the number of elements so the optimization code tries to read
+; through the 3rd mask element, which doesn't exist.
+define i32 @update(<2 x i64> %val1, <2 x i64> %val2) nounwind readnone {
+entry:
+	%shuf = shufflevector <2 x i64> %val1, <2 x i64> %val2, <2 x i32> <i32 0, i32 3>
+	%bit  = bitcast <2 x i64> %shuf to <4 x i32>
+	%res =  extractelement <4 x i32> %bit, i32 3
+	ret i32 %res
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/extractps.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/extractps.ll
