diff --git a/third_party/yasm/source/patched-yasm/libyasm/preproc.h b/third_party/yasm/source/patched-yasm/libyasm/preproc.h
new file mode 100644
index 0000000000000000000000000000000000000000..751b19e4b0a893e568919fc3036e6ce38a9f7519
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/preproc.h
@@ -0,0 +1,210 @@
+/**
+ * \file libyasm/preproc.h
