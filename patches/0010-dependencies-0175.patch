+#
+xmm0,	REG,	X86_XMMREG,	0,	0
+xmm1,	REG,	X86_XMMREG,	1,	0
+xmm2,	REG,	X86_XMMREG,	2,	0
+xmm3,	REG,	X86_XMMREG,	3,	0
+xmm4,	REG,	X86_XMMREG,	4,	0
+xmm5,	REG,	X86_XMMREG,	5,	0
+xmm6,	REG,	X86_XMMREG,	6,	0
