+tr7,	REG,	X86_TRREG,	7,	0
+#
+# floating point, MMX, and SSE/SSE2 registers
+#
+st0,	REG,	X86_FPUREG,	0,	0
+st1,	REG,	X86_FPUREG,	1,	0
