index 0000000000000000000000000000000000000000..20b99986234ff18ff34e2a0edc333a8c4fbcdc30
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/fast-cc-callee-pops.ll
@@ -0,0 +1,13 @@
+; RUN: llc < %s -march=x86 -x86-asm-syntax=intel -mcpu=yonah | FileCheck %s
+
+; Check that a fastcc function pops its stack variables before returning.
+
