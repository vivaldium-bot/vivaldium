diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2011-03-09-Physreg-Coalescing.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2011-03-09-Physreg-Coalescing.ll
