+declare void @func_12(i32, i8 zeroext)
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/force-align-stack.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/force-align-stack.ll
