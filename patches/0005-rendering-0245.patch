-        <div style="height:100px;">&nbsp;</div>
-        <iframe width="600" height="368" src="test.swf" frameborder="0" allowfullscreen></iframe>
-        <div style="height:100px;">&nbsp;</div>
-    </div>
-    <div style="height:300px;">&nbsp;</div>
-<br clear="all">
-</body>
-
-</html>
