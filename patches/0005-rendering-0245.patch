+
+  __ movp(kScratchRegister,
+          FieldOperand(view, JSArrayBufferView::kBufferOffset));
+  __ testb(FieldOperand(kScratchRegister, JSArrayBuffer::kBitFieldOffset),
+           Immediate(1 << JSArrayBuffer::WasNeutered::kShift));
