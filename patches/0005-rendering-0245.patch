+
+const char* Builtins::Lookup(byte* pc) {
+  // may be called during initialization (disassembler!)
+  if (initialized_) {
+    for (int i = 0; i < builtin_count; i++) {
+      Code* entry = Code::cast(builtins_[i]);
+      if (entry->contains(pc)) {
+        return names_[i];
+      }
+    }
+  }
+  return NULL;
+}
