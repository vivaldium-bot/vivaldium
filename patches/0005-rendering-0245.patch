+void InstructionSelector::VisitInt64Sub(Node* node) {
+  X64OperandGenerator g(this);
+  Int64BinopMatcher m(node);
+  if (m.left().Is(0)) {
+    Emit(kX64Neg, g.DefineSameAsFirst(node), g.UseRegister(m.right().node()));
+  } else {
+    VisitBinop(this, node, kX64Sub);
+  }
+}
