-
-        gainSrc.start();
-
-        var startTime = context.currentTime;
-        src.onended = function () {
-          log("Rate variable test ended at " + (context.currentTime - startTime) + " sec");
-        }
-
-        src.start();
-      }
-
-      function log(message) {
