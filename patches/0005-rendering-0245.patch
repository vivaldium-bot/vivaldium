-    pointer-events: none;
-    background: #8ff;
-  }
-
-  #c:hover {
-    background: green;
-  }
-
-  #d {
-    pointer-events: none;
-    background: #88f;
-  }
-
-  #d span {
-    pointer-events: auto;
-    padding: 0 10px;
-    background: #8ff;
-  }
-
-  #d:hover {
-    background: gray;
-  }
-
-  #e {
-    padding: 10px;
-    pointer-events: none;
-    background: #88f;
-  }
-
-  #e div {
-    pointer-events: auto;
-    background: #8ff;
-  }
-
-  #e:hover {
-    background: gray;
-  }
-
-  #e div:hover {
-    background: green;
-  }
-
-  #f, #g, #h, #i, #k, #m {
-    padding: 10px;
-    background: #88f;
-  }
-
-  #f {
-    pointer-events: auto;
-  }
-  
-  #f:hover {
-    background: green;
-  }
