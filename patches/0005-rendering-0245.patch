-  <style type="text/css" media="screen">
-  #a {
-    pointer-events: auto;
-    background: #88f;
-  }
-
-  #a:hover {
-    background: green;
-  }
-  
-  #b {
-    pointer-events: none;
-    background: #88f;
-  }
-  
