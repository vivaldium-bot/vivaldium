+HBasicBlock* HOptimizedGraphBuilder::CreateJoin(HBasicBlock* first,
+                                                HBasicBlock* second,
+                                                BailoutId join_id) {
+  if (first == NULL) {
+    return second;
+  } else if (second == NULL) {
+    return first;
+  } else {
+    HBasicBlock* join_block = graph()->CreateBasicBlock();
+    Goto(first, join_block);
+    Goto(second, join_block);
+    join_block->SetJoinId(join_id);
+    return join_block;
+  }
+}
