-  switch (type) {
-    case gl.BYTE:
-    case gl.UNSIGNED_BYTE:
-      return 1;
-    case gl.SHORT:
-    case gl.UNSIGNED_SHORT:
-    case gl.UNSIGNED_SHORT_5_6_5:
-    case gl.UNSIGNED_SHORT_4_4_4_4:
-    case gl.UNSIGNED_SHORT_5_5_5_1:
-      return 2;
-    case gl.INT:
-    case gl.UNSIGNED_INT:
-      return 4;
-    default:
-      throw 'unknown gl type ' + glEnumToString(gl, type);
-  }
