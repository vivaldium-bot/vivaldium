-var createGLErrorWrapper = function(context, fname) {
-  return function() {
-    var rv = context[fname].apply(context, arguments);
-    var err = context.getError();
-    if (err != 0)
-      throw "GL error " + getGLErrorAsString(err) + " in " + fname;
-    return rv;
