-
-        consoleWrite("EVENT(" + eventName + ")");
-
-        if (func)
-            func(event);
-        
-        if (endit)
-            endTest();    
-    }
-
-    element.addEventListener(eventName, _eventCallback);
-}
-
-function waitForEventAndTest(element, eventName, testFuncString, endit)
-{
-    function _eventCallback(event)
