+      return str +
+          tr.model.source_info.SourceInfo.prototype.toString.call(this);
+    }
+  };
+
+  const JSSourceState = {
+    COMPILED: 'compiled',
+    OPTIMIZABLE: 'optimizable',
+    OPTIMIZED: 'optimized',
