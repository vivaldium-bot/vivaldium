+      id: event.id,
+      start: event.start,
+      end: event.end,
+      startSlice: frame,
+      endSlice: frame
+    }));
+  }
+
+  test('empty', function() {
+    const verifier = new UserExpectationVerifier();
+    verifier.customizeModelCallback = function(model) {
+    };
