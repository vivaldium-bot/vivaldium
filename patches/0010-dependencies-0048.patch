+    kwargs.setdefault('SIGTERM_TIMEOUT', 0.1)
+    kwargs.setdefault('PRINT_INTERVAL', 0.01)
+    kwargs.setdefault('GDB_COMMANDS', ('detach',))
+
+    ex_str = None
+    with mock.patch.multiple(parallel._BackgroundTask, **kwargs):
