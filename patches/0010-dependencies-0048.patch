+    else:
+      runcmd = cros_build_lib.RunCommand
+    with self._MockChecker(real_cmd, ignore_sigint=rc_kv.get('ignore_sigint'),
+                           **sp_kv):
+      actual_result = runcmd(cmd, **rc_kv)
+
+    self._AssertCrEqual(expected_result, actual_result)
