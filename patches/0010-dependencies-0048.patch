+FAKE_PATH = '/imaginary/file'
+LOOP_DEV = '/dev/loop9999'
+LOOP_PARTS_DICT = {num: '%sp%d' % (LOOP_DEV, num) for num in range(1, 13)}
+LOOP_PARTS_LIST = LOOP_PARTS_DICT.values()
