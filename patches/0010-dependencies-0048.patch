+  },
+
+  set selection(selection) {
+    this.currentSelection_ = selection;
+    this.updateContents_();
+  },
+
+  updateContents_() {
+    if (this.selection.length !== 1) {
+      throw new Error('Cannot pass multiple samples to sample table.');
+    }
