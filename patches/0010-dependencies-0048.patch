+    self.assertRaises(gerrit.GerritException, gerrit.GetGerritPatchInfo,
+                      changeids)
+    self.assertRaises(gerrit.GerritException, gerrit.GetGerritPatchInfo,
+                      ['*' + cid for cid in changeids])
+    # Change ID sequence starts at 1000.
