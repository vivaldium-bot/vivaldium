+  source_root = path = os.path.realpath(os.path.join(
+      os.path.abspath(__file__), '..', '..', '..'))
+  while True:
+    if os.path.isdir(os.path.join(path, '.repo')):
+      return path
+    elif path == '/':
+      break
+    path = os.path.dirname(path)
+  return source_root
