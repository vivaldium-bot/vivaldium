+    """Test case where GS path correction is not needed."""
+    gs_path = '%s/%s' % (gs.BASE_GS_URL, self.GS_REL_PATH)
+    self._RunGSPathTestCase(gs_path, gs_path)
+
+  def testTrailingSlashRemoval(self):
+    """Test case where GS path ends with /."""
+    gs_path = '%s/%s/' % (gs.BASE_GS_URL, self.GS_REL_PATH)
