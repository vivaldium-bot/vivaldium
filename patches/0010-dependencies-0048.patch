+
+  def testEvents(self):
+    with self.log.Event():
+      pass
+
+    self.assertDictEqual(self.emitEvent, self.get_event_from_file())
+
+  def testEventFail(self):
+    with self.log.Event():
+      raise ce.Failure("always fail")
+
+    self.assertDictEqual(self.emitEvent, self.get_event_from_file())
