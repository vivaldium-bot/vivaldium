+        "'a\tb'": 'a\tb',
+        "'/a$file'": '/a$file',
+        "'/a#file'": '/a#file',
+        """'b"c'""": 'b"c',
+        "'a@()b'": 'a@()b',
+        'j%k': 'j%k',
+        r'''"s'a\$va\\rs"''': r"s'a$va\rs",
+        r'''"\\'\\\""''': r'''\'\"''',
+        r'''"'\\\$"''': r"""'\$""",
+    }
+
+    # Expected input output specific to ShellUnquote. This string cannot be
+    # produced by ShellQuote but is still a valid bash escaped string.
+    tests_unquote = {
+        r'''\$''': r'''"\\$"''',
+    }
+
+    def aux(s):
