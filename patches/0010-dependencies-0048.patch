+""")
+    self.assertEquals('text/pem/cert',
+                      filetype.FileTypeDecoder.DecodeFile(some_cert))
+
+    # A RSA private key (sample from vboot_reference unittest).
+    rsa_key = os.path.join(self.tempdir, 'rsa_key')
