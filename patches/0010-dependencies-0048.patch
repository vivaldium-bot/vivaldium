+
+  def testChecksForAtLeastOneExecutable(self):
+    """Check that we'll throw up on manifests that don't name an executable."""
+    with self.assertRaises(ValueError):
+      self._generator.GetSandboxSpec({u'apps': []}, SANDBOX_NAME)
