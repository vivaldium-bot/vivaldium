+      result = cros_build_lib.RunCommand(['cat'], input=f.fileno())
+      self.assertEqual(result.output, '')
+
+    with open(__file__) as f:
+      result = cros_build_lib.RunCommand(['cat'], input=f.fileno())
+      self.assertEqual(result.output, osutils.ReadFile(__file__))
