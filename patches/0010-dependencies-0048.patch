+  """
+  # pylint: disable=dangerous-default-value
+  def __init__(self, path='/dev/loop9999', dev=None,
+               part_count=None, part_overrides={}):
+    self.path = path
+    self.dev = dev
+    self.parts = {}
+    for i in xrange(part_count):
