+class TestCreateGroups(cros_test_lib.TestCase):
+  """Unittests for creating groups."""
+
+  def _CrosSdk(self):
+    cmd = ['cros_sdk', '--', 'sleep', '0.001']
+    cros_build_lib.RunCommand(cmd)
