+  def _ChooseReviewers(self):
+    all_reviewers = set(['dborowitz@google.com', 'sop@google.com',
+                         'jrn@google.com'])
+    ret = list(all_reviewers.difference(['%s@google.com' % getpass.getuser()]))
+    self.assertGreaterEqual(len(ret), 2)
+    return ret
