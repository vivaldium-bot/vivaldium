+    vshr.u64        d5, d4, #8
+
+    vmov            q3, q1              //b::[0:7]+b::[1~8]
+    vtrn.32     q0, q1              //d0{a::[0:3]+b::[0:3]}; d1{a::[1:4]+b::[1:4]}
+    vtrn.32     q3, q2              //d6{b::[0:3]+c::[0:3]}; d7{b::[1:4]+c::[1:4]}
+
+    vmull.u8        q1, d0, d28         //(src[x] * A)
