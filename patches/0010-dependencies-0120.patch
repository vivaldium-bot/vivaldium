+    vmlal.u8        q3, d1, d29         //+=(src[x+1] * B)
+    vmlal.u8        q3, d2, d30         //+=(src[x+stride] * C)
+    vmlal.u8        q3, d3, d31         //+=(src[x+stride+1] * D)
