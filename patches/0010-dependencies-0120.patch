+GPUSink::GPUSink(GrContextFactory::GLContextType ct,
+                 GrGLStandard api,
+                 int samples,
+                 bool dfText,
+                 bool threaded)
+    : fContextType(ct)
+    , fGpuAPI(api)
+    , fSampleCount(samples)
+    , fUseDFText(dfText)
