+enum Flags {
+    kStroke_Flag = 1 << 0,
+    kBig_Flag    = 1 << 1
+};
+
+#define FLAGS00  Flags(0)
+#define FLAGS01  Flags(kStroke_Flag)
+#define FLAGS10  Flags(kBig_Flag)
+#define FLAGS11  Flags(kStroke_Flag | kBig_Flag)
