diff --git a/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_ocsprequest.c b/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_ocsprequest.c
