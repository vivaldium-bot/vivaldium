diff --git a/third_party/nss/nss/lib/libpkix/pkix_pl_nss/module/pkix_pl_ldaptemplates.c b/third_party/nss/nss/lib/libpkix/pkix_pl_nss/module/pkix_pl_ldaptemplates.c
