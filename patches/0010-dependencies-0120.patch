+
+    if (!dict->hasData(SkPdfNativeObject::kFont_Data)) {
+        dict->setData(fontFromPdfDictionaryOnce(doc, dict), SkPdfNativeObject::kFont_Data);
+    }
+    return (SkPdfFont*)dict->data(SkPdfNativeObject::kFont_Data);
