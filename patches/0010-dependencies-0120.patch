+
+#endif /* _PKIX_PL_CRLENTRY_H */
diff --git a/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_date.c b/third_party/nss/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_date.c
