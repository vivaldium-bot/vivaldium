+    size_t outLength = readNameLength(start, end);
+    unsigned char* out = (unsigned char*)allocator->alloc(outLength);
+    const unsigned char* now = readName(start, end, out);
+    SkPdfNativeObject::makeName(out, out + outLength, name);
