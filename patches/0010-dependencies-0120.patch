+SkPdfInteger* SkPdfNativeDoc::createInteger(int value) const {
+    SkPdfNativeObject* obj = fAllocator->allocObject();
+    SkPdfNativeObject::makeInteger(value, obj);
+    TRACK_OBJECT_SRC(obj);
+    return (SkPdfInteger*)obj;
+}
