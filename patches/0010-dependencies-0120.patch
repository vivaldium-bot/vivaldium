+void SkDebuggerGUI::setupDirectoryWidget(const QString& path) {
+    fPath = path;
+    QDir dir(path);
+    QRegExp r(".skp");
+    fDirectoryWidget.clear();
+    const QStringList files = dir.entryList();
+    foreach (QString f, files) {
+        if (f.contains(r))
+            fDirectoryWidget.addItem(f);
+    }
+}
