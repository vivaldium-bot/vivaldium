diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-18-DeadBlockProblem.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-18-DeadBlockProblem.ll
new file mode 100644
index 0000000000000000000000000000000000000000..55ea11a5d7421da1c9bec232f26b491bbc6fbf3d
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-18-DeadBlockProblem.ll
@@ -0,0 +1,16 @@
+; This testcases makes sure that mem2reg can handle unreachable blocks.
+; RUN: opt < %s -mem2reg
+
+define i32 @test() {
+	%X = alloca i32		; <i32*> [#uses=2]
+	store i32 6, i32* %X
+	br label %Loop
+Loop:		; preds = %EndOfLoop, %0
+	store i32 5, i32* %X
+	br label %EndOfLoop
+Unreachable:		; No predecessors!
+	br label %EndOfLoop
+EndOfLoop:		; preds = %Unreachable, %Loop
+	br label %Loop
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-24-MultipleIdenticalSuccessors.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-24-MultipleIdenticalSuccessors.ll
