+    // Get the server info and update sample_rate_hz_
+    paOperation = LATE(pa_context_get_server_info)(_paContext,
+                                                   PaServerInfoCallback,
+                                                   this);
+
+    WaitForOperationCompletion(paOperation);
+
+    PaUnLock();
