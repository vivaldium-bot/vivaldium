+  // -- No stream parameters --
+  EXPECT_EQ(apm_->kNoError,
+            AnalyzeReverseStreamChooser(format));
+  EXPECT_EQ(apm_->kStreamParameterNotSetError,
+            ProcessStreamChooser(format));
