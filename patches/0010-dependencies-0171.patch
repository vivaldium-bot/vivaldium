index 0000000000000000000000000000000000000000..bb260c1593a1b875600d970f8f09970bcff8c5be
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-04-24-MultipleIdenticalSuccessors.ll
@@ -0,0 +1,16 @@
+; Mem2reg used to only add one incoming value to a PHI node, even if it had
+; multiple incoming edges from a block.
+;
+; RUN: opt < %s -mem2reg -disable-output
+
+define i32 @test(i1 %c1, i1 %c2) {
+	%X = alloca i32		; <i32*> [#uses=2]
+	br i1 %c1, label %Exit, label %B2
+B2:		; preds = %0
+	store i32 2, i32* %X
+	br i1 %c2, label %Exit, label %Exit
+Exit:		; preds = %B2, %B2, %0
+	%Y = load i32* %X		; <i32> [#uses=1]
+	ret i32 %Y
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-06-26-IterativePromote.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-06-26-IterativePromote.ll
