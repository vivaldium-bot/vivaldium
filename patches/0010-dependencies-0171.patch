+        // Normalize denormalized values prior to conversion.
+        while (!deMath.binaryOp(m, deMath.shiftLeft(1, otherMantissaBits), deMath.BinaryOp.AND)) {
+            m = deMath.shiftLeft(m, 1);
+            e -= 1;
+        }
