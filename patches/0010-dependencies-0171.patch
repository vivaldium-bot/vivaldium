+#endif  // WEBRTC_MODULES_AUDIO_PROCESSING_UTILITY_BLOCK_MEAN_CALCULATOR_H_
diff --git a/third_party/webrtc/modules/audio_processing/utility/block_mean_calculator_unittest.cc b/third_party/webrtc/modules/audio_processing/utility/block_mean_calculator_unittest.cc
