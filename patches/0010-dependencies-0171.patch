+        WEBRTC_TRACE(kTraceError, kTraceAudioDevice, _id,
+                     "  failed to activate playout");
+        return -1;
+    }
+
+    {
+        CriticalSectionScoped lock(&_critSect);
+        if (_playing)
+        {
+            // The playing state is set by the audio thread after playout
+            // has started.
+        } else
+        {
+            WEBRTC_TRACE(kTraceError, kTraceAudioDevice, _id,
+                         "  failed to activate playing");
+            return -1;
+        }
+    }
+
+    return 0;
