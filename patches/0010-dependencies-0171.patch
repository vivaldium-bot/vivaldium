diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyLibCalls/pow-to-sqrt.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyLibCalls/pow-to-sqrt.ll
