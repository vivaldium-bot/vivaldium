diff --git a/third_party/webrtc/modules/desktop_capture/cropping_window_capturer.cc b/third_party/webrtc/modules/desktop_capture/cropping_window_capturer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0dd564f17058da883a53cea2a6e622a2def7153f
--- /dev/null
