+  RTC_DCHECK(thread_checker_.CalledOnValidThread());
+  if (!rec_is_initialized_ || !recording_) {
+    return 0;
+  }
+  if (!playing_) {
+    ShutdownPlayOrRecord();
+  }
+  rec_is_initialized_ = false;
+  rtc::AtomicOps::ReleaseStore(&recording_, 0);
+  return 0;
