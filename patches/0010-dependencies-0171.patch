+    if (res != MMSYSERR_NOERROR)
+    {
+        WEBRTC_TRACE(kTraceWarning, kTraceAudioDevice, _id, "mixerGetLineControls(MIXER_GETLINECONTROLSF_ONEBYID) failed (err=%d)", res);
+        return false;
+    }
+
+    return true;
+}
