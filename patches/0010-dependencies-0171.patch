+    var offset = y * this.stride + x * this.pixelSize;
+    return ((this.data[offset] & 0xff) << 24) +
+        ((this.data[offset + 1] & 0xff) << 16) +
+        ((this.data[offset + 2] & 0xff) << 8) +
+        (this.data[offset + 3] & 0xff);
+};
