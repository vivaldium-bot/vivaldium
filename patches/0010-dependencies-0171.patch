+int32_t AudioMixerManagerMac::Close() {
+  WEBRTC_TRACE(kTraceInfo, kTraceAudioDevice, _id, "%s", __FUNCTION__);
+
+  CriticalSectionScoped lock(&_critSect);
+
+  CloseSpeaker();
+  CloseMicrophone();
+
+  return 0;
+}
