+  RembFeedback* feedback = new RembFeedback(0, 0, 0, 512000, RTCPReportBlock());
+  Packets packets;
+  packets.push_back(feedback);
+  sender.RunFor(0, &packets);
+  EXPECT_EQ(512000u, source.bits_per_second());
