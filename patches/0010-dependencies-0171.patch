+
+#include "webrtc/modules/desktop_capture/window_capturer.h"
+
+#include <assert.h>
+#include <string.h>
+#include <X11/Xatom.h>
+#include <X11/extensions/Xcomposite.h>
+#include <X11/extensions/Xrender.h>
