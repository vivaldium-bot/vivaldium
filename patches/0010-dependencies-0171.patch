diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/ConvertDebugInfo2.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/ConvertDebugInfo2.ll
