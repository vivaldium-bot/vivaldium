diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/MemCpyOpt/2011-06-02-CallSlotOverwritten.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/MemCpyOpt/2011-06-02-CallSlotOverwritten.ll
