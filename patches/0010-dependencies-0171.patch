diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2008-05-16-PHIBlockMerge.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/2008-05-16-PHIBlockMerge.ll
