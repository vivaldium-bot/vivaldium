+	fragment ""
+		void main (void)
+		{
+			gl_FragData[1] = vec4(1.0);
+		}
+	""
+end
+
+case write_fragcolor_and_fragdata_simple
+	version 100 es
+	expect compile_fail
+	vertex ""
+		void main (void)
