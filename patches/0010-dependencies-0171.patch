+
+    // Check if the selected speaker has a mute control
+    _mixerManager.SpeakerMuteIsAvailable(isAvailable);
+
+    available = isAvailable;
+
+    // Close the initialized output mixer
+    if (!wasInitialized)
+    {
+        _mixerManager.CloseSpeaker();
+    }
+
+    return 0;
