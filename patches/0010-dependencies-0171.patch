+  int64_t capture_time_ms = clock_.TimeInMilliseconds();
+
+  EXPECT_EQ(0, send_bucket_->QueueInMs());
+
+  // Due to the multiplicative factor we can send 3 packets not 2 packets.
+  SendAndExpectPacket(PacedSender::kLowPriority,
+                      ssrc,
