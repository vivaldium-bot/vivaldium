+StreamGenerator::StreamGenerator(int capacity, double time_now)
+    : capacity_(capacity),
+      prev_arrival_time_us_(time_now) {}
+
+StreamGenerator::~StreamGenerator() {
+  for (StreamMap::iterator it = streams_.begin(); it != streams_.end();
+      ++it) {
+    delete it->second;
+  }
+  streams_.clear();
+}
