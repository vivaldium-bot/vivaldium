+    aec_rdft_forward_128(fft);
+    aRe = h_fft_buf[0] + pos;
+    aIm = h_fft_buf[1] + pos;
+    __asm __volatile(
+      ".set     push                                    \n\t"
+      ".set     noreorder                               \n\t"
