+    var bs = (color >> 18) & ((1 << 9) - 1);
+    var gs = (color >> 9) & ((1 << 9) - 1);
+    var rs = color & ((1 << 9) - 1);
+
+    var e = Math.pow(2, (exp - eBias - mBits));
+    var r = rs * e;
+    var g = gs * e;
+    var b = bs * e;
