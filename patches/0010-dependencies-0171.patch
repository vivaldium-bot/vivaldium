+
+class PoleZeroFilterTest : public ::testing::Test {
+ protected:
+  PoleZeroFilterTest()
+      : my_filter_(PoleZeroFilter::Create(kCoeffNumerator,
+                                          kFilterOrder,
+                                          kCoeffDenominator,
+                                          kFilterOrder)) {}
+
+  ~PoleZeroFilterTest() {}
