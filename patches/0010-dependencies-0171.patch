+FeedbackPacket* TcpBweReceiver::GetFeedback(int64_t now_ms) {
+  int64_t corrected_send_time_ms = now_ms - latest_owd_ms_;
+  FeedbackPacket* fb =
+      new TcpFeedback(flow_id_, now_ms * 1000, corrected_send_time_ms, acks_);
+  last_feedback_ms_ = now_ms;
+  acks_.clear();
+  return fb;
