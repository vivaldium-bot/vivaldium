diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/nocapture.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/nocapture.ll
new file mode 100644
index 0000000000000000000000000000000000000000..87cb9dd427b47187f2933a8a159c967f82b5dd77
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/TailCallElim/nocapture.ll
