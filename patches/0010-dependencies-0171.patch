+tcuTexture.TextureCube.prototype.allocLevel = function(face, levelNdx) {
+    /** @const */ var size = tcuTexture.getMipPyramidLevelSize(this.m_size, levelNdx);
+    /** @const*/ var dataSize = this.m_format.getPixelSize() * size * size;
