diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/MemCpyOpt/2008-02-24-MultipleUseofSRet.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/MemCpyOpt/2008-02-24-MultipleUseofSRet.ll
