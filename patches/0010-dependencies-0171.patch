+tcuTextureUtil.linearChannelToSRGB = function(cl) {
+    if (cl <= 0.0)
+        return 0.0;
+    else if (cl < 0.0031308)
+        return 12.92 * cl;
+    else if (cl < 1.0)
+        return 1.055 * Math.pow(cl, 0.41666) - 0.055;
+    else
+        return 1.0;
+};
