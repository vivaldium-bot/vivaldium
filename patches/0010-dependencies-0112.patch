+void CPLST_Select::Add(int32_t nBeginIndex, int32_t nEndIndex)
+{
+	if (nBeginIndex > nEndIndex)
+	{
+		int32_t nTemp = nEndIndex;
+		nEndIndex = nBeginIndex;
+		nBeginIndex = nTemp;
+	}
+
+	for (int32_t i=nBeginIndex; i<=nEndIndex; i++)	Add(i);
+}
