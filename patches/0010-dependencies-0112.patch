+		int iEnd;
+		while((iEnd = cFormat.find(cTableAd[iIndex].lpszJSMark, iStart)) != -1)
+		{
+			if (iEnd > 0)
+			{
+				if (cFormat[iEnd-1] == L'%')
+				{
+					iStart = iEnd+1;
+					continue;
+				}
+			}
+			cFormat.replace(iEnd,FXSYS_wcslen(cTableAd[iIndex].lpszJSMark),tszValue);
+			iStart = iEnd;
+		}
+	}
+
+	CFX_WideString strFormat;
+	wchar_t buf[64] = {};
+	strFormat = wcsftime(buf, 64, cFormat.c_str(), &time);
+	cFormat = buf;
+	cPurpose = cFormat;
+}
