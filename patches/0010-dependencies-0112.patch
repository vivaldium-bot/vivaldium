+
+	CPDF_FormControl* pFormCtrl = GetFormControl();
+	ASSERT(pFormCtrl != NULL);
+
+	int32_t iColorType;
+	FX_FLOAT fc[4];
+	pFormCtrl->GetOriginalBackgroundColor(iColorType, fc);
+	if (iColorType > 0)
+		crFill = CPWL_Color(iColorType, fc[0], fc[1], fc[2], fc[3]);
+
+	return crFill;
+}
