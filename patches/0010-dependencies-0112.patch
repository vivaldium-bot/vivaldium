+//CJS_Value::operator CJS_Array()
+FX_BOOL CJS_Value::ConvertToArray(CJS_Array &array) const
+{
+	if (IsArrayObject())
+	{
+		array.Attach(JS_ToArray(m_isolate, m_pValue));
+		return TRUE;
+	}
+
+	return FALSE;
+}
+
+FX_BOOL CJS_Value::ConvertToDate(CJS_Date &date) const
+{
+// 	if (GetType() == VT_date)
+// 	{
+// 		date = (double)(*this);
+// 		return TRUE;
+// 	}
+
+	if (IsDateObject())
+	{
+		date.Attach(m_pValue);
+		return TRUE;
+	}
+
+	return FALSE;
+}
