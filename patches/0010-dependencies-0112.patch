+CPWL_Note_Edit::CPWL_Note_Edit() : m_bEnableNotify(TRUE),
+	m_fOldItemHeight(0.0f),
+	m_bSizeChanged(FALSE),
+	m_fOldMin(0.0f),
+	m_fOldMax(0.0f)
+{
+}
