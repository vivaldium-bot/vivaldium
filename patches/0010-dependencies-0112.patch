+class AreaCodeMapTest : public testing::Test {
+ protected:
+  virtual void SetUp() {
+    MakeCodeMapUS(&map_US_);
+    MakeCodeMapIT(&map_IT_);
+  }
+
+  scoped_ptr<AreaCodeMap> map_US_;
+  scoped_ptr<AreaCodeMap> map_IT_;
+};
