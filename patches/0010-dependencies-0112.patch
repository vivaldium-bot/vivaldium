+# ----------------------------------------------------------------------------------------------
+# Emphasis opcodes
+# ----------------------------------------------------------------------------------------------
+
+# cursief
+lenitalphrase 3
+italsign 456
+begital 456
+endital 6
+firstwordital 456-456
+
+# vet
+lenboldphrase 3
+boldsign 456
+begbold 456
+endbold 6
+firstwordbold 456-456
+
+# onderstreept
+lenunderphrase 3
+undersign 456
+begunder 456
+endunder 6
+firstwordunder 456-456
