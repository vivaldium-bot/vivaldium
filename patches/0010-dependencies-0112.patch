+void CPWL_Note_Edit::SetText(const FX_WCHAR* csText)
+{
+	m_bEnableNotify = FALSE;
+	CPWL_Edit::SetText(csText);
+	m_bEnableNotify = TRUE;
+	m_fOldItemHeight = GetContentRect().Height();
+}
