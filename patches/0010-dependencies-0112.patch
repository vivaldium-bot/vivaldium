+// number when dialed from a mobile phone in Colombia.
+const char kColombiaMobileToFixedLinePrefix[] = "3";
+
+// The kPlusSign signifies the international prefix.
+const char kPlusSign[] = "+";
+
+const char kStarSign[] = "*";
