+	for (int i=0,sz=m_Annots.GetSize(); i<sz; i++)
+	{
+		if (m_Annots[i] == pAnnot)
+		{
+			if (i-1 >= 0)
+				return m_Annots[i-1];
+			else
+				return m_Annots[sz-1];
+		}
+	}
+
+	return NULL;
