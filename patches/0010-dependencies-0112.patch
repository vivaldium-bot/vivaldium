+int CBA_AnnotIterator::CompareByLeft(CPDFSDK_Annot* p1, CPDFSDK_Annot* p2)
+{
+	ASSERT(p1 != NULL);
+	ASSERT(p2 != NULL);
+
+	CPDF_Rect rcAnnot1 = GetAnnotRect(p1);
+	CPDF_Rect rcAnnot2 = GetAnnotRect(p2);
+
+	if (rcAnnot1.left < rcAnnot2.left)
+		return -1;
+	if (rcAnnot1.left > rcAnnot2.left)
+		return 1;
+	return 0;
+}
