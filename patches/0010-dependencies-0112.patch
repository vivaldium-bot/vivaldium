+getTable_SOURCES = getTable.c
+
+typeform_SOURCES =				\
+	typeform.c
+
+pass0_typebuf_SOURCES =				\
+	brl_checks.c				\
+	brl_checks.h				\
+	pass0_typebuf.c
+
+hash_collision_SOURCES =			\
+	brl_checks.c				\
+	brl_checks.h				\
+	hash_collision.c
+
+resolve_table_SOURCES =				\
+	resolve_table.c
+
+logging_SOURCES =				\
+	logging.c
+
+check_PROGRAMS =				\
+	pass2					\
+	pass2_inpos				\
+	inpos					\
+	inpos_match_replace			\
+	uplow_with_unicode			\
+	present_progressive			\
