+		m_pOprNotify->OnAddUndo(m_pGroupUndoItem);
+	m_pGroupUndoItem = NULL;
+}
+
+void CFX_Edit::AddEditUndoItem(CFX_Edit_UndoItem* pEditUndoItem)
+{
+	if (m_pGroupUndoItem)
