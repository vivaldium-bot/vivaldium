+void CPDFSDK_Widget::RemoveAppearance(const CFX_ByteString& sAPType)
+{
+	if (CPDF_Dictionary* pAPDict = m_pAnnot->GetAnnotDict()->GetDict("AP"))
+	{
+		pAPDict->RemoveAt(sAPType);
+	}
