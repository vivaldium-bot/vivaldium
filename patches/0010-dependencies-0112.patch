+CPDF_Rect CPWL_ListCtrl::InToOut(const CPDF_Rect& rect) const
+{
+	CPDF_Rect rcClient = GetClientRect();
+
+	return CPDF_Rect(rect.left + rcClient.left - m_ptScroll.x,
+		rect.bottom + rcClient.top - m_ptScroll.y,
