+TEST(UnicodeTextTest, Iterator) {
+  struct value {
+    const char* utf8;
+    char32 code_point;
+  } values[] = {
+    { "\x31", 0x31 }, // U+0031 DIGIT ONE
+    { "\xC2\xBD", 0x00BD }, // U+00BD VULGAR FRACTION ONE HALF
+    { "\xEF\xBC\x91", 0xFF11 }, // U+FF11 FULLWIDTH DIGIT ONE
