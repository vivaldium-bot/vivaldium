+			InvalidateRect();
+
+		m_bMouseDown = TRUE;
+		SetCapture();
+
+		m_pEdit->OnMouseDown(point,IsSHIFTpressed(nFlag),IsCTRLpressed(nFlag));
+	}
+
+	return TRUE;
+}
