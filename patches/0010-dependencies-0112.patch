@@ -0,0 +1,153 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ftpfr.c                                                                */
+/*                                                                         */
+/*    FreeType API for accessing PFR-specific data (body).                 */
+/*                                                                         */
+/*  Copyright 2002-2004, 2008, 2010, 2013, 2014 by                         */
+/*  David Turner, Robert Wilhelm, and Werner Lemberg.                      */
