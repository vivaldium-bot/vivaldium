+void CPWL_Wnd::PWLtoWnd(const CPDF_Point& point, int32_t& x, int32_t& y) const
+{
+	CPDF_Matrix mt = GetWindowMatrix();
+	CPDF_Point pt = point;
+	mt.Transform(pt.x,pt.y);
+	x = (int32_t)(pt.x+0.5);
+	y = (int32_t)(pt.y+0.5);
