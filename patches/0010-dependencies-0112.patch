+#define VALUE_NAME_UNDEFINED	L"undefined"
+
+FXJSVALUETYPE GET_VALUE_TYPE(v8::Local<v8::Value> p);
+
+#endif  // FPDFSDK_INCLUDE_JAVASCRIPT_JS_DEFINE_H_
