+		crLeftTop = CPWL_Color(COLORTYPE_GRAY,1);
+		crRightBottom = CPWL_Utils::DevideColor(crBackground,2);
+		break;
+	case BBS_INSET:
+		nBorderStyle = PBS_INSET;
+		fBorderWidth *= 2;
+		crLeftTop = CPWL_Color(COLORTYPE_GRAY,0.5);
+		crRightBottom = CPWL_Color(COLORTYPE_GRAY,0.75);
+		break;
+	case BBS_UNDERLINE:
