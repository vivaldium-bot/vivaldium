+{
+}
+
+void CFFL_Notify::BeforeNotify()
+{
+	m_nNotifyFlag ++;
+}
+
+
+void CFFL_Notify::AfterNotify()
+{
+	m_nNotifyFlag --;
+}
+
+FX_BOOL CFFL_Notify::OnMouseUp(FX_BOOL & bExit)
