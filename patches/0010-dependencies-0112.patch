+		DEFINE_GLOBAL_ARRAY(pRuntime);
+	}
+
+	{
+		const FX_WCHAR* ArrayName = L"RE_PHONE_COMMIT";
+		const FX_WCHAR* ArrayContent[] = {
+					L"\\d{3}(\\.|[- ])?\\d{4}",							/* 555-1234 */
+					L"\\d{3}(\\.|[- ])?\\d{3}(\\.|[- ])?\\d{4}",			/* 408 555-1234 */
+					L"\\(\\d{3}\\)(\\.|[- ])?\\d{3}(\\.|[- ])?\\d{4}",	/* (408) 555-1234 */
+					L"011(\\.|[- \\d])*"									/* international */
+				};
+		DEFINE_GLOBAL_ARRAY(pRuntime);
+	}
+
+	{
