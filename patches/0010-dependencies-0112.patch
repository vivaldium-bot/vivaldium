+  number_format->set_national_prefix_formatting_rule("");
+  phone_util_.FormatByPattern(test_number, PhoneNumberUtil::INTERNATIONAL,
+                              number_formats,
+                              &formatted_number);
+  EXPECT_EQ("+44 20 1234 5678", formatted_number);
+}
