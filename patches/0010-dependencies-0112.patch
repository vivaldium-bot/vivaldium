+		crBorder = CPWL_Color(iColorType, fc[0], fc[1], fc[2], fc[3]);
+
+	FX_FLOAT fBorderWidth = (FX_FLOAT)GetBorderWidth();
+	int32_t nBorderStyle = 0;
+	CPWL_Dash dsBorder(3,0,0);
+	CPWL_Color crLeftTop,crRightBottom;
+
+	switch (GetBorderStyle())
+	{
+	case BBS_DASH:
