+  EXPECT_FALSE(ExtractMatch(text, &match));
+  text = "As I said on 03/27/2011, you may call me at ";
+  EXPECT_FALSE(ExtractMatch(text, &match));
+  text = "As I said on 31/8/2011, you may call me at ";
+  EXPECT_FALSE(ExtractMatch(text, &match));
+  text = "As I said on 1/12/2011, you may call me at ";
+  EXPECT_FALSE(ExtractMatch(text, &match));
