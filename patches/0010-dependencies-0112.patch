+void CPWL_Wnd::OnNotify(CPWL_Wnd* pWnd, FX_DWORD msg, intptr_t wParam, intptr_t lParam)
+{
+	switch (msg)
+	{
+	case PNM_ADDCHILD:
+		AddChild(pWnd);
+		break;
+	case PNM_REMOVECHILD:
+		RemoveChild(pWnd);
+		break;
+	default:
+		break;
+	}
