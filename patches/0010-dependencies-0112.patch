+		if (m_pVT->IsMultiLine() && GetTotalLines() > 1)
+		{
+			if (FX_EDIT_IsFloatBigger(rcContent.Height(),rcPlate.Height())) return TRUE;
+		}
+
+		if (FX_EDIT_IsFloatBigger(rcContent.Width(),rcPlate.Width())) return TRUE;
+	}
+
+	return FALSE;
