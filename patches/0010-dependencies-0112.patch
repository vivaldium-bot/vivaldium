+		return FALSE;
+
+	CPDF_Dictionary* pDict = pDoc->GetPage(page_index);
+	if (pDict == NULL) return FALSE;
+
+	CPDF_Page page;
+	page.Load(pDoc, pDict);
+	*width = page.GetPageWidth();
+	*height = page.GetPageHeight();
+
+	return TRUE;
+}
