+
+CPWL_Wnd* CFFL_CheckBox::NewPDFWindow(const PWL_CREATEPARAM& cp, CPDFSDK_PageView* pPageView)
+{
+	CPWL_CheckBox* pWnd = new CPWL_CheckBox();
