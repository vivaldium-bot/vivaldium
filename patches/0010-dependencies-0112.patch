+	int32_t nLimitChar = m_pVT->GetLimitChar();
+	int32_t nCharArray = m_pVT->GetCharArray();
+
+	return IsTextOverflow() || (nLimitChar>0 && nTotalWords >= nLimitChar)
+		|| (nCharArray>0 && nTotalWords >= nCharArray);
+}
