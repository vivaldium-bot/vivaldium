+	CPWL_Point leftup(crBBox.left, crBBox.top);
+	CPWL_Point rightdown(crBBox.right, crBBox.bottom);
+	FX_FLOAT k = -fHeight/fWidth;
+	CPWL_Point tail;
+	tail.x = crBBox.left + fWidth*4/5.0f;
