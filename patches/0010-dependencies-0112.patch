+word , 5
+always , 5
+decpoint . 3
+midnum - 36
+hyphen - 36
+always \s--\s 36-36
+always \s-\s 36-36
+midnum \x00ad 36
+postpunc . 256
+word . 256
+always . 256
+postpunc ; 56-23
+word ; 56-23
+midnum : 5-2
+postpunc : 5-2
+always : 5-2
+postpunc ! 456
+always ! 456
+midnum / 456-34
+always / 456-34
+always < 5-13
+always = 25-25
+always > 46-2
+always + 5-235
+postpunc ? 236
+word ? 236
+always ? 236
+endnum st 34
+endnum nd 1345-145
+endnum rd 1235-145
+endnum 's 3-234
+endnum th 1456
+endnum 's 3-234
+always % 356-1234
+midnum ^ 45
+always ^ 456-126
+always ~ 36-36
+always & 4-12346
+midnum * 5-23
+always * 35-35
+prepunc [ 236-3
+word [ 236-3
+always [ 236-3
+postpunc ] 6-356
+word ] 6-356
+always ] 6-356
+prepunc { 236-23
+word { 236-23
+always { 236-23
+postpunc } 56-356
+word } 56-356
+always } 56-356
+always @ 4-1
+always \\ 4-1256
+always | 456-1256
+always \s-\s 36
+always ..." 5-5-5-356
+always … 5-5-5
+always ... 5-5-5
+always ...' 5-5-5-356-3
+repeated .... 0
+repeated ____ 6-36-36-3
+repeated ---- 36
+always .\s.\s." 3-3-3-356
+always .\s.\s. 3-3-3 . . .
+begnum $ 256
+always $ 4-256
+always _ 6-36-36-3
+always — 56-36-36-23
+
+# special character sequences
+compbrl :// URLs
+compbrl ()
+compbrl www.
+compbrl ::
+compbrl .com
+compbrl .edu
+compbrl .gov
+compbrl .ini
+compbrl .mil
+compbrl .net
+compbrl .org
+compbrl .doc
