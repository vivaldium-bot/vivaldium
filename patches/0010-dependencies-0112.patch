+FX_COLORREF CPDFSDK_InterForm::GetHighlightColor(int nFieldType)
+{
+	if(nFieldType <0 || nFieldType >6) return FXSYS_RGB(255,255,255);
+	if(nFieldType == 0)
+		return m_aHighlightColor[0];
+	else
+		return m_aHighlightColor[nFieldType-1];
+}
