+		CFX_WideString swUnicode = pFont->UnicodeFromCharCode(charcode);
+
+		FX_WORD unicode = 0;
+		if (swUnicode.GetLength() > 0)
+			unicode = swUnicode[0];
+
+		if (ISLATINWORD(unicode) && bIsLatin)
+		{
+		}
+		else
+		{
+			bIsLatin = ISLATINWORD(unicode);
+			if (unicode != 0x20)
+				nWords++;
+		}
+
+		if (nWords-1 == nWordIndex)
+			swRet += unicode;
+	}
+
+	return swRet;
