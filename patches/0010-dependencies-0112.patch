+	if (m_bMouseDown)
+	{
+		//can receive keybord message
+		if (ClientHitTest(point) && !IsFocused())
+			SetFocus();
+
+		ReleaseCapture();
+		m_bMouseDown = FALSE;
+	}
+
+	return TRUE;
+}
+
+FX_BOOL CPWL_EditCtrl::OnMouseMove(const CPDF_Point & point, FX_DWORD nFlag)
+{
+	CPWL_Wnd::OnMouseMove(point,nFlag);
