+
+  context  %uppergreek["\es"]$u        @6
+  context  %lowergreek["\es"]$u        @6
+  context  $l["\es"]%uppergreek        ?
+  context  $l["\es"]%lowergreek        ?
+  context  $l["\es"]$l                 ?
