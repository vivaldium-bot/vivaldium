+  CallArgument args[] = {
+    CallArgument(new_target),
+    CallArgument(target),
+    CallArgument(revc),
+    CallArgument(argc),
+    CallArgument(argv),
+    CallArgument::End()
+  };
+  return CallInt64(entry, args);
+}
