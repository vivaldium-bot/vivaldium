+
+Reduction ChangeLowering::ChangeBitToBool(Node* value, Node* control) {
+  return Replace(
+      graph()->NewNode(common()->Select(MachineRepresentation::kTagged), value,
+                       jsgraph()->TrueConstant(), jsgraph()->FalseConstant()));
+}
