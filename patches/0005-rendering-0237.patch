+
+#ifndef V8_COMPILER_SIMPLIFIED_OPERATOR_H_
+#define V8_COMPILER_SIMPLIFIED_OPERATOR_H_
+
+#include <iosfwd>
+
+#include "src/handles.h"
+#include "src/machine-type.h"
+#include "src/objects.h"
+
+namespace v8 {
+namespace internal {
+
+// Forward declarations.
+class Type;
+class Zone;
+
+
+namespace compiler {
+
+// Forward declarations.
+class Operator;
