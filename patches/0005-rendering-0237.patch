+
+void MacroAssembler::InitializeFieldsWithFiller(Register current_address,
+                                                Register end_address,
+                                                Register filler) {
+  Label loop, entry;
+  b(&entry);
+  bind(&loop);
+  str(filler, MemOperand(current_address, kPointerSize, PostIndex));
+  bind(&entry);
+  cmp(current_address, end_address);
+  b(lo, &loop);
+}
