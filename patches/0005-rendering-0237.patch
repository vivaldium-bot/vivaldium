-    svg = document.getElementById("svg"),
-    rect = document.getElementById("rect");
-function onPageLoad() {
-    // sqrt(2) = 1.414213562373095...
-    var intervals = [
-        ["1.4", "1.5"],
-        ["1.41", "1.42"],
-        ["1.414", "1.415"],
-        ["1.4142", "1.4143"],
-        ["1.41421", "1.41422"],
-        ["1.414213", "1.414220"]
