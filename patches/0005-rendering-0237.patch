+Node* WasmGraphBuilder::FunctionTable() {
+  DCHECK(module_ && module_->instance &&
+         !module_->instance->function_table.is_null());
+  if (!function_table_) {
+    function_table_ = jsgraph()->Constant(module_->instance->function_table);
+  }
+  return function_table_;
+}
