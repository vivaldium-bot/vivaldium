+  // in a (pre-existing) HeapNumber. See crbug.com/349878.
+  bool could_be_heapobject = r.IsTagged() && !object.handle().is_null();
+  bool is_smi = HasSmiValue() && !could_be_heapobject;
+  set_type(is_smi ? HType::Smi() : HType::TaggedNumber());
+  Initialize(r);
