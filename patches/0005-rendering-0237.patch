+void OS::DebugBreak() {
+#if V8_HOST_ARCH_ARM
+  asm("bkpt 0");
+#elif V8_HOST_ARCH_ARM64
+  asm("brk 0");
+#elif V8_HOST_ARCH_MIPS
+  asm("break");
+#elif V8_HOST_ARCH_MIPS64
+  asm("break");
+#elif V8_HOST_ARCH_PPC
+  asm("twge 2,2");
+#elif V8_HOST_ARCH_IA32
