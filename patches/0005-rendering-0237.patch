+
+Range* HConstant::InferRange(Zone* zone) {
+  if (HasInteger32Value()) {
+    Range* result = new(zone) Range(int32_value_, int32_value_);
+    result->set_can_be_minus_zero(false);
+    return result;
+  }
+  return HValue::InferRange(zone);
+}
