+void AstGraphBuilder::VisitThrow(Throw* expr) {
+  VisitForValue(expr->exception());
+  Node* exception = environment()->Pop();
+  Node* value = BuildThrowError(exception, expr->id());
+  ast_context()->ProduceValue(value);
+}
