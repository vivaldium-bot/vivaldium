+class SimpleListPrinter {
+ public:
+  explicit SimpleListPrinter(std::ostream& os) : os_(os), first_(true) {}
+
+  void Add(const char* s) {
+    if (first_) {
+      first_ = false;
+    } else {
+      os_ << ",";
+    }
+    os_ << s;
+  }
+
+ private:
+  std::ostream& os_;
+  bool first_;
+};
