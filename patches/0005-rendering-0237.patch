+
+void MacroAssembler::UntagAndJumpIfSmi(
+    Register dst, Register src, Label* smi_case) {
+  STATIC_ASSERT(kSmiTag == 0);
+  SmiUntag(dst, src, SetCC);
+  b(cc, smi_case);  // Shifter carry is not set for a smi.
+}
