+
+Node* ChangeLowering::LoadHeapNumberValue(Node* value, Node* control) {
+  return graph()->NewNode(machine()->Load(MachineType::Float64()), value,
+                          HeapNumberValueIndexConstant(), graph()->start(),
+                          control);
+}
