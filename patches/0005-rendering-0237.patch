+
+void PrettyPrinter::VisitObjectLiteral(ObjectLiteral* node) {
+  Print("{ ");
+  for (int i = 0; i < node->properties()->length(); i++) {
+    if (i != 0) Print(",");
+    PrintObjectLiteralProperty(node->properties()->at(i));
+  }
+  Print(" }");
+}
