+
+void MacroAssembler::UntagAndJumpIfNotSmi(
+    Register dst, Register src, Label* non_smi_case) {
+  STATIC_ASSERT(kSmiTag == 0);
+  SmiUntag(dst, src, SetCC);
+  b(cs, non_smi_case);  // Shifter carry is set for a non-smi.
+}
