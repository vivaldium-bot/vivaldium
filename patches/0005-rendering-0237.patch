diff --git a/v8/src/crankshaft/hydrogen-osr.cc b/v8/src/crankshaft/hydrogen-osr.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c98bbf627f958c936492f1b5b2c665d6ec458c41
--- /dev/null
