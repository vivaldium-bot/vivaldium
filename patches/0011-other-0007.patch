+# found in the LICENSE file.
+
+import os
+import glob
+from optparse import OptionParser
+from collections import namedtuple
+
+Config = namedtuple('Config', 'linkfiles linkfileglobs rmfiles rmfileglobs')
+
+configs = {
+  ('164.gzip', 'train'):
