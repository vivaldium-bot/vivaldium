+
+set -o nounset
+set -o errexit
+
+PREFIX=${PREFIX:-}
+VERIFY=${VERIFY:-yes}
+EMU_HACK=${EMU_HACK:-yes}
+
+python ../prepare_input.py --config $(basename $(pwd)) ref
+
