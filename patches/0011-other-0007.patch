+           linkfileglobs=[],
+           rmfiles=['words', '2.1.dict'],
+           rmfileglobs=['*.out']),
+  ('197.parser', 'ref'):
+    Config(linkfiles=['data/all/input/words', 'data/all/input/2.1.dict'],
