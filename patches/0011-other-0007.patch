+DEFAULT_CACHE_DIR = os.path.join(SCRIPT_DIR, 'cache')
+DEFAULT_GIT_CACHE_DIR = os.path.join(SCRIPT_DIR, 'git_cache')
+DEFAULT_SRC_DIR = os.path.join(SCRIPT_DIR, 'src')
