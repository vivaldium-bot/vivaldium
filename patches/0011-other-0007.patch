diff --git a/native_client/tests/performance/perf_test_exceptions.cc b/native_client/tests/performance/perf_test_exceptions.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f2d2a152dc663e52d4c34d693eea21960ed7f88e
--- /dev/null
