+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+void far_away(void);
+
+int main(void) {
+  /*
+   * This is useful test only if the branch distance here is more than
+   * 32MB, which is the limit for ARM branches.
+   */
+  assert((uintptr_t) &far_away > (uintptr_t) &main);
+  assert((uintptr_t) &far_away - (uintptr_t) &main > (32 << 20));
+  far_away();
+  return 1;
+}
