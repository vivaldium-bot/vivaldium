+                                 printf("%s:%d:%d: ", \
+                                        __FUNCTION__, \
+                                        __LINE__, \
+                                        (int)pthread_self()); \
+                                 printf mesg; \
+                                 fflush(stdout); \
+                               }\
+                          } while (0)
