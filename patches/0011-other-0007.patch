+int map_rw_ronly_file_test(int d, size_t file_size, void *test_specifics) {
+  void *view;
+
+  UNREFERENCED_PARAMETER(test_specifics);
+  errno = 0;
+  view = mmap(NULL, file_size, PROT_READ | PROT_WRITE, MAP_SHARED, d,
+              /* offset */ 0);
