+def GitUrl(package, push_url=False):
+  repo = GIT_REVISIONS[package].get('repo', package)
+  if push_url:
+    base_url = GIT_PUSH_URL
+  else:
+    base_url = GIT_BASE_URL
+
+  return '%s/nacl-%s.git' % (base_url, repo)
