+def WithDepsOptions(options, component=None):
+  if component is None:
+    directory = command.path.join('%(cwd)s', 'all_deps')
+  else:
+    directory = '%(abs_' + component + ')s'
+  return ['--with-' + option + '=' + directory
+          for option in options]
