+#@
+#@ BuildAndRunBenchmarks <setup> [ref|train] <benchmark>*
+#@
+#@   Builds and run all benchmarks according to the setup
+BuildAndRunBenchmarks() {
+  setup=$1
+  shift
+  BuildBenchmarks 0 ${setup} "$@"
+  RunBenchmarks ${setup} "$@"
+}
