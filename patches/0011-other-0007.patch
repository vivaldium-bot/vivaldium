+def PopulateDeps(dep_dirs):
+  commands = [command.RemoveDirectory('all_deps'),
+              command.Mkdir('all_deps')]
+  commands += [command.Command('cp -r "%s/"* all_deps' % dirname, shell=True)
+               for dirname in dep_dirs]
+  return commands
