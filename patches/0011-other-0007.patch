+           linkfileglobs=['data/ref/input/*'],
+           rmfiles=['mesa.log', 'mesa.ppm', 'mesa.in', 'numbers'],
+           rmfileglobs=['*.out']),
+  ('179.art', 'train'):
+    Config(linkfiles=[],
+           linkfileglobs=['data/train/input/*'],
+           rmfiles=['a10.img', 'c756hel.in', 'hc.img'],
+           rmfileglobs=['*.out', '*.err']),
+  ('179.art', 'ref'):
+    Config(linkfiles=[],
+           linkfileglobs=['data/ref/input/*'],
+           rmfiles=['a10.img', 'c756hel.in', 'hc.img'],
+           rmfileglobs=['*.out', '*.err']),
+  ('181.mcf', 'train'):
