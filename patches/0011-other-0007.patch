+ * found in the LICENSE file.
+ */
+
+#include <stdlib.h>
+__thread int tlsvar;
+
+int check_set_tls(int expected, int value) {
+  if (tlsvar != expected)
+    abort();
+  int oldval = tlsvar;
+  tlsvar = value;
+  return oldval;
+}
