+node = env.CommandSelLdrTestNacl(
+    'cond_wait_test.out',
+    cond_wait_test_nexe,
+    size='small',
+    )
+env.AddNodeToTestSuite(node, ['small_tests'], 'run_cond_wait_test')
+
+mutex_timedlock_test_nexe = env.ComponentProgram(
+    'mutex_timedlock_test',
+    ['mutex_timedlock.c'],
