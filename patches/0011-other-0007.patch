+  CHECK_EQ(lib_3_int8, kINT8_3_INITIAL, "%d", num_errs);
+  CHECK_EQ(lib_3_int16, kINT16_3_INITIAL, "%d", num_errs);
+  CHECK_EQ(lib_3_int32, kINT32_3_INITIAL, "%d", num_errs);
+  CHECK_EQ(lib_3_int64, kINT64_3_INITIAL, "%lld", num_errs);
