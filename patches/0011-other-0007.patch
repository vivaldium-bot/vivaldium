+# found in the LICENSE file.
+
+cd "$(dirname "$0")"
+for i in binutils gcc glibc linux-headers-for-nacl newlib; do
+  (
+    if [ -s "toolchain-try.$i.patch" ]; then
+      echo "@@@BUILD_STEP $i try patch@@@"
+      make "pinned-src-$i"
+      cd "SRC/$i"
