diff --git a/native_client/tests/nonsfi/example_irt_caller_test.cc b/native_client/tests/nonsfi/example_irt_caller_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5a68648750aa7cc0da90793fa73c2a14933c7314
--- /dev/null
