+void AddNanosecondsToTimespec(struct timespec *time, unsigned int nanoseconds) {
+  EXPECT_LE(nanoseconds, 1000000000);
+  time->tv_nsec += nanoseconds;
+  if (time->tv_nsec > 1000000000) {
+    time->tv_nsec -= 1000000000;
+    time->tv_sec += 1;
+  }
+}
