+
+struct NaClSexpNode *SubImpl(struct NaClSexpCons *cons,
+                              struct WorkState *ws) {
+  int first = 1;
+  int value = 0;
+  struct NaClSexpNode *v = NULL;
+  struct NaClSexpCons *p;
+
+  for (p = cons->cdr; NULL != p; p = p->cdr) {
+    v = Eval(p->car, ws);
+    if (!NaClSexpIntp(v)) {
+      error_node(ws, "argument not integral", v);
+      return NULL;
