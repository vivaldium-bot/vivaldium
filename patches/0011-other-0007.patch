+    Config(linkfiles=[],
+           linkfileglobs=['data/train/input/*'],
+           rmfiles=[],
+           rmfileglobs=['*.out', '*.in']),
+  ('175.vpr', 'ref'):
+    Config(linkfiles=[],
+           linkfileglobs=['data/ref/input/*'],
+           rmfiles=[],
+           rmfileglobs=['*.out', '*.in']),
+  ('176.gcc', 'train'):
+    Config(linkfiles=[],
+           linkfileglobs=[],
+           rmfiles=[],
+           rmfileglobs=['*.out', '*.s']),
+  ('176.gcc', 'ref'):
+    Config(linkfiles=[],
+           linkfileglobs=[],
+           rmfiles=[],
+           rmfileglobs=['*.out', '*.s']),
+  ('177.mesa', 'train'):
+    Config(linkfiles=[],
+           linkfileglobs=['data/train/input/*'],
+           rmfiles=['mesa.log', 'mesa.ppm', 'mesa.in', 'numbers'],
