+CheckFileBuilt() {
+  local depname="$1"
+  local filename="$2"
+  if [[ ! -f "${filename}" ]] ; then
+    echo "You have not built ${depname} yet (${filename})!" 1>&2
+    exit -1
+  fi
+}
