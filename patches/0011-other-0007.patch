+#@
+#@ CleanBenchmarks <benchmark>*
+#@
+#@   this is a deep clean and you have to rerun PopulateFromSpecHarness
+CleanBenchmarks() {
+  local list=$(GetBenchmarkList "$@")
+  rm -rf bin/
+  for i in ${list} ; do
+    SubBanner "Cleaning: $i"
+    cd $i
+    make clean
+    rm -rf src/ data/
+    cd ..
+  done
+}
