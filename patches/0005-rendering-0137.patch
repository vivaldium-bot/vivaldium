-    Gap between column 0 and 1: +200px = 200px
-    Column 1: +0px = 200px
-    Gap between column 1 and 2: +200px = 400px
-    Column 2: +0px = 400px
-    Gap between column 2 and 3: +200px = 600px
-    Column 3: +0px = 600px
-    Gap between column 3 and 4: +200px = 800px
-    Column 4: +0px = 800px
--->
