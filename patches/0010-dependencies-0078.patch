+CommandLine::~CommandLine (void)
+{
+	delete m_caseTree;
+}
+
+void CommandLine::clear (void)
+{
+	m_cmdLine.clear();
+	m_logFlags = 0;
+
+	delete m_caseTree;
+	m_caseTree = DE_NULL;
+}
