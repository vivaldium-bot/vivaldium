index 0000000000000000000000000000000000000000..3f515622b642e0ed94e08ea3562ae5a810ded263
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/x86/vf_gradfun_init.c
@@ -0,0 +1,105 @@
+/*
+ * Copyright (C) 2009 Loren Merritt <lorenm@u.washington.edu>
