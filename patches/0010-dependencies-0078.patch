new file mode 100644
index 0000000000000000000000000000000000000000..c4d7b6bb6cc76c5e1e203cbabc5d9de7b94f159c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_dejudder.c
@@ -0,0 +1,187 @@
