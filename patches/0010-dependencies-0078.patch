index 0000000000000000000000000000000000000000..f8ae9d5a6dad04cc56b09ac11b6bd3c095ada327
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_libopencv.c
@@ -0,0 +1,434 @@
+/*
+ * Copyright (c) 2010 Stefano Sabatini
+ *
+ * This file is part of FFmpeg.
+ *
