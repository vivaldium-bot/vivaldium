index 0000000000000000000000000000000000000000..85d7163c96d0595c377721d17d6b4902ec14ef02
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/h264dec.c
@@ -0,0 +1,120 @@
+/*
+ * RAW H.264 video demuxer
+ * Copyright (c) 2008 Michael Niedermayer <michaelni@gmx.at>
+ *
