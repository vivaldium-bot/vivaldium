index 0000000000000000000000000000000000000000..0677f2976603f525addb3dd8ac10eb34a32ad070
--- /dev/null
+++ b/third_party/grpc/src/core/lib/transport/metadata.c
@@ -0,0 +1,750 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
