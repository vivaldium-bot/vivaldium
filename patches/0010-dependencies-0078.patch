+
+- (int)executeSQL:(NSString *)sql {
+  int rc;
+  // Sanity
+  if (!sql) {
+    rc = SQLITE_MISUSE;  // Reasonable return for this case
+  } else {
+    if (hasCFAdditions_) {
+      rc = sqlite3_exec(db_,
+                        [[sql precomposedStringWithCanonicalMapping]
+                          UTF8String],
+                        NULL, NULL, NULL);
+    } else {
+      rc = sqlite3_exec(db_, [sql UTF8String], NULL, NULL, NULL);
+    }
+  }
+  return rc;
+}
