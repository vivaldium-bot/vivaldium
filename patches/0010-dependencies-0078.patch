new file mode 100644
index 0000000000000000000000000000000000000000..45d246b73231c823b8154cb14fa7ab0896c1c038
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/f_sidedata.c
@@ -0,0 +1,180 @@
+/*
