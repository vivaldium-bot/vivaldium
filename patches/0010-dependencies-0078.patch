+		case COMPRESSEDTEXFORMAT_ETC2_SRGB8_PUNCHTHROUGH_ALPHA1:
+		case COMPRESSEDTEXFORMAT_ETC2_EAC_RGBA8:
+		case COMPRESSEDTEXFORMAT_ETC2_EAC_SRGB8_ALPHA8:
+			return true;
+
+		default:
