index 0000000000000000000000000000000000000000..5f63b2a3f9e2a53587a87248342cc971507a8458
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_hqx.c
@@ -0,0 +1,566 @@
+/*
