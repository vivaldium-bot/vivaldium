diff --git a/third_party/grpc/src/core/lib/channel/handshaker.c b/third_party/grpc/src/core/lib/channel/handshaker.c
new file mode 100644
index 0000000000000000000000000000000000000000..c0979f5e80679f9b2adefb03d174cdb647ebdb68
--- /dev/null
+++ b/third_party/grpc/src/core/lib/channel/handshaker.c
@@ -0,0 +1,203 @@
+/*
+ *
+ * Copyright 2016, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
+ *
+ *     * Redistributions of source code must retain the above copyright
+ * notice, this list of conditions and the following disclaimer.
+ *     * Redistributions in binary form must reproduce the above
