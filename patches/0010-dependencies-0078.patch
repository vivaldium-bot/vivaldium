+  STAssertEqualStrings([seg string], @"fooobaar", nil);
+  // "foobar"
+  seg = [enumerator nextObject];
+  STAssertNotNil(seg, nil);
+  STAssertTrue([seg isMatch], nil);
+  STAssertEqualStrings([seg string], @"foobar", nil);
+  // "zz" - skipped
+  // (end)
+  seg = [enumerator nextObject];
