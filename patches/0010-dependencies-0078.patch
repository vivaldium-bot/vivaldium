diff --git a/third_party/ffmpeg/libavformat/a64.c b/third_party/ffmpeg/libavformat/a64.c
new file mode 100644
index 0000000000000000000000000000000000000000..2a0489dae4c1c2764642b78baf79b39fe97f9b2a
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/a64.c
@@ -0,0 +1,68 @@
+/*
+ * a64 muxer
+ * Copyright (c) 2009 Tobias Bindhammer
