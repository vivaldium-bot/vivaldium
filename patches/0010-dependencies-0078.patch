+
+#ifndef AVFILTER_INTERNAL_H
+#define AVFILTER_INTERNAL_H
+
+/**
+ * @file
+ * internal API functions
+ */
+
+#include "libavutil/internal.h"
+#include "avfilter.h"
+#include "avfiltergraph.h"
+#include "formats.h"
