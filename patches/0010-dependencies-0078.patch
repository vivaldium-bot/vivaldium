+- (void)testEscapedPatternForString {
+  STAssertEqualStrings([GTMRegex escapedPatternForString:@"abcdefghijklmnopqrstuvwxyz0123456789"],
+                       @"abcdefghijklmnopqrstuvwxyz0123456789",
+                       nil);
