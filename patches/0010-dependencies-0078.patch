index 0000000000000000000000000000000000000000..e1b79ab779e7cac2cb254f9f16dde9ad5fb1d375
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_premultiply.c
@@ -0,0 +1,409 @@
+/*
