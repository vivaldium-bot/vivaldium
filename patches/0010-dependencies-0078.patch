+    SInt32 major, minor, bugFix;
+    [GTMSystemVersion getMajor:&major minor:&minor bugFix:&bugFix];
+    if (major <= 10 && minor <= 6) {
+      // rdar://5851487 - If NSAlignmentBinding for a NSTextField is set to -1 
+      //                  and then got it returns 7
