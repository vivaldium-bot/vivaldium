diff --git a/third_party/grpc/src/core/lib/surface/channel.c b/third_party/grpc/src/core/lib/surface/channel.c
new file mode 100644
index 0000000000000000000000000000000000000000..6d2b1c4935273b0394e6e9ae1a60f73ca9353f14
--- /dev/null
+++ b/third_party/grpc/src/core/lib/surface/channel.c
@@ -0,0 +1,377 @@
+/*
+ *
