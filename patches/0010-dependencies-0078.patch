+// Private methods
+@interface GTMSQLiteDatabase (PrivateMethods)
+
+- (int)installCFAdditions;
+- (void)collationArgumentRetain:(NSData *)collationArgs;
+//  Convenience method to clean up resources.  Called from both
+//  dealloc & finalize
