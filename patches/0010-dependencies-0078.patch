+  STAssertEqualStrings(@"foooooobaz", [subPatterns objectAtIndex:0], nil);
+  STAssertEqualStrings(@"foooooo", [subPatterns objectAtIndex:1], nil);
+  STAssertEqualStrings(@"ooooo", [subPatterns objectAtIndex:2], nil);
