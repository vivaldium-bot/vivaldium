+- (void)dealloc {
+  // we used pattern_ as our flag that we initialized the regex_t
+  if (pattern_) {
+    regfree(&regexData_);
+    [pattern_ release];
+    // play it safe and clear it since we use it as a flag for regexData_
+    pattern_ = nil;
+  }
+  [super dealloc];
+}
