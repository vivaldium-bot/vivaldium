+    .flags          = AVFMT_GENERIC_INDEX,
+    .extensions     = "g722,722",
+    .raw_codec_id   = AV_CODEC_ID_ADPCM_G722,
+};
diff --git a/third_party/ffmpeg/libavformat/g723_1.c b/third_party/ffmpeg/libavformat/g723_1.c
new file mode 100644
index 0000000000000000000000000000000000000000..27c8c3951be00baa0ce1daa4dcab526bb4cf3f76
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/g723_1.c
@@ -0,0 +1,86 @@
+/*
+ * G.723.1 demuxer
+ * Copyright (c) 2010 Mohamed Naufal Basheer
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
