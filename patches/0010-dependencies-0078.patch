+static int EscapeMapCompare(const void *ucharVoid, const void *mapVoid) {
+  const unichar *uchar = (const unichar*)ucharVoid;
+  const HTMLEscapeMap *map = (const HTMLEscapeMap*)mapVoid;
+  int val;
+  if (*uchar > map->uchar) {
+    val = 1;
+  } else if (*uchar < map->uchar) {
+    val = -1;
+  } else {
+    val = 0;
+  }
+  return val;
