index 0000000000000000000000000000000000000000..dfc873cd39dd70debf30abd92e720ef8c26ed7d2
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_pad.c
@@ -0,0 +1,400 @@
