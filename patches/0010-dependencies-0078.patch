index 0000000000000000000000000000000000000000..cde17d246a186614280d2f3ebb199bc8d55ac595
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_w3fdif.c
@@ -0,0 +1,480 @@
+/*
