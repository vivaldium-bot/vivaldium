+				  :src:type42:type42.c \xB6
+				  :src:winfonts:winfnt.c
+
+
+### Object Files ###
+
+ObjFiles-68K    =  \xB6
+				  "{ObjDir}autofit.c.o" \xB6
+				  "{ObjDir}ftbase.c.o" \xB6
+				  "{ObjDir}ftbbox.c.o" \xB6
+				  "{ObjDir}ftbdf.c.o" \xB6
