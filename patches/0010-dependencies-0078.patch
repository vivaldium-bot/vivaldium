diff --git a/third_party/freetype-android/src/docs/CUSTOMIZE b/third_party/freetype-android/src/docs/CUSTOMIZE
new file mode 100644
index 0000000000000000000000000000000000000000..e8817b72b60ff2de8009f5727e7f530c5e6fdbec
--- /dev/null
