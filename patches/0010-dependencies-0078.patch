+
+    STAssertEqualObjects(
+      LikeGlobTestHelper(db,
+                         @"SELECT x from t1 where x LIKE 'a[xyz]\\%' "
+                         @"ESCAPE '\\'"),
+      ([NSArray array]),
+      @"Literal percent match using ESCAPE clause did not return empty result "
