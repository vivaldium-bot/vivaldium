+    typeTrue,
+    typeFalse,
+    typeBoolean,
+    typeSInt16,
+    typeSInt32,
+    typeUInt32,
+    typeSInt64,
+    typeIEEE32BitFloatingPoint,
+    typeIEEE64BitFloatingPoint };
