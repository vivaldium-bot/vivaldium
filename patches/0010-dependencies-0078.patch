--- /dev/null
+++ b/third_party/freetype-android/src/src/base/ftrfork.c
@@ -0,0 +1,880 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ftrfork.c                                                              */
+/*                                                                         */
+/*    Embedded resource forks accessor (body).                             */
+/*                                                                         */
+/*  Copyright 2004-2016 by                                                 */
