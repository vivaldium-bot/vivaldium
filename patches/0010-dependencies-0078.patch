+bool isEtcFormat (CompressedTexFormat format)
+{
+	switch (format)
+	{
+		case COMPRESSEDTEXFORMAT_ETC1_RGB8:
+		case COMPRESSEDTEXFORMAT_EAC_R11:
+		case COMPRESSEDTEXFORMAT_EAC_SIGNED_R11:
+		case COMPRESSEDTEXFORMAT_EAC_RG11:
