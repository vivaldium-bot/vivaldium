+  // test no match
+  segments = [@"aaa" gtm_allSubstringsMatchedByPattern:@"foo+ba+r"];
+  STAssertNotNil(segments, nil);
+  STAssertEquals((NSUInteger)0, [segments count], nil);
+
+  // test only match
+  segments = [@"foobar" gtm_allSubstringsMatchedByPattern:@"foo+ba+r"];
