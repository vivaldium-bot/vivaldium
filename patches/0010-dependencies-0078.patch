++ (id)gtm_descriptorWithPositionalHandler:(NSString*)handler 
+                          parametersArray:(NSArray*)params {
+  return [[[self alloc] gtm_initWithPositionalHandler:handler 
+                                      parametersArray:params] autorelease];
+}
