++ (id)gtm_descriptorWithLabeledHandler:(NSString*)handler
+                                labels:(AEKeyword*)labels
+                            parameters:(id*)params
+                                 count:(NSUInteger)count {
+  return [[[self alloc] gtm_initWithLabeledHandler:handler
+                                            labels:labels
+                                        parameters:params
+                                             count:count] autorelease];
+}
