+;******************************************************************************
+
+%include "libavutil/x86/x86util.asm"
+
+SECTION_RODATA
+
+SECTION .text
+
+%macro LOWPASS_LINE 0
+cglobal lowpass_line, 5, 5, 7
+    add r0, r1
+    add r2, r1
+    add r3, r1
+    add r4, r1
+    neg r1
+
+    pcmpeqb m6, m6
+
+.loop:
+    mova m0, [r3+r1]
+    mova m1, [r3+r1+mmsize]
+    pavgb m0, [r4+r1]
+    pavgb m1, [r4+r1+mmsize]
+    pxor m0, m6
+    pxor m1, m6
+    pxor m2, m6, [r2+r1]
+    pxor m3, m6, [r2+r1+mmsize]
+    pavgb m0, m2
+    pavgb m1, m3
+    pxor m0, m6
+    pxor m1, m6
+    mova [r0+r1], m0
+    mova [r0+r1+mmsize], m1
+
+    add r1, 2*mmsize
+    jl .loop
+REP_RET
+%endmacro
+
+INIT_XMM sse2
+LOWPASS_LINE
+
+INIT_XMM avx
+LOWPASS_LINE
