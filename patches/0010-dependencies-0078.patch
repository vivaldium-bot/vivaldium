index 0000000000000000000000000000000000000000..6b683aed2d7714576d979042a815cfc76dbabf24
--- /dev/null
+++ b/third_party/google_toolbox_for_mac/src/Foundation/GTMGeometryUtils.h
@@ -0,0 +1,463 @@
+//
+//  GTMGeometryUtils.h
+//
+//  Utilities for geometrical utilities such as conversions
+//  between different types.
+//
