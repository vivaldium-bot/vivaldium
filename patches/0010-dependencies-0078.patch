+      @"0-Character escape clause did not return empty set 4.4");
+
+    STAssertEqualObjects(
+      LikeGlobTestHelper(db,
+                         @"SELECT x from t1 where x LIKE "
+                         @"'a[xyz]\%' ESCAPE NULL"),
