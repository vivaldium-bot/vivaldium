+
+#include "src/core/lib/transport/transport.h"
+
+typedef struct {
+  grpc_linked_mdelem *elems;
+  size_t count;
+  size_t capacity;
+  gpr_timespec deadline;
+  int published;
+  size_t size;  // total size of metadata
+} grpc_chttp2_incoming_metadata_buffer;
