+- (void)testScanUnsignedInt {
+  struct {
+    NSString *string;
+    unsigned int val;
+    BOOL goodScan;
+    NSUInteger location;
+  } testStruct[] = {
+    TEST_BLOCK(UINT_MAX),
+  };
+  for (size_t i = 0; i < sizeof(testStruct) / sizeof(testStruct[0]); ++i) {
