index 0000000000000000000000000000000000000000..efa0140f5411fbb9943ebfbfa49f328e1ec832b0
--- /dev/null
+++ b/third_party/grpc/src/core/lib/iomgr/tcp_client_windows.c
@@ -0,0 +1,231 @@
+/*
+ *
