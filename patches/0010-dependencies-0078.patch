+#include "libavutil/time_internal.h"
+#include "avformat.h"
+#include "internal.h"
+
+#define ISLEAP(y) (((y) % 4 == 0) && (((y) % 100) != 0 || ((y) % 400) == 0))
+#define LEAPS_COUNT(y) ((y)/4 - (y)/100 + (y)/400)
+
+/* This is our own gmtime_r. It differs from its POSIX counterpart in a
+   couple of places, though. */
+struct tm *ff_brktimegm(time_t secs, struct tm *tm)
+{
+    tm = gmtime_r(&secs, tm);
+
+    tm->tm_year += 1900; /* unlike gmtime_r we store complete year here */
+    tm->tm_mon  += 1;    /* unlike gmtime_r tm_mon is from 1 to 12 */
+
+    return tm;
+}
diff --git a/third_party/ffmpeg/libavformat/dashenc.c b/third_party/ffmpeg/libavformat/dashenc.c
new file mode 100644
index 0000000000000000000000000000000000000000..534fa754b4dd418852e71ec72034d0d8ae09b5ea
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/dashenc.c
@@ -0,0 +1,1056 @@
+/*
+ * MPEG-DASH ISO BMFF segmenter
+ * Copyright (c) 2014 Martin Storsjo
+ *
