index 0000000000000000000000000000000000000000..acf1b20847ca26ad96ec470ee16042eb0238aa1f
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/window_func.c
@@ -0,0 +1,178 @@
+/*
