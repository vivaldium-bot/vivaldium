+static void parseIntList (const char* src, std::vector<int>* dst)
+{
+	std::istringstream	str	(src);
+	std::string			val;
+
+	while (std::getline(str, val, ','))
+	{
+		int intVal = 0;
+		de::cmdline::parseType(val.c_str(), &intVal);
+		dst->push_back(intVal);
+	}
+}
