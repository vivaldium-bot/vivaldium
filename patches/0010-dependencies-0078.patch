+
+FreeType.m68k_cfm    \xC4\xC4  FreeType.m68k_cfm.o
+
+FreeType.m68k_cfm.o  \xC4\xC4  {ObjFiles-68K} {LibFiles-68K} {\xA5MondoBuild\xA5}
