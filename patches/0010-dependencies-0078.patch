+- (int)setBusyTimeoutMS:(int)timeoutMS {
+  int rc = sqlite3_busy_timeout(db_, timeoutMS);
+  if (rc == SQLITE_OK) {
+    timeoutMS_ = timeoutMS;
+  }
+  return rc;
+}
