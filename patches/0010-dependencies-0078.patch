+  { @" - 1", 0, NO, 0 }, \
+  { @"+ 1", 1, NO, 0 }, \
+  { @" + 1", 1, NO, 0 }, \
+  { @"0", 0, YES, 1 }, \
+  { @"a", 0, NO, 0 }, \
+  { @" ", 0, NO, 0 }, \
+  { @"-1a", 0, NO, 0 }, \
+  { @"a1", 0, NO, 0 }, \
+  { @"1 ", 1, YES, 1 }, \
+  { @"2 1 ", 2, YES, 1 }, \
+  { @" 2 1 ", 2, YES, 2 }, \
+  { @"99999999999999999999999999999999999", A_MAX_VALUE, YES, 35 }
