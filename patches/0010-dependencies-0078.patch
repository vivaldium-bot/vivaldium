index 0000000000000000000000000000000000000000..2cb8205d942f09a26cfdae107acb95031f086227
--- /dev/null
+++ b/third_party/grpc/src/core/ext/transport/chttp2/transport/hpack_encoder.c
@@ -0,0 +1,577 @@
