index 0000000000000000000000000000000000000000..fbf27ea04fe4a377be4fec8307a903a9239f8f12
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_deband.c
@@ -0,0 +1,312 @@
+/*
