+      = [NSAppleEventDescriptor gtm_descriptorWithDouble:value];
+    STAssertNotNil(desc, @"Value: %g", value);
+    double returnedValue = [desc gtm_doubleValue];
+    STAssertEquals(value, returnedValue, @"Value: %g", value);
+  }
+}
