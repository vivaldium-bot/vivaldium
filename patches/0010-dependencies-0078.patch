index 0000000000000000000000000000000000000000..cf925bd211a2c110d2ad27fa1ddbb75178c23b1b
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_ssim.c
@@ -0,0 +1,509 @@
+/*
