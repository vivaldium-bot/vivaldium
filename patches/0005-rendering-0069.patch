-
-  var tmpl = ["div", {"id":"${test_id}"},
-              ["h2", {}, "${test_id}"],
-              function(vars) {
-                if (vars.container !== null) {
-                  return ["div", {"class":"container"},
-                  ["h3", {}, "innerHTML Container"],
-                  ["pre", {}, vars.container]];
-                } else {
-                  return null;
-                }
-              },
-              ["div", {"id":"input_${test_id}"}, ["h3", {}, "Input"], ["pre", {},
