+        switch (classify(testcases[i]))
+        {
+        case zero:
+        case non_zero:
+            assert(r == testcases[i]);
+            assert(std::signbit(real(r)) == std::signbit(real(testcases[i])));
+            assert(std::signbit(imag(r)) == std::signbit(imag(testcases[i])));
