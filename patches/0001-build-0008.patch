diff --git a/buildtools/third_party/libc++/trunk/test/std/numerics/numeric.ops/numeric.ops.gcd/gcd.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/numerics/numeric.ops/numeric.ops.gcd/gcd.pass.cpp
