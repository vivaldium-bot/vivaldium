+                    /** @type {number} */ var val3 = (w << 30) | (z << 20) | (y2 << 10) | x1;
+
+                    /** @type {number} */ var val4 = (w << 30) | (z << 20) | (y2 << 10) | x1;
+                    /** @type {number} */ var val5 = (w << 30) | (z << 20) | (y1 << 10) | x2;
