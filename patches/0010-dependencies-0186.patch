+    glsVertexArrayTests.ContextShaderProgram.prototype.genVertexSource = function(arrays) {
+        var vertexShaderSrc = '';
+        var params = [];
+
+        params['VTX_IN'] = 'in';
+        params['VTX_OUT'] = 'out';
+        params['FRAG_IN'] = 'in';
