+    var reference = new tcuSurface.Surface(
+        result.getWidth(), result.getHeight()
+    );
+    /** @type {tcuSurface.Surface} */
+    var errorMask = new tcuSurface.Surface(
+        result.getWidth(), result.getHeight()
+    );
