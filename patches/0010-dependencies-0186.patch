+     * @param {glsVertexArrayTests.deArray.Primitive} primitive
+     * @param {glsVertexArrayTests.GLValue} min
+     * @param {glsVertexArrayTests.GLValue} max
+     * @param {number} scale Coordinate scaling factor
+     * @return {ArrayBuffer}
