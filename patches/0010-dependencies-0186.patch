+    } else
+    tcuTestCase.runner.terminate();
+
+};
+
+glsShaderLibraryCase.genValueBlock = function() {
+    return {
+    /** @type {Array} */ values: [],
+    /** @type {number} */ arrayLength: 0
+    };
+};
+
+});
