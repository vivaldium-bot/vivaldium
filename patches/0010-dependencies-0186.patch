+                /** @const @type {string} */ var valueName = val.valueName;
+                /** @const @type {gluShaderUtil.DataType} */ var dataType = val.dataType;
+                /** @const @type {number} */ var scalarSize = gluShaderUtil.getDataTypeScalarSize(val.dataType);
