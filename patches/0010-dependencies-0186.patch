+
+    assertMsgOptions(gl.getError() === gl.NO_ERROR, '', true, true);
+    setCurrentTestName('');
+
+    return true;
+};
+
+glsShaderLibraryCase.runTestCases = function() {
+/** @type {Object} */ var state = tcuTestCase.runner;
+    if (state.next()) {
+        try {
+            glsShaderLibraryCase.init();
+            glsShaderLibraryCase.execute();
