+glsUniformBlockCase.BlockPointers = function() {
+    /** @type {ArrayBuffer} */ this.data; //!< Data (vector<deUint8>).
+    /** @type {Array<number>} */ this.offsets = []; //!< Reference block pointers (map<int, void*>).
+    /** @type {Array<number>} */ this.sizes = [];
