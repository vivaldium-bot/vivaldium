+static bool allLayersAreFixed(const FillLayer& layer)
+{
+    for (const FillLayer* currLayer = &layer; currLayer; currLayer = currLayer->next()) {
+        if (!currLayer->image() || currLayer->attachment() != FixedBackgroundAttachment)
+            return false;
+    }
+
+    return true;
+}
