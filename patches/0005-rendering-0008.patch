index 0000000000000000000000000000000000000000..3dce641df39b86ccb49c3bbe1a2c7d267461e0bc
--- /dev/null
+++ b/third_party/WebKit/Source/core/layout/svg/SVGTextMetricsBuilder.cpp
@@ -0,0 +1,277 @@
