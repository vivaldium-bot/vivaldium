+    int offset() const { return m_offset; }
+    void setOffset(int offset) { m_offset = offset; }
+
+    OutlineIsAuto isAuto() const { return static_cast<OutlineIsAuto>(m_isAuto); }
+    void setIsAuto(OutlineIsAuto isAuto) { m_isAuto = isAuto; }
+
+private:
+    int m_offset;
+};
