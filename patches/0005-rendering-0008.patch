+#include "wtf/Vector.h"
+#include <v8.h>
+
+namespace blink {
+
+    class Document;
+    class DocumentLoader;
+    class FetchRequest;
+    class HTMLAppletElement;
+    class HTMLFormElement;
+    class HTMLFrameOwnerElement;
+    class HTMLPlugInElement;
