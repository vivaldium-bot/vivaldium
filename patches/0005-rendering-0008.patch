+void SVGAnimatedNumberOptionalNumber::animationEnded()
+{
+    SVGAnimatedPropertyCommon<SVGNumberOptionalNumber>::animationEnded();
+    m_firstNumber->animationEnded();
+    m_secondNumber->animationEnded();
+}
