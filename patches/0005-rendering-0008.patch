+
+ApplicationCache::ApplicationCache(LocalFrame* frame)
+    : DOMWindowProperty(frame)
+{
+    ApplicationCacheHost* cacheHost = applicationCacheHost();
+    if (cacheHost)
+        cacheHost->setApplicationCache(this);
