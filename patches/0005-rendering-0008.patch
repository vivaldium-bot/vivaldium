index 0000000000000000000000000000000000000000..bbd4503917039afa145ae4895cbb7616053e24cc
--- /dev/null
+++ b/third_party/WebKit/Source/core/svg/SVGAnimateMotionElement.cpp
@@ -0,0 +1,325 @@
+/*
