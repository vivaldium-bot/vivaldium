index 0000000000000000000000000000000000000000..c1dadc4a60c7ff30c6c12c251e299ce915577325
--- /dev/null
+++ b/third_party/WebKit/Source/core/page/WindowFeatures.cpp
@@ -0,0 +1,267 @@
+/*
+ *  Copyright (C) 2000 Harri Porten (porten@kde.org)
+ *  Copyright (C) 2006 Jon Shier (jshier@iastate.edu)
+ *  Copyright (C) 2003, 2004, 2005, 2006, 2007, 2010 Apple Inc. All rights reseved.
+ *  Copyright (C) 2006 Alexey Proskuryakov (ap@webkit.org)
