+    EXPECT_NE(promise, cancelResult);
+    EXPECT_EQ(ReadableStream::Closed, stream->stateInternal());
+
+    EXPECT_TRUE(onCancelFulfilled.isNull());
+    EXPECT_TRUE(onCancelRejected.isNull());
+
