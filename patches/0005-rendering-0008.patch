+        : m_offset(0)
+    {
+    }
+
+    bool operator==(const OutlineValue& o) const
+    {
+        return BorderValue::operator==(o) && m_offset == o.m_offset && m_isAuto == o.m_isAuto;
+    }
+
+    bool operator!=(const OutlineValue& o) const
+    {
+        return !(*this == o);
+    }
+
+    bool visuallyEqual(const OutlineValue& o) const
+    {
+        if (m_style == BNONE && o.m_style == BNONE)
+            return true;
+        return *this == o;
+    }
