index 0000000000000000000000000000000000000000..23b80c4071d799e9124ee75b291f7df8ac066978
--- /dev/null
+++ b/third_party/WebKit/Source/core/page/SpatialNavigation.cpp
@@ -0,0 +1,634 @@
