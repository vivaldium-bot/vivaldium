+private:
+    FilterEffectBuilder();
+
+    RefPtrWillBeMember<FilterEffect> m_lastEffect;
+    WillBeHeapVector<RefPtrWillBeMember<ReferenceFilter>> m_referenceFilters;
+};
+
+} // namespace blink
+
+#endif // FilterEffectBuilder_h
