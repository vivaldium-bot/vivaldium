+    unsigned scopedChildCount(TreeScope*) const;
+
+    RawPtrWillBeMember<Frame> m_thisFrame;
+
+    AtomicString m_name; // The actual frame name (may be empty).
+    AtomicString m_uniqueName;
+
+    mutable unsigned m_scopedChildCount;
+};
