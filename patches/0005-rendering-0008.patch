+    String m_urlString;
+    Referrer m_referrer;
+    String m_target;
+
+    FloatPoint m_pinchViewportScrollPoint;
+    IntPoint m_scrollPoint;
+    float m_pageScaleFactor;
+    Vector<String> m_documentStateVector;
+    RefPtrWillBeMember<DocumentState> m_documentState;
