-
-controls : String -> List Todo.Task.Model -> Html Msg
-controls visibility tasks =
-    let
-        tasksCompleted =
-            List.length (List.filter .completed tasks)
-
-        tasksLeft =
-            List.length tasks - tasksCompleted
-
-        item_ =
-            if tasksLeft == 1 then
-                " item"
-            else
-                " items"
