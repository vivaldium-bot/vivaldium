+#endif  // WEBRTC_LIBJINGLE_XMPP_SASLMECHANISM_H_
diff --git a/third_party/webrtc/libjingle/xmpp/saslplainmechanism.h b/third_party/webrtc/libjingle/xmpp/saslplainmechanism.h
