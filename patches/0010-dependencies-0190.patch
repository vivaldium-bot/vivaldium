+}
+
+TEST(WebRtcMediaEngineTest, ValidateRtpExtensions_OverlappingIds_StartOfSet) {
+  std::vector<RtpExtension> extensions = MakeUniqueExtensions();
+  extensions.push_back(RtpExtension("foo", 1));
