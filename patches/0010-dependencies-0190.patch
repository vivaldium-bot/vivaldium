+WebRtcVoiceEngine::~WebRtcVoiceEngine() {
+  RTC_DCHECK(worker_thread_checker_.CalledOnValidThread());
+  LOG(LS_INFO) << "WebRtcVoiceEngine::~WebRtcVoiceEngine";
+  StopAecDump();
+  voe_wrapper_->base()->Terminate();
+  webrtc::Trace::SetTraceCallback(nullptr);
+}
