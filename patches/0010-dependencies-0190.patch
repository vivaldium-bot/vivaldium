+#ifndef WEBRTC_MEDIA_BASE_MEDIAENGINE_H_
+#define WEBRTC_MEDIA_BASE_MEDIAENGINE_H_
+
+#if defined(WEBRTC_MAC) && !defined(WEBRTC_IOS)
+#include <CoreAudio/CoreAudio.h>
+#endif
+
+#include <string>
+#include <vector>
+
+#include "webrtc/audio_state.h"
