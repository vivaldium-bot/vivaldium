+SctpDataMediaChannel::SctpDataMediaChannel(rtc::Thread* thread)
+    : worker_thread_(thread),
+      local_port_(kSctpDefaultPort),
+      remote_port_(kSctpDefaultPort),
+      sock_(NULL),
+      sending_(false),
+      receiving_(false),
+      debug_name_("SctpDataMediaChannel") {
+}
