index 0000000000000000000000000000000000000000..4244d5c80996a6a0762af5d31fed811bb222b3a7
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/g722/g722_interface.c
@@ -0,0 +1,107 @@
+/*
