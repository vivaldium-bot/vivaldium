+  int DrainOutgoingPackets() {
+    int packets = 0;
+    do {
+      packets = NumRtpPackets();
+      // 100 ms should be long enough.
+      rtc::Thread::Current()->ProcessMessages(100);
+    } while (NumRtpPackets() > packets);
+    return NumRtpPackets();
+  }
