+        ASSERT_TRUE(frame1);
+        T frame2;
+        EXPECT_TRUE(LoadFrame(ms.get(), cricket::FOURCC_ARGB,
+                              width, height, &frame2));
+        EXPECT_TRUE(IsEqual(*frame1, frame2, 64));
+      }
+    }
+    // Test a practical window size for screencasting usecase.
+    const int kOddWidth = 1228;
+    const int kOddHeight = 260;
