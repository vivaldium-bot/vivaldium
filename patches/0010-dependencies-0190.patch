+
+class ScreenshareLayerConfigTest : public testing::Test,
+                                   protected ScreenshareLayerConfig {
+ public:
+  ScreenshareLayerConfigTest() : ScreenshareLayerConfig(0, 0) {}
+
+  void ExpectParsingFails(const std::string& group) {
