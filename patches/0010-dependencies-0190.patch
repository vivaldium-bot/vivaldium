+// Called on the worker thread.
+DataMediaChannel* SctpDataEngine::CreateChannel(
+    DataChannelType data_channel_type) {
+  if (data_channel_type != DCT_SCTP) {
+    return NULL;
+  }
+  return new SctpDataMediaChannel(rtc::Thread::Current());
