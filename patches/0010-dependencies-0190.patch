+class WebRtcVoiceMediaChannel::WebRtcAudioReceiveStream {
+ public:
+  WebRtcAudioReceiveStream(
+      int ch,
+      uint32_t remote_ssrc,
+      uint32_t local_ssrc,
+      bool use_transport_cc,
+      bool use_nack,
+      const std::string& sync_group,
