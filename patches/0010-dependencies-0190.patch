+                            int dh,
+                            uint8_t* sample,
+                            size_t sample_size,
+                            int64_t time_stamp_ns,
+                            webrtc::VideoRotation rotation) {
+  return Reset(format, w, h, dw, dh, sample, sample_size,
+               time_stamp_ns / rtc::kNumNanosecsPerMicrosec, rotation,
+               true /*apply_rotation*/);
+}
