+    last_packet = NumRtpPackets() - 1;
+    p.reset(GetRtpPacket(static_cast<int>(last_packet)));
+    ParseRtpPacket(p.get(), NULL, NULL, NULL, NULL, &ssrc, NULL);
+    EXPECT_EQ(789u, ssrc);
