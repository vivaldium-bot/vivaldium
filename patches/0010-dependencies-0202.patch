+class VoEAudioProcessingTest : public ::testing::Test {
+ protected:
+  VoEAudioProcessingTest()
+      : voe_(VoiceEngine::Create()),
+        base_(VoEBase::GetInterface(voe_)),
+        audioproc_(VoEAudioProcessing::GetInterface(voe_)) {}
