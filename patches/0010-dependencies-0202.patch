+  EXPECT_TRUE(safe_cmp::Le(p1, p1));
+  EXPECT_TRUE(safe_cmp::Le(p1, p2));
+  EXPECT_FALSE(safe_cmp::Le(p2, p1));
+  EXPECT_TRUE(safe_cmp::Le(p2, p2));
+}
+
+TEST(SafeCmpTest, Gt) {
