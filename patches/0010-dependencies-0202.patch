+int32_t UdpTransportImpl::SourcePorts(uint16_t& rtpPort,
+                                      uint16_t& rtcpPort) const
+{
+    CriticalSectionScoped cs(_crit);
+
+    rtpPort  = (_srcPort != 0) ? _srcPort : _localPort;
+    rtcpPort = (_srcPortRTCP != 0) ? _srcPortRTCP : _localPortRTCP;
+    return 0;
+}
