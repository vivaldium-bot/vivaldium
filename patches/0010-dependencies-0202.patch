index 0000000000000000000000000000000000000000..42679d987f4a6cfec4daa5007e1ee5d43c922374
--- /dev/null
+++ b/third_party/webrtc/base/criticalsection_unittest.cc
@@ -0,0 +1,414 @@
+/*
