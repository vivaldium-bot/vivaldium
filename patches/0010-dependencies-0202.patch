+
+_DO_NOT_EDIT_WARNING = """<!--
+
+This file is auto-generated from fbocolorbuffer_test_generator.py
+DO NOT EDIT!
+
+-->
+
+"""
+
+_HTML_TEMPLATE = """<html>
+<head>
+<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
