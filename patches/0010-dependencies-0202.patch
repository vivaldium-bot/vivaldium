+  if (voe_volume_control_) {
+    voe_volume_control_->Release();
+    voe_volume_control_ = NULL;
+  }
+  if (voe_rtp_rtcp_) {
+    voe_rtp_rtcp_->Release();
+    voe_rtp_rtcp_ = NULL;
+  }
+  if (voe_apm_) {
+    voe_apm_->Release();
+    voe_apm_ = NULL;
+  }
+  if (voe_network_) {
+    voe_network_->Release();
+    voe_network_ = NULL;
+  }
+  if (voe_file_) {
+    voe_file_->Release();
+    voe_file_ = NULL;
+  }
+#ifdef _TEST_VIDEO_SYNC_
+  if (voe_vsync_) {
+    voe_vsync_->Release();
+    voe_vsync_ = NULL;
+  }
+#endif
+  if (voe_hardware_) {
+    voe_hardware_->Release();
+    voe_hardware_ = NULL;
+  }
+#ifdef _TEST_XMEDIA_
+  if (voe_xmedia_) {
+    voe_xmedia_->Release();
