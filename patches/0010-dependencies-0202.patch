+OpenSSLIdentity::OpenSSLIdentity(OpenSSLKeyPair* key_pair,
+                                 OpenSSLCertificate* certificate)
+    : key_pair_(key_pair), certificate_(certificate) {
+  RTC_DCHECK(key_pair != NULL);
+  RTC_DCHECK(certificate != NULL);
+}
