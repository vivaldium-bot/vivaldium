+    es3fTextureFilteringTests.Texture2DArrayFilteringCase.prototype.iterate =
+    function() {
+        /** @type {glsTextureTestUtil.RandomViewport} */
+        var viewport = new glsTextureTestUtil.RandomViewport(
+            gl.canvas, TEX3D_VIEWPORT_WIDTH,
