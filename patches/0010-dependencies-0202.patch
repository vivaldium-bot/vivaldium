+
+        /** @type {glsTextureTestUtil.ReferenceParams} */
+        var refParams = new glsTextureTestUtil.ReferenceParams(
+            glsTextureTestUtil.textureType.TEXTURETYPE_2D_ARRAY
+        );
+
+        /** @type {tcuSurface.Surface} */
