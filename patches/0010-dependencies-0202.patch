+  PROXY_WORKER_METHOD1(std::string, Method1, std::string)
+  PROXY_CONSTMETHOD1(std::string, ConstMethod1, std::string)
+  PROXY_WORKER_METHOD2(std::string, Method2, std::string, std::string)
+END_PROXY()
