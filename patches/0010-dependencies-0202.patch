index 0000000000000000000000000000000000000000..87fc8d911b613f5d36c100b1b22e82710b3b5984
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/tests/leb128_test.c
@@ -0,0 +1,199 @@
+/*
+ *
