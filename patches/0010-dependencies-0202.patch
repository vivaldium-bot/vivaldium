+void VoETestManager::GetInterfaces() {
+  if (voice_engine_) {
+    voe_base_ = VoEBase::GetInterface(voice_engine_);
+    voe_codec_ = VoECodec::GetInterface(voice_engine_);
+    voe_volume_control_ = VoEVolumeControl::GetInterface(voice_engine_);
