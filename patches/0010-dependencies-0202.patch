+#ifndef WEBRTC_API_WEBRTCSESSIONDESCRIPTIONFACTORY_H_
+#define WEBRTC_API_WEBRTCSESSIONDESCRIPTIONFACTORY_H_
+
+#include <memory>
+
+#include "webrtc/api/peerconnectioninterface.h"
