diff --git a/third_party/xdg-utils/tests/debug/t.failoverride b/third_party/xdg-utils/tests/debug/t.failoverride
new file mode 100755
index 0000000000000000000000000000000000000000..c3cf2576df937365f2666fff11a054909d94742a
--- /dev/null
+++ b/third_party/xdg-utils/tests/debug/t.failoverride
@@ -0,0 +1,17 @@
+#!/bin/bash
+
+. "$XDG_TEST_DIR/include/testassertions.sh"
+. "$XDG_TEST_DIR/include/testcontrol.sh"
