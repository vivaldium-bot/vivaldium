+            scale *= 0.5;
+
+            vtx +=
+                '\tgl_Position = vec4(' + scale + ' * ' + 'a_attrib0.xyz, 1.0);\n' +
+                '}';
+        }
+    }
+
+    var fragmentShader =
+        '#version 300 es\n' +
+        'in mediump vec4 v_value;\n' +
+        'layout(location = 0) out mediump vec4 fragColor;\n' +
+        'void main (void)\n' +
+        '{\n' +
+        '\tfragColor = vec4(v_value.xyz, 1.0);\n' +
+        '}';
