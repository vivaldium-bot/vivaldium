+    WEBRTC_TRACE(kTraceMemory, kTraceTransport, id,
+                 "UdpSocketWrapper::CreateSocket");
+
+    UdpSocketWrapper* s = 0;
+
+#ifdef _WIN32
+    if (!_initiated)
+    {
+        WSADATA wsaData;
+        WORD wVersionRequested = MAKEWORD( 2, 2 );
+        int32_t err = WSAStartup( wVersionRequested, &wsaData);
+        if (err != 0)
+        {
+            WEBRTC_TRACE(
