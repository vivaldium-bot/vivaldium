+  uint32_t priority = 1000;
+
+  cricket::Candidate c;
+  ASSERT(c.id().length() > 0);
+  c.set_type(cricket::LOCAL_PORT_TYPE);
+  c.set_protocol(cricket::UDP_PROTOCOL_NAME);
