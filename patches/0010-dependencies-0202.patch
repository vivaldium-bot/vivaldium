+#endif
+#ifdef WEBRTC_VOICE_ENGINE_NETEQ_STATS_API
+  if (voe_neteq_stats_) {
+    voe_neteq_stats_->Release();
+    voe_neteq_stats_ = NULL;
+  }
+#endif
+  if (false == VoiceEngine::Delete(voice_engine_)) {
+    TEST_LOG("\n\nVoiceEngine::Delete() failed. \n");
+    releaseOK = false;
+  }
+
+  return (releaseOK == true) ? 0 : -1;
+}
