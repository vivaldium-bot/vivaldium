+        var data = new ArrayBuffer(slicePitch * this.m_depth);
+        var access = new tcuTexture.PixelBufferAccess({
+                            format: this.m_texFormat,
+                            width: this.m_width,
+                            height: this.m_height,
+                            depth: this.m_depth,
+                            rowPitch: rowPitch,
+                            slicePitch: slicePitch,
+                            data: data
