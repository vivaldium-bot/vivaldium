+VoECodecImpl::VoECodecImpl(voe::SharedData* shared) : _shared(shared) {
+  WEBRTC_TRACE(kTraceMemory, kTraceVoice, VoEId(_shared->instance_id(), -1),
+               "VoECodecImpl() - ctor");
+}
