+int
+yasm_object_sections_traverse(yasm_object *object, /*@null@*/ void *d,
+                              int (*func) (yasm_section *sect,
+                                           /*@null@*/ void *d))
+{
+    yasm_section *cur;
+
+    STAILQ_FOREACH(cur, &object->sections, link) {
+        int retval = func(cur, d);
+        if (retval != 0)
+            return retval;
+    }
+    return 0;
+}
