+
+int VoECodecImpl::GetOpusDtxStatus(int channel, bool* enabled) {
+  WEBRTC_TRACE(kTraceApiCall, kTraceVoice, VoEId(_shared->instance_id(), -1),
+               "GetOpusDtx(channel=%d)", channel);
