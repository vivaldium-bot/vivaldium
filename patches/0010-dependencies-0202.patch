+        _remoteRTPAddr._sockaddr_in6.sin6_port = Htons(_destPort);
+        InetPresentationToNumeric(AF_INET6,_destIP,
+                                  &_remoteRTPAddr._sockaddr_in6.sin6_addr);
+    } else
+    {
+#ifdef HAVE_STRUCT_SOCKADDR_SA_LEN
