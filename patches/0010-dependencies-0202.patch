+    es3fTextureFilteringTests.Texture2DArrayFilteringCase.prototype.init =
+    function() {
+        try {
+            /** @type {tcuTexture.TextureFormat} */
+            var texFmt = gluTextureUtil.mapGLInternalFormat(
