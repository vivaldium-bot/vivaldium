+setAfter (int length)
+{
+  if ((src + length + 2) < srcmax && currentInput[src + 1] == ENDSEGMENT)
+    after = currentInput[src + 2];
+  else
+    after = (src + length < srcmax) ? currentInput[src + length] : ' ';
+  afterAttributes = (findCharOrDots (after, 0))->attributes;
+}
