+static void *
+reallocWrapper (void *address, size_t size)
+{
+  if (!(address = realloc (address, size)) && size)
+    outOfMemory ();
+  return address;
+}
+
+static char *
+strdupWrapper (const char *string)
+{
+  char *address = strdup (string);
+  if (!address)
+    outOfMemory ();
+  return address;
+}
