+static int
+compareDots (const widechar * address1, const widechar * address2, int count)
+{
+  int k;
+  if (!count)
+    return 0;
+  for (k = 0; k < count; k++)
+    if (address1[k] != address2[k])
+      return 0;
+  return 1;
+}
