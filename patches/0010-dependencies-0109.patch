+
+    /* Range limit */
+    movi            v30.8h, #0x80
+    ins             v26.d[1], v27.d[0]
+    ins             v28.d[1], v29.d[0]
+    add             v26.8h, v26.8h, v30.8h
+    add             v28.8h, v28.8h, v30.8h
+    sqxtun          v26.8b, v26.8h
+    sqxtun          v27.8b, v28.8h
+
