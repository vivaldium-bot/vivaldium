diff --git a/third_party/libjpeg_turbo/cderror.h b/third_party/libjpeg_turbo/cderror.h
new file mode 100644
index 0000000000000000000000000000000000000000..63de498f779f3ece054600c68df6a2dc3254c7a2
--- /dev/null
+++ b/third_party/libjpeg_turbo/cderror.h
@@ -0,0 +1,136 @@
+/*
