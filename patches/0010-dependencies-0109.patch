+setBefore ()
+{
+  if (src >= 2 && currentInput[src - 1] == ENDSEGMENT)
+    before = currentInput[src - 2];
+  else
+    before = (src == 0) ? ' ' : currentInput[src - 1];
+  beforeAttributes = (findCharOrDots (before, 0))->attributes;
