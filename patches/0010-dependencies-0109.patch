+                    'nss/lib/freebl/mpi/mpi_x86_asm.c',
+                  ],
+                }],
+              ],
+            }, { # else: OS!="win"
+              'sources!': [
+                'nss/lib/freebl/intel-aes-x86-masm.asm',
