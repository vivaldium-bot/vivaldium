diff --git a/third_party/libaddressinput/src/cpp/test/retriever_test.cc b/third_party/libaddressinput/src/cpp/test/retriever_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..00c2ea45e325a3ead8a9899bf657cdcede3690de
--- /dev/null
+++ b/third_party/libaddressinput/src/cpp/test/retriever_test.cc
@@ -0,0 +1,178 @@
+// Copyright (C) 2013 Google Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
