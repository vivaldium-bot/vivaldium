+      LOG_ERROR(device, "ioctl EVIOCGMTSLOTS(req.code=%d) failed: %s\n",
+                req->code, strerror(errno));
+      return !Success;
+  } else {
+      return Success;
+  }
+}
+
+int EvdevProbeKeyState(EvdevPtr device) {
