+
+static int
+getNumber (widechar * source, widechar * dest)
+{
+/*Convert a string of wide character digits to an integer*/
+  int k = 0;
+  *dest = 0;
+  while (source[k] >= '0' && source[k] <= '9')
+    *dest = 10 * *dest + (source[k++] - '0');
+  return k;
+}
