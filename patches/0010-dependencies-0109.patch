diff --git a/third_party/nss/nss/lib/dev/nssdevt.h b/third_party/nss/nss/lib/dev/nssdevt.h
new file mode 100644
index 0000000000000000000000000000000000000000..b7b7b1e49f28e4cd614abd96c932805ccbf2ecad
--- /dev/null
+++ b/third_party/nss/nss/lib/dev/nssdevt.h
@@ -0,0 +1,36 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef NSSDEVT_H
+#define NSSDEVT_H
+
+/*
+ * nssdevt.h
+ *
+ * This file contains definitions for the low-level cryptoki devices.
+ */
+
+#ifndef NSSBASET_H
