+    psrlq  mm2, 32		; save the carry
+    dec    ecx			; --a_len
+    jnz    L_15			; jmp if a_len != 0
+L_16:
+    movd   [edi], mm2		; *c = carry
+    emms
+    pop    esi
+    pop    edi
+    leave  
+    ret    
+    nop
