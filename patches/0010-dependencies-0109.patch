+        SECTION SEG_CONST
+
+        alignz  16
+        global  EXTN(jconst_idct_islow_sse2) PRIVATE
+
+EXTN(jconst_idct_islow_sse2):
+
+PW_F130_F054    times 4 dw  (F_0_541+F_0_765), F_0_541
+PW_F054_MF130   times 4 dw  F_0_541, (F_0_541-F_1_847)
