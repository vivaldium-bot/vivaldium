+      // Our PreloadSupplier loads all data for a country at a time.
+      : supplier_(new TestdataSource(true), new NullStorage),
+        address_input_helper_(&supplier_),
+        loaded_(BuildCallback(this, &AddressInputHelperTest::Loaded)) {}
