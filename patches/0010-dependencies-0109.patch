+static int
+checkMultCaps ()
+{
+  int k;
+  for (k = 0; k < table->lenBeginCaps; k++)
+    if (k >= srcmax - src ||
+	!checkAttr (currentInput[src + k], CTC_UpperCase, 0))
+      return 0;
+  return 1;
+}
