diff --git a/third_party/libjpeg_turbo/jdcolext.c b/third_party/libjpeg_turbo/jdcolext.c
new file mode 100644
index 0000000000000000000000000000000000000000..59b676cc4dda4f5581fc881611d46c7abf637852
--- /dev/null
+++ b/third_party/libjpeg_turbo/jdcolext.c
@@ -0,0 +1,143 @@
+/*
+ * jdcolext.c
+ *
