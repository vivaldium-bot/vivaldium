+        alignz  16
+        global  EXTN(jconst_fdct_islow_mmx) PRIVATE
+
+EXTN(jconst_fdct_islow_mmx):
+
+PW_F130_F054    times 2 dw  (F_0_541+F_0_765), F_0_541
+PW_F054_MF130   times 2 dw  F_0_541, (F_0_541-F_1_847)
