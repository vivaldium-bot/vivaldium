index 0000000000000000000000000000000000000000..c13850a83f5ce9313d17c29a9a24dc6c17ffd1ac
--- /dev/null
+++ b/third_party/libjpeg_turbo/simd/jfdctint-altivec.c
@@ -0,0 +1,262 @@
+/*
+ * AltiVec optimizations for libjpeg-turbo
