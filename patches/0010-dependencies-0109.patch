index 0000000000000000000000000000000000000000..b826cf93ac5e9671d68c06aaa16492f48ea4c40c
--- /dev/null
+++ b/third_party/nss/nss/lib/freebl/sha_fast.c
@@ -0,0 +1,463 @@
