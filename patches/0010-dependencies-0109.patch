+        movq    XMM_MMWORD [esi+eax*SIZEOF_JSAMPLE], xmm1
+        mov     edx, JSAMPROW [edi+4*SIZEOF_JSAMPROW]
+        mov     esi, JSAMPROW [edi+6*SIZEOF_JSAMPROW]
