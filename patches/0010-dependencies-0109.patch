new file mode 100644
index 0000000000000000000000000000000000000000..ad3ce00435ee6b1b2e51964396fcd46c9fb5179b
--- /dev/null
+++ b/third_party/nss/nss/lib/freebl/dsa.c
@@ -0,0 +1,631 @@
+/*
+ *
