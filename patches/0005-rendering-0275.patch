+  assertEquals(3, O.countArgs(...new Set([1, 2, 3])));
+  assertEquals(4, O.countArgs(...new Set([1, 2, 3, 4])));
+  assertEquals(5, O.countArgs(...new Set([1, 2, 3, 4, 5])));
