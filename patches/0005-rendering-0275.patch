diff --git a/v8/test/mjsunit/es6/object-literals-super.js b/v8/test/mjsunit/es6/object-literals-super.js
new file mode 100644
index 0000000000000000000000000000000000000000..b31a498767afec7d33844a8371425c2ba9dc83fc
--- /dev/null
