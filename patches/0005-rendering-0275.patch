+    return Math.max(0, ...args);
+  }
+
+  function testMax(x, y) {
+    return maxWithZero(x, y);
+  }
+
+  testMax(1, 2);
+  testMax(1, 2);
+  % OptimizeFunctionOnNextCall(testMax);
+  var r = testMax(1, 2);
+
+  assertEquals(2, r);
+
+  var called = 0;
+  Object.defineProperty(ai.__proto__, 'next', {
+    get: function() {
+      called++;
+      return original_next;
+    }
+  });
+
+  var r2 = testMax(1, 2);
+
+  assertEquals(3, called);
+  assertEquals(2, r2);
+})();
