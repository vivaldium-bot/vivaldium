+(function TestDefaultBeforeInitializingYield() {
+  var y = 0;
+  var z = 0;
+  function* f1(x = (y = 1)) { z = 1 };
+  assertEquals(0, y);
+  assertEquals(0, z);
+  var gen = f1();
+  assertEquals(1, y);
+  assertEquals(0, z);
+  gen.next();
+  assertEquals(1, y);
