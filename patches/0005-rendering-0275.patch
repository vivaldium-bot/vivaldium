+  assertEqualsAsync(undefined, () => f2());
+}());
+
+
+(function TestFunctionLength() {
+   assertEquals(0, (async function(x = 1) {}).length);
+   assertEquals(0, (async function(x = 1, ...a) {}).length);
+   assertEquals(1, (async function(x, y = 1) {}).length);
