+
+  assertSame(object, object.a[%HomeObjectSymbol()]);
+
+  assertEquals('a proto m', object.a());
+  assertEquals('b proto m', object.b());
+  assertEquals('0 proto m', object[0]());
+  assertEquals('1 proto m', object[1]());
