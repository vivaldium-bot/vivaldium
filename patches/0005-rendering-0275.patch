+  assertEquals(1, calls);
+
+  calls = 0;
+  object = {
+    set b(_) {
+      assertUnreachable();
+    },
+    set ['b'](_) {
+      calls++;
+    }
+  };
+  object.b = 'B';
+  assertEquals(1, calls);
+
+  calls = 0;
+  object = {
+    set c(_) {
+      assertUnreachable()
+    },
+    set ['c'](_) {
+      assertUnreachable()
+    },
+    set ['c'](_) {
+      calls++
+    }
+  };
+  object.c = 'C';
+  assertEquals(1, calls);
+
+  calls = 0;
+  object = {
+    set ['d'](_) {
