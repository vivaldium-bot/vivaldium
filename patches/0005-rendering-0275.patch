+    __proto__: proto,
+    set ['a'](v) { super.m('a', v); },
+    set [ID('b')](v) { super.m('b', v); },
+    set [0](v) { super.m('0', v); },
+    set [ID(1)](v) { super.m('1', v); },
+  };
+  object.a = 2;
+  assertEquals('a 2', value);
+  object.b = 3;
+  assertEquals('b 3', value);
