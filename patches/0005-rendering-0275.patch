+(function TestDefaultEvaluationOrder() {
+  var y = 0;
+  var z = 0;
+  var w = 0;
+  async function f1(x = (y = 1)) { z = 1; await undefined; w = 1; };
+  assertEquals(0, y);
+  assertEquals(0, z);
+  assertEquals(0, w);
+  f1();
+  assertEquals(1, y);
+  assertEquals(1, z);
+  assertEquals(0, w);
+  %RunMicrotasks();
+  assertEquals(1, y);
+  assertEquals(1, z);
+  assertEquals(1, w);
+})();
