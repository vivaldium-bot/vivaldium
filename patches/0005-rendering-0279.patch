+(function() {
+  function foo() {
+    var a = new Array();
+    a[0] = 10;
+    return a;
+  }
+
+  assertEquals(1, foo().length);
+
+  gc();
+  gc();
+  gc();
+  gc();
+
+  // Change prototype elements from fast smi to slow elements dictionary.
+  // The validity cell is invalidated by the change of Array.prototype's
+  // map.
