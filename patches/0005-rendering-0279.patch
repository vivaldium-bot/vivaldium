index 0000000000000000000000000000000000000000..8284eddc2d91930997f297757b7bb12044d3ffee
--- /dev/null
+++ b/v8/test/mjsunit/strict-mode-implicit-receiver.js
@@ -0,0 +1,187 @@
+// Copyright 2011 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
