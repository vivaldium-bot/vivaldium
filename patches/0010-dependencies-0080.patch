--- /dev/null
+++ b/third_party/deqp/src/framework/delibs/debase/deRandom.c
@@ -0,0 +1,106 @@
+/*-------------------------------------------------------------------------
+ * drawElements Base Portability Library
+ * -------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
