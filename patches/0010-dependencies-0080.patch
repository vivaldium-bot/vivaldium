diff --git a/third_party/ffmpeg/libswscale/arm/hscale.S b/third_party/ffmpeg/libswscale/arm/hscale.S
new file mode 100644
index 0000000000000000000000000000000000000000..dd4d45395757f1a8b6fbbe8d52e06fc5d1eab7d9
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/arm/hscale.S
@@ -0,0 +1,70 @@
+/*
+ * Copyright (c) 2016 Clément Bœsch <clement stupeflix.com>
+ * Copyright (c) 2016 Matthieu Bouron <matthieu.bouron stupeflix.com>
+ *
