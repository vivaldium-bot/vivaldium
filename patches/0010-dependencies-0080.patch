diff --git a/third_party/ffmpeg/libavutil/tests/cpu.c b/third_party/ffmpeg/libavutil/tests/cpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..f02a54cbbb1469412a9dbbf5fa43179b3140f0dd
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/tests/cpu.c
@@ -0,0 +1,147 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
