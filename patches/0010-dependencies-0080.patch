+av_cold void ff_sbrdsp_init_x86(SBRDSPContext *s)
+{
+    int cpu_flags = av_get_cpu_flags();
+
+    if (EXTERNAL_SSE(cpu_flags)) {
+        s->neg_odd_64 = ff_sbr_neg_odd_64_sse;
+        s->sum_square = ff_sbr_sum_square_sse;
