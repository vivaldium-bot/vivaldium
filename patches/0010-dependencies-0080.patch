+cglobal_mc %1, mc31, %2, 3,6,8
+    mov r4, r1
+    add r1, 2
+    jmp stub_%1_h264_qpel%2_mc11_10 %+ SUFFIX %+ .body
+%endmacro
+
+MC MC31
