index 0000000000000000000000000000000000000000..eca3f159348405e0e2677e3533b1fe3ac398bb4b
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/lavfi.c
@@ -0,0 +1,516 @@
+/*
