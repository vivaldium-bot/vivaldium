+      expect { call.set_credentials! creds }.not_to raise_error
+    end
+  end
+
+  def make_test_call
+    @ch.create_call(nil, nil, 'dummy_method', nil, deadline)
+  end
+
+  def deadline
+    Time.now + 2  # in 2 seconds; arbitrary
+  end
+end
