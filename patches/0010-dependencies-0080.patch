index 0000000000000000000000000000000000000000..bcf7e5be0e2266bdf7832b9d0e1bf5525091be8a
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/idctdsp_init.c
@@ -0,0 +1,126 @@
+/*
