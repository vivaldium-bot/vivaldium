index 0000000000000000000000000000000000000000..e6d30a174b8885d8c38b06d65ac02614f1dffa72
--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_channel.c
@@ -0,0 +1,400 @@
