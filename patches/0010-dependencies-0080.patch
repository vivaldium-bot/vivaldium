+static void cleanUpDataTable()
+{
+    int32_t i,j;
+    if(dataTable != NULL) {
+        for (i=0; i<LOCALE_INFO_SIZE; i++) {
+            for(j = 0; j < LOCALE_SIZE; j++) {
