+static const UChar _second[]= {115,101,99,111,110,100,0}; /* "second" */
+static const UChar _third[] = {116,104,105,114,100,0};    /* "third"  */
+static const UChar _fourth[]= {102,111,117,114,116,104,0};/* "fourth" */
