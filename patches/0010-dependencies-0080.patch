index 0000000000000000000000000000000000000000..ffd6505d13f476f0bfc230999dbf1fdf2800e02f
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/vdpau_vc1.c
@@ -0,0 +1,165 @@
+/*
+ * VC-1 decode acceleration through VDPAU
+ *
+ * Copyright (c) 2008 NVIDIA
+ * Copyright (c) 2013 Rémi Denis-Courmont
+ *
