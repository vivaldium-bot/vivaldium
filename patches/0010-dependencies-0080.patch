+
+typedef enum deImageFormat_e
+{
+	DE_IMAGEFORMAT_XRGB8888 = 0,
+	DE_IMAGEFORMAT_ARGB8888,
+
+	DE_IMAGEFORMAT_LAST
+} deImageFormat;
+
+typedef struct deImage_s
+{
+	int				width;
