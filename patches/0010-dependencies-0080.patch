diff --git a/third_party/ffmpeg/libavutil/x86/cpuid.asm b/third_party/ffmpeg/libavutil/x86/cpuid.asm
new file mode 100644
index 0000000000000000000000000000000000000000..c3f7866ec78f6525672a61ecaf1b3fb5dfe60c36
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/x86/cpuid.asm
@@ -0,0 +1,91 @@
+;*****************************************************************************
+;* Copyright (C) 2005-2010 x264 project
+;*
+;* Authors: Loren Merritt <lorenm@u.washington.edu>
+;*          Fiona Glaser <fiona@x264.com>
