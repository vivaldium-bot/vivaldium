+static void TestQuickCheckResultNO() 
+{
+  const UChar CPNFD[] = {0x00C5, 0x0407, 0x1E00, 0x1F57, 0x220C, 
+                         0x30AE, 0xAC00, 0xD7A3, 0xFB36, 0xFB4E};
+  const UChar CPNFC[] = {0x0340, 0x0F93, 0x1F77, 0x1FBB, 0x1FEB, 
