+static void sprite_v_single_c(uint8_t *dst, const uint8_t *src1a,
+                              const uint8_t *src1b,
+                              int offset, int width)
+{
+    sprite_v_template(dst, src1a, src1b, offset, 0, NULL, NULL, 0, 0, 1, width);
+}
