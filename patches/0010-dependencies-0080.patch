+    {
+        $this->assertTrue(is_string($this->call->getPeer()));
+    }
+
+    public function testCancel()
+    {
+        $this->assertNull($this->call->cancel());
+    }
+
+    /**
+     * @expectedException InvalidArgumentException
+     */
+    public function testInvalidMetadataKey()
+    {
+        $batch = [
+            'invalid' => ['key1' => 'value1'],
+        ];
