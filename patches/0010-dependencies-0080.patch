index 0000000000000000000000000000000000000000..10950e70b4dbd69666df1c5974f4fee0907390f8
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/arm/yuv2rgb_neon.S
@@ -0,0 +1,280 @@
+/*
+ * Copyright (c) 2015 Matthieu Bouron <matthieu.bouron stupeflix.com>
+ * Copyright (c) 2015 Clément Bœsch <clement stupeflix.com>
+ *
