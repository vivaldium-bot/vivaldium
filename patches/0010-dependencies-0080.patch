index 0000000000000000000000000000000000000000..5b7aa3417e6ce300a2bd561eec43d0266ab8b44e
--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_channel_credentials.c
@@ -0,0 +1,265 @@
