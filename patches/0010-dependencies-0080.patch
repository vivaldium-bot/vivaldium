+        expect(@call).to receive(:output_metadata).and_return(fake_md)
+        expect(@call).to receive(:send_status).once.with(OK, 'OK', true,
+                                                         metadata: fake_md)
+        @bidi_streamer.run_server_method(@call, method(:fake_bidistream))
+      end
+    end
+  end
