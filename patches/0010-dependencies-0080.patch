+UnicodeString UNACCENT_RULES(
+    "[\\u00C0-\\u00C5] > A;"
+    "[\\u00C8-\\u00CB] > E;"
+    "[\\u00CC-\\u00CF] > I;"
+    "[\\u00E0-\\u00E5] > a;"
+    "[\\u00E8-\\u00EB] > e;"
+    "[\\u00EC-\\u00EF] > i;"
+    );
+
+int main(int argc, char **argv) {
+
+    Calendar *cal;
+    DateFormat *fmt;
+    DateFormat *defFmt;
+    Transliterator *greek_latin;
+    Transliterator *rbtUnaccent;
+    UErrorCode status = U_ZERO_ERROR;
+    Locale greece("el", "GR");
