+            if (cSourceLimit < cBuf + (cTarget - cBuf)) {
+                cSourceLimit = cSourceLimit+1;
+            }
+            ucnv_toUnicode(cnv,&uTarget,uTargetLimit,&cSource,cSourceLimit,NULL,FALSE,&errorCode);
+            if(errorCode==U_BUFFER_OVERFLOW_ERROR){
