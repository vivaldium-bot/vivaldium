index 0000000000000000000000000000000000000000..8e2f76901a33af0db14a6fcd6df2f0e136e5f18e
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/resample.c
@@ -0,0 +1,637 @@
+/*
+ * audio resampling
+ * Copyright (c) 2004-2012 Michael Niedermayer <michaelni@gmx.at>
