diff --git a/third_party/grpc/test/core/census/context_test.c b/third_party/grpc/test/core/census/context_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7a65380fb8cfe6072198eb665098fd0deb3625d
--- /dev/null
+++ b/third_party/grpc/test/core/census/context_test.c
@@ -0,0 +1,378 @@
