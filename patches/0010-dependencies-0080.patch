+/* Testing the DateFormat API */
+static void TestDateFormat()
+{
+    UDateFormat *def, *fr, *it, *de, *def1, *fr_pat;
+    UDateFormat *any;
+    UDateFormat *copy;
+    UErrorCode status = U_ZERO_ERROR;
