index 0000000000000000000000000000000000000000..e92cbbce086a6e291a1ff99a7c79882d71d50948
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/aacpsdsp.asm
@@ -0,0 +1,209 @@
+;******************************************************************************
+;* SIMD optimized MPEG-4 Parametric Stereo decoding functions
+;*
+;* Copyright (C) 2015 James Almer
+;*
+;* This file is part of FFmpeg.
+;*
