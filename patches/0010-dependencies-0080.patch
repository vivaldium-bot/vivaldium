index 0000000000000000000000000000000000000000..6943c93d4aad0aa3a7b9003f9e30c8bbbf0f3d67
--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_channel.c
@@ -0,0 +1,425 @@
+/*
