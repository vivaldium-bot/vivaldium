+};
+
+uint16_t ff_svq1_packet_checksum (const uint8_t *data,
+                                  const int length, int value)
+{
+    int i;
+
+    for (i = 0; i < length; i++)
+        value = checksum_table[data[i] ^ (value >> 8)] ^ ((value & 0xFF) << 8);
+
+    return value;
+}
