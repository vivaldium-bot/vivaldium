+++ b/third_party/ffmpeg/libavutil/x86/float_dsp.asm
@@ -0,0 +1,375 @@
+;*****************************************************************************
+;* x86-optimized Float DSP functions
+;*
+;* Copyright 2006 Loren Merritt
+;*
+;* This file is part of FFmpeg.
+;*
+;* FFmpeg is free software; you can redistribute it and/or
