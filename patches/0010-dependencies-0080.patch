index 0000000000000000000000000000000000000000..db3e9934f8b5f9f0d3f83652abf8f46422f195ed
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/x86/output.asm
@@ -0,0 +1,425 @@
+;******************************************************************************
+;* x86-optimized vertical line scaling functions
+;* Copyright (c) 2011 Ronald S. Bultje <rsbultje@gmail.com>
+;*                    Kieran Kunhya <kieran@kunhya.com>
