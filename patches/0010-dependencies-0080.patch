+static char * formatMap(const int32_t * map, int len, char * buffer)
+{
+    int32_t i, k;
+    char c;
+    for (i = 0; i < len; i++) {
+        k = map[i];
+        if (k < 0)
+            c = '-';
+        else if (k >= sizeof(columns))
+            c = '+';
+        else
+            c = columns[k];
+        buffer[i] = c;
+    }
+    buffer[len] = '\0';
+    return buffer;
+}
