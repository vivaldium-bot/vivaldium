+
+#define XWD_XY_BITMAP       0
+#define XWD_XY_PIXMAP       1
+#define XWD_Z_PIXMAP        2
+
+#define XWD_STATIC_GRAY     0
+#define XWD_GRAY_SCALE      1
+#define XWD_STATIC_COLOR    2
+#define XWD_PSEUDO_COLOR    3
+#define XWD_TRUE_COLOR      4
