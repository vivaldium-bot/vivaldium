+#define NFS4_MAX_BUFFER_SIZE 1000
+#define PREFIX_SUFFIX_SEPARATOR 0x0040 /* '@' */
+
+
+const char* NFS4DataFileNames[5] ={
+    "nfscss",
+    "nfscsi",
+    "nfscis",
+    "nfsmxp",
+    "nfsmxs"
+};
