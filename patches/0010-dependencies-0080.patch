+        TEST_ASSERT(status == U_STRING_NOT_TERMINATED_WARNING);
+        TEST_ASSERT_STRING("Replace <aa> x1x x...x.", buf, FALSE);
+        TEST_ASSERT(resultSz == (int32_t)strlen("Replace xaax x1x x...x."));
+        TEST_ASSERT(buf[resultSz] == (UChar)0xffff);
