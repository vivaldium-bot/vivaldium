diff --git a/third_party/ffmpeg/libavutil/x86/pixelutils_init.c b/third_party/ffmpeg/libavutil/x86/pixelutils_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..c24a533aea02044ea6a18c179fae75d96993a685
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/x86/pixelutils_init.c
@@ -0,0 +1,64 @@
+/*
