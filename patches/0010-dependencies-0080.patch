index 0000000000000000000000000000000000000000..5303fdff8fd0dd953220aa946f01c5fcc30218bd
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/tests/dct.c
@@ -0,0 +1,523 @@
+/*
+ * (c) 2001 Fabrice Bellard
+ *     2007 Marc Hoffman <marc.hoffman@analog.com>
