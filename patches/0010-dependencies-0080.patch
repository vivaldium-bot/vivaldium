+include $(SUBDIR)../config.mak
+
+NAME = swscale
+
+HEADERS = swscale.h                                                     \
+          version.h                                                     \
+
+OBJS = alphablend.o                                     \
+       hscale.o                                         \
+       hscale_fast_bilinear.o                           \
+       gamma.o                                          \
+       input.o                                          \
+       options.o                                        \
+       output.o                                         \
+       rgb2rgb.o                                        \
