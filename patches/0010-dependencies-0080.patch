+                if (U_FAILURE(status)) {
+                    log_err("FAIL: udat_open(%s) failed with (%s) dateIdx=%d, timeIdx=%d\n",
+                        uloc_getAvailable(idx), u_errorName(status), dateIdx, timeIdx);
+                }
+            }
+        }
+    }
+}
