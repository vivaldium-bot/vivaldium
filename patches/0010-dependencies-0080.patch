index 0000000000000000000000000000000000000000..3b0fb6c910df0bb069c579a97ea3441561d381f2
--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_server_credentials.c
@@ -0,0 +1,287 @@
+/*
+ *
