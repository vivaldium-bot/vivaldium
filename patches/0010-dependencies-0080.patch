+
+/***************************************************************************************/
+void TestAliasConflict(void) {
+    UErrorCode status = U_ZERO_ERROR;
+    UResourceBundle *he = NULL;
+    UResourceBundle *iw = NULL;
+    const UChar *result = NULL;
+    int32_t resultLen;
+
