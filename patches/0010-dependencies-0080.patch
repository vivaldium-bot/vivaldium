+        multiple=(UBool)(codepoint[i] == 1 ? FALSE : TRUE);
+        if(UTF_NEED_MULTIPLE_UCHAR(c) != multiple){
+            log_err("ERROR: Unicode::needMultipleUChar() failed for U+%04x\n", c);
+        }
+    }
