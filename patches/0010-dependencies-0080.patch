diff --git a/third_party/ffmpeg/libavutil/ppc/cpu.c b/third_party/ffmpeg/libavutil/ppc/cpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f1e9826245460af28258077bcea7d2a942d8151
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/ppc/cpu.c
@@ -0,0 +1,150 @@
+/*
