+DECLARE_ALIGNED(8, const uint8_t, ff_dither_8x8_128)[9][8] = {
+    {  36, 68,  60, 92,  34, 66,  58, 90, },
+    { 100,  4, 124, 28,  98,  2, 122, 26, },
