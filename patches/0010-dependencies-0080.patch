+        status = U_ZERO_ERROR;
+        resultSz = uregex_replaceFirst(re, replText, -1, NULL, 0, &status);
+        TEST_ASSERT(status == U_BUFFER_OVERFLOW_ERROR);
+        TEST_ASSERT(resultSz == (int32_t)strlen("Replace xaax x1x x...x."));
+
+        /* Buffer too small by one */
+        status = U_ZERO_ERROR;
