+U_CFUNC void
+addBOCU1Tests(TestNode** root) {
+    addTest(root, TestBOCU1RefDiff, "tsconv/bocu1tst/TestBOCU1RefDiff");
+    addTest(root, TestBOCU1, "tsconv/bocu1tst/TestBOCU1");
+}
