+            }
+        }
+        if (ucol_next(iter2, &status) != UCOL_NULLORDER) {
+            log_err("CEs not exhausted\n");
+            return;
+        }
+        ucol_closeElements(iter1);
+        ucol_closeElements(iter2);
+        ucol_close(coll1);
+        ucol_close(coll2);
+    }
+#endif
