index 0000000000000000000000000000000000000000..eeda62523103dfa031ffc2aa893c4a56e2de0d19
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/spherical.h
@@ -0,0 +1,140 @@
+/*
