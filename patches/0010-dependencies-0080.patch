+	int ndx;
+
+	for (ndx = 0; ndx < (int)DE_LENGTH_OF_ARRAY(data->bytes); ndx++)
+		DE_TEST_ASSERT(data->bytes[ndx] == 0);
+
+	for (ndx = 0; ndx < (int)DE_LENGTH_OF_ARRAY(data->bytes); ndx++)
+		data->bytes[ndx] = 0xff;
+}
