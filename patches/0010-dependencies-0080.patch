diff --git a/third_party/ffmpeg/libavcodec/xvmc.h b/third_party/ffmpeg/libavcodec/xvmc.h
new file mode 100644
index 0000000000000000000000000000000000000000..465ee78d6e5562360b4364bb37a623f32e450f2f
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/xvmc.h
@@ -0,0 +1,170 @@
