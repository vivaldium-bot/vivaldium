+		TCU_CHECK(!either.isSecond());
+
+		TCU_CHECK(either.is<int>());
+		TCU_CHECK(!either.is<float>());
+
+		TCU_CHECK(either.getFirst() == intValue);
+		TCU_CHECK(either.get<int>() == intValue);
