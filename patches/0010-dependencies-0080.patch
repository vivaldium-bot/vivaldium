index 0000000000000000000000000000000000000000..8a550e088be12b3fb9f0fcb77cc9963a6b3d2d36
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/tests/fifo.c
@@ -0,0 +1,109 @@
+/*
