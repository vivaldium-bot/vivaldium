+    ActiveCall.new(recvd_call, @server_queue, @pass_through,
+                   @pass_through, deadline)
+  end
+
+  def make_test_call
+    @ch.create_call(@client_queue, nil, nil, '/method', nil, deadline)
+  end
+
+  def deadline
+    Time.now + 2  # in 2 seconds; arbitrary
+  end
+end
