+		case TOKEN_FLOAT_MAT3:				return "mat3";
+		case TOKEN_FLOAT_MAT3X4:			return "mat3x4";
+		case TOKEN_FLOAT_MAT4X2:			return "mat4x2";
+		case TOKEN_FLOAT_MAT4X3:			return "mat4x3";
