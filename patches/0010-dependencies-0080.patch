+        PAVGB(%%mm2, %%mm1)                           //  11                /2
+        PAVGB(%%mm1, %%mm6)                           //1122   11        /8
+        PAVGB(%%mm5, %%mm6)                           //112242211        /16
+        "movq (%%"FF_REG_a"), %%mm5             \n\t" //    1
+        "movq %%mm6, (%%"FF_REG_a")             \n\t" //    X
