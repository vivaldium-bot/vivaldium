+        "movd %%mm1, (%%"FF_REG_d", %1)         \n\t"
+        "psrlq $32, %%mm1                       \n\t"
+        "movd %%mm1, (%%"FF_REG_d", %1, 2)      \n\t"
+
+
+        "movq 64(%2), %%mm0                     \n\t" // 12345678
+        "movq 80(%2), %%mm1                     \n\t" // abcdefgh
