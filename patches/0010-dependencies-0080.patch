+        c->vp6_filter_diag4 = ff_vp6_filter_diag4_sse2;
+    }
+}
diff --git a/third_party/ffmpeg/libavcodec/x86/vp8dsp.asm b/third_party/ffmpeg/libavcodec/x86/vp8dsp.asm
