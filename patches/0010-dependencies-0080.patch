+        "punpckhwd %%mm1, %%mm3                 \n\t"
+        "movq %%mm2, %%mm1                      \n\t"
+        "punpcklwd %%mm4, %%mm2                 \n\t"
+        "punpckhwd %%mm4, %%mm1                 \n\t"
+
+        "movd %%mm0, (%0)                       \n\t"
+        "psrlq $32, %%mm0                       \n\t"
+        "movd %%mm0, (%%"FF_REG_a")             \n\t"
+        "movd %%mm3, (%%"FF_REG_a", %1)         \n\t"
+        "psrlq $32, %%mm3                       \n\t"
+        "movd %%mm3, (%%"FF_REG_a", %1, 2)      \n\t"
+        "movd %%mm2, (%0, %1, 4)                \n\t"
+        "psrlq $32, %%mm2                       \n\t"
