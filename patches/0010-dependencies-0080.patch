+        printf("Transliterated via Greek-Latin: ");
+        uprintf(escape(str));
+        printf("\n");
+        
+        // Transliterate result
+        str2 = str;
+        rbtUnaccent->transliterate(str);
+        printf("Transliterated via RBT unaccent: ");
+        uprintf(escape(str));
+        printf("\n\n");
+    }
+
+    // Clean up
+    delete fmt;
+    delete cal;
+    delete greek_latin;
+    delete rbtUnaccent;
+
+    printf("Exiting successfully\n");
+    return 0;
+}
