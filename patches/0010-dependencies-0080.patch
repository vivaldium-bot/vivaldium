index 0000000000000000000000000000000000000000..9466402db0c6b4887698b704e8b7a60347a23f79
--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_completion_queue.c
@@ -0,0 +1,236 @@
+/*
+ *
