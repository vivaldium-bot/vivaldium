+            return -1;
+        }
+        errorCode = U_ZERO_ERROR;
+
+        /* Initialize ICU */
+        if (!defaultDataFound) {
+            ctest_setICU_DATA();    /* u_setDataDirectory() must happen Before u_init() */
+        }
+        u_init(&errorCode);
+        if (U_FAILURE(errorCode)) {
+            fprintf(stderr,
