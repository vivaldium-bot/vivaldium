+    for (i = 0; i < NUM_VARIABLE_KEY_TESTS; i++) {
+        av_blowfish_init(ctx, variable_key[i], 8);
+
+        av_blowfish_crypt_ecb(ctx, &tmptext_l[i], &tmptext_r[i], 0);
