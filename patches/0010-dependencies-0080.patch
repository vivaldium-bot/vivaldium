+#ifndef _GLUDUMMYRENDERCONTEXT_HPP
+#define _GLUDUMMYRENDERCONTEXT_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
+ *
