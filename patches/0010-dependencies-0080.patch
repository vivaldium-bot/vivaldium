index 0000000000000000000000000000000000000000..805c7dd5476d99bb879073aa2c26c2eeaa30b426
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/subviewerdec.c
@@ -0,0 +1,77 @@
+/*
