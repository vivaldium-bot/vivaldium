+        PAVGB(%%mm2, %%mm0)                           //22242211/16
+        "movq (%0, %1, 2), %%mm2                \n\t" //   1
+        "movq %%mm0, (%0, %1, 2)                \n\t" //   X
+        // mm1=2 mm2=3 mm3=6(11) mm4=1 mm5=4(211) mm6=0(11) mm7=9
+        "movq (%%"FF_REG_a", %1, 4), %%mm0      \n\t" //        1
+        PAVGB((%%FF_REGc), %%mm0)                     //       11        /2
+        PAVGB(%%mm0, %%mm6)                           //11     11        /4
