+
+    TestNull_check(source_dcmp,
+                   source_dcmp_len,
+                   expect_dcmp,
+                   expect_dcmp_len,
+                   UNORM_NFD,
+                   "UNORM_NFD");
+
+    TestNull_check(source_comp,
