--- /dev/null
+++ b/third_party/ffmpeg/libavutil/ppc/float_dsp_vsx.c
@@ -0,0 +1,117 @@
+/*
+ * Copyright (c) 2015 Luca Barbato <lu_zero@gentoo.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
