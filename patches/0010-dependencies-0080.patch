+        return;
+    }
+
+    /*
+     * Use utrie2_set32() not utrie2_setRange32() to write non-initialValue-data.
+     * Should grow/reallocate the data array to a sufficient length.
+     */
+    for(i=0; i<0x1000; ++i) {
+        utrie2_set32(trie, i, 2, &errorCode);
