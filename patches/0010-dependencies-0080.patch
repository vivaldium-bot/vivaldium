index 0000000000000000000000000000000000000000..b663027b42eba3e361686dfb7c145e1499eb7faf
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/pixelutils.c
@@ -0,0 +1,87 @@
+/*
