+
+    status = U_ZERO_ERROR;
+    alias = ucnv_getStandardName("Shift_JIS", "IBM", &status);
+    if (alias == NULL || strcmp(alias, "ibm-943") != 0 || status != U_AMBIGUOUS_ALIAS_WARNING) {
