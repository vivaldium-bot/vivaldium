+static srtp_err_status_t srtp_null_cipher_encrypt (void *cv,
+                                            unsigned char *buf, unsigned int *bytes_to_encr)
+{
+	/* srtp_null_cipher_ctx_t *c = (srtp_null_cipher_ctx_t *)cv; */
