+  p->cipher_key_len  = SRTP_AES_GCM_256_KEY_LEN_WSALT;
+  p->auth_type       = SRTP_NULL_AUTH; /* GCM handles the auth for us */ 
+  p->auth_key_len    = 0; 
+  p->auth_tag_len    = 8;   /* 8 octet tag length */
+  p->sec_serv        = sec_serv_conf_and_auth;
+}
