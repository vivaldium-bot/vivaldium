+      } else if (identifyString.EqualNoCase("xml")) {
+        EncodeXML(toEncodeString, resultBuf);
+      } else {
+        EncodeURL(toEncodeString, resultBuf);
+      }
+      FXJSE_Value_SetUTF8String(args.GetReturnValue(),
+                                resultBuf.GetByteString());
