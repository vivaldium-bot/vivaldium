diff --git a/third_party/libsrtp/crypto/include/rdb.h b/third_party/libsrtp/crypto/include/rdb.h
new file mode 100644
index 0000000000000000000000000000000000000000..4671a0a0d98b5e3f436b95242d580bb636e51709
--- /dev/null
+++ b/third_party/libsrtp/crypto/include/rdb.h
@@ -0,0 +1,129 @@
+/*
+ * replay-database.h
+ *
+ * interface for a replay database for packet security
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+
+/*
+ *	
+ * Copyright (c) 2001-2017, Cisco Systems, Inc.
+ * All rights reserved.
+ * 
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
