+FX_ERR CFX_Shading::CreateAxial(const CFX_PointF& beginPoint,
+                                const CFX_PointF& endPoint,
+                                FX_BOOL isExtendedBegin,
+                                FX_BOOL isExtendedEnd,
+                                const FX_ARGB beginArgb,
