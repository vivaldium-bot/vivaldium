+def describe_reloc_type(x, elffile):
+    arch = elffile.get_machine_arch()
+    if arch == 'x86':
+        return _DESCR_RELOC_TYPE_i386.get(x, _unknown)
+    elif arch == 'x64':
+        return _DESCR_RELOC_TYPE_x64.get(x, _unknown)
+    else:
+        return 'unrecognized: %-7x' % (x & 0xFFFFFFFF)
+
+
