+  srtp_t srtp_send_aes_gcm;
+  srtp_t srtp_send_aes_gcm_mki;
+  uint32_t length = 0;
+  srtp_err_status_t status;
+
+  srtp_test_setup_protect_trailer_streams(&srtp_send, &srtp_send_mki,
+					  &srtp_send_aes_gcm, &srtp_send_aes_gcm_mki);
