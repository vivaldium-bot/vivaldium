+    for (int32_t i = 0; i < GetSize(); i++) {
+      FXJSE_Value_Release(GetAt(i));
+    }
+  }
+  void GetAttributeObject(CXFA_ObjArray& objArray) {
+    for (int32_t i = 0; i < GetSize(); i++) {
