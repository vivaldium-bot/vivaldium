+  CXFA_WidgetData* pContainerWidgetData = m_pNode->GetContainerWidgetData();
+  if (pContainerWidgetData) {
+    pContainerWidgetData->GetFormatDataValue(wsValue, wsFormatValue);
+  }
+  m_pNode->SetContent(wsValue, wsFormatValue, bNotify);
+}
