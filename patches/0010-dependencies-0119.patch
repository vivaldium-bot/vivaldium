+    return FALSE;
+  }
+  IXFA_ScriptContext* pScriptContext = pXFADoc->GetScriptContext();
+  if (!pScriptContext) {
+    return FALSE;
+  }
+  return pScriptContext->RunScript(
+      (XFA_SCRIPTLANGTYPE)eScriptType, wsScript, hRetValue,
+      hThisObject ? (CXFA_Object*)FXJSE_Value_ToObject(hThisObject, NULL)
+                  : NULL);
+}
