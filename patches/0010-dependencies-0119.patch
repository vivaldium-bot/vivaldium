+FX_BOOL CXFA_FFDocHandler::RunDocScript(IXFA_Doc* hDoc,
+                                        XFA_SCRIPTTYPE eScriptType,
+                                        const CFX_WideStringC& wsScript,
+                                        FXJSE_HVALUE hRetValue,
+                                        FXJSE_HVALUE hThisObject) {
