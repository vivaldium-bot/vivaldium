+++ b/third_party/libsrtp/test/roc_driver.c
@@ -0,0 +1,175 @@
+/*
+ * roc_driver.c
+ *
+ * test driver for rollover counter replay implementation
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
+ *	
