index 0000000000000000000000000000000000000000..b29a4bf7abcc93d9fecac21b7286c9c24672b3a2
--- /dev/null
+++ b/third_party/sfntly/cpp/src/test/lock_test.cc
@@ -0,0 +1,244 @@
+/*
