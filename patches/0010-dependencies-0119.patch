+FX_BOOL CXFA_Node::TryEnum(XFA_ATTRIBUTE eAttr,
+                           XFA_ATTRIBUTEENUM& eValue,
+                           FX_BOOL bUseDefault) {
+  void* pValue = NULL;
+  if (!GetValue(eAttr, XFA_ATTRIBUTETYPE_Enum, bUseDefault, pValue)) {
