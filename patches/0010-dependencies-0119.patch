+  int32_t index = 0;
+  for (CXFA_Node* pNode = GetNodeItem(XFA_NODEITEM_PrevSibling); pNode != NULL;
+       pNode = pNode->GetNodeItem(XFA_NODEITEM_PrevSibling)) {
+    if ((pNode->GetClassID() == XFA_ELEMENT_Subform) ||
+        (pNode->GetClassID() == XFA_ELEMENT_SubformSet)) {
+      index++;
+    } else {
+      break;
+    }
+  }
+  return index;
+}
