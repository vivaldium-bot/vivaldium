+    FXJSE_HVALUE newProperty = FXJSE_Value_Create(hruntime);
+    FXJSE_Value_GetObjectPropByIdx(arg, 1, propertyValue);
+    FXJSE_Value_GetObjectPropByIdx(arg, 2, jsobjectValue);
+    if (FXJSE_Value_IsNull(propertyValue)) {
