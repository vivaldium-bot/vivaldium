+      : m_context(pContext),
+        m_parent(pIsolate),
+        m_cscope(v8::Local<v8::Context>::New(
+            pIsolate,
+            pContext ? pContext->m_hContext
+                     : CFXJSE_RuntimeData::Get(pIsolate)->m_hRootContext)) {}
+  v8::Isolate* GetIsolate() { return m_parent.GetIsolate(); }
