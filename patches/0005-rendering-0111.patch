-      direction: rtl;
-      font: 80px/1 Ahem;
-      height: 320px;
-      position: relative;
-      width: 320px;
-    }
-
-  div#containing-block > span
-    {
-      background-color: green;
-      height: 1em;
-      left: 2em;
-      position: absolute;
-      right: 1em;
