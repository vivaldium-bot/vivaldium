-              "NCName (Gecko chooses to throw NAMESPACE_ERR here, but either is valid " +
-              "as this is both an invalid XML name and an invalid QName)" },
-   { args: ["http://example.com/", "a:a\u0BC6"] },
-   { args: ["http://example.com/", "a\u0BC6:a"] },
