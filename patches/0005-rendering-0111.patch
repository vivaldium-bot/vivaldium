-  +
-      0px : border-bottom-width
-  +
-      0px : margin-bottom
-  +
-  (solve) : bottom: auto
-    =====================
-    320px : height of containing block
-
-And so computed bottom value must be 80px .
-*/
-
-  ]]></style>
