+
+      it('fails if one duck is unsatisfied', function(){
+
+        var rootJson = {
+          people:{
+            jack:{
+              name:  'Jack'
+              ,  email: 'jack@example.com'
+            }
+          }
+        };
+
+        expect( matchOf( '{people}.{alberto}.{name email}' ).against(
