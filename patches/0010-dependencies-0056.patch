diff --git a/third_party/ffmpeg/libavdevice/dshow.c b/third_party/ffmpeg/libavdevice/dshow.c
new file mode 100644
index 0000000000000000000000000000000000000000..b280bc314d9e2c50a0c6cf92a75ff5e2afeb65d3
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/dshow.c
@@ -0,0 +1,1309 @@
+/*
+ * Directshow capture interface
+ * Copyright (c) 2010 Ramiro Polla
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
