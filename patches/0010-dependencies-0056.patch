+
+    xit('doesn\'t call path callback after callback is removed', function() {
+
+      var pathCallback = jasmine.createSpy('path callback'),
+          ascent = list(namedNode('path', {}));
+
+      oboeInstance.on('path', 'a_pattern', pathCallback);
