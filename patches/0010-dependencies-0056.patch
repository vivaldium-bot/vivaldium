index 0000000000000000000000000000000000000000..dac4605d0ce630d29cab93b6807cf0167b0c3be7
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_sidechaincompress.c
@@ -0,0 +1,426 @@
+/*
