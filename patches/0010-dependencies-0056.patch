diff --git a/third_party/catapult/tracing/tracing/base/assert_utils.html b/third_party/catapult/tracing/tracing/base/assert_utils.html
new file mode 100644
index 0000000000000000000000000000000000000000..1f0a9972d07d6b0ca4b39900bb708201dd465137
--- /dev/null
+++ b/third_party/catapult/tracing/tracing/base/assert_utils.html
@@ -0,0 +1,31 @@
+<!DOCTYPE html>
+<!--
+Copyright 2016 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<script>
+'use strict';
+
+// TODO(charliea): Investigate whether we could make this a Chai plugin.
+/**
+ * @fileoverview Provides assert functions that are not available on the Chai
+ * assert module.
+ */
+tr.exportTo('tr.b', function() {
+  /**
+   * Throws if the range |actual| is not equal to the range |expected| (using
+   * tr.b.math.Range.equals).
+   */
+  function assertRangeEquals(actual, expected) {
+    assert(actual.equals(expected),
+        'Expected Range(' + actual.min + ', ' + actual.max + ') to be ' +
+             'Range(' + expected.min + ', ' + expected.max + ')');
+  }
+
+  return {
+    assertRangeEquals,
+  };
+});
+</script>
