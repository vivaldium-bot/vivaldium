diff --git a/third_party/ffmpeg/libavcodec/x86/diracdsp_mmx.c b/third_party/ffmpeg/libavcodec/x86/diracdsp_mmx.c
new file mode 100644
index 0000000000000000000000000000000000000000..b2e949c08b2d38e3c93dc4f0307a4024227aeb4e
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/diracdsp_mmx.c
@@ -0,0 +1,156 @@
+/*
+ * Copyright (C) 2010 David Conrad
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
