index 0000000000000000000000000000000000000000..aa0800b40bf5f4846329081ba0c2c1566353cf34
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/pulse_audio_dec.c
@@ -0,0 +1,376 @@
+/*
+ * Pulseaudio input
+ * Copyright (c) 2011 Luca Barbato <lu_zero@gentoo.org>
+ * Copyright 2004-2006 Lennart Poettering
+ * Copyright (c) 2014 Michael Niedermayer <michaelni@gmx.at>
+ *
