diff --git a/third_party/ffmpeg/libavcodec/vorbisenc.c b/third_party/ffmpeg/libavcodec/vorbisenc.c
new file mode 100644
index 0000000000000000000000000000000000000000..2974ca2cf95a600b3275b5b4f43c8af2d74c6441
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/vorbisenc.c
@@ -0,0 +1,1211 @@
+/*
+ * copyright (c) 2006 Oded Shimon <ods15@ods15.dyndns.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
