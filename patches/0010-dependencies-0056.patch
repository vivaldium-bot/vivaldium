new file mode 100644
index 0000000000000000000000000000000000000000..941a8e2e4c6029e2c7f5106c22c43a202b912e43
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/mpegvideodsp.c
@@ -0,0 +1,161 @@
