+        // Do not follow PostComposite that triggers CompositeImmediately
+        // that is tracked by another LatencyInfo.
+        if (slice.title === 'CompositorImpl::PostComposite') {
+          if (this.triggerOtherInputs(slice, flowEvents)) return;
+        }
