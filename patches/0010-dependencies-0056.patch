+    // New style.
+    allTypeNames.push('InputLatency::' + eventTypeName);
+  });
+
+  AsyncSlice.subTypes.register(
+      InputLatencyAsyncSlice,
+      {
+        typeNames: allTypeNames,
+        categoryParts: ['latencyInfo']
