index 0000000000000000000000000000000000000000..b74636409c32b1b6cd174cbcd467218f380e0b2f
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_compand.c
@@ -0,0 +1,589 @@
+/*
