index 0000000000000000000000000000000000000000..80b8a54af324adfe940d525c234f37ff9a834d84
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/huffyuvencdsp.asm
@@ -0,0 +1,147 @@
