+
+        )).not.toSpecifyNode({name:  'Jack',  email: 'jack@example.com'});
+      });
+
+
+      it('can construct the root duck type', function(){
+
+        var rootJson = {
+          people:{
+            jack:{
+              name:  'Jack'
+              ,  email: 'jack@example.com'
+            }
+          }
