index 0000000000000000000000000000000000000000..f06fcdf7cfba0be82bab56f0ffdc019901aac1fe
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/lossless_videodsp.asm
@@ -0,0 +1,294 @@
+;******************************************************************************
+;* SIMD lossless video DSP utils
+;* Copyright (c) 2008 Loren Merritt
+;* Copyright (c) 2014 Michael Niedermayer
+;*
+;* This file is part of FFmpeg.
