--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_sofalizer.c
@@ -0,0 +1,1136 @@
+/*****************************************************************************
+ * sofalizer.c : SOFAlizer filter for virtual binaural acoustics
