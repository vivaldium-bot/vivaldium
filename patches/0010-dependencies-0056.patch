+        if (task.title === RASTER_TASK_TITLE ||
+            task.title === IMAGEDECODE_TASK_TITLE) {
+          if (task.args.source_prepare_tiles_id === prepareTileId) {
+            this.addEntireSliceHierarchy(task.mostTopLevelSlice);
+          }
