diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/2008-04-26-SROA-Global-Align.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/GlobalOpt/2008-04-26-SROA-Global-Align.ll
