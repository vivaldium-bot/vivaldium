+VCMEncodedFrame::~VCMEncodedFrame() {
+  Free();
+}
+
+void VCMEncodedFrame::Free() {
+  Reset();
+  if (_buffer != NULL) {
+    delete[] _buffer;
+    _buffer = NULL;
+  }
+}
