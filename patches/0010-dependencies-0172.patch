diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/fast-isel-avoid-unnecessary-pic-base.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/fast-isel-avoid-unnecessary-pic-base.ll
