+    : PacketSender(listener, source->flow_id()),
+      source_(source),
+      bwe_(CreateBweSender(estimator_type,
+                           source_->bits_per_second() / 1000,
+                           this,
+                           &clock_)),
+      previous_sending_bitrate_(0) {
+  modules_.push_back(bwe_.get());
+}
