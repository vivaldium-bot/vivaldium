+  // Go up 1/2x1/2 spatially and 1/2 temporally. Spatial is done in 2 stages.
+  qm_resolution_->UpdateCodecParameters(15.0f, 320, 240);
+  EXPECT_EQ(2, qm_resolution_->GetImageType(320, 240));
+  qm_resolution_->ResetRates();
