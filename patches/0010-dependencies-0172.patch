diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/DeadArgElim/2008-06-23-DeadAfterLive.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/DeadArgElim/2008-06-23-DeadAfterLive.ll
