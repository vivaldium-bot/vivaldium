+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/change-compare-stride-trickiness-1.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/change-compare-stride-trickiness-1.ll
