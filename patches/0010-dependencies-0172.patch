diff --git a/third_party/webgl/src/sdk/tests/conformance/ogles/GL2FixedTests/buffer_objects/buffer_objects.vert b/third_party/webgl/src/sdk/tests/conformance/ogles/GL2FixedTests/buffer_objects/buffer_objects.vert
