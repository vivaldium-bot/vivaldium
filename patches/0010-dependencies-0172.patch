index 0000000000000000000000000000000000000000..be82c513920e00e50d2de2dbf2183e920427966e
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Object/dg.exp
@@ -0,0 +1,3 @@
+load_lib llvm.exp
