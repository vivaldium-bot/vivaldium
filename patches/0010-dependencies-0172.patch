+TestConfig::TestConfig()
+    : name(""),
+      description(""),
+      test_number(0),
+      input_filename(""),
+      output_filename(""),
+      output_dir("out"),
+      networking_config(),
+      exclude_frame_types(kExcludeOnlyFirstKeyFrame),
+      frame_length_in_bytes(0),
+      use_single_core(false),
+      keyframe_interval(0),
