+
+%struct.s = type {i32, i32, i32}
+
+define i32 @test1() nounwind {
+tak:
+	%tmp = call i1 @foo()
+	br i1 %tmp, label %BB1, label %BB2
+BB1:
+	ret i32 1
+BB2:
+	ret i32 0
+; CHECK: test1:
+; CHECK: calll
+; CHECK-NEXT: testb	$1
+}
+declare zeroext i1 @foo()  nounwind
+
+declare void @foo2(%struct.s* byval)
