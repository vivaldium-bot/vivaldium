+	call fastcc void @foo(%struct.MVT* byval %V) nounwind
+	%t = load i32* %a
+	ret i32 %t
+}
+
+declare fastcc void @foo(%struct.MVT* byval)
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/fastcc-sret.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/fastcc-sret.ll
