diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/IPConstantProp/2009-09-24-byval-ptr.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/IPConstantProp/2009-09-24-byval-ptr.ll
