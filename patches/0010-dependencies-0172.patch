+            gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, vertexObject);
+            gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint32Array([ 0, 1, 2]), gl.STATIC_DRAW);
