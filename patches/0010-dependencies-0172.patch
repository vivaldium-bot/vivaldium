+        rtcpPacketInformation.AddVoIPMetric(&receivedVoIPMetrics);
+
+        rtcpPacketInformation.rtcpPacketTypeFlags |= kRtcpXrVoipMetric; // received signal
+    }
+    rtcpParser.Iterate();
+}
