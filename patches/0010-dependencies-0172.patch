+declare i32 @pass_v8qi(...)
+declare void @pass_v1di(<1 x i64>)
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/mmx-arith.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/mmx-arith.ll
