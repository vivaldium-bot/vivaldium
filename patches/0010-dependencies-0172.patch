diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/ConstProp/2002-05-03-DivideByZeroException.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/ConstProp/2002-05-03-DivideByZeroException.ll
