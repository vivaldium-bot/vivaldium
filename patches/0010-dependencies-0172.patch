+  rtc::CritScope lock(&send_critsect_);
+  if (force) {
+    start_timestamp_forced_ = true;
+    start_timestamp_ = timestamp;
+  } else {
+    if (!start_timestamp_forced_) {
+      start_timestamp_ = timestamp;
+    }
+  }
+}
