+                           uint32_t ssrc) override;
+
+  typedef std::map<uint32_t, StreamStatisticianImpl*> StatisticianImplMap;
+
+  Clock* clock_;
+  rtc::scoped_ptr<CriticalSectionWrapper> receive_statistics_lock_;
+  int64_t last_rate_update_ms_;
