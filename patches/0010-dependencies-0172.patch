+  return function() {
+    var rv = context[fname].apply(context, arguments);
+    var err = context.getError();
+    if (err != context.NO_ERROR)
+      throw "GL error " + getGLErrorAsString(context, err) + " in " + fname;
+    return rv;
+  };
