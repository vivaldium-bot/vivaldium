index 0000000000000000000000000000000000000000..e2bab19e7efdd5a378ce91c1b64455f388214ae5
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/FunctionAttrs/2008-12-31-NoCapture.ll
