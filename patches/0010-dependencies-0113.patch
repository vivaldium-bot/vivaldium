diff --git a/third_party/pyelftools/elftools/elf/constants.py b/third_party/pyelftools/elftools/elf/constants.py
new file mode 100644
index 0000000000000000000000000000000000000000..b41f35a96f4f2cd204baa03d89a3fa945024981e
--- /dev/null
+++ b/third_party/pyelftools/elftools/elf/constants.py
@@ -0,0 +1,89 @@
+#-------------------------------------------------------------------------------
+# elftools: elf/constants.py
+#
+# Constants and flags, placed into classes for namespacing
+#
+# Eli Bendersky (eliben@gmail.com)
+# This code is in the public domain
+#-------------------------------------------------------------------------------
+
+class E_FLAGS(object):
+    """ Flag values for the e_flags field of the ELF header
