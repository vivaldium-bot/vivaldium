diff --git a/third_party/libdrm/src/tests/modetest/buffers.c b/third_party/libdrm/src/tests/modetest/buffers.c
new file mode 100644
index 0000000000000000000000000000000000000000..4fd310b9b00b2c676ffbf9b492c17377f66ce29a
--- /dev/null
+++ b/third_party/libdrm/src/tests/modetest/buffers.c
@@ -0,0 +1,346 @@
