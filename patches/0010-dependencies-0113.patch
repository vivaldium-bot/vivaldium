diff --git a/third_party/libdrm/src/tests/kms/kms-steal-crtc.c b/third_party/libdrm/src/tests/kms/kms-steal-crtc.c
new file mode 100644
index 0000000000000000000000000000000000000000..4b830d27a1bfb412ded0965be7077df70fde9de4
--- /dev/null
+++ b/third_party/libdrm/src/tests/kms/kms-steal-crtc.c
@@ -0,0 +1,165 @@
+/*
