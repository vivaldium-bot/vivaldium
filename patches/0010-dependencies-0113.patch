index 0000000000000000000000000000000000000000..00b08a8cb8ebbd4e25f86fa15c6eca12d3bff38e
--- /dev/null
+++ b/third_party/libdrm/src/tests/util/pattern.c
@@ -0,0 +1,870 @@
+/*
+ * Copyright 2008 Tungsten Graphics
+ *   Jakob Bornecrantz <jakob@tungstengraphics.com>
+ * Copyright 2008 Intel Corporation
+ *   Jesse Barnes <jesse.barnes@intel.com>
