+compbrlAtCursor = 2
+dotsIO = 4
+comp8Dots = 8
+pass1Only = 16
+compbrlLeftCursor = 32
+otherTrans = 64
+ucBrl = 128
+#}
+
+if __name__ == '__main__':
+    # Just some common tests.
+    print(version())
+    print(translate([b'../tables/en-us-g2.ctb'], 'Hello world!', cursorPos=5))
