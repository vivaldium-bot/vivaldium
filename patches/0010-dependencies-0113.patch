diff --git a/third_party/libdrm/src/vc4/Makefile.am b/third_party/libdrm/src/vc4/Makefile.am
new file mode 100644
index 0000000000000000000000000000000000000000..7e486b4d8eaf9fddfbf425085293a09c15667e28
--- /dev/null
