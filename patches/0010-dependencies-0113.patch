new file mode 100644
index 0000000000000000000000000000000000000000..3f15d71a8140a98f5b9c008c6eb9a6bed996c96d
--- /dev/null
+++ b/third_party/libjpeg_turbo/jdhuff.h
@@ -0,0 +1,236 @@
+/*
+ * jdhuff.h
+ *
