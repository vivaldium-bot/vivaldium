+int drmAddBufs(int fd, int count, int size, drmBufDescFlags flags,
+               int agp_offset)
+{
+    drm_buf_desc_t request;
+
+    memclear(request);
+    request.count     = count;
+    request.size      = size;
+    request.flags     = flags;
+    request.agp_start = agp_offset;
+
+    if (drmIoctl(fd, DRM_IOCTL_ADD_BUFS, &request))
+        return -errno;
+    return request.count;
+}
