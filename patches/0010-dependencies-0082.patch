+def toInt(lst):		return [Scalar(int(v.x)) for v in lst]
+def toUint(lst):	return [Uint(int(v.x)) for v in lst]
+def toBool(lst):	return [Scalar(bool(v.x)) for v in lst]
+def toVec4(lst):	return [v.toFloat().toVec4() for v in lst]
