+	IterateResult	iterate						(void);
+
+	glw::GLenum		getParamGLEnum				(void) const;
+	glw::GLint		getParamValue				(void) const;
+	glw::GLenum		getExpectedError			(void) const;
+
+	const TexParam	m_texParam;
