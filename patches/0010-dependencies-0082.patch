diff --git a/third_party/ffmpeg/libavcodec/cbrt_tablegen.h b/third_party/ffmpeg/libavcodec/cbrt_tablegen.h
new file mode 100644
index 0000000000000000000000000000000000000000..9af18d8ab5e15d6a33df932b726f835182e16850
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/cbrt_tablegen.h
@@ -0,0 +1,73 @@
+/*
+ * Header file for hardcoded AAC cube-root table
+ *
+ * Copyright (c) 2010 Reimar Döffinger <Reimar.Doeffinger@gmx.de>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
