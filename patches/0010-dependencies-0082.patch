diff --git a/third_party/ffmpeg/libavcodec/acelp_filters.c b/third_party/ffmpeg/libavcodec/acelp_filters.c
new file mode 100644
index 0000000000000000000000000000000000000000..35aa863e7a1a5cd3a9a73c6bcedf325bf3681c70
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/acelp_filters.c
@@ -0,0 +1,155 @@
+/*
+ * various filters for ACELP-based codecs
+ *
+ * Copyright (c) 2008 Vladimir Voroshilov
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
