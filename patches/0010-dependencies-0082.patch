+static const char* getDerivateFuncCaseName (DerivateFunc func)
+{
+	switch (func)
+	{
+		case DERIVATE_DFDX:		return "dfdx";
+		case DERIVATE_DFDY:		return "dfdy";
+		case DERIVATE_FWIDTH:	return "fwidth";
+		default:
+			DE_ASSERT(false);
+			return DE_NULL;
+	}
+}
