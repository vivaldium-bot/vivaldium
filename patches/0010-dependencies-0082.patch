+static inline IVec3 defaultImageSize (TextureType type)
+{
+	switch (type)
+	{
+		case TEXTURETYPE_BUFFER:	return IVec3(64,	1,		1);
+		case TEXTURETYPE_2D:		return IVec3(64,	64,		1);
