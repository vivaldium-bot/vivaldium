--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/celp_filters.c
@@ -0,0 +1,219 @@
+/*
+ * various filters for ACELP-based codecs
+ *
+ * Copyright (c) 2008 Vladimir Voroshilov
+ *
+ * This file is part of FFmpeg.
