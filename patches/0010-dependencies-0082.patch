+void ShaderStructCase::setupUniforms (int programID, const tcu::Vec4& constCoords)
+{
+	ShaderRenderCase::setupUniforms(programID, constCoords);
+	if (m_setupUniforms)
+		m_setupUniforms(m_renderCtx.getFunctions(), programID, constCoords);
+}
