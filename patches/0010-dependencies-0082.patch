+static void
+bytes_write_java( struct SResource *res, UErrorCode *status) {
+	const char* type  = "new byte[] {";
+	const char* byteDecl = "%i, ";
+    char byteBuffer[100] = { 0 };
+	uint8_t*  byteArray = NULL;
+    int byteIterator = 0;
+	
+    int32_t srcLen=res->u.fBinaryValue.fLength;
