+		}
+
+		const int numIterations = 120;
+		for (int i = 0; i < numIterations; ++i)
+		{
+			GLfloat n	= rnd.getFloat(0, 1);
+			GLfloat f	= rnd.getFloat(0, 1);
+
+			glDepthRangef(n, f);
+			m_verifier->verifyFloat2Expanded(m_testCtx, GL_DEPTH_RANGE, n, f);
