+	, m_numTargetsPerDraw	(numTargetsPerDraw)
+	, m_targetSize			(targetSize)
+	, m_queryMode			(queryMode)
+	, m_occluderTypes		(occluderTypes)
+	, m_renderCtx			(context.getRenderContext())
+	, m_program				(DE_NULL)
+	, m_iterNdx				(0)
