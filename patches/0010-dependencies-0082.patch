+glu::DataType SamplerBindingRenderCase::getSamplerTexCoordType (void) const
+{
+	switch (m_samplerType)
+	{
+		case GL_SAMPLER_2D:
+			return glu::TYPE_FLOAT_VEC2;
+
+		case GL_SAMPLER_3D:
+			return glu::TYPE_FLOAT_VEC3;
+
+		default:
+			DE_ASSERT(false);
+			return glu::TYPE_INVALID;
+	}
+}
