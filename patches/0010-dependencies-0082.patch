+private:
+	enum
+	{
+		RENDER_SIZE = 32
+	};
+
+	void			preDraw						(void);
+	void			postDraw					(void);
+
+	std::string		genVertexSource				(int numTargetSamples) const;
+	std::string		genFragmentSource			(int numTargetSamples) const;
