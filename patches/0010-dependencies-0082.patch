+														"#extension GL_EXT_gpu_shader5 : require\n"
+														"layout(triangles) in;\n"
+														"in highp vec4 v_tess_eval_color[];\n"
+														"out highp vec4 v_color;\n"
+														"precise gl_Position;\n"
+														"void main()\n"
+														"{\n"
