+template <typename T, int N>
+static int arrayIndexOf (const T (&arr)[N], const T& e)
+{
+	return (int)(std::find(DE_ARRAY_BEGIN(arr), DE_ARRAY_END(arr), e) - DE_ARRAY_BEGIN(arr));
+}
