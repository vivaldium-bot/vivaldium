+			glUseProgram(0);
+		});
+
+	// Transform feedback
+
+	ES3F_ADD_API_CASE(gen_transform_feedbacks, "Invalid glGenTransformFeedbacks() usage",
+		{
+			m_log << tcu::TestLog::Section("", "GL_INVALID_VALUE is generated if n is negative.");
