+static float getMinLodForCell (int cellNdx)
+{
+	static const float s_values[] =
+	{
+		1.0f,
+		3.5f,
+		2.0f,
+		-2.0f,
+		0.0f,
+		3.0f,
+		10.0f,
+		4.8f,
+		5.8f,
+		5.7f,
+		-1.9f,
+		4.0f,
+		6.5f,
+		7.1f,
+		-1e10,
+		1000.f
+	};
+	return s_values[cellNdx % DE_LENGTH_OF_ARRAY(s_values)];
+}
+
+static float getMaxLodForCell (int cellNdx)
+{
+	static const float s_values[] =
+	{
+		0.0f,
+		0.2f,
+		0.7f,
+		0.4f,
+		1.3f,
+		0.0f,
+		0.5f,
+		1.2f,
+		-2.0f,
+		1.0f,
+		0.1f,
+		0.3f,
+		2.7f,
+		1.2f,
+		10.0f,
+		-1000.f,
+		1e10f
+	};
+	return s_values[cellNdx % DE_LENGTH_OF_ARRAY(s_values)];
+}
