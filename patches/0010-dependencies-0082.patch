+				m_colorScale = 100.0f;
+				break;
+
+			case tcu::TEXTURECHANNELCLASS_UNSIGNED_INTEGER:
+				m_colorScale = 100.0f;
+				break;
+
+			case tcu::TEXTURECHANNELCLASS_FLOATING_POINT:
+				m_colorScale = 100.0f;
+				break;
+
+			default:
+				DE_ASSERT(false);
+		}
+	}
+	else
+		DE_ASSERT(false);
+}
