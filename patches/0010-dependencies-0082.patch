+			glu::ShaderProgram		programInvalid	(m_context.getRenderContext(), glu::makeVtxFragSources(vertexShaderSource, ""));
+			const char* tfVarying	= "gl_Position";
+			int						maxTransformFeedbackVaryings = 0;
