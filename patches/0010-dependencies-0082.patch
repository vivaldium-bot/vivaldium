+		m_commands.push_back(DispatchCommand(0,						UVec3(1,1,1)));
+		m_commands.push_back(DispatchCommand(104,					UVec3(1,3,1)));
+		m_commands.push_back(DispatchCommand(104,					UVec3(1,3,1)));
+		m_commands.push_back(DispatchCommand(52,					UVec3(1,1,4)));
+		m_commands.push_back(DispatchCommand(52,					UVec3(1,1,4)));
