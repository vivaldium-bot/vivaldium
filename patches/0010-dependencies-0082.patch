+
+			glTexSubImage2D(GL_TEXTURE_2D, ndx, 0, 0, levelW, levelH, m_format, m_dataType, data.getAccess().getDataPtr());
+		}
+	}
+
+	deUint32	m_internalFormat;
+	deUint32	m_format;
+	deUint32	m_dataType;
