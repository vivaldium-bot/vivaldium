--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/bmvaudio.c
@@ -0,0 +1,89 @@
+/*
+ * Discworld II BMV audio decoder
+ * Copyright (c) 2011 Konstantin Shishkov
