+private:
+	int				m_seed;
+	bool			m_chooseFormat;
+	bool			m_useRenderBuffer;
+	int				m_alignment;
+	GLint			m_rowLength;
+	GLint			m_skipRows;
+	GLint			m_skipPixels;
+	GLint			m_format;
+	GLint			m_type;
+
+	const int		m_width;
+	const int		m_height;
+
+	void			getFormatInfo	(tcu::TextureFormat& format, int& pixelSize);
+	void			clearColor		(tcu::Texture2D& reference, vector<deUint8>& pixelData, int pixelSize);
+};
