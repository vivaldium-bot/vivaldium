+// ProgramWrapper
+
+class ProgramWrapper
+{
+public:
+	virtual			~ProgramWrapper			(void) {}
+
+	virtual GLuint	getProgramName			(void) = 0;
+	virtual void	writeToLog				(TestLog& log) = 0;
+};
