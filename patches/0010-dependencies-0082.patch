+class BufferLayout
+{
+public:
+	std::vector<BlockLayoutEntry>		blocks;
+	std::vector<BufferVarLayoutEntry>	bufferVars;
+
+	int									getVariableIndex		(const string& name) const;
+	int									getBlockIndex			(const string& name) const;
+};
