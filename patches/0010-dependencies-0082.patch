+			"void main (void)\n"
+			"{\n"
+			"	gl_Position = a_position;\n"
+			"	v_screenPosition = (a_position.xy + vec2(1.0, 1.0)) / 2.0 * vec2(" << (int)RENDER_SIZE << ".0, " << (int)RENDER_SIZE << ".0);\n"
