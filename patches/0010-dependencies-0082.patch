diff --git a/third_party/ffmpeg/libavcodec/aarch64/cabac.h b/third_party/ffmpeg/libavcodec/aarch64/cabac.h
new file mode 100644
index 0000000000000000000000000000000000000000..6b9b77eb30b4c62c56f37054c8163ab981ad2146
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aarch64/cabac.h
@@ -0,0 +1,104 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
