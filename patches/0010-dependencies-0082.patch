+// TexImage2D() cubemap from pixel buffer object case
+class TexImageCubeBufferCase : public TextureCubeSpecCase
+{
+public:
+	TexImageCubeBufferCase (Context&	context,
+							const char*	name,
+							const char*	desc,
+							deUint32	internalFormat,
+							int			size,
+							int			rowLength,
+							int			skipRows,
+							int			skipPixels,
