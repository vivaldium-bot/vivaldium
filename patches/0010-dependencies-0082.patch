+static inline int divRoundUp (int a, int b)
+{
+	return a/b + (a%b != 0 ? 1 : 0);
+}
+
+static inline int etc2DataSize (int width, int height)
+{
+	return (int)(divRoundUp(width, 4) * divRoundUp(height, 4) * sizeof(deUint64));
