+	, m_minFilter		(minFilter)
+	, m_wrapS			(wrapS)
+	, m_wrapT			(wrapT)
+	, m_format			(format)
+	, m_dataType		(dataType)
+	, m_size			(size)
+	, m_texture			(DE_NULL)
