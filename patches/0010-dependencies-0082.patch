index 0000000000000000000000000000000000000000..24a7ca390e704bec11e8f45435ff95b370f809b2
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/dirac_arith.h
@@ -0,0 +1,196 @@
+/*
