+static string twoValuedVec4 (const string& first, const string& second, const BVec4& firstMask)
+{
+	vector<string> elems(4);
+	for (int i = 0; i < 4; i++)
+		elems[i] = firstMask[i] ? first : second;
+
+	return "vec4(" + stringJoin(elems, ", ") + ")";
+}
