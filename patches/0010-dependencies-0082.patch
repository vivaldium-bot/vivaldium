+static tcu::Vec4 generateRandomColor (de::Random& random)
+{
+	tcu::Vec4 retVal;
+
+	for (int i = 0; i < 3; ++i)
+		retVal[i] = random.getFloat();
+	retVal[3] = 1.0f;
+
+	return retVal;
+}
