--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/cngdec.c
@@ -0,0 +1,172 @@
+/*
+ * RFC 3389 comfort noise generator
+ * Copyright (c) 2012 Martin Storsjo
+ *
