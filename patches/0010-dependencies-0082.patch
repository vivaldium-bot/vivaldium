+++ b/third_party/deqp/src/modules/gles3/functional/es3fShaderPackingFunctionTests.cpp
@@ -0,0 +1,782 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES 3.0 Module
+ * -------------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
