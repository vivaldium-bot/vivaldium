+// Transform feedback
+void gen_transform_feedbacks (NegativeTestContext& ctx)
+{
+	ctx.beginSection("GL_INVALID_VALUE is generated if n is negative.");
+	GLuint id = 0;
+	ctx.glGenTransformFeedbacks(-1, &id);
