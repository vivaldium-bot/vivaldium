--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/cljrdec.c
@@ -0,0 +1,94 @@
+/*
+ * Cirrus Logic AccuPak (CLJR) decoder
+ * Copyright (c) 2003 Alex Beregszaszi
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
