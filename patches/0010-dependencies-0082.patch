+	ctx.beginSection("GL_INVALID_VALUE is generated if level is less than 0.");
+	FOR_CUBE_FACES(faceGL,
+	{
+		ctx.glCompressedTexSubImage2D(faceGL, -1, 0, 0, 0, 0, GL_COMPRESSED_RGBA8_ETC2_EAC, 0, 0);
