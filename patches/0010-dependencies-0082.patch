+void AdvancedBlendTests::init (void)
+{
+	static const glw::GLenum s_blendEquations[] =
+	{
+		GL_MULTIPLY,
+		GL_SCREEN,
+		GL_OVERLAY,
+		GL_DARKEN,
+		GL_LIGHTEN,
+		GL_COLORDODGE,
+		GL_COLORBURN,
+		GL_HARDLIGHT,
+		GL_SOFTLIGHT,
+		GL_DIFFERENCE,
