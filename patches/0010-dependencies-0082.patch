+vector<float> TextureGather2DCase::computeQuadTexCoord (int /* iterationNdx */) const
+{
+	vector<float> res;
+	glu::TextureTestUtil::computeQuadTexCoord2D(res, Vec2(-0.3f, -0.4f), Vec2(1.5f, 1.6f));
+	return res;
+}
