index 0000000000000000000000000000000000000000..5417be7d534d350650a712eec9526af9c4adbfe3
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/synth_filter_neon.S
@@ -0,0 +1,115 @@
