+	, m_coordType		(coordType)
+	, m_minFilter		(minFilter)
+	, m_wrapS			(wrapS)
+	, m_wrapT			(wrapT)
+	, m_format			(format)
+	, m_dataType		(dataType)
+	, m_width			(width)
+	, m_height			(height)
+	, m_texture			(DE_NULL)
+	, m_renderer		(renderCtx, testCtx.getLog(), glu::GLSL_VERSION_300_ES, glu::PRECISION_HIGHP)
+{
+}
