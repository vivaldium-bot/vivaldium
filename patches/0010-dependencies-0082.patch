diff --git a/third_party/ffmpeg/libavcodec/adpcmenc.c b/third_party/ffmpeg/libavcodec/adpcmenc.c
new file mode 100644
index 0000000000000000000000000000000000000000..668939c7789f7cdeb124292b47c56da9ff07850c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/adpcmenc.c
@@ -0,0 +1,726 @@
+/*
+ * Copyright (c) 2001-2003 The FFmpeg project
+ *
+ * first version by Francois Revol (revol@free.fr)
+ * fringe ADPCM codecs (e.g., DK3, DK4, Westwood)
+ *   by Mike Melanson (melanson@pcisys.net)
+ *
