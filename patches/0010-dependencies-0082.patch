+void texstorage2d (NegativeTestContext& ctx)
+{
+	deUint32  textures[] = {0x1234, 0x1234};
+
+	ctx.glGenTextures(2, textures);
+	ctx.glBindTexture(GL_TEXTURE_2D, textures[0]);
+	ctx.expectError(GL_NO_ERROR);
