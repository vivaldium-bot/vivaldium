+	ctx.beginSection("GL_INVALID_ENUM is generated if target is not one of the accepted tokens.");
+	ctx.glFramebufferTexture2D(-1, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+	ctx.expectError(GL_INVALID_ENUM);
