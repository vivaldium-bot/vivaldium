+	if (type == LOOP_TYPE_UNIFORM)
+		result.push_back(ShaderCompilerCase::UniformSpec("u_loopBound" + nameSpecialization,
+														 ShaderCompilerCase::UniformSpec::TYPE_FLOAT,
+														 (float)numLoopIterations));
+
+	return result;
+}
