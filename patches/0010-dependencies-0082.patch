+			{ 0.0f, 0.5f },
+			{ 0.0f, 0.0f },
+			{ 1.0f, 1.0f }
+		};
+		for (int ndx = 0; ndx < DE_LENGTH_OF_ARRAY(fixedTests); ++ndx)
