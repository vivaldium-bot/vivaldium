index 0000000000000000000000000000000000000000..12e8997dbc4b68ea236e4f205fe758d9d64d65e6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/atrac.c
@@ -0,0 +1,165 @@
+/*
+ * common functions for the ATRAC family of decoders
+ *
+ * Copyright (c) 2006-2013 Maxim Poliakovski
+ * Copyright (c) 2006-2008 Benjamin Larsson
+ *
+ * This file is part of FFmpeg.
