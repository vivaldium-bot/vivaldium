+			<< "\n"
+			<< "    if (gl_LocalInvocationIndex == 0u)\n"
+			<< "        imageStore(u_dstImg, ivec2(gl_WorkGroupID.xy), uvec4(0));\n"
+			<< "    barrier();\n"
+			<< "    imageAtomicAdd(u_dstImg, ivec2(gl_WorkGroupID.xy), value);\n"
