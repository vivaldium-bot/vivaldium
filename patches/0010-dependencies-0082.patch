+
+#ifndef AVCODEC_AC3ENC_H
+#define AVCODEC_AC3ENC_H
+
+#include <stdint.h>
+
+#include "libavutil/float_dsp.h"
+
+#include "ac3.h"
+#include "ac3dsp.h"
