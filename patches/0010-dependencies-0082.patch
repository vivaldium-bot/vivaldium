+TestFunctionWrapper::TestFunctionWrapper (DebugTestFunc func)
+	: m_type(TYPE_DEBUG)
+{
+	m_func.debugFn = func;
+}
+
+void TestFunctionWrapper::call (DebugMessageTestContext& ctx) const
+{
+	if (m_type == TYPE_CORE)
+		m_func.coreFn(static_cast<NegativeTestContext&>(ctx));
+	else if (m_type == TYPE_DEBUG)
+		m_func.debugFn(ctx);
+	else
+		DE_ASSERT(false);
+}
