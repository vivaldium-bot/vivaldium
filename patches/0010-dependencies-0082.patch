--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/dnxhd_parser.c
@@ -0,0 +1,141 @@
+/*
+ * DNxHD/VC-3 parser
+ * Copyright (c) 2008 Baptiste Coudurier <baptiste.coudurier@free.fr>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
