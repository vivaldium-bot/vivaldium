+static const char* getDerivateFuncName (DerivateFunc func)
+{
+	switch (func)
+	{
+		case DERIVATE_DFDX:		return "dFdx";
+		case DERIVATE_DFDY:		return "dFdy";
+		case DERIVATE_FWIDTH:	return "fwidth";
+		default:
+			DE_ASSERT(false);
+			return DE_NULL;
+	}
+}
