+static const char* getVerifierSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_TEXTURE_PARAM_INTEGER:	return "_gettexparameteri";
+		case QUERY_TEXTURE_PARAM_FLOAT:		return "_gettexparameterf";
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
+	}
+}
