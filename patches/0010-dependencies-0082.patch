index 0000000000000000000000000000000000000000..80aca8872bbf87c5f1a35647ca4c46ad243b9429
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/avdct.c
@@ -0,0 +1,139 @@
+/*
