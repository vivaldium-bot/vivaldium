+        bx              lr
+endfunc
diff --git a/third_party/ffmpeg/libavcodec/arm/cabac.h b/third_party/ffmpeg/libavcodec/arm/cabac.h
new file mode 100644
index 0000000000000000000000000000000000000000..fdbf86b45e741fc6a8bf4728cdf00b5fefe1e08c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/cabac.h
@@ -0,0 +1,108 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
