+class IdentityShaderCase : public TestCase
+{
+public:
+					IdentityShaderCase	(Context& context, const char* name, const char* description);
+
+protected:
+	std::string		getVertexSource		(void) const;
+	std::string		getFragmentSource	(void) const;
+};
