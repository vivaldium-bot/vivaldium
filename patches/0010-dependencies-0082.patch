+		<< "	highp uint values[" << m_workSize * m_workSize << "];\n"
+		<< "} sb_res;\n"
+		<< "\n"
+		<< "layout (binding = 2, r32ui) readonly uniform highp uimage2D u_workImage;\n"
+		<< "\n"
+		<< "void main ()\n"
