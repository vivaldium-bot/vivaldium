+class RawProgramWrapper : public ProgramWrapper
+{
+public:
+					RawProgramWrapper		(const RenderContext&	renderCtx,
+											 GLuint					programName,
+											 ShaderType				shaderType,
+											 const string&			source)
+						: m_program			(renderCtx, programName)
+						, m_shaderType		(shaderType)
+						, m_source			(source) {}
+					~RawProgramWrapper		(void) {}
+
