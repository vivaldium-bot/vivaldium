+{
+	Vector<T, Size> res;
+	for (int i = 0; i < Size; i++)
+		res[i] = min(v[i], s);
+	return res;
+}
+
+template<typename T, int Size>
+inline Vector<T, Size> maxVecScalar (const Vector<T, Size>& v, T s)
+{
