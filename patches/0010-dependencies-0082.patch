index 0000000000000000000000000000000000000000..fade1a6c02cd4093f20d54ed5ec96f3087b50d80
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/dcadsp.c
@@ -0,0 +1,490 @@
+/*
