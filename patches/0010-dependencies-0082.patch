index 0000000000000000000000000000000000000000..e9291aba192c736232107e33d21e0c433cbe719f
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/bitstream_filter.c
@@ -0,0 +1,183 @@
+/*
+ * copyright (c) 2006 Michael Niedermayer <michaelni@gmx.at>
+ *
