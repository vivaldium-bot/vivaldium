+		spec.apiType							= glu::ApiType::es(3,0);
+		spec.primitive							= m_primitive;
+		spec.primitiveCount						= 5;
+		spec.drawMethod							= m_method;
+		spec.indexType							= m_indexType;
+		spec.indexPointerOffset					= 0;
+		spec.indexStorage						= m_indexStorage;
