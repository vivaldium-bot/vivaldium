+Texture2DLodControlCase::Texture2DLodControlCase (Context& context, const char* name, const char* desc, deUint32 minFilter)
+	: TestCase		(context, name, desc)
+	, m_texWidth	(64)
+	, m_texHeight	(64)
+	, m_minFilter	(minFilter)
+	, m_texture		(DE_NULL)
