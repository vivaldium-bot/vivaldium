index 0000000000000000000000000000000000000000..3c7a3a7583a4a3fc1feed0eaba6c35612596d193
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/audiodsp.c
@@ -0,0 +1,118 @@
+/*
