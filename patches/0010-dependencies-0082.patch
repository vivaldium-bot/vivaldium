+ShaderInterface::~ShaderInterface (void)
+{
+	for (std::vector<StructType*>::iterator i = m_structs.begin(); i != m_structs.end(); i++)
+		delete *i;
+
+	for (std::vector<BufferBlock*>::iterator i = m_bufferBlocks.begin(); i != m_bufferBlocks.end(); i++)
+		delete *i;
+}
