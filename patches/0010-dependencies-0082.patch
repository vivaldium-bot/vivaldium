+	, m_caseType			(caseType)
+	, m_caseOptions			(caseOptions)
+	, m_drawMode			(drawMode)
+	, m_program				(DE_NULL)
+	, m_fbo					(0)
+	, m_colorBuf			(0)
+	, m_depthStencilBuf		(0)
