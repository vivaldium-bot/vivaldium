index 0000000000000000000000000000000000000000..178ea99dcfc8f2e49d1722d63ea6e8764bae1ee1
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/adxdec.c
@@ -0,0 +1,189 @@
+/*
+ * ADX ADPCM codecs
+ * Copyright (c) 2001,2003 BERO
+ *
