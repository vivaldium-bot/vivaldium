+static const char* getVerifierSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_PIPELINE_INTEGER:	return "get_program_pipelineiv";
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
