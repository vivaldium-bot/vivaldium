+int getNBitIntegerMinValue (bool isSigned, int numBits)
+{
+	DE_ASSERT(numBits < 32);
+
+	if (numBits == 0)
+		return 0;
+	else if (isSigned)
+		return deIntMinValue32(numBits);
+	else
+		return 0;
+}
