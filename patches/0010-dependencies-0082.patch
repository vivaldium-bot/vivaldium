+BlendEquationCase::IterateResult BlendEquationCase::iterate (void)
+{
+	const deUint32 blendEquations[] =
+	{
+		GL_FUNC_ADD,
+		GL_FUNC_SUBTRACT,
+		GL_FUNC_REVERSE_SUBTRACT,
+		GL_MIN,
+		GL_MAX
+	};
