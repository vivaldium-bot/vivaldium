+GroupFilterCase::GroupFilterCase (Context&								ctx,
+								  const char*							name,
+								  const char*							desc,
+								  const vector<TestFunctionWrapper>&	errorFuncs)
+	: FilterCase(ctx, name, desc, errorFuncs)
