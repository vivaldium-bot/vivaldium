+
+#include "es3fShaderDiscardTests.hpp"
+#include "glsShaderRenderCase.hpp"
+#include "tcuStringTemplate.hpp"
+#include "gluTexture.hpp"
+
+#include <map>
+#include <sstream>
+#include <string>
+
+#include "glwEnums.hpp"
+#include "glwFunctions.hpp"
+
+using tcu::StringTemplate;
+
