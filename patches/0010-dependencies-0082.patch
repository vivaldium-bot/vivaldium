+class Texture2DMipmapCase : public tcu::TestCase
+{
+public:
+
+								Texture2DMipmapCase			(tcu::TestContext&			testCtx,
+															 glu::RenderContext&		renderCtx,
+															 const glu::ContextInfo&	renderCtxInfo,
+															 const char*				name,
+															 const char*				desc,
+															 CoordType					coordType,
+															 deUint32					minFilter,
+															 deUint32					wrapS,
+															 deUint32					wrapT,
+															 deUint32					format,
+															 deUint32					dataType,
+															 int						width,
+															 int						height);
+								~Texture2DMipmapCase		(void);
