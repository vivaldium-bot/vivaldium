+	const int	minCombinedFragmentUniformComponents	= (minFragmentUniformBlocks*minUniformBlockSize)/4 + minFragmentUniformComponents;
+
+#define LIMIT_CASE(NAME, PARAM, TYPE, MIN_VAL)	\
