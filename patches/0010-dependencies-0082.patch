+	, m_texture				(0)
+	, m_vbo					(0)
+	, m_shader				(DE_NULL)
+	, m_iteration			(0)
+	, m_allIterationsPassed	(true)
+	, m_allCasesSkipped		(true)
+{
+	DE_ASSERT(type < TEXTURE_LAST);
+}
