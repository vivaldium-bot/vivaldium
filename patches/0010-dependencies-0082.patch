+class IndexGroup : public TestCaseGroup
+{
+public:
+									IndexGroup		(Context& context, const char* name, const char* descr, gls::DrawTestSpec::DrawMethod drawMethod);
+									~IndexGroup		(void);
+
+	void							init			(void);
+
+private:
