+static int intPow (int base, int exp)
+{
+	DE_ASSERT(exp >= 0);
+	if (exp == 0)
+		return 1;
+	else
+	{
+		const int sub = intPow(base, exp/2);
+		if (exp % 2 == 0)
+			return sub*sub;
+		else
+			return sub*sub*base;
+	}
