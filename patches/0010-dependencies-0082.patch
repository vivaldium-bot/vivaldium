+class InvalidTexFuncCase(ShaderCase):
+	def __init__(self, funcname, args):
+		self.name		= string.join([s.lower() for s in [funcname] + args], "_")
+		self.funcname	= funcname
+		self.args		= args
+
+	def __str__(self):
+		samplerType	= self.args[0]
