+	, m_colorScale			(1.0f)
+{
+
+	if (m_framebuffeType == TestSpec::FRAMEBUFFERTYPE_NATIVE)
+	{
+		m_colorScale = 1.0f;
+	}
+	else if (m_framebuffeType == TestSpec::FRAMEBUFFERTYPE_RENDERBUFFER)
