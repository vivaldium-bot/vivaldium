--- /dev/null
+++ b/third_party/icu/source/tools/pkgdata/pkgtypes.c
@@ -0,0 +1,300 @@
+/**************************************************************************
+*
+*   Copyright (C) 2000-2011, International Business Machines
+*   Corporation and others.  All Rights Reserved.
+*
+***************************************************************************
+*   file name:  pkgdata.c
+*   encoding:   ANSI X3.4 (1968)
