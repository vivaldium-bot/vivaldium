+#define CABAC_MASK ((1<<CABAC_BITS)-1)
+
+typedef struct CABACContext{
+    int low;
+    int range;
+    int outstanding_count;
+    const uint8_t *bytestream_start;
+    const uint8_t *bytestream;
+    const uint8_t *bytestream_end;
+    PutBitContext pb;
+}CABACContext;
+
+void ff_init_cabac_encoder(CABACContext *c, uint8_t *buf, int buf_size);
+int ff_init_cabac_decoder(CABACContext *c, const uint8_t *buf, int buf_size);
+
+#endif /* AVCODEC_CABAC_H */
diff --git a/third_party/ffmpeg/libavcodec/cabac_functions.h b/third_party/ffmpeg/libavcodec/cabac_functions.h
new file mode 100644
index 0000000000000000000000000000000000000000..fe72a826cf266a2e37226196388b44ede59af3dc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/cabac_functions.h
@@ -0,0 +1,212 @@
+/*
+ * H.26L/H.264/AVC/JVT/14496-10/... encoder/decoder
+ * Copyright (c) 2003 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
+ *
