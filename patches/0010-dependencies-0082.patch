+						~SampleMaskUniqueCase		(void);
+
+	void				init						(void);
+
+private:
+	enum
+	{
+		RENDER_SIZE = 64
+	};
+
+	std::string			genFragmentSource			(int numTargetSamples) const;
+	bool				verifySampleBuffers			(const std::vector<tcu::Surface>& resultBuffers);
