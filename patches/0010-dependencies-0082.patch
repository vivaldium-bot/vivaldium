+class BadDrawModeCase : public TestCase
+{
+public:
+	enum DrawType
+	{
+		DRAW_ARRAYS = 0,
+		DRAW_ELEMENTS,
+		DRAW_ELEMENTS_BAD_INDEX,
+
+		DRAW_LAST
+	};
+
+						BadDrawModeCase	(Context& context, const char* name, const char* desc, DrawType type);
+						~BadDrawModeCase(void);
+
+	void				init			(void);
