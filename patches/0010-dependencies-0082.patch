+
+	IterateResult iterate (void)
+	{
+		const int					maxDiff		= 0; // Values can be represented exactly in mediump.
+		de::Random					rnd			(deStringHash(getName()) ^ 0x776002);
+		std::vector<tcu::Vec2>		inputs;
