+								~Texture2DGenMipmapCase		(void);
+
+	void						init						(void);
+	void						deinit						(void);
+	IterateResult				iterate						(void);
+
+private:
+								Texture2DGenMipmapCase		(const Texture2DGenMipmapCase& other);
