+		spec.instanceCount = 1;
+		test->addIteration(spec, "instance count = 1");
+
+		spec.instanceCount = 4;
+		test->addIteration(spec, "instance count = 4");
+
+		spec.instanceCount = 11;
+		test->addIteration(spec, "instance count = 11");
+	}
+	else
+		DE_ASSERT(false);
