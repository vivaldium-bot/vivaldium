+static VarValue getSamplerUnitValue (const VarValue& sampler)
+{
+	DE_ASSERT(glu::isDataTypeSampler(sampler.type));
+
+	VarValue result;
+	result.type = glu::TYPE_INT;
+	result.val.intV[0] = sampler.val.samplerV.unit;
+
+	return result;
+}
