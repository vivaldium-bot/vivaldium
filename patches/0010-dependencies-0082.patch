+	deUint32					m_caseOptions;
+	deUint32					m_drawMode;
+
+	glu::ShaderProgram*			m_program;
+	deUint32					m_fbo;
+	deUint32					m_colorBuf;
+	deUint32					m_depthStencilBuf;
+	int							m_iterNdx;
+	de::Random					m_rnd;
+};
