+@ ----------------------------------------------------------------
+function ff_put_pixels8_x2_arm, export=1, align=5
+        @ void func(uint8_t *block, const uint8_t *pixels, ptrdiff_t line_size, int h)
+        @ block = word aligned, pixles = unaligned
