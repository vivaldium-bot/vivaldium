+	def fromScalar (numCols, numRows, scalar):
+		scalars = []
+		for col in range(0, numCols):
+			for row in range(0, numRows):
+				scalars.append(scalar if col == row else 0.0)
+		return Mat(numCols, numRows, scalars)
