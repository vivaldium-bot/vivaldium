+Texture2DMipmapCase::Texture2DMipmapCase (tcu::TestContext&			testCtx,
+										  glu::RenderContext&		renderCtx,
+										  const glu::ContextInfo&	renderCtxInfo,
+										  const char*				name,
+										  const char*				desc,
+										  CoordType					coordType,
