+template <typename T, int Size>
+static string arrayStr (const T (&arr)[Size])
+{
+	string result = "{ ";
+	for (int i = 0; i < Size; i++)
+		result += (i > 0 ? ", " : "") + toString(arr[i]);
+	result += " }";
+	return result;
+}
