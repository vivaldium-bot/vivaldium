+			'uniform highp vec4 input2;\n' +
+			'void main (void)\n' +
+			'{\n' +
+			'	gl_Position = input1 + input2;\n' +
+			'}\n';
+		/** @type {string} */ var testFragSource = '' +
+			'#version 300 es\n' +
+			'layout(location = 0) out mediump vec4 fragColor;' +
+			'void main (void)\n' +
+			'{\n' +
+			'	fragColor = vec4(0.0);\n' +
+			'}\n';
