+
+/**
+ * @constructor
+ */
+es3fVertexArrayObjectTests.Attribute = function() {
+    this.enabled = false;
+    this.size = 1;
+    this.stride = 0;
+    this.type = gl.FLOAT;
+    this.integer = false;
