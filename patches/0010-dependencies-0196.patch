+		}
+
+		for (var ndx = 0; ndx < buffers.length; ndx++)
+			gl.deleteBuffer(buffers[ndx]);
+	};
+
+	/**
+	* @constructor
+	* @extends {es3fIndexedStateQueryTests.UniformBufferCase}
+	* @param {string} name
+	* @param {string} description
