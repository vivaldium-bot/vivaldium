+	/** @typedef {function(Array<number>):number} */ es3fFragDepthTests.EvalFragDepthFunc;
+
+	/** @const {string} */ es3fFragDepthTests.s_vertexShaderSrc = '' +
+		'#version 300 es\n' +
+		'in highp vec4 a_position;\n' +
+		'in highp vec2 a_coord;\n' +
+		'out highp vec2 v_coord;\n' +
+		'void main (void)\n' +
+		'{\n' +
