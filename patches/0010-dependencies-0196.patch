+                    return m;
+                case gluShaderUtil.DataType.FLOAT_MAT2X4:
+                    var m = new tcuMatrix.Matrix(4, 2);
+                    m.setCol(0, deMath.swizzle(evalCtx.in_[0], [0, 1, 2, 3]));
