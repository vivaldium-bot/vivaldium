+es3fVertexArrayObjectTests.BufferSpec = function(count, size, componentCount, stride, offset, type, intRangeMin, intRangeMax, floatRangeMin, floatRangeMax) {
+    this.count = count;
+    this.size = size;
+    this.componentCount = componentCount;
