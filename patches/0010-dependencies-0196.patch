+                    return m;
+                case gluShaderUtil.DataType.FLOAT_MAT3X2:
+                    var m = new tcuMatrix.Matrix(2, 3);
+                    m.setCol(0, deMath.swizzle(evalCtx.in_[0], [0, 1]));
+                    m.setCol(1, deMath.swizzle(evalCtx.in_[1], [0, 1]));
