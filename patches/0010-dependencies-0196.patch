+    /**
+     * extendSign
+     * @param {number} integerLen
+     * @param {number} integer_ (deUint32)
+     * @return {number} (deInt32)
+     */
+    rrVertexAttrib.extendSign = function(integerLen, integer_) {
+        return new Int32Array([
+            deMath.binaryOp(
+                0 -
+                deMath.shiftLeft(
+                    deMath.binaryOp(
+                        integer_,
+                        deMath.shiftLeft(
+                            1,
+                            (integerLen - 1)
+                        ),
+                        deMath.BinaryOp.AND
+                    ),
+                    1
+                ) ,
+
+integer_,
+                deMath.BinaryOp.OR
+            )
+        ])[0];
+    };
