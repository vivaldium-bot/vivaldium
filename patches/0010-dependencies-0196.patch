index 0000000000000000000000000000000000000000..3238e6c2efbb556165d2e2f4565b8147b2503205
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/2.0.0/deqp/functional/gles3/es3fApiCase.js
@@ -0,0 +1,161 @@
+/*-------------------------------------------------------------------------
