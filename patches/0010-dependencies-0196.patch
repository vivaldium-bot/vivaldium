+		'#version 300 es\n' +
+		'uniform highp vec4 u_color;\n' +
+		'layout(location = 0) out mediump vec4 o_color;\n' +
+		'void main (void)\n' +
+		'{\n' +
+		'	o_color = u_color;\n' +
+		'}\n';
