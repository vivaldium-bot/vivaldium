+			'}',
+			function(programID, constCoords) {
+				es3fShaderStructTests.setUniform1f(programID, "a.a", 1.0);
+				es3fShaderStructTests.setUniform3fv(programID, "a.b", [0.0, 1.0, 2.0]);
