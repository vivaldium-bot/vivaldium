+        //Reinterpret aligned's values into the dst vector.
+        //(automatic in JS typed arrays).
+        dst[order.T0] = aligned[0];
+        if (size >= 2) dst[order.T1] = aligned[1];
+        if (size >= 3) dst[order.T2] = aligned[2];
+        if (size >= 4) dst[order.T3] = aligned[3];
+    };
