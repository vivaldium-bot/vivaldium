+        TEXTURETYPE_CUBE_MAP: 1,
+        TEXTURETYPE_2D_ARRAY: 2,
+        TEXTURETYPE_3D: 3
+    };
+
+    /**
+     * @struct
+     * @constructor
+     * @param {?es3fShaderTextureFunctionTests.TextureType} type
