+            [gluShaderUtil.DataType.SAMPLER_2D], fboOutputType
+        );
+
+        /** @type {es3fFboTestUtil.Texture2DShader} */
+        var texFromFboShader = new es3fFboTestUtil.Texture2DShader(
+            [fboSamplerType], gluShaderUtil.DataType.FLOAT_VEC4
+        );
