+    };
+    gluVarTypeUtil.SubTypeIterator.prototype.getPath = function() {
+        return this.m_path;
+    };
+
+    gluVarTypeUtil.SubTypeIterator.prototype.toString = function() {
+        var x = new gluVarTypeUtil.TypeAccessFormat(this.m_type, this.m_path);
