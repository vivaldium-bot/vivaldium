+    es3fShaderBuiltinVarTests.DepthRangeParams = function(near, far) {
+        /** @type {number} */ this.zNear = near === undefined ? 0.0 : near;
+        /** @type {number} */ this.zFar = far === undefined ? 1.0 : far;
+    };
