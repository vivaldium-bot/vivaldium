+                format: this.m_texFormat,
+                width: this.m_subW,
+                height: this.m_subH,
+                depth: this.m_subD,
+                rowPitch: rowPitch,
+                slicePitch: slicePitch,
+                data: data,
+                offset: this.m_skipImages * slicePitch + this.m_skipRows * rowPitch + this.m_skipPixels * pixelSize
+            });
+        access = new tcuTexture.PixelBufferAccess({
+                format: this.m_texFormat,
+                width: this.m_subW,
+                height: this.m_subH,
+                depth: this.m_subD,
+                rowPitch: rowPitch,
+                slicePitch: slicePitch,
+                data: data
