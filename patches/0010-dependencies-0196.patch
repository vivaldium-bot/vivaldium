diff --git a/third_party/webgl/src/conformance-suites/2.0.0/deqp/framework/referencerenderer/rrFragmentOperations.js b/third_party/webgl/src/conformance-suites/2.0.0/deqp/framework/referencerenderer/rrFragmentOperations.js
