+                                              true, // has_denorm
+                                              tcuFloatFormat.YesNoMaybe.YES, // has_infinity
+                                              tcuFloatFormat.YesNoMaybe.YES, // has_quiet_nan
+                                              tcuFloatFormat.YesNoMaybe.YES); // has_denorm
+    };
+
+});
diff --git a/third_party/webgl/src/conformance-suites/2.0.0/deqp/framework/common/tcuFuzzyImageCompare.js b/third_party/webgl/src/conformance-suites/2.0.0/deqp/framework/common/tcuFuzzyImageCompare.js
