+				${OUTPUT}
+			}
+		""
+	end
+
+	case undefine_object_invalid_syntax
+		expect compile_fail
+		both ""
+			precision mediump float;
+			#define		VAL			2.0
+			#undef		VAL	sdflkjfds
+			#define		VAL			1.0
