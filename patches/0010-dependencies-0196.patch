+		bufferedLogToConsole('Executing shader for ' + inputs.length + ' input values');
+
+		this.m_executor.useProgram();
+		shaderExecutorOutput  = this.m_executor.execute(inputs.length, [tcuMatrixUtil.flatten(inputs)])[0];
