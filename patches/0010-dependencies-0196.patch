--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/2.0.0/deqp/framework/common/tcuSurface.js
@@ -0,0 +1,184 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
