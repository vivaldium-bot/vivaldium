+						testPassed = false;
+						testPassedMsg = 'Comparison failed';
+					}
+				}
+			}
+		}
+
+
+		gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+
+		this.m_iterNdx += 1;
+		if (!testPassed) {
+			testFailedOptions(testPassedMsg, false);
+			return tcuTestCase.IterateResult.STOP;
