+
+    es3fShaderMatrixTest.multiply = function (a, b) {
+        if (a instanceof tcuMatrix.Matrix) {
+            if (b instanceof tcuMatrix.Matrix)
+                return tcuMatrix.multiply(a, b);
+            else if (b instanceof Array)
