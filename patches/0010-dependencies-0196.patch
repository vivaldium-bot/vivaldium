+    ASTC_5x5_RGBA: 13,
+    ASTC_6x5_RGBA: 14,
+    ASTC_6x6_RGBA: 15,
+    ASTC_8x5_RGBA: 16,
+    ASTC_8x6_RGBA: 17,
+    ASTC_8x8_RGBA: 18,
