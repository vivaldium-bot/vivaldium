+    };
+
+    /** @typedef {function(glsShaderRenderCase.ShaderEvalContext, es3fShaderTextureFunctionTests.TexLookupParams)} */ es3fShaderTextureFunctionTests.TexEvalFunc;
+
+    /**
+     * @param {glsShaderRenderCase.ShaderEvalContext} c
