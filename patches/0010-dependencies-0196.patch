+    DE_ASSERT((exps & ~((1 << 5) - 1)) == 0);
+    DE_ASSERT((rs & ~((1 << 9) - 1)) == 0);
+    DE_ASSERT((gs & ~((1 << 9) - 1)) == 0);
+    DE_ASSERT((bs & ~((1 << 9) - 1)) == 0);
