+        frag += layout + 'uniform ' + precision + ' ' + declaration + ' uniformValue' + postDeclaration + ';\n';
+        frag += 'layout(location = 0) out mediump vec4 fragColor;\n';
+        frag += 'void main (void)\n';
+        frag += '{\n';
+        frag += ' fragColor = vec4(' + getter + ');\n';
+        frag += '}\n';
