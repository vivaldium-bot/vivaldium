+            gl.DEPTH24_STENCIL8, gl.DEPTH32F_STENCIL8
+        ];
+
+        /**
+        * @type {Array<number>}
+        */
+        es3fFboCompletenessTests.s_es3TextureFloatFormats = [
+            gl.RGBA32F, gl.RGBA16F, gl.R11F_G11F_B10F,
+            gl.RG32F, gl.RG16F, gl.R32F, gl.R16F,
+            gl.RGBA16F, gl.RGB16F, gl.RG16F, gl.R16F
