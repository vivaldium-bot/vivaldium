+    es3fShaderMatrixTest.getOperationName = function(op) {
+    	switch (op) {
+    		case es3fShaderMatrixTest.MatrixOp.OP_ADD: return '+';
+    		case es3fShaderMatrixTest.MatrixOp.OP_SUB: return '-';
+    		case es3fShaderMatrixTest.MatrixOp.OP_MUL: return '*';
