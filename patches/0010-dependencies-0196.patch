+        attribs[1] = new rrVertexAttrib.VertexAttrib();
+        attribs[1].type = rrVertexAttrib.VertexAttribType.FLOAT;
+        attribs[1].size = 4;
+        attribs[1].stride = 0;
+        attribs[1].instanceDivisor = 0;
+        attribs[1].pointer = colors.buffer;
