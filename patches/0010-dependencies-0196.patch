+    gluVarType.indent = function(level) {
+        /** @type {string} */ var str = '';
+        for (var i = 0; i < level; i++)
+            str += '\t';
+        return str;
+    };
+
+    /**
+     * @param {gluVarType.VarType} varType
+     * @param {string} name
