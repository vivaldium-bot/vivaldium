+    tcuSkipList.getSkipStatus = function(testName) {
+        var skipEntry = _skipEntries[testName];
+        if (skipEntry === undefined) {
+            return this._getWildcardSkipStatus(testName);
+        } else {
+            return { 'skip': true, 'reason': skipEntry };
+        }
+    }
