+    gluVarType.declareVariable = function(varType, name, level) {
+        /** @type {string} */ var str = '';
+        /** @type {gluVarType.VarType} */ var type = varType;
+        /** @type {gluVarType.VarType} */ var curType = type;
+        /** @type {Array<number>} */ var arraySizes = [];
