+		}
+
+		for (var ndx = 0; ndx < buffers.length; ndx++)
+			gl.deleteBuffer(buffers[ndx]);
+
+	};
+
+	/**
+	 * @return {number}
+	 */
+	es3fIndexedStateQueryTests.UniformBufferBufferCase.prototype.getAlignment = function() {
