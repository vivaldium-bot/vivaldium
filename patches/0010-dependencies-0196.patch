+        context.enable(gl.DEPTH_TEST);
+
+        context.bindTexture(gl.TEXTURE_2D, metaballsTex);
+        rrUtil.drawQuad(
+            context, texToFboShaderID, [-1.0, -1.0, 0.0], [1.0, 1.0, 0.0]
+        );
+
+        context.bindTexture(gl.TEXTURE_2D, quadsTex);
+        rrUtil.drawQuad(
