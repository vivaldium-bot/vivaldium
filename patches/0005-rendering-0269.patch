-  return svgRoot;
-}
-
-function makeSvgWithImage(test) {
-  var svgRoot = makeSvg(test);
-  svgRoot.appendChild(makeImage(test));
-  return svgRoot;
-}
-
-var t0 = async_test("No 'load' event fired after document load for outer SVG root.");
