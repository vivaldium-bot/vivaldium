+    code += "        }\n";
+    code += "        if (a + b + 2 > __i) {\n";
+    code += "            c = e;\n";
+    code += "            x += c;\n";
+    code += "        }\n";
+    code += "        if (a + b + 3 > __i) {\n";
+    code += "            c = f;\n";
+    code += "            x += c;\n";
