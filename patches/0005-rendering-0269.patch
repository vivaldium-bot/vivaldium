+description(
+"Tests that if you alias the arguments in a very small function, arguments simplification still works even if you OSR exit."
+);
+
+function foo() {
+    var args = arguments;
+    return args[0] + args[1] + args[2];
+}
+
+var result = "";
+for (var i = 0; i < 300; ++i) {
+    var a;
+    if (i < 200)
+        a = i;
+    else
+        a = "hello";
+    var b = i + 1;
+    var c = i + 3;
+    result += foo(a, b, c);
+}
+
+shouldBe("result", "\"\"");
