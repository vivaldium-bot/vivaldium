-const svgNs = 'http://www.w3.org/2000/svg';
-
-function makeImage(test) {
-  var image = document.createElementNS(svgNs, 'image');
-  image.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', 'resources/red-checker.png');
