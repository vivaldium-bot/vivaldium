+    code += "            x += c;\n";
+    code += "        }\n";
+    code += "        if (a + b + 5 > __i) {\n";
+    code += "            c = h;\n";
+    code += "            x += c;\n";
+    code += "        }\n";
+    code += "        if (a + b + 6 > __i) {\n";
+    code += "            c = i;\n";
+    code += "            x += c;\n";
+    code += "        }\n";
+    code += "        if (a + b + 7 > __i) {\n";
+    code += "            c = j;\n";
+    code += "            x += c;\n";
+    code += "        }\n";
+    code += "        if (a + b + 8 > __i) {\n";
+    code += "            c = k;\n";
+    code += "            x += c;\n";
