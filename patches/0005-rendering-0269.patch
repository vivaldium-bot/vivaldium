+    EXPECT_EQ(static_cast<unsigned>(expected_length), length);         \
+    EXPECT_EQ(data, decoder.pc());                                     \
+    EXPECT_TRUE(decoder.ok());                                         \
+    EXPECT_EQ(expected, decoder.consume_i32v());                       \
+    EXPECT_EQ(data + expected_length, decoder.pc());                   \
+  } while (false)
