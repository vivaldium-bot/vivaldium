+  void Write(Bytecode bytecode, uint32_t operand0, uint32_t operand1,
+             BytecodeSourceInfo info = BytecodeSourceInfo());
+  void Write(Bytecode bytecode, uint32_t operand0, uint32_t operand1,
+             uint32_t operand2, BytecodeSourceInfo info = BytecodeSourceInfo());
+  void Write(Bytecode bytecode, uint32_t operand0, uint32_t operand1,
