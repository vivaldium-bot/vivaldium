-<script><![CDATA[
-  if (window.testRunner)
-    testRunner.dumpAsText();
-  var svgTree1 = document.getElementById("svgTree1");
-
-  // Test support for "getElementById" on svgTree1
-  var subElem1 = svgTree1.getElementById("subElem1");
