+static void
+yyerror (
+
+         const char *s)
+{
+
+
+  fprintf (stderr, "%d.%d",
+           (yylloc).first_line, (yylloc).first_column);
+  if ((yylloc).first_line != (yylloc).last_line)
+    fprintf (stderr, "-%d.%d",
+	     (yylloc).last_line,  (yylloc).last_column - 1);
+  else if ((yylloc).first_column != (yylloc).last_column - 1)
+    fprintf (stderr, "-%d",
+	     (yylloc).last_column - 1);
+  fprintf (stderr, ": ");
+  fprintf (stderr, "%s\n", s);
+}
