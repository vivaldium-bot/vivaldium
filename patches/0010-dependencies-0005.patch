--- /dev/null
+++ b/third_party/boringssl/src/crypto/x509v3/v3_pci.c
@@ -0,0 +1,317 @@
+/* v3_pci.c -*- mode:C; c-file-style: "eay" -*- */
+/*
+ * Contributed to the OpenSSL Project 2004 by Richard Levitte
+ * (richard@levitte.org)
