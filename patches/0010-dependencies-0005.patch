+      init = 0;
+
+    }
+
+
+
+  /* Skip white space.  */
+  while ((c = get_char ()) == ' ' || c == '\t')
+    {
+
+    }
+
+  /* process numbers   */
+  if (c == '.' || isdigit (c))
+    {
+      unget_char ( c);
+      (yylval).ival = read_signed_integer ();
