+main (int argc, const char **argv)
+{
+  char *endp;
+  YYSTYPE yylval_init;
+  if (argc != 2)
+    abort ();
+  yylval_init = strtol (argv[1], &endp, 10);
+  if (! (argv[1] != endp
+	 && 0 <= yylval_init && yylval_init <= INT_MAX
+	 && errno != ERANGE))
+    abort ();
+  yydebug = 1;
+  {
+    int count;
+    int status;
+    for (count = 0; count < 2; ++count)
+      {
+        int new_status;
+        yylval = yylval_init;
+        new_status = yyparse ();
+        if (count > 0 && new_status != status)
+          abort ();
+        status = new_status;
+      }
+    return status;
+  }
