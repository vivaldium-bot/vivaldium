+
+static YYLTYPE last_yylloc;
+
+static int
+get_char (void)
+{
+  int res = getc (input);
+  ;
+
+  last_yylloc = (calclloc);
+  if (res == '\n')
+    {
+      (calclloc).last_line++;
+      (calclloc).last_column = 1;
+    }
+  else
+    (calclloc).last_column++;
+
+  return res;
+}
+
+static void
+unget_char ( int c)
+{
+  ;
+
+  /* Wrong when C == `\n'. */
+  (calclloc) = last_yylloc;
+
+  ungetc (c, input);
+}
+
+static int
+read_signed_integer (void)
+{
+  int c = get_char ();
+  int sign = 1;
+  int n = 0;
+
+  ;
+  if (c == '-')
+    {
+      c = get_char ();
+      sign = -1;
+    }
+
+  while (isdigit (c))
+    {
+      n = 10 * n + (c - '0');
+      c = get_char ();
+    }
+
+  unget_char ( c);
+
+  return sign * n;
+}
