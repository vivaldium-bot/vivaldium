+DSA *DSA_new(void) {
+  DSA *dsa = OPENSSL_malloc(sizeof(DSA));
+  if (dsa == NULL) {
+    OPENSSL_PUT_ERROR(DSA, ERR_R_MALLOC_FAILURE);
+    return NULL;
+  }
+
+  memset(dsa, 0, sizeof(DSA));
+
+  dsa->references = 1;
