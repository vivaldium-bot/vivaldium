+#: src/complain.c:93 src/complain.c:100 src/gram.c:311 src/reduce.c:387
+#: src/reduce.c:396
+msgid "warning"
+msgstr "aviso"
+
+# Duda: desconozco cu·l ser· el convenio en la lista de correo a
+# propÛsito de "fatal". Por favor, comprueba que "error grave" es
+# preferido por todos los miembros a "error fatal" - cll
+# veremos que dice la mayorÌa, como hay otros 2 revisores
+# La verdad es que a mi lo de error fatal me suena fatal
+# ngp
+#
+#: src/complain.c:130 src/complain.c:137
+#, fuzzy
+msgid "fatal error"
+msgstr "error grave: "
+
+#: src/conflicts.c:77
+#, c-format
+msgid "    Conflict between rule %d and token %s resolved as shift"
+msgstr ""
+"    El conflicto entre la regla %d y el terminal %s se resuelve como "
+"desplazamiento."
+
+#: src/conflicts.c:86
+#, c-format
+msgid "    Conflict between rule %d and token %s resolved as reduce"
+msgstr ""
+"    El conflicto entre la regla %d y el terminal %s se resuelve como "
+"reducciÛn."
+
+#: src/conflicts.c:94
+#, c-format
+msgid "    Conflict between rule %d and token %s resolved as an error"
+msgstr ""
+"    El conflicto entre la regla %d y el terminal %s se resuelve como un "
+"error."
+
+#: src/conflicts.c:492
+#, c-format
+msgid "conflicts: %d shift/reduce, %d reduce/reduce\n"
+msgstr "conflictos: %d desplazamiento/reducciÛn, %d reducciÛn/reducciÛn\n"
+
+# Date cuenta de que `%d' puede ser cualquier n˙mero decimal. PodrÌa
+# ocurrir, por lo tanto, que tu mensaje en ejecuciÛn se vea luego como:
+#
+# 23845789243789 desplazamiento/reducciÛn
+#
+# (°estoy exagerando!, por supuesto :)
+#
+# Te sugiero por lo tanto que aÒadas el caso (s) tal y como se hace en
+# espaÒol habitualmente.
+# ok
+# ngp
+#
+#: src/conflicts.c:495
+#, c-format
+msgid "conflicts: %d shift/reduce\n"
+msgstr "conflictos: %d desplazamiento(s)/reducciÛn(ones)\n"
+
+# Date cuenta de que `%d' puede ser cualquier n˙mero decimal. PodrÌa
+# ocurrir, por lo tanto, que tu mensaje en ejecuciÛn se vea luego como:
+#
+# 23845789243789 reducciÛn/reducciÛn
+#
+# (°estoy exagerando!, por supuesto :)
+#
+# Te sugiero por lo tanto que aÒadas el caso (s) tal y como se hace en
+# espaÒol habitualmente.
+#
+# ok
+# ngp
+#: src/conflicts.c:497
+#, c-format
+msgid "conflicts: %d reduce/reduce\n"
+msgstr "conflictos: %d reducciÛn(ones)/reducciÛn(ones)\n"
+
+#: src/conflicts.c:515
+#, c-format
+msgid "State %d "
+msgstr "Estado %d "
+
+#: src/conflicts.c:582
+#, c-format
+msgid "%%expect-rr applies only to GLR parsers"
+msgstr "%%expect-rr afecta sÛlo a los analizadores GLR"
+
+#: src/conflicts.c:607
+#, c-format
+msgid "expected %d shift/reduce conflict"
+msgid_plural "expected %d shift/reduce conflicts"
+msgstr[0] "esperado %d conflicto desplazamiento/reducciÛn"
+msgstr[1] "esperados %d conflictos desplazamiento/reducciÛn"
+
+#: src/conflicts.c:612
+#, c-format
+msgid "expected %d reduce/reduce conflict"
+msgid_plural "expected %d reduce/reduce conflicts"
+msgstr[0] "esperado %d conflicto reducciÛn/reducciÛn"
+msgstr[1] "esperados %d conflictos reducciÛn/reducciÛn"
+
+#: src/files.c:112
+#, c-format
+msgid "cannot open file `%s'"
+msgstr "no se puede abrir el fichero `%s'"
+
+#: src/files.c:128
+#, c-format
+msgid "I/O error"
+msgstr "Error de E/S"
+
+#: src/files.c:131
+#, c-format
+msgid "cannot close file"
+msgstr "no se puede cerrar el fichero"
+
+#: src/files.c:357
+#, c-format
+msgid "refusing to overwrite the input file %s"
+msgstr ""
+
+#: src/files.c:362
+#, c-format
