+at_status=$?
+at_failed=false
+at_func_diff_devnull "$at_stderr" || at_failed=:
+$at_diff expout "$at_stdout" || at_failed=:
+at_func_check_status 0 $at_status "$at_srcdir/existing.at:956"
+
+$at_failed && at_func_log_failure
+$at_traceon; }
