+int RSA_generate_key_ex(RSA *rsa, int bits, BIGNUM *e_value, BN_GENCB *cb) {
+  if (rsa->meth->keygen) {
+    return rsa->meth->keygen(rsa, bits, e_value, cb);
+  }
+
+  return rsa_default_keygen(rsa, bits, e_value, cb);
+}
