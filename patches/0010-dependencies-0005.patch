+#if defined(__GNUC__) && __GNUC__ >= 2
+#if defined(OPENSSL_X86_64)
+#define BSWAP8(x)                 \
+  ({                              \
+    uint64_t ret = (x);           \
+    asm("bswapq %0" : "+r"(ret)); \
+    ret;                          \
+  })
+#define BSWAP4(x)                 \
+  ({                              \
+    uint32_t ret = (x);           \
+    asm("bswapl %0" : "+r"(ret)); \
