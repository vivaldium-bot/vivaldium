+int yylex (void);
+static int get_char (void);
+static void unget_char ( int c);
+
+
+static YYLTYPE last_yylloc;
+
+static int
+get_char (void)
+{
+  int res = getc (input);
+  ;
+
+  last_yylloc = (yylloc);
+  if (res == '\n')
+    {
+      (yylloc).last_line++;
+      (yylloc).last_column = 1;
+    }
+  else
+    (yylloc).last_column++;
+
+  return res;
