+          PUTU32(ctx->Yi.c + 12, ctr);
+        } else {
+          ctx->Yi.d[3] = ctr;
+        }
+      }
+      c = in[i];
+      out[i] = c ^ ctx->EKi.c[n];
+      ctx->Xi.c[n] ^= c;
+      n = (n + 1) % 16;
+      if (n == 0) {
