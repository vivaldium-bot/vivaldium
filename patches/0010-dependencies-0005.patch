+  char buffer[256];
+  int c;
+  unsigned int i;
+  static int lineNum = 1;
+  static int colNum = 0;
+
+#if YYPURE
+# undef yylloc
+# define yylloc (*llocp)
+# undef yylval
+# define yylval (*lvalp)
+#endif
+
+  while (1)
+    {
+      if (feof (stdin))
+	abort ();
+      c = getchar ();
+      switch (c)
+	{
+	case EOF:
+	  return 0;
+	case '\t':
+	  colNum = (colNum + 7) & ~7;
+	  break;
+	case ' ': case '\f':
+	  colNum += 1;
+	  break;
+	case '\n':
