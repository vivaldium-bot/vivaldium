+  i = len >> 3;
+  if (i) {
+    for (;;) {
+      RC4_LOOP(in, out, 0);
+      RC4_LOOP(in, out, 1);
+      RC4_LOOP(in, out, 2);
+      RC4_LOOP(in, out, 3);
+      RC4_LOOP(in, out, 4);
+      RC4_LOOP(in, out, 5);
+      RC4_LOOP(in, out, 6);
+      RC4_LOOP(in, out, 7);
