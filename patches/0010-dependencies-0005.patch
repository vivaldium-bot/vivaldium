index 0000000000000000000000000000000000000000..bc127c1c9e0dac17b78bb1664643a129e9e046f7
--- /dev/null
+++ b/third_party/boringssl/src/crypto/constant_time_test.c
@@ -0,0 +1,307 @@
+/*
+ * Utilities for constant-time cryptography.
+ *
+ * Author: Emilia Kasper (emilia@openssl.org)
+ * Based on previous work by Bodo Moeller, Emilia Kasper, Adam Langley
+ * (Google).
+ * ====================================================================
