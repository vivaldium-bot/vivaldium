+    {
+      $$ = -1;
+      printf ("line (%d@%d-%d): '(' (%d@%d-%d) error (@%d-%d) ')' (%d@%d-%d)\n",
+              $$, RANGE (@$), $1, RANGE (@1), RANGE (@2), $3, RANGE (@3));
+    }
+;
+
+thing:
+  'x'
+    {
+      $$ = $1;
+      printf ("thing (%d@%d-%d): 'x' (%d@%d-%d)\n",
