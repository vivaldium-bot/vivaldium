+  alarm (100);
+
+  if (argc == 2)
+    input = fopen (argv[1], "r");
+  else
+    input = stdin;
+
+  if (!input)
+    {
+      perror (argv[1]);
+      return 3;
+    }
+
+
+  status = yyparse ();
+  fclose (input);
+  if (global_result != result)
+    abort ();
+  if (global_count != count)
+    abort ();
+  return status;
