+cat >calc-lex.c <<'_ATEOF'
+#include <config.h>
+/* We don't need perfect functions for these tests. */
+#undef malloc
+#undef memcmp
+#undef realloc
+
+#include "calc.h"
+
+#include <ctype.h>
