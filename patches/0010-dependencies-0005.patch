+ASN1_OBJECT *OBJ_txt2obj(const char *s, int dont_search_names) {
+  int nid = NID_undef;
+  ASN1_OBJECT *op = NULL;
+  unsigned char *buf;
+  unsigned char *p;
+  const unsigned char *bufp;
+  int contents_len, total_len;
