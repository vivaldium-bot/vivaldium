+			MBEE_CONSTANT
+			HPAREXPSEPARATOR
+				{}
+			IDENTIFIER_LISTC
+		|       TYPE
+			HIDENTIFIER
+			MBEE_CONSTANT
+		|       MBEE_TYPE
+			HARRAY  {}
+			ARR_SEGMENT_LIST
+		|       HSWITCH
+			HIDENTIFIER
+			HASSIGN {}
+			SWITCH_LIST
