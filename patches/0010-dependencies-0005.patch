+
+%token TYPENAME ID
+
+%right '='
+%left '+'
+
+%glr-parser
+
+%destructor { free_node ($$); } stmt expr decl declarator TYPENAME ID
+
+%%
+
+prog :
+     | prog stmt   {
+			char *output;
+			output = node_to_string ($2);
+			printf ("%s\n", output);
+			free (output);
+			free_node ($2);
+		   }
+     ;
+
+stmt : expr ';'  %merge <stmtMerge>	{ $$ = $1; }
+     | decl      %merge <stmtMerge>
+     | error ';'	{ $$ = new_nterm ("<error>", 0, 0, 0); }
+     | '@'		{ YYACCEPT; }
+     ;
