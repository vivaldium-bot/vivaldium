+  {                                                       \
+    c += n;                                               \
+    switch (n) {                                          \
+      case 8:                                             \
+        *(--(c)) = (uint8_t)(((l2) >> 24L) & 0xff); \
+      case 7:                                             \
+        *(--(c)) = (uint8_t)(((l2) >> 16L) & 0xff); \
+      case 6:                                             \
+        *(--(c)) = (uint8_t)(((l2) >> 8L) & 0xff);  \
+      case 5:                                             \
+        *(--(c)) = (uint8_t)(((l2)) & 0xff);        \
+      case 4:                                             \
+        *(--(c)) = (uint8_t)(((l1) >> 24L) & 0xff); \
+      case 3:                                             \
+        *(--(c)) = (uint8_t)(((l1) >> 16L) & 0xff); \
+      case 2:                                             \
+        *(--(c)) = (uint8_t)(((l1) >> 8L) & 0xff);  \
+      case 1:                                             \
+        *(--(c)) = (uint8_t)(((l1)) & 0xff);        \
