+| blanks and tabs, returns 0 for EOF.                            |
+`---------------------------------------------------------------*/
+
+int
+yylex (void)
+{
+  static int init = 1;
+  int c;
+
+  if (init)
+    {
+      init = 0;
+
+    }
+
+
+
+  /* Skip white space.  */
+  while ((c = get_char ()) == ' ' || c == '\t')
+    {
+
+    }
+
+  /* process numbers   */
+  if (c == '.' || isdigit (c))
+    {
+      unget_char ( c);
+      (yylval).ival = read_signed_integer ();
+      return NUM;
+    }
+
+  /* Return end-of-file.  */
+  if (c == EOF)
