+  static const limb two58m2 = (((limb)1) << 58) - (((limb)1) << 2);
+  static const limb two58m42m2 =
+      (((limb)1) << 58) - (((limb)1) << 42) - (((limb)1) << 2);
+
+  /* Add 0 mod 2^224-2^96+1 to ensure out > in */
+  out[0] += two58p2;
+  out[1] += two58m42m2;
+  out[2] += two58m2;
+  out[3] += two58m2;
+
+  out[0] -= in[0];
+  out[1] -= in[1];
+  out[2] -= in[2];
+  out[3] -= in[3];
+}
