+/* Square a field element: out = in^2 */
+static void felem_square(widefelem out, const felem in) {
+  limb tmp0, tmp1, tmp2;
+  tmp0 = 2 * in[0];
+  tmp1 = 2 * in[1];
+  tmp2 = 2 * in[2];
