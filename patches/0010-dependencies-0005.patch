diff --git a/third_party/boringssl/src/fuzz/cert.cc b/third_party/boringssl/src/fuzz/cert.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e813ed566ebec12a1900c9c1adb69f47aeb39085
--- /dev/null
+++ b/third_party/boringssl/src/fuzz/cert.cc
@@ -0,0 +1,18 @@
+#include <openssl/mem.h>
+#include <openssl/x509.h>
+
+extern "C" int LLVMFuzzerTestOneInput(uint8_t *buf, size_t len) {
+  const uint8_t *bufp = buf;
+  X509 *x509 = d2i_X509(NULL, &bufp, len);
+  if (x509 != NULL) {
+    /* Extract the public key. */
+    EVP_PKEY_free(X509_get_pubkey(x509));
+
+    /* Reserialize the structure. */
+    uint8_t *der = NULL;
+    i2d_X509(x509, &der);
+    OPENSSL_free(der);
+  }
+  X509_free(x509);
+  return 0;
+}
