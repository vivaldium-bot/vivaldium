+      uint8_t *p = (uint8_t *)Xi;
+      uint32_t v;
+      v = (uint32_t)(Z.hi >> 32);
+      PUTU32(p, v);
+      v = (uint32_t)(Z.hi);
+      PUTU32(p + 4, v);
+      v = (uint32_t)(Z.lo >> 32);
+      PUTU32(p + 8, v);
+      v = (uint32_t)(Z.lo);
+      PUTU32(p + 12, v);
+#endif
+    } else {
+      Xi[0] = Z.hi;
+      Xi[1] = Z.lo;
+    }
