+};
+
+%code provides {
+#include <stdio.h>
+/* The input.  */
+extern FILE *input;
+}
+
+%code {
+#include <stdlib.h>
+#include <string.h>
+#if HAVE_UNISTD_H && !_WIN32
+# include <unistd.h>
+#else
