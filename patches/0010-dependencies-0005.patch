+[AT_SETUP([Require $1])
+AT_DATA_GRAMMAR([input.y],
+[[%require "$1";
+%%
+empty_file:;
+]])
+AT_BISON_CHECK([-o input.c input.y], $2, [], ignore)
+AT_CLEANUP
+])
