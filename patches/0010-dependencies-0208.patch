diff --git a/third_party/webrtc/stats/rtcstats.cc b/third_party/webrtc/stats/rtcstats.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1968dd030e0fbc7b5f3300837f2ec880f538659a
--- /dev/null
+++ b/third_party/webrtc/stats/rtcstats.cc
@@ -0,0 +1,155 @@
+/*
