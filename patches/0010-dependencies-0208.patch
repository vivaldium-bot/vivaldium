+  STUN_ATTR_MAGIC_COOKIE                = 0x000f,  // ByteString, 4 bytes
+  STUN_ATTR_BANDWIDTH                   = 0x0010,  // UInt32
+  STUN_ATTR_DESTINATION_ADDRESS         = 0x0011,  // Address
+  STUN_ATTR_SOURCE_ADDRESS2             = 0x0012,  // Address
