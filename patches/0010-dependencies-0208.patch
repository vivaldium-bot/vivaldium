+
+#ifndef WEBRTC_P2P_QUIC_QUICCONNECTIONHELPER_H_
+#define WEBRTC_P2P_QUIC_QUICCONNECTIONHELPER_H_
+
+#include "net/quic/crypto/quic_random.h"
