-    case 'l':
-        TestNavigator._scrollToLastTest();
-        break;
-    case 'e':
-        TestNavigator._expandCurrentTest();
-        break;
-    case 'c':
-        TestNavigator._collapseCurrentTest();
-        break;
-    case 't':
