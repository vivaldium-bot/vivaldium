-    img.onload = function () { log("FAIL: not cached image loaded"); }
-    img.src = "resources/boston.gif?nocache";
-    document.getElementById("img").appendChild(img);
-
-    // Load an image from cache.
-    var imgFromCache = document.createElement('img');
