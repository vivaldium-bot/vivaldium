-class PathParser {
-  constructor(path) {
-    this.path = path;
-    let href;
-    [href, this.dir, this.file] = path.match("/(.*/)?(.*)");
-    this.dir = this.dir || "";
-    [, this.raw_basename, this.raw_extension] = this.file.match(/(.+)\.(.+)/);
-
-    // WebKit/Tools/Scripts/webkitpy/layout_tests/port/base.py output_filename()
-    let index = this.raw_extension.indexOf("?");
