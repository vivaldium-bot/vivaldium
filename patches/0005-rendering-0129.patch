-    return shouldBeResolved(check2({}, '', '', ''), 'valid arguments');
-}).then(function() {
-    return shouldBeResolved(check2({}, ''), 'valid arguments');
-}).then(function() {
-    return shouldBeRejected(check2(3, ''), 'type error(Dictionary)');
