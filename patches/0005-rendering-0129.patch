-testEscapeAndEncode("𯿿", "%uD87F%uDFFF", "%F0%AF%BF%BF");
-testUnescapeAndDecode("%F0%AF%BF%BF", "\xF0\xAF\xBF\xBF", "𯿿");
-
-// --------
