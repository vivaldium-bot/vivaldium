-var arr = [2, 5, 8, 1, 4];
-delete arr[1];
-arr.some(isBigEnough);
-print("Done with first array.");
-
-arr = [undefined];
-arr.some(isBigEnough);
-print("Done with second array.");
-
-delete arr[0];
-arr.some(isBigEnough);
-print("Done with third array.");
-
-arr = new Array(20);
-arr.some(isBigEnough);
-print("Done with fourth array.");
-
-arr[17] = undefined;
-arr.some(isBigEnough);
-print("Done with fifth array.");
-
-</script>
