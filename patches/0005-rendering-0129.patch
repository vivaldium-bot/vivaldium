-    for (var key in tree) {
-        var newPrefix = prefix ? (prefix + '/' + key) : key;
-        if ('archived_results' in tree[key]) {
-            var testObject = tree[key];
-            testObject.name = newPrefix;
-            handler(testObject);
-        } else
-            forEachTest(handler, tree[key], newPrefix);
-    }
-}
