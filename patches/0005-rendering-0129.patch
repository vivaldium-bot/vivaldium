-    return shouldBeResolved(check(null, true, {}, '', []), 'convert(long)');
-}).then(function() {
-    return shouldBeResolved(check(3, {}, {}, '', []), 'convert(boolean)');
-}).then(function() {
-    return shouldBeRejected(check(3, true, 3, '', []), 'type error(Dictionary)');
