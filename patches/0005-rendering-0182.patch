-        else
-            increment /= 2;
-        return increment;
-    }
-
-    video.onseeking = t.step_func(function() {});
-    video.onplay = t.step_func(function() {});
-    video.onpause = t.step_func(function() {});
-
-    video.src = findMediaFile("video", "content/test");
-});
-</script>
