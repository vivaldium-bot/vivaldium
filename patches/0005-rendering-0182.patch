-        text run at (0,60) width 90: "browsers."
-    LayoutBlockFlow {H2} at (0,670.84) size 512x29
-      LayoutText {#text} at (0,-5) size 92x38
-        text run at (0,-5) width 92: "Bug 3"
-    LayoutBlockFlow {P} at (0,726.39) size 512x116
