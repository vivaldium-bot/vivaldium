+})();
+
+// Length change detected during loop, must cause properly handled eager deopt.
+(function() {
+  var result = 0;
+  var eagerDeoptInCalled = function(deopt) {
+    var callback = function(v,i,o) {
+      result += v;
+      a.length = (i == 13 && deopt) ? 25 : 27;
+      return v;
+    }
+    a.map(callback);
+  }
+  eagerDeoptInCalled();
+  eagerDeoptInCalled();
