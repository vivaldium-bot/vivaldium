+
+
+  test('withSamples', function() {
+    var thread;
+    var cpu;
+    var model = tr.c.TestUtils.newModelWithEvents([], {
+      shiftWorldToZero: false,
+      pruneContainers: false,
+      customizeModelCallback: function(model) {
+        cpu = model.kernel.getOrCreateCpu(1);
