+    assert.equal(group.bounds.max, 7);
+  });
+
+  test('boundsWithTwoPartials', function() {
+    var group = new SliceGroup(newFakeThread());
+    group.beginSlice('', 'a', 0);
+    group.beginSlice('', 'a', 1);
