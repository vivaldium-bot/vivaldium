+    assert.equal(getComputedStyle(infoBar)['display'], 'flex');
+
+    infoBar.visible = false;
+    assert.equal(getComputedStyle(infoBar)['display'], 'none');
+
+    infoBar.visible = true;
+    assert.equal(getComputedStyle(infoBar)['display'], 'flex');
+  });
+});
