+      os.dup2(output.fileno(), sys.__stdout__.fileno())
+      os.dup2(output.fileno(), sys.__stderr__.fileno())
+      sys.stdout = os.fdopen(sys.__stdout__.fileno(), 'w', 0)
+      sys.stderr = os.fdopen(sys.__stderr__.fileno(), 'w', 0)
