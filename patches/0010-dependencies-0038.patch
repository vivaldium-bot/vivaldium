+
+  test('getSlicesOfName', function() {
+    var group = new SliceGroup(newFakeThread());
+    var expected = [];
+
+    for (var i = 0; i < 10; i++) {
+      var aSlice = newSliceEx({title: 'a', start: i, duration: i + 1});
