+    assert.equal(group.slices[1].cpuDuration, 8);
+    assert.equal(group.slices[1].cpuSelfTime, 8);
+    assert.equal(group.slices[2].cpuDuration, 11);
+    assert.equal(group.slices[2].cpuSelfTime, 11);
