+      <span>
+        <label>
+          <input type="radio" name="test-type-to-run" value="perf" />
+          Run perf tests
+          </label>
+      </span>
+      <span>
+        <label>
+          <input type="radio" name="test-type-to-run" value="all" />
+          Run all tests
+        </label>
+      </span>
+    </div>
+    <span>
+      <label>
+        <input type="checkbox" id="short-format" /> Short format</label>
