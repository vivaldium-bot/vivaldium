+    function assertRectEquals(a, b, opt_message) {
+      var ok = true;
+      if (a.x === b.x && a.y === b.y &&
+          a.width === b.width && a.height === b.height) {
+        return;
+      }
+      var message = opt_message || 'Expected "' + a.toString() +
