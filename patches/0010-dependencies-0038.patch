+class ProjectSdkTest(cros_test_lib.TempDirTestCase):
+  """Unittest for project_sdk.py"""
+
+  def setUp(self):
+    self.version = '1.2.3'
+
+    # Define assorted paths to test against.
+    self.bogus_dir = os.path.join(self.tempdir, 'bogus')
