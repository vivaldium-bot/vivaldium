+    proc3 = subprocess.Popen(['xxd', '-r', '-p'], stdin=proc2.stdout,
+                             stdout=subprocess.PIPE)
+    proc4 = subprocess.Popen(['base64'], stdin=proc3.stdout,
+                             stdout=subprocess.PIPE)
+    result = proc4.communicate()
+    return result[0][:-1]
