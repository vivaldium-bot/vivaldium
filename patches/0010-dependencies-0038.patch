+
+      mainBrowserThread.name = 'CrBrowserMain';
+      mainRendererThread.name = 'CrRendererMain';
+      compositorThread.name = 'Compositor';
+
+      // Expectation: s2 should be included but not s3
+      // GestureScrollUpdate:  [       as1        ]
+      // CrBrowserMain:        [s0]              [s1]
+      //                         |               /|\
+      // CrRendererMain:         |    [s2] [s3]   |
