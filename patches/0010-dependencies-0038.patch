+        name: 'A:a1/eyJhIjoxfQ==',
+        args: {params: ''},
+        pid: 1,
+        ts: 110,
+        cat: 'blink.user_timing',
+        tid: 2,
+        id: 3,
+        ph: 'e'
+      },
+      {
+        name: 'A:a2/eyJhIjoyLCJiIjoyfQ==',
+        args: {params: ''},
