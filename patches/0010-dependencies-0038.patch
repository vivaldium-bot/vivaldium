+    setStats: function(stats) {
+      this.stats_ = stats;
+    }
+  };
+
+  ObjectSnapshot.register(
+    SystemStatsSnapshot,
+    {typeName: 'base::TraceEventSystemStatsMonitor::SystemStats'});
+
+  return {
+    SystemStatsSnapshot: SystemStatsSnapshot
+  };
+});
