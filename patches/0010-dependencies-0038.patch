+    ctx.beginPath();
+    ctx.moveTo(tmp_p0[0], tmp_p0[1]);
+    ctx.lineTo(tmp_p1[0], tmp_p1[1]);
+    ctx.lineTo(tmp_p2[0], tmp_p2[1]);
+    ctx.closePath();
+
+    tmp_p1[0] -= tmp_p0[0];
+    tmp_p1[1] -= tmp_p0[1];
+    tmp_p2[0] -= tmp_p0[0];
+    tmp_p2[1] -= tmp_p0[1];
+
+    tmp_t1[0] -= tmp_t0[0];
+    tmp_t1[1] -= tmp_t0[1];
+    tmp_t2[0] -= tmp_t0[0];
+    tmp_t2[1] -= tmp_t0[1];
