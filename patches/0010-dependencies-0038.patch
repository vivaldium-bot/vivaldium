+    rows.push({
+        title: 'Sample time',
+        value: tr.v.ui.createScalarSpan(sample.start, {
+          unit: tr.v.Unit.byName.timeStampInMs,
+          ownerDocument: this.ownerDocument
+        })
+    });
+
+    var sfEl = document.createElement('tr-ui-a-stack-frame');
