+                data: 'still_visible',
+                subRows: [
+                  {
+                    data: 'not_visible_any_more'
+                  }
+                ]
+              },
+              {
+                data: 'also_visible'
+              }
+            ]
+          }
+        ]
+      },
+      {
+        data: 'no_sub_rows'
+      },
+      {
+        data: 'fragmentation',
+        subRows: [
+          {
+            data: 'internal'
+          },
+          {
+            data: 'external',
+            subRows: [
+              {
+                data: 'unexpanded'
+              }
+            ]
+          }
+        ]
+      }
