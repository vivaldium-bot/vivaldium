+        VMRegion.fromDict({
+          mappedFile: '/usr/share/fonts/DejaVuSansMono.ttf',
+          startAddress: 140121259503616,
+          sizeInBytes: 335872,
+          protectionFlags: VMRegion.PROTECTION_FLAG_READ,
+          byteStats: {
+            proportionalResident: 22528
+          }
+        }),
