+<script>
+'use strict';
+
+tr.exportTo('tr.ui.analysis', function() {
+
+  var ScalarNumeric = tr.v.ScalarNumeric;
+  var sizeInBytes_smallerIsBetter =
+      tr.v.Unit.byName.sizeInBytes_smallerIsBetter;
