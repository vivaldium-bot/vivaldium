+  },
+
+  _commentChanged: function() {
+    this.createdDate = new Date(this.comment.createdDate).toLocaleString();
+  },
+
+  _computeCommentContentPrefix: function(comment) {
+    return comment.anchor ? '&#9875;&nbsp;' : '';
+  }
+});
