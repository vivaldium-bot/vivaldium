+    self.assertTrue(osutils.SafeMakedirs(path))
+    self.assertTrue(os.path.exists(path))
+    self.assertFalse(osutils.SafeMakedirs(path))
+    self.assertTrue(os.path.exists(path))
+
+  def testSafeMakedirs_error(self):
