+      this.$.content.tableColumns = [
+        {
+          title: 'FirstColumn',
+          value: function(row) { return row.title; },
+          width: '250px'
+        },
+        {
+          title: 'SecondColumn',
+          value: function(row) { return row.value; },
+          width: '100%'
