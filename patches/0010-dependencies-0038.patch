+
+  def testChromeSpecDepsResolution(self):
+    """Test BuildspecUsesDepsGit at release thresholds."""
+    for rev, uses_deps_git in (
+        ('41.0.2270.0', True),
+        ('45.0.2430.3', True),
+        ('45.0.2431.0', False),
