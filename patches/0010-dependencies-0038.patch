+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var Model = tr.Model;
+  var Thread = tr.model.Thread;
+  var EventSet = tr.model.EventSet;
+  var newSliceEx = tr.c.TestUtils.newSliceEx;
