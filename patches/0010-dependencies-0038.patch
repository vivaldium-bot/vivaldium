+namespace {
+
+class CompactEncDetFuzzTest : public testing::Test {};
+
+TEST_F(CompactEncDetFuzzTest, TestRandom) {
+  for (size_t i = 0; i < 16384; ++i) {
+    unsigned int seed = i;
+    srand(seed);
+    size_t length = static_cast<size_t>(rand()) % 1024;
