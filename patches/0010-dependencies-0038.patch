+class RemoteRef(object):
+  """Object representing a remote ref.
+
+  A remote ref encapsulates both a remote (e.g., 'origin',
+  'https://chromium.googlesource.com/chromiumos/chromite.git', etc.) and a ref
+  name (e.g., 'refs/heads/master').
