+
+  def testChromeSpecWithGclientTemplate(self):
+    """Test WriteConfigFile with chrome checkout with a gclient template."""
+    template_path = self._CreateGclientTemplate("""solutions = [
+  {
+    'name': 'src',
+    'custom_deps': {'dep1': '1'},
+    'custom_vars': {'var1': 'test1', 'var2': 'test2'},
