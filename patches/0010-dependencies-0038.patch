+
+<dom-module id='tr-ui-b-radio-picker'>
+  <template>
+    <style>
+    #container {
+      display: flex;
+      flex-direction: column;
+    }
+    </style>
+    <div id="container"></div>
+  </template>
+</dom-module>
+<script>
+'use strict';
+
+Polymer({
+  is: 'tr-ui-b-radio-picker',
+
