+<polymer-element name="tr-ui-a-memory-dump-vm-regions-details-pane"
+    extends="tr-ui-a-stacked-pane">
+  <template>
+    <style>
+      :host {
+        display: flex;
+        flex-direction: column;
+      }
+
+      #label {
+        flex: 0 0 auto;
+        padding: 8px;
+
