+      'AEFAAAAAAAFFQAAAMDBwsPExcbH0NHS09QDAABjaHJvbWUuZXhlAAAAAAAAAI1Jovns+s' +
+      '4B';
+
+  test('DecodeFields', function() {
+
+    var importer = new tr.e.importer.etw.EtwImporter('dummy', []);
