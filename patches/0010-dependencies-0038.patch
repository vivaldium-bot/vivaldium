+# Give preference to /usr/local/google/tmp for space reasons.
+TMPS = ('/usr/local/google/tmp', '/tmp')
+TMP = next(d for d in TMPS if os.path.exists(d))
+
+ONE_GIG = 2 ** 30      # One gig in bytes
+TWO_GIGS = ONE_GIG * 2  # Two gigs in bytes
