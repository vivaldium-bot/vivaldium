+    get mean() {
+      return this.range.center;
+    },
+
+    get mode() {
+      return undefined;
+    },
+
+    get median() {
+      return this.mean;
+    },
+
+    get standardDeviation() {
+      return Math.sqrt(this.variance);
+    },
+
+    get variance() {
+      return Math.pow(this.range.range, 2) / 12;
+    }
+  };
