+    var sB = tsg.pushSlice(newSliceEx({title: 'a', start: 0, end: 3,
+                                       cpuStart: 0, cpuEnd: 3}));
+    var sC = tsg.pushSlice(newSliceEx({title: 'a', start: 4, end: 5,
+                                       cpuStart: 3, cpuEnd: 3.75}));
