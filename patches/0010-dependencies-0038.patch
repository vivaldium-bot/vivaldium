+    },
+
+    onRenderRequired_: function(e) {
+      this.scheduleRender();
+    },
+
+    stackTransformAndProcessQuads_: function(
+        numPasses, handleQuadFunc, includeChromeQuad, opt_arg1, opt_arg2) {
+      var mv = this.camera_.modelViewMatrix;
+      var p = this.camera_.projectionMatrix;
