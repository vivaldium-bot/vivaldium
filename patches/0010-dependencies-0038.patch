+        idxB++;
+      } else {
+        nextSlice = result.copySlice(sA);
+        isFromB = false;
+        idxA++;
+      }
+
+      closeOpenSlices(nextSlice.start);
+
+      result.pushSlice(nextSlice);
+
+      if (isFromB) {
+        openB.push(nextSlice);
+      } else {
+        splitOpenSlices(nextSlice.start);
+        openA.push(nextSlice);
+      }
+    }
+
+    closeOpenSlices();
+
+    return result;
+  };
+
+  return {
+    SliceGroup: SliceGroup
+  };
+});
+</script>
