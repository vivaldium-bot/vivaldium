+
+  test('cpuFreqTargetImport', function() {
+    var lines = [
+      '<idle>-0     [000] ..s3  1043.718825: cpufreq_interactive_target: ' +
+          'cpu=0 load=2 cur=2000000 targ=300000\n',
+      '<idle>-0     [000] ..s3  1043.718825: cpufreq_interactive_target: ' +
