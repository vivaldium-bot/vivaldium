+    var decoder = importer.decoder_;
+    var parser = new tr.e.importer.etw.ThreadParser(importer);
+    var header;
+    var fields;
+
+
+    // Validate a version 2 CSwitch 32-bit payload.
+    header = { guid: guid, opcode: kThreadCSwitchOpcode, version: 2, is64: 0 };
