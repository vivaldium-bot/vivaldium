+  'url': 'https://chromium.googlesource.com/chromium/src.git'},
+ {'custom_deps': {},
+  'custom_vars': {},
+  'deps_file': '.DEPS.git',
+  'name': 'src-internal',
+  'url': 'https://chrome-internal.googlesource.com/chrome/src-internal.git'}]
