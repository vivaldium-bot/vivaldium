+"""Utilities for requesting information for a gerrit server via https.
+
+https://gerrit-review.googlesource.com/Documentation/rest-api.html
+"""
+
+from __future__ import print_function
+
+import base64
+import cookielib
+import datetime
+import httplib
+import json
+import netrc
+import os
+import socket
+import sys
