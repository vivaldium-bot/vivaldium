+            ownerDocument: this.ownerDocument
+          })
+      });
+
+      var sfEl = document.createElement('tr-ui-a-stack-frame');
+      sfEl.stackFrame = sample.leafStackFrame;
+      rows.push({
+        title: 'Stack trace',
+        value: sfEl
+      });
+      table.tableRows = rows;
+      table.rebuild();
