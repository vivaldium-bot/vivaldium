+    },
+
+    get headerText() {
+      return this.querySelector('#header').textContent;
+    },
+
+    set headerText(headerText) {
+      this.querySelector('#header').textContent = headerText;
+      this.updateHeaderVisibility_();
+    },
+
+    onStackingDistanceChange_: function(e) {
