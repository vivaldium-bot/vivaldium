+    selection.push(m.s2);
+    viewEl.selection = selection;
+    this.addHTMLOutput(viewEl);
+    var rows = viewEl.$.runtimeCallStats.$.table.tableRows;
+    assert.lengthOf(rows, 10);
+    assert.deepEqual(rows.map(r => r.time), [
+      2714,
+      0,
+      0,
+      345,
+      0,
+      567,
+      0,
+      789,
+      890,
+      123
+    ]);
+  });
+
+});
