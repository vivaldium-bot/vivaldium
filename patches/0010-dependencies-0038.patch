+class TestHalting(cros_test_lib.MockOutputTestCase, TestBackgroundWrapper):
+  """Test that child processes are halted when exceptions occur."""
+
+  def setUp(self):
+    self.failed = multiprocessing.Event()
+    self.passed = multiprocessing.Event()
+
