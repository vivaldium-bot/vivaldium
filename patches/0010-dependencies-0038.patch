+                    newThreadSlice(t, SCHEDULING_STATE.RUNNING, 50, 10)];
+    var group = new SliceGroup(t);
+    group.pushSlice(newSliceEx({title: 'draw', start: 0, duration: 20}));
+    group.pushSlice(newSliceEx({title: 'render', start: 60, duration: 20}));
