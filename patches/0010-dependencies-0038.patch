+class UnshareTests(cros_test_lib.TestCase):
+  """Tests for Unshare()"""
+
+  def testBasic(self):
+    """Simple functionality test."""
+    try:
+      namespaces.Unshare(namespaces.CLONE_NEWNS)
+    except OSError as e:
+      if e.errno != errno.EPERM:
+        # Running as non-root will fail, so ignore it.  We ran most
