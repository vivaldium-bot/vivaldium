+
+std::ostream& HInstruction::PrintDataTo(std::ostream& os) const {  // NOLINT
+  for (int i = 0; i < OperandCount(); ++i) {
+    if (i > 0) os << " ";
+    os << NameOf(OperandAt(i));
+  }
+  return os;
+}
