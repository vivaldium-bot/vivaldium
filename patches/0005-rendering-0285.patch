+std::ostream& HSimulate::PrintDataTo(std::ostream& os) const {  // NOLINT
+  os << "id=" << ast_id().ToInt();
+  if (pop_count_ > 0) os << " pop " << pop_count_;
+  if (values_.length() > 0) {
+    if (pop_count_ > 0) os << " /";
+    for (int i = values_.length() - 1; i >= 0; --i) {
+      if (HasAssignedIndexAt(i)) {
+        os << " var[" << GetAssignedIndexAt(i) << "] = ";
+      } else {
+        os << " push ";
+      }
+      os << NameOf(values_[i]);
+      if (i > 0) os << ",";
+    }
+  }
+  return os;
+}
