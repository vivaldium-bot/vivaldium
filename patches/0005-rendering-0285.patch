-module Todo.Task exposing (..)
-
-import Html exposing (..)
-import Html.Attributes exposing (..)
-import Html.Events exposing (..)
-import Json.Decode
-import String
-
-
--- MODEL
-
-
-type alias Model =
-    { description : String
-    , completed : Bool
-    , edits : Maybe String
-    , id : Int
-    }
-
-
-init : String -> Int -> Model
-init desc id =
-    { description = desc
-    , completed = False
-    , edits = Nothing
-    , id = id
-    }
-
-
-
--- UPDATE
-
-
-type Msg
-    = Focus String
-    | Edit String
-    | Cancel
-    | Commit
-    | Completed Bool
-    | Delete
-
-
-update : Msg -> Model -> Maybe Model
-update msg model =
-    case msg of
-        Focus elementId ->
-            Just { model | edits = Just model.description }
-
-        Edit description ->
-            Just { model | edits = Just description }
-
-        Cancel ->
-            Just { model | edits = Nothing }
-
