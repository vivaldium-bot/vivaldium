new file mode 100755
index 0000000000000000000000000000000000000000..5cc8011b32a9e02bfa0f7600edd7377a21d66a86
--- /dev/null
+++ b/v8/gypfiles/sysroot_ld_flags.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+# Copyright 2017 the V8 project authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# This is for backwards-compatibility after:
+# https://codereview.chromium.org/2900193003
+
+for entry in $@; do
+  echo -L$entry
+  echo -Wl,-rpath-link=$entry
+done | xargs echo
