+Node* WasmGraphBuilder::Unreachable(wasm::WasmCodePosition position) {
+  TrapIfFalse(wasm::TrapReason::kTrapUnreachable, Int32Constant(0), position);
+  ReturnVoid();
+  return nullptr;
+}
