+HPhase::~HPhase() {
+  if (ShouldProduceTraceOutput()) {
+    isolate()->GetHTracer()->TraceHydrogen(name(), graph_);
+  }
+
+#ifdef DEBUG
+  graph_->Verify(false);  // No full verify.
+#endif
