+enum class UsePositionType : uint8_t { kAny, kRequiresRegister, kRequiresSlot };
+
+
+enum class UsePositionHintType : uint8_t {
+  kNone,
+  kOperand,
+  kUsePos,
+  kPhi,
+  kUnresolved
+};
