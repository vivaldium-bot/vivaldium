+
+void HBasicBlock::RemovePhi(HPhi* phi) {
+  DCHECK(phi->block() == this);
+  DCHECK(phis_.Contains(phi));
+  phi->Kill();
+  phis_.RemoveElement(phi);
+  phi->SetBlock(NULL);
+}
