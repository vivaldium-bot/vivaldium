+  __ AssertFunction(v0);
+  __ Ld(v0, FieldMemOperand(v0, HeapObject::kMapOffset));
+  __ Ld(v0, FieldMemOperand(v0, Map::kPrototypeOffset));
+  context()->Plug(v0);
+}
