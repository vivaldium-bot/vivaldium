+
+void HOptimizedGraphBuilder::VisitWithStatement(WithStatement* stmt) {
+  DCHECK(!HasStackOverflow());
+  DCHECK(current_block() != NULL);
+  DCHECK(current_block()->HasPredecessor());
+  return Bailout(kWithStatement);
+}
