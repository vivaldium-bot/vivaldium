+
+  // ===========================================================================
+
+  Schedule* schedule() const { return schedule_; }
+  Linkage* linkage() const { return linkage_; }
+  InstructionSequence* sequence() const { return sequence_; }
+  Zone* instruction_zone() const { return sequence()->zone(); }
