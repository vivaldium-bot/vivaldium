+void InstructionSelector::VisitIfException(Node* node) {
+  OperandGenerator g(this);
+  DCHECK_EQ(IrOpcode::kCall, node->InputAt(1)->opcode());
+  Emit(kArchNop, g.DefineAsLocation(node, ExceptionLocation()));
+}
