+  auto if_is_hole = __ MakeDeferredLabel<1>();
+  auto done = __ MakeLabel<2>(MachineRepresentation::kTagged);
+
+  Node* check = __ WordEqual(value, __ TheHoleConstant());
+  __ GotoIf(check, &if_is_hole);
+  __ Goto(&done, value);
+
+  __ Bind(&if_is_hole);
+  __ Goto(&done, __ UndefinedConstant());
+
+  __ Bind(&done);
+  return done.PhiAt(0);
+}
