+
+static bool CompareSubstrings(Handle<String> s1, int pos1,
+                              Handle<String> s2, int pos2, int len) {
+  for (int i = 0; i < len; i++) {
+    if (s1->Get(i + pos1) != s2->Get(i + pos2)) {
+      return false;
+    }
+  }
+  return true;
+}
