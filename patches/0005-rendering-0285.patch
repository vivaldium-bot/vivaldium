+class SerializationDataQueue {
+ public:
+  void Enqueue(std::unique_ptr<SerializationData> data);
+  bool Dequeue(std::unique_ptr<SerializationData>* data);
+  bool IsEmpty();
+  void Clear();
+
+ private:
+  base::Mutex mutex_;
+  std::vector<std::unique_ptr<SerializationData>> data_;
+};
