+
+void AstTyper::VisitVariableProxy(VariableProxy* expr) {
+  Variable* var = expr->var();
+  if (var->IsStackAllocated()) {
+    NarrowType(expr, store_.LookupBounds(variable_index(var)));
+  }
+}
