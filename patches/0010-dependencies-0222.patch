+                              const char payloadName[RTP_PAYLOAD_NAME_SIZE],
+                              int frequency,
+                              size_t channels,
+                              uint32_t rate) override {
+    EXPECT_EQ(0u, rate) << "The rate should be zero";
+    return 0;
+  }
+};
