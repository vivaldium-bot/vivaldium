diff --git a/third_party/yasm/source/patched-yasm/libyasm/tests/splitpath_test.c b/third_party/yasm/source/patched-yasm/libyasm/tests/splitpath_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..7f873a472b7d55d04e296177c99d5d5df594bf11
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/tests/splitpath_test.c
@@ -0,0 +1,154 @@
+/*
+ *
+ *  Copyright (C) 2006-2007  Peter Johnson
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
