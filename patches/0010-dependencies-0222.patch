--- /dev/null
+++ b/third_party/webrtc/sdk/objc/Framework/UnitTests/RTCConfigurationTest.mm
@@ -0,0 +1,144 @@
+/*
+ *  Copyright 2015 The WebRTC project authors. All Rights Reserved.
+ *
