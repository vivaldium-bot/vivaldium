+class CaptureSinkFilter: public CBaseFilter
+{
+
+public:
+    CaptureSinkFilter(IN TCHAR * tszName,
+                      IN LPUNKNOWN punk,
+                      OUT HRESULT * phr,
+                      VideoCaptureExternal& captureObserver);
