+  int64_t timestamp_;
+  int qp_max_;
+  int cpu_speed_default_;
+  int number_of_cores_;
+  uint32_t rc_max_intra_target_;
+  std::vector<std::unique_ptr<TemporalLayers>> temporal_layers_;
+  std::vector<uint16_t> picture_id_;
