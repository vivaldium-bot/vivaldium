+
+VideoChannel* ChannelManager::CreateVideoChannel_w(
+    webrtc::Call* call,
+    const cricket::MediaConfig& media_config,
+    DtlsTransportInternal* rtp_dtls_transport,
+    DtlsTransportInternal* rtcp_dtls_transport,
