index 0000000000000000000000000000000000000000..1d11c22a525593ae29625f4cadcf1957165ea10f
--- /dev/null
+++ b/third_party/webrtc/p2p/base/candidatepairinterface.h
@@ -0,0 +1,28 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
