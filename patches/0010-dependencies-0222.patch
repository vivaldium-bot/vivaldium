+  EXPECT_EQ(240, idr_packet.height);
+  if (idr_packet.dataPtr != kData) {
+    // In case CopyAndFixBitStream() prepends SPS/PPS nalus to the packet, it
+    // uses new uint8_t[] to allocate memory. Caller of CopyAndFixBitStream()
