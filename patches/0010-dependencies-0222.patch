+def add_prefix(name, groupname, value, parser=None, **kwargs):
+    prefix = Prefix(groupname, value, **kwargs)
+    if parser is None or parser == "gas":
+        gas_insns[name] = prefix
+    if parser is None or parser == "nasm":
+        nasm_insns[name] = prefix
