+           username,
+           password),
+      requests_(thread),
+      socket_(socket),
+      error_(0),
+      ready_(false),
+      stun_keepalive_delay_(KEEPALIVE_DELAY),
+      emit_local_for_anyaddress_(emit_local_for_anyaddress) {
