+            //    kMetricsXorBursty[code_index1].average_residual_loss[k]);
+            // EXPECT_LT(
+            //   kMetricsXorRandom[code_index2].average_residual_loss[k],
+            //   kMetricsXorRandom[code_index1].average_residual_loss[k]);
+          }
+        }
+      }
+    }
+  }
+}
