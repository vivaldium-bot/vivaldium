+
+#ifndef WEBRTC_ORTC_RTPTRANSPORTADAPTER_H_
+#define WEBRTC_ORTC_RTPTRANSPORTADAPTER_H_
+
+#include <memory>
+#include <vector>
+
+#include "webrtc/api/ortc/srtptransportinterface.h"
