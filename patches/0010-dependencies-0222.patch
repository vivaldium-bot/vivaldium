+  EXPECT_EQ(3, rtp_parameters.header_extensions[1].id);
+  ASSERT_EQ(1u, rtp_parameters.encodings.size());
+  EXPECT_EQ(1234u, rtp_parameters.encodings[0].ssrc);
+}
+
+}  // namespace webrtc
diff --git a/third_party/webrtc/ortc/rtptransport_unittest.cc b/third_party/webrtc/ortc/rtptransport_unittest.cc
new file mode 100644
