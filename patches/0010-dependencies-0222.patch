+
+TEST_F(ReferenceLessVideoAnalysisTest, MatchComputedMetrics) {
+  compute_metrics(video_file, &psnr_per_frame, &ssim_per_frame);
+  EXPECT_EQ(74, (int)psnr_per_frame.size());
