+                           kwargs.pop("gas_no_rev", False))
+
+        # CPU feature flags finalization
+        # Remove redundancies
+        maxcpu = -1
+        maxcpu_set = self.cpu & set(ordered_cpus)
+        if maxcpu_set:
+            maxcpu = max(ordered_cpus.index(x) for x in maxcpu_set)
+        if maxcpu != -1:
+            for cpu in ordered_cpus[0:maxcpu]:
