+  EXPECT_EQ(0x876 * PlayoutDelayLimits::kGranularityMs,
+            header.extension.playout_delay.max_ms);
+  EXPECT_EQ(header.extension.stream_id, StreamId("rtx"));
+  EXPECT_EQ(header.extension.repaired_stream_id, StreamId("stream"));
