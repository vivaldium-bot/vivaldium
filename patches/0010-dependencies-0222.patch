--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/expr.h
@@ -0,0 +1,388 @@
+/**
+ * \file libyasm/expr.h
+ * \brief YASM expression interface.
+ *
+ * \license
+ *  Copyright (C) 2001-2007  Michael Urman, Peter Johnson
+ *
