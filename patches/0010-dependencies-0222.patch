diff --git a/third_party/webrtc/typedefs.h b/third_party/webrtc/typedefs.h
new file mode 100644
index 0000000000000000000000000000000000000000..bd0bee75c2a8c13234fb402aa3a99abd0fcf639e
--- /dev/null
+++ b/third_party/webrtc/typedefs.h
@@ -0,0 +1,125 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
