+/* help messages */
+/*@observer@*/ static const char *help_head = N_(
+    "usage: tasm [option]* source [,object] [,listing] [,xref] \n"
+    "Options:\n");
+/*@observer@*/ static const char *help_tail = N_(
+    "\n"
+    "source is asm source to be assembled.\n"
