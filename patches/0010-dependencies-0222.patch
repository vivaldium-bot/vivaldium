+TEST(BoundedWavFileWriterTest, NoSilence) {
+  static const std::vector<int16_t> kInputSamples = {
+      75, 1234, 243, -1231, -22222, 0, 3, 88,
+      1222, -1213, -13222, -7, -3525, 5787, -25247, 8
