+  ss << ']';
+  ss << ", rtp: " << rtp.ToString();
+  ss << ", renderer: " << (renderer ? "(renderer)" : "nullptr");
+  ss << ", render_delay_ms: " << render_delay_ms;
+  if (!sync_group.empty())
