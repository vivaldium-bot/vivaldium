+  ASSERT_TRUE(ep1_ch1()->GetStats(&infos));
+  ASSERT_TRUE(infos.size() >= 1);
+  ConnectionInfo* best_conn_info = nullptr;
+  for (ConnectionInfo& info : infos) {
+    if (info.best_connection) {
+      best_conn_info = &info;
+      break;
