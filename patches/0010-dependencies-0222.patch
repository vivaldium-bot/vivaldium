+class Prefix(object):
+    def __init__(self, groupname, value, only64=False):
+        self.groupname = groupname
+        self.value = value
+        self.only64 = only64
+
+    def __str__(self):
+        return ",\t".join(["NULL",
+                           "X86_%s>>8" % self.groupname,
+                           "0x%02X" % self.value,
+                           "0",
+                           "0",
+                           "0",
+                           self.only64 and "ONLY_64" or "0",
+                           "0",
+                           "0",
+                           "0"])
