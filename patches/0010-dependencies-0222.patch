+UDPPort::UDPPort(rtc::Thread* thread,
+                 rtc::PacketSocketFactory* factory,
+                 rtc::Network* network,
+                 rtc::AsyncPacketSocket* socket,
+                 const std::string& username,
+                 const std::string& password,
+                 const std::string& origin,
+                 bool emit_local_for_anyaddress)
+    : Port(thread,
+           LOCAL_PORT_TYPE,
+           factory,
