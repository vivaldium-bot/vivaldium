diff --git a/third_party/yasm/source/patched-yasm/frontends/tasm/tasm-options.c b/third_party/yasm/source/patched-yasm/frontends/tasm/tasm-options.c
new file mode 100644
index 0000000000000000000000000000000000000000..57c3bdfd15b16f5733bc8e86ec064ffe04dafced
