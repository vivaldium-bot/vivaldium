+VideoCaptureDS::VideoCaptureDS()
+    : _captureFilter(NULL),
+      _graphBuilder(NULL), _mediaControl(NULL), _sinkFilter(NULL),
+      _inputSendPin(NULL), _outputCapturePin(NULL), _dvFilter(NULL),
+      _inputDvPin(NULL), _outputDvPin(NULL)
