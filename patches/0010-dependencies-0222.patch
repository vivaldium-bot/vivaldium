+TransportController::~TransportController() {
+  // Channel destructors may try to send packets, so this needs to happen on
+  // the network thread.
+  network_thread_->Invoke<void>(
+      RTC_FROM_HERE,
+      rtc::Bind(&TransportController::DestroyAllChannels_n, this));
+}
