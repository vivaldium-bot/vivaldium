+  EXPECT_TRUE(parser.Parse(&header, &extensions));
+
+  // Parse should ignore extension.
+  EXPECT_FALSE(header.extension.hasTransmissionTimeOffset);
+  EXPECT_EQ(sizeof(kPacket), header.headerLength);
