+      std::min(size, static_cast<size_t>(IP_PACKET_SIZE));
+  memcpy(packet.pkt->data, data, packet_size);
+  packet.pkt->length = packet_size;
+
+  UlpfecHeaderReader ulpfec_reader;
+  ulpfec_reader.ReadFecHeader(&packet);
+}
+
