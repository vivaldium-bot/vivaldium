+in vec4 color;
+
+struct s1 {
+    int i;
+    float f;
+};
+
+struct s2 {
+    int i;
+    float f;
+	s1 s1_1;
+	vec4 bleh;
+};
+
+struct s3 {
+	s2 s2_1;
+    int i;
+    float f;
+	s1 s1_1;
+};
+
+
+flat in s1 foo;
+flat in s2 foo2;
+flat in s3 foo3;
+
+
+flat in int condition;
+
+void main()
+{
+	s2 locals2;
+	s3 locals3;
+	float localFArray[16];
+	int localIArray[8];
+
+	locals2 = foo3.s2_1;
