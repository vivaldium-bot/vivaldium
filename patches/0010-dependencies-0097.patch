index 0000000000000000000000000000000000000000..a8a7f568dcdfb09365114b7c02a1e24e37f23588
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/x86/mfqe_sse2.asm
@@ -0,0 +1,287 @@
+;
