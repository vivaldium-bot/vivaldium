--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp9/common/vp9_alloccommon.c
@@ -0,0 +1,183 @@
+/*
+ *  Copyright (c) 2010 The WebM project authors. All Rights Reserved.
+ *
