index 0000000000000000000000000000000000000000..60e95e08f58cde9f5d7b285772cfb8c9b831f7d8
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp9/common/vp9_textblit.c
@@ -0,0 +1,120 @@
+/*
