+    r = FcPatternObjectGet (p, object, id, &v);
+    if (r != FcResultMatch)
+	return r;
+    switch ((int) v.type) {
+    case FcTypeDouble:
+	*i = (int) v.u.d;
+	break;
+    case FcTypeInteger:
+	*i = v.u.i;
+	break;
+    default:
+        return FcResultTypeMismatch;
+    }
+    return FcResultMatch;
+}
