+    _observer.reset(new webrtc::RTCPeerConnectionObserver(self));
+    _peerConnection =
+        factory->CreatePeerConnection(config, constraints, nullptr, nullptr, _observer.get());
+    _localStreams = [[NSMutableArray alloc] init];
+    _delegate = delegate;
+  }
+  return self;
+}
