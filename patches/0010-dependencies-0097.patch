index 0000000000000000000000000000000000000000..af8ffef3983fd2f2e0390cc4e076c41a9ffb9621
--- /dev/null
+++ b/third_party/libexif/sources/libexif/olympus/mnote-olympus-tag.c
@@ -0,0 +1,234 @@
+/* mnote-olympus-tag.c:
