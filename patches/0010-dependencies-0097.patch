+	a *= 64;
+	// no b, it is read only
+	c *= 64;
+	// no d, it is read only
+	e = 64 * 16; // e starts undefined
+	f *= 64;
+
+	sum += a + 64 * b + c + 64 * d + e + f; // everything has a value now, totaling of 64(1+2+4+8+16+32) = 64*63 = 4032
