+U_HAVE_INTTYPES_H=@U_HAVE_INTTYPES_H@
+U_IS_BIG_ENDIAN=@U_IS_BIG_ENDIAN@
+
+##### Add the following to source/config/Makefile.in
+
+GENCCODE=$(BINDIR)/genccode
+GENCMN=$(BINDIR)/gencmn
+ICUPKG=$(BINDIR)/icupkg
+
+
