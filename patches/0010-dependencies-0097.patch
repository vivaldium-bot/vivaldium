+  self.peerConnection->CreateOffer(observer, constraints.constraints);
+}
+
+- (void)removeStream:(RTCMediaStream*)stream {
+  self.peerConnection->RemoveStream(stream.mediaStream);
+  [_localStreams removeObject:stream];
+}
