index 0000000000000000000000000000000000000000..d381d8ddf452d5d9592d499d74b5632a83feef84
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/encoder/encodeframe.c
@@ -0,0 +1,1424 @@
+/*
