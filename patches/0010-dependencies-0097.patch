+
+FcBool
+FcConfigAddBlank (FcConfig	*config,
+		  FcChar32    	blank)
+{
+    FcBlanks	*b, *freeme = 0;
+
+    b = config->blanks;
+    if (!b)
+    {
+	freeme = b = FcBlanksCreate ();
+	if (!b)
+	    return FcFalse;
+    }
+    if (!FcBlanksAdd (b, blank))
+    {
+        if (freeme)
+            FcBlanksDestroy (freeme);
+	return FcFalse;
+    }
+    config->blanks = b;
+    return FcTrue;
+}
