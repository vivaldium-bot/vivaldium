index 0000000000000000000000000000000000000000..e75160836dc94a9d84231ff2db5b35aed226acc8
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/encoder/ssim.c
@@ -0,0 +1,233 @@
+/*
