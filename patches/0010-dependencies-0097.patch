diff --git a/third_party/libvpx/source/libvpx/vp8/common/filter.c b/third_party/libvpx/source/libvpx/vp8/common/filter.c
new file mode 100644
index 0000000000000000000000000000000000000000..84c608effaa8301f3072082607101ec5c7b91557
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/filter.c
@@ -0,0 +1,493 @@
+/*
