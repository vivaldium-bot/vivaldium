diff --git a/third_party/glslang-angle/src/Test/spv.forLoop.frag b/third_party/glslang-angle/src/Test/spv.forLoop.frag
new file mode 100644
index 0000000000000000000000000000000000000000..dfa58ad42cc65fd2c81996e110010a84c03defcf
--- /dev/null
+++ b/third_party/glslang-angle/src/Test/spv.forLoop.frag
@@ -0,0 +1,41 @@
+#version 140
+
+in vec4 bigColor;
+in vec4 BaseColor;
+in float f;
+
+flat in int Count;
+flat in uvec4 v4;
+
+void main()
+{
+    vec4 color = BaseColor;
+
+    for (int i = 0; i < Count; ++i) {
+        color += bigColor;
+    }
+
+    gl_FragColor = color;
+
+    float sum = 0.0;
+    for (int i = 0; i < 4; ++i)
+        sum += v4[i];
+
+    vec4 tv4;
+
+    for (int i = 0; i < 4; ++i)
+        tv4[i] = v4[i] * 4u;
+
+    gl_FragColor += vec4(sum) + tv4;
+
+    vec4 r;
+    r.xyz = BaseColor.xyz;
+
+    for (int i = 0; i < Count; ++i)
+        r.w = f;
+
+    gl_FragColor.xyz += r.xyz;
+
+    for (int i = 0; i < 16; i += 4)
+        gl_FragColor *= f;
+}
