index 0000000000000000000000000000000000000000..ace5d400cb2e741664e30ae1090724539d8532ae
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/mips/dspr2/filter_dspr2.c
@@ -0,0 +1,2823 @@
+/*
