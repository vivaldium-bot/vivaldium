+
+uniform s0 foo0;
+uniform s1 foo1;
+uniform s2 foo2;
+uniform s3 foo3;
+
+uniform s00 foo00;
+
+void main()
+{
+    s0 locals0;
+    s2 locals2;
+    s00 locals00;
+
+    float[6] fArray;
+
+    s1[10] locals1Array;
+
+    if (foo3.s2_1[9].i > 0) {
+        locals2.f = 1.0;
+        locals2.s1_1 = s1(0, 1.0, s0(0));
