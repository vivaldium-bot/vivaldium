+#version 450
+
+uniform layout(binding=0) sampler       g_sSamp1;
+uniform sampler       g_sSamp2;
+uniform layout(binding=2) sampler       g_sSamp3[2];
+uniform sampler       g_sSamp4[3];
+uniform sampler       g_sSamp5;
+
