+@TYPE1+++@ 	FcPattern * 			@ARG1+++@ 	p 
+@TYPE2+++@ 	const char * 			@ARG2+++@ 	object 
+@TYPE3+++@ 	int%  				@ARG3+++@ 	n 
+@TYPE4+++@ 	FcMatrix ** 			@ARG4+++@ 	s 
+
+@PROTOTYPE++++@
+@RET++++@ 	FcResult 
+@FUNC++++@ 	FcPatternGetCharSet 
+@TYPE1++++@ 	FcPattern * 			@ARG1++++@ 	p 
+@TYPE2++++@ 	const char * 			@ARG2++++@ 	object 
+@TYPE3++++@ 	int%  				@ARG3++++@ 	n 
+@TYPE4++++@ 	FcCharSet ** 			@ARG4++++@ 	c 
+
+@PROTOTYPE+++++@
+@RET+++++@ 	FcResult 
+@FUNC+++++@ 	FcPatternGetBool 		
+@TYPE1+++++@ 	FcPattern * 			@ARG1+++++@ 	p
+@TYPE2+++++@ 	const char * 			@ARG2+++++@ 	object 
+@TYPE3+++++@ 	int%  				@ARG3+++++@ 	n 
+@TYPE4+++++@ 	FcBool * 			@ARG4+++++@ 	b 
