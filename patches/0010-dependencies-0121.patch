+    fSkUIView = (SkUIView*)self.view;
+    
+    fWind = (SampleWindow*)fSkUIView.fWind;
+    fSkUIView.fTitleItem = self.navigationItem;
+    
+    [self createButtons];
+    
+    UISwipeGestureRecognizer* swipe = [[UISwipeGestureRecognizer alloc]
