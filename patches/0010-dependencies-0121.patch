+
+static const char *kASTCFilenames[] = {
+    "mandrill_128x128_4x4.astc",    // kASTC_4x4_Format
+    "mandrill_130x128_5x4.astc",    // kASTC_5x4_Format
+    "mandrill_130x130_5x5.astc",    // kASTC_5x5_Format
