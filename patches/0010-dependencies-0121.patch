+            { -49.0f, -50.0f },
+            {  50.0f,  49.0f },
+            {  49.0f,  50.0f }
+        };
+        // trap - narrow on top - wide on bottom
+        const SkPoint gPoints2[] = {
+            { -10.0f, -50.0f },
+            {  10.0f, -50.0f },
+            {  50.0f,  50.0f },
+            { -50.0f,  50.0f }
