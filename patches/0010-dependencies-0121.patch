+class Dashing4GM : public skiagm::GM {
+public:
+    Dashing4GM() {}
+
+protected:
+
+    SkString onShortName() {
+        return SkString("dashing4");
+    }
+
+    SkISize onISize() { return SkISize::Make(640, 950); }
