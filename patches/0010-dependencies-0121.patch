+static SkPdfResult PdfOp_T_star(SkPdfContext* pdfContext, SkCanvas* canvas,
+                                SkPdfTokenLooper* parentLooper) {
+    SkPdfReal* zero = pdfContext->fPdfDoc->createReal(0.0);
