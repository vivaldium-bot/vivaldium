+static void setWeakCallbackForGCObservation(const v8::WeakCallbackInfo<GCObservation>& data)
+{
+    data.GetParameter()->setWasCollected();
+}
+
+void GCObservation::setWasCollected()
+{
+    ASSERT(!wasCollected());
+    m_observed.clear();
+    m_collected = true;
+}
