-if (window.internals) {
-    window.internals.settings.setPreferCompositingToLCDTextEnabled(true);
-}
-
-function doTest() {
-    if (!window.internals)
-        document.getElementById("explanation").style.display = "block";
-
-    if (window.testRunner)
-        testRunner.dumpAsText();
