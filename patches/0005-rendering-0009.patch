+class RepeatEvent final : public Event {
+public:
+    static PassRefPtrWillBeRawPtr<RepeatEvent> create(const AtomicString& type, int repeat)
+    {
+        return adoptRefWillBeNoop(new RepeatEvent(type, false, false, repeat));
