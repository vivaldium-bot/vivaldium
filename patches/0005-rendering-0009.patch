+    [RuntimeEnabled=SVG1DOM, MeasureAs=SVG1DOM] readonly attribute SVGAnimatedLength height;
+    // TODO(philipj): viewport should be a DOMRectReadOnly.
+    readonly attribute SVGRect viewport;
