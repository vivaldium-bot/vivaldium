+    visitor->trace(m_kernelMatrix);
+    visitor->trace(m_kernelUnitLength);
+    visitor->trace(m_order);
+    visitor->trace(m_preserveAlpha);
+    visitor->trace(m_targetX);
+    visitor->trace(m_targetY);
