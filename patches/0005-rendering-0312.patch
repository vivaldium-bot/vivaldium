+class BreakIterator {
+ public:
+  explicit BreakIterator(Handle<DebugInfo> debug_info);
+
+  BreakLocation GetBreakLocation();
+  bool Done() const { return source_position_iterator_.done(); }
+  void Next();
+
+  void SkipToPosition(int position);
+  void SkipTo(int count) {
+    while (count-- > 0) Next();
+  }
+
