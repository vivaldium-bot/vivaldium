+  BasicBlockVector successors_;
+  BasicBlockVector predecessors_;
+#if DEBUG
+  AssemblerDebugInfo debug_info_;
+#endif
+  Id id_;
+
+  DISALLOW_COPY_AND_ASSIGN(BasicBlock);
+};
