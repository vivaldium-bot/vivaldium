+  // Smi operations.
+#define SMI_ARITHMETIC_BINOP(SmiOpName, IntPtrOpName)                  \
+  TNode<Smi> SmiOpName(SloppyTNode<Smi> a, SloppyTNode<Smi> b) {       \
+    return BitcastWordToTaggedSigned(                                  \
