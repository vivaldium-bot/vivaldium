+void JSGenericLowering::LowerJSCallRuntime(Node* node) {
+  const CallRuntimeParameters& p = CallRuntimeParametersOf(node->op());
+  ReplaceWithRuntimeCall(node, p.id(), static_cast<int>(p.arity()));
+}
