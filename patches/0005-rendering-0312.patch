+
+  TotalStats total_stats_;
+  PhaseKindMap phase_kind_map_;
+  PhaseMap phase_map_;
+  base::Mutex record_mutex_;
+
+  DISALLOW_COPY_AND_ASSIGN(CompilationStatistics);
