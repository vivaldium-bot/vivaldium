+bool CodeGenerator::IsNextInAssemblyOrder(RpoNumber block) const {
+  return code()
+      ->InstructionBlockAt(current_block_)
+      ->ao_number()
+      .IsNext(code()->InstructionBlockAt(block)->ao_number());
+}
