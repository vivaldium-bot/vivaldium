+void Shell::WorkerTerminate(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  Isolate* isolate = args.GetIsolate();
+  HandleScope handle_scope(isolate);
+  Worker* worker = GetWorkerFromInternalField(isolate, args.Holder());
+  if (!worker) {
+    return;
+  }
+
+  worker->Terminate();
+}
