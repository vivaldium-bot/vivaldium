+Node* ConstructorBuiltinsAssembler::EmitConstructString(Node* argc,
+                                                        CodeStubArguments& args,
+                                                        Node* context,
+                                                        bool convert_symbol) {
+  VARIABLE(var_result, MachineRepresentation::kTagged);
