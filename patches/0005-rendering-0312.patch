+    __ Addu(i.TempRegister(0), i.InputRegister(0), i.InputRegister(1)); \
+    __ sync();                                                          \
+    __ bind(&binop);                                                    \
+    __ Ll(i.OutputRegister(0), MemOperand(i.TempRegister(0), 0));       \
+    __ bin_instr(i.TempRegister(1), i.OutputRegister(0),                \
+                 Operand(i.InputRegister(2)));                          \
