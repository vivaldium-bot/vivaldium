+  Node* context = Parameter(Descriptor::kContext);
+  Node* receiver = Parameter(Descriptor::kReceiver);
+
+  Node* result = ToThisValue(context, receiver, PrimitiveType::kBoolean,
+                             "Boolean.prototype.valueOf");
+  Return(result);
+}
