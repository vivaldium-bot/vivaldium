-        } else
-            result = resultIframe(link.href);
-
-        appendHTML(newCell, result);
-    }
-
-    newRow.appendChild(newCell);
-    parentTbody.appendChild(newRow);
-
-    updateExpandedState(newRow, true);
-    if (selectRow)
-        TestNavigator._setCurrentTest(parentTbody);
