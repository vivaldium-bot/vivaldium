-    newCell.colSpan = row.querySelectorAll('td').length;
-
-    var resultLinks = row.querySelectorAll('.result-link');
-    var hasTogglingImages = false;
-    for (var i = 0; i < resultLinks.length; i++) {
-        var link = resultLinks[i];
-        var result;
