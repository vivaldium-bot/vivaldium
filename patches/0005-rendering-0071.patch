-        assert_true(supportsNoModule);
-        assert_false(executed);
-        assert_false(loaded);
-        assert_false(errored);
-    });
-}, 'An asynchronously loaded classic script with noModule set to true must not run');
-
-</script>
-</body>
-</html>
