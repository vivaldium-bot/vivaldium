+          Ins_RS( exc, args );
+          break;
+
+        case 0x44:  /* WCVTP */
+          Ins_WCVTP( exc, args );
+          break;
+
+        case 0x45:  /* RCVT */
+          Ins_RCVT( exc, args );
+          break;
+
+        case 0x46:  /* GC */
+        case 0x47:  /* GC */
+          Ins_GC( exc, args );
+          break;
+
+        case 0x48:  /* SCFS */
+          Ins_SCFS( exc, args );
+          break;
+
+        case 0x49:  /* MD */
+        case 0x4A:  /* MD */
+          Ins_MD( exc, args );
+          break;
+
