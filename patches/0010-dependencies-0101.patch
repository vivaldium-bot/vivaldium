+	currentOutput = outbuf;
+	currentPass--;
+	srcmax = dest;
+	goodTrans = makeCorrections ();
+	break;
+      default:
+	break;
+      }
+  if (src < *inlen)
+    *inlen = srcMapping[src];
+  *outlen = dest;
+  if (outputPos != NULL)
+    {
+      int lastpos = 0;
