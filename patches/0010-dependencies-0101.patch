+    1.0,  // pixels/TP height
+    1.0,  // screen DPI x
+    1.0,  // screen DPI y
+    -1,  // orientation minimum
+    2,   // orientation maximum
+    5,  // max fingers
+    5,  // max touch
+    0,  // t5r2
+    0,  // semi-mt
+    1,  // is button pad
+    0   // has_wheel
+  };
+  TestInterpreterWrapper wrapper(ii.get(), &hwprops);
+
+  FingerState fs = {
+    // TM, Tm, WM, Wm, Press, Orientation, X, Y, TrID
+    0, 0, 0, 0, 50, 0, 4, 4, 91, 0
