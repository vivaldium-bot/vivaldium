+	if (outputPos[k] == -1)
+	  outputPos[k] = lastpos;
+	else
+	  lastpos = outputPos[k];
+    }
+  if (cursorPos != NULL)
+    *cursorPos = cursorPosition;
+  return goodTrans;
+}
