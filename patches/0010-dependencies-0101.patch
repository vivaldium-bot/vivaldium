+stime_t InternalTimerCallback(stime_t now, void* callback_data) {
+  Log("TimerCallback called");
+  GestureInterpreter* gi = reinterpret_cast<GestureInterpreter*>(callback_data);
+  stime_t next = -1.0;
+  gi->TimerCallback(now, &next);
+  return next;
