@@ -0,0 +1,111 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ttsubpix.h                                                             */
+/*                                                                         */
+/*    TrueType Subpixel Hinting.                                           */
+/*                                                                         */
+/*  Copyright 2010-2017 by                                                 */
+/*  David Turner, Robert Wilhelm, and Werner Lemberg.                      */
