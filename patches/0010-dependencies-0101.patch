index 0000000000000000000000000000000000000000..01495b46986ea2e4ccf5a7ab1b27723620c27725
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/r300/compiler/tests/r300_compiler_tests.c
@@ -0,0 +1,6 @@
+#include "r300_compiler_tests.h"
+
+int main(int argc, char ** argv)
+{
+	radeon_compiler_util_run_tests();
+}
