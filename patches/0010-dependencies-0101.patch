+TEST(ImmediateInterpreterTest, DiagonalSnapTest) {
+  std::unique_ptr<ImmediateInterpreter> ii;
+  HardwareProperties hwprops = {
+    0,  // left edge
+    0,  // top edge
+    100,  // right edge
+    100,  // bottom edge
