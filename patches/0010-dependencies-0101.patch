index 0000000000000000000000000000000000000000..4608b884181aa46953cfe0217388cb090afe826a
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/rbug/rbug_core.c
@@ -0,0 +1,886 @@
