+struct SVGACmdMemory;
+
+/**
+ * Subclass of pipe_screen
+ */
+struct svga_screen
+{
+   struct pipe_screen screen;
+   struct svga_winsys_screen *sws;
+
+   SVGA3dHardwareVersion hw_version;
+
+   float maxPointSize;
+
+   struct {
