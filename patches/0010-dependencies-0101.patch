+
+        case 0x1E:  /* SSWCI */
+          Ins_SSWCI( exc, args );
+          break;
+
+        case 0x1F:  /* SSW */
+          Ins_SSW( exc, args );
+          break;
+
+        case 0x20:  /* DUP */
