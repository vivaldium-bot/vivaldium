+    {0, 0, 0, 0, kSml, 0, 500, 500, 4, 0}
+  };
+  HardwareState hardware_state[] = {
+    // time, buttons, finger count, touch count, finger states pointer
+    { 200000, 0, 2, 2, &finger_states[0], 0, 0, 0, 0 },
