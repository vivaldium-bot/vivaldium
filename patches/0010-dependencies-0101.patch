diff --git a/third_party/freetype/src/src/pshinter/pshalgo.c b/third_party/freetype/src/src/pshinter/pshalgo.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ad1a3a02a34f5d8001df9d4c3cbdabee927a2db
