+
+        case 0x21:  /* POP */
+          Ins_POP();
+          break;
+
+        case 0x22:  /* CLEAR */
+          Ins_CLEAR( exc );
+          break;
+
+        case 0x23:  /* SWAP */
+          Ins_SWAP( args );
+          break;
+
+        case 0x24:  /* DEPTH */
+          Ins_DEPTH( exc, args );
+          break;
+
+        case 0x25:  /* CINDEX */
+          Ins_CINDEX( exc, args );
+          break;
+
+        case 0x26:  /* MINDEX */
