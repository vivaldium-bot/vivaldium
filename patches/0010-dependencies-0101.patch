+          break;
+
+        case 0x18:  /* RTG */
+          Ins_RTG( exc );
+          break;
+
+        case 0x19:  /* RTHG */
+          Ins_RTHG( exc );
+          break;
+
+        case 0x1A:  /* SMD */
+          Ins_SMD( exc, args );
+          break;
+
+        case 0x1B:  /* ELSE */
+          Ins_ELSE( exc );
+          break;
+
+        case 0x1C:  /* JMPR */
+          Ins_JMPR( exc, args );
+          break;
+
+        case 0x1D:  /* SCVTCI */
+          Ins_SCVTCI( exc, args );
