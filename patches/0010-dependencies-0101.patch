+#ifndef __LOUIS_H_
+#define __LOUIS_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif				/* __cplusplus */
+
+#include "liblouis.h"
+
+#ifdef _WIN32
+#define strcasecmp _stricmp
+#endif
+
+#define NUMSWAPS 50
+#define NUMVAR 50
+#define LETSIGNSIZE 128
+#define CHARSIZE sizeof(widechar)
+#define DEFAULTRULESIZE 50
+#define ENDSEGMENT 0xffff
+
+/*Definitions of braille dots*/
+#define B1 0X01
+#define B2 0X02
+#define B3 0X04
+#define B4 0X08
