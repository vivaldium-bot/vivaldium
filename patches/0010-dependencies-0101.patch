+          gs,
+          false,  // same fingers
+          hwstates[i].timestamp,
+          &down,
+          &up,
+          &timeout);
+    }
+    EXPECT_EQ(down, up);
+    if (test == kWithoutKeyboard)
+      EXPECT_EQ(GESTURES_BUTTON_LEFT, down);
+    else
+      EXPECT_EQ(0, down);
+  }
+}
