+  HardwareState hwstates[] = {
+    // Simple 1-finger tap
+    { 0.01, 0, 1, 1, &fs, 0, 0, 0, 0 },
+    { 0.02, 0, 0, 0, NULL, 0, 0, 0, 0 },
+    { 0.30, 0, 0, 0, NULL, 0, 0, 0, 0 }
