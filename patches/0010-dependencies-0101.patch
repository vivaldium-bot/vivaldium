+          break;
+
+        case 0x2A:  /* LOOPCALL */
+          Ins_LOOPCALL( exc, args );
+          break;
+
+        case 0x2B:  /* CALL */
+          Ins_CALL( exc, args );
+          break;
+
+        case 0x2C:  /* FDEF */
