+      input.now, input.buttons_down, finger_cnt, finger_cnt, fs, 0, 0, 0, 0
+    };
+    stime_t timeout = -1;
+    wrapper.SyncInterpret(&hs, &timeout);
+  }
+  EXPECT_EQ(arraysize(inputs), base_interpreter->iteration_);
+}
