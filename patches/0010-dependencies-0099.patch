+EXTRA_DIST = $(template_DATA) $(DOC_SOURCES)
+CLEANFILES = $(DOC_FILES)
+
+configdir = $(CONFIGDIR)
+config_DATA = $(DOC_FILES)
+
+templatedir = $(TEMPLATEDIR)
+template_DATA =				\
