+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_wide_point.c
@@ -0,0 +1,336 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
