+   _EGLDriver *drv;
+   EGLBoolean ret;
+
+   _EGL_CHECK_CONTEXT(disp, context, EGL_FALSE, drv);
+   _eglUnlinkContext(context);
+   ret = drv->API.DestroyContext(drv, disp, context);
+
+   RETURN_EGL_EVAL(disp, ret);
+}
