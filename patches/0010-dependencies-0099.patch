+/*
+ * Called from eglGetProcAddress() via drv->API.GetProcAddress().
+ */
+static _EGLProc
+dri2_get_proc_address(_EGLDriver *drv, const char *procname)
+{
+   struct dri2_egl_driver *dri2_drv = dri2_egl_driver(drv);
+
