index 0000000000000000000000000000000000000000..9fab7b681fb7aaa396b832c862c5a8871a197073
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_fetch.c
@@ -0,0 +1,228 @@
+/**************************************************************************
+ *
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
