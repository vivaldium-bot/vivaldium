index 0000000000000000000000000000000000000000..898a60a3fd9f8394270bb31a57f35dc1f2fae894
--- /dev/null
+++ b/third_party/mesa/src/src/egl/main/egldisplay.c
@@ -0,0 +1,456 @@
+/**************************************************************************
+ *
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * Copyright 2009-2010 Chia-I Wu <olvaffe@gmail.com>
+ * Copyright 2010-2011 LunarG, Inc.
+ * All Rights Reserved.
+ *
