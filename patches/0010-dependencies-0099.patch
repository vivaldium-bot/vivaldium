index 0000000000000000000000000000000000000000..4b0ed148129f2c3a01c2a1bf4fd918c9db57b4a2
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pipe_validate.c
@@ -0,0 +1,352 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
+ *
