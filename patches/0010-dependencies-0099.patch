index 0000000000000000000000000000000000000000..0fed057efbe7fa8ee1b86ae074443a09e1dba1af
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_vsplit.c
@@ -0,0 +1,216 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.9
+ *
