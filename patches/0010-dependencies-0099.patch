index 0000000000000000000000000000000000000000..98a4668efb79313e1139d5f9a19c39ad4ce0a374
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/draw/draw_pt_vsplit_tmp.h
@@ -0,0 +1,316 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.9
+ *
+ * Copyright 2007-2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * Copyright (C) 2010 LunarG Inc.
+ *
