+                        'result = client.%s(', command_info.client_method_path)
+                    with printer.Indent(indent='    '):
+                        printer('%s)', ', '.join(call_args))
+                    printer('print apitools_base_cli.FormatOutput(result)')
+            printer()
+            printer()
