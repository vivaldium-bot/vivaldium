+                                        policy, md5, res_upload_handler,
+                                        if_generation=if_generation)
+
+    def set_contents_from_string(self, s, headers=None, replace=True,
+                                 cb=None, num_cb=10, policy=None, md5=None,
+                                 if_generation=None):
