+            try:
+                names = zipio.listdir(path)
+            except (os.error, IOError):
+                self.msg(2, "can't list directory", path)
+                continue
+            for info in (moduleInfoForPath(p) for p in names):
+                if info is None: continue
+                if info[0] != '__init__':
+                    yield info[0]
