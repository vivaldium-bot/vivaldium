+                                  * oracle-se = 10--3072
+                                  * oracle-ee = 10--3072
+                                  * sqlserver-ee = 200--1024
+                                  * sqlserver-se = 200--1024
+                                  * sqlserver-ex = 30--1024
+                                  * sqlserver-web = 30--1024
