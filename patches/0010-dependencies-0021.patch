+                ','.join([
+                    (cpatt % item) for item in
+                    nodevisitor(node, data, outgoing, incoming).items()
+                ]),
+            )
+
+            inside = inpackages.get(node)
+            if inside is None:
+                inside = inpackages[node] = set()
+            ident = nodetoident[node]
+            if ident is None:
+                continue
