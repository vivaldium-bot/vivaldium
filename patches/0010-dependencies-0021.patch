+                printer('     messages: the generated messages module')
+                printer('"""')
+                printer('local_vars = {')
+                with printer.Indent(indent='    '):
+                    printer("'apitools_base': apitools_base,")
+                    printer("'client': client,")
+                    printer("'client_lib': client_lib,")
+                    printer("'messages': messages,")
