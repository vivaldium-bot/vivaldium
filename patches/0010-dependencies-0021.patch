+    def testKeywords(self):
+        names = util.Names([''])
+        self.assertEqual('in_', names.CleanName('in'))
+
+    def testNormalizeEnumName(self):
+        names = util.Names([''])
+        self.assertEqual('_0', names.NormalizeEnumName('0'))
