+            'DestinationCidrBlock': destination_cidr_block,
+            'VpnConnectionId': vpn_connection_id,
+        }
+        if dry_run:
+            params['DryRun'] = 'true'
+        return self.get_status('CreateVpnConnectionRoute', params)
+
