+class AliasNode(Node):
+    def __init__(self, name, node):
+        super(AliasNode, self).__init__(name)
+        for k in 'identifier', 'packagepath', '_namespace', 'globalnames', 'starimports':
+            setattr(self, k, getattr(node, k, None))
