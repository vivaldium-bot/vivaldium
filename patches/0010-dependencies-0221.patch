+  // Disable the audio track, this should prevent setting the volume.
+  audio_track_->set_enabled(false);
+  audio_track_->GetSource()->SetVolume(0.8);
+  EXPECT_TRUE(voice_media_channel_->GetOutputVolume(kAudioSsrc, &volume));
+  EXPECT_EQ(0, volume);
