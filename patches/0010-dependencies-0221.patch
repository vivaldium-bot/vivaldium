+    final float rotatedMatrix[] = rotateTextureMatrix(matrix, 0);
+    assertArrayEquals(round(matrix), round(rotatedMatrix), 0.0);
+  }
+
+  @Test
+  @SmallTest
+  public void testRotateTextureMatrix90Deg() {
