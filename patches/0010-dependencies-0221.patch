+    // Cruising, probing new bandwidth.
+    PROBE_BW,
+    // Temporarily limiting congestion window size in order to measure
+    // minimum RTT.
+    PROBE_RTT,
+    // Temporarily reducing pacing rate and congestion window, in order to
