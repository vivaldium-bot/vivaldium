+class FakeEncoder : public VideoEncoder {
+ public:
+  explicit FakeEncoder(Clock* clock);
+  virtual ~FakeEncoder() = default;
+
+  // Sets max bitrate. Not thread-safe, call before registering the encoder.
+  void SetMaxBitrate(int max_kbps);
