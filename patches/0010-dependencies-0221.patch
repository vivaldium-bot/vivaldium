diff --git a/third_party/webrtc/sdk/objc/Framework/Classes/Common/RTCDispatcher.m b/third_party/webrtc/sdk/objc/Framework/Classes/Common/RTCDispatcher.m
new file mode 100644
index 0000000000000000000000000000000000000000..530e51a3c94bc812425e5c00696245781f5d819d
--- /dev/null
