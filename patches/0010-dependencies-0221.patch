+TEST_F(SendSideCongestionControllerTest, GetProbingInterval) {
+  clock_.AdvanceTimeMilliseconds(25);
+  controller_->Process();
+
+  EXPECT_CALL(observer_, OnNetworkChanged(_, _, _, testing::Ne(0)));
+  EXPECT_CALL(*pacer_, SetEstimatedBitrate(_));
