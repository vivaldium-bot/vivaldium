diff --git a/third_party/webrtc/p2p/base/udptransport_unittest.cc b/third_party/webrtc/p2p/base/udptransport_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f9db024afea6391feaac1090c3c83cefd9005c1f
--- /dev/null
