+  void set_next_client_tcp_socket(AsyncPacketSocket* next_client_tcp_socket) {
+    next_client_tcp_socket_ = next_client_tcp_socket;
+  }
+  rtc::AsyncResolverInterface* CreateAsyncResolver() override {
+    return NULL;
+  }
+
+ private:
