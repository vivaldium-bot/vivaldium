new file mode 100644
index 0000000000000000000000000000000000000000..114f3de7e6cb7f7f5364ac8072af8e4f8641c265
--- /dev/null
+++ b/third_party/webrtc/pc/test/fakedatachannelprovider.h
@@ -0,0 +1,147 @@
+/*
