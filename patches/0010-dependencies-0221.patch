+TEST_F(OrtcFactoryTest, CreateSendersOrReceieversWithNullTransport) {
+  auto sender_result =
+      ortc_factory_->CreateRtpSender(cricket::MEDIA_TYPE_AUDIO, nullptr);
+  EXPECT_EQ(RTCErrorType::INVALID_PARAMETER, sender_result.error().type());
