+   public:
+    ObserveRedundantPayloads()
+        : EndToEndTest(kDefaultTimeoutMs),
+          ssrcs_to_observe_(kNumSimulcastStreams) {
+      for (size_t i = 0; i < kNumSimulcastStreams; ++i) {
+        registered_rtx_ssrc_[kSendRtxSsrcs[i]] = true;
