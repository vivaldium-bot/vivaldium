+    if (mediaCodecThread.getId() != Thread.currentThread().getId()) {
+      throw new RuntimeException("MediaCodecVideoEncoder previously operated on " + mediaCodecThread
+          + " but is now called on " + Thread.currentThread());
+    }
+  }
