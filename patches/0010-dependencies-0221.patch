+                 bool enabled);
+  void PopState();
+
+  static Logging g_Logging;
+  rtc::CriticalSection crit_sect_;
+  ThreadMap thread_map_;
+
+  RTC_DISALLOW_COPY_AND_ASSIGN(Logging);
+};
