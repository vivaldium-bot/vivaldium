diff --git a/third_party/webrtc/pc/channelmanager.h b/third_party/webrtc/pc/channelmanager.h
new file mode 100644
index 0000000000000000000000000000000000000000..695b796e09b6345a3331059e7080bdec677897bf
--- /dev/null
+++ b/third_party/webrtc/pc/channelmanager.h
@@ -0,0 +1,227 @@
+/*
