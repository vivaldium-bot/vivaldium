+
+ private:
+  void OnSocketReadPacket(rtc::AsyncPacketSocket* socket,
+                          const char* data,
+                          size_t len,
+                          const rtc::SocketAddress& remote_addr,
+                          const rtc::PacketTime& packet_time);
+  void OnSocketSentPacket(rtc::AsyncPacketSocket* socket,
+                          const rtc::SentPacket& packet);
