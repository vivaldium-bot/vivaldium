+int H264VideoToolboxEncoder::SetRates(uint32_t new_bitrate_kbit,
+                                      uint32_t frame_rate) {
+  target_bitrate_bps_ = 1000 * new_bitrate_kbit;
+  bitrate_adjuster_.SetTargetBitrateBps(target_bitrate_bps_);
