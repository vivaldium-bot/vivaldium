+  // Answer by turning off all send streams.
+  SendNothing();
+  answer = CreateAnswer();
+
+  // Verify the session id is the same and the session version is
+  // increased.
+  EXPECT_EQ(session_id_orig, answer->session_id());
+  EXPECT_LT(rtc::FromString<uint64_t>(session_version_orig),
