+class PeerConnectionWrapper : public webrtc::PeerConnectionObserver,
+                              public SignalingMessageReceiver,
+                              public ObserverInterface {
+ public:
+  // Different factory methods for convenience.
+  // TODO(deadbeef): Could use the pattern of:
