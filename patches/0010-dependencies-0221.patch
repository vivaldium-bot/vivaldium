+  static const char* StunName(NATType type) {
+    switch (type) {
+      case NAT_OPEN_CONE:
+        return "stun(open cone)";
+      case NAT_ADDR_RESTRICTED:
+        return "stun(addr restricted)";
+      case NAT_PORT_RESTRICTED:
+        return "stun(port restricted)";
+      case NAT_SYMMETRIC:
+        return "stun(symmetric)";
+      default:
+        return "stun(?)";
+    }
+  }
+  static const char* RelayName(RelayType type, ProtocolType proto) {
+    if (type == RELAY_TURN) {
+      switch (proto) {
+        case PROTO_UDP:
+          return "turn(udp)";
+        case PROTO_TCP:
+          return "turn(tcp)";
+        case PROTO_SSLTCP:
+          return "turn(ssltcp)";
+        case PROTO_TLS:
+          return "turn(tls)";
+        default:
+          return "turn(?)";
+      }
+    } else {
+      switch (proto) {
+        case PROTO_UDP:
+          return "gturn(udp)";
+        case PROTO_TCP:
+          return "gturn(tcp)";
+        case PROTO_SSLTCP:
+          return "gturn(ssltcp)";
+        case PROTO_TLS:
+          return "gturn(tls)";
+        default:
+          return "gturn(?)";
+      }
+    }
+  }
