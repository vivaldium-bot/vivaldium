+  memset(buffer.get(), 0, buffer_size);
+  AvccBufferWriter writer(buffer.get(), 0);
+  EXPECT_EQ(0u, writer.BytesRemaining());
+  EXPECT_FALSE(writer.WriteNalu(NALU_TEST_DATA_0, arraysize(NALU_TEST_DATA_0)));
