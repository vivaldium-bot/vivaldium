+static bool BadSdp(cricket::ContentSource source,
+                   const std::string& type,
+                   const std::string& reason,
+                   std::string* err_desc) {
+  if (source == cricket::CS_LOCAL) {
+    return BadSdp("local", type, reason, err_desc);
+  } else {
+    return BadSdp("remote", type, reason, err_desc);
+  }
+}
