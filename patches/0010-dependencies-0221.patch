index 0000000000000000000000000000000000000000..99a0a4b06fb2ab1355a1a5552152e085c7c14237
--- /dev/null
+++ b/third_party/webrtc/sdk/android/src/java/org/webrtc/HardwareVideoDecoder.java
@@ -0,0 +1,668 @@
+/*
