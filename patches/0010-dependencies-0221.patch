+++ b/third_party/webrtc/sdk/objc/Framework/Classes/Common/RTCFileLogger.mm
@@ -0,0 +1,176 @@
+/*
+ *  Copyright 2015 The WebRTC project authors. All Rights Reserved.
+ *
