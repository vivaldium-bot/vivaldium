+      // Wait for an OES texture to arrive and draw it onto the pixel buffer.
+      listener.waitForNewFrame();
+      eglBase.makeCurrent();
+      drawer.drawOes(
+          listener.oesTextureId, listener.transformMatrix, width, height, 0, 0, width, height);
