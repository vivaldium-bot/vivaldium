+TEST(BweTestFramework_LossFilterTest, Loss50) {
+  TestLossFilter(50.0f, false);
+}
+
+TEST(BweTestFramework_LossFilterTest, Loss100) {
+  // With 100% loss, the result should be exact (no packets out).
+  TestLossFilter(100.0f, true);
+}
