+int32_t RTCPSender::RemoveMixedCNAME(uint32_t SSRC) {
+  rtc::CritScope lock(&critical_section_rtcp_sender_);
+  auto it = csrc_cnames_.find(SSRC);
+
+  if (it == csrc_cnames_.end())
+    return -1;
+
+  csrc_cnames_.erase(it);
+  return 0;
+}
