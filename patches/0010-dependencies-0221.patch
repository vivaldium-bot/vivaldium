+                                                       kStunAddr1)),
+        stun_server_2_(cricket::TestStunServer::Create(rtc::Thread::Current(),
+                                                       kStunAddr2)),
+        done_(false),
+        error_(false),
+        stun_keepalive_delay_(1),
+        stun_keepalive_lifetime_(-1) {}
