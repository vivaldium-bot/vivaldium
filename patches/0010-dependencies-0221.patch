+          num_samples(num_samples_),
+          round(round_) {}
+    // Sum of RTTs over the round.
+    int64_t sum_of_rtts_ms;
+    // Number of RTT samples over the round.
+    int64_t num_samples;
+    // The number of the round average RTT is recorded for.
