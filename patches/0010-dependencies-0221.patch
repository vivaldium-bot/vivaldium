diff --git a/third_party/webrtc/sdk/objc/Framework/Classes/RTCOpenGLVideoRenderer.h b/third_party/webrtc/sdk/objc/Framework/Classes/RTCOpenGLVideoRenderer.h
new file mode 100644
index 0000000000000000000000000000000000000000..7041861014a506be70ed6e1e9415f79111a3e477
--- /dev/null
+++ b/third_party/webrtc/sdk/objc/Framework/Classes/RTCOpenGLVideoRenderer.h
@@ -0,0 +1,61 @@
+/*
