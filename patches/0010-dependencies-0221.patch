+  void Crop(float cropped_width,
+            float cropped_height,
+            float crop_x,
+            float crop_y);
+
+  void Rotate(webrtc::VideoRotation rotation);
+
+ private:
+  Matrix() {}
+
+  static void Multiply(const float a[16], const float b[16], float result[16]);
+  float elem_[16];
+};
