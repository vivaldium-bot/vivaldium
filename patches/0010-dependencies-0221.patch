+#if defined(WEBRTC_IOS)
+#include "RTCUIApplication.h"
+#endif
+#include "libyuv/convert.h"
+#include "webrtc/api/video/video_frame.h"
+#include "webrtc/base/checks.h"
+#include "webrtc/base/logging.h"
