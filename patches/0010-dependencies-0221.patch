+
+#include <memory>
+
+#include "webrtc/modules/desktop_capture/mouse_cursor_monitor.h"
+#include "webrtc/modules/desktop_capture/desktop_capturer.h"
+#include "webrtc/modules/desktop_capture/desktop_capture_options.h"
