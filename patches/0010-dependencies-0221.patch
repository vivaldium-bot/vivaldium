diff --git a/third_party/webrtc/rtc_tools/barcode_tools/README b/third_party/webrtc/rtc_tools/barcode_tools/README
new file mode 100644
index 0000000000000000000000000000000000000000..a23e798064def22c99d668383fbd8ddccc435768
