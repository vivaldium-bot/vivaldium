+    public int frameHeight() {
+      synchronized (frameLock) {
+        return height;
+      }
+    }
+
+    public int waitForNextFrameToRender() throws InterruptedException {
+      Logging.d(TAG, "Waiting for the next frame to render");
+      synchronized (frameLock) {
+        frameLock.wait();
+        return framesRendered;
+      }
+    }
+  }
