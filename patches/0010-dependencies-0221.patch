diff --git a/third_party/webrtc/pc/trackmediainfomap.cc b/third_party/webrtc/pc/trackmediainfomap.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b5c5ac6a024e6cf46ea1002f14fa900d513d782a
--- /dev/null
+++ b/third_party/webrtc/pc/trackmediainfomap.cc
@@ -0,0 +1,226 @@
+/*
