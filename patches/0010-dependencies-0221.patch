+MouseCursor::MouseCursor() {}
+
+MouseCursor::MouseCursor(DesktopFrame* image, const DesktopVector& hotspot)
+    : image_(image),
+      hotspot_(hotspot) {
+  assert(0 <= hotspot_.x() && hotspot_.x() <= image_->size().width());
+  assert(0 <= hotspot_.y() && hotspot_.y() <= image_->size().height());
+}
