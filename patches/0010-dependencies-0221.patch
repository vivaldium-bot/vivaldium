new file mode 100644
index 0000000000000000000000000000000000000000..d6da2346fa68a269e1c6a38c7ebc8e430a8c2be3
--- /dev/null
+++ b/third_party/webrtc/rtc_base/weak_ptr_unittest.cc
@@ -0,0 +1,233 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
