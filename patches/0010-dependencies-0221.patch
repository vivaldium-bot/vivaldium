+TEST_F(OveruseFrameDetectorTest, NoOveruseForLargeRandomFrameInterval) {
+  // TODO(bugs.webrtc.org/8504): When new estimator is relanded,
+  // behavior is improved in this scenario, with only AdaptUp events,
