+  ASSERT_TRUE(channel_->SetSend(true));
+  cricket::VideoOptions camera_options;
+  camera_options.is_screencast = false;
+  channel_->SetVideoSend(last_ssrc_, true /* enable */, &camera_options,
+                         &capturer);
