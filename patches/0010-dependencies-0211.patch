+    {                                                           \
+      filePtr = fopen(fullPath, "ab");                          \
+      if(filePtr == NULL)                                       \
+      {                                                         \
+        printf("could not open %s to write to.", fullPath);     \
+        return -1;                                              \
+      }                                                         \
+    }                                                           \
+    else                                                        \
+    {                                                           \
