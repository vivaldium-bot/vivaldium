+elif [ "$1" = "LINUX" ] || [ "$2" = "LINUX" ]
+    then
+    PLATFORM=_linux
+    ISAC=../ReleaseTest-API/isacswtest
+else
+    PLATFORM=_2005
+    ISAC=../win32/Release/ReleaseTest-API_2005.exe
+fi
+
+if  [ "$#" -eq 0 ] || [ "$1" = "all" ] || [ "$1" = "wb" ]
+    then
+    LOGFILE=logNormal"$PLATFORM".txt
