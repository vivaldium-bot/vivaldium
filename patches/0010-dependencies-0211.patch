+
+  virtual int32_t RegisterDecodeCompleteCallback(
+      webrtc::DecodedImageCallback*) {
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  virtual int32_t Release() { return WEBRTC_VIDEO_CODEC_OK; }
