+// Statistics for an RTCP channel
+struct RtcpStatistics {
+  RtcpStatistics()
+      : fraction_lost(0),
+        packets_lost(0),
+        extended_highest_sequence_number(0),
+        jitter(0) {}
+
+  uint8_t fraction_lost;
