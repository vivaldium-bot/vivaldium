+    def update(self, driver):
+        # version
+        if not self.os.is_win():
+            ua = driver.execute_script('return navigator.userAgent;')
+            if self.is_chrome():
+                match = re.search('Chrome/(.*) ', ua)
+            elif self.is_edge():
+                match = re.search('Edge/(.*)$', ua)
+            elif self.is_firefox():
