index 0000000000000000000000000000000000000000..a87b3b54f267b59c3840102b9edb547ef3ed76b2
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/isac/fix/source/transform_mips.c
@@ -0,0 +1,1294 @@
+/*
