index 0000000000000000000000000000000000000000..ee3b26e039434320a44c55dbc2276861b946aa0a
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/vq3.c
@@ -0,0 +1,63 @@
