+
+    <h4>Attributes</h4>
+
+    <p>
+        The following attributes are available:
+    </p>
+
+    <dl class="methods">
+        <dt>
+            <code class=attribute-name>
+                <a id="DOM-WebGLShaderPrecisionFormat-rangeMin">
+                    rangeMin
+                </a>
+            </code>
+            of type <code>GLint</code>
+        <dd>
