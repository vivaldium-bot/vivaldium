+std::unique_ptr<AudioEncoder> AudioEncoderOpus::MakeAudioEncoder(
+    const AudioEncoderOpusConfig& config,
+    int payload_type) {
+  return AudioEncoderOpusImpl::MakeAudioEncoder(config, payload_type);
+}
+
+}  // namespace webrtc
