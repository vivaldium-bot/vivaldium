+TEST_F(AudioFrameOperationsTest, QuadToMonoSucceeds) {
+  frame_.num_channels_ = 4;
+  SetFrameData(4, 2, 6, 8, &frame_);
+
+  EXPECT_EQ(0, AudioFrameOperations::QuadToMono(&frame_));
