+namespace {
+void Calc16ByteAlignedStride(int width, int* stride_y, int* stride_uv) {
+  *stride_y = 16 * ((width + 15) / 16);
+  *stride_uv = 16 * ((width + 31) / 32);
+}
+
+}  // Anonymous namespace
+
+class TestLibYuv : public ::testing::Test {
+ protected:
+  TestLibYuv();
