diff --git a/third_party/webrtc/api/audio_codecs/audio_encoder_factory_template.h b/third_party/webrtc/api/audio_codecs/audio_encoder_factory_template.h
new file mode 100644
index 0000000000000000000000000000000000000000..060ba8cb04528d0e65d64de62cd90d983e9b6f75
--- /dev/null
