+
+TEST_F(AudioFrameOperationsTest, SwapStereoChannelsSucceedsOnStereo) {
+  SetFrameData(0, 1, &frame_);
+
+  AudioFrame swapped_frame;
+  swapped_frame.samples_per_channel_ = 320;
