+
+  auto packet = CreatePacketWithSsrc(ssrc);
+  packet->SetPayloadType(different_payload_type);
+  EXPECT_CALL(sink, OnRtpPacket(SamePacketAs(*packet))).Times(1);
+  EXPECT_TRUE(demuxer_.OnRtpPacket(*packet));
