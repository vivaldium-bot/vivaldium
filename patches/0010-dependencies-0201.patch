+  WEBRTC_TRACE(kTraceStream, kTraceVoice, VoEId(_instanceId, _channelId),
+               "Channel::Demultiplex()");
+  _audioFrame.CopyFrom(audioFrame);
+  _audioFrame.id_ = _channelId;
