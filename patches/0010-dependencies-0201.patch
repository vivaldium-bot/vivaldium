+enum {
+  kResultFail = -1,
+  kResultSuccess = 0,
+  kResultSkip = 1,
+
+  kPcapVersionMajor = 2,
+  kPcapVersionMinor = 4,
+  kLinktypeNull = 0,
+  kLinktypeEthernet = 1,
+  kBsdNullLoopback1 = 0x00000002,
+  kBsdNullLoopback2 = 0x02000000,
+  kEthernetIIHeaderMacSkip = 12,
+  kEthertypeIp = 0x0800,
+  kIpVersion4 = 4,
+  kMinIpHeaderLength = 20,
+  kFragmentOffsetClear = 0x0000,
+  kFragmentOffsetDoNotFragment = 0x4000,
+  kProtocolTcp = 0x06,
+  kProtocolUdp = 0x11,
+  kUdpHeaderLength = 8,
+  kMaxReadBufferSize = 4096
+};
