+TEST(PayloadRouterTest, SendOnOneModule) {
+  NiceMock<MockRtpRtcp> rtp;
+  std::vector<RtpRtcp*> modules(1, &rtp);
+  std::vector<VideoStream> streams(1);
+
+  uint8_t payload = 'a';
