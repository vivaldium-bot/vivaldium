+      encoder_config_.content_type = VideoEncoderConfig::ContentType::kScreen;
+      stream_->ReconfigureVideoEncoder(std::move(encoder_config_));
+      EXPECT_TRUE(init_encode_event_.Wait(kDefaultTimeoutMs));
