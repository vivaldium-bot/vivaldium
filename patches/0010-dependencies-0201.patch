+  virtual ~RtpFileReader() {}
+  static RtpFileReader* Create(FileFormat format,
+                               const std::string& filename);
+  static RtpFileReader* Create(FileFormat format,
+                               const std::string& filename,
+                               const std::set<uint32_t>& ssrc_filter);
+
+  virtual bool NextPacket(RtpPacket* packet) = 0;
+};
