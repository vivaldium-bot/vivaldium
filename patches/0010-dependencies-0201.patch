+  // From BitrateStatisticsObserver.
+  uint32_t total = 0;
+  uint32_t retransmit = 0;
+  BitrateStatisticsObserver* bitrate_observer = statistics_proxy_.get();
+  bitrate_observer->Notify(total, retransmit, excluded_ssrc);
