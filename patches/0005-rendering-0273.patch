-mapApp.prototype.addTooltip = function(tooltipNode,tooltipTextvalue,followmouse,checkForUpdates,targetOrCurrentTarget,childAttrib) {
-    var nrArguments = 6;
-    if (arguments.length == nrArguments) {
-        //get reference
