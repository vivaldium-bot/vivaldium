-    //calculation of weights
-    wa = (1 - e) * (1 - f);
-    wb = e * (1 - f);
-    wc = e * f;
-    wd = f * (1 - e);
-
-    height_interpol = wa * zc + wb * zd + wc * za + wd * zb;
-
-    return (height_interpol);    
