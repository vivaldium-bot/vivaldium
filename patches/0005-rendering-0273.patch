-
-//remove content from this.tabwindows[tabindex]["content"]
-tabgroup.prototype.removeContent = function(node,tabindex) {
-    var deletedNode = undefined;
-    if (tabindex >= this.tabTitles.length) {
-        this.outOfBoundMessage(tabindex);
