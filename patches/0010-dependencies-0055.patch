+      + api.step_data(
+          'gitiles log: refs/tags/B',
+          api.gitiles.make_log_test_data('B')
+      )
+      + api.step_data(
+          'commit log: %s' % (api.gitiles.make_hash('commit')),
+          api.gitiles.make_commit_test_data('commit', 'C', new_files=[
+              'foo/bar',
+              'baz/qux',
+          ])
+      )
+      + api.step_data(
+          'fetch master:OWNERS',
+          api.gitiles.make_encoded_file('foobar')
