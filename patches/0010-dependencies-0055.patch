+int ff_mpa_l2_select_table(int bitrate, int nb_channels, int freq, int lsf);
+
+#endif /* AVCODEC_MPEGAUDIO_H */
diff --git a/third_party/ffmpeg/libavcodec/mpegaudio_parser.c b/third_party/ffmpeg/libavcodec/mpegaudio_parser.c
new file mode 100644
index 0000000000000000000000000000000000000000..873f941237d8bb90a420ea8ec29b1a497b8a2b58
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpegaudio_parser.c
@@ -0,0 +1,134 @@
+/*
+ * MPEG Audio parser
+ * Copyright (c) 2003 Fabrice Bellard
+ * Copyright (c) 2003 Michael Niedermayer
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
