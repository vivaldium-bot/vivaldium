diff --git a/third_party/ffmpeg/libavcodec/mpegaudio_tablegen.h b/third_party/ffmpeg/libavcodec/mpegaudio_tablegen.h
new file mode 100644
index 0000000000000000000000000000000000000000..0b0ea40682dc87d5e29d59bfd9b7f79033d9aef9
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpegaudio_tablegen.h
@@ -0,0 +1,91 @@
+/*
+ * Header file for hardcoded mpegaudiodec tables
+ *
+ * Copyright (c) 2009 Reimar Döffinger <Reimar.Doeffinger@gmx.de>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
