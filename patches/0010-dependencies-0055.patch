diff --git a/third_party/ffmpeg/libavcodec/shorten.c b/third_party/ffmpeg/libavcodec/shorten.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f5be96eb7fedcdba1a62b3188db1725d20deb05
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/shorten.c
@@ -0,0 +1,687 @@
+/*
+ * Shorten decoder
