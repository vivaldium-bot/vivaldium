+void ff_rdft_end(RDFTContext *s);
+
+void ff_rdft_init_arm(RDFTContext *s);
+
+
+#endif /* AVCODEC_RDFT_H */
diff --git a/third_party/ffmpeg/libavcodec/realtextdec.c b/third_party/ffmpeg/libavcodec/realtextdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..870953bf3ca624713b2c18a210ef2e69e2653b2b
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/realtextdec.c
@@ -0,0 +1,85 @@
