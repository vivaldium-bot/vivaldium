index 0000000000000000000000000000000000000000..f2b8ecc4112ee35053dac391cf556d7c4777ede9
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/opus.c
@@ -0,0 +1,424 @@
+/*
