--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpeg4audio.c
@@ -0,0 +1,195 @@
+/*
+ * MPEG-4 Audio common code
+ * Copyright (c) 2008 Baptiste Coudurier <baptiste.coudurier@free.fr>
+ * Copyright (c) 2009 Alex Converse <alex.converse@gmail.com>
