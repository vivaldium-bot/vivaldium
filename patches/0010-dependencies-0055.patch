diff --git a/third_party/ffmpeg/libavcodec/rv10enc.c b/third_party/ffmpeg/libavcodec/rv10enc.c
new file mode 100644
index 0000000000000000000000000000000000000000..b17acbc9b5cd683608a61ab57e92f785aa58d196
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/rv10enc.c
@@ -0,0 +1,84 @@
+/*
+ * RV10 encoder
+ * Copyright (c) 2000,2001 Fabrice Bellard
+ * Copyright (c) 2002-2004 Michael Niedermayer
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
