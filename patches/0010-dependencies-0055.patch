new file mode 100644
index 0000000000000000000000000000000000000000..30b7ab9eb7ba4b6026c67afbef0f92b6b9217334
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ttadsp.c
@@ -0,0 +1,57 @@
