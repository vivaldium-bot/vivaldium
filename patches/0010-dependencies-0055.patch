index 0000000000000000000000000000000000000000..23e4ace7da595f073bda6495b2837e4f03166ae6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ppc/vp8dsp_altivec.c
@@ -0,0 +1,359 @@
