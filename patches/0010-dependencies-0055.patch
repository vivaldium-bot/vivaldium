+    'F0010': ('error while code parsing: %s',
+              'parse-error',
+              'Used when an exception occured while building the Astroid '
+              'representation which could be handled by astroid.'),
+
+    'I0001': ('Unable to run raw checkers on built-in module %s',
+              'raw-checker-failed',
