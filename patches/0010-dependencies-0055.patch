index 0000000000000000000000000000000000000000..4432135f19fc34789f054c547e3e15421ec44b1e
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/sinewin_tablegen.h
@@ -0,0 +1,79 @@
+/*
+ * Header file for hardcoded sine windows
+ *
+ * Copyright (c) 2009 Reimar Döffinger <Reimar.Doeffinger@gmx.de>
+ *
