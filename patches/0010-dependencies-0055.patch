--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/vaapi_internal.h
@@ -0,0 +1,102 @@
+/*
+ * Video Acceleration API (video decoding)
+ * HW decode acceleration for MPEG-2, MPEG-4, H.264 and VC-1
+ *
+ * Copyright (C) 2008-2009 Splitted-Desktop Systems
