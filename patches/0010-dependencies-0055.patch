+  def test_gerrit_change_detail_cache_simple(self):
+    self._mock_gerrit_changes_for_detail_cache()
+    self.calls = [
+        (('GetChangeDetail', 'host', '1', []), 'a'),
+        (('GetChangeDetail', 'host', '2', []), 'b'),
