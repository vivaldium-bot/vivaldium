+/**
+ * Set the given MpegEncContext to defaults for decoding.
+ * the changed fields will not depend upon
+ * the prior state of the MpegEncContext.
+ */
+void ff_mpv_decode_defaults(MpegEncContext *s)
+{
+    ff_mpv_common_defaults(s);
+}
