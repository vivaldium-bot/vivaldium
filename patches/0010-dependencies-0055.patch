index 0000000000000000000000000000000000000000..8e02bce2e85642a1e2b55a5b6217f6d1b31c88db
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/rtjpeg.c
@@ -0,0 +1,183 @@
+/*
+ * RTJpeg decoding functions
+ * Copyright (c) 2006 Reimar Doeffinger
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
