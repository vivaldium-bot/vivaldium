--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/sbrdsp.c
@@ -0,0 +1,225 @@
+/*
+ * AAC Spectral Band Replication decoding functions
+ * Copyright (c) 2008-2009 Robert Swain ( rob opendot cl )
+ * Copyright (c) 2009-2010 Alex Converse <alex.converse@gmail.com>
+ *
