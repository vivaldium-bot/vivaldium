+
+#include <string>
+#ifdef COMPILER_MSVC
+#include <sstream>
+#endif  // COMPILER_MSVC
+
+namespace chrome_lang_id {
+
+// TODO(abakalov): Pick the most efficient approach.
+#ifdef COMPILER_MSVC
+std::string Int64ToString(int64 input) {
+  std::stringstream stream;
+  stream << input;
+  return stream.str();
+}
