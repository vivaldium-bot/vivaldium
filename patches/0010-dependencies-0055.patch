+++ b/third_party/ffmpeg/libavcodec/tscc2.c
@@ -0,0 +1,388 @@
+/*
+ * TechSmith Screen Codec 2 (aka Dora) decoder
+ * Copyright (c) 2012 Konstantin Shishkov
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
