diff --git a/third_party/ffmpeg/libavcodec/tiffenc.c b/third_party/ffmpeg/libavcodec/tiffenc.c
new file mode 100644
index 0000000000000000000000000000000000000000..3d37d2e08497ac5ecfe3b98ebc3dbd2aaa5e6301
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/tiffenc.c
@@ -0,0 +1,587 @@
+/*
+ * TIFF image encoder
+ * Copyright (c) 2007 Bartlomiej Wolowiec
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
