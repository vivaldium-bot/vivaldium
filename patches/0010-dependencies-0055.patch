index 0000000000000000000000000000000000000000..75dae15ab5747e22a510417bcaf1bd71411cced0
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/qsvenc_hevc.c
@@ -0,0 +1,267 @@
