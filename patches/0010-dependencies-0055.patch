diff --git a/third_party/ffmpeg/libavcodec/pnm_parser.c b/third_party/ffmpeg/libavcodec/pnm_parser.c
new file mode 100644
index 0000000000000000000000000000000000000000..a7d70b99313e3d1676a9a714e053e5b1bb3f50fc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/pnm_parser.c
@@ -0,0 +1,94 @@
+/*
+ * PNM image parser
+ * Copyright (c) 2002, 2003 Fabrice Bellard
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
