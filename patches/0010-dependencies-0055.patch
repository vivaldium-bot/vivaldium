diff --git a/third_party/findbugs/src/xsl/default.xsl b/third_party/findbugs/src/xsl/default.xsl
new file mode 100644
index 0000000000000000000000000000000000000000..e8f30d46f7d9ffba5d121bb9cc32868e388377a0
--- /dev/null
+++ b/third_party/findbugs/src/xsl/default.xsl
@@ -0,0 +1,376 @@
+<?xml version="1.0" encoding="UTF-8"?>
+
+<!--
+  FindBugs - Find bugs in Java programs
+  Copyright (C) 2004,2005 University of Maryland
+  Copyright (C) 2005, Chris Nappin
+  
