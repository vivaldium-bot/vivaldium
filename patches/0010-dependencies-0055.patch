diff --git a/third_party/ffmpeg/libavcodec/vaapi.c b/third_party/ffmpeg/libavcodec/vaapi.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1ea790add9d14cb7c2f2379732cdd1f649bd8b7
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/vaapi.c
@@ -0,0 +1,253 @@
+/*
+ * Video Acceleration API (video decoding)
+ * HW decode acceleration for MPEG-2, MPEG-4, H.264 and VC-1
+ *
+ * Copyright (C) 2008-2009 Splitted-Desktop Systems
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
