+    options = (('required-attributes',
+                {'default' : (), 'type' : 'csv',
+                 'metavar' : '<attributes>',
+                 'help' : 'Required attributes for module, separated by a '
+                          'comma'}
+               ),
+               ('bad-functions',
+                {'default' : BAD_FUNCTIONS,
