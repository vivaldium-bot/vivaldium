+                             generation=generation,
+                             if_generation=if_generation,
+                             if_metageneration=if_metageneration)
+        else:
+            self.set_canned_acl(acl_or_str, key_name, headers=headers,
+                                generation=generation,
+                                if_generation=if_generation,
+                                if_metageneration=if_metageneration)
