index 0000000000000000000000000000000000000000..4a367b655eb1c4da656dbe57b3ef3b545c5bb6c3
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ppc/vp3dsp_altivec.c
@@ -0,0 +1,203 @@
+/*
