+func.refs: local-fontconfig-devel.sgml $(DOCS_DEPS)
+	$(AM_V_GEN) $(RM) $@; \
+	$(DOC2MAN) -o devel-man local-fontconfig-devel.sgml && \
+	mv devel-man/manpage.refs func.refs &&	\
+	mv devel-man/*.3 . &&			\
+	$(RM) devel-man/manpage.* &&		\
+	rmdir devel-man || rm $@ || :
