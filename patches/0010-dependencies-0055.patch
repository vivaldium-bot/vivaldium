diff --git a/third_party/ffmpeg/libavcodec/pixels.h b/third_party/ffmpeg/libavcodec/pixels.h
new file mode 100644
index 0000000000000000000000000000000000000000..98eacd4df61228a2dd197921d6e3b82ab58a5438
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/pixels.h
@@ -0,0 +1,37 @@
+/*
