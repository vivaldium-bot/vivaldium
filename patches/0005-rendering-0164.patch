-      for (var i = 0; i < jumpsToDo; ++i) {
-        rollback();
-        dumpSelection('Rolled back');
-      }
-      for (var i = 0; i < jumpsToDo; ++i) {
-        rollover();
-        dumpSelection('Rolled over');
-      }
-      next();
-    },
-
