+  fred.Concat("DY", 2);
+  EXPECT_EQ("FREDDY", fred);
+
+  fred.Delete(3, 3);
+  EXPECT_EQ("FRE", fred);
+
+  fred.Concat("D", 1);
+  EXPECT_EQ("FRED", fred);
