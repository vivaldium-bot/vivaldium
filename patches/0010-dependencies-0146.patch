+		sctp_log_lock(_tcb->sctp_ep, _tcb, SCTP_LOG_LOCK_TCB);         \
+	(void)pthread_mutex_lock(&(_tcb)->tcb_mtx);                            \
+} while (0)
+#endif
+#else
+#ifdef INVARIANTS
+#define SCTP_TCB_LOCK(_tcb) \
+        KASSERT(pthread_mutex_lock(&(_tcb)->tcb_mtx) == 0, ("%s: tcb_mtx already locked", __func__))
