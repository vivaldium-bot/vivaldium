+#if defined _SKIA_SUPPORT_ || _SKIA_SUPPORT_PATHS_
+CFX_TypeFace* CFX_Font::GetDeviceCache() const {
+  return GetFaceCache()->GetDeviceCache(this);
+}
+#endif
