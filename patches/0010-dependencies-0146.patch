+  CFX_STemplate<OtherType> As() const {
+    return CFX_STemplate<OtherType>(static_cast<OtherType>(width),
+                                    static_cast<OtherType>(height));
+  }
+
+  void clear() {
+    width = 0;
+    height = 0;
+  }
+  CFX_STemplate operator=(const CFX_STemplate& other) {
