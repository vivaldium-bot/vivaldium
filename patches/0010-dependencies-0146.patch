+
+class CPDFSDK_Annot;
+class CPDFSDK_PageView;
+
+class CBA_AnnotIterator {
+ public:
+  enum TabOrder { STRUCTURE = 0, ROW, COLUMN };
+
+  CBA_AnnotIterator(CPDFSDK_PageView* pPageView,
+                    CPDF_Annot::Subtype nAnnotSubtype);
+  ~CBA_AnnotIterator();
+
+  CPDFSDK_Annot* GetFirstAnnot();
