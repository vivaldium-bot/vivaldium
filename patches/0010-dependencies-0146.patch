+
+#ifndef CORE_FPDFAPI_RENDER_CPDF_PROGRESSIVERENDERER_H_
+#define CORE_FPDFAPI_RENDER_CPDF_PROGRESSIVERENDERER_H_
+
+#include <memory>
+
+#include "core/fpdfapi/page/cpdf_pageobjectlist.h"
