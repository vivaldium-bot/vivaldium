+
+class CFX_BlockBuffer {
+ public:
+  CFX_BlockBuffer();
+  ~CFX_BlockBuffer();
+
+  bool InitBuffer();
+  bool IsInitialized() { return m_BufferSize / GetAllocStep() >= 1; }
+
