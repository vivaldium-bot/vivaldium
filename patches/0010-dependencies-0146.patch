new file mode 100644
index 0000000000000000000000000000000000000000..b84f0da3f25427e606236c8d58529eeec10d8db0
--- /dev/null
+++ b/third_party/wds/src/libwds/public/video_format.h
@@ -0,0 +1,218 @@
+/*
