+CPDF_Action CPDF_FormControl::GetAction() {
+  if (!m_pWidgetDict)
+    return CPDF_Action();
+
+  if (m_pWidgetDict->KeyExist("A"))
+    return CPDF_Action(m_pWidgetDict->GetDictFor("A"));
+
+  CPDF_Object* pObj = FPDF_GetFieldAttr(m_pField->GetDict(), "A");
+  if (!pObj)
+    return CPDF_Action();
+
+  return CPDF_Action(pObj->GetDict());
+}
