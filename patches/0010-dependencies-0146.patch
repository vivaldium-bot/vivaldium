+            if os.path.isdir(name):
+                shutil.rmtree(name)
+            else:
+                os.remove(name)
+    map = asyncore.socket_map
+    for x in map.values():
+        try:
+            sys.stderr.write("garbage: %s\n" % repr(x))
+            x.close()
+        except:
+            pass
+    map.clear()
+
