+  | WFD_INPUT_PATH_ZIGBEE {
+      $$ = wds::rtsp::UIBCCapability::ZIGBEE;
+    }
+  | WFD_INPUT_PATH_WIFI {
+      $$ = wds::rtsp::UIBCCapability::WI_FI;
+    }
+  | WFD_INPUT_PATH_NOSP {
+      $$ = wds::rtsp::UIBCCapability::NO_SP;
+    }
+  ;
+  
+wfd_uibc_setting:
+    WFD_UIBC_SETTING ':' WFD_SP wfd_uibc_setting_value {
+      $$ = new wds::rtsp::UIBCSetting($4);
