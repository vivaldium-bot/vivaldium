+	const float M_PI = 3.14159265358979323846;
+	vec3 c = 2.0 * (gtf_Color.rgb - 0.5);
+	vec3 acos_c = vec3(0.0);
+	vec3 scale = vec3(1.0);
+	vec3 sign = vec3(1.0);
