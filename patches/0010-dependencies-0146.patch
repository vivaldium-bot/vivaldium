+      }
+    </script>
+
+    <script id="identity-vert" type="x-shader/x-vertex">
+      attribute vec3 Vertex;
+      attribute vec2 Tex;
+
+      varying vec4 texCoord0;
+      void main()
+      {
+        texCoord0 = vec4(Tex,0.0,0.0);
