index 0000000000000000000000000000000000000000..fe53240e62a0d9cc0e4dcbc50dfd901d50e80f40
--- /dev/null
+++ b/third_party/wayland/src/tests/array-test.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright © 2012 Intel Corporation
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining
