+void CFX_XMLAttributeNode::SetString(const CFX_WideString& name,
+                                     const CFX_WideString& value) {
+  attrs_[name] = value;
+}
+
+void CFX_XMLAttributeNode::RemoveAttribute(const CFX_WideString& name) {
+  attrs_.erase(name);
+}
