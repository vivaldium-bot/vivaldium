+bool CFX_SkiaDeviceDriver::FillRectWithBlend(const FX_RECT* pRect,
+                                             uint32_t fill_color,
+                                             int blend_type) {
+  m_pCache->FlushForDraw();
+  SkPaint spaint;
+  spaint.setAntiAlias(true);
+  spaint.setColor(fill_color);
+  spaint.setBlendMode(GetSkiaBlendMode(blend_type));
