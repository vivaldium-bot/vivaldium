index 0000000000000000000000000000000000000000..62500ac1557c04d0487d4c2b520005b7d6edf6da
--- /dev/null
+++ b/third_party/pdfium/core/fpdfdoc/cpdf_structtree.cpp
@@ -0,0 +1,155 @@
+// Copyright 2017 PDFium Authors. All rights reserved.
