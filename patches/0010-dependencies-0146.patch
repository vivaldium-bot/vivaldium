+}
+
+WL_EXPORT struct wl_resource *
+wl_resource_find_for_client(struct wl_list *list, struct wl_client *client)
+{
+	struct wl_resource *resource;
+
+	if (client == NULL)
+		return NULL;
+
+	wl_list_for_each(resource, list, link) {
+		if (resource->client == client)
+			return resource;
+	}
+
+	return NULL;
+}
