+  if (y < 0) {
+    ys0 = -y;
+  }
+  if (y + m_nHeight > pDst->m_nHeight) {
+    ys1 = pDst->m_nHeight - y;
+  } else {
+    ys1 = m_nHeight;
+  }
+  if (x < 0) {
+    xs0 = -x;
+  }
+  if (x + m_nWidth > pDst->m_nWidth) {
+    xs1 = pDst->m_nWidth - x;
+  } else {
+    xs1 = m_nWidth;
+  }
