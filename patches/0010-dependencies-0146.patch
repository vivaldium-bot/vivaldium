+	// pow can't handle negative numbers so take advantage of symmetry
+	if(c.g < 0.0)
+	{
+		sign.g = -1.0;
+		c.g *= -1.0;
+	}
+
+	// Taylors series expansion for acos
+	// 1000/2 iterations necessary to get the accuracy with this method
