+int CPDF_FormField::GetControlIndex(const CPDF_FormControl* pControl) const {
+  if (!pControl)
+    return -1;
+
+  auto it = std::find(m_ControlList.begin(), m_ControlList.end(), pControl);
+  return it != m_ControlList.end() ? it - m_ControlList.begin() : -1;
+}
