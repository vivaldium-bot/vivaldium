+TEST(fxcrt, ByteStringOperatorSubscript) {
+  // CFX_ByteString includes the NUL terminator for non-empty strings.
+  CFX_ByteString abc("abc");
+  EXPECT_EQ('a', abc[0]);
+  EXPECT_EQ('b', abc[1]);
+  EXPECT_EQ('c', abc[2]);
+  EXPECT_EQ(0, abc[3]);
+}
