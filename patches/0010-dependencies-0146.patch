+                                 int dest_Bpp,
+                                 const uint8_t* clip_scan,
+                                 const uint8_t* src_alpha_scan) {
+  int blended_colors[3];
+  bool bNonseparableBlend = blend_type >= FXDIB_BLEND_NONSEPARABLE;
