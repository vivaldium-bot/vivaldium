+  fred.Concat(L"DY", 2);
+  EXPECT_EQ(L"FREDDY", fred);
+
+  fred.Delete(3, 3);
+  EXPECT_EQ(L"FRE", fred);
+
+  fred.Concat(L"D", 1);
+  EXPECT_EQ(L"FRED", fred);
+
+  CFX_WideString copy = fred;
+  fred.Concat(L"DY", 2);
+  EXPECT_EQ(L"FREDDY", fred);
+  EXPECT_EQ(L"FRED", copy);
