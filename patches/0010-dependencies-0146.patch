+class CFX_SkiaDeviceDriver : public IFX_RenderDeviceDriver {
+ public:
+  CFX_SkiaDeviceDriver(const CFX_RetainPtr<CFX_DIBitmap>& pBitmap,
+                       bool bRgbByteOrder,
+                       const CFX_RetainPtr<CFX_DIBitmap>& pOriDevice,
