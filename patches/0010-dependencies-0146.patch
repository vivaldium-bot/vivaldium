+int32_t CPDF_VariableText::GetTotalWords() const {
+  int32_t nTotal = 0;
+  for (const auto& pSection : m_SectionArray) {
+    nTotal +=
+        pdfium::CollectionSize<int32_t>(pSection->m_WordArray) + kReturnLength;
+  }
+  return nTotal - kReturnLength;
+}
