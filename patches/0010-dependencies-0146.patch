index 0000000000000000000000000000000000000000..d6ccd933a9301825155bd6c33e478f7a563c6cc7
--- /dev/null
+++ b/third_party/usrsctp/usrsctplib/usrsctplib/netinet/sctp_ss_functions.c
@@ -0,0 +1,999 @@
+/*-
