+struct FPF_SKIAFONTMAP {
+  uint32_t dwFamily;
+  uint32_t dwSubSt;
+};
+
+const FPF_SKIAFONTMAP g_SkiaFontmap[] = {
+    {0x58c5083, 0xc8d2e345},  {0x5dfade2, 0xe1633081},
+    {0x684317d, 0xe1633081},  {0x14ee2d13, 0xc8d2e345},
+    {0x3918fe2d, 0xbbeeec72}, {0x3b98b31c, 0xe1633081},
