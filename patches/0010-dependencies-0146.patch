+  if (IsGDIEnabled())
+    pPlatformData->m_GdiplusExt.Load();
+  m_pPlatformData = pPlatformData;
+  m_pFontMgr->SetSystemFontInfo(IFX_SystemFontInfo::CreateDefault(nullptr));
