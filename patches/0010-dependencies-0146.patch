+#ifndef CORE_FPDFDOC_CPVT_WORDRANGE_H_
+#define CORE_FPDFDOC_CPVT_WORDRANGE_H_
+
+#include <utility>
+
+#include "core/fpdfdoc/cpvt_wordplace.h"
+#include "core/fxcrt/fx_system.h"
+
+struct CPVT_WordRange {
+  CPVT_WordRange() {}
+
+  CPVT_WordRange(const CPVT_WordPlace& begin, const CPVT_WordPlace& end)
+      : BeginPos(begin), EndPos(end) {
+    Normalize();
+  }
+
+  void Reset() {
+    BeginPos.Reset();
+    EndPos.Reset();
+  }
+
+  void Set(const CPVT_WordPlace& begin, const CPVT_WordPlace& end) {
+    BeginPos = begin;
+    EndPos = end;
+    Normalize();
+  }
+
+  void SetBeginPos(const CPVT_WordPlace& begin) {
+    BeginPos = begin;
+    Normalize();
+  }
+
+  void SetEndPos(const CPVT_WordPlace& end) {
+    EndPos = end;
+    Normalize();
+  }
+
+  inline bool IsEmpty() const { return BeginPos == EndPos; }
+  inline bool operator==(const CPVT_WordRange& wr) const {
+    return wr.BeginPos == BeginPos && wr.EndPos == EndPos;
+  }
+  inline bool operator!=(const CPVT_WordRange& wr) const {
+    return !(*this == wr);
+  }
+
+  void Normalize() {
+    if (BeginPos > EndPos)
+      std::swap(BeginPos, EndPos);
+  }
+
+  CPVT_WordPlace BeginPos;
+  CPVT_WordPlace EndPos;
+};
+
+#endif  // CORE_FPDFDOC_CPVT_WORDRANGE_H_
diff --git a/third_party/pdfium/core/fpdfdoc/csection.cpp b/third_party/pdfium/core/fpdfdoc/csection.cpp
