+        tmp = texture2D(Texture, texCoord0.st + vec2(float(3-3)*step,0));
+        sum += tmp * kernel[3];
+        tmp = texture2D(Texture, texCoord0.st + vec2(float(4-3)*step,0));
+        sum += tmp * kernel[4];
+        tmp = texture2D(Texture, texCoord0.st + vec2(float(5-3)*step,0));
