+            case JBIG2_COMPOSE_REPLACE:
+              tmp = (tmp2 & ~maskR) | (tmp1 & maskR);
+              break;
+          }
+          dp[0] = (uint8_t)(tmp >> 24);
+          dp[1] = (uint8_t)(tmp >> 16);
+          dp[2] = (uint8_t)(tmp >> 8);
+          dp[3] = (uint8_t)tmp;
+        }
+        lineSrc += m_nStride;
+        lineDst += pDst->m_nStride;
+      }
+    }
+  }
+  return 1;
+}
