+
+static inline void
+terminate_non_graceful(void) {
+	abort();
+}
+
+#define panic(...)                       \
+	do {                             \
+		SCTP_PRINTF(__VA_ARGS__);\
+		SCTP_PRINTF("\n");       \
+		terminate_non_graceful();\
+} while (0)
+
+#define KASSERT(cond, args)          \
+	do {                         \
+		if (!(cond)) {       \
+			panic args ;\
+		}                    \
+	} while (0)
+#else
+#define KASSERT(cond, args)
+#endif
