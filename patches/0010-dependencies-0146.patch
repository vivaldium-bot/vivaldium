+FX_WordBreakProp GetWordBreakProperty(wchar_t wcCodePoint) {
+  uint32_t dwProperty =
+      (uint32_t)gs_FX_WordBreak_CodePointProperties[wcCodePoint >> 1];
+  return (FX_WordBreakProp)(((wcCodePoint)&1) ? (dwProperty & 0x0F)
+                                              : (dwProperty >> 4));
+}
