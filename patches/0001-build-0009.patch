+        assert(m.size() == 1);
+        assert(!m.prefix().matched);
+        assert(m.prefix().first == BI(s));
+        assert(m.prefix().second == m[0].first);
+        assert(!m.suffix().matched);
+        assert(m.suffix().first == m[0].second);
+        assert(m.suffix().second == m[0].second);
+        assert(m.length(0) == 4);
+        assert(m.position(0) == 0);
+        assert(m.str(0) == s);
+    }
+}
diff --git a/buildtools/third_party/libc++/trunk/test/std/re/re.alg/re.alg.search/grep.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/re/re.alg/re.alg.search/grep.pass.cpp
