+std::string getCaseName (const TessPrimitiveType primitiveType, const Winding winding)
+{
+	std::ostringstream str;
+	str << getTessPrimitiveTypeShaderName(primitiveType) << "_" << getWindingShaderName(winding);
+	return str.str();
