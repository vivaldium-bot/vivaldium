+<pre class="prettyprint">
+// Good: compact without sacrificing readability
+return (a &lt; 0.0f) ? -a : a;
+
+// Bad: waste of space
+float result;
+if (a &lt; 0.0f)
+{
+    result = -a;
+}
+else
+{
+    result = a;
+}
+return result;
