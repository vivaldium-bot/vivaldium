+#ifndef _TCURANDOMVALUEITERATOR_HPP
+#define _TCURANDOMVALUEITERATOR_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Tester Core
+ * ----------------------------------------
