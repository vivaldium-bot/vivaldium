+// Tests
+
+DE_DECLARE_COMMAND_LINE_OPT(TestStringOpt,		std::string);
+DE_DECLARE_COMMAND_LINE_OPT(TestStringDefOpt,	std::string);
+DE_DECLARE_COMMAND_LINE_OPT(TestIntOpt,			int);
