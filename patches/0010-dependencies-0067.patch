+
+inline VkFrontFace mapFrontFace (const Winding winding)
+{
+	switch (winding)
+	{
+		case WINDING_CCW:	return VK_FRONT_FACE_COUNTER_CLOCKWISE;
+		case WINDING_CW:	return VK_FRONT_FACE_CLOCKWISE;
+		default:
+			DE_ASSERT(false);
+			return VK_FRONT_FACE_LAST;
+	}
+}
