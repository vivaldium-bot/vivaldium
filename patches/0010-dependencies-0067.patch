+ * \brief Construct command line
+ * \note CommandLine is not fully initialized until parse() has been called.
+ *//*--------------------------------------------------------------------*/
+CommandLine::CommandLine (void)
+	: m_logFlags	(0)
+	, m_caseTree	(DE_NULL)
+{
+}
