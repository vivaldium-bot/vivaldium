+	const UniformBlock&			getUniformBlock			(int ndx) const	{ return *m_uniformBlocks[ndx];			}
+
+private:
+	std::vector<StructTypeSP>		m_structs;
+	std::vector<UniformBlockSP>		m_uniformBlocks;
+};
