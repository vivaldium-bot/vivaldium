-      assert_equals(img.height, expected_height, 'height');
-      assert_equals(img.naturalWidth, 0, 'naturalWidth');
-      assert_equals(img.naturalHeight, 0, 'naturalHeight');
-    }, img.outerHTML);
-  });
-  done();
-};
-</script>
