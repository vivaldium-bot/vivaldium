+  uxtb(rd, rn);
+}
+
+void TurboAssembler::Uxth(const Register& rd, const Register& rn) {
+  DCHECK(allow_macro_instructions());
+  DCHECK(!rd.IsZero());
+  uxth(rd, rn);
+}
