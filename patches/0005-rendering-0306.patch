+void TurboAssembler::Fcmp(const VRegister& fn, double value) {
+  DCHECK(allow_macro_instructions());
+  if (value != 0.0) {
+    UseScratchRegisterScope temps(this);
+    VRegister tmp = temps.AcquireSameSizeAs(fn);
+    Fmov(tmp, value);
+    fcmp(fn, tmp);
+  } else {
+    fcmp(fn, value);
+  }
+}
