+template <typename T>
+template <typename S>
+void ReturnValue<T>::Set(const Local<S> handle) {
+  TYPE_CHECK(T, S);
+  if (V8_UNLIKELY(handle.IsEmpty())) {
+    *value_ = GetDefaultValue();
+  } else {
