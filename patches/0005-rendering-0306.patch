+bool WebLocalFrameImpl::snapshotPage(SkBitmap& bitmap,
+                                     bool full_page,
+                                     float width,
+                                     float height) {
+  if (!GetFrame()->GetDocument() ||
+      GetFrame()->GetDocument()->GetLayoutViewItem().IsNull())
+    return false;
+
+  Document* document = GetFrame()->GetDocument();
+  bool has_accelerated_compositing =
+    document->GetSettings()->GetAcceleratedCompositingEnabled();
+
+  // Disable accelerated compositing temporary to make canvas and other
+  // normally HWA element show up, restrict to full page rendering for now.
+  if (full_page) {
+    document->GetSettings()->SetAcceleratedCompositingEnabled(false);
+  }
+
+  // Force an update of the lifecycle since we changed the painting method
+  // of accelerated elements.
+  GetFrame()->View()->UpdateAllLifecyclePhasesExceptPaint();
+
+  LayoutViewItem view = GetFrame()->GetDocument()->GetLayoutViewItem();
+  IntRect documentRect = view.DocumentRect();
+  FloatSize pageSize;
+  WebRect fullVisibleSize = VisibleContentRect();
+
+  if (full_page) {
+    pageSize = GetFrame()->ResizePageRectsKeepingRatio(
+      FloatSize(documentRect.Width(), documentRect.Height()),
+      FloatSize(documentRect.Width(), documentRect.Height()));
+    pageSize.SetHeight(std::min(pageSize.Height(), height));
+  } else {
+    pageSize.SetWidth(fullVisibleSize.width);
+    pageSize.SetHeight(fullVisibleSize.height);
+  }
+  float pageWidth = pageSize.Width();
+  float pageHeight = pageSize.Height();
+  IntRect pageRect(FloatRect(0, 0, pageWidth, pageHeight));
+  PaintRecordBuilder pictureBuilder;
+  GraphicsContext& context = pictureBuilder.Context();
+  {
+    SkBitmap bitmap_in;
+
+    // TODO: Check if setInfo is enough here.
+    bitmap_in.allocN32Pixels(pageWidth, pageHeight);
+
+    std::unique_ptr<SkCanvas> canvas(new SkCanvas(bitmap_in));
+
+    context.SetShouldAntialias(false);
+
+    // Avoids re-sampling of the bitmap when it thinks it's printing.
+    context.SetPrinting(true);
+
+    GetFrame()->View()->PaintContents(context,
+                                      kGlobalPaintFlattenCompositingLayers,
+                                      pageRect);
+
+    pictureBuilder.EndRecording()->Playback(canvas.get());
+
+    bitmap.setInfo(SkImageInfo::MakeN32Premul(pageWidth, pageHeight));
+    if (bitmap.tryAllocPixels(bitmap.info())) {
+      canvas->readPixels(bitmap, 0, 0);
+    }
+  }
+  if (full_page) {
+    document->GetSettings()->SetAcceleratedCompositingEnabled(
+      has_accelerated_compositing);
+
+    GetFrame()->View()->UpdateAllLifecyclePhasesExceptPaint();
+  }
+
+  return true;
+}
+
 }  // namespace blink
