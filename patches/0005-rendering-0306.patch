+// Neon sizes.
+enum NeonSize { Neon8 = 0x0, Neon16 = 0x1, Neon32 = 0x2, Neon64 = 0x3 };
+
+// NEON data type
+enum NeonDataType {
+  NeonS8 = 0,
+  NeonS16 = 1,
+  NeonS32 = 2,
