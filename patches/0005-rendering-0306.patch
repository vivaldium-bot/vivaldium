+LogicVRegister Simulator::smaxp(VectorFormat vform, LogicVRegister dst,
+                                const LogicVRegister& src1,
+                                const LogicVRegister& src2) {
+  return SMinMaxP(vform, dst, src1, src2, true);
+}
