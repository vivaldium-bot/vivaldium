+extern void armSP_FFTInv_CToC_FC32_Radix8_fs_OutOfPlace(
+    const OMX_FC32* pSrc,
+    OMX_FC32* pDst,
+    OMX_FC32* pTwiddle,
+    long* subFFTNum,
+    long* subFFTSize);
