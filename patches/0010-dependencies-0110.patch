+Cluster::Cluster(uint64 timecode, int64 cues_pos, uint64 timecode_scale)
+    : blocks_added_(0),
+      finalized_(false),
+      header_written_(false),
+      payload_size_(0),
+      position_for_cues_(cues_pos),
+      size_position_(-1),
+      timecode_(timecode),
+      timecode_scale_(timecode_scale),
+      writer_(NULL) {}
