+	certHandle = sftk_getCertDB(slot);
+	if (certHandle == NULL) {
+	    return CKR_TOKEN_WRITE_PROTECTED;
+	}
+
+	crv = sftkdb_write(certHandle, object, &object->handle);
+	sftk_freeDB(certHandle);
+	return crv;
+    }
+
+    return CKR_OK;
+}
