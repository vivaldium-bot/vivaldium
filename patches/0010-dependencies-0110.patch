index 0000000000000000000000000000000000000000..04894c59ab7ebd44fde56f7a4029c15cf115f65b
--- /dev/null
+++ b/third_party/opus/src/silk/NLSF_VQ_weights_laroia.c
@@ -0,0 +1,80 @@
