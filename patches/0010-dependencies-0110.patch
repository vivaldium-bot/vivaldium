++    s1 = LOAD(&((vec*)kp)[0]);
++    s2 = LOAD(&((vec*)kp)[1]);
++    s3 = (vec) {
++	counter & 0xffffffff,
++	counter >> 32,
++	((uint32_t*)nonce)[0],
++	((uint32_t*)nonce)[1]
