++		} else {
++		    buf[2] = REVV_BE(v2 + s2);
++		}
++	    } else {
++		buf[1] = REVV_BE(v1 + s1);
++	    }
++	} else {
++	    buf[0] = REVV_BE(v0 + s0);
++	}
++
++	for (i=inlen & ~15; i<inlen; i++) {
++	    ((char *)op)[i] = ((char *)ip)[i] ^ ((char *)buf)[i];
++	}
++    }
++}
