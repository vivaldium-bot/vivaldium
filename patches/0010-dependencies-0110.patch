+  private AddressSpinnerInfo findSpinnerByView(View view) {
+    for (AddressSpinnerInfo spinnerInfo : spinners) {
+      if (spinnerInfo.view == view) {
+        return spinnerInfo;
+      }
+    }
+    return null;
+  }
