+PK11SDR_Decrypt(SECItem *data, SECItem *result, void *cx);
+
+SEC_END_PROTOS
+
+#endif
diff --git a/third_party/nss/nss/lib/pk11wrap/pk11skey.c b/third_party/nss/nss/lib/pk11wrap/pk11skey.c
new file mode 100644
index 0000000000000000000000000000000000000000..4c5b9f16aaff5d707723ee27c06fddf6a5e68f6d
--- /dev/null
+++ b/third_party/nss/nss/lib/pk11wrap/pk11skey.c
@@ -0,0 +1,2670 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+/*
+ * This file implements the Symkey wrapper and the PKCS context
+ * Interfaces.
+ */
+
