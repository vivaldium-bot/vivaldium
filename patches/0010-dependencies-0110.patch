index 0000000000000000000000000000000000000000..4af89aa5fad324799620e64c3fa22e3ea6bd9400
--- /dev/null
+++ b/third_party/opus/src/silk/LPC_inv_pred_gain.c
@@ -0,0 +1,154 @@
+/***********************************************************************
