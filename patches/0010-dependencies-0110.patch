index 0000000000000000000000000000000000000000..1d1926caeb7f016658c69b0efba617ca286a4e3a
--- /dev/null
+++ b/third_party/libvpx_new/source/libvpx/vp9/encoder/vp9_ethread.c
@@ -0,0 +1,203 @@
