++	    out[i] = in[i] ^ block[i];
++	}
++
++	input[12]++;
++	if (input[12] == 0) {
++	    input[13]++;
++	}
++
++	inLen -= 64;
++	in += 64;
++	out += 64;
++    }
++
++    if (inLen > 0) {
++	ChaChaCore(block, input, 20);
++	for (i = 0; i < inLen; i++) {
++	    out[i] = in[i] ^ block[i];
++	}
++    }
++}
