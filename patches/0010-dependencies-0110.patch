++#if GPR_TOO
++	register unsigned x0, x1, x2, x3, x4, x5, x6, x7, x8,
++		  x9, x10, x11, x12, x13, x14, x15;
++#endif
++#if VBPI > 2
++	vec v8,v9,v10,v11;
++#endif
++#if VBPI > 3
++	vec v12,v13,v14,v15;
++#endif
++
++	vec v0,v1,v2,v3,v4,v5,v6,v7;
++	v4 = v0 = s0; v5 = v1 = s1; v6 = v2 = s2; v3 = s3;
++	v7 = v3 + ONE;
++#if VBPI > 2
++	v8 = v4; v9 = v5; v10 = v6;
++	v11 =  v7 + ONE;
++#endif
++#if VBPI > 3
++	v12 = v8; v13 = v9; v14 = v10;
++	v15 = v11 + ONE;
++#endif
