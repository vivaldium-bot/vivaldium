+<c>12</c>
+ <c>3920</c> <c>3889</c> <c>3857</c> <c>3822</c>
+<c>16</c>
+ <c>3784</c> <c>3745</c> <c>3703</c> <c>3659</c>
+<c>20</c>
+ <c>3613</c> <c>3564</c> <c>3513</c> <c>3461</c>
+<c>24</c>
+ <c>3406</c> <c>3349</c> <c>3290</c> <c>3229</c>
+<c>28</c>
