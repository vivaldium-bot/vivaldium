+
+#include "dl/api/omxtypes.h"
+
+void x86SP_FFT_CToC_FC32_Inv_Radix2_fs(
+    const OMX_F32 *in,
+    OMX_F32 *out,
+    OMX_INT n) {
+  OMX_INT i;
+  OMX_INT n_by_2 = n >> 1;
+  OMX_F32 *out0 = out;
+
+  for (i = 0; i < n_by_2; i++) {
+    const OMX_F32 *in0 = in + i;
+    const OMX_F32 *in1 = in0 + n_by_2;
+    OMX_F32 *out1 = out0 + n_by_2;
+
+    // CADD out0, in0, in1
+    out0[0] = in0[0] + in1[0];
+    out0[n] = in0[n] + in1[n];
+
+    // CSUB out1, in0, in1
+    out1[0] = in0[0] - in1[0];
+    out1[n] = in0[n] - in1[n];
+
+    out0 += 1;
+  }
+}
