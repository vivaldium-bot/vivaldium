new file mode 100644
index 0000000000000000000000000000000000000000..76e2c66e9c0af518b5d93323094d767b3a7f41f6
--- /dev/null
+++ b/third_party/nss/nss/lib/pki/pkitm.h
@@ -0,0 +1,88 @@
