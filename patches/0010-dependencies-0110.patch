+rm nspr/pr/src/md/unix/os_Darwin_ppc.s
+rm nspr/pr/src/md/unix/os_Linux_ppc.s
+rm nspr/pr/src/md/unix/os_Linux_ia64.s
+rm nspr/pr/src/md/unix/uxpoll.c
