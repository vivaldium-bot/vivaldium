+
+			count = 0;
+			glGetAttachedShaders(program, 1, &count, shaders);
+			if (count != 1)
+			{
+				m_testCtx.getLog() << TestLog::Message << "// ERROR: Expected 1; got " << count << TestLog::EndMessage;
+				if (m_testCtx.getTestResult() == QP_TEST_RESULT_PASS)
