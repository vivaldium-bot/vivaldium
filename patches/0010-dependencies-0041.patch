+
+// GL_EXT_color_buffer_float
+static const FormatKey s_extColorBufferFloatFormats[] =
+{
+	GL_RGBA32F, GL_RGBA16F, GL_R11F_G11F_B10F, GL_RG32F, GL_RG16F, GL_R32F, GL_R16F,
