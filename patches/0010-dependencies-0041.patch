+template <typename T>
+struct NativeSurface : public ManagedSurface
+{
+public:
+	explicit		NativeSurface	(MovePtr<UniqueSurface>	surface,
+									 MovePtr<T>				native)
+						: ManagedSurface	(surface)
+						, m_native			(native) {}
+
+private:
