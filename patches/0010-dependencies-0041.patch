+          e.stopPropagation();
+        }
+      });
+
+      addBinding({
+        keyCodes: ['W'.charCodeAt(0), '<'.charCodeAt(0)],
+        callback: function(e) {
+          this.zoomBy_(10, true);
+          e.stopPropagation();
+        }
+      });
+
+      addBinding({
+        keyCodes: ['S'.charCodeAt(0), 'O'.charCodeAt(0)],
+        callback: function(e) {
