+protected:
+	void createTexture (void)
+	{
+		tcu::TextureFormat	fmt			= m_texFormat;
+		int					numLevels	= (m_flags & MIPMAPS) ? de::max(deLog2Floor32(m_width), deLog2Floor32(m_height))+1 : 1;
+		deUint32			tex			= 0;
+		tcu::TextureLevel	data		(fmt);
