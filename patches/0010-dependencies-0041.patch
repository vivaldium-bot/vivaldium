+	FragmentOutput (glu::DataType type_, glu::Precision precision_, int location_, int arrayLength_ = 0)
+		: type			(type_)
+		, precision		(precision_)
+		, location		(location_)
+		, arrayLength	(arrayLength_)
+	{
+	}
+
+	glu::DataType	type;
