+    if sleep is None:
+      sleep = ctx.DEFAULT_SLEEP_TIME
+
+    result = cros_build_lib.CommandResult(error='')
+    with mock.patch.object(retry_stats, 'RetryWithStats', autospec=True,
+                           return_value=result):
