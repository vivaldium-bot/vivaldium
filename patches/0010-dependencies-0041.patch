+    addHeapEntry(hd2, ['MessageLoop::RunTask', 'V8.Execute'],
+        undefined /* sum over all types */, 2621440 /* 2.5 MiB */, 199);
+    addHeapEntry(hd2, ['MessageLoop::RunTask', 'V8.Execute', 'FunctionCall'],
