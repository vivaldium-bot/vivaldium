+          },
+          {
+            icon: '\u26A0',
+            message: 'provided size was less than the aggregated size of ' +
+                'the children at some selected timestamps',
+            color: 'red'
+          }
+        ]);
+  });
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/ui/analysis/memory_dump_header_pane.html b/third_party/catapult/tracing/tracing/ui/analysis/memory_dump_header_pane.html
