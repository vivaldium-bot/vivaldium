+class RenderTestCase : public TestCase
+{
+public:
+					RenderTestCase	(Context& context, const char* name, const char* description);
+
+	virtual void	testRender		(void) = DE_NULL;
+	virtual void	init			(void) { }
+
+	IterateResult	iterate			(void);
+};
