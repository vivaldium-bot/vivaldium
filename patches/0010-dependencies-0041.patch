+static const char* commonTestVertSource		=	"void main (void)\n"
+												"{\n"
+												"	gl_Position = vec4(0.0);\n"
+												"}\n";
+static const char* commonTestFragSource		=	"void main (void)\n"
+												"{\n"
+												"	gl_FragColor = vec4(0.0);\n"
+												"}\n";
