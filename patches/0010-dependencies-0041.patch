+	}
+	if (m_verifierInteger64)
+	{
+		delete m_verifierInteger64;
+		m_verifierInteger64 = DE_NULL;
+	}
+	if (m_verifierFloat)
+	{
+		delete m_verifierFloat;
+		m_verifierFloat = DE_NULL;
+	}
+
+	this->TestCaseGroup::deinit();
+}
