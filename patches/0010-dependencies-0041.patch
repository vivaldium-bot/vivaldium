+    document.getElementById('x-drive-share').onclick = function() {
+      shareClient_.showSettingsDialog();
+    };
+
+  }());
+
+  </script>
+  <script type="text/javascript"
+          src="https://apis.google.com/js/client.js?onload=onAPIClientLoaded_">
+  </script>
