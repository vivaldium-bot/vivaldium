+		Operation (int apiIndex_, const Action& action_) : apiIndex(apiIndex_), action(&action_) {}
+		int				apiIndex;
+		const Action*	action;
+	};
+
+	vector<ApiContext>	contexts;
+	vector<Operation>	operations;
+
+};
