+#ifndef _RSGVARIABLEMANAGER_HPP
+#define _RSGVARIABLEMANAGER_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Random Shader Generator
+ * ----------------------------------------------------
