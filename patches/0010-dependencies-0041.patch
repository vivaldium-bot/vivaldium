+		, m_verifier	(verifier)
+	{
+	}
+
+	void test (void)
+	{
+		m_verifier->verifyFloatRange(m_testCtx, GL_ALIASED_POINT_SIZE_RANGE, 1, 1);
+		expectError(GL_NO_ERROR);
+	}
+private:
+	StateVerifier*	m_verifier;
+};
+
+class AliasedLineWidthRangeCase : public ApiCase
