+    // Second timestamp.
+    var gmd2 = addGlobalMemoryDump(model, 10);
+    var pmd2 = addProcessMemoryDump(gmd2, process, 11);
+    var hd2 = new HeapDump(pmd2, 'partition_alloc');
+
+    addHeapEntry(hd2, undefined /* sum over all traces */,
