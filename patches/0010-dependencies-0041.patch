+				glSampleCoverage(reference, invert);
+				m_verifier->verifyFloat(m_testCtx, GL_SAMPLE_COVERAGE_VALUE, reference);
+				expectError(GL_NO_ERROR);
+			}
+		}
+	}
+private:
+	StateVerifier*	m_verifier;
+};
