+		log << TestLog::Message << "Replacing " + std::string(getShaderTypeName(m_shaderType)) + " shader source and recompiling" << TestLog::EndMessage;
+		shaders.setSource(m_shaderType);
+		caseShader.compile();
+		DE_UNREF(program);
+	}
+};
