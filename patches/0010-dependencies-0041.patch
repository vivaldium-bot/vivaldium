+			m_log << TestLog::EndSection;
+
+			if (!m_context.getContextInfo().isExtensionSupported("GL_OES_fbo_render_mipmap"))
+			{
+				m_log << TestLog::Section("", "GL_INVALID_VALUE is generated if level is not 0.");
