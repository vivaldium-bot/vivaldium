+//GetIntegerVerifier
+
+class GetIntegerVerifier : public StateVerifier
+{
+public:
+			GetIntegerVerifier				(const glw::Functions& gl, tcu::TestLog& log);
+	void	verifyUnsignedInteger64GreaterOrEqual	(tcu::TestContext& testCtx, GLenum name, GLuint64 reference);
+};
