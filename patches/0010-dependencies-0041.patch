+		if (pointSizeRange[0] <= 0.0f || pointSizeRange[1] <= 0.0f || pointSizeRange[1] < pointSizeRange[0])
+			throw tcu::TestError("Invalid GL_ALIASED_POINT_SIZE_RANGE");
