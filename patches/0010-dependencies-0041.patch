+				TriangleSceneSpec::SceneTriangle tri;
+				tri.positions[0]	= vertices[vtxNdx + 0];
+				tri.positions[1]	= vertices[vtxNdx + 1];
+				tri.positions[2]	= vertices[vtxNdx + 2];
+				tri.sharedEdge[0]	= false;
+				tri.sharedEdge[1]	= false;
