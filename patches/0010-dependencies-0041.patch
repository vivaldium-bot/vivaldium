+															 deUint32					dataType,
+															 int						size);
+								~TextureCubeMipmapCase		(void);
+
+	void						init						(void);
+	void						deinit						(void);
+	IterateResult				iterate						(void);
+
+private:
+								TextureCubeMipmapCase		(const TextureCubeMipmapCase& other);
+	TextureCubeMipmapCase&		operator=					(const TextureCubeMipmapCase& other);
