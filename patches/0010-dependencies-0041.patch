+		m_eglTestCtx.getLibrary().terminate(m_display);
+
+	m_config		= DE_NULL;
+	m_display		= EGL_NO_DISPLAY;
+	m_context.clear();
+	m_surface.clear();
+	m_nativeWindow.clear();
+}
