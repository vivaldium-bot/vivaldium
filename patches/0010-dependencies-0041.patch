+static const char* getQueryTypeSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_BOOLEAN:	return "_getboolean";
+		case QUERY_INTEGER:	return "_getinteger";
+		case QUERY_FLOAT:	return "_getfloat";
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
+	}
+}
