+        'B': 1.0,
+        'KB': 1000.0,
+        'MB': 1000000.0,
+        'GB': 1000000000.0,
+    }
+    divisor = divisors[unit]
+    start = start / divisor
+    end = end / divisor
+    size = size / divisor
+
