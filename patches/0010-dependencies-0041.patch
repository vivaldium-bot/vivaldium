+		case EGL_OPENGL_BIT:		return 1;
+		case EGL_OPENGL_ES_BIT:		return 1;
+		case EGL_OPENGL_ES2_BIT:	return 2;
+		case EGL_OPENGL_ES3_BIT:	return 3;
+		case EGL_OPENVG_BIT:		return 1;
+		default:
