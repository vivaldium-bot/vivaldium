+	{
+		EGL_RENDERABLE_TYPE, 	EGL_OPENGL_ES2_BIT,
+		EGL_SURFACE_TYPE,	 	EGL_WINDOW_BIT,
+		EGL_ALPHA_SIZE,			1,
+		EGL_DEPTH_SIZE,			8,
+		EGL_NONE
+	};
+
+	return eglu::chooseSingleConfig(m_eglTestCtx.getLibrary(), m_display, attribList);
+}
