+	inline void			expectFalse				(eglw::EGLBoolean got) { expectBoolean(EGL_FALSE, got); }
+
+	eglw::EGLDisplay	getDisplay				(void)						{ return m_display;							}
+	bool				isAPISupported			(eglw::EGLenum api) const;
