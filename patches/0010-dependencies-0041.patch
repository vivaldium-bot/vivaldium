+    var ctl = document.createElement('tr-ui-find-control');
+    ctl.controller = {
+      findNext: function() { },
+      findPrevious: function() { },
+      reset: function() {},
+
+      filterHits: ['a', 'b'],
+
+      currentHitIndex: 0
