+
+	if (boolVector4[0] != referenceAsGLBoolean[0] ||
+		boolVector4[1] != referenceAsGLBoolean[1] ||
+		boolVector4[2] != referenceAsGLBoolean[2] ||
+		boolVector4[3] != referenceAsGLBoolean[3])
+	{
