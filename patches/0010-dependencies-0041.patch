+
+static void busyWait (int milliseconds)
+{
+	const deUint64	startTime	= deGetMicroseconds();
+	float			v			= 2.0f;
+
+	for (;;)
+	{
+		for (int i = 0; i < 10; i++)
+			v = deFloatSin(v);
+
+		if (deGetMicroseconds()-startTime >= deUint64(1000*milliseconds))
+			break;
+	}
+}
