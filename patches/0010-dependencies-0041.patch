+template<typename T>
+static inline T min4 (T a, T b, T c, T d)
+{
+	return de::min(de::min(de::min(a, b), c), d);
+}
+
+template<typename T>
+static inline T max4 (T a, T b, T c, T d)
+{
+	return de::max(de::max(de::max(a, b), c), d);
+}
