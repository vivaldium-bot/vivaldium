+	{
+		EGL_LARGEST_PBUFFER,
+		EGL_TEXTURE_FORMAT,
+		EGL_TEXTURE_TARGET,
+		EGL_MIPMAP_TEXTURE,
+		EGL_MIPMAP_LEVEL,
+	};
+
+	logSurfaceAttributes(log, egl, display, surface, attributes, DE_LENGTH_OF_ARRAY(attributes));
+}
