+    addHeapEntry(hd1,
+        ['MessageLoop::RunTask', 'V8.Execute', 'FunctionCall', '<self>'],
+        'v8::Context', 15360 /* 15 KiB */, 5);
+    addHeapEntry(hd1,
+        ['MessageLoop::RunTask', 'V8.Execute', 'FunctionCall', 'V8.Execute'],
