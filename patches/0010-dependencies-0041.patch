+void MultisampleCase::renderTriangle (const Vec2& p0, const Vec2& p1, const Vec2& p2, const Vec4& c0, const Vec4& c1, const Vec4& c2) const
+{
+	renderTriangle(Vec3(p0.x(), p0.y(), 0.0f),
