+#ifndef _RSGVARIABLETYPE_HPP
+#define _RSGVARIABLETYPE_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Random Shader Generator
+ * ----------------------------------------------------
+ *
