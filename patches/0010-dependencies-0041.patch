+void VertexArrayTests::init (void)
+{
+	tcu::TestCaseGroup* const group = new tcu::TestCaseGroup(m_testCtx, "single_attribute", "Single attribute");
+	addChild(group);
+
+	// .single_attribute
+	{
+		group->addChild(new SingleVertexArrayStrideTests(m_context));
