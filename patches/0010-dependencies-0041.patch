+                ]
+              },
+              {
+                data: 'also_visible'
+              }
+            ]
+          }
+        ]
+      },
+      {
+        data: 'no_sub_rows'
+      },
+      {
+        data: 'fragmentation',
+        subRows: [
+          {
+            data: 'internal'
+          },
+          {
+            data: 'external',
+            subRows: [
+              {
+                data: 'unexpanded'
+              }
+            ]
+          }
+        ]
+      }
