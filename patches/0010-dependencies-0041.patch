+	deUint32					m_format;
+	deUint32					m_type;
+	int							m_texSize;
+	int							m_alignment;
+
+	gls::TheilSenCalibrator		m_calibrator;
+	glu::ShaderProgram*			m_program;
+	deUint32					m_texture;
+	de::Random					m_rnd;
