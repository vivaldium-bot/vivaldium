+					 deInt64 fragmentCompileTime_,
+					 deInt64 programLinkTime_,
+					 deInt64 firstInputSetTime_,
+					 deInt64 firstDrawTime_,
+					 deInt64 secondInputSetTime_,
+					 deInt64 secondDrawTime_)
