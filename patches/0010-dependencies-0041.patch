+
+  def testSplitCSVLine(self):
+    """Test splitting of csv line."""
+    tests = {
+        'a,b,c,d':           ['a', 'b', 'c', 'd'],
+        'a, b, c, d':        ['a', ' b', ' c', ' d'],
+        'a,b,c,':            ['a', 'b', 'c', ''],
+        'a,"b c",d':         ['a', 'b c', 'd'],
+        'a,"b, c",d':        ['a', 'b, c', 'd'],
+        'a,"b, c, d",e':     ['a', 'b, c, d', 'e'],
+        'a,"""b, c""",d':    ['a', '"b, c"', 'd'],
+        'a,"""b, c"", d",e': ['a', '"b, c", d', 'e'],
