+
+void GetFloatVerifier::verifyFloatRange (tcu::TestContext& testCtx, GLenum name, GLfloat min, GLfloat max)
+{
+	using tcu::TestLog;
+
+	StateQueryMemoryWriteGuard<GLfloat[2]> floatVector2;
