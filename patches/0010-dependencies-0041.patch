+	deUint32 tex2D = 1;
+	context.bindTexture(GL_TEXTURE_2D, tex2D);
+	context.framebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex2D, 0);
+	checkError(testCtx, context, GL_INVALID_OPERATION);
