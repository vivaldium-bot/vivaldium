+	spec.indexStorage			= gls::DrawTestSpec::STORAGE_LAST;
+	spec.first					= 0;
+	spec.indexMin				= 0;
+	spec.indexMax				= 0;
+	spec.instanceCount			= 1;
+
+	spec.attribs.resize(2);
+
+	spec.attribs[0].inputType				= gls::DrawTestSpec::INPUTTYPE_FLOAT;
