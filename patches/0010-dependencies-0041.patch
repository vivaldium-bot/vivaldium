+class CreateShaderCase : public ApiCase
+{
+public:
+	CreateShaderCase (Context& context, const char* name, const char* desc, glu::ShaderType shaderType)
+		: ApiCase		(context, name, desc)
+		, m_shaderType	(shaderType)
