+
+  def testWriteReadCSV(self):
+    """Write and Read CSV and verify contents preserved."""
+    # This also tests the Table == and != operators.
+    _, path = tempfile.mkstemp(text=True)
+    tmpfile = open(path, 'w')
+    self._table.WriteCSV(tmpfile)
