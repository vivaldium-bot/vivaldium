+        onAuthApiLoad(true, onAuthResultSuccess);
+        setTimeout(function onRepeatAuthApiLoad() {
+          onAuthApiLoad(true, function() {});
+          setTimeout(onRepeatAuthApiLoad, 30000);
+        }, 30000);
