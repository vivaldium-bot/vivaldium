+def load_module(name):
+  """load a module
+
+  Args:
+    name: python dotted namespace path of the module to import
+
+  Returns:
+    imported module
+
+  Raises:
+    FailedImport if importing fails
+  """
+  m = __import__(name)
+  # __import__('foo.bar') returns foo, so...
+  for bit in name.split('.')[1:]:
+    m = getattr(m, bit)
+  return m
