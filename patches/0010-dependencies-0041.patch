+void DrawCallBatchingTest::init (void)
+{
+	createShader();
+	createAttributeDatas();
+	createArrayBuffers();
+
+	if (m_spec.useDrawElements)
+	{
+		createIndexData();
+
+		if (m_spec.useIndexBuffer)
+			createIndexBuffer();
