+
+      var min;
+      var range;
+
+      if (this.model_.bounds.isEmpty) {
+        min = 0;
+        range = 1000;
+      } else if (this.model_.bounds.range === 0) {
+        min = this.model_.bounds.min;
+        range = 1000;
+      } else {
+        min = this.model_.bounds.min;
+        range = this.model_.bounds.range;
