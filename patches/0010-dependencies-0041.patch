+
+    // Check infos.
+    var infos = [];
+    column.addInfos(fields, contexts, infos);
+    assert.lengthOf(infos, expectedInfos.length);
+    for (var i = 0; i < expectedInfos.length; i++)
+      assert.deepEqual(infos[i], expectedInfos[i]);
