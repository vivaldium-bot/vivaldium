+<script>
+'use strict';
+
+/**
+ * @fileoverview Helper code for memory dump sub-views.
+ */
+tr.exportTo('tr.ui.analysis', function() {
+
+  var NO_BREAK_SPACE = String.fromCharCode(160);
+  var RIGHTWARDS_ARROW = String.fromCharCode(8594);
+
