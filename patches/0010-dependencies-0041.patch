+#ifndef _RRFRAGMENTOPERATIONS_HPP
+#define _RRFRAGMENTOPERATIONS_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Reference Renderer
+ * -----------------------------------------------
