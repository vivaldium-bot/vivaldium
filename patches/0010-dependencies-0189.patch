index 0000000000000000000000000000000000000000..2bf34d1c545461f7d71877ddf33b74a6ec364bba
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.3/conformance/textures/texture-size-cube-maps.html
@@ -0,0 +1,354 @@
+<!--
