+          gridNormals[currentNormal++] = (x2 + 1.0) / 2.0;
+          gridNormals[currentNormal++] = (y2 + 1.0) / 2.0;
+          gridFogCoords[currentFogCoord++] = (y1 + 1.0) / 2.0;
