+      webrtc::AudioReceiveStream* receive_stream) override;
+
+  webrtc::VideoSendStream* CreateVideoSendStream(
+      const webrtc::VideoSendStream::Config& config,
+      const VideoEncoderConfig& encoder_config) override;
