+  for (size_t i = 16; i < 2 * kBlockSize; ++i) {
+    EXPECT_EQ(kRefValue32kHz2, out_vector[i]);
+    EXPECT_EQ(kRefValue16kHz2, out_vector_w16[i]);
+  }
+}
diff --git a/third_party/webrtc/common_audio/signal_processing/spl_init.c b/third_party/webrtc/common_audio/signal_processing/spl_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..c9c4e659cf3baad8a9ca0ce5d0409d9809bfae7f
--- /dev/null
+++ b/third_party/webrtc/common_audio/signal_processing/spl_init.c
@@ -0,0 +1,133 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
