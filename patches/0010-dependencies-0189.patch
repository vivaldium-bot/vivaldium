index 0000000000000000000000000000000000000000..6409fbac471cdd6064c01277f27fb6d6194f54da
--- /dev/null
+++ b/third_party/webrtc/common_audio/signal_processing/resample_fractional.c
@@ -0,0 +1,239 @@
+/*
