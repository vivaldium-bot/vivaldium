+int64_t ParsedRtcEventLog::GetTimestamp(size_t index) const {
+  RTC_CHECK_LT(index, GetNumberOfEvents());
+  const rtclog::Event& event = events_[index];
+  RTC_CHECK(event.has_timestamp_us());
+  return event.timestamp_us();
+}
