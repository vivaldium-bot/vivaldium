+          gridColors[currentColor++] = 1.0 - (x2 + y2 + 2.0) / 4.0;
+          gridColors[currentColor++] = (x2 + 1.0) / 2.0;
+          gridColors[currentColor++] = (y2 + 1.0) / 2.0;
+          gridSecColors[currentSecColor++] = 1.0 - (x1 + y1 + 2.0) / 4.0;
