+}
+</script>
+<script>
+"use strict";
+description();
+
+var tests = [
+{ type: 'float',
+  check: "return value == 0.0",
+  setFn: function(gl, loc) { gl.uniform1f(loc, 3.0); }
+},
+{ type: 'int',
+  check: "return value == 0",
+  setFn: function(gl, loc) { gl.uniform1i(loc, 3.0); }
+},
+{ type: 'bool',
+  check: "return value == false",
