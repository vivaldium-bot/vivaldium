+      deps += [ "//testing/android/native_test:native_test_support" ]
+
+      # This needs to be kept in sync with the .isolate file.
+      # TODO(kjellander); Move this to android_assets targets instead.
+      data = [
+        "//resources/foreman_cif.yuv",
+      ]
+
+      shard_timeout = 900
+    }
+  }
+}
