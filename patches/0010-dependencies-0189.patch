+#ifndef WEBRTC_CALL_RTC_EVENT_LOG_PARSER_H_
+#define WEBRTC_CALL_RTC_EVENT_LOG_PARSER_H_
+
+#include <string>
+#include <vector>
+
+#include "webrtc/call/rtc_event_log.h"
+#include "webrtc/video_receive_stream.h"
