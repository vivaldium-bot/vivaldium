diff --git a/third_party/webrtc/examples/objc/AppRTCDemo/ARDJoinResponse.m b/third_party/webrtc/examples/objc/AppRTCDemo/ARDJoinResponse.m
new file mode 100644
index 0000000000000000000000000000000000000000..87d58e0db1d6e2781b28e9051e18ab96aef6eefa
--- /dev/null
