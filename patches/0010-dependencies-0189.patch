index 0000000000000000000000000000000000000000..6e69349a72f954cffd15857055198c8a0c065ba0
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/2.0.0/conformance/context/context-attributes-alpha-depth-stencil-antialias.html
@@ -0,0 +1,354 @@
+<!--
+
+/*
+** Copyright (c) 2012 The Khronos Group Inc.
+**
+** Permission is hereby granted, free of charge, to any person obtaining a
+** copy of this software and/or associated documentation files (the
+** "Materials"), to deal in the Materials without restriction, including
+** without limitation the rights to use, copy, modify, merge, publish,
