+  var exception;
+  try {
+    eval(evalStr);
+  } catch (e) {
+    exception = e;
+  }
+  if (exception) {
+    testFailed(evalStr + " threw exception " + exception);
+    return -1;
+  } else {
+    return glErrorShouldBe(gl, glErrors, "after evaluating: " + evalStr);
+  }
+};
