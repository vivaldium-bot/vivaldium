+
+VideoEncoderConfig::VideoEncoderConfig()
+    : content_type(ContentType::kRealtimeVideo),
+      encoder_specific_settings(NULL),
+      min_transmit_bitrate_bps(0),
+      expect_encode_from_texture(false) {}
+
+VideoEncoderConfig::~VideoEncoderConfig() = default;
+
+std::string VideoEncoderConfig::ToString() const {
+  std::stringstream ss;
+
+  ss << "{streams: [";
+  for (size_t i = 0; i < streams.size(); ++i) {
+    ss << streams[i].ToString();
+    if (i != streams.size() - 1)
+      ss << ", ";
+  }
+  ss << ']';
+  ss << ", content_type: ";
+  switch (content_type) {
+    case ContentType::kRealtimeVideo:
+      ss << "kRealtimeVideo";
+      break;
+    case ContentType::kScreen:
+      ss << "kScreenshare";
+      break;
+  }
+  ss << ", encoder_specific_settings: ";
+  ss << (encoder_specific_settings != NULL ? "(ptr)" : "NULL");
+
+  ss << ", min_transmit_bitrate_bps: " << min_transmit_bitrate_bps;
+  ss << '}';
+  return ss.str();
+}
+
+}  // namespace webrtc
diff --git a/third_party/webrtc/config.h b/third_party/webrtc/config.h
new file mode 100644
index 0000000000000000000000000000000000000000..1550a9f8a13ac1b121c90b31a771eee56e12f1a6
--- /dev/null
+++ b/third_party/webrtc/config.h
@@ -0,0 +1,191 @@
+/*
