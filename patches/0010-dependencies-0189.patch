index 0000000000000000000000000000000000000000..12cdb57e4ed76c8d50f9541f6064677437b9f26f
--- /dev/null
+++ b/third_party/webrtc/examples/androidjunit/src/org/appspot/apprtc/DirectRTCClientTest.java
@@ -0,0 +1,146 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
