diff --git a/third_party/webrtc/test/testsupport/iosfileutils.mm b/third_party/webrtc/test/testsupport/iosfileutils.mm
new file mode 100644
index 0000000000000000000000000000000000000000..87b7397c7911d981c42a62a90f214f935d8a6838
--- /dev/null
