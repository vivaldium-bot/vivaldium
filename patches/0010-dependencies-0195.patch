diff --git a/third_party/webrtc/voice_engine/monitor_module.cc b/third_party/webrtc/voice_engine/monitor_module.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8a1865a95b4fc4334c020c047fda9b05d7fb03bc
--- /dev/null
