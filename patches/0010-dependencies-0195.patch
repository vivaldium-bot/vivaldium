+static bool UseSendSideBwe(const VideoReceiveStream::Config& config) {
+  if (!config.rtp.transport_cc)
+    return false;
+  for (const auto& extension : config.rtp.extensions) {
+    if (extension.uri == RtpExtension::kTransportSequenceNumberUri)
+      return true;
+  }
+  return false;
+}
