+int Channel::GetRxAgcStatus(bool& enabled, AgcModes& mode) {
+  bool enable = rx_audioproc_->gain_control()->is_enabled();
+  GainControl::Mode agcMode = rx_audioproc_->gain_control()->mode();
+
+  enabled = enable;
