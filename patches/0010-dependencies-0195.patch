+ public:
+  // Playout file locally
+
+  int StartPlayingFileLocally(int channel,
+                              const char fileNameUTF8[1024],
+                              bool loop = false,
+                              FileFormats format = kFileFormatPcm16kHzFile,
+                              float volumeScaling = 1.0,
