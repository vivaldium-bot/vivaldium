+
+# This file sets correct neon flags. Include it if you want to build
+# source with neon intrinsics.
+# To use this, create a gyp target with the following form:
+# {
+#   'target_name': 'my_lib',
+#   'type': 'static_library',
+#   'sources': [
+#     'foo.c',
+#     'bar.cc',
