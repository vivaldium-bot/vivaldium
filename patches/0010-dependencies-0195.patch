+uint32_t RtpStreamReceiver::GetRemoteSsrc() const {
+  return rtp_receiver_->SSRC();
+}
+
+int RtpStreamReceiver::GetCsrcs(uint32_t* csrcs) const {
+  return rtp_receiver_->CSRCs(csrcs);
+}
