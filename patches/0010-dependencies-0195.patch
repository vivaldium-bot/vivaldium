+uniform mat4 gtf_ModelViewMatrix;            //<  2
+uniform mat4 gtf_ModelViewProjectionMatrix;  //<  3
+uniform float myAttrib1f;                    //<  4
+uniform vec2 myAttrib2f;                     //<  5
+uniform vec3  LightPosition;                 //<  6
+uniform vec4 myAttrib4f;                     //<  7
