+  void OnReceiveRatesUpdated(uint32_t bitRate, uint32_t frameRate) override;
+  void OnFrameCountsUpdated(const FrameCounts& frame_counts) override;
+  void OnDiscardedPacketsUpdated(int discarded_packets) override;
