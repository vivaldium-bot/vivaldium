new file mode 100644
index 0000000000000000000000000000000000000000..cba1a57eb45405952968bc95bee35af23abebe52
--- /dev/null
+++ b/third_party/webrtc/test/layer_filtering_transport.cc
@@ -0,0 +1,107 @@
+/*
