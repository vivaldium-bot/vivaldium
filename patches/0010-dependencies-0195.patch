+             size_t maxLen, size_t &outLen);
+
+private:
+    enum ResamplerMode
+    {
+        kResamplerMode1To1,
+        kResamplerMode1To2,
+        kResamplerMode1To3,
+        kResamplerMode1To4,
+        kResamplerMode1To6,
+        kResamplerMode1To12,
