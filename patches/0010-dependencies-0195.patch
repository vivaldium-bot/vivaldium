index 0000000000000000000000000000000000000000..b38c515ea1229fa7fc8bebb3c9a52c3ee85ccc74
--- /dev/null
+++ b/third_party/webrtc/common_audio/vad/vad_core.h
@@ -0,0 +1,115 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
