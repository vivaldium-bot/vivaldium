+  void Reset() {
+    rtc::CritScope lock(&lock_);
+    state_ = State();
+  }
+
+  State Get() const {
+    rtc::CritScope lock(&lock_);
+    return state_;
+  }
+
+  void SetRxApmIsEnabled(bool enable) {
+    rtc::CritScope lock(&lock_);
+    state_.rx_apm_is_enabled = enable;
