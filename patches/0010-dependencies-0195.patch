+    webrtc::PrintDevices();
+  }
+  if (FLAGS_codecs) {
+    webrtc::PrintCodecs();
+  }
+  if (!FLAGS_devices && !FLAGS_codecs) {
+    webrtc::RunHarness();
+  }
+  return 0;
+}
