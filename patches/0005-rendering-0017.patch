+TEST_F(WebNodeTest, GetElementsByHTMLTagName)
+{
+    document().documentElement()->setInnerHTML("<body><LABEL></LABEL><svg xmlns='http://www.w3.org/2000/svg'><label></label></svg></body>", ASSERT_NO_EXCEPTION);
