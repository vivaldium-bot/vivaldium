+TEST(TransformOperationsTest, EmpiricalAnimatedScaleBoundsTest)
+{
+
+    float testTransforms[][2][3] = {
+        { { 1, 1, 1 }, { 10, 10, -32}},
+        { { 1, 2, 5 }, { -1, -2, -4}},
