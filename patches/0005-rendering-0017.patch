+    if (v8Object.IsEmpty())
+        return false;
+    Node* native = V8Node::hasInstance(v8Object, isolate) ? V8Node::toImpl(v8Object) : 0;
+    if (!native)
+        return false;
+
+    *webNode = WebNode(native);
