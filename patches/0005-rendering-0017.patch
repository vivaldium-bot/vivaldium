+bool WebPluginContainerImpl::executeEditCommand(const WebString& name)
+{
+    if (m_webPlugin->executeEditCommand(name))
+        return true;
+
+    if (name != "Copy")
+        return false;
+
+    copy();
+    return true;
+}
