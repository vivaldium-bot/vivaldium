+
+void WebKeyboardEvent::setKeyIdentifierFromWindowsKeyCode()
+{
+#if defined(VIVALDI_PATCH_VB2300)
+    int key_code = toupper(windowsKeyCode);
+    const char* id = staticKeyIdentifiers(key_code);
+#else
+    const char* id = staticKeyIdentifiers(windowsKeyCode);
+#endif
+    if (id) {
+        strncpy(keyIdentifier, id, sizeof(keyIdentifier) - 1);
+        keyIdentifier[sizeof(keyIdentifier) - 1] = '\0';
+    } else
+#if defined(VIVALDI_PATCH_VB2300)
+        // NOTE(daniel@vivaldi): Do nothing if slready set
+        using namespace std;
+        if(strlen(keyIdentifier) && strcmp(keyIdentifier, "U+0000") != 0) {
+		    return;
+        }
+        snprintf(keyIdentifier, sizeof(keyIdentifier), "U+%04X", key_code);
+#else
+        snprintf(keyIdentifier, sizeof(keyIdentifier), "U+%04X", toupper(windowsKeyCode));
+#endif
+}
+
+// static
+int WebKeyboardEvent::windowsKeyCodeWithoutLocation(int keycode)
+{
+    switch (keycode) {
+    case VK_LCONTROL:
+    case VK_RCONTROL:
+        return VK_CONTROL;
+    case VK_LSHIFT:
+    case VK_RSHIFT:
+        return VK_SHIFT;
+    case VK_LMENU:
+    case VK_RMENU:
+        return VK_MENU;
+    default:
+        return keycode;
+    }
+}
+
+// static
+int WebKeyboardEvent::locationModifiersFromWindowsKeyCode(int keycode)
+{
+    switch (keycode) {
+    case VK_LCONTROL:
+    case VK_LSHIFT:
+    case VK_LMENU:
+    case VK_LWIN:
+        return IsLeft;
+    case VK_RCONTROL:
+    case VK_RSHIFT:
+    case VK_RMENU:
+    case VK_RWIN:
+        return IsRight;
+    default:
+        return 0;
+    }
+}
