+}
+
+void PluginPlaceholderImpl::update()
+{
+    m_placeholderElement->setMessage(m_webPluginPlaceholder->message());
+    m_placeholderElement->setIsCloseable(m_webPluginPlaceholder->isCloseable());
+}
