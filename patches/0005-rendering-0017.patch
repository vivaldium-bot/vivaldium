+bool JPEGImageEncoder::encode(const SkBitmap& bitmap, int quality, Vector<unsigned char>* output)
+{
+    SkAutoLockPixels bitmapLock(bitmap);
+
+    if (bitmap.colorType() != kN32_SkColorType || !bitmap.getPixels())
