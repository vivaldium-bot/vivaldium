+    , m_isMultipartPayload(false)
+    , m_wasFetchedViaSPDY(false)
+    , m_wasNpnNegotiated(false)
+    , m_wasAlternateProtocolAvailable(false)
+    , m_wasFetchedViaProxy(false)
+    , m_wasFetchedViaServiceWorker(false)
