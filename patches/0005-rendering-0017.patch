--- /dev/null
+++ b/third_party/WebKit/Source/platform/text/TextRun.h
@@ -0,0 +1,289 @@
+/*
+ * Copyright (C) 2000 Lars Knoll (knoll@kde.org)
+ *           (C) 2000 Antti Koivisto (koivisto@kde.org)
