+    bool containsNoCache : 1;
+    bool containsNoStore : 1;
+    bool containsMustRevalidate : 1;
+    double maxAge;
+    double staleWhileRevalidate;
+
+    CacheControlHeader()
+        : parsed(false)
+        , containsNoCache(false)
+        , containsNoStore(false)
+        , containsMustRevalidate(false)
+        , maxAge(0.0)
+        , staleWhileRevalidate(0.0)
+    {
+    }
+};
