+bool isDefaultPortForProtocol(unsigned short port, const String& protocol)
+{
+    if (protocol.isEmpty())
+        return false;
+
+    switch (port) {
+    case 80:
+        return protocol == "http";
+    case 443:
+        return protocol == "https";
+    case 21:
+        return protocol == "ftp";
+    case 990:
+        return protocol == "ftps";
+    }
+    return false;
+}
+
