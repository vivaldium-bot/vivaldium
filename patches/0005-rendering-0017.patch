+    return toHTMLInputElement(m_private.get());
+}
+
+WebInputElement* toWebInputElement(WebElement* webElement)
+{
+    if (!isHTMLInputElement(*webElement->unwrap<Element>()))
+        return 0;
+
+    return static_cast<WebInputElement*>(webElement);
+}
+} // namespace blink
