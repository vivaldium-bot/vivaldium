+
+PassOwnPtrWillBeRawPtr<InspectorRenderingAgent> InspectorRenderingAgent::create(WebViewImpl* webViewImpl)
+{
+    return adoptPtrWillBeNoop(new InspectorRenderingAgent(webViewImpl));
+}
