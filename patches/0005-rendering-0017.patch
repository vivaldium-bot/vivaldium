+static void assertProtocolIsGood(const char* protocol)
+{
+#if ENABLE(ASSERT)
+    const char* p = protocol;
+    while (*p) {
+        ASSERT(*p > ' ' && *p < 0x7F && !(*p >= 'A' && *p <= 'Z'));
+        ++p;
+    }
+#endif
