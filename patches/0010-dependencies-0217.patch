+int AudioDeviceWindowsCore::SetVtI4Property(IPropertyStore* ptrPS,
+                                            REFPROPERTYKEY key,
+                                            LONG value)
+{
+    PROPVARIANT pv;
+    PropVariantInit(&pv);
+    pv.vt = VT_I4;
