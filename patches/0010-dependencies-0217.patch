diff --git a/third_party/webrtc/rtc_tools/network_tester/test_controller.cc b/third_party/webrtc/rtc_tools/network_tester/test_controller.cc
new file mode 100644
index 0000000000000000000000000000000000000000..908e6954ceddb1d51886bf99d85986d7c0e59b2c
