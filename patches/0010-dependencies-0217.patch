+
+  bool _playing;
+  bool _recording;
+  int64_t _lastCallPlayoutMillis;
+  int64_t _lastCallRecordMillis;
+
+  FileWrapper& _outputFile;
+  FileWrapper& _inputFile;
+  std::string _outputFilename;
+  std::string _inputFilename;
+};
