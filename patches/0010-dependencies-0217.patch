+# grave/acute accent (by libiconv), and the double quotation marks are
+# transliterated to 0x22.
+# When output to an ASCII terminal, the single quotation marks are
+# transliterated to apostrophes, and the double quotation marks are
+# transliterated to 0x22.
+#
diff --git a/third_party/yasm/source/patched-yasm/po/insert-header.sin b/third_party/yasm/source/patched-yasm/po/insert-header.sin
new file mode 100644
index 0000000000000000000000000000000000000000..b26de01f6c88c7b15bb4815a8fcd5120d479300d
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/po/insert-header.sin
@@ -0,0 +1,23 @@
+# Sed script that inserts the file called HEADER before the header entry.
+#
+# At each occurrence of a line starting with "msgid ", we execute the following
+# commands. At the first occurrence, insert the file. At the following
+# occurrences, do nothing. The distinction between the first and the following
+# occurrences is achieved by looking at the hold space.
+/^msgid /{
+x
+# Test if the hold space is empty.
+s/m/m/
+ta
+# Yes it was empty. First occurrence. Read the file.
+r HEADER
+# Output the file's contents by reading the next line. But don't lose the
+# current line while doing this.
+g
+N
+bb
+:a
+# The hold space was nonempty. Following occurrences. Do nothing.
+x
+:b
+}
diff --git a/third_party/yasm/source/patched-yasm/po/quot.sed b/third_party/yasm/source/patched-yasm/po/quot.sed
new file mode 100644
index 0000000000000000000000000000000000000000..0122c46318dc8bc115167fa2c259f8456668f861
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/po/quot.sed
@@ -0,0 +1,6 @@
+s/"\([^"]*\)"/“\1”/g
+s/`\([^`']*\)'/‘\1’/g
+s/ '\([^`']*\)' / ‘\1’ /g
+s/ '\([^`']*\)'$/ ‘\1’/g
+s/^'\([^`']*\)' /‘\1’ /g
+s/“”/""/g
diff --git a/third_party/yasm/source/patched-yasm/po/remove-potcdate.sin b/third_party/yasm/source/patched-yasm/po/remove-potcdate.sin
new file mode 100644
index 0000000000000000000000000000000000000000..2436c49e786dea6c9b4a8f87803288496ed38164
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/po/remove-potcdate.sin
@@ -0,0 +1,19 @@
+# Sed script that remove the POT-Creation-Date line in the header entry
+# from a POT file.
+#
+# The distinction between the first and the following occurrences of the
+# pattern is achieved by looking at the hold space.
+/^"POT-Creation-Date: .*"$/{
+x
+# Test if the hold space is empty.
+s/P/P/
+ta
+# Yes it was empty. First occurrence. Remove the line.
+g
+d
+bb
+:a
+# The hold space was nonempty. Following occurrences. Do nothing.
+x
+:b
+}
