+AudioDeviceLinuxALSA::~AudioDeviceLinuxALSA()
+{
+    LOG(LS_INFO) << __FUNCTION__ << " destroyed";
+
+    Terminate();
+
+    // Clean up the recording buffer and playout buffer.
+    if (_recordingBuffer)
+    {
