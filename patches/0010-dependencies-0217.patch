index 0000000000000000000000000000000000000000..c3cfa766cdac45f13de9522d6cfe356ef8bac05a
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/tools/genperf/genperf.c
@@ -0,0 +1,540 @@
