+  uint16_t delay(0);
+
+  if (_ptrAudioDevice->PlayoutDelay(delay) == -1) {
+    LOG(LERROR) << "failed to retrieve the playout delay";
+    return -1;
+  }
+
+  *delayMS = delay;
+  return (0);
+}
