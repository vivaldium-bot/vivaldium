+#define ISAC_DISALLOWED_BANDWIDTH_MODE_DECODER      6750
+#define ISAC_DISALLOWED_LPC_MODEL                   6760
+/* 6800 Call setup formats */
+#define ISAC_INCOMPATIBLE_FORMATS     6810
