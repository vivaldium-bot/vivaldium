+      virtual_payload_length_bytes_(0),
+      time_ms_(time_ms) {
+  std::unique_ptr<RtpHeaderParser> parser(RtpHeaderParser::Create());
+  valid_header_ = ParseHeader(*parser);
+}
+
+Packet::Packet(uint8_t* packet_memory,
