+int32_t AudioDeviceIOS::StopRecording() {
+  LOGI() << "StopRecording";
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  if (!audio_is_initialized_ || !recording_) {
+    return 0;
+  }
+  if (!playing_) {
+    ShutdownPlayOrRecord();
+    audio_is_initialized_ = false;
+  }
+  rtc::AtomicOps::ReleaseStore(&recording_, 0);
+  return 0;
+}
