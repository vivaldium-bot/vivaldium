diff --git a/third_party/webrtc/call/rtp_transport_controller_send_interface.h b/third_party/webrtc/call/rtp_transport_controller_send_interface.h
new file mode 100644
index 0000000000000000000000000000000000000000..b58042197ebea8ad0184a53ece0a5d61477527d4
