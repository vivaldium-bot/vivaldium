+      : AudioProcessingImpl(config) {}
+
+  MOCK_METHOD0(InitializeLocked, int());
+  int RealInitializeLocked() NO_THREAD_SAFETY_ANALYSIS {
+    return AudioProcessingImpl::InitializeLocked();
+  }
