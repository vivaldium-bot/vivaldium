+                        "`%%%smacro': already defining a macro",
+                        (i == PP_IMACRO ? "i" : ""));
+            tline = tline->next;
+            skip_white_(tline);
+            tline = expand_id(tline);
+            if (!tok_type_(tline, TOK_ID))
+            {
+                error(ERR_NONFATAL,
+                        "`%%%smacro' expects a macro name",
+                        (i == PP_IMACRO ? "i" : ""));
+                return DIRECTIVE_FOUND;
+            }
