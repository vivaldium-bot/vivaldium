index 0000000000000000000000000000000000000000..a81814d3e316177100463b8c3d0d6123c9d807b0
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/isac/fix/source/lpc_masking_model_unittest.cc
@@ -0,0 +1,61 @@
+/*
