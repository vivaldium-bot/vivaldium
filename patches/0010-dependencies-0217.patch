+  float dc_level_[2];
+  float dc_forgetting_factor_;
+  float last_gain_;
+  bool gain_jumpstart_ = false;
+  AudioProcessing::Config::LevelController config_;
+
+  RTC_DISALLOW_COPY_AND_ASSIGN(LevelController);
