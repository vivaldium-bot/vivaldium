+
+JNI_FUNCTION_DECLARATION(void,
+                         JniCommon_nativeAddRef,
+                         JNIEnv* jni,
+                         jclass,
+                         jlong j_native_ref_counted_pointer) {
+  reinterpret_cast<rtc::RefCountInterface*>(j_native_ref_counted_pointer)
