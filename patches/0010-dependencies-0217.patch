diff --git a/third_party/webrtc/api/ortc/rtptransportinterface.h b/third_party/webrtc/api/ortc/rtptransportinterface.h
new file mode 100644
index 0000000000000000000000000000000000000000..165daada6bc59bab1daccce89235e7207dc78f91
--- /dev/null
+++ b/third_party/webrtc/api/ortc/rtptransportinterface.h
@@ -0,0 +1,123 @@
+/*
