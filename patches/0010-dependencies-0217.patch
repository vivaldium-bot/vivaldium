+class SuppressionFilter {
+ public:
+  explicit SuppressionFilter(int sample_rate_hz);
+  ~SuppressionFilter();
+  void ApplyGain(const FftData& comfort_noise,
+                 const FftData& comfort_noise_high_bands,
