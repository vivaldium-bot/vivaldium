diff --git a/third_party/webrtc/sdk/objc/Framework/Classes/Common/RTCUIApplicationStatusObserver.m b/third_party/webrtc/sdk/objc/Framework/Classes/Common/RTCUIApplicationStatusObserver.m
new file mode 100644
