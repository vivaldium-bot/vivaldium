+        self._pyxstr( toks, indent, cprefix, use_cdef, shadow_name, **kw )
+
+        #print self.deepstr()
+        if self.name and not names.has_key( self.name ):
+            names[ self.name ] = self
+        if not (self.tagged and self.name == self.tagged.tag.name):
