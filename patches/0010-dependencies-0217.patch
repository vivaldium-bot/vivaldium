+Action *
+Action_new_Accept(State *x, unsigned int n, unsigned int *s, State **r)
+{
+    Action *a = malloc(sizeof(Action));
+    a->type = ACCEPTACT;
+    a->state = x;
+    a->d.Accept.nRules = n;
+    a->d.Accept.saves = s;
+    a->d.Accept.rules = r;
+    x->action = a;
+    return a;
+}
