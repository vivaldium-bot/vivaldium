diff --git a/third_party/webrtc/api/audio_codecs/audio_decoder_factory_template.h b/third_party/webrtc/api/audio_codecs/audio_decoder_factory_template.h
new file mode 100644
index 0000000000000000000000000000000000000000..422a514b8a8af2a304284883ed16dbd071d430b7
--- /dev/null
+++ b/third_party/webrtc/api/audio_codecs/audio_decoder_factory_template.h
@@ -0,0 +1,124 @@
+/*
