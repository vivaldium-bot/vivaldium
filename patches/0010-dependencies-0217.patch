+  ASSERT_NEAR(window[0], 0.0f, 1e-6f);
+  ASSERT_NEAR(window[1], 1.0f, 1e-6f);
+  ASSERT_NEAR(window[2], 0.0f, 1e-6f);
+  ASSERT_NEAR(window[3], 0.0f, 1e-6f);
+  ASSERT_NEAR(window[4], 0.0f, 1e-6f);
+  ASSERT_NEAR(window[5], 0.0f, 1e-6f);
