+  int         LPCindex_s[108*2]; /* KLT_ORDER_SHAPE = 108 */
+  int         LPCindex_g[12*2];  /* KLT_ORDER_GAIN = 12 */
+  double      LPCcoeffs_lo[(ORDERLO+1)*SUBFRAMES*2];
+  double      LPCcoeffs_hi[(ORDERHI+1)*SUBFRAMES*2];
+
