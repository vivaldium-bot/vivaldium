+class StructDeclarator(Declarator):
+  """
+  """
+  def parse(self,lexer,symbols):
+    if lexer.tok != ':':
+      Declarator.parse(self,lexer,symbols)
+    if lexer.tok == ':':
+      lexer.get_token()
+      # ConstantExpr
+      length = int(lexer.tok)
+      #print "length = ",length
+      self.append( FieldLength(length) )
+      lexer.get_token()
