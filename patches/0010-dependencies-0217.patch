+
+    int errVal =
+        LATE(snd_mixer_selem_get_capture_volume_range)(_inputMixerElement,
+                                                       &minVol, &maxVol);
+
+    WEBRTC_TRACE(kTraceInfo, kTraceAudioDevice, _id,
