index 0000000000000000000000000000000000000000..c14986dc3934824459e01a554412ef4acfdafd18
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/neteq/red_payload_splitter.cc
@@ -0,0 +1,162 @@
+/*
