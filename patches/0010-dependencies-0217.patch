+    ]
+
+    deps = [
+      ":NetworkTesterMobile_resources",
+      "../../rtc_base:base_java",
+    ]
+  }
+
+  android_resources("NetworkTesterMobile_resources") {
+    testonly = true
+    resource_dirs = [ "androidapp/res" ]
+    custom_package = "com.google.media.networktester"
+  }
+
+  rtc_shared_library("network_tester_so") {
+    sources = [
+      "jni.cpp",
+    ]
+
+    deps = [
+      ":network_tester",
