+  int32_t _record_index;
+  AudioDeviceModule::BufferType _playBufType;
+  AudioDeviceBuffer* _ptrAudioBuffer;
+  int8_t* _recordingBuffer;  // In bytes.
+  int8_t* _playoutBuffer;  // In bytes.
