+// ----------------------------------------------------------------------------
+//  ~AudioDeviceModuleImpl - dtor
+// ----------------------------------------------------------------------------
+
+AudioDeviceModuleImpl::~AudioDeviceModuleImpl() {
+  LOG(INFO) << __FUNCTION__;
+  if (_ptrAudioDevice) {
+    delete _ptrAudioDevice;
+    _ptrAudioDevice = NULL;
+  }
+}
