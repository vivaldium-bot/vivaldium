+int32_t AudioMixerManagerLinuxALSA::MicrophoneVolumeStepSize(
+    uint16_t& stepSize) const
+{
+
+    if (_inputMixerHandle == NULL)
+    {
+        WEBRTC_TRACE(kTraceWarning, kTraceAudioDevice, _id,
