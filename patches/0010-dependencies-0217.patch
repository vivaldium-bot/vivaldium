+                    free_tlist(origline);
+                    return DIRECTIVE_FOUND;
+                }
+                tline = tline->next;
+                if (!tline || tline->type != TOK_ID)
+                {
+                    error(ERR_NONFATAL,
+                            "`%%arg' missing size type parameter");
+                    free_tlist(origline);
+                    return DIRECTIVE_FOUND;
+                }
