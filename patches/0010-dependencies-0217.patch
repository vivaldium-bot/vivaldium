+// VP9 specific.
+struct VideoCodecVP9 {
+  VideoCodecComplexity complexity;
+  bool resilienceOn;
+  unsigned char numberOfTemporalLayers;
+  bool denoisingOn;
+  bool frameDroppingOn;
+  int keyFrameInterval;
+  bool adaptiveQpMode;
+  bool automaticResizeOn;
