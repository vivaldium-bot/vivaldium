+                                            record_frames_per_10ms_buffer(),
+                                            kBytesPerSample,
+                                            record_channels(),
+                                            record_sample_rate(),
+                                            total_delay_ms(),
+                                            0,
+                                            0,
+                                            false,
+                                            _))
