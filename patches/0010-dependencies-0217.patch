+            }
+            free_tlist(origline);
+            break;
+
+        case PP_IF:
+        case PP_IFCTX:
+        case PP_IFDEF:
+        case PP_IFID:
+        case PP_IFIDN:
+        case PP_IFIDNI:
+        case PP_IFMACRO:
+        case PP_IFNCTX:
+        case PP_IFNDEF:
+        case PP_IFNID:
+        case PP_IFNIDN:
+        case PP_IFNIDNI:
+        case PP_IFNMACRO:
+        case PP_IFNNUM:
+        case PP_IFNSTR:
+        case PP_IFNUM:
