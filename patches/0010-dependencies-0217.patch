+class ShortTimestampJumpTest : public LargeTimestampJumpTest {
+ protected:
+  void UpdateState(AudioFrame::SpeechType output_type) override {
+    switch (test_state_) {
+      case kInitialPhase: {
+        if (output_type == AudioFrame::kNormalSpeech) {
+          test_state_ = kNormalPhase;
+        }
+        break;
+      }
+      case kNormalPhase: {
