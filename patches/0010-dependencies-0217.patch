+                tline = tline->next;
+                if (tline && tline->type == TOK_WHITESPACE)
+                    tline = tline->next;
+                if (!tline || tline->type != TOK_ID)
+                {
+                    error(ERR_NONFATAL, "`%%arg' missing argument parameter");
+                    free_tlist(origline);
+                    return DIRECTIVE_FOUND;
