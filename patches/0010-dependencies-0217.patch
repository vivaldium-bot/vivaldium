diff --git a/third_party/webrtc/call/audio_receive_stream.h b/third_party/webrtc/call/audio_receive_stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..fdf1698b6b7935171886dd712a449d8f329375b5
--- /dev/null
+++ b/third_party/webrtc/call/audio_receive_stream.h
@@ -0,0 +1,157 @@
+/*
+ *  Copyright (c) 2015 The WebRTC project authors. All Rights Reserved.
+ *
