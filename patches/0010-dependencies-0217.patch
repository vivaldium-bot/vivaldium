diff --git a/third_party/webrtc/modules/audio_device/audio_device_data_observer.cc b/third_party/webrtc/modules/audio_device/audio_device_data_observer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..08ca1693b2f2a1aa5581670a91ccf366db2302f7
