+
+  /* Returns the new SNR value (input argument: bottle_neck) */
+  double WebRtcIsac_GetSnr(
+      double bottle_neck,
+      int    new_framelength);
+
+
+  int16_t WebRtcIsac_UpdateUplinkJitter(
+      BwEstimatorstr*              bwest_str,
+      int32_t                  index);
+
+#if defined(__cplusplus)
+}
+#endif
