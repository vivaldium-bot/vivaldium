index 0000000000000000000000000000000000000000..dc12a5a7c43ff186a0090767b1d156577842da89
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/window32_w32.c
@@ -0,0 +1,62 @@
+/*
