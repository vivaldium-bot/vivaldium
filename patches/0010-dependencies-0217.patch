+bool APITest::PullAudioRunA() {
+  _pullEventA->Wait(100);
+  AudioFrame audioFrame;
+  bool muted;
+  if (_acmA->PlayoutData10Ms(_outFreqHzA, &audioFrame, &muted) < 0) {
+    bool thereIsDecoder;
+    {
+      ReadLockScoped rl(_apiTestRWLock);
+      thereIsDecoder = _thereIsDecoderA;
