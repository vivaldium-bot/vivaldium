+bool APITest::APIRunA() {
+  _apiEventA->Wait(50);
+
+  bool randomTest;
+  {
+    ReadLockScoped rl(_apiTestRWLock);
+    randomTest = _randomTest;
+  }
+  if (randomTest) {
+    RunTest('A');
+  } else {
+    CurrentCodec('A');
+    ChangeCodec('A');
+    if (_codecCntrA == 0) {
+      fprintf(stdout, "\nTesting Delay ...\n");
+      TestDelay('A');
+    }
+    // VAD TEST
+    TestSendVAD('A');
+    TestRegisteration('A');
+  }
+  return true;
+}
