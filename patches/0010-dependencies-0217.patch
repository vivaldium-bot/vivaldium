+// Unregister a codec & register again.
+void APITest::TestRegisteration(char sendSide) {
+  AudioCodingModule* sendACM;
+  AudioCodingModule* receiveACM;
+  bool* thereIsDecoder;
+  EventWrapper* myEvent = EventWrapper::Create();
