+#else
+    requirements_satisfied_ = false;
+#endif
+    if (requirements_satisfied_) {
+      EXPECT_EQ(0, audio_device_->SetPlayoutDevice(0));
+      EXPECT_EQ(0, audio_device_->InitSpeaker());
