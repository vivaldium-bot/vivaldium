+H	= [a-fA-F0-9];
+E	= [Ee] [+-]? D+;
+FS	= [fFlL];
+IS	= [uUlL]*;
+ESC	= [\\] ([abfnrtv?'"\\] | "x" H+ | O+);
+*/
+
+/*!re2c
+	"/*"			{ goto comment; }
+	
+	"auto"			{ RET(AUTO); }
+	"break"			{ RET(BREAK); }
+	"case"			{ RET(CASE); }
+	"char"			{ RET(CHAR); }
