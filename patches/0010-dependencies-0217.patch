+
+    if(n == 1) {
+	fputs("\tif(YYLIMIT == YYCURSOR) YYFILL(1);\n", o); oline++;
+    } else {
+	fprintf(o, "\tif((YYLIMIT - YYCURSOR) < %u) YYFILL(%u);\n", n, n);
+	oline++;
+    }
+
+    if (hasFillIndex) {
+	fprintf(o, "yyFillLabel%u:\n", fillIndex);
+	++oline;
+    }
+
+    fputs("\tyych = *YYCURSOR;\n", o); oline++;
