+  V8_INLINE Isolate* GetIsolate() const { return isolate_; }
+  V8_INLINE P* GetParameter() const { return parameter_; }
+  V8_INLINE Local<T> GetValue() const { return handle_; }
+
+ private:
+  Isolate* isolate_;
+  P* parameter_;
+  Local<T> handle_;
