+  // Bfm aliases.
+  // Bitfield insert.
+  void bfi(const Register& rd, const Register& rn, int lsb, int width) {
+    DCHECK(width >= 1);
+    DCHECK(lsb + width <= rn.SizeInBits());
+    bfm(rd, rn, (rd.SizeInBits() - lsb) & (rd.SizeInBits() - 1), width - 1);
