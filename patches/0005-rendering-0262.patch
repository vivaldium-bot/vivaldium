+
+void Simulator::VisitLogicalImmediate(Instruction* instr) {
+  if (instr->SixtyFourBits()) {
+    LogicalHelper<int64_t>(instr, instr->ImmLogical());
+  } else {
+    LogicalHelper<int32_t>(instr, static_cast<int32_t>(instr->ImmLogical()));
+  }
+}
