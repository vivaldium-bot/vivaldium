+    return feedback_vector_;
+  }
+  void SetCode(Handle<Code> code) { code_ = code; }
+
+  void SetBytecodeArray(Handle<BytecodeArray> bytecode_array) {
+    bytecode_array_ = bytecode_array;
+  }
