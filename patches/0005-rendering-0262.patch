+
+bool InstructionSelector::IsUsed(Node* node) const {
+  DCHECK_NOT_NULL(node);
+  if (!node->op()->HasProperty(Operator::kEliminatable)) return true;
+  size_t const id = node->id();
+  DCHECK_LT(id, used_.size());
+  return used_[id];
+}
