+void Accessors::FunctionArgumentsSetter(
+    v8::Local<v8::Name> name,
+    v8::Local<v8::Value> val,
+    const v8::PropertyCallbackInfo<void>& info) {
+  // Function arguments is non writable, non configurable.
+  UNREACHABLE();
+}
