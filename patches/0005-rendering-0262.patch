diff --git a/v8/src/ast/ast-literal-reindexer.cc b/v8/src/ast/ast-literal-reindexer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..fce33e70b8f7caf9aec7a25aaf3fe1ebfa00344e
--- /dev/null
