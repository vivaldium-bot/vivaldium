+  Isolate* isolate_;
+  Graph* graph_;
+  Schedule* schedule_;
+  MachineOperatorBuilder machine_;
+  CommonOperatorBuilder common_;
+  CallDescriptor* call_descriptor_;
+  NodeVector parameters_;
+  BasicBlock* current_block_;
+
+  DISALLOW_COPY_AND_ASSIGN(RawMachineAssembler);
+};
