+#define DEF_ENUM_C(name, ignore) FUNCTION_ADDR(Builtin_##name),
+Address const Builtins::c_functions_[cfunction_count] = {
+  BUILTIN_LIST_C(DEF_ENUM_C)
+};
+#undef DEF_ENUM_C
