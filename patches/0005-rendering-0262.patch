+
+static void Generate_InterpreterPushArgs(MacroAssembler* masm, Register index,
+                                         Register limit, Register scratch) {
+  Label loop_header, loop_check;
+  __ b(al, &loop_check);
+  __ bind(&loop_header);
+  __ ldr(scratch, MemOperand(index, -kPointerSize, PostIndex));
+  __ push(scratch);
+  __ bind(&loop_check);
+  __ cmp(index, limit);
+  __ b(gt, &loop_header);
+}
