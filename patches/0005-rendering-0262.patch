+void PrettyPrinter::VisitBlock(Block* node) {
+  if (!node->ignore_completion_value()) Print("{ ");
+  PrintStatements(node->statements());
+  if (node->statements()->length() > 0) Print(" ");
+  if (!node->ignore_completion_value()) Print("}");
+}
