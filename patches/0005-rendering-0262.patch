+CallPrinter::CallPrinter(Isolate* isolate, bool is_builtin) {
+  output_ = NULL;
+  size_ = 0;
+  pos_ = 0;
+  position_ = 0;
+  found_ = false;
+  done_ = false;
+  is_builtin_ = is_builtin;
+  InitializeAstVisitor(isolate);
+}
