+  explicit BootstrapperActive(Bootstrapper* bootstrapper)
+      : bootstrapper_(bootstrapper) {
+    ++bootstrapper_->nesting_;
+  }
+
+  ~BootstrapperActive() {
+    --bootstrapper_->nesting_;
+  }
