+                                Heap::RootListIndex* index_return);
+
+  // Assemble code for the specified instruction.
+  void AssembleInstruction(Instruction* instr);
+  void AssembleSourcePosition(Instruction* instr);
+  void AssembleGaps(Instruction* instr);
+
+  // ===========================================================================
