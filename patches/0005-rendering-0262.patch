+
+void PrettyPrinter::VisitReturnStatement(ReturnStatement* node) {
+  Print("return ");
+  Visit(node->expression());
+  Print(";");
+}
+
+
+void PrettyPrinter::VisitWithStatement(WithStatement* node) {
+  Print("with (");
+  Visit(node->expression());
+  Print(") ");
