+
+void MacroAssembler::Jump(intptr_t target, RelocInfo::Mode rmode,
+                          Condition cond) {
+  if (cond == nv) return;
+  UseScratchRegisterScope temps(this);
+  Register temp = temps.AcquireX();
+  Label done;
+  if (cond != al) B(NegateCondition(cond), &done);
+  Mov(temp, Operand(target, rmode));
+  Br(temp);
+  Bind(&done);
+}
