+
+void GraphC1Visualizer::PrintType(Node* node) {
+  if (NodeProperties::IsTyped(node)) {
+    Type* type = NodeProperties::GetType(node);
+    os_ << " type:";
+    type->PrintTo(os_);
+  }
+}
