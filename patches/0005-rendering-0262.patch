-      <text font-family="Arial" fill="red" font-size="40"  x="3" y="100">keyTimes="0;.2;.6;.8"</text>
-      <g xml:space="preserve" font-family="Arial" font-size="13.5" stroke-width="3" >
-         <g transform="translate(150,140)">
