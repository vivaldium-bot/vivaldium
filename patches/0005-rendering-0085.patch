-      "transport",
-      "candidate-pair",
-      "local-candidate",
-      "remote-candidate",
-      "certificate"
-    };
- */
-const statsValidatorTable = {
-  'codec': validateCodecStats,
-  'inbound-rtp': validateInboundRtpStreamStats,
-  'outbound-rtp': validateOutboundRtpStreamStats,
