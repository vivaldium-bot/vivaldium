-        ('destination-in',   '0',    'aA'),
-        ('source-out',       '1-aB', '0'),
-        ('destination-out',  '0',    '1-aA'),
-        ('source-atop',      'aB',   '1-aA'),
-        ('destination-atop', '1-aB', 'aA'),
-        ('xor',              '1-aB', '1-aA'),
-        ('copy',             '1',    '0'),
-        ('lighter',          '1',    '1'),
-    ]
