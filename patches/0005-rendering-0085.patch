-    ctx.fillRect(0, 0, 100, 50);
-    ctx.shadowColor = 'rgba(255, 0, 0, 0.01)';
-    ctx.shadowOffsetY = 50;
-    ctx.fillRect(0, -50, 100, 50);
-    @assert pixel 50,25 ==~ 0,255,0,255 +/- 4;
