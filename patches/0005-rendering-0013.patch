+
+static bool hadException(ExceptionState& exceptionState, ErrorString* errorString)
+{
+    if (!exceptionState.hadException())
+        return false;
+
+    switch (exceptionState.code()) {
+    case SecurityError:
+        *errorString = "Security error";
+        return true;
+    default:
+        *errorString = "Unknown DOM storage error";
+        return true;
+    }
+}
