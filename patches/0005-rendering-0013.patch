+NotificationPermissionClient* NotificationPermissionClient::from(ExecutionContext* context)
+{
+    if (!context->isDocument())
+        return 0;
+
+    const Document* document = toDocument(context);
+    if (!document->frame() || !document->frame()->isLocalFrame())
+        return 0;
