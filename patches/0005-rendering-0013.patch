+namespace blink {
+
+PresentationController::PresentationController(LocalFrame& frame, WebPresentationClient* client)
+    : LocalFrameLifecycleObserver(&frame)
+    , m_client(client)
+{
+    if (m_client)
+        m_client->setController(this);
