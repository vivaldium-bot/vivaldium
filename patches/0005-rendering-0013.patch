+public:
+    static MediaDevices* create()
+    {
+        return new MediaDevices();
+    }
+
+    ScriptPromise enumerateDevices(ScriptState*);
+    ScriptPromise getUserMedia(ScriptState*, const Dictionary&, ExceptionState&);
+    DEFINE_INLINE_TRACE() { }
+
+private:
+    MediaDevices() { }
+};
+
+} // namespace blink
+
