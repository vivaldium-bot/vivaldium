+        'action': 'add_buglabel_pattern',
+        'buglabel_to_add': 'Performance-1',
+        'pattern': '*/*/Suite1/*',
+        'xsrf_token': xsrf.GenerateToken(users.get_current_user()),
+    })
+
+    # The list of patterns should now contain the pattern that was added.
+    self.assertEqual(
