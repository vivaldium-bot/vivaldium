index 0000000000000000000000000000000000000000..bba4a75c06738758198fd519d2c547e3c52e2540
--- /dev/null
+++ b/third_party/catapult/dashboard/dashboard/elements/test-picker-test.html
@@ -0,0 +1,288 @@
+<!DOCTYPE html>
+<!--
+Copyright 2015 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link rel="import" href="/dashboard/elements/test-picker.html">
+<link rel="import" href="/dashboard/static/testing_common.html">
+
+<link rel="import" href="/tracing/core/test_utils.html">
+<link rel="import" href="/tracing/value/diagnostics/reserved_names.html">
+
+<script>
+'use strict';
+
+const MOCK_RESPONSE = {
+  'select-multiple-add': {
+    'has_rows': true,
