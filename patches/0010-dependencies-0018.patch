+
+//Aliases
+var $ = HTML.TAG_NAMES,
+    NS = HTML.NAMESPACES,
+    ATTRS = HTML.ATTRS;
+
+//Default options
+var DEFAULT_OPTIONS = {
+    decodeHtmlEntities: true,
+    locationInfo: false
+};
+
