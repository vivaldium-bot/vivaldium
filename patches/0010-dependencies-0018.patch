+        assert_raises(CGIError, app.get, '', status=500)
+
+    def test_stderr():
+        app = TestApp(CGIApplication({}, script='stderr.cgi', path=[data_dir]))
+        res = app.get('', expect_errors=True)
+        assert res.status == 500
+        assert 'error' in res
+        assert b'some data' in res.errors
