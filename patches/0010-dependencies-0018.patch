+import re
+import urllib
+
+from google.appengine.api import urlfetch
+
+from dashboard.common import utils
+
+_SINGLE_EMAIL_SUBJECT = (
+    '%(percent_changed)s %(change_type)s in %(test_name)s '
+    'on %(bot)s at %(start)d:%(end)d')
