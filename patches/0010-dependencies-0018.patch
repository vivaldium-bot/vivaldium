+
+  test('getSubtestsForPath', async function() {
+    testing_common.addXhrMock('*', JSON.stringify(['foo/bar']));
+    const testPicker = document.createElement('test-picker');
+    assert.deepEqual(
+        await testPicker.subtests.get('foo'), [{name: 'bar'}]);
