+
+ - name: benchmark-health-queue
+   rate: 5/s
+   retry_parameters:
+     task_retry_limit: 2
+
+ - name: find-anomalies-bench-queue
+   rate: 5/s
+   max_concurrent_requests: 20
+   retry_parameters:
+     task_retry_limit: 0
+
+ - name: default
+   rate: 5/s
+   retry_parameters:
+     task_retry_limit: 1
+
+ - name: delete-tests-queue
+   rate: 20/s
+   retry_parameters:
+     task_retry_limit: 1
+
+ - name: deprecate-tests-queue
+   rate: 100/s
+   max_concurrent_requests: 10
+   retry_parameters:
+     task_retry_limit: 0
+
+ - name: edit-sheriffs-queue
+   rate: 10/m
+   retry_parameters:
+     task_retry_limit: 1
+
+ - name: histograms-queue
+   rate: 100/s
+   max_concurrent_requests: 100
+   retry_parameters:
+     task_retry_limit: 8
