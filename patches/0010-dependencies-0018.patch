+                    encodeHtmlEntities: false
+                }),
+                html = test.expected,
+                document = parser.parse(html);
+
+            walkTree(document, function (node) {
+                if (node.__location !== null) {
+                    var fragment = treeAdapter.createDocumentFragment();
+
+                    treeAdapter.appendChild(fragment, node);
