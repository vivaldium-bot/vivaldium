+                    'ChromiumFYI': {'linux': False}
+                },
+                'mon': ['dom', 'foo', 'jslib']
+            },
+            'scrolling': {
+                'mas': {'Chromium': {'mac': False, 'win7': False}},
+            },
+            'really': {
+                'mas': {'Chromium': {'mac': False, 'win7': False}}
+            },
+        },
+        update_test_suites._CreateTestSuiteDict())
+
+  def testFetchSuites(self):
