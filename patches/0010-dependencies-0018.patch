+        'test/test': 10000,
+        'test/test1': 50402,
+        'test2/test3': 20002,
+        'test2/test4': 0,  // Removed test2/test5 to get the 'undefined'.
+        'test2/test6': 40002,
+      },
+
+      'master2/bot2':
+      {
+        'test/test': 30012,
+        'test/test1': 60222,
+        'test2/test3': 40007,
+        'test2/test4': 40052,
+        'test2/test5': 40012,
+        'test2/test6': 40002,
