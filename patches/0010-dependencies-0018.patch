+
+  def testFlattenTrace_InvalidTraceType(self):
+    """Tests whether a ref trace that is not a chart has the _ref suffix."""
+    trace = self._SampleTrace()
+    trace.update({'type': 'foo'})
+    with self.assertRaises(add_point.BadRequestError):
