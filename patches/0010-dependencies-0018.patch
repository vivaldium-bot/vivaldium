+
+  def testCache(self):
+    self._request_json.return_value = {'log': []}
+    self._request.return_value = 'aGVsbG8='
+
+    repository = 'https://chromium.googlesource.com/repo'
+    git_hash = '3a44bc56c4efa42a900a1c22b001559b81e457e9'
