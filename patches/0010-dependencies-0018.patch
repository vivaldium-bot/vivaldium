+              continue;
+            }
+            const end = annotation[revisionTypeKey];
+            let start = -1;
+            if (dataIndex > 0 && previousAnnotation &&
+                previousAnnotation[revisionTypeKey]) {
+              start = previousAnnotation[revisionTypeKey];
