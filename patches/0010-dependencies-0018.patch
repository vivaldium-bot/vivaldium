+    self._AssertExists([
+        'ChromiumPerf/mac/SunSpider/3d-cube/t',
+        'ChromiumPerf/win7/SunSpider/3d-cube/t',
+    ])
+
+
+  def testPost_DeleteSuiteLevelTest(self):
