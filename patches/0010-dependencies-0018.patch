+
+  def AssertDeprecated(self, test_path, deprecated):
+    test_key = utils.TestKey(test_path)
+    test = test_key.get()
+
+    self.assertEqual(test.deprecated, deprecated)
+
+  @mock.patch.object(deprecate_tests, '_AddDeleteTestDataTask')
