+    };
+    testPicker.subtests.populateForTest(new Map([
+      ['Chromium/mac/blink_perf', [{name: 'textarea-edit'}]],
+      ['Chromium/mac/blink_perf/textarea-edit', [
+        {name: 'textarea_edit.html'}]],
