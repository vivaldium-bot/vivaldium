+
+    expected = run_test.RunTest(
+        {'key': 'value'}, _ALL_TELEMETRY_ARGUMENTS)
+    self.assertEqual(run_test.RunTest.FromDict(arguments),
+                     (arguments, expected))
+
+  def testInvalidExtraTestArgs(self):
