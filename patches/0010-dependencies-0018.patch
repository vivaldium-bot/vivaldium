+def test_parse_media_range():
+    parse = parse_media_range
+    assert parse('application/*;q=0.5') == ('application', '*', {'q': '0.5'})
+    assert parse('text/plain') == ('text', 'plain', {'q': '1'})
+    assert parse('*') == ('*', '*', {'q': '1'})
+    assert parse(';q=0.5') == ('*', '*', {'q': '0.5'})
+    assert parse('*;q=0.5') == ('*', '*', {'q': '0.5'})
+    assert parse('*;q=1') == ('*', '*', {'q': '1'})
+    assert parse('*;q=') == ('*', '*', {'q': '1'})
