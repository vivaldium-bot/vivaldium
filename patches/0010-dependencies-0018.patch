+    self.assertEqual(
+        [{'key': 'foo', 'value': 'mac_dimensions'}],
+        json.loads(results['dimensions']))
+
+  @mock.patch.object(
+      utils, 'IsValidSheriffUser', mock.MagicMock(return_value=True))
+  def testPinpointParams_IsolateTarget_WebviewTelemetry(self):
