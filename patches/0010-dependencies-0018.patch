+$(this).attr("hottracked", "true");
+var description = $(this).find('.id-swipeUp-description');
+var content = $(this).find('.id-swipeUp-content');
+timer = setTimeout(function () {
+content.css('border-top-style', 'solid');
+description.slideDown(timeSwipe);
+}, delaySwipe);
+};
+function down(event) {
+clearTimeout(timer);
+var content = $(this).find('.id-swipeUp-content');
+$(this).find('.id-swipeUp-description').slideUp(timeSwipe, function () { content.css('border-top-style', 'none'); });
+};
+})();
+});
