+    self._AssertExists([
+        'ChromiumPerf/mac/SunSpider/Total',
+        'ChromiumPerf/mac/SunSpider/Total/t_ref',
+        'ChromiumPerf/mac/SunSpider/Total/t_extwr',
+        'ChromiumPerf/mac/SunSpider/3d-cube',
+        'ChromiumPerf/mac/moz',
