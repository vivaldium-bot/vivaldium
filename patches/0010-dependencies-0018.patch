+<!DOCTYPE html>
+<!--
+Copyright 2015 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link rel="import" href="/dashboard/elements/login-warning.html">
+
+<link rel="import" href="/tracing/core/test_utils.html">
+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  test('should be hidden when "missing" attribute is empty', function() {
+    const element = document.createElement('login-warning');
+    assert.isTrue(element.messageElement.hidden);
+  });
+
+  test('should become visible when "missing" attribute is set', function() {
+    const element = document.createElement('login-warning');
+    Polymer.dom(element).setAttribute('missing', 'foo');
+    Polymer.dom(document.body).appendChild(element);
+    assert.isFalse(element.messageElement.hidden);
+  });
+});
+</script>
diff --git a/third_party/catapult/dashboard/dashboard/elements/login-warning.html b/third_party/catapult/dashboard/dashboard/elements/login-warning.html
new file mode 100644
index 0000000000000000000000000000000000000000..152c94764089c873b52ee38ef697d92501a04e38
--- /dev/null
+++ b/third_party/catapult/dashboard/dashboard/elements/login-warning.html
@@ -0,0 +1,37 @@
+<!DOCTYPE html>
+<!--
+Copyright 2016 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<dom-module id="login-warning">
+  <style>
+    #message {
+      color: #dd4b39;
+      font-size: 20px;
+    }
+  </style>
+  <template>
+    <div id="message" hidden$="{{!missing}}">
+      No data available for {{missing}}. Note that some data is only visible
+      when <a href$="{{loginLink}}">signed in</a> with a chromium.org account, which is linked to a google user.
+    </div>
+  </template>
+  <script>
+    'use strict';
+    Polymer({
+      is: 'login-warning',
+      properties: {
+        loginLink: { notify: true },
+        missing: {
+          value: null,
+          notify: true
+        }
+      },
+      get messageElement() {
+        return this.$.message;
+      }
+    });
+  </script>
+</dom-module>
