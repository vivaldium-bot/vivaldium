+        onAlertMouseOver(flotSeriesIndex, dataIndex, event) {
+          if (!this.stickyTooltip) {
+            this.showTooltip(flotSeriesIndex, dataIndex);
+          }
+        },
+        /**
+         * Updates the interface when a bug is triaged.
