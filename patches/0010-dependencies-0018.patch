+    self._AssertNotExists([
+        'ChromiumPerf/mac/SunSpider/Total/t',
+        'ChromiumPerf/win7/SunSpider/Total/t',
+        'ChromiumPerf/mac/SunSpider/Total/t_ref',
+        'ChromiumPerf/win7/SunSpider/Total/t_ref',
