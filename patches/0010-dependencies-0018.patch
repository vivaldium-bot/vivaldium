+                dest = dest.replace(cwd, '', 1)
+            aslist = []
+            head, tail = _os.path.split(dest)
+            while tail:
+                aslist.append(tail)
+                head, tail = _os.path.split(head)
+            aslist.reverse()
+            dest = '/'.join(aslist)
+            yield dest
+
+        if not recursive:
