+import math
+import unittest
+
+from dashboard import find_step
+from dashboard import math_utils
+
+# Sample data where there is a small-ish step upwards around revision 304772.
+_QUITE_STEPPISH = [
+    (304469, 1056467.555),
+    (304496, 1053394.222),
+    (304521, 1052791.555),
+    (304537, 1061429.777),
