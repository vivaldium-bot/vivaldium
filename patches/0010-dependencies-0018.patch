+  const unitMap = {
+    'test/test': 'timeStampInMs',
+    'test/test1': 'sizeInBytes',
+    'test2/test3': 'powerInWatts',
+    'test2/test4': 'count',
+    'test2/test5': 'bytes',
+    'test2/test6': 'sizeInBytes',
+  };
+
+  const categories = {
+    'foreground': 3,
+    'background': 2,
+    'middleground': 1
+  };
+
+  const urlMap = {
+    'master/bot/test/test': '/do/not/click/me',
