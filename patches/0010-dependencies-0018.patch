+    self.assertEqual('efgh5678', results['end_git_hash'])
+    self.assertEqual('0', results['auto_explore'])
+    self.assertEqual('', results['bug_id'])
+    self.assertEqual(
+        [{'key': 'foo', 'value': 'android_dimensions'}],
