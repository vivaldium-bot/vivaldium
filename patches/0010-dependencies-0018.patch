+    assert.deepEqual(actualSuites, expectedSuites);
+  }, testOptions);
+
+  test('fullPathRetained', async function() {
+    const testPicker = document.createElement('test-picker');
+    testPicker.testSuites = {
+      'endure': {
+        'mas': {'Chromium': {'mac': false, 'win7': true}},
