diff --git a/third_party/catapult/dashboard/dashboard/static/series_group.html b/third_party/catapult/dashboard/dashboard/static/series_group.html
new file mode 100644
index 0000000000000000000000000000000000000000..2d0e58c1d6ca3deb0fc3a940f6e7ecf83e740536
--- /dev/null
