+{
+   switch (op) {
+   case SM4_OPCODE_EQ:
+   case SM4_OPCODE_DEQ:
+   case SM4_OPCODE_IEQ: return CC_EQ;
+   case SM4_OPCODE_GE:
+   case SM4_OPCODE_DGE:
+   case SM4_OPCODE_IGE:
+   case SM4_OPCODE_UGE: return CC_GE;
+   case SM4_OPCODE_LT:
