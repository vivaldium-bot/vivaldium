+
+   struct {
+      union {
+         float f[4];
+         unsigned u[4];
+         int i[4];
+      } value;
+      unsigned nr;
+      unsigned type;
+   } immediate[UREG_MAX_IMMEDIATE];
+   unsigned nr_immediates;
+
+   struct ureg_src sampler[PIPE_MAX_SAMPLERS];
+   unsigned nr_samplers;
