+from sys import executable as python_cmd
+import distutils.version
+
+Import('*')
+
+if not env['llvm']:
+    print 'warning: LLVM disabled: not building llvmpipe'
+    Return()
+
+env = env.Clone()
+
+env.Append(CPPPATH = ['.'])
+
