+
+static void
+galahad_screen_destroy(struct pipe_screen *_screen)
+{
+   struct galahad_screen *glhd_screen = galahad_screen(_screen);
+   struct pipe_screen *screen = glhd_screen->screen;
+
+   screen->destroy(screen);
+
+   FREE(glhd_screen);
+}
