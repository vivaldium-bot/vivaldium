+                           unsigned short dst_pitch,
+                           struct i915_winsys_buffer *dst_buffer,
+                           unsigned dst_offset,
+                           short x, short y,
+                           short w, short h, unsigned color);
+
+
+#endif
diff --git a/third_party/mesa/src/src/gallium/drivers/i915/i915_clear.c b/third_party/mesa/src/src/gallium/drivers/i915/i915_clear.c
