index 0000000000000000000000000000000000000000..25755ba471d9abe69182730ca1aef4a8b6304bf8
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/nv30/nv30_state.c
@@ -0,0 +1,459 @@
