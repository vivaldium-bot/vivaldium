+class Instruction
+{
+public:
+   Instruction();
+   Instruction(Function *, operation, DataType);
+   virtual ~Instruction();
+
+   virtual Instruction *clone(ClonePolicy<Function>&,
+                              Instruction * = NULL) const;
+
+   void setDef(int i, Value *);
