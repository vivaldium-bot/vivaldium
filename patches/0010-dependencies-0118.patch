+galahad_context_bind_blend_state(struct pipe_context *_pipe,
+                          void *blend)
+{
+   struct galahad_context *glhd_pipe = galahad_context(_pipe);
+   struct pipe_context *pipe = glhd_pipe->pipe;
+
+   pipe->bind_blend_state(pipe,
+                              blend);
+}
