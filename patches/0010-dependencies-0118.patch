index 0000000000000000000000000000000000000000..df08ec302a26956ef50f133cf1c59c11f93d64a4
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/util/u_cache.c
@@ -0,0 +1,351 @@
+/**************************************************************************
+ *
+ * Copyright 2008 VMware, Inc.
+ * All Rights Reserved.
+ *
