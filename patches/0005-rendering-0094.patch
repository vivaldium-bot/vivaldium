-    t.done();
-  }
-  ac.startRendering();
-}, "ConstantSourceNode onended event");
-
-async_test(function(t) {
-  var ac = new OfflineAudioContext(1, 2048, 44100);
-  var csn = ac.createConstantSource();
-  csn.connect(ac.destination);
-  csn.start(512/44100)
-  csn.stop(1024/44100)
-
-  ac.oncomplete = function(e) {
-    t.step(function() {
