-    target: target.id
-  }];
-  port.postMessage({actual: entries.map(entryToJson), expected: expected}, "*");
-  port.postMessage({DONE: 1}, "*");
-}
-
-function handleMessage(event)
-{
-  port = event.source;
-  nextStep();
-}
-
-nextStep = step0;
-window.addEventListener("message", handleMessage);
