-function propertyToIDL(property) {
-  // https://drafts.csswg.org/web-animations/#animation-property-name-to-idl-attribute-name
-  if (property === 'float') {
-    return 'cssFloat';
-  }
-  return property.replace(/-[a-z]/gi,
-                          function (str) {
