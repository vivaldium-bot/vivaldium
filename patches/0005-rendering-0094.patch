-function getRequestInit(params) {
-  var init = {};
-  if (params['method']) {
-    init['method'] = params['method'];
-  }
-  if (params['mode']) {
-    init['mode'] = params['mode'];
-  }
-  if (params['credentials']) {
-    init['credentials'] = params['credentials'];
-  }
-  if (params['headers'] === 'CUSTOM') {
-    init['headers'] = {'X-ServiceWorker-Test': 'test'};
