+// Test that we don't cache the result of a regexp match across a
+// compile event.
+var re = /x/;
+assertEquals("a.yb", "axyb".replace(re, "."));
+
+re.compile("y");
+assertEquals("ax.b", "axyb".replace(re, "."));
+
+re.compile("(x)");
+
+assertEquals(["x", "x"], re.exec("axyb"));
+
+re.compile("(y)");
+
+assertEquals(["y", "y"], re.exec("axyb"));
