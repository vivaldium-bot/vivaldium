+    new Proxy({},{}),
+    new Date(), new String(" a"),
+    new Uint8Array(12), new Float32Array([1, 2, 4, 5]),
+    new Uint8ClampedArray(2048),
+    /asdf/, new RegExp(),
+    Object.create, Object, Array,
+    Symbol.iterator,
+    [][Symbol.iterator](),
+    new Map(), new Set(),
+    (new Map()).entries(), (new Set()).entries(),
+    sloppyArguments(), sloppyArguments(1, 2, 3, 4),
