+  x = eval("1e" + i);
+  assertEquals(x, y);
+  y *= 10;
+  assertEquals(Math.floor(x), parseInt(x));
+  x = eval("-1e" + i);
+  assertEquals(Math.ceil(x), parseInt(x));
+  x = eval("-1.2e" + i);
+  assertEquals(Math.ceil(x), parseInt(x));
+}
+
+for (i = 21; i < 53; i++) {
+  var x = eval("1e" + i);
