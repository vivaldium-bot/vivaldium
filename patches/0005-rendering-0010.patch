+    "phtml": "application/x-httpd-php",
+
+    // Python
+    "py": "text/x-python",
+
+    // Shell
+    "sh": "text/x-sh",
+
+    // SCSS
+    "scss": "text/x-scss",
+
+    // Video Text Tracks.
+    "vtt": "text/vtt",
+
+    // LiveScript
+    "ls": "text/x-livescript",
+
+    // ClojureScript
+    "cljs": "text/x-clojure",
+    "cljc": "text/x-clojure",
+    "cljx": "text/x-clojure"
+}
