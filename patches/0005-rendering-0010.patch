+        return;
+
+    if (m_parserPaused) {
+        m_pendingCallbacks.append(adoptPtr(new PendingInternalSubsetCallback(name, externalID, systemID)));
+        return;
+    }
+
+    if (document())
+        document()->parserAppendChild(DocumentType::create(document(), name, externalID, systemID));
+}
