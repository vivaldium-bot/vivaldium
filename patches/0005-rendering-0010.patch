+WTF_ATTRIBUTE_PRINTF(2, 3)
+static void warningHandler(void* closure, const char* message, ...)
+{
+    va_list args;
+    va_start(args, message);
+    getParser(closure)->error(XMLErrors::ErrorTypeWarning, message, args);
+    va_end(args);
