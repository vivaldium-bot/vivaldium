+    white-space: nowrap;
+    text-overflow: ellipsis;
+    overflow: hidden;
+    padding: 2px 0;
+}
+
+.breakpoint-list li:hover {
+    background-color: #eee;
+}
+
+.breakpoint-list .source-text {
+    white-space: nowrap;
+    text-overflow: ellipsis;
+    overflow: hidden;
+    margin: 2px 0 0 20px;
+}
+
+.sidebar-pane .breakpoint-hit {
+    background-color: rgb(255, 255, 194);
+}
+
+li.breakpoint-hit .breakpoint-hit-marker {
+    background-color: rgb(255, 255, 194);
+    height: 18px;
+    left: 0;
+    margin-top: -16px;
+    position: absolute;
+    right: 0;
+    z-index: -1;
+}
+
+.event-listener-breakpoints {
+    margin-top: 0;
+    padding: 2px 6px;
+    list-style: none;
+    min-height: 18px;
+}
+
+.event-listener-breakpoints ol {
+    display: none;
+    margin: 0;
+    -webkit-padding-start: 12px;
+    list-style: none;
+}
+
+.event-listener-breakpoints ol.expanded {
+    display: block;
+}
+
+.event-listener-breakpoints li {
+    margin-left: 12px;
+    text-overflow: ellipsis;
+    -webkit-user-select: text;
+    cursor: default;
+}
+
+.event-listener-breakpoints li.parent {
+    margin-left: 1px;
+}
+
+.event-listener-breakpoints li.parent::before {
