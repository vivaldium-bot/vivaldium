+ * @param {!WebInspector.UISourceCode} uiSourceCode
+ * @param {!Array.<!WebInspector.Script>} scripts
+ */
+WebInspector.ResourceScriptFile = function(resourceScriptMapping, uiSourceCode, scripts)
+{
+    console.assert(scripts.length);
