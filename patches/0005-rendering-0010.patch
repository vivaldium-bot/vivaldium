+}
+
+.responsive-design-suite.responsive-design-suite-top {
+    color: rgb(255, 255, 255);
+}
+
+.responsive-design-suite-separator {
+    flex: none;
+    width: 1px;
+    background-color: rgb(43, 43, 43);
