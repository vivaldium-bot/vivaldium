+    width: 80px;
+    height: 107px;
+    background-color: gray;
+    transform: translate3d(0, 0, 10px);
+}
+
+.accelerometer-box .back {
+    width: 80px;
+    height: 107px;
+    background-color: black;
+    transform: rotateY(-180deg) translate3d(0, 0, 10px);
+}
+
+.accelerometer-box .top {
+    overflow: hidden;
+    width: 80px;
+    height: 20px;
+    background-color: #75CE89;
