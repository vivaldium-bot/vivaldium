+
+.responsive-design-section-network select {
+    width: 145px;
+}
+
+.responsive-design-section-network input[type='text'] {
+    width: 182px;
+    margin-left: 5px;
+    text-overflow: ellipsis;
+}
+
+.responsive-design-section-network input[type='text'],
