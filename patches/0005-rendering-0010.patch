-jsTestIsAsync = true;
-
-kHkdfKey = hexStringToUint8Array("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
-kIv = new Uint8Array(16);
-
-var extractable = true;
