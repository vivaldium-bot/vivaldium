+    color: rgb(136, 19, 145);
+    flex-shrink: 0;
+}
+
+.ax-readable-name {
+    flex-shrink: 0;
+}
+
+span.ax-role {
+    font-weight: bold;
+}
+
+span.ax-internal-role {
+    font-style: italic;
+}
+
+.ax-ignored-info {
+    padding: 6px;
+}
+
+.ax-ignored-node-pane {
+    background-color: hsl(0, 0%, 96%);
+}
+
+.tree-outline li {
+    padding-top: 5px;
+}
