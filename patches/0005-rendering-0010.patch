+                break;
+            }
+            case "find-trace-tree": {
+                var tracesToken = "\"trace_tree\"";
+                var tracesTokenIndex = this._json.indexOf(tracesToken);
+                if (tracesTokenIndex === -1)
+                    return;
+                var bracketIndex = this._json.indexOf("[", tracesTokenIndex);
+                if (bracketIndex === -1)
+                    return;
