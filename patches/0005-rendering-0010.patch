+        uiSourceCode[WebInspector.NetworkProject._contentTypeSymbol] = type;
+    },
+
+    /**
+     * @param {string} url
+     */
+    _removeFile: function(url)
+    {
+        if (!this._processedURLs[url])
+            return;
+        delete this._processedURLs[url];
+        this._removeFileForURL(url);
+    },
