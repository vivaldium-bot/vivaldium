+    },
+
+    /**
+     * @param {!WebInspector.PresentationConsoleMessageHelper.Events} eventType
+     * @param {!WebInspector.UISourceCode} uiSourceCode
+     * @param {function(!WebInspector.Event)} listener
+     * @param {!Object=} thisObject
