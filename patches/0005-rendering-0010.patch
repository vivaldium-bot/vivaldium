+WebInspector.OutputStreamDelegate.prototype = {
+    onTransferStarted: function() { },
+
+    onTransferFinished: function() { },
+
+    /**
+     * @param {!WebInspector.ChunkedReader} reader
+     */
+    onChunkTransferred: function(reader) { },
+
+    /**
+     * @param {!WebInspector.ChunkedReader} reader
+     * @param {!Event} event
+     */
+    onError: function(reader, event) { },
