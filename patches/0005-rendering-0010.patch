+    background-image: url(Images/toolbarButtonGlyphs.png);
+    background-size: 352px 144px;
+    opacity: 0.5;
+    content: "a";
+    width: 8px;
+    float: left;
+    margin: 2px 2px 0 -2px;
+    color: transparent;
+    text-shadow: none;
+}
+
