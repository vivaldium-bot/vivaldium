+
+    /**
+     * @param {!WebInspector.Event} event
+     */
+    _onRowSizeChanged: function(event)
+    {
+        this._updateUI();
+    },
+
+    /**
+     * @param {!WebInspector.Event} event
+     */
+    _onSearchCountUpdated: function(event)
+    {
