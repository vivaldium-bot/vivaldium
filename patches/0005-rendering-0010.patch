+        return this._displayName;
+    },
+
+    /**
+     * @override
+     * @return {string}
+     */
+    url: function()
+    {
+        return this._url;
+    },
+
+    /**
+     * @param {string} parentPath
+     * @param {string} name
+     * @param {string} url
+     * @param {!WebInspector.ContentProvider} contentProvider
+     * @return {string}
+     */
+    addFile: function(parentPath, name, url, contentProvider)
+    {
