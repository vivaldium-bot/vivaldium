+    font-size: 11px;
+    line-height: 17px;
+    white-space: nowrap;
+}
+
+.crumbs .crumb {
+    display: inline-block;
+    padding: 0 7px;
+    height: 18px;
+    white-space: nowrap;
+}
+
+:host-context(.material) .crumb {
+    padding: 0px 4px 0px 11px;
+    cursor: pointer;
+    line-height: 18px;
+    margin: 5px 0px;
+    position: relative;
+    color: hsl(0, 0%, 35%);
+}
