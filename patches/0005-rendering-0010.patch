+    display: block;
+    margin-left: 0;
+    margin-right: 0;
+    outline: none !important;
+    border: 1px solid rgb(66%, 66%, 66%);
+}
+
+ol.breakpoint-list {
+    -webkit-padding-start: 0;
+    list-style: none;
+    margin: 0;
+    padding-bottom: 3px;
+}
+
+.breakpoints-list-deactivated {
+    background-color: #eee;
+    opacity: 0.3;
+}
+
