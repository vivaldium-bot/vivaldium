index 0000000000000000000000000000000000000000..3c17f0f2b6d7036dd620c47df477b56ba25632d6
--- /dev/null
+++ b/third_party/WebKit/Source/core/xmlhttprequest/XMLHttpRequestProgressEventThrottle.h
@@ -0,0 +1,111 @@
+/*
