+    width: 3px;
+    background-color: rgb(46, 46, 46);
+    border-right: 1px solid rgb(75, 75, 75);
+}
+
+.responsive-design-section {
+    display: flex;
+    flex: none;
+    flex-direction: column;
+    white-space: nowrap;
+    align-items: stretch;
+    justify-content: flex-start;
+    padding-top: 1px;
+}
+
+.responsive-design-section-decorator {
