+            }
+        }
+    },
+
+    _callbackForResourceCookiePairs: function(requests, cookie, callback)
+    {
+        if (!requests)
+            return;
+        for (var i = 0; i < requests.length; ++i) {
+            if (WebInspector.Cookies.cookieMatchesResourceURL(cookie, requests[i].url))
