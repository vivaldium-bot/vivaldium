+{
+    this._workspace = workspace;
+    this._networkMapping = networkMapping;
+    targetManager.observeTargets(this);
+}
+
+WebInspector.NetworkProjectManager.prototype = {
+    /**
+     * @override
+     * @param {!WebInspector.Target} target
+     */
