+    -webkit-appearance: none;
+    padding: 0;
+    border: 0;
+}
+
+.responsive-design-icon-swap {
+    margin-left: 1px;
+    top: 4px;
+}
+
+.responsive-design-icon-swap:hover {
+    background-color: rgb(255, 180, 0);
+}
+
+.responsive-design-icon-swap:active {
+    opacity: 0.8;
+}
