+.ax-computed-text {
+    padding: 3px 5px 0;
+    background-image: url(Images/speech.png);
+    background-repeat: no-repeat;
+    background-position: 16px center;
+    padding: 4px 4px 0 4px;
+    padding-left: 36px;
+    min-height: 18px;
+}
+
