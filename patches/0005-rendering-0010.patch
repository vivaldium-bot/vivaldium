@@ -0,0 +1,50 @@
+.dialog {
+    position: absolute;
+    border: 1px solid rgb(204, 204, 204);
+    box-shadow: rgb(140, 140, 140) 0 3px 14px;
+    display: flex;
+    -webkit-flex-direction: column;
+    background: white;
+}
+
+.dialog-contents {
+    width: 100%;
+}
+
+.go-to-line-dialog {
+    font-family: 'Lucida Grande', sans-serif;
+    padding: 10px;
+    font-size: inherit;
+}
+
