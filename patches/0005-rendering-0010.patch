+        this._updateUI();
+    },
+
+    /**
+     * @override
+     * @return {!Array.<!Element>}
+     */
+    elementsToRestoreScrollPositionsFor: function()
+    {
+        return this._networkLogView.elementsToRestoreScrollPositionsFor();
+    },
+
+    /**
+     * @override
+     * @return {!WebInspector.SearchableView}
+     */
+    searchableView: function()
