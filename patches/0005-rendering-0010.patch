+                this._drawPoint(iteration, group, leftDistance, i, iteration === 0);
+        }
+        this._drawPoint(iteration, group, this._duration() * this._timeline.pixelMsRatio() + WebInspector.AnimationUI.Options.AnimationMargin, -1, iteration === 0);
+    },
+
+    /**
+     * @return {number}
+     */
+    _delay: function()
+    {
