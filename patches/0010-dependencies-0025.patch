+    """Data for a single download.
+
+    Public attributes:
+      chunksize: default chunksize to use for transfers.
+    """
+    _ACCEPTABLE_STATUSES = set((
+        http_client.OK,
+        http_client.NO_CONTENT,
+        http_client.PARTIAL_CONTENT,
+        http_client.REQUESTED_RANGE_NOT_SATISFIABLE,
+    ))
