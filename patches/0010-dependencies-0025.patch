+
+import boto
+
+from gslib.cloud_api import ProjectIdException
+
+GOOG_PROJ_ID_HDR = 'x-goog-project-id'
+
+
+def PopulateProjectId(project_id=None):
+  """Fills in a project_id from the boto config file if one is not provided."""
+  if not project_id:
