+    log_handler = self.RunCommand(
+        'cp', [suri(object_uri), dst_dir], return_log_handler=True)
+    warning_messages = log_handler.messages['warning']
+    self.assertEquals(2, len(warning_messages))
+    self.assertRegexpMatches(
+        warning_messages[0],
