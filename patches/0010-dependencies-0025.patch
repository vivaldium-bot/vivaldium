+    stderr = self.RunGsUtil(['rb', suri(bucket_uri)], expected_status=1,
+                            return_stderr=True)
+    self.assertIn('BucketNotEmpty', stderr)
+
+  def test_rb_versioned_bucket_not_empty(self):
+    bucket_uri = self.CreateVersionedBucket(test_objects=1)
