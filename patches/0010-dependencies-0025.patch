+                          messages.find_definition,
+                          'i.am.a.module.A',
+                          importer=self.Importer)
+
+    def testGlobalFind(self):
+        """Test finding definitions from fully qualified module names."""
+        A = self.DefineMessage('a.b.c', 'A', {})
