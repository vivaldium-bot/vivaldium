+  <style is="custom-style" include="demo-pages-shared-styles">
+    paper-material {
+      display: inline-block;
+      background: white;
+      box-sizing: border-box;
+      margin: 8px;
+      padding: 16px;
+      border-radius: 2px;
+    }
+  </style>
