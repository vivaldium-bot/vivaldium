+
+        Args:
+          name: Name of attribute to set.
+          value: Value to assign.
+        """
+        # Special case post-init names.  They need to be set after constructor.
+        if name in _POST_INIT_FIELD_ATTRIBUTE_NAMES:
+            object.__setattr__(self, name, value)
+            return
