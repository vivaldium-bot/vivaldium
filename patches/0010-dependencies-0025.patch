+                          protojson.decode_message,
+                          MyMessage, '{"a_string": 10}')
+        self.assertRaises(messages.ValidationError,
+                          protojson.decode_message,
+                          MyMessage, '{"an_integer": 10.2}')
+        self.assertRaises(messages.ValidationError,
+                          protojson.decode_message,
+                          MyMessage, '{"an_integer": "10.2"}')
