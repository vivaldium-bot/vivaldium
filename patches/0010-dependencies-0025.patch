+
+        self.assertEqual(set(self.run_completer(p, c, "prog aa ")),
+                         set(["-h", "--help", "d", "e"]))
+
+        self.assertEqual(set(self.run_completer(p, c, "prog ")),
+                         set(["-h", "--help", "aa", "bb", "cc"]))
