+<script>
+
+  Polymer({
+
+    is: 'squares-page',
+
+    behaviors: [
+      Polymer.NeonSharedElementAnimatableBehavior
+    ],
+
+    properties: {
+
+      sharedElements: {
+        value: function() {
+          return {
+            'hero': this.$.header
+          }
+        }
+      },
+
+      animationConfig: {
+        value: function() {
