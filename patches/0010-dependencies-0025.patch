+                                                  retryable_codes=[])
+        # The request to be added. The actual request sent will be somewhat
+        # larger, as this is added to a batch.
+        desired_request = http_wrapper.Request(desired_url, 'POST', {
+            'content-type': 'multipart/mixed; boundary="None"',
+            'content-length': 80,
