+  def _WatchBucket(self):
+    """Creates a watch on a bucket given in self.args."""
+    self.CheckArguments()
+    identifier = None
+    client_token = None
+    if self.sub_opts:
+      for o, a in self.sub_opts:
+        if o == '-i':
+          identifier = a
+        if o == '-t':
+          client_token = a
+
