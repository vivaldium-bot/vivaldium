+                                              obj_metadata.metadata,
+                                              preserve_posix=True)
+      if dst_url.IsCloudUrl():
+        dst_generation = GenerationFromUrlAndString(dst_url, dst_url.generation)
+        dst_obj_metadata = gsutil_api.GetObjectMetadata(
