+    def testUnexpectedResponseCode(self):
+        response = _FakeResponse(http_client.INTERNAL_SERVER_ERROR)
+        with mock.patch.object(apitools_base, 'MakeRequest',
+                               return_value=response,
+                               autospec=True) as mock_make_request:
