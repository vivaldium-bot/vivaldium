+def _GenerateSuffixRegex():
+  """Creates a suffix regex for human-readable byte counts."""
+  human_bytes_re = r'(?P<num>\d*\.\d+|\d+)\s*(?P<suffix>%s)?'
+  suffixes = []
+  suffix_to_si = {}
+  for i, si in enumerate(_EXP_STRINGS):
