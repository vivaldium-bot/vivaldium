+        self._AssertInstanceSequence(results, 0)
+
+    def testYieldFromListWithPredicate(self):
+        self.mocked_client.column.List.Expect(
+            fusiontables.FusiontablesColumnListRequest(
+                maxResults=100,
+                pageToken=None,
+                tableId='mytable',
+            ),
+            fusiontables.ColumnList(
