+    for suffix in si_suffixes:
+      suffix_to_si[suffix] = i
+    suffixes.extend(si_suffixes)
+  human_bytes_re %= '|'.join(suffixes)
+  matcher = re.compile(human_bytes_re)
+  return suffix_to_si, matcher
