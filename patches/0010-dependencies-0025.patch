+    dst_url = StorageUrlFromString(self.args[-1])
+    if dst_url.IsFileUrl() and (dst_url.object_name == '-' or
+                                dst_url.IsFifo()):
+      if self.preserve_posix_attrs:
+        raise CommandException('Cannot preserve POSIX attributes with a '
+                               'stream or a named pipe.')
