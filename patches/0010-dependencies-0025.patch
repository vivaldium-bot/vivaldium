+        responses = []
+        for i in range(0, number_of_requests, max_batch_size):
+            responses.append(
+                self._MakeResponse(
+                    min(number_of_requests - i, max_batch_size)))
+        with mock.patch.object(http_wrapper, 'MakeRequest',
+                               autospec=True) as mock_request:
+            self.__ConfigureMock(
