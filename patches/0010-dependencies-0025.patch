+class TestSignUrl(testcase.GsUtilIntegrationTestCase):
+  """Integration tests for signurl command."""
+
+  def _GetKsFile(self):
+    if not hasattr(self, 'ks_file'):
+      # Dummy pkcs12 keystore generated with the command
