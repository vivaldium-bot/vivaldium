+<body>
+
+  <test-fixture id="basic">
+    <template>
+      <neon-animated-pages>
+      </neon-animated-pages>
+    </template>
+  </test-fixture>
+
+  <test-fixture id="notify-resize">
+    <template>
+      <neon-animated-pages>
+        <a-resizable-page></a-resizable-page>
+        <b-resizable-page></b-resizable-page>
+        <c-resizable-page></c-resizable-page>
+      </neon-animated-pages>
+    </template>
+  </test-fixture>
+
+  <test-fixture id="animate-initial-selection">
