+    self.RunGsUtil(['setmeta',
+                    '-h', 'x-%s-meta-%s' % (provider_meta_string, ATIME_ATTR),
+                    '-h', 'x-%s-meta-%s' % (provider_meta_string, MTIME_ATTR),
+                    '-h', 'x-%s-meta-%s' % (provider_meta_string, UID_ATTR),
+                    '-h', 'x-%s-meta-%s' % (provider_meta_string, GID_ATTR),
