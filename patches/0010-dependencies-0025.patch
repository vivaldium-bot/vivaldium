+                printer('"""Command wrapping %s."""',
+                        command_info.client_method_path)
+                printer()
+                printer('usage = """%s%s%s"""',
+                        command_info.name,
+                        ' ' if arg_list else '',
+                        ' '.join('<%s>' % argname for argname in arg_list))
+                printer()
+                printer('def __init__(self, name, fv):')
+                with printer.Indent():
+                    printer('super(%s, self).__init__(name, fv)',
+                            command_info.class_name)
