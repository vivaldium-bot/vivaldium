+    composite = bucket_uri.clone_replace_name(self.MakeTempName('obj'))
+
+    self.RunGsUtil(['compose', component1.uri, component2.uri, composite.uri])
+    self.assertEqual(composite.get_contents_as_string(), 'hello world!')
