+
+    request = '%s://%s' % (self.default_provider, bucket_base_name)
+    expected_result1 = '//%s/' % bucket1_name
+    expected_result2 = '//%s/' % bucket2_name
+
+    self.RunGsUtilTabCompletion(['ls', request], expected_results=[
