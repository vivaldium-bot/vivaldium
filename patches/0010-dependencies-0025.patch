+        c = CompletionFinder(p, always_complete_options=True)
+
+        completions = self.run_completer(p, c, "prog ")
+        assert(set(completions) == set(["-h", "--help", "--foo", "--bar"]))
+
+        completions = self.run_completer(p, c, "prog --")
+        assert(set(completions) == set(["--help", "--foo", "--bar"]))
