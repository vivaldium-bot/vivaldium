+@RET++@ 	FcResult
+@FUNC++@	FcPatternGetString
+@TYPE1++@	FcPattern *			@ARG1++@	p
+@TYPE2++@	const char *			@ARG2++@	object
+@TYPE3++@	int%				@ARG3++@	n
+@TYPE4++@	FcChar8 **			@ARG4++@	s
+
