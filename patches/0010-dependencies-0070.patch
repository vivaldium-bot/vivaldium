+@;@
+@?TYPE7@
+		<paramdef>@TYPE7@<parameter>@ARG7@</parameter></paramdef>
+@;@
+	</funcprototype>
+@}PROTOTYPE@
+	</funcsynopsis>
+	</refsynopsisdiv>
+	<refsect1><title>Description</title>
+	    <para>
+@DESC@
+	    </para>
+	</refsect1>
