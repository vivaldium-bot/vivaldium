index 0000000000000000000000000000000000000000..6cffe4c8d4bb431b95d0397d9fbe250c3fb9afb2
--- /dev/null
+++ b/third_party/flatbuffers/src/python/flatbuffers/table.py
@@ -0,0 +1,117 @@
