+
+@PROTOTYPE++@
+@RET++@		FcBool
+@FUNC++@	FcPatternAddString
+@TYPE1++@ 	FcPattern * 			@ARG1++@ 	p
+@TYPE2++@	const char *			@ARG2++@	object
+@TYPE3++@	const FcChar8 *			@ARG3++@	s
+
+@PROTOTYPE+++@
+@RET+++@	FcBool
