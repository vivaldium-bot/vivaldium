+@TYPE4@		int *				@ARG4@		i
+
+@PROTOTYPE+@
+@RET+@		FcResult
+@FUNC+@ 	FcPatternGetDouble
+@TYPE1+@	FcPattern *			@ARG1+@		p
+@TYPE2+@	const char *			@ARG2+@		object
+@TYPE3+@	int%				@ARG3+@		n
+@TYPE4+@	double *			@ARG4+@		d 
+
