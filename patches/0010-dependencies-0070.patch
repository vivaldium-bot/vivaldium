index 0000000000000000000000000000000000000000..f8e2f830f91a9bee43c656abaf91375af638b317
--- /dev/null
+++ b/third_party/icu/source/common/ucnv_cnv.c
@@ -0,0 +1,174 @@
+/*
+******************************************************************************
+*
+*   Copyright (C) 1999-2004, International Business Machines
