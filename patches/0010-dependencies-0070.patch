+ */
+
+#include "locmap.h"
+#include "cstring.h"
+#include "cmemory.h"
+
+#if 0
+#if U_PLATFORM == U_PF_WINDOWS && defined(_MSC_VER) && (_MSC_VER >= 1500)
+/*
+ * TODO: It seems like we should widen this to
+ * either U_PLATFORM_USES_ONLY_WIN32_API (includes MinGW)
