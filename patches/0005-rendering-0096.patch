-              // fail.
-              win.postMessage({ type: worklet_type,
-                                script_url: kWorkletScriptURL }, '*');
-              return promise;
-            })
-          .then(msg_event => assert_equals(msg_event.data, 'REJECTED'));
-    }, 'addModule() on a non-controlled document should not be intercepted ' +
