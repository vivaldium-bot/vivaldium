-        }
-        lines.push(prefix + "}");
-    }
-
-    function dumpItems(object, prefix, firstLinePrefix)
-    {
-        prefix = prefix || "";
-        firstLinePrefix = firstLinePrefix || prefix;
-        lines.push(firstLinePrefix + "[");
-        for (var i = 0; i < object.length; ++i)
-            dumpValue(object[i], "    " + prefix, "    " + prefix + "[" + i + "] : ");
