-    'hsla(100.5,50.5%,50.5%,.5)',
-
-    // Each of these has their alpha clipped [0.0, 1.0].
-    'rgba(255, 0, 0, -5)',  // clipped to rgba(255,0,0,0)
-    'rgba(255, 0, 0, 5)',   // clipped to rgba(255,0,0,1)
-  ];
-
-  var invalidColors = [
