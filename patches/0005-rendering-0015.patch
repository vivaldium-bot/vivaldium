-
-        .composited_from_none.before {
-            -webkit-filter: none;
-        }
-
-        .composited_from_composited {
-            -webkit-filter: drop-shadow(0px 0px 10px blue);
-        }
-
-        .composited_from_composited.before {
-            -webkit-filter: drop-shadow(0px 0px 10px red);
