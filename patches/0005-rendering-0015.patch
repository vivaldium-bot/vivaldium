-                return;
-
-            var layerTreeText = window.internals.layerTreeAsText(document);
-            document.getElementById("console").appendChild(document.createTextNode(layerTreeText));
-        }
-
-        function runTest()
-        {
-            // Dump the layer tree with the compositor-painted drop shadow.
