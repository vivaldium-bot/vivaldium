+
+TEST(UUIDTest, ComplexUUID)
+{
+    EXPECT_TRUE(isValidUUID("01234567-89ab-cdef-0123-456789abcdef"));
+    EXPECT_TRUE(isValidUUID("7ad025e0-1e86-11e5-b5f7-727283247c7f"));
