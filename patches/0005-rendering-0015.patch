+    double m_maxDelayTime;
+    int m_writeIndex;
+    double m_currentDelayTime;
+    double m_smoothingRate;
+    bool m_firstTime;
+    double m_desiredDelayFrames;
+
+    AudioFloatArray m_delayTimes;
+
+    size_t bufferLengthForDelay(double delayTime, double sampleRate) const;
+};
