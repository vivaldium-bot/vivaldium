+WebCryptoAlgorithmId WebCryptoAlgorithm::id() const
+{
+    ASSERT(!isNull());
+    return m_private->id;
+}
+
+WebCryptoAlgorithmParamsType WebCryptoAlgorithm::paramsType() const
+{
+    ASSERT(!isNull());
+    if (!m_private->params)
+        return WebCryptoAlgorithmParamsTypeNone;
+    return m_private->params->type();
+}
