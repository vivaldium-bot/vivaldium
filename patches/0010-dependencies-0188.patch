diff --git a/third_party/webrtc/base/logging_unittest.cc b/third_party/webrtc/base/logging_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c08b1efd4a1cb4a4b1aba96b7beda40f69c42b8e
--- /dev/null
+++ b/third_party/webrtc/base/logging_unittest.cc
@@ -0,0 +1,162 @@
+/*
