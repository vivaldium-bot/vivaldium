+#ifndef WEBRTC_AUDIO_AUDIO_SEND_STREAM_H_
+#define WEBRTC_AUDIO_AUDIO_SEND_STREAM_H_
+
+#include <memory>
+
+#include "webrtc/audio_send_stream.h"
+#include "webrtc/audio_state.h"
+#include "webrtc/base/constructormagic.h"
