+{
+    vec3 c = 10.0 * 2.0 * (gtf_Color.rgb - 0.5);
+    color = vec4((floor_ref(c) + 10.0) / 20.0, 1.0);
+    gl_Position = gtf_ModelViewProjectionMatrix * gtf_Vertex;
+}
