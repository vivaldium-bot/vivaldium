+PeerConnection::PeerConnection(PeerConnectionFactory* factory)
+    : factory_(factory),
+      observer_(NULL),
+      uma_observer_(NULL),
+      signaling_state_(kStable),
+      ice_state_(kIceNew),
+      ice_connection_state_(kIceConnectionNew),
