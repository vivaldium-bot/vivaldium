diff --git a/third_party/webrtc/base/maccocoathreadhelper.mm b/third_party/webrtc/base/maccocoathreadhelper.mm
new file mode 100644
index 0000000000000000000000000000000000000000..59ae6c4c9943f2c7cc00494177a78bc5038f3025
--- /dev/null
