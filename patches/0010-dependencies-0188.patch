+vec3 floor_ref(vec3 x)
+{
+    if(x[0] >= 0.0)
+        x[0] = float(int(x[0]));
+    else
+        x[0] = float(int(x[0]) - 1);
+    if(x[1] >= 0.0)
+        x[1] = float(int(x[1]));
+    else
+        x[1] = float(int(x[1]) - 1);
+    if(x[2] >= 0.0)
+        x[2] = float(int(x[2]));
+    else
+        x[2] = float(int(x[2]) - 1);
+    return x;
+}
+
