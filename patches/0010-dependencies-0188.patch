diff --git a/third_party/webrtc/base/macutils.cc b/third_party/webrtc/base/macutils.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3a07b815c90d864a3f7346e5b5a9d17357b718ac
--- /dev/null
+++ b/third_party/webrtc/base/macutils.cc
@@ -0,0 +1,209 @@
+/*
+ *  Copyright 2007 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
