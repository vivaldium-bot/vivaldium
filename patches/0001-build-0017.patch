+  if '-v' in sys.argv:
+    unittest.TestCase.maxDiff = None
+  logging.basicConfig(
+      level=(logging.DEBUG if '-v' in sys.argv else logging.CRITICAL))
+  clear_env_vars()
+  unittest.main()
