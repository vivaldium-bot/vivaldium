+class TestSwarm(unittest.TestCase):
+  def test_example(self):
+    # pylint: disable=W0101
+    # A user should be able to trigger a swarm job and return results.
+    cmd = [
+      sys.executable,
+      '3_swarming_trigger_collect.py',
