+
+        The JSON should have been produced by calling .to_json() on the object.
+
+        Args:
+            data: dict, A deserialized JSON object.
+
+        Returns:
+            An instance of a Credentials subclass.
+        """
+        s = _from_bytes(s)
+        data = json.loads(s)
