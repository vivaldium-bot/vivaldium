+    """Returns the execution mode corresponding to this test case."""
+    test_id = self.id().split('.')
+    self.assertEqual(3, len(test_id))
+    self.assertEqual('__main__', test_id[0])
+    return re.match('^test_([a-z]+)$', test_id[2]).group(1)
