+def readable_copy(outfile, infile):
+  """Makes a copy of the file that is readable by everyone."""
+  fs.copy2(infile, outfile)
+  fs.chmod(
+      outfile,
+      fs.stat(outfile).st_mode | stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)
