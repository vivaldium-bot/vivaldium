+      isolateserver.Item('foo', 12),
+      isolateserver.Item('blow', 0),
+      isolateserver.Item('bizz', 1222),
+      isolateserver.Item('buzz', 1223),
+    ]
+    expected = [
+      [items[3], items[2], items[0], items[1]],
+    ]
+    batches = list(isolateserver.batch_items_for_check(items))
