+class TestArRoundTrip(BaseTestSuite, unittest.TestCase):
+
+  def assertWorking(self, *initems):
+    outfile = ClosesSaveIOBytes()
+
+    afw = arfile.ArFileWriter(outfile)
+    for ai, data in initems:
