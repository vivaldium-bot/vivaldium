diff --git a/tools/swarming_client/libs/luci_context/luci_context.py b/tools/swarming_client/libs/luci_context/luci_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..2c559e1f3eb368eb1d14b1a83a49fe2c0b1a5697
--- /dev/null
