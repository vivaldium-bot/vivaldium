+                res = (subId & 0x7f,)
+                subId = subId >> 7
+                while subId > 0:
+                    res = (0x80 | (subId & 0x7f),) + res
+                    subId = subId >> 7 
+                # Add packed Sub-Object ID to resulted Object ID
+                octets += res
+
+        return ints2octs(octets), 0
