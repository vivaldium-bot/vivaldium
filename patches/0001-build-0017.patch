+            while head:  # value
+                p <<= 8
+                p |= oct2int(head[0])
+                head = head[1:]
+            if fo & 0x40:    # sign bit
+                p = -p
+            sf = fo >> 2 & 0x03  # scale bits
+            p *= 2**sf
