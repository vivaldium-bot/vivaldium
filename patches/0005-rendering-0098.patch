-                                  redirectUrl(hostInfo.HTTP_REMOTE_ORIGIN,
-                                              redirectUrl(hostInfo.HTTP_ORIGIN,
-                                                          cacheBustedUrl())));
-    loadImages([directUrl, sameOriginRedirect, crossOriginRedirect,
-                mixedRedirect, complexRedirect], checkResourceSizes);
