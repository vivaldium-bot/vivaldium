-//
-// getShaderSource
-//
-// Load the source from the passed shader file.
-//
-function getShaderSource(file)
-{
-    var xhr = new XMLHttpRequest();
-    xhr.open("GET", file, false);
-    xhr.send();
-    return xhr.responseText;
