-            testFailed("Subarray of " + name + " threw exception");
-        }
-    } catch (e) {
-        testFailed("Exception: " + e);
-    }
-}
-
-function testSettingFromArrayWithOutOfRangeOffset(type, name) {
-    var webglArray = new type(32);
-    var array = [];
