-            baseIndex + 0,
-            baseIndex + 1,
-            baseIndex + 2,
-            baseIndex + 2,
-            baseIndex + 3,
-            baseIndex + 0]), gl.STATIC_DRAW);
-
-        var opt_positionLocation = 0;
