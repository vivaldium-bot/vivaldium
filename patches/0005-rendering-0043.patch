-        // Initialized the last 4 values to a quad
-        quadArray[idx++] = 1.0 * s;
-        quadArray[idx++] = 1.0 * s;
-        quadArray[idx++] = 0.0;
-
-        quadArray[idx++] = -1.0 * s;
-        quadArray[idx++] = 1.0 * s;
-        quadArray[idx++] = 0.0;
-
-        quadArray[idx++] = -1.0 * s;
-        quadArray[idx++] = -1.0 * s;
-        quadArray[idx++] = 0.0;
-
-        quadArray[idx++] = 1.0 * s;
-        quadArray[idx++] = -1.0 * s;
-        quadArray[idx++] = 0.0;
