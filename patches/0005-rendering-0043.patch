-function axisRotation(axis, angle) {
-  var dst = new Float32Array(16);
-  var x = axis[0];
-  var y = axis[1];
-  var z = axis[2];
-  var n = Math.sqrt(x * x + y * y + z * z);
-  x /= n;
-  y /= n;
-  z /= n;
-  var xx = x * x;
-  var yy = y * y;
-  var zz = z * z;
-  var c = Math.cos(angle);
-  var s = Math.sin(angle);
-  var oneMinusCosine = 1 - c;
