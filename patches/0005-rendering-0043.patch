-function runTest(bitmaps, alphaVal, colorSpaceEffective)
-{
-    var retVal = {testPassed: true, alpha: alphaVal, colorSpaceEffect: colorSpaceEffective};
-    var program = tiu.setupTexturedQuad(gl, internalFormat);
