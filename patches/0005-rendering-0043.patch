-    errFn("*** Error loading shader '" + shader + "':" + glEnumToString(gl, err));
-    return null;
-  }
-
-  // Compile the shader
-  gl.compileShader(shader);
-
-  if (opt_logShaders) {
-    var label = shaderType == gl.VERTEX_SHADER ? 'vertex shader' : 'fragment_shader';
-    if (opt_shaderLabel) {
-      label = opt_shaderLabel + ' ' + label;
