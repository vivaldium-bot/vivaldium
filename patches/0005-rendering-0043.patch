-                      gl.RGBA, type, null);
-        if (gl.getError() != gl.NO_ERROR)
-            testFailed("GL error after texImage2D(null)");
-        gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, 1, 2, gl.RGBA, type, data);
-        if (gl.getError() != gl.NO_ERROR)
