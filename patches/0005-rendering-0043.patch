-                var y = -Math.floor(l * canvas.height / 2) + canvas.height / 2;
-                var source = readLocation(x, y);
-                if (Math.abs(source[0] - expected) > 2) {
-                    return false;
-                }
-            }
-            return true;
-        }
-        return testList(blackList, 0) && testList(whiteList, 255);
-    };
-    function verifyDraw(drawNumber, s) {
