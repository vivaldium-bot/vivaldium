+
+Node* Range::pastLastNode() const
+{
+    if (m_end.container()->offsetInCharacters())
+        return NodeTraversal::nextSkippingChildren(*m_end.container());
+    if (Node* child = NodeTraversal::childAt(*m_end.container(), m_end.offset()))
+        return child;
+    return NodeTraversal::nextSkippingChildren(*m_end.container());
+}
