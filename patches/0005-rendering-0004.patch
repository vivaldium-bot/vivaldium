+DEFINE_TRACE(VisibleSelection)
+{
+    visitor->trace(m_base);
+    visitor->trace(m_extent);
+    visitor->trace(m_start);
+    visitor->trace(m_end);
+    visitor->trace(m_baseInComposedTree);
+    visitor->trace(m_extentInComposedTree);
