+
+inline static Node& rootInTreeOfTrees(const Node& node)
+{
+    if (node.inDocument())
+        return node.document();
+    Node* root = const_cast<Node*>(&node);
+    while (Node* host = root->shadowHost())
+        root = host;
+    while (Node* ancestor = root->parentNode())
+        root = ancestor;
+    ASSERT(!root->shadowHost());
+    return *root;
+}
