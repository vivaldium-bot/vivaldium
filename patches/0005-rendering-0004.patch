+typedef HashMap<AtomicString, AtomicString> Namespaces;
+
+enum EntityMask {
+    EntityAmp = 0x0001,
+    EntityLt = 0x0002,
+    EntityGt = 0x0004,
+    EntityQuot = 0x0008,
+    EntityNbsp = 0x0010,
