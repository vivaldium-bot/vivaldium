+#ifndef ShadowRoot_h
+#define ShadowRoot_h
+
+#include "core/CoreExport.h"
+#include "core/dom/ContainerNode.h"
+#include "core/dom/DocumentFragment.h"
+#include "core/dom/Element.h"
