+void EditingStyle::overrideWithStyle(const StylePropertySet* style)
+{
+    if (!style || style->isEmpty())
+        return;
+    if (!m_mutableStyle)
+        m_mutableStyle = MutableStylePropertySet::create();
+    m_mutableStyle->mergeAndOverrideOnConflict(style);
+    extractFontSizeDelta();
+}
