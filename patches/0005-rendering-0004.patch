+namespace blink {
+
+class NthIndexCacheTest : public ::testing::Test {
+protected:
+    void SetUp() override;
+
+    Document& document() const { return m_dummyPageHolder->document(); }
+    void setHtmlInnerHTML(const char* htmlContent);
