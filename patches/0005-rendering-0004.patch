index 0000000000000000000000000000000000000000..4b65c887575e74c5226c83e07c2786aecc426165
--- /dev/null
+++ b/third_party/WebKit/Source/core/dom/SpaceSplitString.cpp
@@ -0,0 +1,206 @@
+/*
+ * Copyright (C) 2007 David Smith (catfish.man@gmail.com)
+ * Copyright (C) 2007, 2008, 2011, 2012 Apple Inc. All rights reserved.
+ *
+ * This library is free software; you can redistribute it and/or
