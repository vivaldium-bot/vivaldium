+#include "config.h"
+#include "core/editing/InputMethodController.h"
+
+#include "core/events/CompositionEvent.h"
+#include "core/dom/Document.h"
+#include "core/dom/Element.h"
+#include "core/dom/Range.h"
+#include "core/dom/Text.h"
