-function moveByCharacterPositions(element) {
-  selection.collapse(element, 0);
-  var result = [];
-  var last = { node: selection.anchorNode, offset: selection.anchorOffset };
-  for (;;) {
-    result.push(selectedNodeAsText());
-    selection.modify("move", "left", "character");
