-    eventSender.mouseMoveTo(pos.x + CHAR_WIDTH * 4, pos.y + LINE_HEIGHT / 2);
-    eventSender.mouseDown();
-    eventSender.leapForward(1);
-    eventSender.mouseUp();
-    eventSender.leapForward(50);
-    eventSender.mouseDown();
