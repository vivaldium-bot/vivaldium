-    def expand_nonfinite(method, argstr, tail):
-        """
-        >>> print expand_nonfinite('f', '<0 a>, <0 b>', ';')
-        f(a, 0);
-        f(0, b);
-        f(a, b);
-        >>> print expand_nonfinite('f', '<0 a>, <0 b c>, <0 d>', ';')
