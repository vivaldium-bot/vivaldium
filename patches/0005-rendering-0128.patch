-    let promiseReject;
-    this.promise = new Promise(function(resolve, reject) {
-      promiseResolve = resolve;
-      promiseReject = reject;
-    });
-    this.resolve = promiseResolve;
-    this.reject = promiseReject;
-  }
-
-  static createResolvers(count) {
-    let result = [];
