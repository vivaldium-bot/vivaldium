+struct ComputeSubRange
+{
+	template <typename T>
+	void operator() (de::Random& rnd, T dstMin, T dstMax, T& aMin, T& aMax, T& bMin, T& bMax) const;
+};
+
+struct EvaluateSub
+{
+	template <typename T> inline T operator() (T a, T b) const { return a-b; }
+};
