+GlxVisual::GlxVisual (GlxDisplay& display, GLXFBConfig fbConfig)
+	: m_display		(display)
+	, m_visual		(DE_NULL)
+	, m_fbConfig	(fbConfig)
+{
+	XVisualInfo* visualInfo = glXGetVisualFromFBConfig(getXDisplay(), fbConfig);
+	if (visualInfo != DE_NULL)
+	{
+		m_visual = visualInfo->visual;
+		XFree(visualInfo);
+	}
+}
