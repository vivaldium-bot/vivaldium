+			EGL_STENCIL_SIZE,
+			EGL_SURFACE_TYPE,
+			EGL_TRANSPARENT_TYPE,
+//			EGL_TRANSPARENT_RED_VALUE,
+//			EGL_TRANSPARENT_GREEN_VALUE,
+//			EGL_TRANSPARENT_BLUE_VALUE
+		};
+		randomGroup->addChild(new ChooseConfigRandomCase(m_eglTestCtx, "all", "All attributes", toSet(allAttribs)));
+	}
+}
+
+} // egl
+} // deqp
