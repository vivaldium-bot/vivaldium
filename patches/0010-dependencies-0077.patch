+SwapBuffersWithDamageAndBufferAgeTest::SwapBuffersWithDamageAndBufferAgeTest (EglTestContext&			eglTestCtx,
+																			  const vector<DrawType>&	frameDrawType,
+																			  int						iterationTimes,
+																			  ResizeType				resizeType,
+																			  const char*				name,
+																			  const char*				description)
