diff --git a/third_party/grpc/include/grpc/support/avl.h b/third_party/grpc/include/grpc/support/avl.h
new file mode 100644
index 0000000000000000000000000000000000000000..f5bf32c71901c147a5299d31e83e1f7187a1799c
--- /dev/null
+++ b/third_party/grpc/include/grpc/support/avl.h
@@ -0,0 +1,97 @@
