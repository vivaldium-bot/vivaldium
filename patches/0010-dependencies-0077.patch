+	{
+		EGL_RENDERABLE_TYPE,	EGL_OPENGL_ES2_BIT,
+		EGL_SURFACE_TYPE,		EGL_WINDOW_BIT,
+		EGL_RED_SIZE,			8,
+		EGL_BLUE_SIZE,			8,
+		EGL_GREEN_SIZE,			8,
+		EGL_ALPHA_SIZE,			8,
+		EGL_DEPTH_SIZE,			8,
