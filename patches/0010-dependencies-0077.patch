+#ifndef _RRPRIMITIVEASSEMBLER_HPP
+#define _RRPRIMITIVEASSEMBLER_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Reference Renderer
+ * -----------------------------------------------
