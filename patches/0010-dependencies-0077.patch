+# Basic platform detection
+HOST_SYSTEM = $(shell uname | cut -f 1 -d_)
+SYSTEM ?= $(HOST_SYSTEM)
+ifeq ($(SYSTEM),MSYS)
+SYSTEM = MINGW32
+endif
+ifeq ($(SYSTEM),MINGW64)
+SYSTEM = MINGW32
+endif
