+	std::vector<const char*> charPtrs(filenames.size());
+	for (int ndx = 0; ndx < (int)filenames.size(); ndx++)
+		charPtrs[ndx] = filenames[ndx].c_str();
+
+	return Texture2D::create(context, contextInfo, archive, numLevels, &charPtrs[0]);
+}
