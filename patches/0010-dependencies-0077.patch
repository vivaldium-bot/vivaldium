+++ b/third_party/deqp/src/framework/delibs/dethread/win32/deMutexWin32.c
@@ -0,0 +1,130 @@
+/*-------------------------------------------------------------------------
+ * drawElements Thread Library
+ * ---------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
