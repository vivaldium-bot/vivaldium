+		const int* val = deTestHash_find(hash, (deInt16)i);
+		if (deInBounds32(i, 1000, 5000))
+			DE_TEST_ASSERT(val && (*val == -i));
+		else
+			DE_TEST_ASSERT(!val);
+	}
+
+	/* Test insert() after delete(). */
+	for (i = 10000; i < 12000; i++)
+		deTestHash_insert(hash, (deInt16)i, -i);
