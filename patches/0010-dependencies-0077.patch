+{
+	return mode == GL_FUNC_ADD				||
+		   mode == GL_FUNC_SUBTRACT			||
+		   mode == GL_FUNC_REVERSE_SUBTRACT	||
+		   mode == GL_MIN					||
+		   mode == GL_MAX;
+}
