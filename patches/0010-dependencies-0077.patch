+
+	// Check different sized pbuffers and use them
+	{
+		MemoryStressCase::Spec spec;
+
+		spec.types		= OBJECTTYPE_PBUFFER;
+		spec.minWidth	= 64;
+		spec.minHeight	= 64;
+		spec.maxWidth	= 1024;
+		spec.maxHeight	= 1024;
+		spec.use		= true;
+
+		addChild(new MemoryStressCase(m_eglTestCtx, spec, "pbuffer_use", "PBuffer allocation stress tests"));
+	}
