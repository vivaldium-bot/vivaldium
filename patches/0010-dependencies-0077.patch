+static bool isValidCompareFunc (deUint32 func)
+{
+	switch (func)
+	{
+		case GL_NEVER:
+		case GL_LESS:
+		case GL_LEQUAL:
+		case GL_GREATER:
+		case GL_GEQUAL:
+		case GL_EQUAL:
+		case GL_NOTEQUAL:
+		case GL_ALWAYS:
+			return true;
+
+		default:
+			return false;
+	}
+}
+
+static bool isValidStencilOp (deUint32 op)
+{
+	switch (op)
+	{
+		case GL_KEEP:
+		case GL_ZERO:
+		case GL_REPLACE:
+		case GL_INCR:
+		case GL_INCR_WRAP:
+		case GL_DECR:
+		case GL_DECR_WRAP:
+		case GL_INVERT:
+			return true;
+
+		default:
+			return false;
+	}
+}
