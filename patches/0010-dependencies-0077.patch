+#ifndef _RRRENDERSTATE_HPP
+#define _RRRENDERSTATE_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Reference Renderer
+ * -----------------------------------------------
+ *
+ * Copyright 2014 The Android Open Source Project
