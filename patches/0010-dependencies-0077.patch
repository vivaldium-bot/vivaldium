+inline UVec4 clampedRGBA (const IVec4& rgba)
+{
+	return UVec4(de::clamp(rgba.x(), 0, 0xff),
+				 de::clamp(rgba.y(), 0, 0xff),
+				 de::clamp(rgba.z(), 0, 0xff),
+				 de::clamp(rgba.w(), 0, 0xff));
+}
