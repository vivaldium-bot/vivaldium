+class IndexBuffer : public Buffer
+{
+public:
+									IndexBuffer			(const RenderContext& context, IndexType indexType, int numIndices, const void* indices);
+									~IndexBuffer		(void);
+
+private:
+									IndexBuffer			(const IndexBuffer& other);
