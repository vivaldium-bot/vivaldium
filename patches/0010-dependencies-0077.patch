+	, m_window			(DE_NULL)
+	, m_eglContext		(EGL_NO_CONTEXT)
+	, m_seed			(deStringHash(name))
+	, m_iterationTimes	(iterationTimes)
+	, m_frameDrawType	(frameDrawType)
+	, m_resizeType		(resizeType)
+	, m_eglDisplay		(EGL_NO_DISPLAY)
