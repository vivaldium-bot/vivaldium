+void grpc_census_call_set_context(grpc_call *call, census_context *context) {
+  GRPC_API_TRACE("grpc_census_call_set_context(call=%p, census_context=%p)", 2,
+                 (call, context));
+  if (census_enabled() == CENSUS_FEATURE_NONE) {
+    return;
+  }
+  if (context != NULL) {
+    grpc_call_context_set(call, GRPC_CONTEXT_TRACING, context, NULL);
+  }
+}
+
+census_context *grpc_census_call_get_context(grpc_call *call) {
+  GRPC_API_TRACE("grpc_census_call_get_context(call=%p)", 1, (call));
+  return (census_context *)grpc_call_context_get(call, GRPC_CONTEXT_TRACING);
+}
diff --git a/third_party/grpc/src/core/ext/census/grpc_filter.c b/third_party/grpc/src/core/ext/census/grpc_filter.c
new file mode 100644
index 0000000000000000000000000000000000000000..9dacc17eb4af954b61ce971e0b90a25a816ef552
--- /dev/null
+++ b/third_party/grpc/src/core/ext/census/grpc_filter.c
@@ -0,0 +1,207 @@
