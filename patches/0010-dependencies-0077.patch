+std::vector<tcu::TestNode*> parseFile (const tcu::Archive& archive, const std::string& filename, ShaderCaseFactory* caseFactory)
+{
+	sl::ShaderParser	parser	(archive, filename, caseFactory);
+
+	return parser.parse();
+}
