+
+		DE_ASSERT(DE_FALSE);
+		return EGL_NONE;
+	}
+public:
+	ChooseConfigSimpleCase (EglTestContext& eglTestCtx, const char* name, const char* description, EGLenum attribute, bool checkOrder)
