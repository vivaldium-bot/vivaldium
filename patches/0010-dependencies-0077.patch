+#ifndef _GLUSHADERLIBRARY_HPP
+#define _GLUSHADERLIBRARY_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
+ * Copyright 2015 The Android Open Source Project
+ *
