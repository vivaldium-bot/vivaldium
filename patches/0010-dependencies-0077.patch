+enum TextureType
+{
+	TEXTURETYPE_2D = 0,
+	TEXTURETYPE_CUBE,
+	TEXTURETYPE_2D_ARRAY,
+	TEXTURETYPE_3D,
+	TEXTURETYPE_CUBE_ARRAY,
+	TEXTURETYPE_1D,
+	TEXTURETYPE_1D_ARRAY,
+	TEXTURETYPE_BUFFER,
