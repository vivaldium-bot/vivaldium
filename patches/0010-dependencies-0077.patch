+void deSemaphore_decrement (deSemaphore semaphore)
+{
+	sem_t*	sem	= (sem_t*)semaphore;
+	int		ret	= sem_wait(sem);
+	DE_ASSERT(ret == 0);
+	DE_UNREF(ret);
