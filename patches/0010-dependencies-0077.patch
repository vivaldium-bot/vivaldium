+#define WGL_SWAP_METHOD_ARB							0x2007
+#define WGL_NUMBER_OVERLAYS_ARB						0x2008
+#define WGL_NUMBER_UNDERLAYS_ARB					0x2009
+#define WGL_TRANSPARENT_ARB							0x200A
