+#ifndef _TEGLNATIVECOLORMAPPINGTESTS_HPP
+#define _TEGLNATIVECOLORMAPPINGTESTS_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program EGL Module
