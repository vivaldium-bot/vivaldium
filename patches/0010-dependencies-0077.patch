+tcu::FunctionLibrary* Platform::createDefaultGLFunctionLibrary (glu::ApiType apiType, const tcu::CommandLine&) const
+{
+	// \todo [2014-03-14 pyry] Do we want to implement tcu::DynamicFunctionLibrary-based fallback?
