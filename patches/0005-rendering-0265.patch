-            var success = Should(message, actual)
-              .beEqualToArray(expected);
-
-            Should(message, success)
-              .summarize(
-                "correctly clamped rolloffFactor to " + options.clampedRolloff,
-                "did not correctly clamp rolloffFactor to " + options.clampedRolloff);
-          });
-      }
