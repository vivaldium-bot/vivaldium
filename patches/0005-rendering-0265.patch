-  let offsets = new Array(numberOfNotes);
-
-  for (let k = 0; k < numberOfNotes; ++k) {
-    let timeOffset = k * timeStep;
-    let grainOffset = k * grainOffsetStep;
-
-    playGrain(context, source, timeOffset, grainOffset, duration);
