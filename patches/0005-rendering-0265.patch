-            maxError = Math.abs(diff);
-            errorPosition = i;
-        }
-
-        // The reference file is a 16-bit WAV file, so we will almost never get
-        // an exact match between it and the actual floating-point result.
-        if (Math.abs(diff) > scaleFactor)
-            diffCount++;
