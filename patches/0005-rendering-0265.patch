-    return {b0 : b0 * scale,
-            b1 : b1 * scale,
-            b2 : b2 * scale,
-            a1 : a1 * scale,
-            a2 : a2 * scale};
-}
-
-function createBandpassFilter(freq, q, gain) {
-    var b0;
-    var b1;
-    var b2;
-    var a0;
-    var a1;
-    var a2;
-    var coef;
