-
-  for (var k = 0; k < length; ++k) {
-    var t = (startFrame + k) / sampleRate;
-    var indexFloat = f * (t - startTime);
-    var index = Math.floor(indexFloat);
-    if (index + 1 < length) {
-      var v0 = curve[index];
-      var v1 = curve[index + 1];
-      array[k] = v0 + (v1 - v0) * (indexFloat - index);
