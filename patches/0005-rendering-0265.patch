-    while (this.numberOfGroups < this.N) {
-
-        if (this.notSwitchInput) {
-            this.iFFTRadix2Core(this.aReal, this.aImag, bReal, bImag);
-        } else {
-            this.iFFTRadix2Core(bReal, bImag, this.aReal, this.aImag);
-        }
