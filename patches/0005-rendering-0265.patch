-    while (this.numberOfGroups < this.N) {
-        if (this.notSwitchInput) {
-            this.FFTRadix2Core(this.aReal, this.aImag, bReal, bImag);
-        } else {
-            this.FFTRadix2Core(bReal, bImag, this.aReal, this.aImag);
-        }
