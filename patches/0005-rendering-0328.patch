+}
+
+function f12() {
+    return [,undefined];
+}
+
+function f13() {
+    return [,undefined,];
+}
+
+function f14() {
+    return [,undefined,,];
+}
+
+function f15() {
+    return [,,];
+}
+
+function f16() {
+    return [,,,];
+}
+
+shouldBe("typeof undefined", "'undefined'");
+
+unevalf = function(x) { return '(' + x.toString() + ')'; };
