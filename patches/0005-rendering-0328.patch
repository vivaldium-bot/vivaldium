+// ===========================================================================
+
+class NestingDistribution {
+  constructor(funktions) {
+    // Stores the nof bytes per function nesting level.
+    this.accumulator = [0, 0, 0, 0, 0];
+    // Max nof bytes encountered at any nesting level.
+    this.max = 0;
+    // avg bytes per nesting level.
+    this.avg = 0;
+    this.totalBytes = 0;
