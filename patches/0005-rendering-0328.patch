+description(
+"This test checks that toString() round-trip on a function that has a array with elision does not remove a comma."
+);
+
+function f1() {
+    return [,];
+}
+
+function f2() {
+    return [1];
+}
+
+function f3() {
+    return [1,];
+}
+
+// this is the first testcase that proves that trailing
+// elision comma is not removed
+function f4() {
+    return [1,,];
+}
+
+function f5() {
+    return [1,,,];
+}
+function f6() {
+    return [1,,,4];
+}
+
+function f7() {
+    return [,2,];
+}
+
+function f8() {
+    return [,2,,];
+}
+
+function f9() {
+    return [,2,,,5];
+}
+
+function f10() {
+    return [,,3,,,];
+}
+
+function f11() {
