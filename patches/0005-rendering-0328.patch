diff --git a/v8/tools/profview/profview.js b/v8/tools/profview/profview.js
new file mode 100644
index 0000000000000000000000000000000000000000..d480cd4a771bf87b86c9afff5f775f2b167367ee
--- /dev/null
+++ b/v8/tools/profview/profview.js
@@ -0,0 +1,1252 @@
+// Copyright 2017 the V8 project authors. All rights reserved.
