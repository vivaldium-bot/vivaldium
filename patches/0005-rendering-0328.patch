+  while (value > 1000 && unitIndex < units.length) {
+    value /= 1000;
+    unitIndex++;
+  }
+  let result = formatNumber(value).padStart(10) + ' ' + units[unitIndex];
+  if (total !== void 0 && total != 0) {
+    result += PERCENT(bytes, total).padStart(5);
+  }
+  return result;
