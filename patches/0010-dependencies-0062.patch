+vk::Move<vk::VkDeviceMemory> allocMemory (const vk::DeviceInterface&	vkd,
+										  vk::VkDevice					device,
+										  vk::VkDeviceSize				size,
+										  deUint32						memoryTypeIndex)
+{
+	const vk::VkMemoryAllocateInfo alloc =
+	{
+		vk::VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,	// sType
+		DE_NULL,									// pNext
+
+		size,
+		memoryTypeIndex
+	};
+
