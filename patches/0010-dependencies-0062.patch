+	if (usage & USAGE_TRANSFER_DST)
+		return true;
+
+	if (usage & USAGE_STORAGE_IMAGE)
+		return true;
+
+	if (usage & USAGE_COLOR_ATTACHMENT)
+		return true;
+
+	return false;
+}
