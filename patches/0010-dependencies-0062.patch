+			}
+			{
+				// Fragment storage image
+				const char* const fragmentShader =
+					"#version 450\n"
+					"#extension GL_EXT_texture_buffer : require\n"
+					"precision highp float;\n"
+					"layout(set=0, binding=0, rgba8) uniform image2D u_image;\n"
