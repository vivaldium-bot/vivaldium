+					0u,
+					1u
+				}
+			};
+
+			m_imageView = vk::createImageView(vkd, device, &createInfo);
+		}
+
+		{
+			const vk::VkSamplerCreateInfo createInfo =
+			{
+				vk::VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+				DE_NULL,
