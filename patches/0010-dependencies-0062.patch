+void addCopyImageTestsAllFormats (tcu::TestCaseGroup*	testCaseGroup,
+								  tcu::TestContext&		testCtx,
+								  TestParams&			params)
+{
+	const VkFormat	compatibleFormats8Bit[]			=
+	{
+		VK_FORMAT_R4G4_UNORM_PACK8,
