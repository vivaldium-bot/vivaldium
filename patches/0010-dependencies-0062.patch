+	reference.setUndefined(0, (size_t)m_imageMemorySize);
+
+	{
+		const PixelBufferAccess&	refAccess	(context.getReferenceImage().getAccess());
+
+		for (deInt32 y = 0; y < m_imageHeight; y++)
