+	const deUint32									m_queueFamilyIndex;
+	const vector<pair<deUint32, vk::VkQueue> >		m_queues;
+	const vk::Unique<vk::VkCommandPool>				m_commandPool;
+	const vk::ProgramCollection<vk::ProgramBinary>&	m_binaryCollection;
