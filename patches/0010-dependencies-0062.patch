+deUint32 getTargetLayer (const ImageParams& imageParams)
+{
+	if (imageParams.viewType == VK_IMAGE_VIEW_TYPE_3D)
+		return imageParams.size.depth / 2;
+	else
+		return imageParams.numLayers / 2;
