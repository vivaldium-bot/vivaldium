+  # WebKit.grd can be in two different places depending on whether we are
+  # in a chromium checkout or a webkit-only checkout.
+  "third_party/WebKit/Source/WebKit/chromium/WebKit.grd": {
+    "includes": [7000],
+  },
+  "WebKit.grd": {
+    "includes": [7000],
