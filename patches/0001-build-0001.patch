+bool __equivalent(const path& p1, const path& p2, std::error_code *ec)
+{
+    std::error_code ec1, ec2;
+    struct ::stat st1 = {};
+    struct ::stat st2 = {};
+    auto s1 = detail::posix_stat(p1.native(), st1, &ec1);
+    auto s2 = detail::posix_stat(p2.native(), st2, &ec2);
