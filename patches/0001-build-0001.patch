+locale&
+locale::__imp::make_global()
+{
+    // only one thread can get in here and it only gets in once
+    static aligned_storage<sizeof(locale)>::type buf;
+    auto *obj = ::new (&buf) locale(locale::classic());
+    return *obj;
+}
