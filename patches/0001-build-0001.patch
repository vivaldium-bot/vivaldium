+    include_node.StartParsing(u'include', includes)
+    include_node.HandleAttribute(u'file', ur'flugel\kugel.pdf')
+    include_node.HandleAttribute(u'use_base_dir', u'false')
+    includes.AddChild(include_node)
+    root.EndParsing()
