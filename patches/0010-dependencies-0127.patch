+
+/**
+ *  Subclass of SkBaseDevice, which directs all drawing to the GrGpu owned by the
+ *  canvas.
+ */
+class SK_API SkGpuDevice : public SkBaseDevice {
+public:
+    enum InitContents {
+        kClear_InitContents,
+        kUninit_InitContents
+    };
+
+    /**
+     * Creates an SkGpuDevice from a GrRenderTarget.
+     */
