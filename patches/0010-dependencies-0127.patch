diff --git a/third_party/libphonenumber/dist/tools/java/java-build/src/com/google/i18n/phonenumbers/BuildMetadataJsonFromXml.java b/third_party/libphonenumber/dist/tools/java/java-build/src/com/google/i18n/phonenumbers/BuildMetadataJsonFromXml.java
