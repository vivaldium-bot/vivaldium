+#endif
+#ifdef HAVE_NEON_AARCH64
+  if (iCpu & WELS_CPU_NEON) {
+    *pfSetNZCZero = WelsNonZeroCount_AArch64_neon;
+  }
+#endif
+#if defined(X86_ASM)
+  if (iCpu & WELS_CPU_SSE2) {
+    *pfSetNZCZero = WelsNonZeroCount_sse2;
+  }
+#endif
+}
