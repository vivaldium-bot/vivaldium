+int32_t   iPreviousBitrate;
+int32_t   iPreviousGopSize;
+double    fFrameRate;
+int32_t   iBitsPerFrame;
+int32_t   iMaxBitsPerFrame;
+double    dPreviousFps;
+
+// bits allocation and status
+int32_t   iRemainingBits;
