+    vpadd.u16 d0, d0, d1
+    vpaddl.u16 d0, d0
+    vmov r11, r12, d0
+    subs r10, r12
+    add r0, r10, r11
+
+    strh r0, [r1] // sum -> pFeatureOfBlock[i]
+
+    add r1, r5, r0, lsl #2
+    ldr r0, [r1]
+    add r0, #1
+    str r0, [r1]
+    subs r7, #1
+    bne _width_loop8x8_2
+
+    add r8, r3
+    add r4, r4, r6, lsl #1
+    subs r2, #1
+    bne _height_loop8x8
+_SumOf8x8BlockOfFrame_end:
+    ldmia sp!, {r4-r12}
+WELS_ASM_FUNC_END
