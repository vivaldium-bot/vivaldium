+#include "SkSpinlock.h"
+
+void SkPODSpinlock::contendedAcquire() {
+    // To act as a mutex, we need an acquire barrier when we take the lock.
+    while(sk_atomic_exchange(&fLocked, true, sk_memory_order_acquire)) { /*spin*/ }
+}
