+#define NO_OUTPUT_MODE //define to disable the output yuv file
+
+extern int DecMain(int argc, char * argv[]);
+
+#import "DEMOViewController.h"
+#import "DEMOViewControllerShowResource.h"
+
+@interface DEMOViewController ()
+
