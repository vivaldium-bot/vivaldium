+bool SkMemoryStream::move(long offset) {
+    return this->seek(fOffset + offset);
+}
+
+SkMemoryStream* SkMemoryStream::fork() const {
+    SkAutoTDelete<SkMemoryStream> that(this->duplicate());
+    that->seek(fOffset);
+    return that.detach();
