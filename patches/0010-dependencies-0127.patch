+    ldr         r2, [sp, #0]
+    vst1.s16    d1, [r2]        // store to block
+
+    mov         r1, #1
+    vdup.s16    d3, r1
+    DC_ZERO_COUNT_IN_DUALWORD   d1, d0, d3
+
+    vmov    r0, r1, d0
+    and     r0, #0x07       // range [0~4]
+    rsb     r0, #4
+WELS_ASM_FUNC_END
+
+
+WELS_ASM_FUNC_BEGIN WelsHadamardQuant2x2SkipKernel_neon
+
+    vdup.s16    d3, r1
+    mov         r1, #32
