+    pmaddubsw        xmm3, xmm7
+    movq             xmm4, [r2+2*r3]
+    punpcklqdq       xmm4, xmm4
+    pmaddubsw        xmm4, xmm7
+    movq             xmm5, [r2+r5]
+    punpcklqdq       xmm5, xmm5
+    pmaddubsw        xmm5, xmm7
+    psubsw           xmm2, xmm4
+    psubsw           xmm3, xmm5
