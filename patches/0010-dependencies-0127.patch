+    umull2 v7.8h, v6.16b, v6.16b
+    uadalp v4.4s, v5.8h //sqr
+    uadalp v4.4s, v7.8h //sqr
+
+    //v2 save sum
+    uadalp v2.8h, v6.16b
+
+    //v3 save sqr_cur
