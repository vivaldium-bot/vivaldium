+    movdqa       %3, %1
+    punpcklqdq   %1, %2
+    punpckhqdq   %3, %2
+;    paddd        xmm4, %1 ;for dc
+;    paddd        xmm4, %3 ;for dc
+    movdqa       %4, %1
+    punpcklqdq   %4, %3
+    packssdw     %1, %3
+    psllw        %1, 2
+%endmacro
