+    pshufb      xmm6,xmm1
+    movdqa      %1,  xmm6
+    movdqa      xmm0,%2
+    psadbw      xmm0,xmm7
+    paddw       xmm4,xmm0
+    movdqa      xmm0,%2
+    psadbw      xmm0,xmm5
+    paddw       xmm2,xmm0
+    psadbw      xmm6,%2
+    paddw       xmm3,xmm6
+%endmacro
+%macro WelsAddDCValue 4
+    movzx   %2, byte %1
+    mov    %3, %2
+    add     %4, %2
+%endmacro
