index 0000000000000000000000000000000000000000..17d2d7f727d9abb5fd6f441fb1d559bd2810a74d
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/state_trackers/xa/xa_composite.c
@@ -0,0 +1,547 @@
+/**********************************************************
