+
+    if (iAvailCount == 9 || iAvailCount == 7) {
+      //I4_PRED_DC(2)
+
+      iBestMode = I4_PRED_DC;
+
+      pDst = &pMbCache->pMemPredBlk4[iBestPredBufferNum << 4];
