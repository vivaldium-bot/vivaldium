diff --git a/third_party/libphonenumber/dist/tools/java/common/src/com/google/i18n/phonenumbers/BuildMetadataFromXml.java b/third_party/libphonenumber/dist/tools/java/common/src/com/google/i18n/phonenumbers/BuildMetadataFromXml.java
