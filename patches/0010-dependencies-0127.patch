+    MoveWindow(m_hWnd,0,0,pInfo->UsrData.sSystemBuffer.iWidth,pInfo->UsrData.sSystemBuffer.iHeight,true);
+    SAFE_RELEASE (m_lpD3D9RawSurfaceShare);
