index 0000000000000000000000000000000000000000..340229b1ce3cac6b5bea0d92e9b07b562804b5d2
--- /dev/null
+++ b/third_party/libsrtp/srtp/ekt.c
@@ -0,0 +1,258 @@
+/*
+ * ekt.c
+ *
+ * Encrypted Key Transport for SRTP
+ * 
+ * David McGrew
+ * Cisco Systems, Inc.
+ */
+/*
+ *	
