+    punpckldq  xmm5, xmm7
+    punpcklqdq xmm2, xmm5 ;-1
+    movd       xmm7, [r2+1]
+    punpckldq  xmm6, xmm7
+    punpcklqdq xmm3, xmm6 ;+1
+    movd       xmm6, [r2]
+    movd       xmm7, [r2+r3]
+    punpckldq  xmm6, xmm7
+    punpcklqdq xmm4, xmm6 ;+L
