+
+#include "src/xml/xml.pb.h"
+
+namespace protobuf_mutator {
+namespace xml {
+
+namespace {
+
+class XmlWriter {
+ public:
+  XmlWriter();
+  std::string ToXml(const Document& doc);
+
+ private:
+  void ToXml(const std::string& name, const std::string& value);
+  void ToXml(const Element& element);
