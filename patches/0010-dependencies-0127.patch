+//  normal case: {cA*src[x]  + cB*src[x+1]} + {cC*src[x+stride] + cD*srcp[x+stride+1]}
+//  we can opti it by adding vert only/ hori only cases, to be continue
+    vld1.u8 {d31}, [r4]     //load A/B/C/D
+
+    vdup.u8 d28, d31[0]         //A
