+    SSE41_HSum8W     xmm5, xmm0, xmm1
+    SSE41_HSum8W     xmm6, xmm0, xmm1
+    ; comparing order: DC H V
+    movd      r3d, xmm6 ;DC
+    movd      r1d, xmm5 ;H
+    movd      r0d, xmm4 ;V
+
+
+    shl       r5d, 1
+    add       r1d, r5d
+    add       r0d, r5d
+    cmp       r3d, r1d
+    jge near   not_dc_8x8
+    cmp        r3d, r0d
+    jge near   not_dc_h_8x8
+
