+    movhlps    xmm0, xmm2
+    paddw      xmm2, xmm0
+    movhlps    xmm0, xmm3
+    paddw      xmm3, xmm0
+    movhlps    xmm0, xmm4
+    paddw      xmm4, xmm0
+    punpckldq  xmm1, xmm4
+    punpckldq  xmm2, xmm3
+    punpcklqdq xmm1, xmm2
+    movdqa     [r4],xmm1
