+;***********************************************************************
+; Local Data (Read Only)
+;***********************************************************************
+SECTION .rodata align=16
+
+ALIGN 16
+mv_x_inc_x4     dw  0x10, 0x10, 0x10, 0x10
+mv_y_inc_x4     dw  0x04, 0x04, 0x04, 0x04
