+
+    movd      mm3, [r2]
+    movd      mm4, [r2+r3]
+    punpckldq mm3, mm4
+    psadbw    mm0, mm3
+
+    lea       r0, [r0+2*r1]
+    lea       r2, [r2+2*r3]
+
+    movd      mm1, [r0]
