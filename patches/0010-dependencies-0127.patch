+bool EllipticalRRectEffect::onIsEqual(const GrFragmentProcessor& other) const {
+    const EllipticalRRectEffect& erre = other.cast<EllipticalRRectEffect>();
+    return fEdgeType == erre.fEdgeType && fRRect == erre.fRRect;
+}
