+vpx_img_fmt_t CspForFrameNumber(int frame) {
+  if (frame < 10) return VPX_IMG_FMT_I420;
+  if (frame < 20) return VPX_IMG_FMT_I444;
+  return VPX_IMG_FMT_I420;
+}
