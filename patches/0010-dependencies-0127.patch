+    vld1.u8     {q0}, [r0], r1  //src[x]
+
+    vdup.u8 d28, d31[0]         //A
+    vdup.u8 d29, d31[1]         //B
+    vdup.u8 d30, d31[2]         //C
+    vdup.u8 d31, d31[3]         //D
+
+    vext.u8     d1, d0, d1, #1      //src[x+1]
+
+w8_mc_chroma_loop:  // each two pxl row
+    vld1.u8     {q1}, [r0], r1  //src[x+stride]
+    vld1.u8     {q2}, [r0], r1  //src[x+2*stride]
