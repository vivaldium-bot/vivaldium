+;*******************************************************************************
+WELS_EXTERN McHorVer20WidthEq16_sse2
+    %assign  push_num 0
+    LOAD_5_PARA
+    PUSH_XMM 8
+    SIGN_EXTENSION  r1, r1d
+    SIGN_EXTENSION  r3, r3d
+    SIGN_EXTENSION  r4, r4d
+    lea r0, [r0-2]            ;pSrc -= 2;
+
+    pxor xmm7, xmm7
+    movdqa xmm6, [h264_w0x10_1]
+.y_loop:
+
+    movq xmm0, [r0]
+    punpcklbw xmm0, xmm7
+    movq xmm1, [r0+5]
