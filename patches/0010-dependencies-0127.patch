+  iIdexA = CLIP3_QP_0_51(iIdexA);\
+  iAlpha = g_kuiAlphaTable(iIdexA);\
+  iBeta  = g_kiBetaTable((CLIP3_QP_0_51(QP + iBetaOffset)));\
