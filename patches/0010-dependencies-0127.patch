+_height_loop8x8:
+    mov r7, r6
+_width_loop8x8_2:
+    subs r0, r8, r7
+    subs r1, r4, r7, lsl #1
+
+    subs r9, r1, r6, lsl #1 // last line of pFeatureOfBlock[i]
+    ldrh  r10, [r9] // sum of last line of pFeatureOfBlock[i]
+
+    subs r11, r0, r3
+    vld1.64 {d1}, [r11]
+    add r0, r11, r3, lsl #3
+    vld1.64 {d0}, [r0] //
