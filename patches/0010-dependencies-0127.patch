+/* Sequence Parameter Set, refer to Page 57 in JVT X201wcm */
+typedef struct TagWelsSPS {
+uint32_t        uiSpsId;
+int16_t         iMbWidth;
+int16_t         iMbHeight;
+uint32_t        uiLog2MaxFrameNum;
+// uint32_t        uiPocType;
