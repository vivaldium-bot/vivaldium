index 0000000000000000000000000000000000000000..1ad23e3ca00ffb170787e915b1e85bd5739e32e4
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/winsys/radeon/drm/radeon_drm_cs.c
@@ -0,0 +1,567 @@
+/*
+ * Copyright © 2008 Jérôme Glisse
+ * Copyright © 2010 Marek Olšák <maraeo@gmail.com>
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining
