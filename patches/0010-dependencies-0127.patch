+
+  if (NULL == pCurPicture || NULL == kpFileName)
+    return;
+
+  if (strlen (kpFileName) > 0) { // confirmed_safe_unsafe_usage
+    pDumpRecFile = WelsFopen (kpFileName, openMode);
+  } else {
+    pDumpRecFile = WelsFopen ("rec.yuv", openMode);
+  }
+  if (NULL != pDumpRecFile && bAppend)
