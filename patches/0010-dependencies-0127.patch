diff --git a/third_party/libsrtp/run_all_tests.sh b/third_party/libsrtp/run_all_tests.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a93f5ec7d02034b81e7f363fc3b7b2835a9be557
--- /dev/null
+++ b/third_party/libsrtp/run_all_tests.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+
+BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+run_all_tests() {
+  export LD_LIBRARY_PATH="${BASE}/.."  # libboringssl.so
+
+  # rtwp_test.sh and rtpw_test_gcm.sh expect to run ./rtpw
+  pushd "${BASE}"
+
+  ./cipher_driver -v &&
+    ./datatypes_driver -v &&
+    ./dtls_srtp_driver &&
+    ./kernel_driver -v &&
+    ./rdbx_driver -v &&
+    ./replay_driver -v &&
+    ./roc_driver -v &&
+    ./srtp_driver -v &&
+    ./rtpw_test.sh &&
+    ./rtpw_test_gcm.sh
+}
+
+(run_all_tests && echo PASSED) || echo FAILED
diff --git a/third_party/libsrtp/srtp/ekt.c b/third_party/libsrtp/srtp/ekt.c
