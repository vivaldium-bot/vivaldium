+%macro SSE41_GetSatd8x4 0
+    movq             xmm0, [r0]
+    punpcklqdq       xmm0, xmm0
+    pmaddubsw        xmm0, xmm7
+    movq             xmm1, [r0+r1]
+    punpcklqdq       xmm1, xmm1
+    pmaddubsw        xmm1, xmm7
+    movq             xmm2, [r2]
+    punpcklqdq       xmm2, xmm2
+    pmaddubsw        xmm2, xmm7
+    movq             xmm3, [r2+r3]
+    punpcklqdq       xmm3, xmm3
+    pmaddubsw        xmm3, xmm7
+    psubsw           xmm0, xmm2
+    psubsw           xmm1, xmm3
+    movq             xmm2, [r0+2*r1]
