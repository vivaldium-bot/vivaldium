+int32_t   iTotalMbSlice;
+int32_t   iTargetBitsSlice;
+int32_t   iBsPosSlice;
+int32_t   iFrameBitsSlice;
+int32_t   iGomBitsSlice;
+int32_t   iGomTargetBits;
+//int32_t   gom_coded_mb;
+} SRCSlicing;
+
+typedef struct TagRCTemporal {
+int32_t   iMinBitsTl;
+int32_t   iMaxBitsTl;
+int32_t   iTlayerWeight;
+int32_t   iGopBitsDq;
