diff --git a/third_party/openh264/src/build/gtest-targets.mk b/third_party/openh264/src/build/gtest-targets.mk
new file mode 100644
index 0000000000000000000000000000000000000000..fe7119688b50f7d80d8dde10f958357d6c9dea86
--- /dev/null
+++ b/third_party/openh264/src/build/gtest-targets.mk
@@ -0,0 +1,17 @@
+GTEST_SRCDIR=gtest
+GTEST_CPP_SRCS=\
+	$(GTEST_SRCDIR)/src/gtest-all.cc\
+
+GTEST_OBJS += $(GTEST_CPP_SRCS:.cc=.$(OBJ))
+
+OBJS += $(GTEST_OBJS)
+
+$(GTEST_SRCDIR)/%.$(OBJ): $(GTEST_SRCDIR)/%.cc
+	$(QUIET_CXX)$(CXX) $(CFLAGS) $(CXXFLAGS) $(INCLUDES) $(GTEST_CFLAGS) $(GTEST_INCLUDES) -c $(CXX_O) $<
+
+$(LIBPREFIX)gtest.$(LIBSUFFIX): $(GTEST_OBJS)
