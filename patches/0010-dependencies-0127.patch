index 0000000000000000000000000000000000000000..7b1cc8c86fbd6414e59bbabcdf2ad6d8c95663e1
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/winsys/sw/xlib/SConscript
@@ -0,0 +1,23 @@
+#######################################################################
+# SConscript for xlib winsys
+
+
+Import('*')
+
+if env['platform'] in ('cygwin', 'freebsd', 'linux', 'sunos'):
+
+    env = env.Clone()
+
