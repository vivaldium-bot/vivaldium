+   (*compose)( struct pipe_screen *screen,
+               struct pipe_resource *res,
+               struct stw_shared_surface *dest,
+               LPCRECT pRect,
+               ULONGLONG PresentHistoryToken );
+};
+
+boolean
+stw_init(const struct stw_winsys *stw_winsys);
+
+boolean
+stw_init_thread(void);
+
+void
+stw_cleanup_thread(void);
+
+void
+stw_cleanup(void);
+
+#endif /* STW_WINSYS_H */
diff --git a/third_party/mesa/src/src/gallium/state_trackers/xa/Makefile b/third_party/mesa/src/src/gallium/state_trackers/xa/Makefile
