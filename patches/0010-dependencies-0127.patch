+    lsl r5, r5, #4 //r5 keeps the little step
+
+    lsl r6, r4, #4
+    sub r6, r2, r6  //r6 keeps the big step
+
+    ldr r7,     [sp, #84]   //psadframe
+    ldr r8,     [sp, #88]   //psad8x8
+    ldr r9,     [sp, #92]   //psum16x16
+    ldr r10,    [sp, #96]   //psqsum16x16
