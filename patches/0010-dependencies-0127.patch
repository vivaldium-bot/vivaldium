+    SAD_SSD_16_RESET_8x8 \arg0, \arg1, \arg2, q7
+    SAD_SSD_16 \arg0, \arg1, \arg2, q7
+    SAD_SSD_16 \arg0, \arg1, \arg2, q7
+    SAD_SSD_16 \arg0, \arg1, \arg2, q7
+    SAD_SSD_16 \arg0, \arg1, \arg2, q7
