diff --git a/third_party/libvpx/source/libvpx/solution.mk b/third_party/libvpx/source/libvpx/solution.mk
new file mode 100644
index 0000000000000000000000000000000000000000..145adc0ddad33217570108eb71df69203ea11abc
--- /dev/null
