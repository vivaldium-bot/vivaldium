index 0000000000000000000000000000000000000000..81268b83953abe3c768a5113b7f1c51da0d57ca1
--- /dev/null
+++ b/third_party/mesa/src/src/getopt/getopt_long.c
@@ -0,0 +1,511 @@
+/*	$OpenBSD: getopt_long.c,v 1.24 2010/07/22 19:31:53 blambert Exp $	*/
+/*	$NetBSD: getopt_long.c,v 1.15 2002/01/31 22:43:40 tv Exp $	*/
