+  "test/cpp-build/generate_geocoding_data_test.cc"
+  "test/cpp-build/run_tests.cc"
+)
+
+set (TEST_LIBS ${GTEST_LIB})
+
+if (NOT WIN32)
+  list (APPEND TEST_LIBS pthread)
+endif ()
+
+# Build the testing binary.
+include_directories ("test")
