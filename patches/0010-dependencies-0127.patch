+    uadalp v4.4s, v3.8h //sqr
+    uaddlp v2.8h, v2.16b //sum
+
+    uaddlp v1.8h, v0.16b //sum_cur
+
+    umull  v3.8h, v0.8b, v0.8b
+    umull2 v5.8h, v0.16b, v0.16b
