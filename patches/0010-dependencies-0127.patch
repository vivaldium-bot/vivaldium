+CUtils::CUtils() {
+  hHandle = NULL;
+  iOSType = CheckOS();
+
+#ifdef ENABLE_DISPLAY_MODULE
+  if (iOSType == OS_XP)
+    hHandle = (void*) new CD3D9Utils;
+
+  else if (iOSType == OS_VISTA_UPPER)
+    hHandle = (void*) new CD3D9ExUtils;
+#endif
+
+  if (hHandle == NULL)
+    iOSType = OS_UNSUPPORTED;
+}
