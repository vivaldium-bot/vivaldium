+
+bool SkProcCoeffXfermode::asFragmentProcessor(const GrFragmentProcessor** fp,
+                                              const GrFragmentProcessor* dst) const {
+    if (fp) {
+        SkASSERT(dst);
+        *fp = GrXfermodeFragmentProcessor::CreateFromDstProcessor(dst, fMode);
