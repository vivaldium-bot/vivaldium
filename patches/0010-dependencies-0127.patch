+WELS_ASM_FUNC_BEGIN VAACalcSadVar_neon
+    stmdb sp!, {r4-r11}
+    vpush {q4}
+    vpush {q6-q7}
+
+    ldr r4, [sp, #80] //r4 keeps the pic_stride
+
