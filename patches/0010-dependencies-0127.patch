+
+;*******************************************************************************
+; void McHorVer20WidthEq16_sse2(  const uint8_t *pSrc,
+;                       int iSrcStride,
+;                                               uint8_t *pDst,
+;                                               int iDstStride,
+;                                               int iHeight,
