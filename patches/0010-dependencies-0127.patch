+        return a.fWidth == b.fWidth
+            && a.fMiter == b.fMiter
+            && a.fCap   == b.fCap
+            && a.fJoin  == b.fJoin;
+    }
+
+    // The default SkGoodHash works fine for Stroke, as it's dense.
+    static_assert(sizeof(Stroke) == offsetof(Stroke, fJoin) + sizeof(Stroke().fJoin), "");
