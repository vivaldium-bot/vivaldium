+
+   graw_set_display_func(draw);
+   /*graw_set_reshape_func(resize);*/
+   graw_main_loop();
+   return 0;
+}
diff --git a/third_party/mesa/src/src/gallium/tests/graw/fs-test.c b/third_party/mesa/src/src/gallium/tests/graw/fs-test.c
