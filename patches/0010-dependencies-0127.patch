+GrResourceProvider::GrResourceProvider(GrGpu* gpu, GrResourceCache* cache, GrSingleOwner* owner)
+    : INHERITED(gpu, cache, owner) {
+    GR_DEFINE_STATIC_UNIQUE_KEY(gQuadIndexBufferKey);
