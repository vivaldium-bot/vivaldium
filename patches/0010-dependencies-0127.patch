+.macro DC_ZERO_COUNT_IN_DUALWORD arg0, arg1, arg2
+//  {   //  input:  coef, dst_d, working_d (all 0x01)
+    cmeq    \arg0\().4h, \arg0\().4h, #0
+    and     \arg0\().8b, \arg0\().8b, \arg2\().8b
+    addv    \arg1\(), \arg0\().4h
