+    WelsAddDCValue [r0-1+r1*2], r4d, [r6+32], r5d
+    WelsAddDCValue [r0-1+r3  ], r4d, [r6+48], r5d
+    lea         r0, [r0+4*r1]
+    add         r6, 64
+    WelsAddDCValue [r0-1     ], r4d, [r6   ], r5d
+    WelsAddDCValue [r0-1+r1  ], r4d, [r6+16], r5d
+    WelsAddDCValue [r0-1+r1*2], r4d, [r6+32], r5d
+    WelsAddDCValue [r0-1+r3  ], r4d, [r6+48], r5d
+    lea         r0, [r0+4*r1]
+    add         r6, 64
+    WelsAddDCValue [r0-1     ], r4d, [r6   ], r5d
+    WelsAddDCValue [r0-1+r1  ], r4d, [r6+16], r5d
+    WelsAddDCValue [r0-1+r1*2], r4d, [r6+32], r5d
+    WelsAddDCValue [r0-1+r3  ], r4d, [r6+48], r5d
+    lea         r0, [r0+4*r1]
+    add         r6, 64
+    WelsAddDCValue [r0-1     ], r4d, [r6   ], r5d
+    WelsAddDCValue [r0-1+r1  ], r4d, [r6+16], r5d
+    WelsAddDCValue [r0-1+r1*2], r4d, [r6+32], r5d
+    WelsAddDCValue [r0-1+r3  ], r4d, [r6+48], r5d
+    sub         r6, 192
+    add         r5d,10h
+    shr         r5d,5
+    movd        xmm7,r5d
+    pxor        xmm1,xmm1
+    pshufb      xmm7,xmm1
+    pxor        xmm4,xmm4
+    pxor        xmm3,xmm3
+    pxor        xmm2,xmm2
