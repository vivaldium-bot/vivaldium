+    movq xmm3, [r0+4]
+    punpcklbw xmm3, xmm7
+    movq xmm4, [r0+2]
+    punpcklbw xmm4, xmm7
+    movq xmm5, [r0+3]
+    punpcklbw xmm5, xmm7
+
+    paddw xmm2, xmm3
+    paddw xmm4, xmm5
+    psllw xmm4, 2
+    psubw xmm4, xmm2
+    paddw xmm0, xmm1
+    paddw xmm0, xmm4
+    psllw xmm4, 2
+    paddw xmm0, xmm4
+    paddw xmm0, xmm6
+    psraw xmm0, 5
+
+    packuswb xmm0, xmm7
+    movq [r2], xmm0
+
+    lea r2, [r2+r3]
+    lea r0, [r0+r1]
+    dec r4
+    jnz near .y_loop
+
+    POP_XMM
