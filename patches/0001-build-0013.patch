+}
+
+template <class Catch>
+void catch_nullptr_test() {
+  try {
+    throw nullptr;
+    assert(false);
+  } catch (Catch c) {
+    assert(!c);
+  } catch (...) {
+    assert(false);
+  }
+}
+
+
+int main()
+{
+  // catch naked nullptrs
+  test1();
+  test2();
+
+  catch_nullptr_test<int*>();
