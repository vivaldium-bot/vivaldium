+
+// UNSUPPORTED: c++98, c++03, libcxxabi-no-exceptions
+
+#include <cassert>
+#include <cstdlib>
+
+struct A {};
+
+void test1()
+{
+    try
+    {
+        throw nullptr;
+        assert(false);
+    }
+    catch (int* p)
+    {
+        assert(!p);
+    }
+    catch (long*)
+    {
+        assert(false);
+    }
+}
+
+void test2()
+{
+    try
+    {
+        throw nullptr;
+        assert(false);
