diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/EqualPHIEdgeBlockMerge.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/EqualPHIEdgeBlockMerge.ll
