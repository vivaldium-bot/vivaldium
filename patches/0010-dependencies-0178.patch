diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-06-26-IterativePromote.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2003-06-26-IterativePromote.ll
