+          gridColors[currentColor++] = (x1 + 1.0) / 2.0;
+          gridColors[currentColor++] = (y1 + 1.0) / 2.0;
+          gridSecColors[currentSecColor++] = 1.0 - (x2 + y2 + 2.0) / 4.0;
+          gridSecColors[currentSecColor++] = (x2 + 1.0) / 2.0;
+          gridSecColors[currentSecColor++] = (y2 + 1.0) / 2.0;
