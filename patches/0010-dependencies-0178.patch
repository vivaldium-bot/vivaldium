@@ -0,0 +1,27 @@
+; Test merging of blocks that only have PHI nodes in them.  This tests the case
+; where the mergedinto block doesn't have any PHI nodes, and is in fact 
+; dominated by the block-to-be-eliminated
+;
+; RUN: opt < %s -simplifycfg -S | not grep N:
+;
+
+declare i1 @foo()
+
+define i32 @test(i1 %a, i1 %b) {
+        %c = call i1 @foo()
+	br i1 %c, label %N, label %P
+P:
+        %d = call i1 @foo()
+	br i1 %d, label %N, label %Q
+Q:
+	br label %N
+N:
+	%W = phi i32 [0, %0], [1, %Q], [2, %P]
+	; This block should be foldable into M
+	br label %M
+
+M:
+	%R = add i32 %W, 1
+	ret i32 %R
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiEliminate.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiEliminate.ll
new file mode 100644
index 0000000000000000000000000000000000000000..4b4e6090215034b93dbed5a1e5283a40874769d9
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiEliminate.ll
@@ -0,0 +1,27 @@
+; Test a bunch of cases where the cfg simplification code should
+; be able to fold PHI nodes into computation in common cases.  Folding the PHI
+; nodes away allows the branches to be eliminated, performing a simple form of
+; 'if conversion'.
+
+; RUN: opt < %s -simplifycfg -S > %t.xform
+; RUN:   not grep phi %t.xform 
+; RUN:   grep ret %t.xform
+
+declare void @use(i1)
+
+declare void @use.upgrd.1(i32)
+
+
+define void @test(i1 %c, i32 %V, i32 %V2) {
+; <label>:0
+        br i1 %c, label %T, label %F
+T:              ; preds = %0
+        br label %F
+F:              ; preds = %T, %0
+        %B1 = phi i1 [ true, %0 ], [ false, %T ]                ; <i1> [#uses=1]
+        %I6 = phi i32 [ %V, %0 ], [ 0, %T ]             ; <i32> [#uses=1]
+        call void @use( i1 %B1 )
+        call void @use.upgrd.1( i32 %I6 )
+        ret void
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiEliminate2.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiEliminate2.ll
