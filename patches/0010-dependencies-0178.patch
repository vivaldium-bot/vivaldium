index 0000000000000000000000000000000000000000..78298960f24ad22c69f235d404063911189b2080
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.2/conformance/resources/iterable-test.js
@@ -0,0 +1,147 @@
+/*
