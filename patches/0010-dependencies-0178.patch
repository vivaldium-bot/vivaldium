diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiBlockMerge.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiBlockMerge.ll
