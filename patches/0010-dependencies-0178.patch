+	%tmp29 = icmp ne i32 %tmp28, 0		; <i1> [#uses=1]
+	%tmp2930 = zext i1 %tmp29 to i8		; <i8> [#uses=1]
+	%toBool31 = icmp ne i8 %tmp2930, 0		; <i1> [#uses=1]
