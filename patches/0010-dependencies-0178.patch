index 0000000000000000000000000000000000000000..cfae7c23a84baecbaddee1664620c4dbf5c0cd04
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.2/conformance/renderbuffers/framebuffer-object-attachment.html
@@ -0,0 +1,610 @@
+<!--
