+   i32 0, label %lor.end
+   i32 1, label %lor.end
+ ]
+
+lor.rhs:
+ br label %lor.end
+
+lor.end:
+ %0 = phi i1 [ true, %entry ], [ false, %lor.rhs ], [ true, %entry ]
+ ret i1 %0
+
+; CHECK: @test2
+; CHECK: %switch = icmp ult i32 %x, 2
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch_create.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/switch_create.ll
