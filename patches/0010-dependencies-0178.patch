diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/different-type-ivs.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/different-type-ivs.ll
