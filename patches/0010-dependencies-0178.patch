diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2008-09-22-vector-gep.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2008-09-22-vector-gep.ll
