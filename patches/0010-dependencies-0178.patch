diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiBlockMerge2.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/PhiBlockMerge2.ll
new file mode 100644
index 0000000000000000000000000000000000000000..1202f2b3d2e53ff3c9c596b188e96f4c4a40e301
--- /dev/null
