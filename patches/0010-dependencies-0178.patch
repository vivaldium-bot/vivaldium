+        gl, simpleTextureFragmentShader, gl.FRAGMENT_SHADER);
+};
+
+/**
+ * Creates a texture vertex shader that doesn't need texcoords.
+ * @param {!WebGLContext} gl The WebGLContext to use.
+ * @return {!WebGLShader}
