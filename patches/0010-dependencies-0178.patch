+	%tmp21 = add i32 %tmp20, 1		; <i32> [#uses=1]
+	store i32 %tmp21, i32* %i
+	%tmp22 = load i32* %i		; <i32> [#uses=1]
+	%tmp23 = icmp sgt i32 %tmp22, 262144		; <i1> [#uses=1]
+	%tmp2324 = zext i1 %tmp23 to i8		; <i8> [#uses=1]
+	%toBool25 = icmp ne i8 %tmp2324, 0		; <i1> [#uses=1]
