diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/dce-cond-after-folding-terminator.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/SimplifyCFG/dce-cond-after-folding-terminator.ll
