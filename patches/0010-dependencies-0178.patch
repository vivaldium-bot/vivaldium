+	%tmp9 = load i32* %z		; <i32> [#uses=1]
+	%tmp10 = icmp ne i32 %tmp9, 0		; <i1> [#uses=1]
+	%tmp1011 = zext i1 %tmp10 to i8		; <i8> [#uses=1]
+	%toBool12 = icmp ne i8 %tmp1011, 0		; <i1> [#uses=1]
