diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/2011-07-20-DoubleIV.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/2011-07-20-DoubleIV.ll
