diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2011-09-22-PHISpeculateInvoke.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2011-09-22-PHISpeculateInvoke.ll
