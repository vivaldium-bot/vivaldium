diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2003-09-12-IncorrectPromote.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/ScalarRepl/2003-09-12-IncorrectPromote.ll
