diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/dont_reverse.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/dont_reverse.ll
