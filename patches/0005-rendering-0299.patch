+TEST(NoBarrierAtomicValue, ConstructionVoidStar) {
+  NoBarrierAtomicValue<void*> a(nullptr);
+  void* b = nullptr;
+  NoBarrierAtomicValue<void*>* ptr =
+      NoBarrierAtomicValue<void*>::FromAddress(&b);
+  EXPECT_EQ(ptr->Value(), a.Value());
+}
