+static void AppendUint32v(std::vector<byte>& buffer, uint32_t val) {
+  while (true) {
+    uint32_t next = val >> 7;
+    uint32_t out = val & 0x7f;
+    if (next) {
+      buffer.push_back(static_cast<byte>(0x80 | out));
+      val = next;
+    } else {
+      buffer.push_back(static_cast<byte>(out));
+      break;
+    }
+  }
+}
