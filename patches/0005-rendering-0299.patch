+TEST(NoBarrierAtomicValue, Construction) {
+  NoBarrierAtomicValue<TestFlag> a(kA);
+  TestFlag b = kA;
+  NoBarrierAtomicValue<TestFlag>* ptr =
+      NoBarrierAtomicValue<TestFlag>::FromAddress(&b);
+  EXPECT_EQ(ptr->Value(), a.Value());
+}
