+  size_t speed = kMarkCompactSpeed;
+  double idle_time_ms = static_cast<double>(kSizeOfObjects / speed - 1);
+  GCIdleTimeAction action = handler()->Compute(idle_time_ms, heap_state);
+  EXPECT_EQ(DONE, action.type);
