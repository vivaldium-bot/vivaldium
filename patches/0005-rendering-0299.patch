+  Write(Bytecode::kAdd, R(1), U8(1), {42, false});
+  WriteJump(Bytecode::kJumpIfUndefined, &jump_end_1, {68, true});
+  WriteJump(Bytecode::kJumpIfNull, &jump_end_2);
