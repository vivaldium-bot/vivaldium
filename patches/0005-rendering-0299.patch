+  scanner.Next();
+  CHECK(scanner.IsPrecededByNewline());
+  Skip(TOK(var));
+  scanner.Next();
+  Skip('=');
+  scanner.Next();
+  CHECK(scanner.IsPrecededByNewline());
+  CheckForEnd();
+}
