+  writer()->BindLabel(&back_jump);
+  Write(Bytecode::kForInContinue, R(7), R(6), {63, true});
+  WriteJump(Bytecode::kJumpIfFalse, &jump_end_3);
+  Write(Bytecode::kForInNext, R(3), R(7), R(4), U8(1));
