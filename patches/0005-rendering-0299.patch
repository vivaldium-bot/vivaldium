+struct While {
+  Node* loop;
+  Node* branch;
+  Node* if_true;
+  Node* if_false;
+  Node* exit;
+};
+
+
+// A helper for building branches.
+struct Branch {
+  Node* branch;
+  Node* if_true;
+  Node* if_false;
+};
+
+
+// A helper for building counters attached to loops.
+struct Counter {
+  Node* base;
+  Node* inc;
+  Node* phi;
+  Node* add;
+  Node* exit_marker;
+};
+
