+  job->StepNextOnMainThread();
+  ASSERT_FALSE(job->IsFailed());
+  job->StepNextOnMainThread();
+  ASSERT_FALSE(job->IsFailed());
+  job->StepNextOnMainThread();
+  ASSERT_FALSE(job->IsFailed());
+  job->StepNextOnMainThread();
+  ASSERT_FALSE(job->IsFailed());
