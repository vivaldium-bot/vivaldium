+}
+
+function foo() {
+    var result = 0;
+    var a = arguments;
+    for (var i = 0; i < a.length; ++i) {
+        result += a[i];
+        result += baz()[0];
+
+        // Just some dummy control flow.
+        if (result < 0)
+            throw "Error";
+    }
+    return result;
+}
+
+function bar(x) {
+    return foo(x);
+}
+
+var variable = 32;
+var expected = "74";
+
