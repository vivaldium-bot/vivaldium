+.Running			{ background: #d3d3d3; }
+.NotSupported		{ background: #ff69b4; }
+.ResourceError		{ background: #ff4040; }
+.InternalError		{ background: #ff1493; }
+.Canceled			{ background: #808080; }
+.Crash				{ background: #ffa500; }
+.Timeout			{ background: #ffa500; }
