+														0,
+														0,
+														false,
+														GLValue::getMinValue(Array::INPUTTYPE_FLOAT),
+														GLValue::getMaxValue(Array::INPUTTYPE_FLOAT));
+
+		MultiVertexArrayTest::Spec _spec = spec;
+		_spec.arrays.push_back(arraySpec);
+		addStorageCases(_spec, depth-1);
+	}
