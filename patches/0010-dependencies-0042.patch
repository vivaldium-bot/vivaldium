+static inline int computePixelStore (const TextureFormat& format)
+{
+	const int pixelSize = format.getPixelSize();
+	if (deIsPowerOfTwo32(pixelSize))
+		return de::min(pixelSize, 8);
+	else
+		return 1;
+}
