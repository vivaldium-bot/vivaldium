+		   Mat2(1.0/8.0, 1.0/16.0,  1.0/32.0, 1.0/64.0),
+		   Mat2(-18.725, -0.5,  -0.0125, 19.975),
+		   #Mat2(128.0, -4096.0,  192.0, -1536.0),
+		   #Mat2(-1536.0, 8192.0,  6144.0, -6144.0)
+		   ]
+
+INPUTS = {
+	"float":	inFloat,
+	"vec2":		inVec2,
+	"vec3":		inVec3,
+	"vec4":		inVec4,
+	"int":		inInt,
+	"ivec2":	inIVec2,
+	"ivec3":	inIVec3,
