+	IterateResult iterate (void)
+	{
+		const glu::RenderContext&	renderCtx			= m_context.getRenderContext();
+		const glw::Functions&		gl					= renderCtx.getFunctions();
+		const int					width				= 41;
+		const int					height				= 13;
