+struct StructNameEquals
+{
+	std::string name;
+
+	StructNameEquals (const char* name_) : name(name_) {}
+
+	bool operator() (const StructType* type) const
+	{
+		return type->getTypeName() && name == type->getTypeName();
+	}
+};
