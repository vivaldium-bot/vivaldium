+#			vectorSwizzleCases.append(SwizzleCase(caseName, precision, dataType, swizzle, [("in0", inputs)], [("out0", outputs)]))
+
+allCases.append(CaseGroup("vector_swizzles", "Vector Swizzles", vectorSwizzleCases))
+
+# Swizzles:
+# - vector components
+#   * int, float, bool vectors
+#   * .xyzw, .rgba, .stpq
