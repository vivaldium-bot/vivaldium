+
+		gl.bindFramebuffer(GL_FRAMEBUFFER, *fbo);
+		gl.framebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, *colorBuf);
