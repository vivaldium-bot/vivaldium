+ShaderAtomicOpTests::ShaderAtomicOpTests (Context& context, const char* name, AtomicOperandType operandType)
+	: TestCaseGroup	(context, name, "Atomic Operation Tests")
+	, m_operandType	(operandType)
+{
+}
