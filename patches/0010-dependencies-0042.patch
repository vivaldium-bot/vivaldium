+	: TextureSpecCase		(context, name, desc)
+	, m_texFormat			(format)
+	, m_texFormatInfo		(tcu::getTextureFormatInfo(format))
+	, m_width				(width)
+	, m_height				(height)
+	, m_numLevels			(numLevels)
