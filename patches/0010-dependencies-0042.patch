+		: Texture2DSpecCase	(context, name, desc, glu::mapGLInternalFormat(internalFormat), width, height, maxLevelCount(width, height))
+		, m_internalFormat	(internalFormat)
+		, m_format			(GL_NONE)
+		, m_dataType		(GL_NONE)
