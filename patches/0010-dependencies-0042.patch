+static inline string getTimeStr (const deUint64 seconds)
+{
+	const deUint64		m = seconds / 60;
+	const deUint64		h = m / 60;
+	const deUint64		d = h / 24;
+	std::ostringstream	res;
+
+	res << d << "d " << h%24 << "h " << m%60 << "m " << seconds%60 << "s";
+	return res.str();
+}
