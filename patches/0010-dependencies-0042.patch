+ExprP<TRET> NAME (const ExprP<T0>& arg0, const ExprP<T1>& arg1,			\
+				  const ExprP<T2>& arg2, const ExprP<T3>& arg3)			\
+{																		\
+	return app<CLASS>(arg0, arg1, arg2, arg3);							\
+}
