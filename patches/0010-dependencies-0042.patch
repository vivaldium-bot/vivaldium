+
+  test('cpuIdleImport', function() {
+    var lines = [
+      '          <idle>-0     [000] 15050.992883: cpu_idle: ' +
+          'state=1 cpu_id=0',
+      '          <idle>-0     [000] 15050.993027: cpu_idle: ' +
