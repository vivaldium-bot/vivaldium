+
+def findConfig (name):
+	for config in CONFIGS:
+		if config.name == name:
+			return config
+	return None
+
+if __name__ == "__main__":
+	if len(sys.argv) != 2:
+		die("%s: [config]" % sys.argv[0])
+
+	config = findConfig(sys.argv[1])
+	if config == None:
+		die("Config '%s' not found" % sys.argv[1])
+
+	random.seed()
+	runInternalTests(config)
