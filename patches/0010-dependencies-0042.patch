+static const char* getVerifierSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_PROGRAM_INTEGER_VEC3:
+		case QUERY_PROGRAM_INTEGER:
+			return "get_programiv";
+
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
+	}
