+	bool				verifyImage					(const tcu::Surface& resultImage);
+
+	std::string			genFragmentSource			(int numSamples) const;
+
+	enum
+	{
+		RENDER_SIZE = 128
+	};
+
+	const TestType		m_type;
+};
