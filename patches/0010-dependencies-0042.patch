+			throw tcu::TestError("failed to build program");
+
+		verifyStateProgramIntegerVec3(result, gl, program.getProgram(), GL_COMPUTE_WORK_GROUP_SIZE, tcu::IVec3(3, 2, 4), m_verifier);
+	}
+
+	result.setTestContextResult(m_testCtx);
+	return STOP;
+}
