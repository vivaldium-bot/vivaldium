+struct VarValue
+{
+	glu::DataType type;
+
+	union
+	{
+		float		floatV[4*4]; // At most mat4. \note Matrices here are column-major.
+		deInt32		intV[4];
+		deUint32	uintV[4];
+		bool		boolV[4];
+		struct
+		{
+			int		unit;
+			union
+			{
+				float		floatV[4];
+				deInt32		intV[4];
+				deUint32	uintV[4];
+			} fillColor;
+		} samplerV;
+	} val;
+};
