+// Enabling & disabling states
+void enable (NegativeTestContext& ctx)
+{
+	ctx.beginSection("GL_INVALID_ENUM is generated if cap is not one of the allowed values.");
+	ctx.glEnable(-1);
+	ctx.expectError(GL_INVALID_ENUM);
+	ctx.endSection();
+}
