+			<< (int)m_results[sampleNdx].renderDuration
+			<< (int)m_results[sampleNdx].readDuration
+			<< tcu::TestLog::EndSample;
+
+	m_testCtx.getLog() << tcu::TestLog::EndSampleList;
+}
