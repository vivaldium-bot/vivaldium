+	0x80800000,	// maximum negative normalized value
+	0x00000001,	// minimum positive denorm value
+	0x80000001,	// maximum negative denorm value
+	0x7F7FFFFF,	// maximum finite value.
+	0xFF7FFFFF,	// minimum finite value.
+	0x7F800000,	//  inf
