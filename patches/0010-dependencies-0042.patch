+
+    var c1 = m.kernel.cpus[1];
+    assert.equal(c1.slices.length, 0);
+    assert.equal(c1.counters['.Clock Frequency'].series[0].samples.length, 2);
+  });
+
+  test('cpuFrequencyImport', function() {
