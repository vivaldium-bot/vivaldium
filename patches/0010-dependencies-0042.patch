+		varType = glu::TYPE_FLOAT_VEC4;
+	else
+		DE_ASSERT(false);
+
+	m_testCtx.getLog() << tcu::TestLog::Message << "Verifying type, expecting " << glu::getDataTypeName(varType) << tcu::TestLog::EndMessage;
+	if (glu::getDataTypeFromGLType(propValue) != varType)
