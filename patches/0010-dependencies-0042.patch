+    assert.isBelow(results.p, 0.1);
+
+    // 0.01 < x < 0.1
+    sampleA = [1, 2, 2.1, 2.2, 2, 1];
+    sampleB = [2, 3, 3.1, 3.2, 3, 2];
+    results = Statistics.mwu(sampleA, sampleB);
+    assert.isBelow(results.p, 0.1);
+    assert.isAbove(results.p, 0.01);
