+			block.setArraySize(m_numInstances);
+		}
+
+		{
+			de::Random rnd(7921);
+			for (int ndx = 0; ndx < (m_numInstances ? m_numInstances : 1); ndx++)
+			{
+				const int lastArrayLen = rnd.getInt(1, 5);
+				block.setLastUnsizedArraySize(ndx, lastArrayLen);
+			}
+		}
+	}
+
+private:
+	deUint32	m_layoutFlags;
+	int			m_numInstances;
+};
