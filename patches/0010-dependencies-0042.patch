+	deUint8*				getPtr					(int offset = 0)		{ return &m_data[offset]; }
+	const deUint8*			getPtr					(int offset = 0) const	{ return &m_data[offset]; }
+
+private:
+	std::vector<deUint8>	m_data;
+};
