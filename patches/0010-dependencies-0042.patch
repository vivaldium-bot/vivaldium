+	virtual void		deinit								(void);
+
+private:
+	typedef MovePtr<glu::Texture> TexPtr;
+
+	virtual ObjectData	genOccludedGeometry					(void) const
+	{
+		return ObjectData(Utils::getTextureWorkloadShader(), Utils::getFullscreenQuad(0.8f));
+	}
