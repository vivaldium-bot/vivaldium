+	def toUVec3(self):			return UVec3(self.x, self.y, 0.0)
+	def toUVec4(self):			return UVec4(self.x, self.y, 0.0, 0.0)
+	def toMat2(self):			return Mat2(float(self.x), 0.0, 0.0, float(self.y));
