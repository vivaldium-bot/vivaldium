+ * \brief Texture filtering performance tests.
+ *//*--------------------------------------------------------------------*/
+
+#include "es3pTextureFilteringTests.hpp"
+#include "es3pTextureCases.hpp"
+#include "tcuMatrixUtil.hpp"
+
+#include "glwEnums.hpp"
+
+using std::string;
+
+namespace deqp
+{
