+const char* TextureRenderer::s_vertexShaderGLES2 =
+"attribute mediump vec2 a_coord;\n"
+"varying mediump vec2 v_texCoord;\n"
+"void main (void)\n"
+"{\n"
+"\tv_texCoord = 0.5 * (a_coord + vec2(1.0));\n"
+"\tgl_Position = vec4(a_coord, 0.0, 1.0);\n"
+"}\n";
