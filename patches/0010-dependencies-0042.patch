+private:
+						ShaderEvaluator			(const ShaderEvaluator&);	// not allowed!
+	ShaderEvaluator&	operator=				(const ShaderEvaluator&);	// not allowed!
+
+	ShaderEvalFunc		m_evalFunc;
+};
