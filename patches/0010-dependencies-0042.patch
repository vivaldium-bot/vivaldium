+	else if (m_iteration == 4)
+		buf << "	v_input[0] = a_position.yx + vec2(0.5, 0.5);\n"
+			   "	v_input[1] = a_position.xy;\n";
+	else
+		DE_ASSERT(false);
+
+	buf <<	"}";
