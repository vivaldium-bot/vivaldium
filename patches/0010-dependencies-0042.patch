+#define GLS_COLLECT_GL_ERROR(RES, ERR, MSG) \
+	do \
+	{ \
+		const deUint32 err = (ERR); \
+		if (err != GL_NO_ERROR) \
+			(RES).fail(std::string("Got Error ") + glu::getErrorStr(err).toString() + ": " + (MSG)); \
+	} \
+	while (deGetFalse())
