+template <int N>
+static tcu::Vector<float, N> mean (const vector<tcu::Vector<float, N> >& data)
+{
+	tcu::Vector<float, N> sum(0.0f);
+	for (int i = 0; i < (int)data.size(); i++)
+		sum += data[i];
+	return sum / tcu::Vector<float, N>((float)data.size());
+}
