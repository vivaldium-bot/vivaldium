+}
+
+bool PerPatchDataCase::caseTypeUsesRefImageFromFile (CaseType type)
+{
+	switch (type)
+	{
+		case CASETYPE_PRIMITIVE_ID_TCS:
+		case CASETYPE_PRIMITIVE_ID_TES:
+			return true;
+
+		default:
+			return false;
