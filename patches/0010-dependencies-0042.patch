+Vec4 getRandomColor (de::Random& rnd)
+{
+	const float r = rnd.getFloat(0.2f, 0.9f);
+	const float g = rnd.getFloat(0.2f, 0.9f);
+	const float b = rnd.getFloat(0.2f, 0.9f);
+	return Vec4(r, g, b, 1.0f);
+}
