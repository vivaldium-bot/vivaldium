+class AutoFbo
+{
+public:
+	AutoFbo (const glw::Functions& gl)
+		: m_gl	(gl)
+		, m_fbo	(0)
+	{
+	}
+
+	~AutoFbo (void)
+	{
+		if (m_fbo)
+			m_gl.deleteFramebuffers(1, &m_fbo);
+	}
+
+	void gen (void)
+	{
+		DE_ASSERT(!m_fbo);
+		m_gl.genFramebuffers(1, &m_fbo);
+	}
+
+	deUint32 operator* (void) const { return m_fbo; }
+
+private:
+	const glw::Functions&	m_gl;
+	deUint32				m_fbo;
+};
