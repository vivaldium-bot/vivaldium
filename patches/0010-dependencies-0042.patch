+static const char* getInterpolationName (Interpolation interp)
+{
+	switch (interp)
+	{
+		case INTERPOLATION_SMOOTH:		return "smooth";
+		case INTERPOLATION_FLAT:		return "flat";
+		case INTERPOLATION_CENTROID:	return "centroid";
+		default:
+			DE_ASSERT(false);
+			return DE_NULL;
