+	void									deinit						(void);
+
+protected:
+	int										getNumAtomicCounterBuffers	(void) const;
+	int										getMaxNumActiveVariables	(void) const;
+	int										getBufferVariableCount		(int binding) const;
+	int										getBufferMinimumDataSize	(int binding) const;
+
