+
+	// barrier
+
+	buf << genBarrierSource();
+
+	// write
+
+	for (int ndx = 0; ndx < m_elementsPerInvocation; ++ndx)
+	{
+		if (m_storage == STORAGE_BUFFER && m_useAtomic)
+			buf << "\tatomicAdd(sb_store.values[getIndex(gl_LocalInvocationID.xy, " << ndx << ")], groupNdx);\n";
