+void uniform_block_binding (NegativeTestContext& ctx)
+{
+	glu::ShaderProgram program(ctx.getRenderContext(), glu::makeVtxFragSources(uniformBlockVertSource, uniformTestFragSource));
+
+	ctx.glUseProgram	(program.getProgram());
