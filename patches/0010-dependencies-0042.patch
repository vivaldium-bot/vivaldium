+
+		const PointerData pointers[] =
+		{
+			// size test
+			{ 4, GL_FLOAT,		0,	GL_FALSE, vertexData },
+			{ 3, GL_FLOAT,		0,	GL_FALSE, vertexData },
+			{ 2, GL_FLOAT,		0,	GL_FALSE, vertexData },
