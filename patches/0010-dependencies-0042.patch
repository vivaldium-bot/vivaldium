+																  caseConfigs[ndx].name,
+																  caseConfigs[ndx].description,
+																  caseConfigs[ndx].tessellationOutput,
+																  caseConfigs[ndx].tessellationPointMode,
+																  caseConfigs[ndx].geometryOutputType));
