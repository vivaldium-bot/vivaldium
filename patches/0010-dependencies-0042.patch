+class NegativeDrawCase : public TestCase
+{
+public:
+							NegativeDrawCase 	(Context& context, const char* name, const char* desc, GLenum inputType, GLenum inputPrimitives);
+							~NegativeDrawCase	(void);
+
+	void					init				(void);
+	void					deinit				(void);
+
+	IterateResult			iterate 			(void);
+
+private:
