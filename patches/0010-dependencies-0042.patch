+			return 1;
+
+		case GL_TEXTURE_1D_ARRAY:
+		case GL_TEXTURE_2D:
+		case GL_TEXTURE_CUBE_MAP:
+			return 2;
+
+		case GL_TEXTURE_2D_ARRAY:
+		case GL_TEXTURE_3D:
+			return 3;
+
+		default:
+			DE_ASSERT(false);
+			return -1;
+	}
