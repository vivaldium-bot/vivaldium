+
+template<>
+inline GLValue::Half getRandom (deRandom& rnd, GLValue::Half min, GLValue::Half max)
+{
+	if (max < min)
+		return min;
+
+	float fMax = max.to<float>();
+	float fMin = min.to<float>();
+	GLValue::Half h = GLValue::Half::create(fMin + deRandom_getFloat(&rnd) * (fMax - fMin));
+	return h;
+}
