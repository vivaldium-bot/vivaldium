+																		const glu::ContextInfo&				ctxInfo,
+																		const tcu::CompressedTexture&		compressedLevel,
+																		const tcu::TexDecompressionParams&	decompressionParams)
+	{
+		return de::MovePtr<glu::Texture3D>(new glu::Texture3D(renderCtx,
+															  ctxInfo,
+															  1,
+															  &compressedLevel,
+															  decompressionParams));
+	}
