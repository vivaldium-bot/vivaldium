+VertexFeedbackCase::VertexFeedbackCase (Context& context, const char* name, const char* description, DrawMethod method, PrimitiveType output)
+	: TestCase			(context, name, description)
+	, m_method			(method)
+	, m_output			(output)
+	, m_elementBuf		(0)
+	, m_arrayBuf		(0)
+	, m_offsetBuf		(0)
+	, m_feedbackBuf		(0)
+	, m_indirectBuffer	(0)
+	, m_program			(DE_NULL)
