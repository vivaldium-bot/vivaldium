+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var Base64 = tr.b.Base64;
+
+  test('simple', function() {
+    var htmlLines = [
+      '<!DOCTYPE html>',
+      '<script id="viewer-data" type="application/json">',
+      Base64.btoa('hello'),
+      '<\/script>',
+      '<script id="viewer-data" type="text/plain">',
