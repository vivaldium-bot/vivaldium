+static const char* getVerifierSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_BOOLEAN:		return "getboolean";
+		case QUERY_INTEGER:		return "getinteger";
+		case QUERY_INTEGER64:	return "getinteger64";
+		case QUERY_FLOAT:		return "getfloat";
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
+	}
+}
