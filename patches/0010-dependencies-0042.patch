+
+		if (!mapPtr)
+			throw tcu::TestError("mapBufferRange returned null");
+
+		result.duration.mapDuration = endTime - startTime;
+	}
+
+	// write
+	{
+		result.duration.writeDuration = medianTimeMemcpy(mapPtr, &m_zeroData[0], subdataSize);
