+	, m_height			(0)
+	, m_filenames		(filenames)
+	, m_renderer		(renderCtx, testCtx.getLog(), glu::GLSL_VERSION_300_ES, glu::PRECISION_HIGHP)
+	, m_caseNdx			(0)
+{
+}
