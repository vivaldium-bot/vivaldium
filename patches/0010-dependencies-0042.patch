+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var newAsyncSliceEx = tr.c.TestUtils.newAsyncSliceEx;
+  var newSliceEx = tr.c.TestUtils.newSliceEx;
+  var newFlowEventEx = tr.c.TestUtils.newFlowEventEx;
