+		V3				= VALUE_VEC3,
+		V4				= VALUE_VEC4,
+		M				= VALUE_MATRIX,
+		B				= VALUE_BOOL,
+		BV				= VALUE_BOOL_VEC,
+		B4				= VALUE_BOOL_VEC4,
+		BGT				= VALUE_BOOL_GENTYPE,
+		I				= VALUE_INT,
+		IV				= VALUE_INT_VEC,
+		I4				= VALUE_INT_VEC4,
+		IGT				= VALUE_INT_GENTYPE,
+
+		VALUE_ANY_FLOAT			= VALUE_FLOAT		|	VALUE_FLOAT_VEC		|	VALUE_FLOAT_GENTYPE		| VALUE_VEC3 | VALUE_VEC4 | VALUE_FLOAT_VEC34,
