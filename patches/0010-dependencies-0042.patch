+{
+public:
+	string		getName		(void) const								{ return "round"; }
+
+protected:
+	Interval	applyPoint	(const EvalContext&, double x) const
+	{
+		double			truncated	= 0.0;
+		const double	fract		= deModf(x, &truncated);
+		Interval		ret;
