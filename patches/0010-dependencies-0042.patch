+void BuiltinVariableRenderTest::init (void)
+{
+	// Requirements
+	if (m_test == BuiltinVariableShader::TEST_POINT_SIZE)
+	{
+		const float requiredPointSize = 5.0f;
+
+		tcu::Vec2 range = tcu::Vec2(1.0f, 1.0f);
