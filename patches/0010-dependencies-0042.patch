+static std::string getFileDirectory (const std::string& filePath)
+{
+	const std::string::size_type lastDelim = filePath.find_last_of('/');
+
+	if (lastDelim == std::string::npos)
+		return "";
+	else
+		return filePath.substr(0, lastDelim+1);
+}
