+			}
+			break;
+		}
+		case DATATYPE_UNSIGNED_INTEGER_VEC4:
+		{
+			const glw::GLuint reference[4] =
+			{
+				(expected[0] ? 1u : 0u),
+				(expected[1] ? 1u : 0u),
+				(expected[2] ? 1u : 0u),
+				(expected[3] ? 1u : 0u)
+			};
+
+			if (state.getUintVec4Access()[0] != reference[0] ||
+				state.getUintVec4Access()[1] != reference[1] ||
