+	MAX_LINES_PER_INDEX_ARRAY_DRAW		= 128,		//!< Maximum number of lines per one draw in IndexArrayVerifier
+	INDEX_ARRAY_DRAW_VIEWPORT_WIDTH		= 128,
+	INDEX_ARRAY_DRAW_VIEWPORT_HEIGHT	= 128
+};
