+template <int SIZE>
+struct UniformWeightArray
+{
+	float weights[SIZE];
+
+	UniformWeightArray (void)
+	{
+		for (int i=0; i<SIZE; ++i)
+			weights[i] = 1.0f;
+	}
+};
+
