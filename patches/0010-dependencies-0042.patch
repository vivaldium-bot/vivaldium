+
+	# textureProjOffset
+	InvalidTexFuncCase("textureProjOffset",		["samplerCube", "vec4", "ivec2"]),
+	InvalidTexFuncCase("textureProjOffset",		["samplerCube", "vec4", "ivec3"]),
