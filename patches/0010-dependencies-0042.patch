+class MapBufferRangeCase : public BasicUploadCase<MapBufferRangeDuration>
+{
+public:
+	enum Flags
+	{
+		FLAG_PARTIAL						= 0x01,
+		FLAG_MANUAL_INVALIDATION			= 0x02,
+		FLAG_USE_UNUSED_UNSPECIFIED_BUFFER	= 0x04,
+		FLAG_USE_UNUSED_SPECIFIED_BUFFER	= 0x08,
