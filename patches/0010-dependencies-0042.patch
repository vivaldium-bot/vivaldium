+}
+
+static inline float triangleArea (const Vec2& a, const Vec2& b, const Vec2& c)
+{
+	const Vec2 ab = b-a;
+	const Vec2 ac = c-a;
+	return 0.5f * tcu::length(ab.x()*ac.y() - ab.y()*ac.x());
+}
