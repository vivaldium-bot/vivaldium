+void use_program (NegativeTestContext& ctx)
+{
+	GLuint shader = ctx.glCreateShader(GL_VERTEX_SHADER);
+
+	ctx.beginSection("GL_INVALID_VALUE is generated if program is neither 0 nor a value generated by OpenGL.");
