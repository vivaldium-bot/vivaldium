+static bool isGatherOffsetsCompareResultValid (const tcu::TextureCubeView&		texture,
+											   const tcu::Sampler&				sampler,
+											   const tcu::TexComparePrecision&	prec,
+											   const Vec3&						coord,
+											   const IVec2						(&offsets)[4],
+											   float							cmpReference,
+											   const Vec4&						result)
+{
+	DE_ASSERT(isZeroOffsetOffsets(offsets));
