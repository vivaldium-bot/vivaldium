+
+		addChild(group);
+
+		for (int caseNdx = 0; caseNdx < DE_LENGTH_OF_ARRAY(internalFormats); ++caseNdx)
+		{
+			const std::string name = std::string(internalFormats[caseNdx].name) + "_samples";
