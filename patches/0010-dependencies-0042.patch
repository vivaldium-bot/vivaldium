+const char* TextureRenderer::s_fragmentShaderGL3 =
+"#version 330\n"
+"in mediump vec2 v_texCoord;\n"
+"uniform sampler2D u_texture;\n"
+"layout(location = 0) out mediump vec4 dEQP_FragColor;\n"
+"void main (void)\n"
