+enum LoopType
+{
+	LOOPTYPE_FOR = 0,
+	LOOPTYPE_WHILE,
+	LOOPTYPE_DO_WHILE,
+
+	LOOPTYPE_LAST
+};
+
+enum IterCountType
+{
