+
+//! A pair type that, unlike stl::pair, is POD so it can be statically initialized.
+template <typename T1, typename T2>
+struct Pair
+{
+	typedef	T1	first_type;
+	typedef T2	second_type;
+	T1			first;
+	T2			second;
+};
