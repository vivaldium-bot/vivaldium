+}
+
+void BufferSubDataWriter::write (deUint32 buffer, int offset, int numBytes, const deUint8* bytes, deUint32 target)
+{
+	glBindBuffer(target, buffer);
+	glBufferSubData(target, offset, numBytes, bytes);
+	glBindBuffer(target, 0);
+	GLU_CHECK();
+}
