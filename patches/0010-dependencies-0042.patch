+																	: isIntType(v.valueType)	? s_intTypes[curInScalarSize - 1]
+																	: isUintType(v.valueType)	? s_uintTypes[curInScalarSize - 1]
+																	: isBoolType(v.valueType)	? s_boolTypes[curInScalarSize - 1]
+																	: TYPE_LAST;
