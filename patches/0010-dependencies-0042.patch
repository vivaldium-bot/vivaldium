+ * \file
+ * \brief Single-program test case wrapper for ShaderPerformanceMeasurer.
+ *//*--------------------------------------------------------------------*/
+
+#include "glsShaderPerformanceCase.hpp"
+#include "tcuRenderTarget.hpp"
+#include "deStringUtil.hpp"
+#include "deMath.h"
+
+#include "glwFunctions.hpp"
