+		elif isinstance(self.x, float):
+			return "vec2(%s, %s)" % (self.x, self.y)
+		else:
+			assert False
+
+	def distance(self, v):
+		assert isinstance(v, Vec2)
+		return (self - v).length()
+
+	def dot(self, v):
+		assert isinstance(v, Vec2)
+		return Scalar(self.x*v.x + self.y*v.y)
+
+	def abs(self):
