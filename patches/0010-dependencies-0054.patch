+.if n \{\
+.RS 4
+.\}
+.nf
+\fB$ fetch chromium\fR
+\&.\&.\&. truncated output \&.\&.\&.
+\fB$ cd src\fR
+.fi
+.if n \{\
+.RE
+.\}
+.sp
+(only on linux)
+.sp
+.if n \{\
+.RS 4
+.\}
+.nf
+\fB$ \&./build/install\-build\-deps\&.sh\fR
+\&.\&.\&. truncated output \&.\&.\&.
+.fi
+.if n \{\
+.RE
+.\}
+.sp
+Pull in all dependencies for HEAD
