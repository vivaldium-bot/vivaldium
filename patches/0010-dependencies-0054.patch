+    void (*get_pixels_8x4_sym)(int16_t * /* align 16 */,
+                               const uint8_t *, ptrdiff_t);
+} DNXHDEncContext;
+
+void ff_dnxhdenc_init_x86(DNXHDEncContext *ctx);
+
+#endif /* AVCODEC_DNXHDENC_H */
