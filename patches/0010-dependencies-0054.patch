+# Footer metadata keys for regular and gsubtreed mirrored commit positions.
+COMMIT_POSITION_FOOTER_KEY = 'Cr-Commit-Position'
+COMMIT_ORIGINAL_POSITION_FOOTER_KEY = 'Cr-Original-Commit-Position'
