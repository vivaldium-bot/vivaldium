diff --git a/third_party/ffmpeg/libavcodec/huffyuv.c b/third_party/ffmpeg/libavcodec/huffyuv.c
new file mode 100644
index 0000000000000000000000000000000000000000..492155550f03c496408447f0a455128211fe9a0c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/huffyuv.c
@@ -0,0 +1,95 @@
+/*
+ * huffyuv codec for libavcodec
+ *
+ * Copyright (c) 2002-2014 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * see http://www.pcisys.net/~melanson/codecs/huffyuv.txt for a description of
+ * the algorithm used
