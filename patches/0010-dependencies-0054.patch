index 0000000000000000000000000000000000000000..5a399dcb25dd9ed1a7563cdb20482c351460733d
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/hapdec.c
@@ -0,0 +1,441 @@
+/*
+ * Vidvox Hap decoder
+ * Copyright (C) 2015 Vittorio Giovara <vittorio.giovara@gmail.com>
+ * Copyright (C) 2015 Tom Butterworth <bangnoise@gmail.com>
+ *
+ * This file is part of FFmpeg.
+ *
