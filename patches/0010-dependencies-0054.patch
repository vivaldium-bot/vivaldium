+                                  "manually.\ncd %s && git " %
+                                  self.checkout_path
+                                  + "%s" % ' '.join(rebase_cmd))
+
+    self.Print(rebase_output.strip())
+    if not options.verbose:
+      # Make the output a little prettier. It's nice to have some
+      # whitespace between projects when syncing.
+      self.Print('')
