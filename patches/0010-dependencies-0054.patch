index 0000000000000000000000000000000000000000..2815704997f9399af616bd97903fd620870386a9
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/g2meet.c
@@ -0,0 +1,1636 @@
+/*
+ * Go2Webinar / Go2Meeting decoder
+ * Copyright (c) 2012 Konstantin Shishkov
+ * Copyright (c) 2013 Maxim Poliakovski
+ *
