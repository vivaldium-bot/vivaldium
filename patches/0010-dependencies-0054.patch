+    if ((ret = init_vlc(&ctx->vlc, 11, FF_ARRAY_ELEMS(huffbits),
+                        huffbits, 1, 1, huffcodes, 4, 4, 0)) < 0) {
+        av_log(avctx, AV_LOG_ERROR, "error initializing vlc table\n");
