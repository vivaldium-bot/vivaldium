--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/h264dsp.c
@@ -0,0 +1,161 @@
+/*
+ * H.26L/H.264/AVC/JVT/14496-10/... encoder/decoder
+ * Copyright (c) 2003-2010 Michael Niedermayer <michaelni@gmx.at>
+ *
