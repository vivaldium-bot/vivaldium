+uint32_t ff_square_tab[512] = { 0, };
+
+static int sse4_c(MpegEncContext *v, uint8_t *pix1, uint8_t *pix2,
+                  ptrdiff_t stride, int h)
+{
+    int s = 0, i;
+    uint32_t *sq = ff_square_tab + 256;
+
+    for (i = 0; i < h; i++) {
+        s    += sq[pix1[0] - pix2[0]];
+        s    += sq[pix1[1] - pix2[1]];
+        s    += sq[pix1[2] - pix2[2]];
+        s    += sq[pix1[3] - pix2[3]];
+        pix1 += stride;
+        pix2 += stride;
+    }
+    return s;
+}
+
+static int sse8_c(MpegEncContext *v, uint8_t *pix1, uint8_t *pix2,
+                  ptrdiff_t stride, int h)
+{
