+#include "mathops.h"
+
+typedef struct DPCMContext {
+    int16_t square_array[256];
+    int sample[2];                  ///< previous sample (for SOL_DPCM)
+    const int8_t *sol_table;        ///< delta table for SOL_DPCM
+} DPCMContext;
+
+static const int16_t interplay_delta_table[] = {
