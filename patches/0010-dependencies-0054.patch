+  def diff(self, options, _args, _file_list):
+    try:
+      merge_base = [self._Capture(['merge-base', 'HEAD', self.remote])]
+    except subprocess2.CalledProcessError:
+      merge_base = []
+    self._Run(['-c', 'core.quotePath=false', 'diff'] + merge_base, options)
