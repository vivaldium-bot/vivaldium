+  def _GetCurrentBranch(self):
+    # Returns name of current branch or None for detached HEAD
+    branch = self._Capture(['rev-parse', '--abbrev-ref=strict', 'HEAD'])
+    if branch == 'HEAD':
+      return None
+    return branch
