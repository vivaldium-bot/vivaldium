+DEPS = [
+  'depot_tools',
+  'gclient',
+  'gerrit',
+  'recipe_engine/context',
+  'recipe_engine/json',
+  'recipe_engine/path',
+  'recipe_engine/platform',
+  'recipe_engine/properties',
