+# Copied from scripts/recipes/chromium.py.
+GOT_REVISION_MAPPINGS = {
+    CHROMIUM_SRC_URL: {
+        'got_revision': 'src/',
+        'got_nacl_revision': 'src/native_client/',
+        'got_swarm_client_revision': 'src/tools/swarm_client/',
+        'got_swarming_client_revision': 'src/tools/swarming_client/',
