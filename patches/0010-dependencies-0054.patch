diff --git a/third_party/ffmpeg/libavcodec/mips/h263dsp_msa.c b/third_party/ffmpeg/libavcodec/mips/h263dsp_msa.c
new file mode 100644
index 0000000000000000000000000000000000000000..472bcbd70a7229a5b8e3dc0a5182423087b8bbc5
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/h263dsp_msa.c
@@ -0,0 +1,164 @@
+/*
+ * Copyright (c) 2015 Manojkumar Bhosale (Manojkumar.Bhosale@imgtec.com)
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
