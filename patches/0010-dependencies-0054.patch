+def GetMacWinOrLinux():
+  """Returns 'mac', 'win', or 'linux', matching the current platform."""
+  if sys.platform.startswith(('cygwin', 'win')):
+    return 'win'
+  elif sys.platform.startswith('linux'):
+    return 'linux'
