+    fetch_cmd =  cfg + [
+        'fetch',
+        remote or self.remote,
+    ]
+    if refspec:
+      fetch_cmd.append(refspec)
+
+    if prune:
+      fetch_cmd.append('--prune')
+    if options.verbose:
+      fetch_cmd.append('--verbose')
+    elif quiet:
+      fetch_cmd.append('--quiet')
