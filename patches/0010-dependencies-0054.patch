--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/lagarithrac.h
@@ -0,0 +1,109 @@
+/*
+ * Lagarith range decoder
+ * Copyright (c) 2009 Nathan Caldwell <saintdev (at) gmail.com>
+ * Copyright (c) 2009 David Conrad
+ *
+ * This file is part of FFmpeg.
+ *
