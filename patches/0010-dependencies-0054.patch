+/**
+ * @file
+ * h263 bitstream encoder.
+ */
+
+#include <limits.h>
+
+#include "libavutil/attributes.h"
+#include "avcodec.h"
+#include "mpegvideo.h"
+#include "mpegvideodata.h"
