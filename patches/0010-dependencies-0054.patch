+  def _AskForData(self, prompt, options):
+    if options.jobs > 1:
+      self.Print(prompt)
+      raise gclient_utils.Error("Background task requires input. Rerun "
+                                "gclient with --jobs=1 so that\n"
+                                "interaction is possible.")
+    try:
