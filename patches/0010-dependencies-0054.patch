index 0000000000000000000000000000000000000000..b29e4205564645ba81a7e9de8184e8ce9e24d185
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/idctdsp_msa.c
@@ -0,0 +1,149 @@
+/*
+ * Copyright (c) 2015 Manojkumar Bhosale (Manojkumar.Bhosale@imgtec.com)
