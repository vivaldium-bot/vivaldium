+  @staticmethod
+  def _CheckMinVersion(min_version):
+    (ok, current_version) = scm.GIT.AssertVersion(min_version)
+    if not ok:
+      raise gclient_utils.Error('git version %s < minimum required %s' %
+                                (current_version, min_version))
