diff --git a/third_party/ffmpeg/libavcodec/g729_parser.c b/third_party/ffmpeg/libavcodec/g729_parser.c
new file mode 100644
index 0000000000000000000000000000000000000000..d13c990807af632e29737758ec9e8c394d6af806
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/g729_parser.c
@@ -0,0 +1,82 @@
