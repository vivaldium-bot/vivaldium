+      assertEquals(x, right_funcs[j](a));
+    }
+  }
+
+  var result = matrix();
+  for (var i = 0; i < values.length; i++) {
+    for (var j = 0; j < values.length; j++) {
+      assertEquals(expected[i][j], result[i][j]);
+    }
+  }
+}
+test();
+test();
