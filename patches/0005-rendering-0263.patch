-<!-- Test that the viewer can handle the xlink:href attribute on          -->
-<!-- linear, radial gradients and patterns.                               -->
-<!--                                                                      -->
-<!-- Author : Haroon Sheikh  08-Mar-2000                                  -->
-<!--          & Philip Mansfield                                          -->
-<!-- Revised for 1.1 : Jun Fujisawa 19-Feb-2002                           -->
