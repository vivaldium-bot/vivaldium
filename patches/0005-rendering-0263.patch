-    <animate attributeName="fill"
-                  from="#000000" to="green"
-                  begin="0s" dur="5s" fill="freeze" />
-  </rect>
-  <rect  fill="#f00" x="140" y="50" height="100" width="90">
-    <animate attributeName="fill"
-                  from="#000000" to="#008000"
-                  begin="0s" dur="5s" fill="freeze" />
-  </rect>
-  <rect color="green" fill="#f00" x="250" y="50" height="100" width="90">
