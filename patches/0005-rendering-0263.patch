-                <use xlink:href="#shadow" x="80"/>
-
-                <rect x="-6" y="-6" width="12" height="12" fill="rgb(204,0,102)">
-                    <set id="secondSet" attributeName="x" to="74" begin="0s; secondSet.end + 1s" dur="1s" fill="remove"/>
-                </rect>
-
-            </g>
-
