+for (var i = 0; i < 5; i++) assertEquals(1 << 5, f(4));
+%OptimizeFunctionOnNextCall(f);
+assertEquals(1 << 5, f(4));
+
+var one = { valueOf: function() { return 1; } };
+assertEquals(1 << 5, f(4));
