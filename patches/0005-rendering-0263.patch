-	<!--Content of Test Case follows...                  =====================-->
-	<!--======================================================================-->
-	<g id="test-body-content">
-		<defs>
-			<color-profile id="changeColor" name="changeColor" xlink:href="resources/changeColor.ICM"/>
-		</defs>
-		<g>
