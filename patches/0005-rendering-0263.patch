+
+function Module(stdlib) {
+  "use asm";
+  function TernaryMin(a, b) {
+    a=+(a);
+    b=+(b);
+    return (+((a < b) ? a : b));
+  }
+  function TernaryMax(a, b) {
+    a=+(a);
+    b=+(b);
+    return (+((b < a) ? a : b));
+  }
+  return { TernaryMin: TernaryMin,
+           TernaryMax: TernaryMax };
+}
+var min = Module(this).TernaryMin;
+var max = Module(this).TernaryMax;
+
