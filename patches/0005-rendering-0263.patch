-		<g fill="none" stroke="black" stroke-width="4">
-			<marker id="marker2" viewBox="0 0 20 20" markerWidth="4" markerHeight="4" refX="10" refY="10" markerUnits="strokeWidth">
-				<rect width="20" height="20"/>
-			</marker>
