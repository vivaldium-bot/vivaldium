--- /dev/null
+++ b/third_party/icu/source/common/bytestrie.cpp
@@ -0,0 +1,439 @@
+/*
+*******************************************************************************
+*   Copyright (C) 2010-2011, International Business Machines
+*   Corporation and others.  All Rights Reserved.
+*******************************************************************************
+*   file name:  bytestrie.cpp
+*   encoding:   US-ASCII
