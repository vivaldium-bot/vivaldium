index 0000000000000000000000000000000000000000..2bb2ab1ed5ac199b3f910151e4f5a597d6c21bed
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_avgblur.c
@@ -0,0 +1,326 @@
