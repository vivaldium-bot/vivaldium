index 0000000000000000000000000000000000000000..88d3b75af11e3fb7b72d4b187293f453a450311c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_geq.c
@@ -0,0 +1,287 @@
+/*
