index 0000000000000000000000000000000000000000..3a1cfb8fbf3021447921b147d5d1e0b6cfdaf78e
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_deband.c
@@ -0,0 +1,312 @@
+/*
