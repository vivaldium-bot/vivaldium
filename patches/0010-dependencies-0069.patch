diff --git a/third_party/ffmpeg/libavfilter/f_realtime.c b/third_party/ffmpeg/libavfilter/f_realtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..171c16aaaa3ca815c87971eca421bd655269374c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/f_realtime.c
@@ -0,0 +1,132 @@
+/*
