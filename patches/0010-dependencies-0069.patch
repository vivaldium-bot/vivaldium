index 0000000000000000000000000000000000000000..efa31287274a5ed0077e4b488b42aa85e2dcbeb1
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_interlace.c
@@ -0,0 +1,252 @@
+/*
