index 0000000000000000000000000000000000000000..f63128d72ecef9589a2b743f5b32e484e63baaa8
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_gradfun.c
@@ -0,0 +1,265 @@
+/*
