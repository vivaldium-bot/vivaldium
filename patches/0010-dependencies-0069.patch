+    .query_formats = query_formats,
+    .uninit        = uninit,
+    .inputs        = inputs,
+    .outputs       = outputs,
+};
diff --git a/third_party/ffmpeg/libavfilter/vf_vflip.c b/third_party/ffmpeg/libavfilter/vf_vflip.c
