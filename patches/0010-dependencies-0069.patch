index 0000000000000000000000000000000000000000..3e23890208c56cb57ba87e2cae5f9c296e1037e8
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_stereo3d.c
@@ -0,0 +1,1116 @@
+/*
