new file mode 100644
index 0000000000000000000000000000000000000000..83616c1361045f3c8704793386fbc88e9fac5b7c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/settb.c
@@ -0,0 +1,187 @@
+/*
