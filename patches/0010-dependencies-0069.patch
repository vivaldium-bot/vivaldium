index 0000000000000000000000000000000000000000..33ecb1a7fbe89e505e67888bbfeea189e872e423
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_aphaser.c
@@ -0,0 +1,301 @@
+/*
