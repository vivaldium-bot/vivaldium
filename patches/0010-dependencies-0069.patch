index 0000000000000000000000000000000000000000..662386af9a53fb2d394650cbf5445a6fc3710ef3
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/xan.c
@@ -0,0 +1,648 @@
+/*
+ * Wing Commander/Xan Video Decoder
+ * Copyright (c) 2003 The FFmpeg Project
+ *
