+};
diff --git a/third_party/ffmpeg/libavfilter/vf_chromakey.c b/third_party/ffmpeg/libavfilter/vf_chromakey.c
new file mode 100644
index 0000000000000000000000000000000000000000..88414783bc8001bb39f7f53e02aa6731dae403ab
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_chromakey.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright (c) 2015 Timo Rothenpieler <timo@rothenpieler.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
