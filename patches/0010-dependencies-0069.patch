index 0000000000000000000000000000000000000000..a57c99d7974b852fc3ebff4b597da27fadbbff08
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_format.c
@@ -0,0 +1,223 @@
+/*
+ * Copyright (c) 2007 Bobby Bingham
+ *
