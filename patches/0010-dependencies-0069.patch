index 0000000000000000000000000000000000000000..49b950c4d8b15ee31c1f906aaf41f278532ff326
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/avf_showcqt.c
@@ -0,0 +1,1573 @@
