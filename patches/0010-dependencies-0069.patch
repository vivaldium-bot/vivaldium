index 0000000000000000000000000000000000000000..6f922847e7cf54784a4b576568c0f3481873cf1f
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_hflip.c
@@ -0,0 +1,201 @@
+/*
+ * Copyright (c) 2007 Benoit Fouet
+ * Copyright (c) 2010 Stefano Sabatini
+ *
