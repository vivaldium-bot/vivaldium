+static const uint8_t rainbow[7][4] = {
+    { 180, 128, 128, 255 },     /* 75% white */
+    { 162,  44, 142, 255 },     /* 75% yellow */
+    { 131, 156,  44, 255 },     /* 75% cyan */
+    { 112,  72,  58, 255 },     /* 75% green */
