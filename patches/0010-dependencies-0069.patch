+
+    int16_t *rgb[3];
+    ptrdiff_t rgb_stride;
+    unsigned rgb_sz;
+    int *dither_scratch[3][2], *dither_scratch_base[3][2];
+
+    const struct ColorPrimaries *in_primaries, *out_primaries;
+    int lrgb2lrgb_passthrough;
+    DECLARE_ALIGNED(16, int16_t, lrgb2lrgb_coeffs)[3][3][8];
+
