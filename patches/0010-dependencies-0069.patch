index 0000000000000000000000000000000000000000..01728b191f84a0677cc4d702d4e1d3b425c0878c
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_deband.c
@@ -0,0 +1,312 @@
+/*
