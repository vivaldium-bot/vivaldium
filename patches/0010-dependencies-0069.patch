index 0000000000000000000000000000000000000000..9fe2a429429aa28640650c5485e00263fd3f3e19
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_blackframe.c
@@ -0,0 +1,143 @@
+/*
