+    IDCT4_1D      w, 0, 1, 2, 3, 4, 5
+    pxor         m7, m7
+    movq    [%2+ 0], m7
+    movq    [%2+ 8], m7
+    movq    [%2+16], m7
+    movq    [%2+24], m7
