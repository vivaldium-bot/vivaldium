index 0000000000000000000000000000000000000000..48a597530b25d9dfae4b0e98b1e41e6f4e2c91f6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/hevc_deblock.asm
@@ -0,0 +1,876 @@
+;*****************************************************************************
+;* SSE2-optimized HEVC deblocking code
+;*****************************************************************************
+;* Copyright (C) 2013 VTT
+;*
+;* Authors: Seppo Tomperi <seppo.tomperi@vtt.fi>
+;*
+;* This file is part of FFmpeg.
