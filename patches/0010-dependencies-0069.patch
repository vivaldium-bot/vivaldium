index 0000000000000000000000000000000000000000..96e9d18bd3ae463cc269046283b3ba85b75b8a85
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_setfield.c
@@ -0,0 +1,94 @@
+/*
