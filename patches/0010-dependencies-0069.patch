--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/ac3dsp_init.c
@@ -0,0 +1,256 @@
+/*
+ * x86-optimized AC-3 DSP functions
+ * Copyright (c) 2011 Justin Ruggles
