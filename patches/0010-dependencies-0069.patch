index 0000000000000000000000000000000000000000..59963e14b890b01e5eda2939ac1498b20ccf6685
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/amr.c
@@ -0,0 +1,189 @@
+/*
+ * amr file format
+ * Copyright (c) 2001 FFmpeg project
