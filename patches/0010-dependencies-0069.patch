+    mova         m6, m4
+    pmullw       m4, [pw_coefhf1]
+    pmulhw       m6, [pw_coefhf1]
+    mova         m5, m4
+    punpcklwd    m4, m6
+    punpckhwd    m5, m6
+    paddd        m2, m4
+    paddd        m3, m5
+    psrad        m2, 2
+    psrad        m3, 2
+
+    mova         m4, m0
+    paddw        m0, m1
+%if ARCH_X86_64
+    LOAD%4       m5, [curq+t2*%5]
+    LOAD%4       m6, [curq+t3*%5]
+%else
+    mov          r4, prefs3mp
+    mov          r5, mrefs3mp
+    LOAD%4       m5, [curq+t0*%5]
+    LOAD%4       m6, [curq+t1*%5]
