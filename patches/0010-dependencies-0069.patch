diff --git a/third_party/ffmpeg/libavfilter/pthread.c b/third_party/ffmpeg/libavfilter/pthread.c
new file mode 100644
index 0000000000000000000000000000000000000000..ccb915eae56c8bf7f5d9bd4f869178b152bb6dfa
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/pthread.c
@@ -0,0 +1,229 @@
+/*
