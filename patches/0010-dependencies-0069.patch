diff --git a/third_party/ffmpeg/libavfilter/tests/integral.c b/third_party/ffmpeg/libavfilter/tests/integral.c
new file mode 100644
index 0000000000000000000000000000000000000000..049fefae83d36ead49c1f1317810073b5468d90a
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/tests/integral.c
@@ -0,0 +1,90 @@
+/*
