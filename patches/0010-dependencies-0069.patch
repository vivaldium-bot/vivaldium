diff --git a/third_party/ffmpeg/libavformat/avc.c b/third_party/ffmpeg/libavformat/avc.c
new file mode 100644
index 0000000000000000000000000000000000000000..094a95821f396327ff0a3398aef53ca4f10a7bcd
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/avc.c
@@ -0,0 +1,210 @@
+/*
+ * AVC helper functions for muxers
+ * Copyright (c) 2006 Baptiste Coudurier <baptiste.coudurier@smartjog.com>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
