--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_delogo.c
@@ -0,0 +1,309 @@
+/*
+ * Copyright (c) 2002 Jindrich Makovicka <makovick@gmail.com>
+ * Copyright (c) 2011 Stefano Sabatini
+ * Copyright (c) 2013, 2015 Jean Delvare <jdelvare@suse.com>
