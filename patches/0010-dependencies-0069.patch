+                                            pulse_audio_common.o timefilter.o
+OBJS-$(CONFIG_PULSE_OUTDEV)              += pulse_audio_enc.o \
+                                            pulse_audio_common.o
+OBJS-$(CONFIG_QTKIT_INDEV)               += qtkit.o
