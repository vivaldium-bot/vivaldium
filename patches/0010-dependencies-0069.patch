diff --git a/third_party/ffmpeg/libavformat/asfcrypt.c b/third_party/ffmpeg/libavformat/asfcrypt.c
new file mode 100644
index 0000000000000000000000000000000000000000..221a8a89bc013737efd8cad0c74e3f97f9dccdc1
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/asfcrypt.c
@@ -0,0 +1,195 @@
+/*
+ * ASF decryption
+ * Copyright (c) 2007 Reimar Doeffinger
+ * This is a rewrite of code contained in freeme/freeme2
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
