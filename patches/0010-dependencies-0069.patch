index 0000000000000000000000000000000000000000..a5b8e3058a2e45fbcc4afe118c0bb6d73b7007c4
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_aemphasis.c
@@ -0,0 +1,369 @@
+/*
