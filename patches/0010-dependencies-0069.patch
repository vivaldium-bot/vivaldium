+	-$(RMV) "perf-*.xml"
+	-$(RMV) $(ALL_PKGCONFIG_FILES) $(top_builddir)/config/icuinfo.xml
+	$(RMV) Doxyfile doc $(DOCZIP)
+
+distclean-local: clean-local
