diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-09-01-RemoveCopyByCommutingDef.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-09-01-RemoveCopyByCommutingDef.ll
