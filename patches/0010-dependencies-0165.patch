+    if (_xData.size() > 0)
+    {
+        s << "set(h,'xdata',"<< GetXName() <<"(1:" << _xData.size() << "),'ydata',"<< GetYName() << "(1:" << _yData.size() << "));";
+    }
+    else
+    {
+        s << "set(h,'xdata',[NaN],'ydata',[NaN]);";
