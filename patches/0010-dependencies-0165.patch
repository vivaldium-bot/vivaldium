+
+    // sanity for index
+    if (lineIndex < 0 || lineIndex >= static_cast<int>(_line.size()))
+    {
+        throw "Line index out of range";
+        exit(1);
+    }
+
+    return (_line[lineIndex]->Append(x, y));
