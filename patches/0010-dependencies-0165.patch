diff --git a/third_party/webrtc/modules/video_coding/main/source/codec_database.cc b/third_party/webrtc/modules/video_coding/main/source/codec_database.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5f899368b172e6d4d087a5895e0ec3a4e03cca4c
--- /dev/null
+++ b/third_party/webrtc/modules/video_coding/main/source/codec_database.cc
@@ -0,0 +1,739 @@
+/*
