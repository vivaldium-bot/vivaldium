+std::string MatlabLine::GetPlotString()
+{
+
+    std::ostringstream s;
+
+    if (_xData.size() == 0)
+    {
+        s << "[0 1], [0 1]"; // To get an empty plot
+    }
+    else
+    {
+        s << GetXName() << "(1:" << _xData.size() << "),";
+        s << GetYName() << "(1:" << _yData.size() << ")";
+    }
+
+    s << ", '";
+    s << _plotAttribute;
+    s << "'";
+
+    return s.str();
+}
