+  // Drops all packets in the NACK list up until |last_decoded_sequence_number|.
+  void DropPacketsFromNackList(uint16_t last_decoded_sequence_number);
+
+  void ReleaseFrameIfNotDecoding(VCMFrameBuffer* frame);
+
