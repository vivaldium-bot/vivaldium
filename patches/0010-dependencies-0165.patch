+    LOG(LS_WARNING) << "Packet payload size should be " << kCommonFeedbackLength
+                    << " instead of " << header.payload_size_bytes
+                    << " to be a valid Rapid Resynchronisation Request";
+    return false;
+  }
+
+  ParseCommonFeedback(payload);
+  return true;
+}
