diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-02-12-CoalescerBug-Impdef.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-02-12-CoalescerBug-Impdef.ll
