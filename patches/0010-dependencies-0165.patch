diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-03-13-PHIElimBug.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-03-13-PHIElimBug.ll
