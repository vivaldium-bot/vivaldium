+  Log("  Max payload size : %" PRIuS " bytes\n",
+      config.networking_config.max_payload_size_in_bytes);
+  Log("  Packet loss:\n");
+  Log("    Mode           : %s\n",
+      PacketLossModeToStr(config.networking_config.packet_loss_mode));
