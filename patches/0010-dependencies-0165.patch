+VideoRenderWindowsImpl::~VideoRenderWindowsImpl()
+{
+    delete &_renderWindowsCritsect;
+    if (_ptrRendererWin)
+    {
+        delete _ptrRendererWin;
+        _ptrRendererWin = NULL;
+    }
+}
