+declare i32 @foo1(...)
+declare zeroext i1 @foo2()
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/br-fold.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/br-fold.ll
