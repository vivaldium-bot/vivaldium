+StunMessage::StunMessage()
+    : type_(0),
+      length_(0),
+      transaction_id_(EMPTY_TRANSACTION_ID) {
+  ASSERT(IsValidTransactionId(transaction_id_));
+  attrs_ = new std::vector<StunAttribute*>();
+}
