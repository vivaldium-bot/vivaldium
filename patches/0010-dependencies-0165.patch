+int32_t ModuleRtpRtcpImpl::SetMaxTransferUnit(const uint16_t mtu) {
+  if (mtu > IP_PACKET_SIZE) {
+    LOG(LS_ERROR) << "Invalid mtu: " << mtu;
+    return -1;
+  }
+  return rtp_sender_.SetMaxPayloadLength(mtu - packet_overhead_,
+                                         packet_overhead_);
+}
