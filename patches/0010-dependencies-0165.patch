new file mode 100644
index 0000000000000000000000000000000000000000..02075d5e194e12c95d235068805a2e817184717f
--- /dev/null
+++ b/third_party/webrtc/modules/video_capture/android/device_info_android.cc
@@ -0,0 +1,256 @@
+/*
