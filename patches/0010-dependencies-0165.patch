+  if (audio_configured_) {
+    return max_payload_length_ - RTPHeaderLength();
+  } else {
+    return max_payload_length_ - RTPHeaderLength()  // RTP overhead.
+           - video_->FECPacketOverhead()            // FEC/ULP/RED overhead.
