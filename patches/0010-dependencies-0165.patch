+  if (it != _receivedCnameMap.end()) {
+    return it->second;
+  }
+  RTCPCnameInformation* cnameInfo = new RTCPCnameInformation;
+  memset(cnameInfo->name, 0, RTCP_CNAME_SIZE);
+  _receivedCnameMap[remoteSSRC] = cnameInfo;
+  return cnameInfo;
+}
