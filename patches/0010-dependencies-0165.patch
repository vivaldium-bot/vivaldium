diff --git a/third_party/webrtc/modules/video_render/video_render.h b/third_party/webrtc/modules/video_render/video_render.h
new file mode 100644
index 0000000000000000000000000000000000000000..84c9536e35cac7984c1ddbe814b16471f454946f
--- /dev/null
+++ b/third_party/webrtc/modules/video_render/video_render.h
@@ -0,0 +1,268 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
