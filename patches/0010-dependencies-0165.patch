+  EXPECT_EQ(kStableEncoding, qm_resolution_->GetEncoderState());
+  float scale = (4.0f / 3.0f) / 2.0f;
+  EXPECT_TRUE(IsSelectedActionCorrect(qm_scale_, scale, scale, 2.0f / 3.0f, 480,
