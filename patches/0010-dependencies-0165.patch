diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-05-23-dagcombine-shifts.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-05-23-dagcombine-shifts.ll
