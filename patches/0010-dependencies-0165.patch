+  for (TmmbItem& item : items_) {
+    item.Parse(next_item);
+    next_item += TmmbItem::kLength;
+  }
+  return true;
+}
+
+void Tmmbr::WithTmmbr(const TmmbItem& item) {
+  items_.push_back(item);
+}
