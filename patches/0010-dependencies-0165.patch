index 0000000000000000000000000000000000000000..e06b12eca69e269761a7e3f11c6138be936f0994
--- /dev/null
+++ b/third_party/webrtc/modules/video_processing/main/source/deflickering.cc
@@ -0,0 +1,398 @@
+/*
