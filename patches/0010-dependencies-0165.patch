diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-10-27-StackRealignment.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-10-27-StackRealignment.ll
