+H264Encoder* H264Encoder::Create() {
+  DCHECK(H264Encoder::IsSupported());
+#if defined(WEBRTC_IOS) && defined(WEBRTC_VIDEO_TOOLBOX_SUPPORTED)
+  return new H264VideoToolboxEncoder();
+#else
+  RTC_NOTREACHED();
+  return nullptr;
+#endif
+}
