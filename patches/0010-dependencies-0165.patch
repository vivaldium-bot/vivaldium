+
+
+class VideoX11Channel: public VideoRenderCallback
+{
+public:
+    VideoX11Channel(int32_t id);
+
+    virtual ~VideoX11Channel();
+
+    virtual int32_t RenderFrame(const uint32_t streamId,
+                                const VideoFrame& videoFrame);
