diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-06-13-NotVolatileLoadStore.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-06-13-NotVolatileLoadStore.ll
