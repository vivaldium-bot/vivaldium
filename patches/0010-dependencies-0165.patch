diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-08-04-MingWCrash.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-08-04-MingWCrash.ll
