+{
+    CriticalSectionScoped cs(&_renderWindowsCritsect);
+    zOrder = 0;
+    left = 0;
+    top = 0;
+    right = 0;
+    bottom = 0;
+
+    int32_t error = -1;
+    if (!_ptrRendererWin)
+    {
+    }
+    else
+    {
+        error = _ptrRendererWin->GetStreamSettings(streamId, 0, zOrder, left,
