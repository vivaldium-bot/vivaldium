diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-08-23-SubRegReuseUndo.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-08-23-SubRegReuseUndo.ll
