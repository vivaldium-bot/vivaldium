+/******************************/
+/* VCMProtectionMethod class  */
+/******************************/
+
+enum VCMProtectionMethodEnum
+{
+    kNack,
+    kFec,
+    kNackFec,
+    kNone
+};
+
+class VCMLossProbabilitySample
+{
+public:
+    VCMLossProbabilitySample() : lossPr255(0), timeMs(-1) {};
+
+    uint8_t     lossPr255;
+    int64_t     timeMs;
+};
