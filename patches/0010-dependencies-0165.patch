+        WEBRTC_TRACE(kTraceError, kTraceVideo, -1,
+                     "Direct3D render failed to find channel");
+        return -1;
+    }
+    // Only allow one stream per channel, demuxing is
+    ddobj->SetStreamSettings(0, zOrder, left, top, right, bottom);
+
+    return 0;
+}
