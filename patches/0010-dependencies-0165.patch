+
+  enum { kFrameCountHistory_size = 90};
+  enum { kFrameHistoryWindowMs = 2000};
+
+  // Temporal decimation.
+  int32_t overshoot_modifier_;
+  uint32_t drop_count_;
+  uint32_t keep_count_;
+  uint32_t target_frame_rate_;
