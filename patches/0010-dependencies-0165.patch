+  size_t RtpHeaderExtensionTotalLength() const;
+
+  uint16_t BuildRTPHeaderExtension(uint8_t* data_buffer, bool marker_bit) const;
+
+  uint8_t BuildTransmissionTimeOffsetExtension(uint8_t *data_buffer) const;
