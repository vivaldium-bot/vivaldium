diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-09-10-LoadFoldingBug.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2009-09-10-LoadFoldingBug.ll
