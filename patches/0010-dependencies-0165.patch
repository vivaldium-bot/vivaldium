+{
+
+    LockAGLCntx();
+    UnlockAGLCntx();
+    return -1;
+
+}
+
+void VideoRenderAGL::LockAGLCntx()
+{
+    _renderCritSec.Enter();
+}
+void VideoRenderAGL::UnlockAGLCntx()
+{
+    _renderCritSec.Leave();
+}
