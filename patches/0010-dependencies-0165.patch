diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-07-11-FPStackLoneUse.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-07-11-FPStackLoneUse.ll
