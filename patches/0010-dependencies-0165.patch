+  }
+  size_t items_size_bytes = header.payload_size_bytes - kCommonFeedbackLength;
+  if (items_size_bytes % TmmbItem::kLength != 0) {
+    LOG(LS_WARNING) << "Payload length " << header.payload_size_bytes
+                    << " is not valid for a TMMBR.";
+    return false;
