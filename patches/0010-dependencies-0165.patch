+  rtc::scoped_ptr<CriticalSectionWrapper> target_bitrate_critsect_;
+  uint32_t target_bitrate_ GUARDED_BY(target_bitrate_critsect_);
+
+  RTC_DISALLOW_IMPLICIT_CONSTRUCTORS(RTPSender);
