+  virtual ~RTPSender();
+
+  void ProcessBitrate();
+
+  uint16_t ActualSendBitrateKbit() const override;
+
+  uint32_t VideoBitrateSent() const;
+  uint32_t FecOverheadRate() const;
+  uint32_t NackOverheadRate() const;
