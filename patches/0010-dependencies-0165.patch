+class RtcpParseCommonHeaderTest : public ::testing::Test {
+ public:
+  RtcpParseCommonHeaderTest() { memset(buffer, 0, kBufferCapacityBytes); }
+  virtual ~RtcpParseCommonHeaderTest() {}
