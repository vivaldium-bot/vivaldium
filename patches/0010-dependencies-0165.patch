+double MatlabLine::xMin()
+{
+    if (!_xData.empty())
+    {
+        std::list<double>::iterator theStart = _xData.begin();
+        std::list<double>::iterator theEnd = _xData.end();
+        return(*min_element(theStart, theEnd));
+    }
+    return (0.0);
+}
