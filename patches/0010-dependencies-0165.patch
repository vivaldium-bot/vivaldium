diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-09-17-inline-asm-1.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-09-17-inline-asm-1.ll
