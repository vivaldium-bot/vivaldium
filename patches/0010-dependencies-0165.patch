+    decoder_->Decode(encoded_frame, false, NULL);
+    encoder_callback.GetLastEncodedFrame(&encoded_frame);
+    decoder_->Decode(encoded_frame, false, NULL);
+    EXPECT_EQ(2, decoder_callback.DecodedFrames());
+  }
