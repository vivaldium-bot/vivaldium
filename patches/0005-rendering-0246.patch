+  // Implementation of the ObjectIterator functions.
+  inline HeapObject* next_object() override;
+
+ private:
+  void Initialize(Address start, Address end);
+
+  // The current iteration point.
+  Address current_;
+  // The end of iteration.
+  Address limit_;
+};
