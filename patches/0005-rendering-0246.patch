+void RegExpMacroAssemblerX64::IfRegisterLT(int reg,
+                                           int comparand,
+                                           Label* if_lt) {
+  __ cmpp(register_location(reg), Immediate(comparand));
+  BranchOrBacktrack(less, if_lt);
