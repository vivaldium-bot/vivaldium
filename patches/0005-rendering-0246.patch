+HeapGraphEdge::HeapGraphEdge(Type type, int index, int from, int to)
+    : bit_field_(TypeField::encode(type) | FromIndexField::encode(from)),
+      to_index_(to),
+      index_(index) {
+  DCHECK(type == kElement || type == kHidden);
