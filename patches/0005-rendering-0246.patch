+
+void MacroAssembler::NumberOfOwnDescriptors(Register dst, Register map) {
+  lwu(dst, FieldMemOperand(map, Map::kBitField3Offset));
+  DecodeField<Map::NumberOfOwnDescriptorsBits>(dst);
+}
