+
+void RegExpMacroAssemblerX64::AdvanceRegister(int reg, int by) {
+  DCHECK(reg >= 0);
+  DCHECK(reg < num_registers_);
+  if (by != 0) {
+    __ addp(register_location(reg), Immediate(by));
+  }
+}
