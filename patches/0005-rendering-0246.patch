+
+#ifndef V8_RUNTIME_PROFILER_H_
+#define V8_RUNTIME_PROFILER_H_
+
+#include "src/allocation.h"
+
+namespace v8 {
+
+namespace base {
+class Semaphore;
+}
+
+namespace internal {
+
+class Isolate;
+class JSFunction;
+class Object;
+
+class RuntimeProfiler {
+ public:
+  explicit RuntimeProfiler(Isolate* isolate);
+
+  void MarkCandidatesForOptimization();
+
