+HeapGraphEdge::HeapGraphEdge(Type type, const char* name, int from, int to)
+    : bit_field_(TypeField::encode(type) | FromIndexField::encode(from)),
+      to_index_(to),
+      name_(name) {
+  DCHECK(type == kContextVariable
+      || type == kProperty
+      || type == kInternal
+      || type == kShortcut
+      || type == kWeak);
+}
