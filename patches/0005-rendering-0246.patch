+class DeleteNodesCallback {
+ public:
+  void BeforeTraversingChild(ProfileNode*, ProfileNode*) { }
+
+  void AfterAllChildrenTraversed(ProfileNode* node) {
+    delete node;
+  }
+
+  void AfterChildTraversed(ProfileNode*, ProfileNode*) { }
+};
