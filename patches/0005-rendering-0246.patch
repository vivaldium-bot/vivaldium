+
+OldSpace* OldSpaces::next() {
+  switch (counter_++) {
+    case OLD_SPACE:
+      return heap_->old_space();
+    case CODE_SPACE:
+      return heap_->code_space();
+    default:
+      return NULL;
+  }
+}
