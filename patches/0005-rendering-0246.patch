+
+void RegExpMacroAssemblerMIPS::IfRegisterLT(int reg,
+                                            int comparand,
+                                            Label* if_lt) {
+  __ ld(a0, register_location(reg));
+  BranchOrBacktrack(if_lt, lt, a0, Operand(comparand));
+}
