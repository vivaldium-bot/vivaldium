+                                             int deopt_entry_count,
+                                             PretenureFlag pretenure);
+
+  DECLARE_CAST(DeoptimizationInputData)
+
+#ifdef ENABLE_DISASSEMBLER
+  void DeoptimizationInputDataPrint(std::ostream& os);  // NOLINT
