+
+void CodeEntry::SetBuiltinId(Builtins::Name id) {
+  bit_field_ = TagField::update(bit_field_, Logger::BUILTIN_TAG);
+  bit_field_ = BuiltinIdField::update(bit_field_, id);
+}
