+
+PagedSpace* PagedSpaces::next() {
+  switch (counter_++) {
+    case OLD_SPACE:
+      return heap_->old_space();
+    case CODE_SPACE:
+      return heap_->code_space();
+    case MAP_SPACE:
+      return heap_->map_space();
+    default:
+      return NULL;
+  }
+}
