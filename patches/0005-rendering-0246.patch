+namespace v8 {
+namespace platform {
+
+WorkerThread::WorkerThread(TaskQueue* queue)
+    : Thread(Options("V8 WorkerThread")), queue_(queue) {
+  Start();
+}
+
+
+WorkerThread::~WorkerThread() {
+  Join();
+}
