+  // Minimum length for a cons string.
+  static const int kMinLength = 13;
+
+  typedef FixedBodyDescriptor<kFirstOffset, kSecondOffset + kPointerSize, kSize>
+          BodyDescriptor;
+
+  DECLARE_VERIFIER(ConsString)
