+                                            extra_ic_state());
+  } else {
+    DCHECK(kind() == Code::KEYED_STORE_IC);
+    if (is_strict(language_mode())) {
+      return isolate()->builtins()->KeyedStoreIC_Megamorphic_Strict();
+    } else {
+      return isolate()->builtins()->KeyedStoreIC_Megamorphic();
+    }
