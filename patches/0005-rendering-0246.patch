+MarkCompactCollector::MarkCompactCollector(Heap* heap)
+    :  // NOLINT
+#ifdef DEBUG
+      state_(IDLE),
+#endif
+      marking_parity_(ODD_MARKING_PARITY),
+      was_marked_incrementally_(false),
+      evacuation_(false),
+      heap_(heap),
+      marking_deque_memory_(NULL),
