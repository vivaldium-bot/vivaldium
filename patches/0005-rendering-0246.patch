+  PrintF("\n");
+  // t8, k0, LO.
+  PrintF("%3s: 0x%016lx %14ld\t%3s: 0x%016lx %14ld\t%3s: 0x%016lx %14ld\n",
+         REG_INFO(24), REG_INFO(26), REG_INFO(32));
