+int HashTableBase::ComputeCapacity(int at_least_space_for) {
+  const int kMinCapacity = 4;
+  int capacity = base::bits::RoundUpToPowerOfTwo32(at_least_space_for * 2);
+  return Max(capacity, kMinCapacity);
