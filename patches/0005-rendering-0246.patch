+void ELFSection::PopulateHeader(Writer::Slot<ELFSection::Header> header,
+                                ELFStringTable* strtab) {
+  header->name = static_cast<uint32_t>(strtab->Add(name_));
+  header->type = type_;
+  header->alignment = align_;
+  PopulateHeader(header);
+}
