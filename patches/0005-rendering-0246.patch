+Space* AllSpaces::next() {
+  switch (counter_++) {
+    case NEW_SPACE:
+      return heap_->new_space();
+    case OLD_SPACE:
+      return heap_->old_space();
+    case CODE_SPACE:
+      return heap_->code_space();
+    case MAP_SPACE:
+      return heap_->map_space();
+    case LO_SPACE:
+      return heap_->lo_space();
+    default:
+      return NULL;
+  }
+}
