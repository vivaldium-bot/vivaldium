+assertFalse(target.propertyIsEnumerable('b'));
+assertFalse(proxy.propertyIsEnumerable('b'));
diff --git a/v8/test/mjsunit/es6/proxies-prototype-handler-stackoverflow.js b/v8/test/mjsunit/es6/proxies-prototype-handler-stackoverflow.js
