index 0000000000000000000000000000000000000000..7c996e5de0c71d7a41b3ff9f98e961742c22c339
--- /dev/null
+++ b/v8/test/mjsunit/debug-setbreakpoint.js
@@ -0,0 +1,214 @@
+// Copyright 2008 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
