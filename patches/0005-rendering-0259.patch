+    }
+    assertIteratorIsClosed(iter);
+  }
+  function testSend(thunk) {
+    var iter = thunk();
+    for (var i = 0; i < expected_values_for_send.length; i++) {
+      assertIteratorResult(expected_values_for_send[i],
+                           i == expected_values_for_send.length - 1,
