index 0000000000000000000000000000000000000000..3fe9fdd143b1eab5eabe85ff57dcf908e524a39f
--- /dev/null
+++ b/v8/test/mjsunit/d8-worker-sharedarraybuffer.js
@@ -0,0 +1,106 @@
+// Copyright 2015 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
