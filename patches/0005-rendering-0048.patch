-                           compute_outer_product.apply(this, [index+1].concat(args.slice(1, index), x, args.slice(index+1)));
-                          });
-    } else {
-      rv.push(args.slice(1));
-    }
-  }
-  compute_outer_product.apply(this, [1].concat(Array.prototype.slice.call(arguments)));
-  return rv;
-}
