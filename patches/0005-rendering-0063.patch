-
-  <style type="text/css"><![CDATA[
-  html
-    {
-      writing-mode: vertical-rl;
-    }
-
-  div#containing-block
-    {
-      background: red url("support/bg-red-3col-2row-320x320.png");
-      color: transparent;
-      direction: rtl;
-      font: 80px/1 Ahem;
-      height: 320px;
-      position: relative;
-      width: 320px;
-    }
