-    assert_array_equals(d, [0, 255, 0, 255], "This pixel should be green.");
-    d = ctx.getImageData(0, 39, 1, 1).data;
-    assert_array_equals(d, [0, 0, 255, 255], "This pixel should be blue.");
-    d = ctx.getImageData(39, 39, 1, 1).data;
