-    world,
-    '(function () { ' +
-    '  var proto = Object.create(HTMLSpanElement.prototype); ' +
-    '  proto.createdCallback = function () { ' +
-    '    console.log(this.id + " entered (isolated)"); ' +
-    '  }; ' +
-    '  try { ' +
-    '    document.registerElement("x-a", {extends: "span", prototype: proto}); ' +
