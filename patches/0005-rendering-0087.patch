-    '      log(obj.id + ".q ~> " + obj.q); ' +
-    '    } ' +
-    '    inspect(window.a); ' +
-    '    inspect(document.querySelector("#y")); ' +
-    '    return messages.join(", "); ' +
-    '  } catch (e) { ' +
