-function test(testPosX, testPosY, transformCallback)
-{
-    ctx.save();
-    ctx.beginPath();
-    ctx.translate(testPosX, testPosY);
-    ctx.rect(0, 0, 100, 100);
-    // After transformCallback, no-repeat pattern should follow the new
