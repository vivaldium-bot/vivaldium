-        ctx1.beginPath();
-        ctx1.moveTo(10, 10);
-        ctx1.lineTo(90, 50);
-        ctx1.lineTo(10, 90);
-        ctx1.clip();
-        ctx1.save();
-
-        // ctx2 covers accumulation of path and rect in separate layers
