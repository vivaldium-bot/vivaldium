-                    if (e.code == 12)
-                        log("PASS: Exception raised successfully. Type: " + e);
-                    else
-                        log("FAIL: wrong exception type thrown. " + e + " was thrown, should of been Error: SyntaxError: DOM Exception 12!");
-                }
-
-
