-      .xscroll  { overflow-x: scroll;  }
-      .xauto    { overflow-x: auto;    }
-    </style>
-  </head>
-  <body>
-    <!-- min-width:auto should prevent shrinking below intrinsic width when
-         the flex item has "overflow-x: visible", but not for any other
-         overflow-x values. -->
