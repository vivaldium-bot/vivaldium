-         ><div class="child2 paddingB"><div class="filler"/></div
-         ><div class="child1 marginA"></div
-         ><div class="child2 marginB"></div
-    ></div>
-
-    <!-- Flex container has height: 50px - vertical margin and padding should
-         resolve % values against that. -->
