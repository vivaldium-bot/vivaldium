-
-      <tr><td class="lime"></td><td class="fuchsia"></td><td class="lime"></td></tr>
-
-      <tr><td class="aqua"></td><td class="fuchsia"></td><td class="aqua"></td></tr>
-
-      <tr><td class="aqua"></td><td class="aqua"></td><td class="aqua"></td></tr>
-
-  </table>
