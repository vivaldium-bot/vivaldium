+static PyObject*
+_crc8(PyObject* self, PyObject* args)
+{
+    UINT8 crc;
+    UINT8* data;
+    Py_ssize_t dataLen;
+    UINT8* table;
+    Py_ssize_t tableLen;
+
+    if (!PyArg_ParseTuple(args, INPUT8, &data, &dataLen, &crc,
+                            &table, &tableLen))
+    {
+        return NULL;
+    }
+
+    if (tableLen != 256)
+    {
+        PyErr_SetString(PyExc_ValueError, "invalid CRC table");
+        return NULL;
+    }
+
+    while (dataLen--)
+    {
+        crc = table[*data ^ crc];
+        data++;
+    }
+
+    return PyInt_FromLong((long)crc);
