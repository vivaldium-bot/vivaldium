+    rc = super(FakeDirectory, self).__str__() + ':\n'
+    for item in self.contents:
+      item_desc = self.contents[item].__str__()
+      for line in item_desc.split('\n'):
+        if line:
+          rc = rc + '  ' + line + '\n'
+    return rc
