+        # Secret shouldn't change if memcache goes away.
+        memcache.delete(appengine.XSRF_MEMCACHE_ID,
+                        namespace=appengine.OAUTH2CLIENT_NAMESPACE)
+        secret3 = appengine.xsrf_secret_key()
+        self.assertEqual(secret2, secret3)
