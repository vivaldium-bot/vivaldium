+            component, substrate = decodeFun(substrate, self.protoComponent,
+                                             allowEoo=True, **options)
+            if component is eoo.endOfOctets:
+                break
+
+            bitString += component
+
+        else:
+            raise error.SubstrateUnderrunError('No EOO seen before substrate ends')
