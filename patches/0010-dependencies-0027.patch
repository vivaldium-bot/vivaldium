+        self.assertEqual(response['CreateHostedZoneResponse']
+                                 ['DelegationSet']['NameServers'],
+                                 ['ns-100.awsdns-01.com',
+                                  'ns-1000.awsdns-01.co.uk',
+                                  'ns-1000.awsdns-01.org',
+                                  'ns-900.awsdns-01.net'])
