+    file_path = self.NormalizePath(file_path)
+    if self.Exists(file_path):
+      raise IOError(errno.EEXIST,
+                    'File already exists in fake filesystem',
+                    file_path)
+    parent_directory, new_file = self.SplitPath(file_path)
