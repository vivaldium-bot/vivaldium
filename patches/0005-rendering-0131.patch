-        var cf = Common.Color.Format;
-        for (var colorFormatKey in cf) {
-            var colorFormat = cf[colorFormatKey];
-            // Simple colors do not have RGBA and HSLA representations.
-            if (!color.hasAlpha() && (colorFormat === cf.RGBA || colorFormat === cf.HSLA))
