-        }
-    }
-
-    function dumpColorRepresentationsForColor(colorString)
-    {
-        var color = Common.Color.parse(colorString);
-        if (!color)
-            return;
-
-        InspectorTest.addResult("");
-        InspectorTest.addResult("color: " + colorString);
