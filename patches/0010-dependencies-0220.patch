+  timestamp_offset_ = rtp_state.start_timestamp;
+  last_rtp_timestamp_ = rtp_state.timestamp;
+  capture_time_ms_ = rtp_state.capture_time_ms;
+  last_timestamp_time_ms_ = rtp_state.last_timestamp_time_ms;
