+    hr = _ptrEnumerator->EnumAudioEndpoints(
+                               dir,
+                               DEVICE_STATE_ACTIVE,        // only active endpoints are OK
+                               &pCollection);
+    if (FAILED(hr))
+    {
+        _TraceCOMError(hr);
+        SAFE_RELEASE(pCollection);
+        return -1;
+    }
+
+    hr = pCollection->Item(
+                        index,
+                        ppDevice);
+    if (FAILED(hr))
+    {
+        _TraceCOMError(hr);
+        SAFE_RELEASE(pCollection);
+        return -1;
+    }
+
+    return 0;
+}
