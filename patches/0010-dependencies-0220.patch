diff --git a/third_party/webrtc/modules/audio_processing/ns/nsx_core_mips.c b/third_party/webrtc/modules/audio_processing/ns/nsx_core_mips.c
new file mode 100644
index 0000000000000000000000000000000000000000..308effc1907f9a6ca3b66cf3e300e9e44f973c02
--- /dev/null
+++ b/third_party/webrtc/modules/audio_processing/ns/nsx_core_mips.c
@@ -0,0 +1,1002 @@
+/*
