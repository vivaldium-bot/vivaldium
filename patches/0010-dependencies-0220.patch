+                                                 cricket::DCT_SCTP,
+                                                 "test",
+                                                 init_)) {}
+
+  void SetChannelReady() {
+    provider_->set_transport_available(true);
+    webrtc_data_channel_->OnTransportChannelCreated();
+    if (webrtc_data_channel_->id() < 0) {
+      webrtc_data_channel_->SetSctpSid(0);
