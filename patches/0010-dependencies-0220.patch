+void SetSettingIfFlagSet(int32_t flag, rtc::Optional<bool>* parameter) {
+  if (flag == 0) {
+    *parameter = rtc::Optional<bool>(false);
+  } else if (flag == 1) {
+    *parameter = rtc::Optional<bool>(true);
+  }
