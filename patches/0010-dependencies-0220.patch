+    _volumeMutex.Enter();
+    _ptrCaptureVolume->SetMasterVolumeLevelScalar(fLevel, NULL);
+    _volumeMutex.Leave();
+    EXIT_ON_ERROR(hr);
+
+    return 0;
+
+Exit:
+    _TraceCOMError(hr);
+    return -1;
