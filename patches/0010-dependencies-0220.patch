index 0000000000000000000000000000000000000000..34cab08befd30e927882b956f4272446e771214b
--- /dev/null
+++ b/third_party/webrtc/pc/externalhmac.cc
@@ -0,0 +1,148 @@
+/*
+ *  Copyright 2014 The WebRTC project authors. All Rights Reserved.
+ *
