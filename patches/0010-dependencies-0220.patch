+int32_t AudioMixerManagerMac::StereoRecordingIsAvailable(bool& available) {
+  if (_inputDeviceID == kAudioObjectUnknown) {
+    LOG(LS_WARNING) << "device ID has not been set";
+    return -1;
+  }
+
+  available = (_noInputChannels == 2);
+  return 0;
