+#else
+TEST(EchoCancellationBitExactnessTest,
+     DISABLED_Mono8kHz_HighLevel_NoDrift_StreamDelay0) {
+#endif
+  const float kOutputReference[] = {-0.000646f, -0.001525f, 0.002688f};
