diff --git a/third_party/webrtc/rtc_base/json_unittest.cc b/third_party/webrtc/rtc_base/json_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5b65bc8b6651ca1fc284a946ca66c7cd9c42ec3b
--- /dev/null
+++ b/third_party/webrtc/rtc_base/json_unittest.cc
@@ -0,0 +1,283 @@
+/*
+ *  Copyright 2009 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
