diff --git a/third_party/webrtc/test/fuzzers/ulpfec_receiver_fuzzer.cc b/third_party/webrtc/test/fuzzers/ulpfec_receiver_fuzzer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c850fec996a6ce5c747d62b39ff2ed60d478519d
--- /dev/null
