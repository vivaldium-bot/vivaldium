+void RtpDataChannel::OnMediaMonitorUpdate(DataMediaChannel* media_channel,
+                                          const DataMediaInfo& info) {
+  RTC_DCHECK(media_channel == this->media_channel());
+  SignalMediaMonitor(this, info);
