+      selected_candidate_pair_(nullptr) {
+  RTC_DCHECK(worker_thread_ == rtc::Thread::Current());
+#if defined(ENABLE_EXTERNAL_AUTH)
+  srtp_filter_.EnableExternalAuth();
+#endif
