+// Helper to set an error and return from a method.
+bool SafeSetError(webrtc::RTCErrorType type, webrtc::RTCError* error) {
+  if (error) {
+    error->set_type(type);
+  }
+  return type == webrtc::RTCErrorType::NONE;
+}
