diff --git a/third_party/webrtc/p2p/base/sessiondescription.cc b/third_party/webrtc/p2p/base/sessiondescription.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1e69c83e76243da6d0864025624435a2e12d2d01
--- /dev/null
+++ b/third_party/webrtc/p2p/base/sessiondescription.cc
@@ -0,0 +1,229 @@
+/*
+ *  Copyright 2010 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
