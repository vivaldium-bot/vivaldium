+  for (int i = 0; i < S_NUM_STATS; ++i) {
+    len += rtc::sprintfn(buffer, arraysize(buffer), "%s%s:%d",
+                               (i == 0) ? "" : ",", STAT_NAMES[i], g_stats[i]);
+    g_stats[i] = 0;
+  }
+  LOG(LS_INFO) << "Stats[" << buffer << "]";
+}
