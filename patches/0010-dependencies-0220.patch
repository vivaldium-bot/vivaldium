+TEST(AudioMixer, MixingRateShouldBeDecidedByRateCalculator) {
+  constexpr int kOutputRate = 22000;
+  const auto mixer =
+      AudioMixerImpl::Create(std::unique_ptr<OutputRateCalculator>(
