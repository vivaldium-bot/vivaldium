+  ASSERT_EQ(fragmentation.fragmentationLength[1], packet.payload_size());
+  VerifySingleNaluPayload(fragmentation, 1, frame, packet.payload());
+
+  EXPECT_FALSE(packetizer->NextPacket(&packet));
+}
