+TEST(RtpPayloadRegistryTest,
+     DoesNotAcceptSamePayloadTypeTwiceExceptIfPayloadIsCompatible) {
+  uint8_t payload_type = 97;
+  RTPPayloadRegistry rtp_payload_registry;
