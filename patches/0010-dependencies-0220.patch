+
+  rtcp::Sdes* sdes = new rtcp::Sdes();
+  sdes->AddCName(ssrc_, cname_);
+
+  for (const auto& it : csrc_cnames_)
+    RTC_CHECK(sdes->AddCName(it.first, it.second));
+
+  return std::unique_ptr<rtcp::RtcpPacket>(sdes);
+}
