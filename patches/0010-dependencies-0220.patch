+                         std::string* error_desc);
+  bool SetSrtp_n(const std::vector<CryptoParams>& params,
+                 ContentAction action,
+                 ContentSource src,
+                 const std::vector<int>& encrypted_extension_ids,
+                 std::string* error_desc);
+  bool SetRtcpMux_n(bool enable,
+                    ContentAction action,
+                    ContentSource src,
+                    std::string* error_desc);
