+TEST_F(WebRtcSdpTest, SerializeSessionDescription) {
+  // SessionDescription with desc and candidates.
+  std::string message = webrtc::SdpSerialize(jdesc_, false);
+  TestMismatch(std::string(kSdpFullString), message);
+}
