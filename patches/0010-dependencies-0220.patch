+#ifndef WEBRTC_AUDIO_DEVICE_PA_RINGBUFFER_H
+#define WEBRTC_AUDIO_DEVICE_PA_RINGBUFFER_H
+/*
+ * $Id: pa_ringbuffer.h 1421 2009-11-18 16:09:05Z bjornroche $
