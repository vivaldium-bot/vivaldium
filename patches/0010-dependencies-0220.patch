+  rtc::SocketAddress first_addr(turn_port_->socket()->GetLocalAddress());
+
+  // Clear connected_ flag on turnport to suppress the release of
+  // the allocation.
+  turn_port_->OnSocketClose(turn_port_->socket(), 0);
+
