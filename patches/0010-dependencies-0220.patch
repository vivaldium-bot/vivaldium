+TEST_F(TransportControllerTest, TestGetRemoteSSLCertificate) {
+  rtc::FakeSSLCertificate fake_certificate("fake_data");
+
+  FakeDtlsTransport* transport = CreateFakeDtlsTransport("audio", 1);
+  ASSERT_NE(nullptr, transport);
