+template <class T>
+static std::vector<std::string> GetCodecNames(const std::vector<T>& codecs) {
+  std::vector<std::string> codec_names;
+  for (const auto& codec : codecs) {
+    codec_names.push_back(codec.name);
+  }
+  return codec_names;
+}
