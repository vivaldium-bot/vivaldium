+  bool has_data() { return data().size() > 0; }
+
+  FakeTransportChannel* channel() { return channel_.get(); }
+
+  ReliableQuicStream* incoming_stream() { return last_incoming_stream_; }
+
+ private:
+  // Transports QUIC packets to/from peer.
