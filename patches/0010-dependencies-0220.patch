+TEST_F(MediaSessionDescriptionFactoryTest,
+       CreateDataAnswerToOfferWithUnknownProtocol) {
+  MediaSessionOptions opts;
+  opts.data_channel_type = cricket::DCT_RTP;
+  opts.recv_audio = false;
+  f1_.set_secure(SEC_ENABLED);
