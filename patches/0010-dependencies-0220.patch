+    }
+
+    loop++;
+  } while (loop < kMaxPacketsInSession);
+
+  // Max number of packets inserted.
+  // Insert one more packet.
+  seq_num_++;
+  packet_->is_first_packet_in_frame = false;
+  packet_->markerBit = true;
+  packet_->seqNum = seq_num_;
