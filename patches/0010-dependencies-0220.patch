+  nada_sender_.set_original_operating_mode(true);
+  for (int i = 0; i < 100; ++i) {
+    int previous_bitrate = nada_sender_.bitrate_kbps();
+    nada_sender_.GiveFeedback(not_congested_fb);
+    EXPECT_GE(nada_sender_.bitrate_kbps(), previous_bitrate);
