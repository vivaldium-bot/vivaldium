+
+#define WEBRTC_CA_LOG_WARN(expr)                                         \
+  do {                                                                   \
+    err = expr;                                                          \
+    if (err != noErr) {                                                  \
+      logCAMsg(rtc::LS_WARNING, "Error in " #expr,                       \
+               (const char*) & err);                                     \
+    }                                                                    \
+  } while (0)
