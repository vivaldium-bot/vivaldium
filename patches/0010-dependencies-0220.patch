+#ifndef WEBRTC_P2P_QUIC_QUICSESSION_H_
+#define WEBRTC_P2P_QUIC_QUICSESSION_H_
+
+#include <memory>
+#include <string>
+
+#include "net/quic/quic_crypto_client_stream.h"
