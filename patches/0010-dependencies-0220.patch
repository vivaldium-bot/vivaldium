+
+static const int kInputSamples = 50;
+
+static const int16_t kInput[kInputSamples] = {
+    -2136,  -7116, 10715,  2464,   3164,   8139,   11393, 24013, -32117, -5544,
+    -27740, 10181, 14190,  -24055, -15912, 17393,  6359,  -9950, -13894, 32432,
