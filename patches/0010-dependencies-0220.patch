+
+#ifndef WEBRTC_RTC_BASE_IPADDRESS_H_
+#define WEBRTC_RTC_BASE_IPADDRESS_H_
+
+#if defined(WEBRTC_POSIX)
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#endif
