+  // Slots for signals (sigslot) that are wired up to |pc_|.
+  void OnDataChannelCreated(DataChannel* channel);
+  // Slots for signals (sigslot) that are wired up to |channel|.
+  void OnDataChannelOpened(DataChannel* channel);
