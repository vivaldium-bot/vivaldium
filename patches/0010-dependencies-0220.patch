diff --git a/third_party/webrtc/rtc_base/sigslot.h b/third_party/webrtc/rtc_base/sigslot.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec4232cdca1420a4eeb8676c77d7c0ab1b29efc7
