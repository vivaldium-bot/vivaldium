+      ns_speech_prob_average += apm_->noise_suppression()->speech_probability();
+
+      size_t frame_size = frame_->samples_per_channel_ * frame_->num_channels_;
+      size_t write_count = fwrite(frame_->data(),
+                                  sizeof(int16_t),
+                                  frame_size,
+                                  out_file_);
+      ASSERT_EQ(frame_size, write_count);
