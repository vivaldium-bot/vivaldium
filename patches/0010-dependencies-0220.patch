+void RTPReceiverStrategy::SetLastMediaSpecificPayload(
+    const PayloadUnion& payload) {
+  rtc::CritScope cs(&crit_sect_);
+  memcpy(&last_payload_, &payload, sizeof(last_payload_));
+}
