+  // Get the certificate from the RTP channel's DTLS handshake. Should be
+  // identical to the RTCP channel's, since they were given the same remote
+  // fingerprint.
+  const RefCountedChannel* ch = GetChannel_n(transport_name, 1);
+  if (!ch) {
