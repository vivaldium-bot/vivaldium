index 0000000000000000000000000000000000000000..bfd6778c123c5bfb7ea2750f4f1cd89e756ed531
--- /dev/null
+++ b/third_party/webrtc/modules/video_coding/timing.h
@@ -0,0 +1,143 @@
+/*
