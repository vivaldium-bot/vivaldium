+
+#include <memory>
+
+#if defined(WEBRTC_WIN)
+#include "webrtc/rtc_base/win32.h"
+#else  // !WEBRTC_WIN
+#define SEC_E_CERT_EXPIRED (-2146893016)
+#endif  // !WEBRTC_WIN
+
+#include "webrtc/rtc_base/checks.h"
+#include "webrtc/rtc_base/httpbase.h"
