+                                 XFA_ATTRIBUTE eAttribute) {
+  CXFA_Occur occur(this);
+  if (bSetting) {
+    int32_t iMin = pValue->ToInteger();
+    occur.SetMin(iMin);
+  } else {
+    pValue->SetInteger(occur.GetMin());
+  }
+}
