+        canvas->drawBitmap(bm4444, SkIntToScalar(bm.width()), 0);
+    }
+
+private:
+    typedef GM INHERITED;
+};
+
+//////////////////////////////////////////////////////////////////////////////
+
+static GM* MyFactory(void*) { return new CopyTo4444GM; }
+static GMRegistry reg(MyFactory);
