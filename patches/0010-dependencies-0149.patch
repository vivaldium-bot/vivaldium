+            continue;
+
+          uCount++;
+          double dValue = ValueToDouble(pThis, newPropertyValue.get());
+          dMaxValue = (uCount == 1) ? dValue : std::max(dMaxValue, dValue);
+        }
+      }
+    } else if (argValue->IsObject()) {
+      auto newPropertyValue = pdfium::MakeUnique<CFXJSE_Value>(pIsolate);
