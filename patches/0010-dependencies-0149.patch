+    FX_STRSIZE ptPos = wsWideNarrowRatio.Find(':');
+    float fRatio = 0;
+    if (ptPos >= 0) {
+      fRatio = (float)FXSYS_wtoi(wsWideNarrowRatio.c_str());
+    } else {
+      int32_t fA, fB;
+      fA = FXSYS_wtoi(wsWideNarrowRatio.Left(ptPos).c_str());
+      fB = FXSYS_wtoi(wsWideNarrowRatio.Mid(ptPos + 1).c_str());
+      if (fB)
+        fRatio = (float)fA / fB;
+    }
+    val = fRatio;
+    return true;
+  }
+  return false;
+}
