index 0000000000000000000000000000000000000000..fcc32c89c4d16c12d0ae84caae12e155ba235a18
--- /dev/null
+++ b/third_party/skia/src/gpu/GrPathUtils.h
@@ -0,0 +1,180 @@
+/*
