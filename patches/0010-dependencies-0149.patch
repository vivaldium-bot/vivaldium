+  XFA_ATTRIBUTEENUM m_ePageSetMode;
+  bool m_bCreateOverFlowPage;
+  std::map<CXFA_Node*, int32_t> m_pPageSetMap;
+  std::vector<CXFA_ContainerLayoutItem*> m_PageArray;
