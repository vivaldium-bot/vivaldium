+#Enum BitDepth
+
+#Code
+    enum class BitDepth {
+        kU8,
+        kF16,
+    };
+##
+
+#Const kU8 0
+Use 8 bits per Color_ARGB component using unsigned integer format.
+##
+#Const kF16 1
+Use 16 bits per Color_ARGB component using half-precision floating point format.  
