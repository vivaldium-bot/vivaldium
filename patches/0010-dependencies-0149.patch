+            for (int i = 0; i < 20; ++i) {
+                array[i] = make_scalar();
+            }
+            return SkColorFilter::MakeMatrixFilterRowMajor255(array);
+        }
+        case 1:
+            return SkLumaColorFilter::Make();
+        case 2: {
+            uint8_t tableA[256];
+            uint8_t tableR[256];
