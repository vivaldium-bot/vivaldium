+        this->INHERITED::setupPaint(paint);
+        // draw non opaque rect
+        paint->setAlpha(0x80);
+    }
+
+    const char* onGetName() override {
+        fName.set(this->INHERITED::onGetName());
+        fName.prepend("transparent_");
+        return fName.c_str();
+    }
