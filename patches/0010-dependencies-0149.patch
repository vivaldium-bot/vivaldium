+const wchar_t RUNTIMEBLOCKTEMPARRAY[] =
+    L"foxit_xfa_formcalc_runtime_block_temp_array";
+
+const wchar_t RUNTIMEBLOCKTEMPARRAYINDEX[] =
+    L"foxit_xfa_formcalc_runtime_block_temp_array_index";
+
