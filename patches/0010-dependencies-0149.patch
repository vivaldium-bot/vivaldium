+void SkDebuggerGUI::actionSaveAs() {
+    QString filename = QFileDialog::getSaveFileName(this, "Save File", "",
+            "Skia Picture (*skp)");
+    if (!filename.endsWith(".skp", Qt::CaseInsensitive)) {
+        filename.append(".skp");
+    }
+    saveToFile(SkString(filename.toAscii().data()));
+}
