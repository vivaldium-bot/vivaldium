index 0000000000000000000000000000000000000000..ccff378ceecb0ada0db3ccff1c7198d8e4c0904f
--- /dev/null
+++ b/third_party/skia/src/effects/SkMagnifierImageFilter.cpp
@@ -0,0 +1,422 @@
+/*
