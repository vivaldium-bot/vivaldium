+    var pathStr = ArcStart(circle.center, circle.radius, 0, (now - circle.start) / (dur / 359.9));
+
+    circle.setAttribute("d", MakeArc(pathStr));
+    circleFill.setAttribute("d", MakeWedge(circle.center, pathStr));
+    if (!animating) {
