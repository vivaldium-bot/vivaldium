+
+    bool internalDrawPath(GrRenderTargetContext*,
+                          const GrPaint&,
+                          const GrUserStencilSettings&,
+                          const GrClip&,
+                          const SkMatrix& viewMatrix,
+                          const GrShape&,
+                          bool stencilOnly);
+
