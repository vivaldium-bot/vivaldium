diff --git a/third_party/scons-2.0.1/README.nacl b/third_party/scons-2.0.1/README.nacl
new file mode 100644
index 0000000000000000000000000000000000000000..5fd35e9b9f84298618170fb26ea11909e9870c20
--- /dev/null
