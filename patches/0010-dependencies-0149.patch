+      case TOKksgt:
+        NextToken();
+        e2 = ParseAddtiveExpression();
+        if (m_pErrorInfo->message.IsEmpty()) {
+          e1 = pdfium::MakeUnique<CXFA_FMRelationalExpression>(
+              line, TOKgt, std::move(e1), std::move(e2));
+        } else {
+          e1.reset();
+        }
+        continue;
+      case TOKle:
+      case TOKksle:
+        NextToken();
+        e2 = ParseAddtiveExpression();
+        if (m_pErrorInfo->message.IsEmpty()) {
+          e1 = pdfium::MakeUnique<CXFA_FMRelationalExpression>(
+              line, TOKle, std::move(e1), std::move(e2));
+        } else {
+          e1.reset();
