+        if (!data.length) {
+            break;
+        }
+        var ch = data[0];
+        if (('0' <= ch && ch <= '9') || ch == '-' || ch == '+') {
+            assert(op != '\0');
+        } else if (ch == ' ' || ch == ',') {
+            data = skip_sep(data);
+        } else {
