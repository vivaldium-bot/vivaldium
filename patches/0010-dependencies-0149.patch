+void CXFA_FFDocView::AddInvalidateRect(CXFA_FFPageView* pPageView,
+                                       const CFX_RectF& rtInvalidate) {
+  if (m_mapPageInvalidate[pPageView]) {
+    m_mapPageInvalidate[pPageView]->Union(rtInvalidate);
