+  std::unique_ptr<CXFA_LayoutPageMgr> m_pLayoutPageMgr;
+  std::vector<CXFA_Node*> m_rgChangedContainers;
+  uint32_t m_nProgressCounter;
+  bool m_bNeedLayout;
+};
