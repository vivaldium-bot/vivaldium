+    params.m_dwStates = pDataInfo->dwStates;
+    if (j + 1 == m_iHovered)
+      params.m_dwStates |= CFWL_PartState_Hovered;
+    params.m_dwTTOStyles = FDE_TTOSTYLE_SingleLine;
+    pTheme->DrawText(&params);
+  }
+}
