new file mode 100644
index 0000000000000000000000000000000000000000..62595cf1eef38157f0840dfb171d9b6cc414b021
--- /dev/null
+++ b/third_party/skia/src/effects/SkArithmeticMode.cpp
@@ -0,0 +1,161 @@
+/*
