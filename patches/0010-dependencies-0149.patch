+template <>
+inline void Fuzz::next(SkImageFilter::CropRect* cropRect) {
+    SkRect rect;
+    uint8_t flags;
+    this->next(&rect);
+    this->nextRange(&flags, 0, 0xF);
+    *cropRect = SkImageFilter::CropRect(rect, flags);
+}
