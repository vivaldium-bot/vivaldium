+CXFA_NodeHelper::CXFA_NodeHelper()
+    : m_eLastCreateType(XFA_Element::DataValue),
+      m_pCreateParent(nullptr),
+      m_iCreateCount(0),
+      m_iCreateFlag(XFA_RESOLVENODE_RSTYPE_CreateNodeOne),
