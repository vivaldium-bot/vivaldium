+
+const FXJSE_CLASS_DESCRIPTOR NormalClassDescriptor = {
+    "XFAObject",  // name
+    nullptr,      // constructor
+    nullptr,      // properties
+    nullptr,      // methods
+    0,            // property count
+    0,            // method count
+    CXFA_ScriptContext::NormalPropTypeGetter,
+    CXFA_ScriptContext::NormalPropertyGetter,
+    CXFA_ScriptContext::NormalPropertySetter,
+    nullptr,  // property deleter
