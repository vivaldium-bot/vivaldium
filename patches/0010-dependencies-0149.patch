+        canvas->save();
+        canvas->clipRect(rect, SkRegion::kReplace_Op, true);
+        canvas->drawRect(r, p);
+        canvas->restore();
+
+        p.setColor(SK_ColorBLUE);
+        p.setStrokeWidth(2);
+        canvas->drawRect(rect, p);
+
+        p.setColor(SK_ColorRED);
+        p.setAntiAlias(true);
+        p.setStyle(SkPaint::kStroke_Style);
+        p.setStrokeWidth(22);
+
+        SkRect r2 = SkRect::MakeXYWH(20, 140, 100, 100);
