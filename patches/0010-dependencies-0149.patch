+CXFA_Node* CXFA_WidgetData::GetSelectedMember() {
+  CXFA_Node* pSelectedMember = nullptr;
+  CFX_WideString wsState = GetRawValue();
+  if (wsState.IsEmpty())
+    return pSelectedMember;
