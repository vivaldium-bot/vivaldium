+  bool ToRun(const XFA_TextPiece* pPiece, FX_RTFTEXTOBJ* tr);
+  void DoTabstops(CFDE_CSSComputedStyle* pStyle, CXFA_PieceLine* pPieceLine);
+  bool Layout(int32_t iBlock);
