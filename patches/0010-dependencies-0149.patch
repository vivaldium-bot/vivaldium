+namespace sksg {
+
+InvalidationController::InvalidationController() : fBounds(SkRect::MakeEmpty()) {}
+
+void InvalidationController::inval(const SkRect& r, const SkMatrix& ctm) {
+    if (r.isEmpty()) {
+        return;
+    }
+
+    SkTCopyOnFirstWrite<SkRect> rect(r);
+
+    if (!ctm.isIdentity()) {
+        ctm.mapRect(rect.writable());
+    }
+
+    fRects.push(*rect);
+    fBounds.join(*rect);
+}
+
+} // namespace sksg
