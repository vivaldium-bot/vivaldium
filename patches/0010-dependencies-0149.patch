+        host, port = ftplib.parse227(self.client.sendcmd('pasv'))
+        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        s.settimeout(2)
+        try:
+            s.connect((host, port))
+        finally:
+            s.close()
+
