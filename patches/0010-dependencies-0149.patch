+    class AutoValidate : SkNoncopyable {
+    public:
+        AutoValidate(const SkGradientBitmapCache* bc) : fBC(bc) { bc->validate(); }
+        ~AutoValidate() { fBC->validate(); }
+    private:
+        const SkGradientBitmapCache* fBC;
+    };
+};
