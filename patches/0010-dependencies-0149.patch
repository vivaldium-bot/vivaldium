diff --git a/third_party/re2/src/util/test.cc b/third_party/re2/src/util/test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..fb31ed812e5f7e6e89aaa75198011116762ae276
--- /dev/null
+++ b/third_party/re2/src/util/test.cc
@@ -0,0 +1,34 @@
+// Copyright 2009 The RE2 Authors.  All Rights Reserved.
+// Use of this source code is governed by a BSD-style
