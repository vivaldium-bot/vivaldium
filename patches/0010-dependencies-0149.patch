+void SkGammaColorFilter::filterSpan(const SkPMColor src[], int count,
+                                    SkPMColor dst[]) const {
+    // Gamma-correcting bytes to bytes is pretty questionable.
+    SkASSERT(0);
+    for (int i = 0; i < count; ++i) {
