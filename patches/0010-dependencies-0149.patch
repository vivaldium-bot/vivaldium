+
+#Return  integral rectangle from origin to width() and height() ##
+
+#Example
+#Height 128
+#Image 4
+    canvas->scale(.5f, .5f);
+    SkIRect bounds = source.bounds();
+    for (int x : { 0, bounds.width() } ) {
