index 0000000000000000000000000000000000000000..f0efc19a1a5b138a10744e67e4d2ddbc0843e46e
--- /dev/null
+++ b/third_party/skia/fuzz/FuzzCommon.h
@@ -0,0 +1,88 @@
+/*
