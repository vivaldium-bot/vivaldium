+                    accum += sk_float_floor(data[i]);
+                }
+                this->process(accum);
+            }
+        }
+    }
+
+    const char* onGetName() override {
+        return fName;
+    }
+
+private:
+    const char*     fName;
+
+    typedef Benchmark INHERITED;
+};
