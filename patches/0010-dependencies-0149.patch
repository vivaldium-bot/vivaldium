+    keywords=['ftp', 'ftps', 'server', 'ftpd', 'daemon', 'python', 'ssl',
+              'sendfile', 'rfc959', 'rfc1123', 'rfc2228', 'rfc2428', 'rfc3659'],
+    classifiers=[
