+  javascript << L");\n";
+  javascript << L"var ";
+  javascript << RUNTIMEBLOCKTEMPARRAYINDEX;
+  javascript << L" = 0;\n";
+  javascript << L"while(";
+  javascript << RUNTIMEBLOCKTEMPARRAYINDEX;
+  javascript << L" < ";
+  javascript << RUNTIMEBLOCKTEMPARRAY;
+  javascript << L".length)\n{\n";
+  if (m_wsIdentifier.GetAt(0) == L'!') {
+    CFX_WideString tempIdentifier =
