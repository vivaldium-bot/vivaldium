new file mode 100644
index 0000000000000000000000000000000000000000..cec8bee97bde06b0d00a617f92624f0d1b6eb7e4
--- /dev/null
+++ b/third_party/skia/src/gpu/GrStencilSettings.cpp
@@ -0,0 +1,490 @@
+/*
