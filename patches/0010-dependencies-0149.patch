+                data = find_scalar(data, y, relative, c.y);
+                path += "ctx.lineTo(" + c.x + "," + yObj.value+ ");\n";
+                c.y = yObj.value;
+            } break;
+            case 'C':
+                data = find_points(data, points, 3, relative, c);
+                path += "ctx.bezierCurveTo(" + points[0].x + "," + points[0].y + ","
+                    + points[1].x + "," + points[1].y + ","
+                    + points[2].x + "," + points[2].y + ");\n";
+                lastc = points[1];
+                c = points[2];
+                break;
+            case 'S':
