+// Same as DecryptString(...), but used by vivaldi during import of passwords.
+bool OSCrypt::DecryptImportedString16(const std::string& ciphertext,
+                                      base::string16* plaintext,
+                                      const std::string& service_name,
+                                      const std::string& account_name) {
+  std::string utf8;
+  if (ciphertext.empty()) {
+    utf8 = std::string();
+    *plaintext = base::UTF8ToUTF16(utf8);
+    return true;
+  }
+
+  // Check that the incoming cyphertext was indeed encrypted with the expected
+  // version.  If the prefix is not found then we'll assume we're dealing with
+  // old data saved as clear text and we'll return it directly.
+  // Credit card numbers are current legacy data, so false match with prefix
+  // won't happen.
+  if (ciphertext.find(kEncryptionVersionPrefix) != 0) {
+    utf8 = ciphertext;
+    *plaintext = base::UTF8ToUTF16(utf8);
+    return true;
+  }
+
+  // Strip off the versioning prefix before decrypting.
+  std::string raw_ciphertext =
+  ciphertext.substr(strlen(kEncryptionVersionPrefix));
+
+  crypto::SymmetricKey* encryption_key = GetEncryptionKey(service_name,
+                                                          account_name);
+  if (!encryption_key)
+    return false;
+
+  std::string iv(kCCBlockSizeAES128, ' ');
+  crypto::Encryptor encryptor;
+  if (!encryptor.Init(encryption_key, crypto::Encryptor::CBC, iv))
+    return false;
+
+  if (!encryptor.Decrypt(raw_ciphertext, &utf8))
+    return false;
+
+  *plaintext = base::UTF8ToUTF16(utf8);
+  return true;
+}
