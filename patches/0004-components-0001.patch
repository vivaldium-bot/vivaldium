+  temp = speeddial ? "true" : "false";
+
+  SetMetaInfo("Speeddial", temp);
+}
+
+bool BookmarkNode::GetSpeeddial() const
+{
+  std::string temp;
+  if (GetMetaInfo("Speeddial",&temp))
+    return temp == "true";
+
+  return false;
+}
