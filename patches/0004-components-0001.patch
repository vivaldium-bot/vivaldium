+// gisli@vivaldi.com: Added RestorePreviousSession.
+std::vector<LiveTab*> PersistentTabRestoreService::RestorePreviousSession(
+    LiveTabContext* context,
+    chrome::HostDesktopType host_desktop_type) {
+
+  int count = delegate_->previous_active_entries_count();
+  TabRestoreService::Entries previous_entries;
+  for (TabRestoreService::Entries::const_iterator it = entries().begin();
+      it != entries().end() && count > 0; ++it) {
+    Entry* entry = *it;
+    if (entry->type == TabRestoreService::WINDOW) {
+      Window* window = static_cast<Window*>(entry);
+      // Ignore popups.
+      if (window->ext_data.find("\"windowType\":\"popup\"") == std::string::npos) {
+        count--;
+        previous_entries.push_back(*it);
+      }
+    }
+  }
+
+  std::vector<LiveTab*> contents;
+  for (TabRestoreService::Entries::iterator it = previous_entries.begin();
+      it != previous_entries.end(); ++it) {
+    std::vector<LiveTab *> entryContents =
+       helper_.RestoreEntryById(context, (*it)->id, host_desktop_type, UNKNOWN);
+    contents.insert( contents.end(), entryContents.begin(), entryContents.end() );
+  }
+  return contents;
+}
