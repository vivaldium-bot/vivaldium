+    crypto::SymmetricKey::DeriveKeyFromPassword(crypto::SymmetricKey::AES,
+                                                password,
+                                                salt,
+                                                kEncryptionIterations,
+                                                kDerivedKeySizeInBits);
+  ANNOTATE_LEAKING_OBJECT_PTR(import_cached_encryption_key);
