+                                       int max_hits,
+                                       URLRows* results) {
+  results->clear();
+  sql::Statement statement(
+      GetDB().GetCachedStatement(SQL_FROM_HERE, sql_statement));
+
+  statement.BindString(0, search_string);
+  statement.BindString(1, search_string);
+  statement.BindInt(2, max_hits);
