+ *//*--------------------------------------------------------------------*/
+
+#include "rsgDefs.hpp"
+#include "rsgShader.hpp"
+#include "rsgVariableValue.hpp"
+#include "tcuTexture.hpp"
+#include "rsgSamplers.hpp"
+
