+			m_log << TestLog::EndSection;
+		});
+	ES2F_ADD_API_CASE(buffer_data, "Invalid glBufferData() usage",
+		{
+			GLuint buffer;
+			glGenBuffers(1, &buffer);
+			glBindBuffer(GL_ARRAY_BUFFER, buffer);
+
