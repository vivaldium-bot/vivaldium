+	std::vector<tcu::Vec4>					drawBuffer;
+	std::vector<PointSceneSpec::ScenePoint>	points;
+
+	// last iteration, max out size
+	if (m_primitiveWideness == PRIMITIVEWIDENESS_WIDE &&
