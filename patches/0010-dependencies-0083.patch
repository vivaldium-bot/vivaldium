+struct VarValue
+{
+	glu::DataType type;
+
+	union
+	{
+		float		floatV[4*4]; // At most mat4. \note Matrices here are column-major.
+		deInt32		intV[4];
+		bool		boolV[4];
+		struct
+		{
+			int		unit;
+			float	fillColor[4];
+		} samplerV;
+	} val;
+};
