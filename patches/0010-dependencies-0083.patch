+glu::ProgramSources programSources (const string& vertexSource, const string& fragmentSource)
+{
+	glu::ProgramSources sources;
+
+	sources << glu::VertexSource(vertexSource) << glu::FragmentSource(fragmentSource);
+
+	return sources;
+}
