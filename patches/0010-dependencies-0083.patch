+float IntLiteral::getWeight (const GeneratorState& state, ConstValueRangeAccess valueRange)
+{
+	DE_UNREF(state);
+	const VariableType& type = valueRange.getType();
+	if (type == VariableType(VariableType::TYPE_INT, 1))
