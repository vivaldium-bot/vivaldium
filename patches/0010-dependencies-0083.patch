+};
+
+ColoredRect::ColoredRect (const IVec2& bottomLeft_, const IVec2& topRight_, const Color& color_)
+	: bottomLeft (bottomLeft_)
+	, topRight	 (topRight_)
+	, color		 (color_)
+{
+}
