+    public void testExceptionRunningAndTearDown() {
+        // With 1.4, we should
+        // wrap the exception thrown while running with the exception thrown
+        // while tearing down
+        Test t = new TornDown() {
+            @Override
+            public void tearDown() {
+                throw new Error("tearingDown");
+            }
+        };
