+			"void main (void)\n"
+			"{\n"
+			"	gl_FragColor = vec4(0.0);\n"
+			"}\n";
+
+		glu::ShaderProgram program(m_context.getRenderContext(), glu::makeVtxFragSources(testVertSource, testFragSource));
