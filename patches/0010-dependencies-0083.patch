+			m_log << tcu::TestLog::EndSection;
+
+			m_log << tcu::TestLog::Section("", "GL_INVALID_ENUM is generated if type is not GL_UNSIGNED_BYTE or GL_UNSIGNED_SHORT.");
+			glDrawElements(GL_TRIANGLES, 1, -1, vertices);
