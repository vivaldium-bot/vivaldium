+			m_log << tcu::TestLog::EndSection;
+
+			m_log << tcu::TestLog::Section("", "GL_INVALID_VALUE is generated if count is negative.");
+			glDrawElements(GL_TRIANGLES, -1, GL_UNSIGNED_BYTE, vertices);
+			expectError(GL_INVALID_VALUE);
+			m_log << tcu::TestLog::EndSection;
