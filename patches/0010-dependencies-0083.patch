+class TexCubeCompletenessCase : public tcu::TestCase
+{
+public:
+							TexCubeCompletenessCase		(tcu::TestContext& testCtx, glu::RenderContext& renderCtx, const char* name, const char* description);
+							~TexCubeCompletenessCase	(void) {};
