+
+		return (deleteStatus == GL_TRUE);
+	}
+
+	void deleteShaders (void)
+	{
+		glDeleteShader(m_vertShader);
+		glDeleteShader(m_fragShader);
+		GLU_CHECK();
+	}
+
+	void test (void)
