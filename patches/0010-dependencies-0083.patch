+			{
+				m_log << TestLog::Section("", "GL_INVALID_VALUE is generated if level is less than 0.");
+				glCompressedTexImage2D(GL_TEXTURE_2D, -1, compressedFormats[0], 0, 0, 0, 0, 0);
