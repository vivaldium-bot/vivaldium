+	// Check contexts and pbuffers
+	{
+		MemoryStressCase::Spec spec;
+
+		spec.types		= (ObjectType)(OBJECTTYPE_PBUFFER|OBJECTTYPE_CONTEXT);
+		spec.minWidth	= 64;
