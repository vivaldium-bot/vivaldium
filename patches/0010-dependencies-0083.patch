+		}
+
+		m_log << tcu::TestLog::Message << buffer << tcu::TestLog::EndMessage;
+		TCU_FAIL("Failed to compile shader");
+	}
+
+	GLuint program = m_gl.createProgram();
+	GLU_CHECK_GLW_MSG(m_gl, "glCreateProgram()");
+
