+	for (int i = 0; i < Size; i++)															\
+		res[i] = SCALAR_OP_NAME(v[i], s0, s1);												\
+	return res;																				\
+}
+
+#define DEFINE_FLOAT_FLOAT_VEC_FUNCTION(FUNC_NAME, SCALAR_OP_NAME)							\
