+- (void)testNilImage {
+  UIImage *image = [[UIImage alloc] init];
+  UIImage *actual = [image gtm_imageByResizingToSize:CGSizeMake(100, 100)
+                                 preserveAspectRatio:YES
+                                           trimToFit:NO];
+  XCTAssertNil(actual, @"Invalid inputs should return nil");
+}
