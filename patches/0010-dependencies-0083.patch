+#ifndef _RSGVARIABLEVALUE_HPP
+#define _RSGVARIABLEVALUE_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Random Shader Generator
+ * ----------------------------------------------------
+ *
