+	ES2F_ADD_API_CASE(gen_buffers, "Invalid glGenBuffers() usage",
+		{
+			m_log << TestLog::Section("", "GL_INVALID_VALUE is generated if n is negative.");
+			glGenBuffers(-1, 0);
