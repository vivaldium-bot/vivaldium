+void GetBooleanVerifier::verifyFloatRange (tcu::TestContext& testCtx, GLenum name, GLfloat min, GLfloat max)
+{
+	using tcu::TestLog;
+
+	StateQueryMemoryWriteGuard<GLboolean[2]> range;
