+
+	inline tcu::Vec4 sample (float s, float t, float r, float lod) const
+	{
+		return m_texture->sample(m_sampler, s, t, r, lod);
+	}
+
+private:
+	const tcu::TextureCube*		m_texture;
+	tcu::Sampler				m_sampler;
