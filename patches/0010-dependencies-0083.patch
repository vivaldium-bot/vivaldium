+{
+	DE_ASSERT(numBytes >= getMinSize());
+	DE_ASSERT(offset%getAlignment() == 0);
+	DE_ASSERT((offset+numBytes)%getAlignment() == 0);
+	return m_verifier->verify(buffer, reference, offset, numBytes);
+}
