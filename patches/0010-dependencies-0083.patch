+#define WGL_ALPHA_SHIFT_ARB							0x201C
+#define WGL_ACCUM_BITS_ARB							0x201D
+#define WGL_ACCUM_RED_BITS_ARB						0x201E
+#define WGL_ACCUM_GREEN_BITS_ARB					0x201F
