+	int						maxStatementDepth;
+	int						maxStatementsPerBlock;
+	int						maxExpressionDepth;
+	int						maxCombinedVariableScalars;
+	int						maxUniformScalars;
+	int						maxInputVariables;
+
+	float					texLookupBaseWeight;
+	int						maxSamplers;
