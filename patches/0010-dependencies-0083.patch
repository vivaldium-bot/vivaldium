+static tcu::Vec4 genRandomVector (de::Random& rnd)
+{
+	tcu::Vec4 retVal;
+
+	retVal.x() = rnd.getFloat(-1.0f, 1.0f);
+	retVal.y() = rnd.getFloat(-1.0f, 1.0f);
+	retVal.z() = rnd.getFloat(-1.0f, 1.0f);
+	retVal.w() = rnd.getFloat( 0.2f, 1.0f);
+
+	return retVal;
+}
