+
+#include <stdexcept>
+
+#if !defined(DEQP_GLES2_RUNTIME_LOAD)
+#	if (DE_OS == DE_OS_IOS)
+#		include <OpenGLES/ES2/gl.h>
+#	else
+#		include <GLES2/gl2.h>
+#	endif
+#endif
+
