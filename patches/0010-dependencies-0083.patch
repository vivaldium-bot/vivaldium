+void CompressedCubeFormatCase::init (void)
+{
+	// Create texture.
+	DE_ASSERT(m_filenames.size() % 6 == 0);
+	m_texture = TextureCube::create(m_renderCtx, m_renderCtxInfo, m_testCtx.getArchive(), (int)m_filenames.size()/6, m_filenames);
+
+	m_curFace	= 0;
