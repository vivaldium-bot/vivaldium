+
+static const char* const s_clientExtensionList[] =
+{
+	"EGL_EXT_platform_base",
+	"EGL_EXT_client_extensions",
+	"EGL_EXT_platform_x11",
+	"EGL_KHR_client_get_all_proc_addresses",
+	"EGL_MESA_platform_gbm",
