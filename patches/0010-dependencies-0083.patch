+        }
+
+        public Date notADataPoint() {
+            return new Date();
+        }
+
+        @Theory
+        public void allIntsOk(int x) {
+
+        }
+
+        @Theory
+        public void onlyStringsOk(String s) {
+
+        }
+
+        @Theory
+        public void onlyDatesOk(Date d) {
+
+        }
+    }
