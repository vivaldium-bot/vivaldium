+void IsEnabledVerifier::verifyBooleanAnything (tcu::TestContext& testCtx, GLenum name)
+{
+	DE_UNREF(testCtx);
+	DE_UNREF(name);
+	DE_ASSERT(false && "not supported");
+}
+// GetBooleanVerifier
