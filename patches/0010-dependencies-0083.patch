+				if (threadCount * contextCount != 4 && threadCount * contextCount != 1)
+					continue;
+
+				TestConfig config				= basicConfig;
+				config.threadCount				= threadCount;
+				config.perThreadContextCount	= contextCount;
+				config.sharedContexts			= false;
