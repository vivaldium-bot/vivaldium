+
+	virtual const RenderTarget&		getRenderTarget			(void) const { return m_renderTarget;	}
+	virtual deUint32				getDefaultFramebuffer	(void) const { return *m_framebuffer;	}
+	virtual void					postIterate				(void);
+
+private:
