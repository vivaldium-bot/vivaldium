+			simpleGroup->addChild(pbufferGroup);
+
+			eglu::FilterList baseFilters;
+			baseFilters << surfaceType<EGL_PBUFFER_BIT>;
+
+			std::vector<NamedFilterList> filterLists;
+			getDefaultFilterLists(filterLists, baseFilters);
