index 0000000000000000000000000000000000000000..5612b6621a5efdf8922c4d70690f06d2b0460f9d
--- /dev/null
+++ b/third_party/grpc/test/core/end2end/fuzzers/client_fuzzer.c
@@ -0,0 +1,163 @@
