+			glActiveTexture(-1);
+			expectError(GL_INVALID_ENUM);
+			int numMaxTextureUnits = m_context.getContextInfo().getInt(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS);
+			glActiveTexture(GL_TEXTURE0 + numMaxTextureUnits);
+			expectError(GL_INVALID_ENUM);
+			m_log << TestLog::EndSection;
