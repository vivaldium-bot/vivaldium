+    public void testTearDownFails() {
+        TestCase fails = new TestCase("success") {
+            @Override
+            protected void tearDown() {
+                throw new Error();
+            }
+
+            @Override
+            protected void runTest() {
+            }
+        };
+        verifyError(fails);
