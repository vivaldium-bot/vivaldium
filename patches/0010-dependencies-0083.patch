+try, TK_TRY
+var, TK_VAR
+void, TK_VOID
+while, TK_WHILE
+with, TK_WITH
+%%
+
+int js_keyword_lookup (register const char *str, register int len)
+{
+  struct js_keyword * keyword = js_kw_lookup(str,len);
+  if (keyword)
+    return keyword->token;
+  else
+    return TK_IDENT;
+}
