+CullingTest::CullingTest (Context& ctx, const char* name, const char* desc, glw::GLenum cullMode, glw::GLenum primitive, glw::GLenum faceOrder)
+	: BaseRenderingCase	(ctx, name, desc)
+	, m_cullMode		(cullMode)
