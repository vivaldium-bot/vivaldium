+		const std::string		caseName		= name + "_" + shaderTypeName;
+		const std::string		caseDesc		= "Build program, " + desc + ", for " + shaderTypeName + " shader.";
+
+		group->addChild(new T(context, caseName.c_str(), caseDesc.c_str(), shaderType));
+	}
+}
