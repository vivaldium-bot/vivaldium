+void IsEnabledVerifier::verifyBoolean4 (tcu::TestContext& testCtx, GLenum name, bool reference0, bool reference1, bool reference2, bool reference3)
+{
+	DE_UNREF(testCtx);
+	DE_UNREF(name);
+	DE_UNREF(reference0);
+	DE_UNREF(reference1);
+	DE_UNREF(reference2);
+	DE_UNREF(reference3);
+	DE_ASSERT(false && "not supported");
+}
