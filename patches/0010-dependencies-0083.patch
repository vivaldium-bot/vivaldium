+		deUint32			tex			= 0;
+		tcu::TextureLevel	levelData	(fmt);
+		de::Random			rnd			(deStringHash(getName()));
+
+		glGenTextures(1, &tex);
+		glBindTexture(GL_TEXTURE_2D, tex);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+
+		for (int ndx = 0; ndx < numLevels; ndx++)
+		{
+			int		levelW		= de::max(1, m_width >> ndx);
