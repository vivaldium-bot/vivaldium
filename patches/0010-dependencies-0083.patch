+		case GL_NOTEQUAL:	return rr::TESTFUNC_NOTEQUAL;
+		default:
+			DE_ASSERT(false);
+			return rr::TESTFUNC_LAST;
+	}
+}
+
+rr::StencilOp mapGLStencilOp (deUint32 op)
