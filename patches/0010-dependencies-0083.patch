+						width		!= dst.getWidth()	||
+						height		!= dst.getHeight(), GL_INVALID_OPERATION, RC_RET_VOID);
+		}
+		else
+			texture->allocLevel(level, storageFmt, width, height);
+
+		// Copy from current framebuffer.
