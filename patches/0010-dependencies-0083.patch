+struct DataStoreSpec
+{
+	DataStoreSpec (void)
+		: target	(0)
+		, usage		(0)
+		, size		(0)
+	{
+	}
+
+	DataStoreSpec (deUint32 target_, deUint32 usage_, int size_)
+		: target	(target_)
+		, usage		(usage_)
+		, size		(size_)
