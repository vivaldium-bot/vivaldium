+void initES20Direct (Functions* gl)
+{
+#if !defined(DEQP_GLES2_RUNTIME_LOAD)
+#	include "glwInitES20Direct.inl"
+#else
+	DE_UNREF(gl);
+	throw std::runtime_error("Binaries were compiled without ES2 direct loading support");
+#endif
+}
+
+} // glw
