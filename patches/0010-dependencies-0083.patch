+	IterateResult		iterate				(void);
+	void				checkExtensions		(void);
+
+private:
+	EGLConfig			getConfig			(void);
+
+	const TestSpec		m_spec;
+
+	vector<ImageApi*>	m_apiContexts;
+
+	EGLDisplay			m_display;
+	eglu::NativeWindow*	m_window;
+	EGLSurface			m_surface;
+	EGLConfig			m_config;
+	int					m_curIter;
