+void ZeroSlopeTestCase::testPolygonOffset (void)
+{
+	using tcu::TestLog;
+
+	const tcu::Vec4 triangle[] =
+	{
+		tcu::Vec4(-0.4f,  0.4f, 0.0f, 1.0f),
