-    var y = element.offsetTop + element.offsetHeight / 2;
-    eventSender.mouseMoveTo(x, y);
-    eventSender.mouseDown();
-    eventSender.mouseMoveTo(maxX, y + ARBITRARY_DELTA);
-    eventSender.mouseUp();
