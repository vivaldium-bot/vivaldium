index 0000000000000000000000000000000000000000..b7781854a45907ae9566bddc18ac85cb263c7139
--- /dev/null
+++ b/third_party/openmax_dl/dl/sp/src/mips/omxSP_FFT_F32TwiddleTable.c
@@ -0,0 +1,1871 @@
+/*
+ *  Copyright (c) 2014 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ *
+ */
+
+#include "dl/api/omxtypes.h"
+
+/*
+ * Twiddle table for split radix FFT in float format.
+ * It contains factors cos (W * i) where W = 2*PI/N and 0 <= i < N/4.
+ * N is the max size of the FFT. Here is N = 2^12 or N = 2^15, depending
+ * on the TWIDDLE_TABLE_ORDER parameter.
+ */
+
+const OMX_F32 mipsSP_FFT_F32TwiddleTable[1 << (TWIDDLE_TABLE_ORDER - 2)] = {
+#if TWIDDLE_TABLE_ORDER == 15
+    1.0000000000f, 1.0000000000f, 0.9999999404f, 0.9999998212f, 0.9999997020f,
+    0.9999995232f, 0.9999993443f, 0.9999991059f, 0.9999988079f, 0.9999985099f,
+    0.9999981523f, 0.9999977946f, 0.9999973774f, 0.9999969006f, 0.9999964237f,
+    0.9999958873f, 0.9999952912f, 0.9999946952f, 0.9999940395f, 0.9999933839f,
+    0.9999926686f, 0.9999918938f, 0.9999911189f, 0.9999902844f, 0.9999893904f,
+    0.9999884963f, 0.9999876022f, 0.9999865890f, 0.9999855757f, 0.9999845624f,
+    0.9999834299f, 0.9999823570f, 0.9999811649f, 0.9999799728f, 0.9999787211f,
+    0.9999774694f, 0.9999761581f, 0.9999748468f, 0.9999734759f, 0.9999720454f,
+    0.9999706149f, 0.9999691248f, 0.9999675751f, 0.9999660254f, 0.9999644160f,
+    0.9999627471f, 0.9999610782f, 0.9999594092f, 0.9999576211f, 0.9999558330f,
+    0.9999540448f, 0.9999521971f, 0.9999502897f, 0.9999483824f, 0.9999464154f,
+    0.9999443889f, 0.9999423623f, 0.9999402761f, 0.9999381304f, 0.9999359846f,
