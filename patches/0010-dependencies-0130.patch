+
+static void radeonRenderMode( struct gl_context *ctx, GLenum mode )
+{
+   r100ContextPtr rmesa = R100_CONTEXT(ctx);
+   FALLBACK( rmesa, RADEON_FALLBACK_RENDER_MODE, (mode != GL_RENDER) );
+}
