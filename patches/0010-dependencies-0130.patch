+void InitRandomLayerRefIdxData (PDqLayer pDqLayer) {
+  for (int32_t i = 0; i < pDqLayer->iMbWidth * pDqLayer->iMbHeight; ++i) {
+    for (int32_t j = 0; j < MB_BLOCK4x4_NUM; ++j) {
+      pDqLayer->pRefIndex[0][i][j] = (rand() % 18 - 2); //-2 ~ 15
+    }
+  }
+}
