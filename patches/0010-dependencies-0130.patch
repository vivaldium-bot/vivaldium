+//DECODER_OPTION_DATAFORMAT
+void DecoderInterfaceTest::TestDataFormat() {
+  int iTmp = rand();
+  int iOut;
+  CM_RETURN eRet;
+
+  Init();
+
+  //invalid input
+  eRet = (CM_RETURN) m_pDec->SetOption (DECODER_OPTION_DATAFORMAT, NULL);
