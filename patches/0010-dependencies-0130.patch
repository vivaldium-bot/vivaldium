+/*
+ * Windows (Win32/Win64) device driver for Mesa
+ *
+ */
+
+#include "wmesadef.h"
+#include "colors.h"
+#include "GL/wmesa.h"
+#include <winuser.h>
+#include "main/context.h"
+#include "main/extensions.h"
