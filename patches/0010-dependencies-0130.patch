+                      OMXFFTSpec_R_F32 *fft_fwd_spec) {
+  return omxSP_FFTFwd_RToCCS_F32_Sfs(x, y, fft_fwd_spec);
+}
+
+OMXResult InverseRFFT(OMX_F32* y,
+                      OMX_F32* z,
+                      OMXFFTSpec_R_F32 *fft_inv_spec) {
+  return omxSP_FFTInv_CCSToR_F32_Sfs(y, z, fft_inv_spec);
+}
