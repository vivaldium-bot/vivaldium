+        @//LDR     pTwiddle, [pFFTSpec, #ARMsFFTSpec_pTwiddle]
+        LDR     pOut, [pFFTSpec, #ARMsFFTSpec_pBuf]
+        
+        
+        MOV     pTmpDst,pDst
+        ADD     pDst,pOut,N, LSL #2
+        
+        
+        BL      omxSP_FFTInv_CCSToR_S32_Sfs
+        
+        ADD     pDst,pOut,N, LSL #2
+        
+        CMP     N,#2
+        BGT     copyLoop
+        BEQ     copyS32ToS16
+        VLD1    dX0[0],[pDst]
+        VQMOVN  dY0,qX0
+        VST1    dY0[0],[pTmpDst]
+        
+        B       End
+        
+copyS32ToS16:   
+        
+        VLD1    dX0,[pDst]
+        VQMOVN  dY0,qX0
+        VST1    dY0S32[0],[pTmpDst]
+        B       End
+
+copyLoop:               
+              
+        VLD1    {dX0,dX01},[pDst]!
+        SUBS    N,N,#4
+        VQMOVN  dY0,qX0
+        VST1    dY0,[pTmpDst]!
+        
