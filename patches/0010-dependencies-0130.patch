index 0000000000000000000000000000000000000000..501cee42ea4a5a4f94e43a54db3215bdb56a6f4c
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/drivers/dri/i965/brw_gs_emit.c
@@ -0,0 +1,539 @@
+/*
