+static inline GLuint
+clamp_float_to_uint(GLfloat f)
+{
+   return f < 0.0F ? 0 : F_TO_I(f);
+}
+
+
+static inline GLuint
+clamp_half_to_uint(GLhalfARB h)
+{
+   GLfloat f = _mesa_half_to_float(h);
+   return f < 0.0F ? 0 : F_TO_I(f);
+}
