+  for (int32_t k = 0; k < SVC_ME_TEST_NUM; k++) {\
+    FillWithRandomData (uiRefBuf,16*320);\
+    iRes[0] = anchor (uiRefBuf,320);\
+    iRes[1] = method (uiRefBuf,320);\
+    ASSERT_EQ (iRes[0], iRes[1]);\
+  }\
+}
