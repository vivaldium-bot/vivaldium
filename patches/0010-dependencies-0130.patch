+  for (i = 0; i <= iMbFirstSliceEnd; ++i) {
+    pDqLayer->pSliceIdc[i] = 0; //to keep simple value here
+  }
+  for (; i < iTotalMbNum; ++i) {
+    pDqLayer->pSliceIdc[i] = 1; //to keep simple value here
+  }
