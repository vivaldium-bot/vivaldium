+
+void radeon_teximage_unmap(radeon_texture_image *image)
+{
+	radeon_print(RADEON_TEXTURE, RADEON_VERBOSE,
+			"%s(img %p)\n",
+			__func__, image);
+	if (image->mt) {
+		assert(image->base.Map);
+
+		image->base.Map = 0;
+		radeon_bo_unmap(image->mt->bo);
+	}
+}
