+    WelsDequantFour4x4_c (pInput[0], g_kuiDequantCoeff[uiQp]);
+    sFuncPtrList.pfDequantizationFour4x4 (pInput[1], g_kuiDequantCoeff[uiQp]);
+    for (int32_t i = 0 ; i < 64; i++) {
+      ASSERT_EQ (pInput[0][i], pInput[1][i]);
+    }
+  }
+}
