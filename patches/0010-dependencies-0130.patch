+         n[3].i = width;
+         n[4].e = format;
+         n[5].e = type;
+         n[6].data = unpack_image(ctx, 1, width, 1, 1, format, type, table,
+                                  &ctx->Unpack);
+      }
+      if (ctx->ExecuteFlag) {
+         CALL_ColorTable(ctx->Exec, (target, internalFormat, width,
+                                     format, type, table));
