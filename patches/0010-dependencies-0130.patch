+void copy (uint8_t* pDst, int32_t iDStride, uint8_t* pSrc, int32_t iSStride, int32_t iWidth, int32_t iHeight) {
+  for (int i = 0; i < iHeight; i++)
+    memcpy (pDst + i * iDStride, pSrc + i * iSStride, iWidth);
+}
