+			for func in api.functionIterateByCategory(name):
+				if func.client_supported_for_indirect():
+					if preamble:
+						print preamble
+						preamble = None
+
+					if func.is_abi():
+						print '    table[{offset}] = (_glapi_proc) __indirect_gl{name};'.format(name = func.name, offset = func.offset)
+					else:
