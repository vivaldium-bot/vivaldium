+      GLubyte v[4];
+      _mesa_unclamped_float_rgba_to_ubyte(v, src[i]);
+      d[i*3+2] = v[RCOMP];
+      d[i*3+1] = v[GCOMP];
+      d[i*3+0] = v[BCOMP];
+   }
+}
+
+
+/*
+ * MESA_FORMAT_BGR888
+ */
