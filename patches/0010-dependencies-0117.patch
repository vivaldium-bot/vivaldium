+#  WITHOUT ANY WARRANTY; without even the implied warranty of
+#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
+#  Lesser General Public License for more details.
+#
+#  You should have received a copy of the GNU Lesser General Public
+#  License along with liblouis. If not, see
+#  <http://www.gnu.org/licenses/>.
+	
+include eo-g1.ctb
+	
+correct "cx" "ĉ"
+correct "cX" "ĉ"
+correct "Cx" "Ĉ"
+correct "CX" "Ĉ"
+correct "gx" "ĝ"
+correct "gX" "ĝ"
+correct "Gx" "Ĝ"
+correct "GX" "Ĝ"
+correct "hx" "ĥ"
+correct "hX" "ĥ"
+correct "Hx" "Ĥ"
+correct "HX" "Ĥ"
+correct "jx" "ĵ"
+correct "jX" "ĵ"
+correct "Jx" "Ĵ"
+correct "JX" "Ĵ"
+correct "sx" "ŝ"
+correct "sX" "ŝ"
+correct "Sx" "Ŝ"
+correct "SX" "Ŝ"
+correct "ux" "ŭ"
+correct "uX" "ŭ"
+correct "Ux" "Ŭ"
+correct "UX" "Ŭ"
