index 0000000000000000000000000000000000000000..c3157500cf7744fde5e9270b764d71952b547199
--- /dev/null
+++ b/third_party/webrtc/modules/audio_processing/agc/legacy/gain_control.h
@@ -0,0 +1,247 @@
