+TEST(AudioBufferTest, SetNumChannelsDeathTest) {
+  AudioBuffer ab(kNumFrames, kMono, kNumFrames, kMono, kNumFrames);
+  EXPECT_DEATH(ab.set_num_channels(kStereo), "num_channels");
+}
+#endif
