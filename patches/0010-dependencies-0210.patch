+void ApmTest::Init(AudioProcessing* ap) {
+  ASSERT_EQ(kNoErr,
+            ap->Initialize(
+                {{{frame_->sample_rate_hz_, frame_->num_channels_},
+                  {output_sample_rate_hz_, num_output_channels_},
+                  {revframe_->sample_rate_hz_, revframe_->num_channels_},
+                  {revframe_->sample_rate_hz_, revframe_->num_channels_}}}));
