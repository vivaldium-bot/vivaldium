-    if(checkInitialization(builder, "table52") != null) return;
-    var nodeList;
-      var testNode;
-      var vvalign;
-      var doc;
-
-      var docRef = null;
-      if (typeof(this.doc) != 'undefined') {
-        docRef = this.doc;
-      }
-      doc = load(docRef, "doc", "tablecol");
-      nodeList = doc.getElementsByTagName("col");
