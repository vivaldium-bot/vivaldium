+
+bool supportsDeviceBufferWrites (Usage usage)
+{
+	if (usage & USAGE_TRANSFER_DST)
+		return true;
+
+	if (usage & USAGE_STORAGE_BUFFER)
+		return true;
+
+	if (usage & USAGE_STORAGE_TEXEL_BUFFER)
+		return true;
+
+	return false;
+}
