+					"};\n"
+					"void main (void) {\n"
+					"\tgl_PointSize = 1.0;\n"
+					"\thighp vec4 val = imageLoad(u_image, ivec2((gl_VertexIndex / 2) / imageSize(u_image).x, (gl_VertexIndex / 2) % imageSize(u_image).x));\n"
+					"\thighp vec2 pos;\n"
+					"\tif (gl_VertexIndex % 2 == 0)\n"
+					"\t\tpos = val.xy;\n"
+					"\telse\n"
+					"\t\tpos = val.zw;\n"
+					"\tgl_Position = vec4(1.998 * pos - vec2(0.999), 0.0, 1.0);\n"
