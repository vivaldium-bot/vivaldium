+	bool											isSome						(void) const;
+	bool											isNone						(void) const;
+	bool											isIdentitySwizzle			(void) const;
+
+	tcu::Vector<TextureSwizzleComponent, 4>&		getSwizzle					(void);
+	const tcu::Vector<TextureSwizzleComponent, 4>&	getSwizzle					(void) const;
