+static VkSampleCountFlagBits getVkSampleCount (int numSamples)
+{
+	switch (numSamples)
+	{
+		case 0:		return VK_SAMPLE_COUNT_1_BIT;
+		case 2:		return VK_SAMPLE_COUNT_2_BIT;
+		case 4:		return VK_SAMPLE_COUNT_4_BIT;
+		default:
+			DE_ASSERT(false);
+			return (VkSampleCountFlagBits)0;
+	}
+}
