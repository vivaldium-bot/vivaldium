+														  const ImageType				imageType,
+														  const tcu::UVec3&				imageSize,
+														  const TextureFormat&			format,
+														  const AtomicOperation			operation);
+
+	tcu::TestStatus				iterate					 (void);
+
+	virtual deUint32			getOutputBufferSize		 (void) const = 0;
+
