+/*--------------------------------------------------------------------*//*!
+ * \brief Texture format
+ *//*--------------------------------------------------------------------*/
+class TextureFormat
+{
+public:
+	enum ChannelOrder
+	{
+		R = 0,
+		A,
+		I,
+		L,
+		LA,
+		RG,
+		RA,
