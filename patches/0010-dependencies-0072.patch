+
+	flushMappedMemoryRange(deviceInterface, device, vertexBufferAllocation.getMemory(), vertexBufferAllocation.getOffset(), vertexDataDesc.dataSize);
+
+	const VkVertexInputBindingDescription vertexBinding =
+	{
+		0u,							// deUint32				binding;
