+	COMPRESSEDTEXFORMAT_ETC2_EAC_RGBA8,
+	COMPRESSEDTEXFORMAT_ETC2_EAC_SRGB8_ALPHA8,
+
+	COMPRESSEDTEXFORMAT_ASTC_4x4_RGBA,
+	COMPRESSEDTEXFORMAT_ASTC_5x4_RGBA,
+	COMPRESSEDTEXFORMAT_ASTC_5x5_RGBA,
