+pt{
+    Version{"2.1.7.45"}
+    exceptions{
+        SentenceBreak:array{
+            "psicol.",
+            "fig.",
+            "compl.",
+            "rep.",
+            "cap.",
+            "doc.",
+            "fisiol.",
+            "dipl.",
+            "astron.",
+            "port.",
+            "eletr\u00F4n.",
+            "geom.",
+            "mov.",
+            "ago.",
+            "trad.",
+            "arquit.",
+            "dez.",
+            "ed.",
+            "apt.",
+            "Exmo.",
+            "col.",
+            "ff.",
+            "univ.",
+            "res.",
