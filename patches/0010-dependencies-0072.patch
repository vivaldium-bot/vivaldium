+TCU_DECLARE_VECTOR_BINARY_FUNC(step, deFloatStep)
+TCU_DECLARE_VECTOR_TERNARY_FUNC(smoothStep, deFloatSmoothStep)
+
+} // tcu
+
+#endif // _TCUVECTORUTIL_HPP
