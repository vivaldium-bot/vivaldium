+		DE_NULL,
+		(vk::VkPipelineShaderStageCreateFlags)0,
+		stage,			// stage
+		shader,			// shader
+		"main",
+		DE_NULL,		// pSpecializationInfo
+	};
+	return stageCreateInfo;
+}
