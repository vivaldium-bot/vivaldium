+		}
+
+		if (config.usage & USAGE_STORAGE_IMAGE)
+		{
+			{
+				// Vertex storage image
+				const char* const vertexShader =
+					"#version 450\n"
+					"precision highp float;\n"
+					"layout(set=0, binding=0, rgba8) uniform image2D u_image;\n"
