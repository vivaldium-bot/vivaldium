+{
+	if (isDebugReportSupported(vkp))
+		return MovePtr<vk::DebugReportRecorder>(new vk::DebugReportRecorder(vki, instance));
+	else
+		TCU_THROW(NotSupportedError, "VK_EXT_debug_report is not supported");
+}
