+
+	de::MovePtr<Buffer>			m_outputBuffer;
+	Move<VkDescriptorPool>		m_descriptorPool;
+	Move<VkDescriptorSetLayout>	m_descriptorSetLayout;
+	Move<VkDescriptorSet>		m_descriptorSet;
