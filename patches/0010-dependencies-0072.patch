+template<typename T>
+T chooseRandom (de::Random& rng, const set<T>& values)
+{
+	size_t							ndx		= ((size_t)rng.getUint32()) % values.size();
+	typename set<T>::const_iterator	iter	= values.begin();
+
+	for (; ndx > 0; ndx--)
+		iter++;
+
+	return *iter;
+}
