+TestInstance* GeometryOutputCountTest::createInstance (Context& context) const
+{
+	return new GeometryOutputCountTestInstance (context, VK_PRIMITIVE_TOPOLOGY_POINT_LIST, static_cast<int>(m_pattern.size()), getName());
+}
