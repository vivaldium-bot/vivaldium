+struct DrawParamsBase
+{
+	std::vector<PositionColorVertex>	vertices;
+	vk::VkPrimitiveTopology				topology;
+
+	DrawParamsBase ()
+	{}
+
+	DrawParamsBase (const vk::VkPrimitiveTopology top)
+		: topology	(top)
+	{}
+};
