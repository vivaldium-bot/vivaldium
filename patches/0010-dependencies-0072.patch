+
+		m_spec.inputs.push_back(Symbol("value", glu::VarType(baseType, precision)));
+		m_spec.outputs.push_back(Symbol("msb", glu::VarType(intType, glu::PRECISION_LOWP)));
+		m_spec.source = "msb = findMSB(value);";
+		init();
+	}
