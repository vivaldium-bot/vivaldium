+    GLU_EXPECT_NO_ERROR(gl.getError(), "Query TF varyings");
+
+    {
+        vector&lt;char&gt; nameBuf(maxNameLen+1);
+
+        for (int ndx = 0; ndx &lt; numTfVaryngs; ndx++)
+        {
+            ...
+</pre>
