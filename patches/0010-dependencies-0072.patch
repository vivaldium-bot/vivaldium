+/*--------------------------------------------------------------------*//*!
+ * \brief Texture swizzle
+ *//*--------------------------------------------------------------------*/
+struct TextureSwizzle
+{
+	enum Channel
+	{
+		// \note CHANNEL_N must equal int N
+		CHANNEL_0 = 0,
+		CHANNEL_1,
+		CHANNEL_2,
+		CHANNEL_3,
+
+		CHANNEL_ZERO,
+		CHANNEL_ONE,
+
+		CHANNEL_LAST
+	};
+
+	Channel components[4];
+};
