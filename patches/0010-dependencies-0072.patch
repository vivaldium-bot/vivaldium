+static const char* s_inSwizzles[MAX_INPUTS][4] =
+{
+	{ "z", "wy", "zxy", "yzwx" },
+	{ "x", "yx", "yzx", "wzyx" },
+	{ "y", "zy", "wyz", "xwzy" }
+};
