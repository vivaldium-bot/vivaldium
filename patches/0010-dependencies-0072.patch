+			<< tcu::TestLog::Message
+			<< "Line " << (lineNdx+1) << ":"
+			<< "\n\t" << outLines[lineNdx].positions[0]
+			<< "\n\t" << outLines[lineNdx].positions[1]
+			<< tcu::TestLog::EndMessage;
