+
+		group->addChild(new TexelBufferDescriptorCase(group->getTestContext(),
+													  s_texelBufferTypes[ndx].name,
+													  s_texelBufferTypes[ndx].description,
+													  isPrimaryCmdBuf,
+													  descriptorType,
+													  exitingStages,
+													  activeStages,
+													  dimension,
+													  s_texelBufferTypes[ndx].flags));
