+	const vk::VkCommandBuffer	commandBuffer	= context.getCommandBuffer();
+	const vk::VkImageCopy		region			=
+	{
+		{
+			vk::VK_IMAGE_ASPECT_COLOR_BIT,
+			0,	// mipLevel
+			0,	// arrayLayer
+			1	// layerCount
+		},
+		{ 0, 0, 0 },
+
+		{
+			vk::VK_IMAGE_ASPECT_COLOR_BIT,
+			0,	// mipLevel
+			0,	// arrayLayer
+			1	// layerCount
+		},
