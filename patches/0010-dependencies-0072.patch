+enum
+{
+	TEXCUBE_VIEWPORT_SIZE		= 28,
+
+	TEX2D_VIEWPORT_WIDTH		= 64,
+	TEX2D_VIEWPORT_HEIGHT		= 64,
+
+	TEX3D_VIEWPORT_WIDTH		= 64,
+	TEX3D_VIEWPORT_HEIGHT		= 64,
+};
