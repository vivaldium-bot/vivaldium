+fate-vsynth%-mpeg2-ilace:        ENCOPTS = -qscale 10 -flags +ildct+ilme
+fate-vsynth%-mpeg2-ivlc-qprd:    ENCOPTS = -b:v 500k                    \
+                                           -bf 2                        \
+                                           -trellis 1                   \
+                                           -mpv_flags +qp_rd+mv0        \
+                                           -intra_vlc 1                 \
+                                           -cmp 2 -subcmp 2             \
+                                           -mbd rd
