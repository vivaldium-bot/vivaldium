+static const char* stripLeadingWhitespace (const char* str)
+{
+	int whitespaceCount = 0;
+
+	while (str[whitespaceCount]	!= 0	&&
+		   (str[whitespaceCount] == ' '		||
+			str[whitespaceCount] == '\t'	||
+			str[whitespaceCount] == '\r'	||
+			str[whitespaceCount] == '\n'))
+		whitespaceCount += 1;
+
+	return str + whitespaceCount;
+}
