+										     const LookupPrecision&				prec,
+										     const float						coordX,
+											 const int							coordY,
+										     const Vec2&						fBounds,
+										     const Vec4&						result)
+{
+	if (levelFilter == Sampler::LINEAR)
+		return isLinearMipmapLinearSampleResultValid(level0, level1, sampler, prec, coordX, coordY, fBounds, result);
