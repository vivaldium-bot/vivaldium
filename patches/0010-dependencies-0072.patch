+TestInstance* IndirectDispatchCaseBufferGenerate::createInstance (Context& context) const
+{
+	return new IndirectDispatchInstanceBufferGenerate(context, m_name, m_bufferSize, m_workGroupSize, m_dispatchCommands);
+}
