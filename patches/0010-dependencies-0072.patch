+static std::string generateEmptyFragmentSource ()
+{
+	std::ostringstream src;
+
+	src <<	"#version 310 es\n"
+			"layout(location=0) out highp vec4 o_color;\n";
+
+	src << "void main (void)\n{\n";
+	src << "	o_color = vec4(0.0);\n";
+	src << "}\n";
+
+	return src.str();
+}
