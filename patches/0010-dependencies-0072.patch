+enum QueryFunction
+{
+	QUERYFUNCTION_TEXTURESIZE = 0,
+	QUERYFUNCTION_TEXTUREQUERYLOD,
+	QUERYFUNCTION_TEXTUREQUERYLEVELS,
+	QUERYFUNCTION_TEXTURESAMPLES,
+
+	QUERYFUNCTION_LAST
+};
