index 0000000000000000000000000000000000000000..772a123ab7a053a760848d704a26d606d32891b1
--- /dev/null
+++ b/third_party/webrtc/modules/audio_conference_mixer/source/memory_pool_win.h
@@ -0,0 +1,199 @@
+/*
