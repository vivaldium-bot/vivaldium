+  if (_outputFile.Open()) {
+      _outputFile.Flush();
+      _outputFile.CloseFile();
+  }
+  delete &_outputFile;
+  if (_inputFile.Open()) {
+      _inputFile.Flush();
+      _inputFile.CloseFile();
+  }
+  delete &_inputFile;
