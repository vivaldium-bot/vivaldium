diff --git a/third_party/swiftshader/third_party/LLVM/docs/HistoricalNotes/2000-11-18-EarlyDesignIdeas.txt b/third_party/swiftshader/third_party/LLVM/docs/HistoricalNotes/2000-11-18-EarlyDesignIdeas.txt
