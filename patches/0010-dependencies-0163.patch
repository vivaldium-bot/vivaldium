+
+  int16_t pitchCycles;
+  int16_t A;
+  int16_t B;
+  int16_t pitchIndex;
+  int16_t stretchLag;
+  int16_t *prevPitchLP;                                  // [ FRAMESAMPLES/2 ]; saved 240
+  int16_t seed;
+
