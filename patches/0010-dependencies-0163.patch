+  /// @brief Set every bit to 1.
+  void setAllBits() {
+    if (isSingleWord())
+      VAL = ~0ULL;
+    else {
+      // Set all the bits in all the words.
+      for (unsigned i = 0; i < getNumWords(); ++i)
+        pVal[i] = ~0ULL;
+    }
+    // Clear the unused ones
