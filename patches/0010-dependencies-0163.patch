+    void reset() override {
+        INHERITED::resetCommon();
+        fEnumClass = nullptr;
+        fMethod = nullptr;
+        fRoot = nullptr;
+        fTableState = TableState::kNone;
+        fHasFiddle = false;
+        fInDescription = false;
+        fInList = false;
