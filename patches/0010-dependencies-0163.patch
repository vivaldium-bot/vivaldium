+  void get_arrival_time(
+      int              current_framesamples,   /* samples */
+      int              packet_size,            /* bytes */
+      int              bottleneck,             /* excluding headers; bits/s */
+      BottleNeckModel* BN_data,
+      short            senderSampFreqHz,
+      short            receiverSampFreqHz);
