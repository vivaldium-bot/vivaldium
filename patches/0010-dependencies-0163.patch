+  void flipAllBits() {
+    if (isSingleWord())
+      VAL ^= ~0ULL;
+    else {
+      for (unsigned i = 0; i < getNumWords(); ++i)
+        pVal[i] ^= ~0ULL;
+    }
+    clearUnusedBits();
