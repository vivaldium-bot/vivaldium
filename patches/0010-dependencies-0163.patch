+static __inline int16_t  exp2_Q10_T(int16_t x) { // Both in and out in Q10
+
+  int16_t tmp16_1, tmp16_2;
+
+  tmp16_2=(int16_t)(0x0400|(x&0x03FF));
+  tmp16_1 = -(x >> 10);
+  if(tmp16_1>0)
+    return tmp16_2 >> tmp16_1;
+  else
+    return tmp16_2 << -tmp16_1;
+
+}
