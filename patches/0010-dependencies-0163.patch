+  /* ms */
+  int16_t    ExceedAgo;
+  /* packets left to send in current burst */
+  int16_t    BurstCounter;
+  /* packets */
+  int16_t    InitCounter;
+  /* ms remaining in buffer when next packet will be sent */
+  int16_t    StillBuffered;
