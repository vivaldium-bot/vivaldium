+
+namespace {
+
+// TODO: Share this class with ANGLE if/when it gets support for EGL_KHR_fence_sync.
+class EGLFenceSync : public sk_gpu_test::FenceSync {
+public:
+    static std::unique_ptr<EGLFenceSync> MakeIfSupported(EGLDisplay);
+
