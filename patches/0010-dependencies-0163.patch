+AudioDecoderOpus::AudioDecoderOpus(int num_channels) : channels_(num_channels) {
+  DCHECK(num_channels == 1 || num_channels == 2);
+  WebRtcOpus_DecoderCreate(&dec_state_, static_cast<int>(channels_));
