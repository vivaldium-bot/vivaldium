diff --git a/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter4/parser.ml b/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter4/parser.ml
