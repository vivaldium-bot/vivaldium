+                    focusXmax = Math.max(focusXmax, curve[idx]);
+                    focusYmin = Math.min(focusYmin, curve[idx + 1]);
+                    focusYmax = Math.max(focusYmax, curve[idx + 1]);
+                }
+            }
+            focusXmin -= Math.min(1, Math.max(focusXmax - focusXmin, focusYmax - focusYmin));
