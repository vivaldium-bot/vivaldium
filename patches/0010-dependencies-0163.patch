+DEF_TEST(SkSLMemoryLayout140Test, r) {
+    SkSL::Context context;
+    SkSL::MemoryLayout layout(SkSL::MemoryLayout::k140_Standard);
+
+    // basic types
+    REPORTER_ASSERT(r,  4 == layout.size(*context.fFloat_Type));
