+#define OPEN_FILE_WB(filePtr, fullPath)                         \
+  do                                                            \
+  {                                                             \
+    if(fullPath != NULL)                                        \
+    {                                                           \
+      filePtr = fopen(fullPath, "wb");                          \
+      if(filePtr == NULL)                                       \
+      {                                                         \
+        printf("could not open %s to write to.", fullPath);     \
