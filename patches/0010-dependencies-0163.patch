+
+    sk_sp<SkPicture> fPicture;
+    sk_gpu_test::GrContextFactory* fContextFactory;
+    sk_sp<SkSurface> fSurface;
+    bool fGPUEnabled;
+    bool fOverdraw;
+    int fColorMode;
+};
+
