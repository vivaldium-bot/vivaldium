diff --git a/third_party/skia/tools/gpu/vk/VkTestContext.cpp b/third_party/skia/tools/gpu/vk/VkTestContext.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e329583a0371ad41f26701e542eecf186a5b1500
--- /dev/null
