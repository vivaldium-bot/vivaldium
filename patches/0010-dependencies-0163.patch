+         "            x = 1.0;"
+         "    }"
+         "    sk_FragColor = float4(x);"
+         "}",
+         *SkSL::ShaderCapsFactory::Default(),
+         "#version 400\n"
+         "out vec4 sk_FragColor;\n"
+         "void main() {\n"
+         "    float x = 0.0;\n"
+         "    switch (0) {\n"
+         "        case 0:\n"
+         "            x = 0.0;\n"
+         "            if (0.0 < sqrt(1.0)) break;\n"
+         "        case 1:\n"
+         "            x = 1.0;\n"
+         "    }\n"
+         "    sk_FragColor = vec4(x);\n"
+         "}\n");
+}
