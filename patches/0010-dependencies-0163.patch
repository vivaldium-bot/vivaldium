+  float    PreStateHiF[ORDERHI+1];
+  float    PreStateHiG[ORDERHI+1];
+  float    PostStateLoF[ORDERLO+1];
+  float    PostStateLoG[ORDERLO+1];
+  float    PostStateHiF[ORDERHI+1];
+  float    PostStateHiG[ORDERHI+1];
+
+  double    OldEnergy;
+
