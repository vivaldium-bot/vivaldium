+AudioEncoderCopyRed::AudioEncoderCopyRed(const Config& config)
+    : speech_encoder_(config.speech_encoder),
+      red_payload_type_(config.payload_type) {
+  CHECK(speech_encoder_) << "Speech encoder not provided.";
+}
