+                                                SpeechType* speech_type) {
+  CriticalSectionScoped cs(encoder_lock_.get());
+  return encoder()->Decode(encoded, encoded_len, sample_rate_hz,
+                           max_decoded_bytes, decoded, speech_type);
+}
