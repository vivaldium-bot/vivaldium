-    var eventLogs = [];
-    for (var i = 0; i < targets.length; i++) {
-        targets[i].addEventListener('mousedown', function (event) {
-            eventLogs.push({current: this, target: event.target, offsetX: event.offsetX, offsetY: event.offsetY});
-        });
-    }
-    return eventLogs;
