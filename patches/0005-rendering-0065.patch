-  });
-}, 'writer.write(), ready and closed reject with the error passed to controller.error() made before sink.write'
-    + ' rejection');
-
-promise_test(() => {
-  const numberOfWrites = 1000;
-
-  let resolveFirstWritePromise;
-  let writeCount = 0;
