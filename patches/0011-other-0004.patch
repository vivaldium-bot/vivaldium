+#
+# Tests a few instructions that are always illegal in NaCl.
+#
+  .align 4
+  .globl __start
+__start:
+  .set mips32r2
+
+  eret               # Error, (forbidden) unsafe instruction.
+
+  li        $v0, 1   # System call code for print_int.
