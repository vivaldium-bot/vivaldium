+static bool HandleService(NaClCommandLoop* ncl, const vector<string>& args) {
+  UNREFERENCED_PARAMETER(args);
+  // TODO(robertm): move this library call into sel_universal
+  NaClSrpcServicePrint(ncl->getService());
