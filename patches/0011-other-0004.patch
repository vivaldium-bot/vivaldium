+def _add_if_bitexpr(value, set):
+  """Adds value to set if value is a BitExpr (or sub values if a list)."""
+  if value:
+    if isinstance(value, BitExpr):
+      set.add(value)
+    elif isinstance(value, list):
+      for v in value:
+        _add_if_bitexpr(v, set)
