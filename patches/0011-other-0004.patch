+  # Single-step and check IP corresponds to debugger_test:test_single_step
+  def CheckSingleStep(self, connection, step_command, thread_id):
+    if ARCH == 'x86-32':
+      instruction_sizes = [1, 2, 3, 6]
+    elif ARCH == 'x86-64':
