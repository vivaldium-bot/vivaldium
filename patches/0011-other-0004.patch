+
+  // Create a shared memory descriptor of arbitrary size and map it at
+  // an arbitrary address.
+  MapShmFd(&app, 0x200000, 0x100000);
+
+  // Check that we can deallocate the address space.
+  NaClAddrSpaceFree(&app);
+}
