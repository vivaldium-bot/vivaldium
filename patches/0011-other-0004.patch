+  char *base = (char *) nap->mem_start - NACL_ADDRSPACE_LOWER_GUARD_SIZE;
+  uintptr_t addrsp_size = (uintptr_t) 1U << nap->addr_bits;
+  size_t full_size = (NACL_ADDRSPACE_LOWER_GUARD_SIZE + addrsp_size +
+                      NACL_ADDRSPACE_UPPER_GUARD_SIZE);
