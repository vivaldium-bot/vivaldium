+  vst1.8 {d3-d6}, [sp], r12         /* Same deal. */
+
+bundle3:
+  vld1.8 {d3-d6}, [sp], r12         /* Attempt to update SP, */
+  bic sp, sp, #0xC0000000           /* with mask - should pass. */
+  vst1.8 {d3-d6}, [sp], r12         /* Same deal, */
+  bic sp, sp, #0xC0000000           /* with mask - should pass. */
