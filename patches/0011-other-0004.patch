diff --git a/native_client/src/trusted/service_runtime/sel_ldr_thread_interface.c b/native_client/src/trusted/service_runtime/sel_ldr_thread_interface.c
new file mode 100644
index 0000000000000000000000000000000000000000..4d2bad7cd777831fd540426057550b785861fe2f
--- /dev/null
+++ b/native_client/src/trusted/service_runtime/sel_ldr_thread_interface.c
@@ -0,0 +1,119 @@
+/*
