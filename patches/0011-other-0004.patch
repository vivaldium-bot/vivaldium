+static struct {
+  int         d;
+  char const  *env_name;
+  int         nacl_flags;
+  int         mode;
+} const g_nacl_redir_control[] = {
+  { 0, "NACL_EXE_STDIN",
+    NACL_ABI_O_RDONLY, 0, },
+  { 1, "NACL_EXE_STDOUT",
+    NACL_ABI_O_WRONLY | NACL_ABI_O_APPEND | NACL_ABI_O_CREAT, 0777, },
+  { 2, "NACL_EXE_STDERR",
