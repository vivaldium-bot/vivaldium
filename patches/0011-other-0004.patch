+static void FireDebugStubEvent(int pipe_fd) {
+  char buf = 0;
+  if (write(pipe_fd, &buf, sizeof(buf)) != sizeof(buf)) {
+    NaClLog(LOG_FATAL, "FireDebugStubEvent: Can't send debug stub event\n");
+  }
+}
