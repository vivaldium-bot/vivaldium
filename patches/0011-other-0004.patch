+    NACL_ABI__SC_NACL_FILE_ACCESS_ENABLED
+  NACL_ABI__SC_NACL_LIST_MAPPINGS_ENABLED,
+#define NACL_ABI__SC_NACL_LIST_MAPPINGS_ENABLED \
+    NACL_ABI__SC_NACL_LIST_MAPPINGS_ENABLED
+  NACL_ABI__SC_NACL_PNACL_MODE,
+#define NACL_ABI__SC_NACL_PNACL_MODE \
+    NACL_ABI__SC_NACL_PNACL_MODE
+};
