+# define NACL_ADDRSPACE_UPPER_GUARD_SIZE 0
+#elif NACL_BUILD_SUBARCH == 64
+# define NACL_MAX_ADDR_BITS  (32)
+# define NACL_THREAD_MAX     LDT_ENTRIES  /* can be larger */
