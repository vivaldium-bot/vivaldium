+      decoder_tests_obj,
+      EXTRA_LIBS=['decoder_test_tools', 'arm_validator_core', 'platform'])
+
+  decoder_test_node = gtest_env.CommandTest(
+      'arm32_decode_' + tbl + 'tests.out',
+      command=[decoder_tests_exe],
+      scale_timeout=1000)
+
+  gtest_env.AddNodeToTestSuite(decoder_test_node,
