+SafetyLevel %(decoder_name)s::
+safety(Instruction inst) const {
+  UNREFERENCED_PARAMETER(inst);  // To silence compiler.
+"""
+
+DECODER_SAFETY_DEF_CHECK="""
+  // %(neutral_rep)s
+  if (%(safety_test)s)
+    return %(safety_action)s;
+"""
+
+DECODER_SAFETY_DEF_FOOTER="""
+  return MAY_BE_SAFE;
+}
+
+"""
