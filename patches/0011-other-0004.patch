+  desc = malloc(sizeof(*desc));
+
+  if (!desc || !NaClDescSemaphoreCtor(desc, init_value)) {
+    retval = -NACL_ABI_ENOMEM;
+    goto cleanup;
+  }
+
+  retval = NaClAppSetDescAvail(nap, (struct NaClDesc *) desc);
+  desc = NULL;
+cleanup:
+  free(desc);
+  return retval;
+}
