+
+#ifndef NATIVE_CLIENT_SRC_TRUSTED_SERVICE_RUNTIME_NACL_VALGRIND_HOOKS_H__
+#define NATIVE_CLIENT_SRC_TRUSTED_SERVICE_RUNTIME_NACL_VALGRIND_HOOKS_H__ 1
