+
+  NaClLog(3,
+          ("Entered NaClSysFtruncate(0x%08"NACL_PRIxPTR", %d,"
+           " 0x%"NACL_PRIx32")\n"),
+          (uintptr_t) natp, d, lengthp);
+
+  ndp = NaClAppGetDesc(nap, d);
+  if (NULL == ndp) {
+    retval = -NACL_ABI_EBADF;
