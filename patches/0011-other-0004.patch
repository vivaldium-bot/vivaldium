new file mode 100644
index 0000000000000000000000000000000000000000..64d1aa08da529fef1a29af0ebe6cdca1c6609ed6
--- /dev/null
+++ b/native_client/src/trusted/service_runtime/sel_ldr_test.cc
@@ -0,0 +1,257 @@
