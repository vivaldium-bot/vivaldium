+void NaClBlockIfCommandChannelExists(struct NaClApp *nap) {
+  if (NULL != nap->secure_service) {
+    for (;;) {
+      struct nacl_abi_timespec req;
+      req.tv_sec = 1000;
+      req.tv_nsec = 0;
+      NaClNanosleep(&req, (struct nacl_abi_timespec *) NULL);
+    }
+  }
