+GLOBAL_SYM(movnti_code_post_rewrite_end)
+
+GLOBAL_SYM(movnti_code2)
+    mov %edx,%edx
+    movnti %r9d,(%r15,%rdx,1)
+GLOBAL_SYM(movnti_code2_end)
+
+GLOBAL_SYM(movnti_code2_post_rewrite)
