+  printf("  echo <args>*\n");
+  printf("    print rest of line - performs variable substitution\n");
+  printf("  quit\n");
+  printf("    quit the program\n");
+  printf("  help\n");
+  printf("    print this menu\n");
+  printf("  ?\n");
+  printf("    print this menu\n");
