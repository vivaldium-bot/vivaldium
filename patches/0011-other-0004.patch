+class AddOp(BitExpr):
+  """Models an additive operator."""
+
+  def __init__(self, op, arg1, arg2):
+    if op not in ['+', '-']:
+      raise Exception("Not add op: %s" % op)
+    self._op = op
+    self._args = [arg1, arg2]
+
+  def args(self):
+    return self._args[:]
+
