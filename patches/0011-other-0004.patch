+/*
+ * MIG generated message pump from /usr/include/mach/exc.defs
+ * Tweaked to place in an isolated namespace.
+ */
+boolean_t nacl_exc_server(
+    mach_msg_header_t *InHeadP,
+    mach_msg_header_t *OutHeadP);
