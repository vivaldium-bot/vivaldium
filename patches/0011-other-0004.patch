+
+static struct nacl_irt_random random_interface = { NULL };
+
+int nacl_secure_random_init(void) {
+  return 0;  /* Success */
+}
+
+static void random_init(void) {
+  nacl_interface_query(NACL_IRT_RANDOM_v0_1, &random_interface,
+                       sizeof(random_interface));
