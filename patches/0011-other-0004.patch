+#define NACL_ABI_E2BIG     7  /* Argument list too long */
+#define NACL_ABI_ENOEXEC   8  /* Exec format error */
+#define NACL_ABI_EBADF     9  /* Bad file number */
+#define NACL_ABI_ECHILD   10  /* No child processes */
