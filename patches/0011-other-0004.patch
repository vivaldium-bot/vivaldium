+
+#if NACL_WINDOWS
+enum NaClDebugExceptionHandlerState {
+  NACL_DEBUG_EXCEPTION_HANDLER_NOT_STARTED,
+  NACL_DEBUG_EXCEPTION_HANDLER_STARTED,
+  NACL_DEBUG_EXCEPTION_HANDLER_FAILED
