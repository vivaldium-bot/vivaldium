+  { 0x0D010B99, "vstr d0, [r1, #-0x99]: negative displacement vector store" },
+  { 0x0C810B10, "vstmia r1, { d0-d7 }: no writeback" },
+  { 0x0CA10B10, "vstmia r1!, { d0-d7 }: writeback" },
+};
