+  def __repr__(self):
+    return _IF_THEN_ELSE_DGEN_FORMAT % (
+        self._then_value, self._test, self._else_value)
+
+  def neutral_repr(self):
+    return _IF_THEN_ELSE_DGEN_FORMAT % (
+        neutral_repr(self._then_value),
+        neutral_repr(self._test),
+        neutral_repr(self._else_value))
