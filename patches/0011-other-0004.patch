+static const int kTestFillByte = 0x42;
+
+class MmapTest : public testing::Test {
+ protected:
+  virtual void SetUp();
+  virtual void TearDown();
+};
+
+void MmapTest::SetUp() {
+  NaClNrdAllModulesInit();
+}
+
+void MmapTest::TearDown() {
+  NaClNrdAllModulesFini();
