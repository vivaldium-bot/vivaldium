+static void PrintVmmap(struct NaClApp  *nap) {
+  printf("In PrintVmmap\n");
+  fflush(stdout);
+  NaClXMutexLock(&nap->mu);
+  NaClVmmapVisit(&nap->mem_map, VmentryPrinter, (void *) 0);
+
+  NaClXMutexUnlock(&nap->mu);
+}
