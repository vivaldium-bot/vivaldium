+ protected:
+  VideoProcessorIntegrationTestParameterized()
+      : bitrate_(::testing::get<0>(GetParam())),
+        codec_type_(::testing::get<1>(GetParam())),
+        hw_codec_(::testing::get<2>(GetParam())) {}
