+        {bitrate_, framerate, kNumFrames + 1}};
+
+    ProcessFramesAndMaybeVerify(rate_profiles, nullptr, nullptr, nullptr,
+                                &kVisualizationParams);
+  }
+
+  const int bitrate_;
+  const VideoCodecType codec_type_;
+  const bool hw_codec_;
+};
