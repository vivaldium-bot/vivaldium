+{
+enum {kDefaultWidth = 640};  // Start width
+enum {kDefaultHeight = 480}; // Start heigt
+enum {kDefaultFrameRate = 30}; // Start frame rate
+
+enum {kMaxFrameRate =60}; // Max allowed frame rate of the start image 
