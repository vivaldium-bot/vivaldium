+      "\n  Height            : 180"
+      "\n  Max frame rate    : 35"
+      "\n  QPmax             : 66"
+      "\n VP8 specific: "
+      "\n  Complexity        : 0"
+      "\n  Resilience        : 0"
+      "\n  # temporal layers : 2"
+      "\n  Denoising         : 0"
+      "\n  Error concealment : 1"
+      "\n  Automatic resize  : 1"
+      "\n  Frame dropping    : 0"
+      "\n  Key frame interval: 999\n",
+      config.ToString());
+}
