+    uint32_t* rtcp_arrival_time_secs,
+    uint32_t* rtcp_arrival_time_frac,
+    uint32_t* rtcp_timestamp) const {
+  return rtcp_receiver_.NTP(received_ntpsecs,
+                            received_ntpfrac,
+                            rtcp_arrival_time_secs,
+                            rtcp_arrival_time_frac,
+                            rtcp_timestamp)
+             ? 0
+             : -1;
+}
