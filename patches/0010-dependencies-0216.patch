+enum {
+  kRtcpExpectedVersion = 2,
+  kRtcpMinHeaderLength = 4,
+  kRtcpMinParseLength = 8,
+
+  kRtpExpectedVersion = 2,
+  kRtpMinParseLength = 12
+};
