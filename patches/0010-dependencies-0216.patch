+class RtpRtcpRtcpTest : public ::testing::Test {
+ protected:
+  RtpRtcpRtcpTest()
+      : fake_clock(123456), retransmission_rate_limiter_(&fake_clock, 1000) {
+    test_csrcs.push_back(1234);
+    test_csrcs.push_back(2345);
+    test_ssrc = 3456;
+    test_timestamp = 4567;
+    test_sequence_number = 2345;
