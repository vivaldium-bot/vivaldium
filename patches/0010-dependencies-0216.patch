+  ASSERT_EQ(1u, frames_from_callback_.size());
+  EXPECT_EQ(kVideoFrameKey, frames_from_callback_[kSeqNum]->frame_type());
+}
+
+}  // namespace video_coding
+}  // namespace webrtc
