+    constructor() { return [1, 2, 3]; }
+  }
+  var a = [5, 4];
+  a.__proto__ = MyArray.prototype;
+  var o = a.filter(() => true);
+  assertEquals([5, 4, 3], o);
+  assertEquals(3, o.length);
