+        Number.MAX_VALUE * 1e-13);
+  });
+
+  test('weightedMean', function() {
+    function getWeight(element) {
+      return element.weight;
+    }
+    function getValue(element) {
+      return element.value;
+    }
+
+    var data = [
+      {value: 10, weight: 3},
