+  },
+
+  initHelpButton_: function() {
+    var helpButtonEl = this.$.view_help_button;
+
+    var dlg = new tr.ui.b.Overlay();
+    dlg.title = 'Chrome Tracing Help';
+    dlg.visible = false;
+    dlg.appendChild(
+        document.createElement('tr-ui-timeline-view-help-overlay'));
+
+    function onClick(e) {
+      dlg.visible = !dlg.visible;
