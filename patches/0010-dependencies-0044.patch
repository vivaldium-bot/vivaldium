+        // Enforce same width of '+++' and '---'.
+        prefixEl.style.fontFamily = 'monospace';
+        Polymer.dom(titleEl).appendChild(prefixEl);
+        Polymer.dom(titleEl).appendChild(
+            tr.ui.b.asHTMLOrTextNode(NO_BREAK_SPACE));
+      }
+      if (color !== undefined)
+        titleEl.style.color = color;
+      Polymer.dom(titleEl).appendChild(
