+    var c = b.clone();
+    assert.isTrue(b.equals(c));
+    assert.isTrue(b.almostEquals(c));
+
+    c.set(a);
+    assert.isTrue(a.equals(c));
+    assert.isTrue(a.almostEquals(c));
+  });
+});
