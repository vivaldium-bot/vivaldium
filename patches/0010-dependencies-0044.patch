+#: src/size.c:60
+msgid ""
+"Use the output format FORMAT.  FORMAT can be `bsd' or `sysv'.  The default "
+"is `bsd'"
+msgstr ""
+"Używa FORMATU wyjścia. Może to być \"bsd\" lub \"sysv\". Domyślny jest \"bsd"
+"\""
+
+#: src/size.c:62
+msgid "Same as `--format=sysv'"
+msgstr "To samo, co \"--format=sysv\""
+
+#: src/size.c:63
