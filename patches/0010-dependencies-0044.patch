diff --git a/third_party/elfutils/src/tests/testfile_entry_value.c b/third_party/elfutils/src/tests/testfile_entry_value.c
new file mode 100644
index 0000000000000000000000000000000000000000..d2f232b22793bd9cecc2a0676b2e5d22363b0f2b
--- /dev/null
+++ b/third_party/elfutils/src/tests/testfile_entry_value.c
@@ -0,0 +1,19 @@
+// gcc -g -O2 -o entry_value entry_value.c
+int __attribute__((noinline, noclone)) foo (int x, int y)
+{
+  return x + y;
+}
+
+int __attribute__((noinline, noclone)) bar (int x, int y)
+{
+  int z;
+  z = foo (x, y);
+  z += foo (y, x);
+  return z;
+}
+
+int
+main (int argc, char **argv)
+{
+  return bar (argc + 1, argc - 1);
+}
