+tr.b.unittest.testSuite(function() {
+  var newSliceEx = tr.c.TestUtils.newSliceEx;
+
+  function createModel() {
+    var m = tr.c.TestUtils.newModel(function(m) {
+      m.p1 = m.getOrCreateProcess(1);
+      m.t2 = m.p1.getOrCreateThread(2);
