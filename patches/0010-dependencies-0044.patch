+
+static void
+new_dynamic_entry (Elf_Data *data, int idx, XElf_Sxword tag, XElf_Addr val)
+{
+  XElf_Dyn_vardef (dyn);
+  xelf_getdyn_ptr (data, idx, dyn);
+  dyn->d_tag = tag;
+  dyn->d_un.d_ptr = val;
+  (void) xelf_update_dyn (data, idx, dyn);
+}
