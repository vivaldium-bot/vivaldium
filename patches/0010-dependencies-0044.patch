diff --git a/third_party/catapult/tracing/tracing/extras/chrome/layout_object.html b/third_party/catapult/tracing/tracing/extras/chrome/layout_object.html
new file mode 100644
index 0000000000000000000000000000000000000000..1403ff1eec38d57e19c929ff60c59bfa360e9404
