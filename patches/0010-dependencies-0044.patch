+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var Viewport = tr.ui.TimelineViewport;
+  var GlobalMemoryDumpTrack = tr.ui.tracks.GlobalMemoryDumpTrack;
+  var createTestGlobalMemoryDumps = tr.ui.tracks.createTestGlobalMemoryDumps;
