+
+    track.height = '100px';
+  });
+
+  test('instantiate_highDetailsNoStepGraphWithSelectionAndYAxisLabels',
+      function() {
+        var div = document.createElement('div');
+        var viewport = new Viewport(div);
+        viewport.highDetails = true;
