+
+    samples = Statistics.normalizeSamples(samples).normalized_samples;
+    d = Statistics.discrepancy(samples);
+    assert.equal(d, 0.25);
+  });
+
+  test('timestampsDiscrepancy', function() {
+    var timestamps = [];
+    var dAbs = Statistics.timestampsDiscrepancy(timestamps, true);
