+    }
+    #comment-img {
+      width: 32px;
+      height: 32px;
+    }
+    #comment-text-author {
+      padding-bottom: 2px;
+    }
+    #comment-date {
+      color: #777;
+      font-size: 11px;
+    }
+    #comment-content {
+      word-wrap: break-word;
+    }
+    </style>
+    <div id="comment-area">
