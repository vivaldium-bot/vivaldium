+                {
+                  CompileFullCode: [3, 345],
+                  LoadIC_Miss: [5, 567],
+                  ParseLazy: [8, 890]
+                }}}));
+      m.s2 = m.t2.sliceGroup.pushSlice(
+          newSliceEx(
+              {title: 'V8.Execute',
