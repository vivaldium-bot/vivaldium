+
+  test('instantiate_multipleProcessMemoryDumps', function() {
+    var processMemoryDumps = convertToProcessMemoryDumps(
+        tr.ui.analysis.createMultipleTestProcessMemoryDumps());
+    createAndCheckMemoryDumpOverviewPane(this,
+        processMemoryDumps,
+        [  // Table rows.
+          {
