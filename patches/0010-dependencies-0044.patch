+    assert.deepEqual(tr.b.asArray(fc.inFlowEvents), [a]);
+    assert.deepEqual(tr.b.asArray(fc.outFlowEvents), [d]);
+    assert.deepEqual(tr.b.asArray(fc.internalFlowEvents), [b, c]);
+  });
