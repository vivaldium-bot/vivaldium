+          quads.push(quad);
+        }
+      }
+      return quads;
+    },
+
+    generateLayerQuads: function() {
+      this.updateContentsPending_ = false;
+
+      // Generate the quads for the view.
+      var layers = this.layers;
+      var quads = [];
+      var nextStackingGroupId = 0;
