+      return INTUSE(elf32_offscn) (elf, (Elf32_Off) offset);
+    }
+
+  return INTUSE(elf64_offscn) (elf, offset);
+}
diff --git a/third_party/elfutils/src/libelf/gelf_update_auxv.c b/third_party/elfutils/src/libelf/gelf_update_auxv.c
