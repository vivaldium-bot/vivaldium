+
+// Return number of src bytes skipped
+static int DoSpecialFixup(const unsigned char c,
+                    const unsigned char** srcp, const unsigned char* srclimit,
+                    unsigned char** dstp, unsigned char* dstlimit) {
+  return 0;
+}
