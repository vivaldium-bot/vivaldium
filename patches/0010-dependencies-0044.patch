+/* Check whether file associated with FD is a DSO.  */
+static bool
+is_dso_p (int fd)
+{
+  /* We have to read the 'e_type' field.  It has the same size (16
+     bits) in 32- and 64-bit ELF.  */
+  XElf_Half e_type;
+
+  return (pread (fd, &e_type, sizeof (e_type), offsetof (XElf_Ehdr, e_type))
+	  == sizeof (e_type)
+	  && e_type == ET_DYN);
+}
