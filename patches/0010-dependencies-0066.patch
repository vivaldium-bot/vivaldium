+	const VkDeviceSize					m_pixelDataSize;
+
+	Move<VkImage>						m_colorImage;
+	de::MovePtr<Allocation>				m_colorImageAlloc;
+	Move<VkImageView>					m_colorAttachmentView;
+	Move<VkRenderPass>					m_renderPass;
