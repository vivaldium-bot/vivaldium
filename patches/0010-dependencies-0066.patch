+class keywords(dict):
+    """Keyword args (**kwargs) support for generative tests."""
+
+class starargs(tuple):
+    """Variable arguments (*args) for generative tests."""
+    def __new__(cls, *args):
+        return tuple.__new__(cls, args)
+
+unittest_main = unittest.main
