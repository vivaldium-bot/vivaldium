+
+namespace
+{
+
+// Command line arguments.
+namespace opt
+{
+
+DE_DECLARE_COMMAND_LINE_OPT(StartServer,	string);
+DE_DECLARE_COMMAND_LINE_OPT(Host,			string);
+DE_DECLARE_COMMAND_LINE_OPT(Port,			int);
