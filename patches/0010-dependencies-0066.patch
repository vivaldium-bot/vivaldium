+                    # super should not be used on an old style class
+                    self.add_message('super-on-old-class', node=node,
+                                     confidence=confidence)
+                else:
+                    # super first arg should be the class
+                    if not call.args and sys.version_info[0] == 3:
+                        # unless Python 3
+                        continue
