+
+	static const struct
+	{
+		const char*	name;
+		const char*	description;
+		deUint32	flags;
+	} s_texelBufferTypes[] =
+	{
+		{ "offset_zero",		"View offset is zero",		0u											},
+		{ "offset_nonzero",		"View offset is non-zero",	TexelBufferDescriptorCase::FLAG_VIEW_OFFSET	},
+	};
+
+	for (int ndx = 0; ndx < DE_LENGTH_OF_ARRAY(s_texelBufferTypes); ++ndx)
