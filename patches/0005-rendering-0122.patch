-            // another completion callback might generate more results.  So, we
-            // don't dump the results immediately.
-            setTimeout(done, 0);
-        } else {
-            // Parsing the test HTML isn't finished yet.
-            window.addEventListener('load', done);
-        }
-    });
-
-})();
