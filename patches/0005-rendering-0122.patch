-      node.removeChild(child);
-      i--;
-    } else if (child.nodeType === Node.ELEMENT_NODE || child.nodeType === Node.DOCUMENT_FRAGMENT_NODE) {
-      removeWhiteSpaceOnlyTextNodes(child);
-    }
-  }
-  if (node.shadowRoot) {
-    removeWhiteSpaceOnlyTextNodes(node.shadowRoot);
-  }
-}
