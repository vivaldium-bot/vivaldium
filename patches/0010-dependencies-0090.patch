--- /dev/null
+++ b/third_party/freetype/src/src/cache/ftcache.c
@@ -0,0 +1,32 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ftcache.c                                                              */
+/*                                                                         */
+/*    The FreeType Caching sub-system (body only).                         */
+/*                                                                         */
+/*  Copyright 2000-2017 by                                                 */
+/*  David Turner, Robert Wilhelm, and Werner Lemberg.                      */
