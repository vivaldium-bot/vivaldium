+Builder::Builder(unsigned int magicNumber, SpvBuildLogger* buildLogger) :
+    source(SourceLanguageUnknown),
+    sourceVersion(0),
+    addressModel(AddressingModelLogical),
+    memoryModel(MemoryModelGLSL450),
