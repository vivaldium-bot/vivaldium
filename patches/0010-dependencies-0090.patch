+    symbolTable.relateToOperator("ddx",                         EOpDPdx);
+    symbolTable.relateToOperator("ddx_coarse",                  EOpDPdxCoarse);
+    symbolTable.relateToOperator("ddx_fine",                    EOpDPdxFine);
