diff --git a/third_party/gestures/gestures/include/box_filter_interpreter.h b/third_party/gestures/gestures/include/box_filter_interpreter.h
new file mode 100644
index 0000000000000000000000000000000000000000..f78a42da905e8c987d0c863ac700e93963f7caa6
--- /dev/null
