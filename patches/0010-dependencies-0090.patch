+
+/***************************************************************************/
+/*                                                                         */
+/*  aflatin2.c                                                             */
+/*                                                                         */
+/*    Auto-fitter hinting routines for latin writing system (body).        */
+/*                                                                         */
+/*  Copyright 2003-2017 by                                                 */
