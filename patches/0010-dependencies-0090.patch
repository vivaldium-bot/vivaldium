+DEPDIR = .deps
+
+DESTDIR = .
+
+CXXFLAGS+=\
+	-g \
+	-std=gnu++11 \
+	-fno-exceptions \
+	-fno-strict-aliasing \
+	-fPIC \
+	-Wall \
+	-Wclobbered \
+	-Wempty-body \
+	-Werror \
+	-Wignored-qualifiers \
+	-Wmissing-field-initializers \
+	-Wmissing-format-attribute \
+	-Wmissing-noreturn \
+	-Wsign-compare \
+	-Wtype-limits \
+	-D__STDC_FORMAT_MACROS=1 \
+	-D_FILE_OFFSET_BITS=64 \
+	-DGESTURES_INTERNAL=1 \
+	-I..
+
+LID_TOUCHPAD_HELPER=lid_touchpad_helper
+
+# Local compilation needs these flags, esp for code coverage testing
+ifeq (g++,$(CXX))
+CXXFLAGS+=\
+	-O1 \
+	-DVCSID="\"1234 TESTVERSION\"" \
+	--coverage \
+	-ftest-coverage \
+	-fprofile-arcs
+LINK_FLAGS+=-lgcov
+else
+CXXFLAGS+=\
