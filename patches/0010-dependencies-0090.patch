+PKG_CONFIG ?= pkg-config
+PC_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PC_DEPS))
+PC_LIBS := $(shell $(PKG_CONFIG) --libs $(PC_DEPS))
+
+CXXFLAGS += $(PC_CFLAGS) -I$(SYSROOT)/usr/include/jsoncpp
+LINK_FLAGS += $(PC_LIBS) -ljsoncpp
+
+LINK_FLAGS+=\
+	-lpthread \
+	-lrt
+
+TEST_LINK_FLAGS=\
+	-lgcov \
+	-lglib-2.0 \
+	-lgtest
