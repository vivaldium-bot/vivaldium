+  int interpret_call_count_;
+  int handle_timer_call_count_;
+  BoolProperty bool_prop_;
+  DoubleProperty double_prop_;
+  IntProperty int_prop_;
+  ShortProperty short_prop_;
+  StringProperty string_prop_;
