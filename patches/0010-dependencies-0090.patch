+    0,  // t5r2
+    0,  // semi-mt
+    1,  // is button pad
+    0  // has_wheel
+  };
+  TestInterpreterWrapper wrapper(&pci, &hwprops);
+
+  const float kBig = pci.palm_pressure_.val_ + 1;  // big (palm) pressure
+  const float kSml = pci.palm_pressure_.val_ - 1;  // low pressure
+
+  FingerState finger_states[] = {
