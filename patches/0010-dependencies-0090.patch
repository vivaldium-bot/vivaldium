+  ASSERT_EQ(8, k8);
+  ASSERT_EQ(41, k41);
+  ASSERT_EQ(107, k107);
+  ASSERT_EQ(16, k16);
+  ASSERT_EQ(49, k49);
+  ASSERT_EQ(115, k115);
+
+  ThumbClickWiggleWithPalmTestInputs inputs[] = {
+    { 4.5231, 0, 52.0, 59.8, 118.20, k16,   0.0,  0.0,  0.00,    0 },
+    { 4.5325, 0, 52.0, 59.9, 118.20, k16,   0.0,  0.0,  0.00,    0 },
