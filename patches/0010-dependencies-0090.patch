+{
+	mediump int u;
+	S s[2][3];
+	mediump vec2 v;
+} inst430;
+
+S s;
+
+// should get 5 SPV types for T: no layout, 140/row, 140/col, 430/row, and 430/col
+struct T {
+    mat2 m;
+    int a;
+};
+
+T t;
+
+struct Nestor {
+    T nestorT;
+};
+
+layout(set = 1, binding = 0, std140) uniform Bt1
