+    CASERET(GESTURES_FINGER_TREND_INC_TOUCH_MAJOR);
+    CASERET(GESTURES_FINGER_TREND_DEC_TOUCH_MAJOR);
+    CASERET(GESTURES_FINGER_INSTANTANEOUS_MOVING);
