+LINK_LIBRARY   = $(foreach m,$(OBJECTS_LIST),$(AR) -r $@ $(m);) echo > nul
+
+
+# EOF
diff --git a/third_party/freetype/src/builds/compiler/gcc-dev.mk b/third_party/freetype/src/builds/compiler/gcc-dev.mk
