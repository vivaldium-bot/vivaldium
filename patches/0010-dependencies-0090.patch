+MISC_OBJECTS=\
+	$(OBJDIR)/activity_replay.o \
+
+TEST_MAIN=\
+	$(OBJDIR)/test_main.o
+
+TEST_EXE=test
+SONAME=$(OBJDIR)/libgestures.so.0
+
+ALL_OBJECTS=\
+	$(TEST_OBJECTS) \
+	$(TEST_MAIN) \
+	$(SO_OBJECTS) \
+	$(MISC_OBJECTS)
+
+ALL_OBJECT_FILES=\
+	$(SO_OBJECTS) \
+	$(MISC_OBJECTS) \
+	$(TEST_OBJECTS) \
+	$(TEST_MAIN)
