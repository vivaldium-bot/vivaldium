+struct DistFromPointToLineRec {
+  // line is (x0, y0) to (x1, y1). Point is (px, py). Expected dist is dist.
+  float x0, y0, x1, y1, px, py, dist;
+};
+
+bool WeakFloatEq(float f_a, float f_b) {
+  return fabsf(f_a - f_b) < 0.001;
+}
+}  // namespace
