+        return VerificationModeFactory.calls( wantedNumberOfInvocations );
+    }
+
+    /**
+     * Allows checking if given method was the only one invoked. E.g:
+     * <pre class="code"><code class="java">
+     *   verify(mock, only()).someMethod();
