+    public static class ArrayDelimiters {
+        private String before;
+        private String inside;
+        private String after;
+            
+        public ArrayDelimiters(String before, String inside, String after) {
+            this.before = before;
+            this.inside = inside;
+            this.after = after;
+        }
+    }
