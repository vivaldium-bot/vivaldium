+     *  list.add(0);
+     *  System.out.println(list.get(0)); //we don't want to verify this
+     *  list.clear();
+     *
+     *  InOrder inOrder = inOrder(ignoreStubs(list));
+     *  inOrder.verify(list).add(0);
+     *  inOrder.verify(list).clear();
