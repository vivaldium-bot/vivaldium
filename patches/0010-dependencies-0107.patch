+    /** Internal interface, only public due to ClassLoader issues. */
+    public interface EnhancerKey {
+        public Object newInstance(String type,
+                                  String[] interfaces,
+                                  CallbackFilter filter,
+                                  Type[] callbackTypes,
+                                  boolean useFactory,
+                                  boolean interceptDuringConstruction,
+                                  Long serialVersionUID);
+    }
