diff --git a/third_party/mockito/src/cglib-and-asm/src/org/mockito/cglib/reflect/ConstructorDelegate.java b/third_party/mockito/src/cglib-and-asm/src/org/mockito/cglib/reflect/ConstructorDelegate.java
