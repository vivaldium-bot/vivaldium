diff --git a/third_party/mockito/src/src/org/mockito/internal/configuration/SpyAnnotationEngine.java b/third_party/mockito/src/src/org/mockito/internal/configuration/SpyAnnotationEngine.java
new file mode 100644
index 0000000000000000000000000000000000000000..de1a1957dcd9e6d779bbc1e2d2119eb89540d761
