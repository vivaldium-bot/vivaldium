-    <style>
-      div.flexbox {
-        height: 200px;
-        background: lightgreen;
-        display: flex;
-        justify-content: space-between;
-        flex-direction: column;
-        float: left;
-        margin-right: 10px;
-        font: 8px monospace;
-      }
-      fieldset {
-        width: 20px;
-        height: 10px;
-        min-height: 0;
-        border: 1px dotted green;
-        margin: 0;
-        padding: 0;
-      }
