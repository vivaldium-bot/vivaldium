-var tests = [];
-setup(function() {
-        var name_inputs = ["abc", "Abc", "ABC", "ä", "Ä"];
-        var namespaces = ["http://www.w3.org/1999/xhtml", "http://www.w3.org/2000/svg", "http://FOO"];
-        name_inputs.forEach(function(x) {
-                              tests.push(["createElement " + x, test_create_element, [x]]);
