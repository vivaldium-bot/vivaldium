-function getEnumerableOwnProps1(obj) {
-  var arr = [];
-  for (var prop in obj) {
-    if (obj.hasOwnProperty(prop)) {
-      arr.push(prop);
-    }
-  }
-  return arr;
-}
-
-function getEnumerableOwnProps2(obj) {
-  return Object.getOwnPropertyNames(obj).filter(
-    (name) => Object.getOwnPropertyDescriptor(obj, name).enumerable)
-}
-
