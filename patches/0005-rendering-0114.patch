-    if (TestNavigator._setCurrentTest(links[0])) {
-        TestNavigator._scrollToCurrentTest();
-    }
-};
-
-TestNavigator._scrollToLastTest = function() {
-    var links = visibleTests();
-    if (links.length == 0) {
-        return;
