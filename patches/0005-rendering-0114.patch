-  e %= 360;
-  if (e < 0) {
-    s += e;
-    e = -e;
-  }
-  s %= 360;
-  if (s < 0)
-    s += 360;
-  var is = Math.floor(s/359 * p.length/2);
-  var ie = Math.floor(e/359 * p.length/2)+1;
-  p = p.slice(is*2).concat(p.slice(0, is*2)).slice(0, ie*2);
