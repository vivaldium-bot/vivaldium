-    </div>
-    <!--  ...and now with a smaller explicit 'flex-basis' value (which shouldn't
-         be considered for 'min-width:auto' anyway)  -->
-    <div class="flexbox">
-      <div style="flex-basis: 10px"><div></div></div>
-    </div>
-  </body>
-</html>
