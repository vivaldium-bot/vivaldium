-    var image = new Image();
-    image.src = url;
-    image.style.display = 'none';
-
-    var canvas = document.createElement('canvas');
-
-    imageContainer.appendChild(image);
-    imageContainer.appendChild(canvas);
-    container.appendChild(imageContainer);
-
-    return container;
