+TEST_F(SendTimeHistoryTest, HistorySizeWithWraparound) {
+  const uint16_t kMaxSeqNo = std::numeric_limits<uint16_t>::max();
+  AddPacketWithSendTime(kMaxSeqNo - 2, 0, 0, PacketInfo::kNotAProbe);
