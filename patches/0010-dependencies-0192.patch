+  nada_sender_.set_bitrate_kbps(original_bitrate);
+  nada_sender_.GradualRateUpdate(not_congested_fb, kDeltaSMs, smoothing_factor);
+  EXPECT_GT(nada_sender_.bitrate_kbps(), original_bitrate);
+}
