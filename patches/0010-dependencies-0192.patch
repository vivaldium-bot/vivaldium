+	if(b[2][1] != 128.0) elms = false;
+	if(b[2][2] != 256.0) elms = false;
+
+	// Add up each row of the copy.
+	bool rows = true;
+	x = b[0][0] + b[1][0] + b[2][0];
+	if( x < 73.0-ERROR_EPSILON || x > 73.0+ERROR_EPSILON ) rows = false;
