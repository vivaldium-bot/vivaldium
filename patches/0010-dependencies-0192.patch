+bool IsTimeSorted(const Packets& packets) {
+  PacketsConstIt last_it = packets.begin();
+  for (PacketsConstIt it = last_it; it != packets.end(); ++it) {
+    if (it != last_it && **it < **last_it) {
+      return false;
+    }
+    last_it = it;
+  }
+  return true;
+}
