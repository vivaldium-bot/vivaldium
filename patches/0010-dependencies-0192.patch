+    controller_->SetMinMaxBitrate(kMinBitrateBps, kMaxBitrateBps);
+    EXPECT_EQ(kStartBitrateBps, bitrate_observer_.last_bitrate_);
+    bandwidth_observer_ = controller_->CreateRtcpBandwidthObserver();
+  }
