diff --git a/third_party/webrtc/modules/desktop_capture/win/dxgi_adapter_duplicator.cc b/third_party/webrtc/modules/desktop_capture/win/dxgi_adapter_duplicator.cc
new file mode 100644
index 0000000000000000000000000000000000000000..abe7908afe5673826b1ff80c3466dbd971066b4f
--- /dev/null
