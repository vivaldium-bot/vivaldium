+  // Mean is 2 ; ((1-2)*(1-2)+(3-2)*(3-2))/2 = (1+1)/2 = 1
+  stats.Push(1);
+  stats.Push(3);
+  EXPECT_EQ(1, stats.GetVariance());
+
+  // Integer division rounds 26/3 to 8
+  // Mean is 0 ; (1*1+3*3+(-4)*(-4))/3 = (1+9+16)/3 = 8
+  stats.Push(-4);
+  EXPECT_EQ(8, stats.GetVariance());
