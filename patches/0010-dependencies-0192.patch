+           DesktopRect::MakeXYWH(20, 30, 30, 10),
+           DesktopRect::MakeXYWH(20, 50, 30, 10) } },
+  };
+
+  for (size_t i = 0; i < (sizeof(cases) / sizeof(Case)); ++i) {
+    SCOPED_TRACE(i);
