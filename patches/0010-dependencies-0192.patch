+	x = b[0][2] + b[1][2] + b[2][2];
+	if(x < 18.0-ERROR_EPSILON || x > 18.0+ERROR_EPSILON ) rows = false;
+
+	// Add up each column of the copy.
+	bool cols = true;
+	x = b[0][0] + b[0][1] + b[0][2];
+	if( x < 6.0-ERROR_EPSILON || x > 6.0+ERROR_EPSILON ) cols = false;
