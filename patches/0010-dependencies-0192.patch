+	// Copy the matrix to another non-const matrix.
+	mat3 b = a;
+
+	// Check each element of the copy.
+	bool elms = true;
+	if(b[0][0] != 1.0) elms = false;
+	if(b[0][1] != 2.0) elms = false;
