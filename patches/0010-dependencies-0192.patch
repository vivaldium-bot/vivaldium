+  RunBitexactnessTest(48000, 1, 0,
+                      EchoControlMobile::RoutingMode::kLoudSpeakerphone, true,
+                      kOutputReference);
+}
+
+TEST(EchoControlMobileBitExactnessTest,
+     DISABLED_Mono16kHz_LoudSpeakerPhone_CngOff_StreamDelay0) {
