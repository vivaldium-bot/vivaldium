-  var n4 = p.length;
-  for (var i = n4-4; i >= 0; i -= 2)
-    p.push(-p[i], p[i+1]);
-  // quadrants III and IV, anticlockwise
-  var n2 = p.length;
-  for (i = n2-4; i > 0; i -= 2)
-    p.push(p[i], -p[i+1]);
