-function shouldBe(a, b)
-{
-    var evalA, evalB;
-    try {
-        evalA = eval(a);
-        evalB = eval(b);
-    } catch(e) {
-        evalA = e;
-    }
-
-    var message = (evalA === evalB)
-                    ? "PASS: " + a + " should be '" + evalB + "' and is."
-                    : "*** FAIL: " + a + " should be '" + evalB + "' but instead is " + evalA + ". ***";
-    log(message);
-}
-
-function shouldBeTrue(a) 
-{ 
-    shouldBe(a, "true"); 
-}
-
-function shouldBeFalse(b) 
-{ 
-    shouldBe(b, "false"); 
-}
