-{
-    var valuePath = "window.marker";
-
-    try {
-        eval("window." + keyPath + " = " + valuePath);
-        return eval("window." + keyPath) === eval("window." + valuePath);
-    } catch(e) {
-        return false;
-    }
-}
-
-function canSetWithTypeConversion(keyPath)
-{
-    var valuePath = "window.marker";
-
-    try {
-        eval("window." + keyPath + " = " + valuePath);
