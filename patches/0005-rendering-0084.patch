-    if (d1 < 0) {
-      d1 += b2*(2*x+3);
-    } else {
-      d1 += b2*(2*x+3) + a2*(-2*y + 2);
-      y -= 1;
-    }
-    x += 1;
-    p.unshift(x,-y);
-  }
-  var d2 = b2*(x+1/2)*(x+1/2) + a2*(y-1)*(y-1) - a2*b2;
-  while (y > 0) {
-    if (d2 < 0) {
-      d2 += b2*(2*x+2) + a2*(-2*y+3);
-      x += 1;
-    } else {
-      d2 += a2*(-2*y+3);
