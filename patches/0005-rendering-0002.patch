+PassRefPtrWillBeRawPtr<AnimatableValue> unknownAnimatableValue(double n)
+{
+    return AnimatableUnknown::create(CSSPrimitiveValue::create(n, CSSPrimitiveValue::CSS_UNKNOWN).get());
+}
