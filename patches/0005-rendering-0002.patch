+{
+    Color transparent = AnimatableColorImpl(Color::transparent).toColor();
+    EXPECT_EQ(transparent.rgb(), Color::transparent);
+    Color red = AnimatableColorImpl(Color(0xFFFF0000)).toColor();
+    EXPECT_EQ(red.rgb(), 0xFFFF0000);
