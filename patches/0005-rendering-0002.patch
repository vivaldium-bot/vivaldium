+    jsKeyframes.append(Dictionary(keyframe1, m_isolate, exceptionState));
+    jsKeyframes.append(Dictionary(keyframe2, m_isolate, exceptionState));
+    jsKeyframes.append(Dictionary(keyframe3, m_isolate, exceptionState));
