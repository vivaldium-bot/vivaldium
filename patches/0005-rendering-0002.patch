+    TEST_PRIMITIVE_VALUE(value, 10, CSSPrimitiveValue::CSS_PX);
+
+    value = roundTrip(CSSPrimitiveValue::create(30, CSSPrimitiveValue::CSS_PERCENTAGE));
+    TEST_PRIMITIVE_VALUE(value, 30, CSSPrimitiveValue::CSS_PERCENTAGE);
