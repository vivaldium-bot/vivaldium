-    {at: 0.5, is: '-webkit-cross-fade(' + fromComputed + ', ' + options.to + ', 0.5)'},
-    {at: 0.6, is: '-webkit-cross-fade(' + fromComputed + ', ' + options.to + ', 0.6)'},
-    {at: 1, is: options.to},
-    {at: 1.5, is: options.to},
-  ]);
-}
