+bool AnimatableDoubleAndBool::equalTo(const AnimatableValue* value) const
+{
+    const AnimatableDoubleAndBool* other = toAnimatableDoubleAndBool(value);
+    return toDouble() == other->toDouble() && flag() == other->flag();
+}
