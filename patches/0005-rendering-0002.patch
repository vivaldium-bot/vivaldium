+    static PassRefPtrWillBeRawPtr<AnimatableSVGPaint> create(
+        SVGPaintType type, SVGPaintType visitedLinkType,
+        const Color& color, const Color& visitedLinkColor,
+        const String& uri, const String& visitedLinkURI)
