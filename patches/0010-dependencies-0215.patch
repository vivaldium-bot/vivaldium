+				"in mediump vec4 v_coords;\n" +
+				"layout(location = 0) out mediump vec4 o_color;";
+			spParams["COORDS"]			= "v_coords";
+			spParams["DST"]				= "o_color";
+			spParams["ASSIGN_POS"]		= "";
