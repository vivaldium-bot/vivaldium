new file mode 100644
index 0000000000000000000000000000000000000000..b45c67d657244c17592545b9e637b6125140a6ad
--- /dev/null
+++ b/third_party/webrtc/pc/test/mockpeerconnectionobservers.h
@@ -0,0 +1,447 @@
+/*
