+  AsyncSocket* CreateAsyncSocket(int type) override {
+    SocketDispatcher* dispatcher = new FakeSocketDispatcher(this);
+    if (!dispatcher->Create(type)) {
+      delete dispatcher;
+      return nullptr;
+    }
+    return dispatcher;
+  }
