+        '#version 300 es\n' +
+        'layout(location = 0) out mediump vec4 fragColor;' +
+        'void main (void)\n' +
+        '{\n' +
+        ' fragColor = vec4(0.0);\n' +
+        '}\n';
+
+    var shaderVert = gl.createShader(gl.VERTEX_SHADER);
+    var shaderFrag = gl.createShader(gl.FRAGMENT_SHADER);
