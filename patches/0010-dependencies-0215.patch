+    es3fShaderMatrixTest.reduceVecToVec3 = function (value) {
+        if (value.length == 3) {
+            return value;
+        } else if (value.length == 2) {
+            return deMath.swizzle(value, [0, 1, 0])
+        } else {
+            return [value[0], value[1], value[2] + value[3]];
+        }
+    };
