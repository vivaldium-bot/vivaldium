+  ChannelBuffer<float> chb(kNumFrames, kStereo);
+  EXPECT_EQ(chb.num_channels(), kStereo);
+  chb.set_num_channels(kMono);
+  EXPECT_EQ(chb.num_channels(), kMono);
+}
