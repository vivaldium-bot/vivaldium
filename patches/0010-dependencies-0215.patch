+                    break;
+                }
+                default: {
+                    data[componentNdx] = this.m_random.getInt(buffer.intRangeMin, buffer.intRangeMax);
+                }
+            }
+        }
+
+        offset += stride;
+    }
+
+    return new typedArray(raw);
+};
