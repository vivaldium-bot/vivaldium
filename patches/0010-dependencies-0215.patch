+static const uint32_t kVideoSsrc2 = 100;
+static const uint32_t kAudioSsrc = 99;
+static const uint32_t kAudioSsrc2 = 101;
+static const int kDefaultTimeout = 10000;  // 10 seconds.
+}  // namespace
