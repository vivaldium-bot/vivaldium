+        new UDPPort(thread, factory, network, min_port, max_port, username,
+                    password, origin, emit_local_for_anyaddress);
+    if (!port->Init()) {
+      delete port;
+      port = NULL;
+    }
+    return port;
+  }
+
+  ~UDPPort() override;
+
+  rtc::SocketAddress GetLocalAddress() const {
