diff --git a/third_party/webrtc/api/audio_codecs/audio_decoder.h b/third_party/webrtc/api/audio_codecs/audio_decoder.h
new file mode 100644
index 0000000000000000000000000000000000000000..dab7d3b2731c68d075ec5017ad3a6bfce00d9739
