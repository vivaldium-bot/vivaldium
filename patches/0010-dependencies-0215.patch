+
+    // Use screencapture option.
+    boolean useScreencapture = sharedPrefGetBoolean(R.string.pref_screencapture_key,
+        CallActivity.EXTRA_SCREENCAPTURE, R.string.pref_screencapture_default, useValuesFromIntent);
+
+    // Use Camera2 option.
