+uint32_t PseudoTcp::GetBytesBufferedNotSent() const {
+  size_t buffered_bytes = 0;
+  m_sbuf.GetBuffered(&buffered_bytes);
+  return static_cast<uint32_t>(m_snd_una + buffered_bytes - m_snd_nxt);
