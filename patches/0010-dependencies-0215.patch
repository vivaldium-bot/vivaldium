+
+  AudioFrame muted_frame;
+  muted_frame.samples_per_channel_ = 320;
+  muted_frame.num_channels_ = 2;
+  SetFrameData(1000, -1000, &muted_frame);
+  VerifyFramesAreEqual(muted_frame, frame_);
+}
