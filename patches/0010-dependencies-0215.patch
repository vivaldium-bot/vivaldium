+#endif  // WEBRTC_COMMON_AUDIO_SIGNAL_PROCESSING_RESAMPLE_BY_2_INTERNAL_H_
diff --git a/third_party/webrtc/common_audio/signal_processing/resample_by_2_mips.c b/third_party/webrtc/common_audio/signal_processing/resample_by_2_mips.c
