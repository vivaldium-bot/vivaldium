+  virtual void TearDown() { Thread::Current()->set_socketserver(nullptr); }
+
+  VirtualSocketServer* ss_;
+  const SocketAddress kIPv4AnyAddress;
+  const SocketAddress kIPv6AnyAddress;
+};
