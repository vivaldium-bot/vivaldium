+// Defined in TURN RFC 5766.
+enum TurnMessageType {
+  STUN_ALLOCATE_REQUEST                 = 0x0003,
+  STUN_ALLOCATE_RESPONSE                = 0x0103,
+  STUN_ALLOCATE_ERROR_RESPONSE          = 0x0113,
