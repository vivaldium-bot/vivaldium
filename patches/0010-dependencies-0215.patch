diff --git a/third_party/webrtc/pc/trackmediainfomap.cc b/third_party/webrtc/pc/trackmediainfomap.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2a7fe9cf4981b4ab05475636e4777f1a404ddcef
--- /dev/null
+++ b/third_party/webrtc/pc/trackmediainfomap.cc
@@ -0,0 +1,226 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
