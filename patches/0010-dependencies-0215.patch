+
+    /**
+     * @enum
+     */
+    es3fShaderTextureFunctionTests.TexFunction = {
+        TEXTURE: 0, //!< texture(), textureOffset()
+        TEXTUREPROJ: 1, //!< textureProj(), textureProjOffset()
+        TEXTUREPROJ3: 2, //!< textureProj(sampler2D, vec3)
+        TEXTURELOD: 3, // ...
