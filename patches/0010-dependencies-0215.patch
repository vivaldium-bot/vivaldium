+        var textureID = gl.createTexture();
+        gl.bindTexture(this.m_textureTarget, textureID);
+
+        if (this.m_textureTarget == gl.TEXTURE_2D_ARRAY || this.m_textureTarget == gl.TEXTURE_3D)
