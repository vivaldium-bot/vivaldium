+TEST_F(AudioFrameOperationsTest, MonoToStereoFailsWithBadParameters) {
+  EXPECT_EQ(-1, AudioFrameOperations::MonoToStereo(&frame_));
+
+  frame_.samples_per_channel_ = AudioFrame::kMaxDataSizeSamples;
+  frame_.num_channels_ = 1;
+  EXPECT_EQ(-1, AudioFrameOperations::MonoToStereo(&frame_));
