+        // Switch body.
+        var params = {};
+        params["CONDITION"] = type == es3fShaderSwitchTests.SwitchType.STATIC ? "2"     :
+                              type == es3fShaderSwitchTests.SwitchType.UNIFORM ? "ui_two" :
+                              type == es3fShaderSwitchTests.SwitchType.DYNAMIC ? "int(floor(coords.z*1.5 + 2.0))" : "???";
