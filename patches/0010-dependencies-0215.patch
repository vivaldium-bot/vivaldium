+    description(state.testCases.getDescription());
+    try {
+        if (range)
+            state.setRange(range);
+        //Run test cases
+        tcuTestCase.runTestCases();
+    }
+    catch (err) {
+        testFailedOptions('Failed to es3fShaderLoopTests.run tests', false);
+        tcuTestCase.runner.terminate();
+    }
+};
+
+});
