+    var TEX3D_VIEWPORT_WIDTH = 64;
+    var TEX3D_VIEWPORT_HEIGHT = 64;
+    var TEX3D_MIN_VIEWPORT_WIDTH = 64;
+    var TEX3D_MIN_VIEWPORT_HEIGHT = 64;
+
+    /**
+     * @constructor
+     * @extends {tcuTestCase.DeqpTest}
