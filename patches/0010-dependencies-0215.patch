+void PeerConnection::OnSctpTransportReadyToSendData_s(bool ready) {
+  RTC_DCHECK(signaling_thread()->IsCurrent());
+  sctp_ready_to_send_data_ = ready;
+  SignalSctpReadyToSendData(ready);
+}
