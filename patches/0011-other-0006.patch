+                       "  Expected: /" TEST_FILE "\n"
+                       "  Retrieved: %s\n",
+                       buffer);
+    return 1;
+  }
+
+  return 0;
+}
+
+static int do_unlink_test(struct file_desc_environment *file_desc_env) {
