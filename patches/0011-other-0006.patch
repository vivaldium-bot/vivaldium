+
+  pthread_mutex_t mutex;
+  int ret = pthread_mutex_init(&mutex, NULL);
+  if (0 != ret) {
+    irt_ext_test_print("do_cond_timed_wait_test: pthread_mutex_init failed:"
+                       " %s\n",
