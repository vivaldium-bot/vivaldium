+      fd < NACL_ARRAY_SIZE(g_activated_env->file_descs) &&
+      g_activated_env->file_descs[fd].valid &&
+      g_activated_env->file_descs[fd].data != NULL) {
+    if (!S_ISDIR(g_activated_env->file_descs[fd].data->mode))
