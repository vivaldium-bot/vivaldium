+ * nacl-clang does not use the .init/.fini mechanism at all, but newlib
+ * still calls _init and _fini, so define them as empty functions in the
+ * text section.
+ */
+        .section .text
+        .p2align 4
+        .globl _init
+        .type _init,%function
+_init:
+        sfi_bx lr
+
+        .p2align 4
+        .globl _fini
+        .type _fini,%function
+_fini:
+        sfi_bx lr
+#endif
