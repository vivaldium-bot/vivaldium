+/* ------------------------------------------------------------------*/
+/*                       POSIX semaphores.                           */
+
+static int handle_sem_wait(void* sem) {
+  OrigFn fn;
+  int    ret;
+  VALGRIND_GET_ORIG_FN(fn);
+
+  start_ignore_all_accesses();
+  CALL_FN_W_W(ret, fn, (size_t)sem);
+  stop_ignore_all_accesses();
+
+  if (!ret)
+    VG_CREQ_v_W(TSREQ_WAIT, VALGRIND_SANDBOX_PTR((size_t)sem));
