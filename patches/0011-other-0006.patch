+  }
+
+  struct timespec wait_time = { TEST_TIME_VALUE + TEST_WAIT_TIME };
+  env->current_time = TEST_TIME_VALUE;
+  ret = pthread_cond_timedwait(&cond, &mutex, &wait_time);
+  if (ETIMEDOUT != ret) {
