new file mode 100644
index 0000000000000000000000000000000000000000..d047949ae0f74c48c53495c55be4d0ed4a7926b9
--- /dev/null
+++ b/native_client/src/untrusted/pthread/nc_thread.c
@@ -0,0 +1,810 @@
+/*
