+Import('env')
+
+nexe = env.ComponentProgram('longjmp', 'longjmp.c',
+                            EXTRA_LIBS=['${NONIRT_LIBS}'])
+node = env.CommandSelLdrTestNacl('longjmp.out', nexe)
