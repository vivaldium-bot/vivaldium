+                       ['small_tests', 'toolchain_tests'],
+                       'run_longjmp_test')
+
+nexe = env.ComponentProgram('setlongjmp', 'setlongjmp.c',
+                            EXTRA_LIBS=['${NONIRT_LIBS}'])
+node = env.CommandSelLdrTestNacl('setlongjmp.out', nexe, exit_status=55)
+env.AddNodeToTestSuite(node,
+                       ['small_tests', 'toolchain_tests'],
+                       'run_setlongjmp_test')
