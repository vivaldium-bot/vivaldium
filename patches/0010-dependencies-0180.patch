+  extern "C" int fcmpSelect##cmp##Float(float a, float b, int c, int d);       \
+  extern "C" int fcmpSelect##cmp##Double(double a, double b, int c, int d);    \
+  extern "C" v4si32 fcmp##cmp##Vector(v4f32 a, v4f32 b);                       \
