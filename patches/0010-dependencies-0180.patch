index 0000000000000000000000000000000000000000..6c4fb38a2faf4fa18093ba0bbca2cd85853d3c63
--- /dev/null
+++ b/third_party/webrtc/voice_engine/include/voe_codec.h
@@ -0,0 +1,146 @@
+/*
+ *  Copyright (c) 2012 The WebRTC project authors. All Rights Reserved.
+ *
