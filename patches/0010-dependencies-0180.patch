+                         "DALLOW_LLVM_CL=1" \
+                         "DALLOW_LLVM_IR=1" \
+                         "DALLOW_LLVM_IR_AS_INPUT=1" \
+                         "DALLOW_MINIMAL_BUILD=0" \
