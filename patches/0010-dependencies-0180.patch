+        VideoSendStream* send_stream,
+        const std::vector<VideoReceiveStream*>& receive_streams) override {
+      send_stream_ = send_stream;
+    }
+
+    VideoSendStream* send_stream_;
+  } test;
+
+  RunBaseTest(&test);
+}
