+template <typename TraitsType>
+::Ice::Type TargetX86Base<TraitsType>::getPointerType() {
+  if (!Traits::Is64Bit ||
+      ::Ice::getFlags().getApplicationBinaryInterface() == ::Ice::ABI_PNaCl) {
+    return ::Ice::IceType_i32;
+  }
+  return ::Ice::IceType_i64;
+}
