+static bool property_type_exists (std::vector<std::string> properties,
+                                  wds::rtsp::PropertyType type)
+{
+  return std::find (properties.begin(),
+                    properties.end(),
+                    wds::rtsp::GetPropertyName(type)) != properties.end();
+}
