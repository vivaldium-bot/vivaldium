+  virtual void lowerIcmp(const InstIcmp *Instr) = 0;
+  virtual void lowerInsertElement(const InstInsertElement *Instr) = 0;
+  virtual void lowerIntrinsicCall(const InstIntrinsicCall *Instr) = 0;
