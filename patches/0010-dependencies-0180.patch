+void GlobalContext::saveBlockInfoPtrs() {
+  for (VariableDeclaration *Global : Globals) {
+    if (Cfg::isProfileGlobal(*Global)) {
+      ProfileBlockInfos.push_back(Global);
+    }
+  }
