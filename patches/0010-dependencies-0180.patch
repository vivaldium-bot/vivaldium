+void AssemblerMIPS32::emitRdRtSa(IValueT Opcode, const Operand *OpRd,
+                                 const Operand *OpRt, const uint32_t Sa,
+                                 const char *InsnName) {
+  const IValueT Rd = encodeGPRegister(OpRd, "Rd", InsnName);
