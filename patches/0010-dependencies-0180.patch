+int32_t UdpTransportImpl::SendSocketInformation(
+    char ipAddr[kIpAddressVersion6Length],
+    uint16_t& rtpPort,
+    uint16_t& rtcpPort) const
+{
+    CriticalSectionScoped cs(_crit);
+    rtpPort = _destPort;
