+      Control()->appendInst(
+          InstCast::create(Func, InstCast::Sitofp, Dest, Input));
+      break;
+    case kExprF32UConvertI32:
+      Dest = makeVariable(IceType_f32);
+      Control()->appendInst(
+          InstCast::create(Func, InstCast::Uitofp, Dest, Input));
