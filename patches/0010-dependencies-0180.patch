+
+    def find_elements_by_css_selector(self, css_selector):
+        """
+        Finds elements by css selector.
+
+        :Args:
+         - css_selector: The css selector to use when finding elements.
+
+        :Usage:
+            driver.find_element_by_css_selector('#foo')
