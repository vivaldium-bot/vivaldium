diff --git a/third_party/wds/src/p2p/connman-peer.cpp b/third_party/wds/src/p2p/connman-peer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..292045fcc9ebba0f9bc68bcbdb25c55771b5724f
--- /dev/null
+++ b/third_party/wds/src/p2p/connman-peer.cpp
@@ -0,0 +1,257 @@
