+      for (size_t i = 0; i < kNumStreams; ++i) {
+        ASSERT_TRUE(stats.substreams.find(kVideoSendSsrcs[i]) !=
+                    stats.substreams.end())
+            << "No stats for SSRC: " << kVideoSendSsrcs[i]
