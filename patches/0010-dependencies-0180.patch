+TEST_F(VideoQualityAnalysisTest, PrintAnalysisResultsOneFrame) {
+  ResultsContainer result;
+  result.frames.push_back(AnalysisResult(0, 35.0, 0.9));
+  PrintAnalysisResults(logfile_, "OneFrame", &result);
+}
