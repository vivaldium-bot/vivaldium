+            abort();
+          }
+        }
+        for (size_t m = 0; m < NumThreads; ++m) {
+          pthread_join(t[m], NULL);
+        }
+        Type ResultLlc = *AtomicLoc;
+
+        // Try N threads w/ both Sz and Llc.
+        *AtomicLoc = Value1;
+        for (size_t m = 0; m < NumThreads; ++m) {
+          pthread_attr_init(&attr[m]);
+          if (pthread_create(&t[m], &attr[m], &threadWrapper<Type>,
+                             m % 2 == 0
