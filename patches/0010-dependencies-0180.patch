+bool TargetARM32::doBranchOpt(Inst *I, const CfgNode *NextNode) {
+  if (auto *Br = llvm::dyn_cast<InstARM32Br>(I)) {
+    return Br->optimizeBranch(NextNode);
+  }
+  return false;
+}
