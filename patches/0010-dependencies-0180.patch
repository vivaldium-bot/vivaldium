+void InstARM32Mov::dump(const Cfg *Func) const {
+  if (!BuildDefs::dump())
+    return;
+  assert(getSrcSize() == 1 || getSrcSize() == 2);
+  Ostream &Str = Func->getContext()->getStrDump();
+  Variable *Dest = getDest();
+  Variable *DestHi = getDestHi();
+  Dest->dump(Func);
+  if (DestHi) {
+    Str << ", ";
+    DestHi->dump(Func);
+  }
+
+  dumpOpcodePred(Str, " = mov", getDest()->getType());
+  Str << " ";
+
+  dumpSources(Func);
+}
