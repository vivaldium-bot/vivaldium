+#define ICEINSTX8632BR_TABLE                                                   \
+  /* val, encode, opposite, dump, emit */                                      \
+  X(Br_o,  0,  Br_no, "o",  "jo")                                              \
+  X(Br_no, 1,  Br_o,  "no", "jno")                                             \
+  X(Br_b,  2,  Br_ae, "b",  "jb")                                              \
