+  static constexpr char LLVMPrefix[] = "llvm.";
+  constexpr size_t LLVMPrefixLen = llvm::array_lengthof(LLVMPrefix) - 1;
+  Error = false;
+  if (Name.toString().substr(0, LLVMPrefixLen) != LLVMPrefix)
+    return nullptr;
+  auto Iter = Map.find(Name);
+  if (Iter == Map.end()) {
