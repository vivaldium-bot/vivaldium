+      Control()->appendInst(
+          InstCast::create(Func, InstCast::Sext, Dest, Input));
+      break;
+    case kExprI32SConvertF32:
+      Dest = makeVariable(IceType_i32);
+      Control()->appendInst(
+          InstCast::create(Func, InstCast::Fptosi, Dest, Input));
