+// Return the width of the option tag for printing...
+size_t basic_parser_impl::getOptionWidth(const Option &O) const {
+  size_t Len = O.ArgStr.size();
+  auto ValName = getValueName();
+  if (!ValName.empty())
+    Len += getValueStr(O, ValName).size() + 3;
+
+  return Len + 6;
+}
