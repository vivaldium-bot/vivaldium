+  Ostream &Str = Func->getContext()->getStrEmit();
+  assert(Instr->getSrcSize() == 2);
+  Variable *Dest = Instr->getDest();
+  assert(Dest == Instr->getSrc(0));
+  Str << "\t" << Opcode << Instr->getPredicate() << "\t";
+  Dest->emit(Func);
+  Str << ", ";
+  Instr->getSrc(1)->emit(Func);
+}
