+void VideoSendStream::Stop() {
+  if (!payload_router_.active())
+    return;
+  TRACE_EVENT_INSTANT0("webrtc", "VideoSendStream::Stop");
+  vie_encoder_.Pause();
+  payload_router_.set_active(false);
+}
