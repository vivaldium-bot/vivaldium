+    k__Start = Operand::kTarget,
+    kMem,
+    kShAmtImm,
+    kFlexStart,
+    kFlexImm = kFlexStart,
+    kFlexFpImm,
+    kFlexFpZero,
+    kFlexReg,
+    kFlexEnd = kFlexReg
+  };
+
+  enum ShiftKind {
+    kNoShift = -1,
+#define X(enum, emit) enum,
+    ICEINSTARM32SHIFT_TABLE
+#undef X
+  };
+
+  using Operand::dump;
+  void dump(const Cfg *, Ostream &Str) const override {
+    if (BuildDefs::dump())
+      Str << "<OperandARM32>";
+  }
