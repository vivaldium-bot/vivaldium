+    // Cache used by GetCachedAddress(..).
+    RWLockWrapper* _cachLock;
+    SocketAddress _previousAddress;
+    char _previousIP[kIpAddressVersion6Length];
+    uint32_t _previousIPSize;
+    uint16_t _previousSourcePort;
