+
+    def testFindElementByXpathThrowNoSuchElementException(self):
+        self._loadSimplePage()
+        try:
+            self.driver.find_element_by_xpath("//h4")
+        except NoSuchElementException:
+            pass
+
+    def testFindElementsByXpath(self):
