+    AssemblerFixup *fixup_ = nullptr;
+    uint8_t rex_ = 0;
+    uint8_t encoding_[6];
+    uint8_t length_ = 0;
+
+    explicit Operand(GPRRegister reg) : fixup_(nullptr) { SetModRM(3, reg); }
