+}
+static const bool red_dummy =
+    google::RegisterFlagValidator(&FLAGS_red_payload_type,
+                                  &ValidateOptionalPayloadType);
+
+// Flag for ULPFEC payload type.
+DEFINE_int32(fec_payload_type, -1, "ULPFEC payload type");
