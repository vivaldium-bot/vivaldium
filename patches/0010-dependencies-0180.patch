+TimerStackIdT GlobalContext::newTimerStackID(const std::string &Name) {
+  if (!BuildDefs::timers())
+    return 0;
+  auto Timers = getTimers();
+  TimerStackIdT NewID = Timers->size();
+  Timers->push_back(TimerStack(Name));
+  return NewID;
+}
