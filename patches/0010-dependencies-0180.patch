+void testsIntWithZero(size_t &TotalTests, size_t &Passes, size_t &Failures) {
+  typedef bool (*FuncTypeUnsigned)(TypeUnsigned);
+  typedef bool (*FuncTypeSigned)(TypeSigned);
+  static struct {
+    const char *Name;
