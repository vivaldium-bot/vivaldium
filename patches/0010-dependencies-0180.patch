+  packet.Parse(data, size);
+
+  // Call packet accessors because they have extra checks.
+  packet.Marker();
+  packet.PayloadType();
+  packet.SequenceNumber();
+  packet.Timestamp();
+  packet.Ssrc();
+  packet.Csrcs();
+}
+
+}  // namespace webrtc
+
