diff --git a/third_party/webgl/src/conformance-suites/1.0.0/conformance/copy-tex-image-and-sub-image-2d.html b/third_party/webgl/src/conformance-suites/1.0.0/conformance/copy-tex-image-and-sub-image-2d.html
