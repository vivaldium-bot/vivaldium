+
+    if(_ipV6Enabled)
+    {
+#ifdef HAVE_STRUCT_SOCKADDR_SA_LEN
+        _localRTCPAddr.sin_length = 0;
+        _localRTCPAddr.sin_family = PF_INET6;
+#else
+        _localRTCPAddr._sockaddr_storage.sin_family = PF_INET6;
