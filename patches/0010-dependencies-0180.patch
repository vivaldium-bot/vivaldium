+    if (!_inputExternalMediaCallbackPtr) {
+      _engineStatisticsPtr->SetLastError(
+          VE_INVALID_OPERATION, kTraceWarning,
+          "Channel::DeRegisterExternalMediaProcessing() "
+          "input external media already disabled");
