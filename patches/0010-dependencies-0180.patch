+  // the constant pool.
+  Constant *getConstantInt(Type Ty, int64_t Value);
+  Constant *getConstantInt1(int8_t ConstantInt1) {
+    ConstantInt1 &= INT8_C(1);
+    switch (ConstantInt1) {
+    case 0:
+      return getConstantZero(IceType_i1);
+    case 1:
+      return ConstantTrue;
+    default:
+      assert(false && "getConstantInt1 not on true/false");
