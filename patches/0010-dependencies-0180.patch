diff --git a/third_party/wds/src/libwds/common/message_handler.cpp b/third_party/wds/src/libwds/common/message_handler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4cffeb804e8b83c8137d151a03c3112305229bbd
--- /dev/null
+++ b/third_party/wds/src/libwds/common/message_handler.cpp
@@ -0,0 +1,340 @@
+/*
+ * This file is part of Wireless Display Software for Linux OS
+ *
+ * Copyright (C) 2014 Intel Corporation.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
