+void VideoSendStream::Start() {
+  if (payload_router_.active())
+    return;
+  TRACE_EVENT_INSTANT0("webrtc", "VideoSendStream::Start");
+  payload_router_.set_active(true);
+  // Was not already started, trigger a keyframe.
+  vie_encoder_.SendKeyFrame();
+  vie_encoder_.Start();
+}
