+  Asm->bindLocalLabel(this, Number);
+  if (OffsetReloc != nullptr) {
+    Asm->bindRelocOffset(OffsetReloc);
+  }
+  if (Asm->needsTextFixup())
+    emitUsingTextFixup(Func);
+}
