+using namespace std;
+using namespace Ice;
+using namespace v8::internal;
+using namespace v8::internal::wasm;
+using v8::internal::wasm::DecodeWasmModule;
+
+#undef LOG
+#define LOG(Expr) log([&](Ostream & out) { Expr; })
