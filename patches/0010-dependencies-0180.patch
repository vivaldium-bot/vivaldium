+    #Public Methods
+    def set_preference(self, key, value):
+        """
+        sets the preference that we want in the profile.
+        """
+        clean_value = ''
+        if value is True:
+            clean_value = 'true'
+        elif value is False:
+            clean_value = 'false'
+        elif isinstance(value, str):
+            clean_value = '"%s"' % value
+        elif isinstance(value, unicode):
+            clean_value = '"%s"' % value
+        else:
+            clean_value = str(int(value))
