+  testPassed("All WebGL constants found to have correct values.");
+}
+var extended = false;
+for (var i in gl) {
+  if (i.match(/^[^a-z]/) && constants[i] == null) {
+    if (!extended) {
+      extended = true;
+      debug("Also found the following extra constants:");
+    }
+    debug(i);
