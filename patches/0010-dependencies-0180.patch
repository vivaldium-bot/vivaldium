+        if self.port == 0:
+            self.port = utils.free_port()
+        self.host = host
+        self.log_level = log_level
+        self.log_file = log_file
+
+        self.iedriver = Service(executable_path, port=self.port,
+             host=self.host, log_level=self.log_level, log_file=self.log_file)
