+
+template <class C>
+void
+test2(typename C::size_type n,
+      typename C::allocator_type const& a = typename C::allocator_type ())
+{
+#if TEST_STD_VER >= 14
+    C c(n, a);
+    LIBCPP_ASSERT(c.__invariants());
+    assert(c.size() == n);
+    assert(c.get_allocator() == a);
