diff --git a/buildtools/third_party/libc++/trunk/test/std/containers/sequences/vector.bool/move_assign_noexcept.pass.cpp b/buildtools/third_party/libc++/trunk/test/std/containers/sequences/vector.bool/move_assign_noexcept.pass.cpp
