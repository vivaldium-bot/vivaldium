+  var range = this.max - this.min + 1;
+  while (value < this.min) {
+    value += range;
+  }
+  while (value > this.max) {
+    value -= range;
+  }
+  return value;
+}
+
+function toRangeClamped(value) {
+  if (value < this.min) return this.min;
+  if (value > this.max) return this.max;
+  return value;
+}
+
