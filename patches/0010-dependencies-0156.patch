+        SkPaint paint;
+        paint.setARGB(255, 34, 31, 31);
+        paint.setAntiAlias(true);
+
+        SkPath path;
+        path.moveTo(18,439);
+        path.lineTo(414,439);
+        path.lineTo(414,702);
+        path.lineTo(18,702);
