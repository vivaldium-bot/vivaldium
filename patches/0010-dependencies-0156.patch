+          'failure': failure,
+          'id': '148aa78d7aa%02d00' % i,
+          'internal_failure': internal_failure,
+          'isolated_out': {
+            'isolated': 'abc123',
+            'isolatedserver': 'https://isolateserver.appspot.com',
+            'namespace': 'default-gzip',
