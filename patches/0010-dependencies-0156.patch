+bool Catalog::parseFromFile(const char* path) {
+    if (!INHERITED::parseSetup(path)) {
+        return false;
+    }
+    fIndent = 4;
+    this->writeString("var text = {");
+    this->lf(1);
+    fTextOut = true;
+    TextParser::Save save(this);
+    if (!parseFiddles()) {
+        return false;
+    }
+    this->lf(1);
+    this->writeString("}");
+    this->lf(2);
+    this->writeString("var pngs = {");
+    fTextOut = false;
+    fPngOut = true;
+    save.restore();
+    fContinuation = false;
+    return parseFiddles();
+}
