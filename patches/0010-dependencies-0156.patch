+SkDrawPatchCommand* SkDrawPatchCommand::fromJSON(Json::Value& command,
+                                                 UrlDataManager& urlDataManager) {
+    Json::Value jsonCubics = command[SKDEBUGCANVAS_ATTRIBUTE_CUBICS];
+    SkPoint cubics[12];
+    for (int i = 0; i < 12; i++) {
+        cubics[i] = get_json_point(jsonCubics[i]);
