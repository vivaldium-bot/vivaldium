+
+    for (auto r : recs) {
+        int i = sk_float_saturate2int(r.fFloat);
+        REPORTER_ASSERT(reporter, r.fExpectedInt == i);
+    }
+}
+
+DEF_TEST(DoubleSaturate, reporter) {
+    const struct {
+        double  fDouble;
