+    }
+    var changeAlpha = "opacity" == animation.attr;
+    if (changeAlpha) {
+        ctx.save();
+        ctx.globalAlpha = interp;
+    }
+    if (animation.func) {
+        animation.func(ctx, interp, animation.inParams);
+    } else {
+        animation.element.func(ctx);
+    }
+    if (changeAlpha) {
+        ctx.restore();
+    }
