+};
+
+// Test stroking for curves that produce degenerate tangents when t is 0 or 1 (see bug 4191)
+class Strokes5GM : public skiagm::GM {
+public:
+    Strokes5GM() {}
+
+protected:
+
+    SkString onShortName() override {
