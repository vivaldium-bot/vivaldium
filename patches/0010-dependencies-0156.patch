+DEF_SIMPLE_GM(CubicStroke, canvas, 384, 384) {
+    SkPaint p;
+    p.setAntiAlias(true);
+    p.setStyle(SkPaint::kStroke_Style);
+    p.setStrokeWidth(1.0720f);
+	SkPath path;
+    path.moveTo(-6000,-6000);
+    path.cubicTo(-3500,5500,-500,5500,2500,-6500);
+    canvas->drawPath(path, p);
