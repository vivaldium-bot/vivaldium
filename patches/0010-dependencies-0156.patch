+    path->lineTo(22, 18);
+    path->lineTo(22, 14);
+    path->lineTo(26, 14);
+    path->lineTo(26, 18);
+    path->close();
+}
+
+static void make_accessibility(SkPath* path) {
+    path->moveTo(12, 2);
+    path->cubicTo(13.10000038146973f,
+                  2,
+                  14,
+                  2.900000095367432f,
+                  14,
+                  4);
+    path->cubicTo(14,
+                  5.099999904632568f,
