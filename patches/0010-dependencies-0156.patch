+        SkDebugf("clip is%s empty\n", canvas->isClipEmpty() ? "" : " not");
+        SkPath path;
+        canvas->clipPath(path);
+        SkDebugf("clip is%s empty\n", canvas->isClipEmpty() ? "" : " not");
+    }
+    #StdOut
+        clip is not empty
