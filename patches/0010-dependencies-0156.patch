+        }
+        TRange lowerRange, upperRange;
+        bool result = bruteMinT(reporter, q1, q2, &lowerRange, &upperRange);
+        REPORTER_ASSERT(reporter, result);
+        double min = SkTMin(upperRange.t1, upperRange.t2);
