+        case 10: path.cubicTo(nonFinitePts[i], nonFinitePts[i], nonFinitePts[i]); break;
+        case 11: path.cubicTo(nonFinitePts[i], finitePts[f], finitePts[g]); break;
+        case 12: path.moveTo(nonFinitePts[i]); break;
