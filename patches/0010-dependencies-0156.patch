+        fPts[16].set(450, 450);
+
+        fText = "a";
+        fTextSize = 12;
+        fWidth = 50;
+        fDWidth = 0.25f;
+        fWeight = 1;
+        fRadius = 150;
+
+        fCubicButton.fLabel = 'C';
