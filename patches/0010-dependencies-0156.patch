diff --git a/third_party/swiftshader/third_party/LLVM/include/llvm/CodeGen/MachineBranchProbabilityInfo.h b/third_party/swiftshader/third_party/LLVM/include/llvm/CodeGen/MachineBranchProbabilityInfo.h
