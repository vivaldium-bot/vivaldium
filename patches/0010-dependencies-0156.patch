+
+  class MachineInstr;
+  class TargetInstrInfo;
+  class TargetRegisterInfo;
+  class MachineRegisterInfo;
+  class LiveVariables;
+
+  /// Process IMPLICIT_DEF instructions and make sure there is one implicit_def
