+            if (newT >= 0) {
+                diff = fabs(t - newT);
+                break;
+            }
+            step *= 1.5;
+            SkASSERT_RELEASE(step < 1);
+        } while (true);
+        worstStep[largeBits] = SkTMax(worstStep[largeBits], diff);
+#if 0
+        {
