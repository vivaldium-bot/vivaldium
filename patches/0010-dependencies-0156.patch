+static void construct_path(SkPath& path) {
+    path.reset();
+    path.moveTo(442, 101.5f);
+    path.quadTo(413.5f, 691, 772, 514);
+    path.lineTo(346, 721.5f);
+    path.lineTo(154, 209);
+    path.lineTo(442, 101.5f);
+    path.close();
+}
