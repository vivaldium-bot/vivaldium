+    #Example
+    void draw(SkCanvas* canvas) {
+        SkPaint paint;
+        paint.setAntiAlias(true);
+        SkPath path;
+        path.moveTo(128, 20);
+        path.rQuadTo(-6, 10, -7, 10);
+        for (int i = 1; i < 32; i += 4) {
+           path.rQuadTo(10 + i, 10 + i, 10 + i * 4, 10);
+           path.rQuadTo(-10 - i, 10 + i, -10 - (i + 2) * 4, 10);
+        }
+        path.quadTo(92, 220, 128, 215);
