+
+constexpr MakePathProc gProcs[] = {
+    make_frame,
+    make_triangle,
+    make_rect,
+    make_oval,
+    make_sawtooth_32,
+    make_star_5,
+    make_star_13,
+    make_line,
+    make_house,
+    make_sawtooth_3,
+};
