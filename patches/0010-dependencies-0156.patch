+        double angle = diamond_angle(y, x);
+        double rAngle = diamond_angle(ry, rx);
+        double diff = fabs(angle - rAngle);
+        SkDebugf("%s diamond xy=%1.9g rxy=%1.9g diff=%1.9g factor=%d\n", __FUNCTION__,
+                angle, rAngle, diff, (int) (diff / FLT_EPSILON));
