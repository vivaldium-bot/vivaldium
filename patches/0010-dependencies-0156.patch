+]
+
+DEFINES_IOS = [
+    "SK_BUILD_FOR_IOS",
+    "SK_BUILD_NO_OPTS",
+    "SK_HAS_JPEG_LIBRARY",
+    "SK_IGNORE_ETC1_SUPPORT",
+    "SKNX_NO_SIMD",
+]
+
+DEFINES_ALL = [
+    # Chrome DEFINES.
+    "SK_USE_FLOATBITS",
+    "SK_USE_FREETYPE_EMBOLDEN",
+    # Turn on a few Google3-specific build fixes.
+    "GOOGLE3",
