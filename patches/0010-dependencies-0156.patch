+            }
+        } else {
+            bXAlign = 5;
+            bYAlign = 5;
+        }
+        if (cShape) {
+            switch (cShape) {
+                case 1:  // square
+                    l =  cXAlign * 6;
+                    r =  l + 12;
+                    t =  cYAlign * 6;
+                    b =  l + 12;
+                    break;
+                case 2:
+                    l =  cXAlign * 6;
+                    r =  l + 12;
+                    t =  20; b = 30;
+                    cYAlign = 5;
+                    break;
+                case 3:
