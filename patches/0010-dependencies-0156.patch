+  F->viewCFGOnly();
+}
diff --git a/third_party/swiftshader/third_party/LLVM/lib/Analysis/BasicAliasAnalysis.cpp b/third_party/swiftshader/third_party/LLVM/lib/Analysis/BasicAliasAnalysis.cpp
