+static bool match(int* first, int* second, int count, int tol) {
+    int delta;
+    for (int i = 0; i < count; ++i) {
+        delta = first[i] - second[i];
+        if (delta > tol || delta < -tol) {
+            return false;
+        }
+    }
+
+    return true;
+}
