+static void write_as_csv(const char* label, SkScalar scale, int* data, int count) {
+    SkDebugf("%s_%.2f,", label, scale);
+    for (int i = 0; i < count-1; ++i) {
+        SkDebugf("%d,", data[i]);
+    }
+    SkDebugf("%d\n", data[count-1]);
+}
+#endif
