+    paint.isSubpixelText() == !!(paint.getFlags() & SkPaint::kSubpixelText_Flag) ? '=' : '!');
+
+        #StdOut
+            paint.isSubpixelText() == !!(paint.getFlags() & SkPaint::kSubpixelText_Flag)
