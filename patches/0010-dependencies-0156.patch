+            }
+        } else {
+            aXAlign = 5;
+            aYAlign = 5;
+        }
+        if (bShape) {
+            switch (bShape) {
+                case 1:  // square
+                    l =  bXAlign * 10;
+                    r =  l + 20;
+                    t =  bYAlign * 10;
+                    b =  l + 20;
+                    break;
+                case 2:
+                    l =  bXAlign * 10;
+                    r =  l + 20;
+                    t =  10; b = 40;
+                    bYAlign = 5;
+                    break;
+                case 3:
+                    l =  10; r = 40;
+                    t =  bYAlign * 10;
+                    b =  l + 20;
+                    bXAlign = 5;
+                    break;
+            }
+            path.addRect(SkIntToScalar(l), SkIntToScalar(t), SkIntToScalar(r), SkIntToScalar(b),
