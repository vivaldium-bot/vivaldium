diff --git a/third_party/skia/platform_tools/android/bin/android_build_app b/third_party/skia/platform_tools/android/bin/android_build_app
new file mode 100755
index 0000000000000000000000000000000000000000..7ce13013f88f691897f5922b59be0a64ce070dfc
--- /dev/null
