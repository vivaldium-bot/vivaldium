+        SkScalar h = SkIntToScalar(renderTargetContext->height()) / numRows;
+        int row = 0;
+        int col = 0;
+        constexpr GrColor color = 0xff000000;
+
+        for (int i = 0; i < kNumQuads; ++i) {
+            SkPoint baseControlPts[] = {
