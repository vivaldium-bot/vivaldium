+           SkDebugf("nullptr %c= color filter\n", paint.getColorFilter() ? '!' : '=');
+           paint.setColorFilter(SkColorFilter::MakeModeFilter(SK_ColorLTGRAY, SkBlendMode::kSrcIn));
+           SkDebugf("nullptr %c= color filter\n", paint.getColorFilter() ? '!' : '=');
+        }
+
