+
+// All we're looking for here is that we see a smooth gradient.
+DEF_SIMPLE_GM(radial_gradient_precision, canvas, 200, 200) {
+    SkPoint  center   = {100000, 100000};
+    SkScalar radius   = 40;
+    SkColor  colors[] = {SK_ColorBLACK, SK_ColorWHITE};
