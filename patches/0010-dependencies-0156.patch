+    }
+    SkScalar loopT[3];
+    SkCubicType cubicType = SkClassifyCubic(c);
+    int breaks = SkDCubic::ComplexBreak(c, loopT);
+    SkASSERT(breaks < 2);
+    if (breaks && cubicType == SkCubicType::kLoop) {
+        SkIntersections i;
