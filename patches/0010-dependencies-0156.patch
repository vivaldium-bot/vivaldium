diff --git a/third_party/skia/tests/MemsetTest.cpp b/third_party/skia/tests/MemsetTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b68844c86650ff21fba7a1b0df151936403f03ef
--- /dev/null
+++ b/third_party/skia/tests/MemsetTest.cpp
@@ -0,0 +1,89 @@
+/*
