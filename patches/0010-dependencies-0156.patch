+    REPORTER_ASSERT(r,  2.0f == c[0]);
+    REPORTER_ASSERT(r,  6.0f == c[1]);
+    REPORTER_ASSERT(r, 10.0f == c[2]);
+    REPORTER_ASSERT(r, 14.0f == c[3]);
+    REPORTER_ASSERT(r,  3.0f == d[0]);
+    REPORTER_ASSERT(r,  7.0f == d[1]);
+    REPORTER_ASSERT(r, 11.0f == d[2]);
