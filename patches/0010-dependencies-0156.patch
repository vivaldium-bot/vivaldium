+        float y = (float)gTriples[i+1];
+        float expected = (float)gTriples[i+2];
+        REPORTER_ASSERT(reporter, sk_float_copysign(x, y) == expected);
+    }
+
+    SkRandom rand;
+    for (int j = 0; j < 1000; j++) {
