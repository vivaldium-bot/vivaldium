+// There should be no more than one make_* used as a function argument.
+static bool make_bool() {
+    bool b; fuzz->next(&b);
+    return b;
+}
+
+static float make_number(bool positiveOnly) {
+    float f;
+    fuzz->next(&f);
+    if (positiveOnly) {
+        return std::abs(f);
+    }
+    return f;
+}
