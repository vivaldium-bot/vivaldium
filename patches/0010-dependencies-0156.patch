+static void create_ngon(int n, SkPoint* pts, SkScalar width, SkScalar height) {
+    float angleStep = 360.0f / n, angle = 0.0f, sin, cos;
+    if ((n % 2) == 1) {
+        angle = angleStep/2.0f;
+    }
+
+    for (int i = 0; i < n; ++i) {
+        sin = SkScalarSinCos(SkDegreesToRadians(angle), &cos);
+        pts[i].fX = -sin * width;
+        pts[i].fY = cos * height;
+        angle += angleStep;
+    }
+}
+
