+    for (auto& surface_func : { &create_gpu_surface, &create_gpu_scratch_surface }) {
+        auto surface(surface_func(ctxInfo.grContext(), kPremul_SkAlphaType, nullptr));
+        test_copy_on_write(reporter, surface.get());
+    }
+}
