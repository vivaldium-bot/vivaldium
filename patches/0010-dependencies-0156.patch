+
+    // This is enough to read the header etc, but no rows.
+    std::unique_ptr<SkCodec> codec(SkCodec::MakeFromData(SkData::MakeFromStream(stream.get(), 99)));
+    if (!codec) {
+        ERRORF(r, "Failed to create codec\n");
