+    bool            fPlayback;
+    void*           fBlock;
+    size_t          fBlockSize;
+    size_t          fBytesWritten;
+    int             fAtomsWritten;
+    size_t          fTotalWritten;
+
+    SkGPipeReader::Status   fStatus;
+};
+#endif
