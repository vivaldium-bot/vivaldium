+    "SK_NO_ANALYTIC_AA",
+]
+
+################################################################################
+## LINKOPTS
+################################################################################
+
+LINKOPTS_UNIX = []
+
+LINKOPTS_ANDROID = [
+    "-lEGL",
+]
+
+LINKOPTS_IOS = []
+
+LINKOPTS_ALL = [
+    "-ldl",
+]
