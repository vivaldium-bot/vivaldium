+static constexpr int kImageWidth = kBoxCountY * kBoxSize;
+static constexpr int kImageHeight = kBoxCountX * kBoxSize;
+
+static constexpr int kIndexPatternRepeatCount = 3;
+constexpr uint16_t kIndexPattern[6] = {0, 1, 2, 1, 2, 3};
