+using sk_gpu_test::GLTestContext;
+
+static void cleanup(GLTestContext* glctx0, GrGLuint texID0, GLTestContext* glctx1,
+                    sk_sp<GrContext> grctx1, GrBackendTexture* backendTex1,
+                    GrEGLImage image1) {
