+            'tests': {
+                'foo': {
+                    'pass1.html': {'results': [[4, 'P']], 'expected': 'FAIL'},
+                    'pass2.html': {'results': [[2, 'P']], 'expected': 'IMAGE'},
+                    'fail.html': {'results': [[4, 'F']]},
