+    BLINK_PLATFORM_EXPORT size_t elementCount() const;
+
+    // Sets the values of the element at the given index. Returns false if
+    // index is out of bounds.
+    BLINK_PLATFORM_EXPORT bool elementAt(size_t index, Element&) const;
