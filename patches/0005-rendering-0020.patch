+                test_list=['virtual/foo/bar1.html', 'virtual/foo/bar2.html'])
+        self.assert_shards(unlocked,
+            [('.', ['virtual/foo/bar1.html']),
+             ('.', ['virtual/foo/bar2.html'])])
