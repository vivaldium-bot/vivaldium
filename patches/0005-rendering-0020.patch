diff --git a/third_party/WebKit/Tools/Scripts/webkitpy/thirdparty/coverage/htmlfiles/pyfile.html b/third_party/WebKit/Tools/Scripts/webkitpy/thirdparty/coverage/htmlfiles/pyfile.html
