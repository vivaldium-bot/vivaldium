+        self.assertBaselines(file_list,
+            "platform/test-mac-leopard/passes/image", [".txt", ".png"], err)
+        self.assertBaselines(file_list,
+            "platform/test-mac-leopard/failures/expected/missing_image", [".txt", ".png"], err)
+
