+class MockDRTTest(unittest.TestCase):
+    def input_line(self, port, test_name, pixel_tests, checksum=None):
+        url = port.create_driver(0).test_to_uri(test_name)
+        if url.startswith('file://'):
+            url = url[len('file://'):]
+        if pixel_tests:
+            url += "'--pixel-test"
