-      docsLoaded += preload(docRef, "doc", "body");
-
-       if (docsLoaded == 1) {
-          setUpPageStatus = 'complete';
-       }
-    } catch(ex) {
-        catchInitializationError(builder, ex);
-        setUpPageStatus = 'complete';
-    }
-}
