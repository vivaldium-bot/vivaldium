-window.onload = (() => {
-  if (!window.eventSender || !window.internals) {
-  	debug("This test requires window.eventSender.");
-  	return;
-  }
-  internals.settings.setScrollAnimatorEnabled(true);
-});
-
-function handleMessage(event) {
-  if (event.data.hasOwnProperty('scrollBy')) {
-    port = event.source;
