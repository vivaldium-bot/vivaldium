-        case crossOriginRedirect:
-        case mixedRedirect:
-        case complexRedirect:
-            assert_between_exclusive(entry.transferSize, lowerBound, upperBound,
-                                     'cross origin transferSize');
-            ++seenCount;
-            break;
-
-        default:
-            break;
-        }
-    }
-    assert_equals(seenCount, 5, 'seenCount');
-    t.done();
-}
-
