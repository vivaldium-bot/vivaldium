-  }
-}
-
-window.onscroll = (() => {
-  if (port) {
-    port.postMessage({scrolled: frame_id, scrollTop: document.documentElement.scrollTop}, "*");
-  }
-});
-
-window.addEventListener("message", handleMessage);
-</script>
