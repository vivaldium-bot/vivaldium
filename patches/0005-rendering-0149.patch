-      view[i] = val | 0;
-    }
-    return buffer;
-  }
-
-  instantiate(ffi) {
-    let module = new WebAssembly.Module(this.toBuffer());
-    let instance = new WebAssembly.Instance(module, ffi);
-    return instance;
-  }
-}
