-
-function configureShadowRoot(shadow) {
-    shadow.innerHTML =
-        '<div id="x" style="position: relative;"><content></content></div>';
-    shadow.positionedElement = shadow.querySelector('#x');
-}
-
-function configureUAShadowRoot(shadow) {
