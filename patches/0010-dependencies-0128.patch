diff --git a/third_party/libvpx/source/libvpx/vp8/common/modecont.h b/third_party/libvpx/source/libvpx/vp8/common/modecont.h
new file mode 100644
index 0000000000000000000000000000000000000000..b58c7dc2d3da747b0e4eebb32c7c643e1d9bbba5
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/modecont.h
