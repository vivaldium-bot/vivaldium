+#endif  // VP9_ENCODER_VP9_BITSTREAM_H_
diff --git a/third_party/libvpx/source/libvpx/vp9/encoder/vp9_block.h b/third_party/libvpx/source/libvpx/vp9/encoder/vp9_block.h
