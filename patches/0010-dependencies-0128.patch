+  0,  /* rc_max_intra_bitrate_pct */
+  0,  /* gf_cbr_boost_pct */
+  0,  /* screen_content_mode */
+};
+
+struct vpx_codec_alg_priv {
+  vpx_codec_priv_t base;
+  vpx_codec_enc_cfg_t cfg;
+  struct vp8_extracfg vp8_cfg;
+  VP8_CONFIG oxcf;
+  struct VP8_COMP *cpi;
+  unsigned char *cx_data;
