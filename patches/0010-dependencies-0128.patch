+  for (int i = 0; i < seq_len; i++)
+  {
+    for (int j = 0; j < seq_len; j++)
+    {
+      for (int k = 0; k < seq_len; k++)
+      {
+        for (int l = 0; l < seq_len; l++)
+        {
+          if (i < k && k < j && j < l)
+          {
+            int ij = i * seq_len + j;
+            int kl = k * seq_len + l;
