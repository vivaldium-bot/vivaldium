index 0000000000000000000000000000000000000000..4152e7bb5d5da9cb032aada6b603460e3fcd6b24
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp9/encoder/arm/neon/vp9_denoiser_neon.c
@@ -0,0 +1,352 @@
+/*
