+                                unsigned char *v_ptr) {
+  int mb_col;
+  int filter_level;
+  loop_filter_info_n *lfi_n = &cm->lf_info;
+  (void)post_uvstride;
+
+  for (mb_col = 0; mb_col < cm->mb_cols; ++mb_col) {
