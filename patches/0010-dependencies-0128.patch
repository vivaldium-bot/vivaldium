diff --git a/third_party/libvpx/source/libvpx/vp8/common/reconinter.c b/third_party/libvpx/source/libvpx/vp8/common/reconinter.c
new file mode 100644
index 0000000000000000000000000000000000000000..48892c9b8e5def6f92795190c9d2e5655e1315fc
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/common/reconinter.c
@@ -0,0 +1,496 @@
+/*
