+
+      // Python: fd.write("ASSERT((Y(%s) AND Y(%s)) => final_Ey[%s]=%s);\n" %
+      // Python: (dec2bin(ij,idx2_bits), dec2bin(ij2,idx2_bits),
+      // dec2bin(ij,idx2_bits), dec2bin(int(alpha*E_table[kl]),e_bits)) );
