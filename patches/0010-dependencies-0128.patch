index 0000000000000000000000000000000000000000..da06fb151d8b2b4833295b6f70a8b594783b8dd6
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp9/encoder/vp9_multi_thread.c
@@ -0,0 +1,313 @@
+/*
