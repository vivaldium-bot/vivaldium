index 0000000000000000000000000000000000000000..0abffb05862afa6c2e110a984d825aa393d76740
--- /dev/null
+++ b/third_party/skia/src/pathops/SkPathOpsWinding.cpp
@@ -0,0 +1,407 @@
+/*
