+static int get_prediction_error(BLOCK *be, BLOCKD *b) {
+  unsigned char *sptr;
+  unsigned char *dptr;
+  sptr = (*(be->base_src) + be->src);
+  dptr = b->predictor;
+
+  return vpx_get4x4sse_cs(sptr, be->src_stride, dptr, 16);
+}
