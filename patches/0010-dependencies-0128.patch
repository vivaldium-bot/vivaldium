+bool SkPushButtonWidget::onClick(Click* click)
+{
+    SkRect    r;
+    State    state = kOff_State;
+
+    this->getLocalBounds(&r);
+    if (r.contains(click->fCurr))
+    {
+        if (click->fState == Click::kUp_State)
+            this->postWidgetEvent();
+        else
+            state = kOn_State;
+    }
+    this->setButtonState(state);
+    return true;
+}
