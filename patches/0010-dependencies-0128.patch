+    Expr ce = vc_getCounterExample(vc, elem);
+    unsigned long long v = getBVUnsigned(ce);
+    fprintf(stderr, "a[%d] = %llu\n", i, v);
+    *p = v;
+    p++;
+  }
+  printf("a = %d\n", *a_val);
+  ASSERT_TRUE((*a_val) / 5 == 5);
+
+  vc_Destroy(vc);
+}
