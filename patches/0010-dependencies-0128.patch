+    void debugValidate() const;
+    void detach(const SkOpSpan* );
+    double distSq(double t, const SkOpAngle* opp) const;
+
+    bool done() const {
+        SkASSERT(fDoneCount <= fCount);
+        return fDoneCount == fCount;
