index 0000000000000000000000000000000000000000..6f2c1634926ece5abb7b186ec84397b619300b6b
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp8/encoder/x86/quantize_sse4.c
@@ -0,0 +1,126 @@
+/*
