+
+#include "SkOpTAllocator.h"
+#include "SkOpSpan.h"
+#include "SkPathOpsTypes.h"
+
+class SkOpPtT;
+
+struct SkCoincidentSpans {
+    SkCoincidentSpans* fNext;
+    SkOpPtT* fCoinPtTStart;
+    SkOpPtT* fCoinPtTEnd;
+    SkOpPtT* fOppPtTStart;
+    SkOpPtT* fOppPtTEnd;
+    bool fFlipped;
