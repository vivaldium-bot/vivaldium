+
+public:
+    static FontConfigTypeface* Create(const SkFontStyle& style,
+                                      const SkFontConfigInterface::FontIdentity& fi,
+                                      const SkString& familyName) {
+        return new FontConfigTypeface(style, fi, familyName);
+    }
