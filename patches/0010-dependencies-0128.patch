+                                      const uint8_t *above,
+                                      const uint8_t *left) {
+  const uint16x4_t sum = dc_sum_32(left);
+  const uint8x8_t dc = vreinterpret_u8_u16(vrshr_n_u16(sum, 5));
+  (void)above;
+  dc_store_32x32(dst, stride, dc);
