+SkTypeface* SkCreateTypefaceFromLOGFONT(const LOGFONT& origLF) {
+    LOGFONT lf = origLF;
+    make_canonical(&lf);
+    SkTypeface* face = SkTypefaceCache::FindByProcAndRef(FindByLogFont, &lf);
+    if (nullptr == face) {
+        face = LogFontTypeface::Create(lf);
+        SkTypefaceCache::Add(face, get_style(lf));
+    }
+    return face;
+}
