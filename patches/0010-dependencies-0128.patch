+  ASTNodeMap sub;
+  plus_w = renameVars(plus_w);
+  assert(commutative_matchNode(plus_w, plus_v, sub, 2));
+  sub.clear();
+
+  assert(commutative_matchNode(plus_v, plus_w, sub, 1));
+}
