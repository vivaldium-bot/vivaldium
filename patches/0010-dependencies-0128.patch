+// Helper functions. Don't need to specify the width.
+ASTNode create(Kind k, const ASTNode& n0, const ASTNode& n1)
+{
+  if (is_Term_kind(k))
+    return nf->CreateTerm(k, n0.GetValueWidth(), n0, n1);
+  else
+    return nf->CreateNode(k, n0, n1);
+}
