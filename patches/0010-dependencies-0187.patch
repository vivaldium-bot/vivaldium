+      tx += "WebGL VERSION: " + this.contextInfo["VERSION"] + "\n";
+      tx += "WebGL RENDERER: " + this.contextInfo["RENDERER"] + "\n";
+      tx += "Unmasked VENDOR: " + this.contextInfo["UNMASKED_VENDOR"] + "\n";
