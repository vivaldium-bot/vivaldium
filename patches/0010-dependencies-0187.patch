+int yasm_x86__intnum_tobytes
+    (yasm_arch *arch, const yasm_intnum *intn, unsigned char *buf,
+     size_t destsize, size_t valsize, int shift, const yasm_bytecode *bc,
+     int warn);
+
+unsigned int yasm_x86__get_reg_size(uintptr_t reg);
