+int
+elf_ssym_has_flag(yasm_symrec *wrt, int flag)
+{
+    int i;
+    for (i=0; (unsigned int)i<elf_march->num_ssyms; i++) {
+        if (elf_ssyms[i] == wrt)
+            return (elf_march->ssyms[i].sym_rel & flag) != 0;
+    }
