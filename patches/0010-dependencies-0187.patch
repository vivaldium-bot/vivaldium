+static void
+cv8_lineinfo_bc_destroy(void *contents)
+{
+    cv8_lineinfo *li = (cv8_lineinfo *)contents;
+    cv8_lineset *ls1, *ls2;
+
+    /* delete line sets */
+    ls1 = STAILQ_FIRST(&li->linesets);
+    while (ls1) {
+        ls2 = STAILQ_NEXT(ls1, link);
+        yasm_xfree(ls1);
+        ls1 = ls2;
+    }
+
+    yasm_xfree(contents);
+}
