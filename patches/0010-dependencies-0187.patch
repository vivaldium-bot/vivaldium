+static void
+coff_symrec_data_print(void *data, FILE *f, int indent_level)
+{
+    coff_symrec_data *csd = (coff_symrec_data *)data;
+
+    fprintf(f, "%*ssymtab index=%lu\n", indent_level, "", csd->index);
+    fprintf(f, "%*ssclass=%d\n", indent_level, "", csd->sclass);
+}
