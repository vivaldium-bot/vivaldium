-    tailFrame = filtered.length - 1;
-  } else {
-    for (let k = filtered.length - 1; k >= 0; --k) {
-      if (Math.abs(filtered[k]) >= 1 / 32768) {
-        tailFrame = k + 1;
-        break;
-      }
-    }
-  }
-
-  return tailFrame;
-}
