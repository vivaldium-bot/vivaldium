diff --git a/third_party/grpc/test/core/json/json_test.c b/third_party/grpc/test/core/json/json_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..7ea5caca5b1fe3257850aa30b7a5956d73d7c12d
--- /dev/null
+++ b/third_party/grpc/test/core/json/json_test.c
@@ -0,0 +1,206 @@
+/*
+ *
+ * Copyright 2015-2016, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
+ *
