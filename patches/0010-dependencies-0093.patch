+@TYPE1@		FcStrSet *			@ARG1@		set
+@TYPE2@		const FcChar8 *			@ARG2@		s	
+@PURPOSE@	delete from a string set
+@DESC@
+Removes <parameter>s</parameter> from <parameter>set</parameter>, returning
