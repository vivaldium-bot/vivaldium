+template<typename T> void CompareTableFieldValue(flatbuffers::Table *table,
+                                                 flatbuffers::voffset_t voffset,
+                                                 T val) {
+  T read = table->GetField(voffset, static_cast<T>(0));
+  TEST_EQ(read, val);
+}
