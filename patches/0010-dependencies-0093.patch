+        return NULL;
+    }
+
+    PluralRuleParser parser;
+    PluralRules *newRules = new PluralRules(status);
+    if (U_SUCCESS(status) && newRules == NULL) {
+        status = U_MEMORY_ALLOCATION_ERROR;
