+    // Begin a class declaration.
+    static void BeginClass(const StructDef &struct_def, std::string *code_ptr) {
+      std::string &code = *code_ptr;
+      if (struct_def.fixed) {
+        code += "class " + struct_def.name + " extends Struct\n";
