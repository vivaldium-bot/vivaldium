+@TYPE3+++@ 	int%  				@ARG3+++@ 	n 
+@TYPE4+++@ 	FcMatrix ** 			@ARG4+++@ 	s 
+
+@PROTOTYPE++++@
+@RET++++@ 	FcResult 
