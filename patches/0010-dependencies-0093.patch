index 0000000000000000000000000000000000000000..ba069f1259ef96aa74fcf05f9eb955ed4dd3a6e2
--- /dev/null
+++ b/third_party/ffmpeg/tests/checkasm/h264qpel.c
@@ -0,0 +1,81 @@
