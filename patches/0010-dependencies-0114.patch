index 0000000000000000000000000000000000000000..d0d6b57f27b6aba9ed809ff5abf276ce162fea8d
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/cipher.h
@@ -0,0 +1,254 @@
+/*
+ * cipher.h
+ *
