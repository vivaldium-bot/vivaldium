+TEST_F(RegionDataBuilderTest, BuildUsRegionTree) {
+  supplier_.LoadRules("US", *loaded_callback_);
+  const RegionData& tree = builder_.Build("US", "en-US", &best_language_);
+  EXPECT_FALSE(tree.sub_regions().empty());
