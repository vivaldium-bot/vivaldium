+  Rule rule;
+  ASSERT_TRUE(rule.ParseSerializedRule("{\"languages\":\"sv\"}"));
+  std::vector<const RE2ptr*> matchers = PostBoxMatchers::GetMatchers(rule);
+  EXPECT_EQ(2, matchers.size());
