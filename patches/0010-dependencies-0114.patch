index 0000000000000000000000000000000000000000..f1aa4d7f79b478add0659d133333b0df40b1eaa8
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/test/test_vector_test.cc
@@ -0,0 +1,192 @@
+/*
+ *  Copyright (c) 2013 The WebM project authors. All Rights Reserved.
