+bool Segment::AddFrameWithAdditional(const uint8* data, uint64 length,
+                                     const uint8* additional,
+                                     uint64 additional_length, uint64 add_id,
+                                     uint64 track_number, uint64 timestamp,
+                                     bool is_key) {
+  if (!data || !additional)
+    return false;
