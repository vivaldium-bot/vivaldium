index 0000000000000000000000000000000000000000..caccfa03a9623223a2a4fd7196e570b2b536669b
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/crypto_kernel.h
@@ -0,0 +1,281 @@
+/*
+ * crypto_kernel.h
+ *
+ * header for the cryptographic kernel
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+/*
+ *	
