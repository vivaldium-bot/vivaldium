diff --git a/third_party/libdrm/src/tests/vbltest/vbltest.c b/third_party/libdrm/src/tests/vbltest/vbltest.c
new file mode 100644
index 0000000000000000000000000000000000000000..3f6b803a743ca753ca0622eff914fa2b0919b968
--- /dev/null
+++ b/third_party/libdrm/src/tests/vbltest/vbltest.c
@@ -0,0 +1,190 @@
+/*
+ * DRM based vblank test program
+ * Copyright 2008 Tungsten Graphics
+ *   Jakob Bornecrantz <jakob@tungstengraphics.com>
+ * Copyright 2008 Intel Corporation
+ *   Jesse Barnes <jesse.barnes@intel.com>
+ *
