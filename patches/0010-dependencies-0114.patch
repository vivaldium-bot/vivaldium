+    if (TestBit(BTN_TOOL_QUADTAP, device->info.key_bitmask))
+        return 4;
+    if (TestBit(BTN_TOOL_TRIPLETAP, device->info.key_bitmask))
+        return 3;
+    if (TestBit(BTN_TOOL_DOUBLETAP, device->info.key_bitmask))
+        return 2;
+    return 1;
