index 0000000000000000000000000000000000000000..d7d40cb72ce9071022fd0ac2004cbdfc9389ee61
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp10/encoder/mips/msa/fdct_msa.h
@@ -0,0 +1,117 @@
+/*
