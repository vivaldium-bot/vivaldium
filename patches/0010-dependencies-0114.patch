index 0000000000000000000000000000000000000000..37269f0a43a8f739f663681eebb475e190ef2ce2
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vp10/encoder/mips/msa/fdct4x4_msa.c
@@ -0,0 +1,99 @@
+/*
