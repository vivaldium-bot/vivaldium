--- /dev/null
+++ b/v8/test/mjsunit/array-functions-prototype-misc.js
@@ -0,0 +1,386 @@
+// Copyright 2008 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
