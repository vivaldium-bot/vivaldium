+PASS re.toString() is '/c/i'
+PASS re.compile(new RegExp('+')); threw exception SyntaxError: Invalid regular expression: /+/: Nothing to repeat.
+PASS re.toString() is '/(?:)/'
+PASS re.toString() is '/null/'
+PASS re.toString() is '/(?:)/'
+PASS re.toString() is '/z/'
+PASS re.lastIndex is 0
