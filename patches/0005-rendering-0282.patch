-		<rect id="Simple-round-rect-no-fill" fill="none" stroke="#000000"  x="250" y="46" width="50" height="80" rx="30"/>
-		<rect id="Simple-round-rect-filled" fill="red"  x="350" y="46" width="50" height="80" rx="30"/>
-		<!-- ====================================================================== -->
