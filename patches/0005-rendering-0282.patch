-
-    let maxError = -1;
-    let errorPosition = -1;
-    let diffCount = 0;
-
-    for (let k = 0; k < renderedData.length; ++k) {
-      let diff = renderedData[k] - reference[k];
-      noisePower += diff * diff;
-      signalPower += reference[k] * reference[k];
-      if (Math.abs(diff) > maxError) {
-        maxError = Math.abs(diff);
-        errorPosition = k;
-      }
-    }
