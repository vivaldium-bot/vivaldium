+  function sum2(a,b,c) {
+    var sum = 0;
+    for (var i = 0; i < arguments.length; ++i) {
+      var j = i;
+      if (arguments.length % 15 == 0 && i == 10) j += 10000;
+      sum += arguments[j] || i+1;
+    }
+    return sum;
+  };
+
+  var args = []
+  for (var i = 1; i < 30; ++i) {
+    args.push(i);
+    if (i%10 == 0) %OptimizeFunctionOnNextCall(sum2);
