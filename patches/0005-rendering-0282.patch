-// Apply the windowing function, in place.
-function applyWindow(timeData) {
-  let length = timeData.length;
-  let alpha = 0.16;
-  let a0 = (1 - alpha) / 2;
-  let a1 = 0.5;
-  let a2 = alpha / 2;
-  let omega = 2 * Math.PI / length;
