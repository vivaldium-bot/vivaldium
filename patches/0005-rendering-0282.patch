+function isReserved(word)
+{
+    try {
+        eval("var " + word + ";");
+        return false;
+    } catch (e) {
+        return true;
+    }
+}
+
+var reservedWords = [
+    "break",
+    "case",
+    "catch",
+    "class",
+    "const",
+    "continue",
+    "debugger",
