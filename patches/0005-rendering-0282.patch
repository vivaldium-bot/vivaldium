+    var stack = [];
+    stack.push({ "args": hostAndException.arguments });
+    throwException();
+}
+
+twoHostFunctions();
+myArray = hostCallsUser(myArray);
+shouldBe(myArray, new Array( 5, 6, 7 ) );
+
+try {
+    hostAndException();
+} catch (e) {
