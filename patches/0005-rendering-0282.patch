-  // Compare the rendered signal with our reference, keeping
-  // track of the maximum difference (and the offset of the max
-  // difference.)  Check for bad numbers in the rendered output
-  // too.  There shouldn't be any.
-  for (let k = 0; k < len; ++k) {
