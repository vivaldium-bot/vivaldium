-        
-        dropTarget.ondragenter = dragEntered;
-        dropTarget.ondragover = dragOver;
-        dropTarget.ondrop = drop;
-    }
-    
-    function dragStart(e)
-    {
-        event = e;
-        e.dataTransfer.effectAllowed = ALLOWED_EFFECTS;
-        e.dataTransfer.setData('Text', e.target.textContent);
-    }
