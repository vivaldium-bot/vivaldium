-
-      refreshValues();
-
-      let startBeepingTime;
-      let endBeepingTime;
-      let indicator = document.querySelector('#beepIndicator');
-
-      function inBeepingInterval(audioPosition) {
-        return audioPosition >= startBeepingTime && audioPosition <= endBeepingTime;
-      }
