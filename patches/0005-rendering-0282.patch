-  let distance = Math.sqrt(x * x + y * y + z * z);
-  distance = Math.max(distance, panner.refDistance);
-  let rolloff = panner.rolloffFactor;
-  let gain = Math.pow(distance / panner.refDistance, -rolloff);
-
-  return gain;
-}
