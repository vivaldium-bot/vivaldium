+  function sum1(a,b,c) {
+    var sum = 0;
+    var rest = arguments;
+    for (var i = 0; i < rest.length; ++i) {
+      var j = i;
+      if (rest.length % 15 == 0 && i == 10) j += 10000;
+      sum += rest[j] || i+1;
+    }
+    return sum;
+  };
+
+  var args = []
+  for (var i = 1; i < 30; ++i) {
+    args.push(i);
+    if (i%10 == 0) %OptimizeFunctionOnNextCall(sum1);
+    assertEquals(i*(i+1)/2, sum1(...args));
+  }
+})();
