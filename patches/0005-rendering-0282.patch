-function sendXHR(url, method, headers, body) {
-    if (!method) method = "GET";
-    if (!headers) headers = [];
-    if (!body) body="";
-
-    // copy headers
-    var headersNew = [];
-    for (var i=0; i<headers.length; i++) {
