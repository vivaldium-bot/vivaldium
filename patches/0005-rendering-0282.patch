+  %OptimizeFunctionOnNextCall(test2);
+  assertEquals(test2(1, 2), 3);
+  %OptimizeFunctionOnNextCall(test2);
+  assertEquals(test2(1, 2, 3), 3);
+})();
+
+(function MaterializeStrictOverwrittenArguments() {
+  "use strict"
+
+  function f(x, y) {
+    return x + y;
