+  }
+})();
+
+(function RestAccess0 () {
+  function sum3(...rest) {
+    var sum = 0;
+    for (var i = 0; i < rest.length; ++i) {
+      var j = i;
+      if (rest.length % 15 == 0 && i == 10) j += 10000;
+      sum += rest[j] || i+1;
+    }
+    return sum;
+  };
+
+  var args = []
+  for (var i = 1; i < 30; ++i) {
