+  %OptimizeFunctionOnNextCall(test3);
+  assertEquals(test3(11, 12), 23);
+  %OptimizeFunctionOnNextCall(test3);
+  assertEquals(test3(11, 12, 13), 23);
+})();
+
+(function MaterializeSloppyOverwrittenArguments() {
+  function f(x, y) {
+    return x + y;
+  }
+
+  function test4(a, b) {
+    a = 4;
+    %DeoptimizeNow();
+    return f.apply(null, arguments);
+  }
