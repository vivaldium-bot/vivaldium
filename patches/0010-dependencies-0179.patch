new file mode 100644
index 0000000000000000000000000000000000000000..ef97ecab9db478e0656f2aa271cbc1eed61bf943
--- /dev/null
+++ b/third_party/webrtc/modules/video_capture/video_capture_defines.h
@@ -0,0 +1,118 @@
+/*
