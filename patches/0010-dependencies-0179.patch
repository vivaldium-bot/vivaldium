+#define WAIT_(ex, timeout, res) \
+  do { \
+    res = (ex); \
+    int64_t start = rtc::TimeMillis(); \
+    while (!res && rtc::TimeMillis() < start + timeout) { \
+      SleepMs(5); \
+      res = (ex); \
+    } \
+  } while (0)
+
+#define EXPECT_TRUE_WAIT(ex, timeout) \
+  do { \
+    bool res; \
+    WAIT_(ex, timeout, res); \
+    if (!res) EXPECT_TRUE(ex); \
+  } while (0)
+
