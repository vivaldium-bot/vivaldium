+  BitrateAdjuster bitrate_adjuster_;
+  uint32_t target_bitrate_bps_;
+  uint32_t encoder_bitrate_bps_;
+  int32_t width_;
+  int32_t height_;
+};  // H264VideoToolboxEncoder
