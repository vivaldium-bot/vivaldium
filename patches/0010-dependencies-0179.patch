+bool FindMatchingCrypto(const CryptoParamsVec& cryptos,
+                        const CryptoParams& crypto,
+                        CryptoParams* out) {
+  for (CryptoParamsVec::const_iterator it = cryptos.begin();
+       it != cryptos.end(); ++it) {
+    if (crypto.Matches(*it)) {
+      *out = *it;
+      return true;
+    }
+  }
+  return false;
+}
