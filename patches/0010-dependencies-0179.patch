+    } else {
+      switch (proto) {
+        case PROTO_UDP:           return "gturn(udp)";
+        case PROTO_TCP:           return "gturn(tcp)";
+        case PROTO_SSLTCP:        return "gturn(ssltcp)";
+        default:                  return "gturn(?)";
+      }
+    }
