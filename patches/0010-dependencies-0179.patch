+namespace webrtc {
+
+class VCMPacket {
+ public:
+  VCMPacket();
+  VCMPacket(const uint8_t* ptr,
+            const size_t size,
+            const WebRtcRTPHeader& rtpHeader);
+  VCMPacket(const uint8_t* ptr,
+            size_t size,
+            uint16_t seqNum,
+            uint32_t timestamp,
+            bool markerBit);
+
+  void Reset();
+
+  uint8_t payloadType;
+  uint32_t timestamp;
+  // NTP time of the capture time in local timebase in milliseconds.
+  int64_t ntp_time_ms_;
+  uint16_t seqNum;
+  const uint8_t* dataPtr;
+  size_t sizeBytes;
+  bool markerBit;
+
+  FrameType frameType;
