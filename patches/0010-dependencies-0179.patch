+    EXPECT_EQ(kTiebreaker1, ports_before[i]->IceTiebreaker());
+  }
+
+  EXPECT_TRUE_WAIT(ep1_ch1()->receiving() &&
+                   ep1_ch1()->writable() &&
+                   ep2_ch1()->receiving() &&
+                   ep2_ch1()->writable(),
+                   1000);
