+// A common macro for testing converting I420 to ARGB, BGRA and ABGR.
+#define TEST_YUVTORGB(SRC_NAME, DST_NAME, JPG_TYPE, MSE, BLOCK_SIZE)           \
+  TEST_F(PlanarFunctionsTest, SRC_NAME##To##DST_NAME) {                        \
