index 0000000000000000000000000000000000000000..3d46ce2bcdf626d777b8996cb722f7cf042cf18b
--- /dev/null
+++ b/third_party/webrtc/modules/video_coding/jitter_estimator_tests.cc
@@ -0,0 +1,160 @@
+/*  Copyright (c) 2014 The WebRTC project authors. All Rights Reserved.
+ *
