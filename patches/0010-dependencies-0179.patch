+VP8DecoderImpl::VP8DecoderImpl()
+    : decode_complete_callback_(NULL),
+      inited_(false),
+      feedback_mode_(false),
+      decoder_(NULL),
+      last_keyframe_(),
+      image_format_(VPX_IMG_FMT_NONE),
+      ref_frame_(NULL),
+      propagation_cnt_(-1),
+      last_frame_width_(0),
+      last_frame_height_(0),
+      key_frame_required_(true) {}
