+  EXPECT_EQ(expected_flags[7], tl.EncodeFlags(timestamp));
+  tl.PopulateCodecSpecific(false, &vp8_info, 0);
+  EXPECT_EQ(expected_temporal_idx[7], vp8_info.temporalIdx);
+  EXPECT_EQ(true, vp8_info.layerSync);
