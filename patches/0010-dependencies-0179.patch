+ private:
+  enum {
+    MSG_ALLOCATE_ERROR = MSG_FIRST_AVAILABLE,
+    MSG_ALLOCATE_MISMATCH,
+    MSG_TRY_ALTERNATE_SERVER,
+    MSG_REFRESH_ERROR
+  };
