+// Types and classes used in media session descriptions.
+
+#ifndef WEBRTC_PC_MEDIASESSION_H_
+#define WEBRTC_PC_MEDIASESSION_H_
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <vector>
