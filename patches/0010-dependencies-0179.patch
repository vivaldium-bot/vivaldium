+{
+const int32_t NoWindowsCaptureDelays = 1;
+const DelayValues WindowsCaptureDelays[NoWindowsCaptureDelays] = {
+  "Microsoft LifeCam Cinema",
+  "usb#vid_045e&pid_075d",
+  {
+    {640,480,125},
