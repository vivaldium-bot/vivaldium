+    }
+
+    ~ScopedCallThread() { thread_->Stop(); }
+
+    rtc::Thread* thread() { return thread_.get(); }
+
+   private:
+    std::unique_ptr<rtc::Thread> thread_;
+    std::unique_ptr<rtc::MessageHandler> task_;
+  };
