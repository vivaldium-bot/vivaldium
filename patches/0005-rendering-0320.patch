index 0000000000000000000000000000000000000000..319f93bd767481acb28e52ca1ff85058a6c6f970
--- /dev/null
+++ b/v8/test/mjsunit/for-in.js
@@ -0,0 +1,271 @@
+// Copyright 2008 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
