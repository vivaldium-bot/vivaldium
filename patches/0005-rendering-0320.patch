+}
+
+
+let sigil2 = {};
+let reached = false;
+try {
+  try {
+    throw sigil1;
+  } catch {
+    reached = true;
+  } finally {
+    throw sigil2;
+  }
+} catch (e) {
+  assertEquals(e, sigil2);
+}
+assertTrue(reached);
