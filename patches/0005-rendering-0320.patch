+
+  // Race: generator request's promise should resolve after this Promise.
+  Promise.resolve("already-resolved").then(
+      _ => { didResolvePromise = true },
+      test.unexpectedRejection());
+
+}, "AsyncGenerator.return(thenable) / suspendStart");
