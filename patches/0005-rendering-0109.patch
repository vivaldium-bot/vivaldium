-    function serializedInsetRound(lhsValues, rhsValues, convert) {
-        var retStr = '';
-        if(!rhsValues)
-            retStr = 'inset(10' +testUnit+ ' round ' + lhsValues +')';
-        else
-            retStr = 'inset(10' +testUnit+ ' round ' + lhsValues +' / '+ rhsValues +')';
-
-        if(convert)
-            return convertToPx(retStr);
-
-        return retStr;
-    }
