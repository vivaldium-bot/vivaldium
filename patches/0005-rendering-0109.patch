-    if (filesRead == 3) {
-        finishJSTest();
-    }
-}
-
-function expectFileContents(file, contents) {
-    var reader = new FileReader();
-    reader.readAsText(file, "UTF-8");
-    reader.onload = checkFileContents.bind(undefined, contents);
-}
