-        +
-            0px : margin-left
-        +
-           35px : border-left-width
-        +
-            0px : padding-left
-        +
-           50px : width
-        +
-            0px : padding-right
-        +
-           15px : border-right-width
-        +
-            0px : margin-right
-        +
-          solve : right
-        ====================
-                : width of containing block (width of Initial Containing Block)
-  */
