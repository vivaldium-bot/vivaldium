-      <div class="b"></div>
-    </div>
-
-    <!-- block-level flex container -->
-    <div class="container" style="display: flex">
-      <div class="a"><div class="aKid"/></div>
-      <div class="b"></div>
-    </div>
-
-    <!-- floated flex container -->
-    <div class="container" style="display: flex; float: left">
