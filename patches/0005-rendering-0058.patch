-        height: 10px;
-        width: 100%;
-        background: lightgrey;
-      }
-
-    </style>
-  </head>
-  <body>
-    <!-- Flex container is auto-height - vertical margin and padding should
-         resolve to 0, since they don't have anything to resolve % against. -->
