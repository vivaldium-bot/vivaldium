-  for (var i = 0; i < div.length; i++) {
-    anyNS.appendChild(div[i])
-  }
-
-  div = [doc.createElement("div"),
-         doc.createElementNS("http://www.w3.org/1999/xhtml", "div"),
-         doc.createElementNS("", "div"),
