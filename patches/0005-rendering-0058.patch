-function formatStartTag(el) {
-//@{
-    var ret = "<" + el.tagName.toLowerCase();
-    for (var i = 0; i < el.attributes.length; i++) {
-        ret += " " + el.attributes[i].name + '="';
-        ret += el.attributes[i].value.replace(/\&/g, "&amp;")
-            .replace(/"/g, "&quot;");
-        ret += '"';
-    }
-    return ret + ">";
-}
