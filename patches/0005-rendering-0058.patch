-      <canvas style="width: 13px; max-width: 90px; flex: 3 auto"/>
-    </div>
-
-    <!-- G) Making sure we grow at least as large as min-width -->
-    <!-- Same as (C), except we've added a min-width on the second element.
-      -->
-    <div class="flexbox">
