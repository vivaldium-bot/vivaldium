-var shadowHost = document.getElementById("host")
-var shadowRoot = shadowHost.attachShadow({mode:"open"});
-var shadowNode = document.createElement('div');
-shadowRoot.appendChild(shadowNode);
-
-console.log("");
-console.log();
-
-test(function() {
