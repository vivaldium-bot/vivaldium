-    checkValues(shadowNode, "justifyItems", "justify-items", "right", "right");
-    checkValues(shadowNode, "justifySelf", "justify-self", "auto", "normal");
-
-    checkValues(shadowHost, "justifyItems", "justify-items", "auto", "normal");
