-
-      .marginA  { margin: 10%  8%  6%  4%; }
-      .marginB  { margin:  8% 10% 12% 14%; }
-      .paddingA { padding: 8%  6%  4%  2%; }
-      .paddingB { padding: 6%  8% 10% 12%; }
