+    Returns:
+      the FakeFile object corresponding to target_directory
+
+    Raises:
+      OSError:  if the target is not a directory
+    """
+    try:
+      directory = self.filesystem.GetObject(target_directory)
+    except IOError as e:
+      raise OSError(e.errno, e.strerror, target_directory)
