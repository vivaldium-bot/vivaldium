+
+  def testCopy2(self):
+    src_file = 'xyzzy'
+    dst_file = 'xyzzy_copy'
+    src_obj = self.filesystem.CreateFile(src_file)
+    src_obj.st_mode = ((src_obj.st_mode & ~0o7777) | 0o750)
