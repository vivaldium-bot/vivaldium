+    if (uni) {
+        style = PyUnicode_DecodeUTF8(PyString_AS_STRING(result),
+                                     PyString_GET_SIZE(result), "strict");
+        Py_DECREF(result);
+        if (!style)
+            return NULL;
+        result = style;
+    }
+#endif
+    return result;
+}
