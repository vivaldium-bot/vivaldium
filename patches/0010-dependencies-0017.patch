+    font-size: 100%;
+}
+ 
+/* Fix so <syntaxhighlight> tags and .css and .js pages get normal text size.
+   [[Bugzilla:26204]]. See also [[Wikipedia:Typography#The monospace 'bug']] */
+div.mw-geshi div,
+div.mw-geshi div pre,
+span.mw-geshi,
