+        'name': 'Devil Device Tests',
+        'path': 'devil/bin/run_py_devicetests',
+        'disabled': ['win', 'mac', 'linux']
+    },
+    {
+        'name': 'Devil Python Tests',
+        'path': 'devil/bin/run_py_tests',
+        'disabled': ['mac', 'win'],
+    },
+    {
+        'name': 'eslint Tests',
+        'path': 'common/eslint/bin/run_tests',
+        'disabled': ['android'],
