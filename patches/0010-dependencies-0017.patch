index 0000000000000000000000000000000000000000..8f96ae93d640cc8dbd4a699a494fa94c8c6b902d
--- /dev/null
+++ b/third_party/catapult/telemetry/third_party/web-page-replay/third_party/dns/rdtypes/ANY/HIP.py
@@ -0,0 +1,140 @@
+# Copyright (C) 2010 Nominum, Inc.
+#
+# Permission to use, copy, modify, and distribute this software and its
+# documentation for any purpose with or without fee is hereby granted,
+# provided that the above copyright notice and this permission notice
