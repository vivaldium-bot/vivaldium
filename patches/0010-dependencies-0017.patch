+def _GetDummyTime(start_time, increment):
+  def _DummyTime():
+    _DummyTime._curr_time += increment
+    return _DummyTime._curr_time
+  _DummyTime._curr_time = start_time - increment  # pylint: disable-msg=W0612
+  return _DummyTime
