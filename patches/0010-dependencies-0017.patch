+        EXT_INIT_ERROR(NULL);
+
+    EXT_ADD_UNICODE(m, "__author__", "Andr\xe9 Malo", "latin-1");
+    EXT_ADD_STRING(m, "__docformat__", "restructuredtext en");
+
+    EXT_INIT_RETURN(m);
+}
