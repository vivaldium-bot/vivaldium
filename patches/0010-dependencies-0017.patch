+}
+td.diff-deletedline {
+	background: #ffffaa;
+	font-size: smaller;
+	border: dotted 2px black;
+}
+td.diff-context {
+	background: #eeeeee;
+	font-size: smaller;
+}
+.diffchange {
+	color: silver;
