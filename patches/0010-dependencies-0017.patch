+class AndTest(testtools.TestCase):
+    """Test And correctly chains Comparators."""
+
+    def testValidAnd(self):
+        """And should be True if both Comparators return True."""
+        self.assertTrue(mox.And(mox.IsA(str), mox.IsA(str)) == '1')
