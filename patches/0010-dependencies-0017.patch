+/**
+ * Diff rendering
+ */
+table.diff {
+	background: white;
+}
+td.diff-otitle {
+	background: #ffffff;
+}
+td.diff-ntitle {
+	background: #ffffff;
+}
+td.diff-addedline {
+	background: #ccffcc;
+	font-size: smaller;
