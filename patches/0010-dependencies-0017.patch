+class TestExpectationParserTest(unittest.TestCase):
+
+  def testInitWithGoodData(self):
+    good_data = """
+# This is a test expectation file.
+#
+# tags: tag1 tag2 tag3
+# tags: tag4 Mac Win Debug
+
+crbug.com/12345 [ Mac ] b1/s1 [ Skip ]
