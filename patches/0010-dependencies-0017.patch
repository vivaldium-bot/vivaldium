+class MoxTestBaseTest(testtools.TestCase):
+    """Verify that all tests in class derived from MoxTestBase are wrapped."""
+
+    def setUp(self):
+        super(MoxTestBaseTest, self).setUp()
+        self.mox = mox.Mox()
+        self.addCleanup(self.mox.UnsetStubs)
