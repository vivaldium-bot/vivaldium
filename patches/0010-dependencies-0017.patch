+import logging
+import StringIO
+import unittest
+
+from py_utils import logging_util
+
+
+class LoggingUtilTest(unittest.TestCase):
+  def testCapture(self):
+    s = StringIO.StringIO()
+    with logging_util.CaptureLogs(s):
+      logging.fatal('test')
+
+    # Only assert ends with, since the logging message by default has the date
+    # in it.
