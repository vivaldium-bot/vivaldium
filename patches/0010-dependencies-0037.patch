+      else
+        maxLength = 0;
+
+      while (i + maxLength < n && list[startIndex + maxLength] ===
+             list[startIndex + i + maxLength]) {
+        ++maxLength;
+      }
+
+      if (i + maxLength - 1 > right) {
+        left = i;
+        right = i + maxLength - 1;
+      }
+
+      z[i] = maxLength;
+    }
+
+    return z;
+  }
