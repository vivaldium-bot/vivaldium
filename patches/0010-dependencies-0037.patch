+    buildroot: If |chroot| is not set, find it relative to |buildroot|.
+
+  Returns:
+    The version of the chroot dir.
+  """
+  if chroot is None and buildroot is None:
+    raise ValueError('need either |chroot| or |buildroot| to search')
