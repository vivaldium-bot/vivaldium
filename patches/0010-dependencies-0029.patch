+
+    var thread = threads[0];
+    assert.equal(thread.sliceGroup.slices[0].args['cpu'], 3);
+    assert.equal(thread.sliceGroup.slices[0].args['targ'], 800000);
+    assert.equal(thread.sliceGroup.slices[0].args['actual'], 1000000);
+  });
+});
+</script>
