+          this.topLevelSlices,
+          getSliceLo, getSliceHi,
+          ts);
+      if (i == -1 || i == this.topLevelSlices.length)
+        return undefined;
+
+      var curSlice = this.topLevelSlices[i];
+
+      // Now recurse on slice looking for subSlice of given ts.
+      while (true) {
+        var i = tr.b.findIndexInSortedClosedIntervals(
+            curSlice.subSlices,
+            getSliceLo, getSliceHi,
