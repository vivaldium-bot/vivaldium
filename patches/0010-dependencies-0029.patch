+          ColorScheme.getColorIdForGeneralPurposeString(title);
+      var slice = new this.sliceConstructor(category, title, colorId, ts,
+                                            opt_args ? opt_args : {},
+                                            duration, tts, cpuDuration,
+                                            opt_argsStripped, opt_bind_id);
