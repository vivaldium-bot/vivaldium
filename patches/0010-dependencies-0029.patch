index 0000000000000000000000000000000000000000..fe1eed2b4bed47f534037a8b30e863c02e4d7b6d
--- /dev/null
+++ b/third_party/catapult/tracing/tracing/model/global_memory_dump.html
@@ -0,0 +1,833 @@
+<!DOCTYPE html>
+<!--
