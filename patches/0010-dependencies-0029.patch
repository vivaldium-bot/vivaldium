+    var selectionSummaryTableEl = tr.b.findDeepElementMatching(
+        viewEl, 'tr-ui-a-selection-summary-table');
+    assert.isDefined(selectionSummaryTableEl);
+    assert.equal(selectionSummaryTableEl.selection, selection);
