+      var maliEvent = this.lineRE.exec(eventBase.details);
+      // Old-style Mali perf events have no thread id, so make one.
+      var tid = (maliEvent[1] === '' ? 'mali' : maliEvent[1]);
+      switch (maliEvent[2]) {
