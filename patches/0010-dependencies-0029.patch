+    var model = tr.c.TestUtils.newModel(function(model) {
+      buildDumpTrees([
+        [  // GMD.
+          {
+            'name': 'owned_root',
+            'guid': 1,
+            'size': 10,
+            'children': [
+              {
+                'name': 'owned_child1',
+                'attrs': {
+                  'summed': new ScalarAttribute('bytes', 12)
+                }
+              },
+              {
+                'name': 'owned_child2',
+                'attrs': {
+                  'summed': new ScalarAttribute('bytes', 15)
+                }
+              }
+            ]
+          }
+        ],
+        [  // PMD.
+          {
+            'name': 'direct_owner',
+            'owns': 1,
+            'guid': 2
+          },
+          {
+            'name': 'parent_owner',
+            'children': [
+              {
+                'name': 'child_owner',
+                'owns': 1
+              },
+              {
+                'name': 'sibling',
+                'size': 5,
+                'attrs': {
+                  'summed': new ScalarAttribute('bytes', 13)
+                }
+              }
+            ]
+          },
+          {
+            'name': 'precedent_owner',
+            'owns': 1,
+            'attrs': {
+              'summed': new ScalarAttribute('bytes', 0)
+            }
+          },
+          {
+            'name': 'indirect_owner',
+            'owns': 2
+          }
+        ]
+      ], model);
+    });
+    var pmd = model.getProcess(0).memoryDumps[0];
+
+    var directOwnerDump = pmd.getMemoryAllocatorDumpByFullName('direct_owner');
+    assertSizeAttribute(directOwnerDump, 'summed', 27);
+    assertSizeAttribute(directOwnerDump, 'size', 10);
+    assertSizeAttribute(directOwnerDump, 'effective_size', 3.3333, [
+      ownedInfo('indirect_owner', 'Process 0', 0),
+      ownerInfo('owned_root', 'global space', 0, 'parent_owner/child_owner',
+          'Process 0', 0, 'precedent_owner', 'Process 0', 0)
+    ]);
+
+    var childOwnerDump =
+        pmd.getMemoryAllocatorDumpByFullName('parent_owner/child_owner');
+    assertSizeAttribute(childOwnerDump, 'summed', 27);
+    assertSizeAttribute(childOwnerDump, 'size', 10);
+    assertSizeAttribute(childOwnerDump, 'effective_size', 3.3333, [
+      ownerInfo('owned_root', 'global space', 0, 'direct_owner', 'Process 0', 0,
+          'precedent_owner', 'Process 0', 0)
+    ]);
+
+    var parentOwnerDump = pmd.getMemoryAllocatorDumpByFullName('parent_owner');
+    assertSizeAttribute(parentOwnerDump, 'summed', 40);
+    assertSizeAttribute(parentOwnerDump, 'size', 15);
+    assertSizeAttribute(parentOwnerDump, 'effective_size', 8.3333);
+
+    var precedentOwnerDump =
+        pmd.getMemoryAllocatorDumpByFullName('precedent_owner');
+    assertSizeAttribute(precedentOwnerDump, 'summed', 0);
+    assertSizeAttribute(precedentOwnerDump, 'size', 10);
+    assertSizeAttribute(precedentOwnerDump, 'effective_size', 3.3333, [
