+  test('importMemoryDumps_levelsOfDetail', function() {
+    function checkLevelsOfDetail(rawLevelsOfDetail, expectedGlobalLevelOfDetail,
+        expectedProcessLevelsOfDetail) {
+      var events = [];
+      rawLevelsOfDetail.forEach(function(rawProcessLevelsOfDetail, pid) {
+        rawProcessLevelsOfDetail.forEach(function(rawComposableLevelOfDetail) {
+          var dumps = {};
+          if (rawComposableLevelOfDetail !== undefined)
+            dumps.level_of_detail = rawComposableLevelOfDetail;
+          events.push({
+            name: 'process_' + pid,
+            pid: pid,
+            ts: 10,
+            ph: 'v',
+            id: '0x0001',
+            args: {
+              dumps: dumps
+            }
+          });
+        });
+      });
+      var model = makeModel(events);
+
+      // Check GlobalMemoryDump level of detail.
+      assert.lengthOf(model.globalMemoryDumps, 1);
+      assert.strictEqual(model.globalMemoryDumps[0].levelOfDetail,
+          expectedGlobalLevelOfDetail);
+
+      // Check ProcessMemoryDumps levels of detail.
+      assert.lengthOf(Object.keys(model.processes),
+          expectedProcessLevelsOfDetail.length);
+      for (var i = 0; i < expectedProcessLevelsOfDetail.length; i++) {
+        var process = model.getProcess(i);
+        assert.lengthOf(process.memoryDumps, 1);
+        assert.strictEqual(process.memoryDumps[0].levelOfDetail,
+            expectedProcessLevelsOfDetail[i]);
+      }
+    }
+
+    // Well-formed trace events.
+    checkLevelsOfDetail([[undefined]], undefined, [undefined]);
+    checkLevelsOfDetail([['light'], ['light']], 'light', ['light', 'light']);
+    checkLevelsOfDetail(
+        [
+          ['detailed', 'detailed'],
+          ['detailed'],
+          ['detailed', 'detailed', 'detailed']
+        ],
+        'detailed',
+        ['detailed', 'detailed', 'detailed']);
+
+    // Not so well-formed trace events.
+    checkLevelsOfDetail(
+        [['light'], [undefined], ['detailed'], ['light']],
+        'detailed',
+        ['light', undefined, 'detailed', 'light']);
+    checkLevelsOfDetail(
+        [['light', 'detailed'], [undefined], ['light', undefined]],
+        'detailed',
+        ['detailed', undefined, 'light']);
+    checkLevelsOfDetail(
+        [['invalid', 'light'], ['invalid']],
+        'light',
+        ['light', undefined]);
+  });
