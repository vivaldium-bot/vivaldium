+          this.getMaxAttributeValue(attrsA), this.getMaxAttributeValue(attrsB));
+    },
+
+    getMaxAttributeValue: function(attrs) {
+      return attrs.reduce(function(accumulator, attr) {
+        if (attr === undefined)
+          return accumulator;
+        var attrValue = attr.value;
+        if (accumulator === undefined ||
