+          slice.colorId, slice.start,
+          slice.args, slice.duration, slice.cpuStart, slice.cpuDuration);
+      newSlice.didNotFinish = slice.didNotFinish;
+      return newSlice;
+    },
+
+    iterateAllEventsInThisContainer: function(eventTypePredicate,
+                                              callback, opt_this) {
