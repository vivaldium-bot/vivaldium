+      var args = Array.prototype.slice.call(arguments);
+      print('Info:', args.join(' '));
+    },
+
+    error: function() {
+      var args = Array.prototype.slice.call(arguments);
+      print('Error:', args.join(' '));
+    },
+
+    warn: function() {
