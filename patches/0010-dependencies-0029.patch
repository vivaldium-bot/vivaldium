+#: Regex for route definitions.
+_route_re = re.compile(r"""
+    \<               # The exact character "<"
+    ([a-zA-Z_]\w*)?  # The optional variable name
+    (?:\:([^\>]*))?  # The optional :regex part
+    \>               # The exact character ">"
+    """, re.VERBOSE)
+#: Regex extract charset from environ.
+_charset_re = re.compile(r';\s*charset=([^;]*)', re.I)
+
