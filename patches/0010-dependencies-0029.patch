+        }
+      }
+      return slices;
+    },
+
+    iterSlicesInTimeRange: function(callback, start, end) {
+      var ret = [];
+      tr.b.iterateOverIntersectingIntervals(
+        this.topLevelSlices,
+        function(s) { return s.start; },
+        function(s) { return s.duration; },
+        start,
+        end,
+        function(topLevelSlice) {
