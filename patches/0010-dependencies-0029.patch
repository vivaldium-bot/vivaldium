+              attrsB[0], attrsB[attrsB.length - 1]);
+
+        case MemoryColumn.AggregationMode.MAX:
+          return this.compareMultipleAttributesMax(attrsA, attrsB);
+
+        default:
+          return 0;
+      }
+    },
+
