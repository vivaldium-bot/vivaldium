+    assert.isBelow(column.compareAttributes(attrsA, attrsB), 0);
+    assert.isAbove(column.compareAttributes(attrsB, attrsA), 0);
+  }
+
+  function checkScalarMemoryColumnValueFormat(test, column, attrValues,
