+    assert.equal(threads[0].sliceGroup.length, 1);
+
+    var threads = m.findAllThreadsNamed('kworker/u:5');
+    assert.equal(threads.length, 1);
+    assert.equal(threads[0].sliceGroup.length, 1);
+    assert.equal('fence_wait("display")',
+                 threads[0].sliceGroup.slices[0].title);
