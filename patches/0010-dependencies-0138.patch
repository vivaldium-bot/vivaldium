+    for (size_t i = 0; i < SK_ARRAY_COUNT(g32); ++i) {
+        REPORTER_ASSERT(reporter, g32[i].fYang == SkEndianSwap32(g32[i].fYin));
+    }
+    for (size_t i = 0; i < SK_ARRAY_COUNT(g64); ++i) {
+        REPORTER_ASSERT(reporter, g64[i].fYang == SkEndianSwap64(g64[i].fYin));
+    }
+}
