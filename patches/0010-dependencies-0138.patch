+			for(unsigned i = 0; i < uav_count; ++i)
+			{
+				om_unordered_access_views[uav_start + i] = new_unordered_access_views[i];
+				render_target_views[uav_start + i] = (ID3D11RenderTargetView*)0;
+			}
+		}
+	}
