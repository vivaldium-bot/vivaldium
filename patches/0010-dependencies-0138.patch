+
+#include "fpdfview.h"
+
+// Exported Functions
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Function: FPDFText_LoadPage
+//          Prepare information about all characters in a page.
+// Parameters:
+//          page    -   Handle to the page. Returned by FPDF_LoadPage function
+//          (in FPDFVIEW module).
