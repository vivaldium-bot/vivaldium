+template<bool threadsafe>
+struct maybe_mutex_t;
+
+template<>
+struct maybe_mutex_t<true>
+{
+	pipe_mutex mutex;
+
+	maybe_mutex_t()
+	{
+		pipe_mutex_init(mutex);
+	}
+
+	void lock()
+	{
+		pipe_mutex_lock(mutex);
+	}
+
+	void unlock()
+	{
+		pipe_mutex_unlock(mutex);
+	}
+};
+
+template<>
+struct maybe_mutex_t<false>
+{
+	void lock()
+	{
+	}
+
+	void unlock()
+	{
+	}
+};
+
+typedef maybe_mutex_t<true> mutex_t;
+
+template<typename T>
+struct lock_t
+{
+	T& mutex;
+	lock_t(T& mutex)
+	: mutex(mutex)
+	{
+		mutex.lock();
+	}
+
+	~lock_t()
+	{
+		mutex.unlock();
+	}
+};
