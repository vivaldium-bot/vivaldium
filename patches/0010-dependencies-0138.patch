+  public String toString() {
+    return super.toString().toLowerCase();
+  }
+
+  public static GsubLookupType forTypeNum(int typeNum) {
+    if (typeNum <= 0 || typeNum > values.length) {
+      System.err.format("unknown gsub lookup typeNum: %d\n", typeNum);
