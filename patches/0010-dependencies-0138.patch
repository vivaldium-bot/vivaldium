+CPDFSDK_DateTime CPDFSDK_DateTime::ToGMT() const {
+  CPDFSDK_DateTime dt = *this;
+  dt.AddSeconds(-gAfxGetTimeZoneInSeconds(dt.dt.tzHour, dt.dt.tzMinute));
+  dt.dt.tzHour = 0;
+  dt.dt.tzMinute = 0;
+  return dt;
+}
