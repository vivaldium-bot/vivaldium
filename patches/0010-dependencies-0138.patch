+	virtual HRESULT STDMETHODCALLTYPE CreateBuffer(
+		const D3D11_BUFFER_DESC *desc,
+		const D3D11_SUBRESOURCE_DATA *initial_data,
+		ID3D11Buffer **out_buffer)
