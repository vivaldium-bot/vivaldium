--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/svga/svga_screen_cache.c
@@ -0,0 +1,492 @@
+/**********************************************************
+ * Copyright 2008-2009 VMware, Inc.  All rights reserved.
