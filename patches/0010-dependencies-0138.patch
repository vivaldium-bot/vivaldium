+void vcgen_dash::add_dash(FX_FLOAT dash_len, FX_FLOAT gap_len)
+{
+    if(m_num_dashes < max_dashes) {
+        m_total_dash_len += dash_len + gap_len;
+        m_dashes[m_num_dashes++] = dash_len;
+        m_dashes[m_num_dashes++] = gap_len;
