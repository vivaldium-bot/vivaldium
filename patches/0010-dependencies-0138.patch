new file mode 100644
index 0000000000000000000000000000000000000000..5599171619c3f9b416bc4a21dfde7e7cf8241d48
--- /dev/null
+++ b/third_party/pdfium/public/fpdf_dataavail.h
@@ -0,0 +1,197 @@
+// Copyright 2014 PDFium Authors. All rights reserved.
