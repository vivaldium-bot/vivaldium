+    protected:                                                        \
+        void onGetName(SkString* name) override { name->set(#name); } \
+        void onRun() override { test_##name(); }                      \
+    };                                                                \
+    static TestRegistry gReg_##name##Class(name##Class::Factory);     \
+    static void test_##name()
