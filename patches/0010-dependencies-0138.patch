+      rcWindow, (FX_FLOAT)(GetBorderWidth() + GetInnerBorderWidth()));
+  if (CPWL_ScrollBar* pVSB = GetVScrollBar())
+    rcClient.right -= pVSB->GetScrollBarWidth();
