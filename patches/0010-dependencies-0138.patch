+
+        '../third_party/skia/src/utils/win/SkDWrite.cpp',
+        '../third_party/skia/src/utils/win/SkDWriteFontFileStream.cpp',
+        '../third_party/skia/src/utils/win/SkDWriteGeometrySink.cpp',
+        '../third_party/skia/src/utils/win/SkHRESULT.cpp',
+      ],
