+#if SK_SUPPORT_GPU
+DEF_GPUTEST_FOR_RENDERING_CONTEXTS(ImageEncode_Gpu, reporter, context) {
+    SkAutoTUnref<SkImage> image(create_gpu_image(context));
+    test_encode(reporter, image);
+}
