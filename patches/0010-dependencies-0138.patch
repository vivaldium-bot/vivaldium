+			templat.u.tex.first_layer = desc->Texture1DArray.FirstArraySlice;
+			templat.u.tex.last_layer = desc->Texture1DArray.FirstArraySlice + desc->Texture1DArray.ArraySize - 1;
+			break;
+		case D3D11_DSV_DIMENSION_TEXTURE2DMS:
