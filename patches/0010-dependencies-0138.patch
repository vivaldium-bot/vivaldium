+FX_FLOAT CFX_Edit::GetLineBottom(const CPVT_WordPlace& place) const {
+  CPDF_VariableText::Iterator* pIterator = m_pVT->GetIterator();
+  CPVT_WordPlace wpOld = pIterator->GetAt();
