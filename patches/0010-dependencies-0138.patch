+      }
+      CFX_ByteString bsRet = CFX_ByteString(pbuff, nActualLen);
+      CFX_WideString wsRet = CFX_WideString::FromUTF16LE(
+          (unsigned short*)bsRet.GetBuffer(bsRet.GetLength()),
+          bsRet.GetLength() / sizeof(unsigned short));
+      delete[] pbuff;
+      return wsRet;
+    }
+    return L"";
+  }
