+        ScrollToCaret();
+        CPVT_WordRange wr(m_wpOldCaret, GetVisibleWordRange().EndPos);
+        Refresh(RP_ANALYSE, &wr);
+        SetCaretOrigin();
+        SetCaretInfo();
