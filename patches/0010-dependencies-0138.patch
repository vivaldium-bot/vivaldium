+        SkPoint pts[3];
+        for (int j = 0; j < 3; ++j) {
+            pts[j].set(rand.nextSScalar1() * 100, rand.nextSScalar1() * 100);
+        }
+        for (int k = 0; k < 10; ++k) {
+            SkScalar w = rand.nextUScalar1() * 2;
+            SkConic conic(pts, w);
