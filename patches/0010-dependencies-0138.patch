+    if (m_wpCaret != m_wpOldCaret) {
+      m_SelState.SetEndPos(m_wpCaret);
+
+      ScrollToCaret();
+      CPVT_WordRange wr(m_wpOldCaret, m_wpCaret);
+      Refresh(RP_OPTIONAL, &wr);
+      SetCaretOrigin();
+      SetCaretInfo();
+    }
