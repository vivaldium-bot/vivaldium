+                  FXDIB_ALPHA_MERGE(FX_GAMMA(dest_scan[0]), b, src_alpha));
+            }
+            dest_scan += Bpp;
+            src_scan += 3;
+            for (int col = start_col + 1; col < end_col - 1; col++) {
+              int src_alpha = src_scan[1];
+              ADJUST_ALPHA(dest_scan[2], r, src_alpha, nativetext_flags, a);
+              src_alpha = src_alpha * a / 255;
