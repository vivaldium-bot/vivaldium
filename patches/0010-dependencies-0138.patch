+  WelsIDctRecI16x16DcAnchor (iRefDst, iRefDct);
+  WelsIDctRecI16x16Dc_c (iRec, FDEC_STRIDE, iPred, FDEC_STRIDE, iDct);
+  int ok = -1;
+  for (int i = 0; i < 16; i++) {
+    for (int j = 0; j < 16; j++) {
+      if (iRec[i * FDEC_STRIDE + j] != iRefDst[i * FDEC_STRIDE + j]) {
+        ok = i * 16 + j;
+        break;
+      }
