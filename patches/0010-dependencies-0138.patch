+
+    dict.reset(new SkPDFDict);
+    ASSERT_EMIT_EQ(reporter, *dict, "<<>>");
+
+    dict->insertInt("n1", 24);
+    ASSERT_EMIT_EQ(reporter, *dict, "<</n1 24>>");
+
+    dict->insertInt("n2", SkToSizeT(99));
+    ASSERT_EMIT_EQ(reporter, *dict, "<</n1 24\n/n2 99>>");
