+		D3D11_SUBRESOURCE_DATA buffersd;
+		buffersd.pSysMem = data;
+
+		ensure(dev->CreateBuffer(&bufferd, &buffersd, &buffer));
+		free(data);
+	}
+
+	~mesh()
+	{
+		layout->Release();
+		buffer->Release();
+	}
+
+	void bind(ID3D11DeviceContext* ctx)
+	{
+		unsigned offset = 0;
+		ctx->IASetPrimitiveTopology(topology);
+		ctx->IASetInputLayout(layout);
+		if(index_format)
