+FX_BOOL CJS_GlobalData::SetGlobalVariablePersistent(
+    const CFX_ByteString& propname,
+    FX_BOOL bPersistent) {
+  CFX_ByteString sPropName(propname);
+  if (!TrimPropName(&sPropName))
+    return FALSE;
+
+  CJS_GlobalData_Element* pData = GetGlobalVariable(sPropName);
