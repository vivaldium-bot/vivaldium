+   },
+   /*
+    * SVGA3D_BUFFER is a placeholder format for index/vertex buffers.
+    */
+   {
+      SVGA3D_Z_D24X8,
+      SVGA3D_DEVCAP_SURFACEFMT_Z_D24X8,
+      SVGA3DFORMAT_OP_ZSTENCIL |
