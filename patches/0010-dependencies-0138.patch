+  CFX_WideString& wChange = pEvent->Change();
+  if (vp.IsSetting()) {
+    if (vp.GetType() == CJS_Value::VT_string)
+      vp >> wChange;
+  } else {
+    vp << wChange;
+  }
+  return TRUE;
