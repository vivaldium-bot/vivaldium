+        if (nullptr == first.get()) {
+            continue;
+        }
+        for (int j = 0; j < 10; ++j) {
+            SkAutoTUnref<SkTypeface> face(SkTypeface::CreateFromName(inNames[i],
+                                                         SkTypeface::kNormal));
+    #if 0
