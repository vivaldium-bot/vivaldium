+            if (start_col > left) {
+              src_alpha = src_scan[-1];
+              ADJUST_ALPHA(dest_scan[1], g, src_alpha, nativetext_flags, a);
+              src_alpha = src_alpha * a / 255;
+              dest_scan[1] = FX_GAMMA_INVERSE(
