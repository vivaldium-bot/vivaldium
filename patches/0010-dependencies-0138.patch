@@ -0,0 +1,11 @@
+SUBDIRS=dxgi d3d10 d3d10_1 d3d11
+
+all:
+	@for dir in $(SUBDIRS) ; do $(MAKE) -C "$$dir" || exit $?; done
+
+clean:
+	rm -f `find . -name \*.[oa]`
+	rm -f `find . -name depend`
+
+install:
+	sudo install */*.dll.so /usr/lib/wine
diff --git a/third_party/mesa/src/src/gallium/state_trackers/d3d1x/winedlls/Makefile.wine b/third_party/mesa/src/src/gallium/state_trackers/d3d1x/winedlls/Makefile.wine
