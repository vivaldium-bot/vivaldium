+                str += sprintf(str, "    pathB.moveTo(%d,%d);\n", a, b);
+                str += sprintf(str, "    pathB.cubicTo(%d,%d, %d,%d, %d,%d);\n", c, d,
+                        state.fB, state.fA, state.fD, state.fC);
+                str += sprintf(str, "    pathB.close();\n");
