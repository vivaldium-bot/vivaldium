+
+void CPWL_SBButton::GetThisAppearanceStream(CFX_ByteTextBuf& sAppStream) {
+  CPWL_Wnd::GetThisAppearanceStream(sAppStream);
+
+  if (!IsVisible())
+    return;
+
+  CFX_ByteTextBuf sButton;
+
+  CFX_FloatRect rectWnd = GetWindowRect();
+
+  if (rectWnd.IsEmpty())
