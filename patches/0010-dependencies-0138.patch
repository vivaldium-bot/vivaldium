+  void RemoveAt(int32_t nIndex) {
+    if (nIndex >= 0 && nIndex < CFX_ArrayTemplate<TYPE>::GetSize())
+      CFX_ArrayTemplate<TYPE>::RemoveAt(nIndex);
+  }
+};
