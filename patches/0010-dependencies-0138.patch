+   rbug_shader_t *shdrs;
+   int i = 0;
+
+   pipe_mutex_lock(rb_screen->list_mutex);
+   rb_context = rbug_get_context_locked(rb_screen, list->context);
+
+   if (!rb_context) {
+      pipe_mutex_unlock(rb_screen->list_mutex);
