+        REPORTER_ASSERT(r, bm.getColor(0, 4) == 0xff808080);
+        REPORTER_ASSERT(r, bm.getColor(1, 4) == 0xff000000);
+        REPORTER_ASSERT(r, bm.getColor(2, 4) == 0xff00ff00);
