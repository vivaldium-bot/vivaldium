+        for (int b = a + 1; b < 7; ++b) {
+            for (int c = 0 ; c < 6; ++c) {
+                for (int d = 0; d < 2; ++d) {
+                    *testRunner.fRunnables.append() = new PathOpsThreadedRunnable(
+                            &testOpCirclesMain, a, b, c, d, &testRunner);
+                }
+            }
+            if (!reporter->allowExtendedTest()) goto finish;
+        }
+    }
+finish:
