+   */
+  protected ReadableFontData(ReadableFontData data, int offset, int length) {
+    super(data, offset, length);
+  }
+
+  /**
+   * Makes a slice of this FontData. The returned slice will share the data with
+   * the original <code>FontData</code>.
+   *
