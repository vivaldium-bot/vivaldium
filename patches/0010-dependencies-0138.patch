+     */
+    public Table.Builder<? extends Table> getTableBuilder(int tag) {
+      Table.Builder<? extends Table> builder = this.tableBuilders.get(tag);
+      return builder;
+    }
+
+    /**
+     * Creates a new empty table builder for the table type given by the table
