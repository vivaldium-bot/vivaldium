+  if (!m_pDocument->GetPermissions(FPDFPERM_EXTRACT_ACCESS))
+    return FALSE;
+
+  int nPageNo = params.size() > 0 ? params[0].ToInt() : 0;
+  CPDF_Document* pDocument = m_pDocument->GetPDFDocument();
+  CJS_Context* pContext = static_cast<CJS_Context*>(cc);
