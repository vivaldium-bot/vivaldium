+ *             -  pSrc,
+ *             -  pDst,
+ *             -  pTaps, or
+ *             -  pDelayLine.
+ *    -    len < 0
+ *    -    pTaps[order+1] < 0 (negative scaling)
+ *    -    order < 1
+ *
+ */
+OMXResult omxSP_IIR_Direct_S16 (
+    const OMX_S16 *pSrc,
+    OMX_S16 *pDst,
+    OMX_INT len,
+    const OMX_S16 *pTaps,
+    OMX_INT order,
+    OMX_S32 *pDelayLine
+);
