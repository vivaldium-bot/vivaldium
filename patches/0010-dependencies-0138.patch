+    public Table.Builder<? extends Table> newTableBuilder(int tag) {
+      Header header = new Header(tag);
+      Table.Builder<? extends Table> builder = Table.Builder.getBuilder(header, null);
+      this.tableBuilders.put(header.tag(), builder);
