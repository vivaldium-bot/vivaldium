diff --git a/third_party/skia/src/views/mac/SkEventNotifier.mm b/third_party/skia/src/views/mac/SkEventNotifier.mm
new file mode 100644
index 0000000000000000000000000000000000000000..0864380d95174df3f717cb09d3413891f3640df9
--- /dev/null
