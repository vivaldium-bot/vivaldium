+	virtual void STDMETHODCALLTYPE CSSetUnorderedAccessViews(
+		unsigned start,
+		unsigned count,
+		ID3D11UnorderedAccessView *const *new_unordered_access_views,
+		const unsigned *new_uav_initial_counts)
