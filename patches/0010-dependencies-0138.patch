+++ b/third_party/mesa/src/src/gallium/drivers/softpipe/sp_quad_fs.c
@@ -0,0 +1,179 @@
+/**************************************************************************
+ * 
+ * Copyright 2007 Tungsten Graphics, Inc., Cedar Park, Texas.
