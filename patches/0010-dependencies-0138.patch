+template <typename T>
+static void memsetT(T* dst, T val, int n) {
+    for (int i = 0; i < n; i++) { dst[i] = val; }
+}
+
+template <> void MemsetBench<uint32_t, true>::onDraw(int loops, SkCanvas*) {
