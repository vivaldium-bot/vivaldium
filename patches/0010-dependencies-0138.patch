+
+int si_context_init(struct r600_context *ctx)
+{
+	int r;
+
+	LIST_INITHEAD(&ctx->active_query_list);
+
+	ctx->cs = ctx->ws->cs_create(ctx->ws);
+
+	ctx->max_db = 8;
+	return 0;
+}
+
+
