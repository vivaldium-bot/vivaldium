+
+#include <fstream>
+#include "InputStream.h"
+
+class FileInputStream : public InputStream {
+ public:
+  bool Open (const char* fileName) {
+    file_.open (fileName, std::ios_base::in | std::ios_base::binary);
+    return file_.is_open();
