+    typedef Benchmark INHERITED;
+};
+
+///////////////////////////////////////////////////////////////////////////////
+
+class FixedMathBench : public Benchmark {
+    enum {
+        N = 1000,
+    };
+    float fData[N];
+    SkFixed fResult[N];
+public:
+
+    FixedMathBench()  {
+        SkRandom rand;
+        for (int i = 0; i < N; ++i) {
