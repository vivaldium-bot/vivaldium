+void CPWL_EditCtrl::IOnSetCaret(FX_BOOL bVisible,
+                                const CFX_FloatPoint& ptHead,
+                                const CFX_FloatPoint& ptFoot,
+                                const CPVT_WordPlace& place) {
+  PWL_CARET_INFO cInfo;
+  cInfo.bVisible = bVisible;
+  cInfo.ptHead = ptHead;
+  cInfo.ptFoot = ptFoot;
