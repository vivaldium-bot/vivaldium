+class FeatureMotionEstimateTest : public ::testing::Test {
+ public:
+  virtual void SetUp() {
+    m_pRefData = NULL;
+    m_pSrcBlock = NULL;
+    m_pMvdCostTable = NULL;
+
+    m_iWidth = 64;//size of search window
