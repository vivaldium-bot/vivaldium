+        if (verbose()) {
+            SkDebugf("dirNo=%d\n", dirNo);
+        }
+        state.fResult.fDirNo = dirNo;
+        if (!doOneDir(&state, false)) {
+            break;
+        }
+    }
+    encodeFound(state);
+}
