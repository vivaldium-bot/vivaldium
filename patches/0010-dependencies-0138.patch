index 0000000000000000000000000000000000000000..4406204b5129836b8d23457b02e4b109601e79d7
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/radeonsi/r600_blit.c
@@ -0,0 +1,399 @@
