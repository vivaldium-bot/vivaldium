+    Iterator<NameEntry> nameEntryIter = this.iterator(new NameEntryFilter() {
+      @Override
+      public boolean accept(int pid, int eid, int lid, int nid) {
+        if (pid == platformId && eid == encodingId && lid == languageId && nid == nameId) {
+          return true;
