+    SkTypeface* onCreateFromStream(SkStreamAsset* stream, int ttcIndex) const override {
+        AutoCFRelease<CGDataProviderRef> pr(SkCreateDataProviderFromStream(stream));
+        if (nullptr == pr) {
+            return nullptr;
