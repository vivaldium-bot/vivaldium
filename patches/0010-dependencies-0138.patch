+  CPDF_Document* pDoc = CPDFDocumentFromFPDFDocument(document);
+  if (!pDoc)
+    return nullptr;
+
+  CPDF_NameTree name_tree(pDoc, "Dests");
+  return name_tree.LookupNamedDest(pDoc, name);
+}
