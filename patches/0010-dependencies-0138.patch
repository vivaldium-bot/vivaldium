+DEF_TEST(SixtyOvalsOneOff, reporter) {
+    for (const OvalSetOneOff& oneOff : oneOffs) {
+        setupOne(reporter, oneOff.fCol, oneOff.fRow, oneOff.fRot, oneOff.fTrial);
+    }
+}
