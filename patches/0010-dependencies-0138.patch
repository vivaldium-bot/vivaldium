+	float3 _v = normalize(cross(s, _u));
+	float3 dc_dU = s * dot(dd, _u) + _u * d;
+	float3 dc_dV = s * dot(dd, _v) + _v * d;
+		
+	result.objnormal = normalize(cross(dc_dU, dc_dV));
+	result.worldnormal = mul(model, result.objnormal);
+	return result;
+}
