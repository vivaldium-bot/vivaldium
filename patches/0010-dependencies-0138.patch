+    {
+        SkAutoTUnref<SkData> data(ds.copyToData());
+        REPORTER_ASSERT(reporter, 100 * 26 == data->size());
+        REPORTER_ASSERT(reporter, memcmp(dst, data->data(), data->size()) == 0);
+    }
