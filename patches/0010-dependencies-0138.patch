+    return;
+
+  if (m_iDocType != DOCTYPE_DYNAMIC_XFA)
+    return;
+
+  CXFA_FFWidgetHandler* pWidgetHandler = m_pXFADocView->GetWidgetHandler();
+  if (!pWidgetHandler)
