+static void test_conic_eval_tan(skiatest::Reporter* reporter, const SkConic& conic, SkScalar t) {
+    SkVector v0, v1;
+    conic.evalAt(t, nullptr, &v0);
+    v1 = conic.evalTangentAt(t);
+    check_pairs(reporter, 0, t, "conic-tan", v0.fX, v0.fY, v1.fX, v1.fY);
+}
