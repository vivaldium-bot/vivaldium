+
+/**
+ * Runs a GM as a benchmark by repeatedly drawing the GM.
+ */
+class GMBench : public Benchmark {
+public:
+    // Constructor takes ownership of the GM param.
+    GMBench(skiagm::GM* gm);
+    virtual ~GMBench();
+
+protected:
