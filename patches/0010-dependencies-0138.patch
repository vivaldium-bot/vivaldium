+  if (!(condition)) {      \
+    abort();               \
+    NULL_DEREF_IF_POSSIBLE \
+  }
+
+#define NOTREACHED() assert(false)
+
+#endif  // PDFIUM_THIRD_PARTY_BASE_LOGGING_H_
