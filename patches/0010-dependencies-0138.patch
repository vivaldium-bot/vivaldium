index 0000000000000000000000000000000000000000..0ae0777e90190620013ca3b9e09a185aad4b5207
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/drivers/svga/svga_draw_arrays.c
@@ -0,0 +1,298 @@
+/**********************************************************
+ * Copyright 2008-2009 VMware, Inc.  All rights reserved.
+ *
