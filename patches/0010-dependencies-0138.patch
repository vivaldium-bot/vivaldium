+static void test_fontiter(skiatest::Reporter* reporter, bool verbose) {
+    SkAutoTUnref<SkFontMgr> fm(SkFontMgr::RefDefault());
+    int count = fm->countFamilies();
+
+    for (int i = 0; i < count; ++i) {
+        SkString fname;
