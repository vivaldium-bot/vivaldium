+
+  public static void main(String[] args) throws IOException {
+    SFLint dumper = new SFLint();
+    File fontFile = null;
+
+    for (int i = 0; i < args.length; i++) {
+      String option = null;
+      if (args[i].charAt(0) == '-') {
+        option = args[i].substring(1);
