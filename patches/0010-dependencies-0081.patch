index 0000000000000000000000000000000000000000..c09b1ac1e1aa77686780694e7f45c4ad59b7dc5d
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/bprint.h
@@ -0,0 +1,219 @@
+/*
