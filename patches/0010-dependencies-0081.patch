new file mode 100644
index 0000000000000000000000000000000000000000..8e59b74259e92a64ee4ef50914f98a5802eb6ac8
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/tests/movenc.c
@@ -0,0 +1,792 @@
