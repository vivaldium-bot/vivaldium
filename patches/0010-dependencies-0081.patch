diff --git a/third_party/ffmpeg/libavutil/atomic.c b/third_party/ffmpeg/libavutil/atomic.c
new file mode 100644
index 0000000000000000000000000000000000000000..64cff2576fd3032822e499ad2c8036935289714d
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/atomic.c
@@ -0,0 +1,109 @@
+/*
+ * Copyright (c) 2012 Ronald S. Bultje <rsbultje@gmail.com>
+ *
