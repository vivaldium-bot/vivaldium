--- /dev/null
+++ b/third_party/ffmpeg/libavformat/wvenc.c
@@ -0,0 +1,91 @@
+/*
+ * WavPack muxer
+ * Copyright (c) 2013 Konstantin Shishkov <kostya.shishkov@gmail.com>
+ * Copyright (c) 2012 Paul B Mahol
+ *
