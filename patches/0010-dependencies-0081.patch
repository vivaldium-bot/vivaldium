--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/dvbsub_parser.c
@@ -0,0 +1,186 @@
+/*
+ * DVB subtitle parser for FFmpeg
+ * Copyright (c) 2005 Ian Caulfield
+ *
