+static const MXFCodecUL *mxf_get_data_definition_ul(int type)
+{
+    const MXFCodecUL *uls = ff_mxf_data_definition_uls;
+    while (uls->uid[0]) {
+        if (type == uls->id)
+            break;
+        uls++;
+    }
+    return uls;
+}
