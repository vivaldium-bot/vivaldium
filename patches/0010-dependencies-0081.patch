index 0000000000000000000000000000000000000000..7a2ab3ef95d6309363b6db58141bc767cd427252
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/atrac3plusdec.c
@@ -0,0 +1,412 @@
+/*
+ * ATRAC3+ compatible decoder
+ *
+ * Copyright (c) 2010-2013 Maxim Poliakovski
+ *
