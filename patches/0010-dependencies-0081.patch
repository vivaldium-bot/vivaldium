--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/vc1dsp_neon.S
@@ -0,0 +1,1174 @@
+/*
+ * VC1 NEON optimisations
+ *
+ * Copyright (c) 2010 Rob Clark <rob@ti.com>
+ * Copyright (c) 2011 Mans Rullgard <mans@mansr.com>
