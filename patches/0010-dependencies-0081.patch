--- /dev/null
+++ b/third_party/ffmpeg/libavformat/tls_gnutls.c
@@ -0,0 +1,288 @@
+/*
+ * TLS/SSL Protocol
+ * Copyright (c) 2011 Martin Storsjo
+ *
