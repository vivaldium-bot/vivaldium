+{
+    av_buffer_unref(&f->qp_table_buf);
+
+    f->qp_table_buf = buf;
+
+FF_DISABLE_DEPRECATION_WARNINGS
+    f->qscale_table = buf->data;
+    f->qstride      = stride;
+    f->qscale_type  = qp_type;
+FF_ENABLE_DEPRECATION_WARNINGS
+
+    return 0;
+}
+
+int8_t *av_frame_get_qp_table(AVFrame *f, int *stride, int *type)
+{
+FF_DISABLE_DEPRECATION_WARNINGS
+    *stride = f->qstride;
+    *type   = f->qscale_type;
+FF_ENABLE_DEPRECATION_WARNINGS
+
+    if (!f->qp_table_buf)
