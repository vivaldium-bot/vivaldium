--- /dev/null
+++ b/third_party/ffmpeg/libavformat/soxenc.c
@@ -0,0 +1,122 @@
+/*
+ * SoX native format muxer
+ * Copyright (c) 2009 Daniel Verkamp <daniel@drv.nu>
+ *
+ * Based on libSoX sox-fmt.c
+ * Copyright (c) 2008 robs@users.sourceforge.net
