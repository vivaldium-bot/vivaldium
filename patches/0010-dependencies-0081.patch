index 0000000000000000000000000000000000000000..964026ec71fa5e87217b65294c6d65f89278a5e0
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/movenchint.c
@@ -0,0 +1,472 @@
+/*
+ * MOV, 3GP, MP4 muxer RTP hinting
+ * Copyright (c) 2010 Martin Storsjo
+ *
