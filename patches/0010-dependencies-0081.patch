index 0000000000000000000000000000000000000000..3178f2953ca6a73a8a641aca7995ab400af40b53
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/assdec.c
@@ -0,0 +1,83 @@
+/*
+ * SSA/ASS decoder
+ * Copyright (c) 2010  Aurelien Jacobs <aurel@gnuage.org>
+ *
+ * This file is part of FFmpeg.
