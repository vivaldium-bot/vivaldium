+    add  src1q, lenq
+    lea   dstq, [dstq+2*lenq]
+    neg   lenq
+.loop:
+    mova    m0, [src0q+lenq       ]
+    mova    m1, [src1q+lenq       ]
+    mova    m2, [src0q+lenq+mmsize]
+    mova    m3, [src1q+lenq+mmsize]
+    SBUTTERFLYPS 0, 1, 4
+    SBUTTERFLYPS 2, 3, 4
+    mova  [dstq+2*lenq+0*mmsize], m0
+    mova  [dstq+2*lenq+1*mmsize], m1
+    mova  [dstq+2*lenq+2*mmsize], m2
+    mova  [dstq+2*lenq+3*mmsize], m3
