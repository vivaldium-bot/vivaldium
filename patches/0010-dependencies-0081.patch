diff --git a/third_party/ffmpeg/libavcodec/arm/vp8_armv6.S b/third_party/ffmpeg/libavcodec/arm/vp8_armv6.S
new file mode 100644
index 0000000000000000000000000000000000000000..e7d25a45c1603873f135ef817c30771463d8c898
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/vp8_armv6.S
@@ -0,0 +1,248 @@
+/*
