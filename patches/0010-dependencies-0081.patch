index 0000000000000000000000000000000000000000..47445854c61b009b5787cb7e9cca7c8b7e5a2b8d
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/os_support.c
@@ -0,0 +1,304 @@
+/*
+ * various OS-feature replacement utilities
+ * Copyright (c) 2000, 2001, 2002 Fabrice Bellard
+ * copyright (c) 2002 Francois Revol
+ *
+ * This file is part of FFmpeg.
+ *
