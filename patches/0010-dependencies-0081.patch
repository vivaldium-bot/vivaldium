+++ b/third_party/ffmpeg/libavcodec/ffv1dec_template.c
@@ -0,0 +1,164 @@
+/*
+ * FFV1 decoder template
+ *
+ * Copyright (c) 2003-2016 Michael Niedermayer <michaelni@gmx.at>
