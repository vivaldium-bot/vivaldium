+typedef struct OGGPage {
+    int64_t start_granule;
+    int64_t granule;
+    int stream_index;
+    uint8_t flags;
+    uint8_t segments_count;
+    uint8_t segments[255];
+    uint8_t data[MAX_PAGE_SIZE];
+    uint16_t size;
+} OGGPage;
+
+typedef struct OGGStreamContext {
+    unsigned page_counter;
+    uint8_t *header[3];
+    int header_len[3];
+    /** for theora granule */
+    int kfgshift;
+    int64_t last_kf_pts;
+    int vrev;
