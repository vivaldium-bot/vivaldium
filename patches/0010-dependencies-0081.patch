--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rtmppkt.h
@@ -0,0 +1,330 @@
+/*
+ * RTMP packet utilities
+ * Copyright (c) 2009 Konstantin Shishkov
+ *
