+static int mov_read_ilst(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    int ret;
+    c->itunes_metadata = 1;
+    ret = mov_read_default(c, pb, atom);
+    c->itunes_metadata = 0;
+    return ret;
+}
