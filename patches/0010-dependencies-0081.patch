index 0000000000000000000000000000000000000000..2299c1cfc5978a4a84b58ee8a7e6acfe04067a46
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/h261_parser.c
@@ -0,0 +1,94 @@
+/*
+ * H.261 parser
+ * Copyright (c) 2002-2004 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (c) 2004 Maarten Daniels
+ *
+ * This file is part of FFmpeg.
