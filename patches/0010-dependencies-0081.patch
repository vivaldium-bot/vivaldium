+            h263_get_motion_length(x, f_code)
+           +h263_get_motion_length(y, f_code));
+    }else{
+        ff_h263_encode_motion(&s->pb, x, f_code);
+        ff_h263_encode_motion(&s->pb, y, f_code);
+    }
+}
