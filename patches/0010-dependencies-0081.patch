--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/frwu.c
@@ -0,0 +1,128 @@
+/*
+ * Forward Uncompressed
+ *
+ * Copyright (c) 2009 Reimar Döffinger <Reimar.Doeffinger@gmx.de>
+ *
+ * This file is part of FFmpeg.
+ *
