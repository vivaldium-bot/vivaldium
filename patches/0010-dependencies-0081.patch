--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/binkdsp.c
@@ -0,0 +1,157 @@
+/*
+ * Bink DSP routines
+ * Copyright (c) 2009 Konstantin Shishkov
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
