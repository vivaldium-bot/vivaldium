--- /dev/null
+++ b/third_party/ffmpeg/libavformat/smjpegdec.c
@@ -0,0 +1,185 @@
+/*
+ * SMJPEG demuxer
+ * Copyright (c) 2011 Paul B Mahol
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
