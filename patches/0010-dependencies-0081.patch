+  for (i = 0; i < sizeof(configs) / sizeof(*configs); i++) {
+    grpc_end2end_tests(argc, argv, configs[i]);
+  }
+
+  grpc_shutdown();
+
+  return 0;
+}
diff --git a/third_party/grpc/test/core/end2end/fixtures/proxy.c b/third_party/grpc/test/core/end2end/fixtures/proxy.c
