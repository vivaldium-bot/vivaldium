diff --git a/third_party/ffmpeg/libavcodec/h263dec.c b/third_party/ffmpeg/libavcodec/h263dec.c
new file mode 100644
index 0000000000000000000000000000000000000000..be16179c01fa8c59b879654fec99724f93976a8c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/h263dec.c
@@ -0,0 +1,765 @@
+/*
+ * H.263 decoder
+ * Copyright (c) 2001 Fabrice Bellard
+ * Copyright (c) 2002-2004 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
