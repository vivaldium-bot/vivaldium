+        b               .Lhf_apply_noise_0
+endfunc
+
+function ff_sbr_hf_apply_noise_3_neon, export=1
+        ldr             r12, [sp]
+        push            {r4,lr}
+        lsl             r12, r12, #31
+        eor             lr,  r12, #1<<31
+        vmov            d3,  lr, r12
+        b               .Lhf_apply_noise_1
+endfunc
diff --git a/third_party/ffmpeg/libavcodec/arm/simple_idct_arm.S b/third_party/ffmpeg/libavcodec/arm/simple_idct_arm.S
new file mode 100644
index 0000000000000000000000000000000000000000..42d79ab95e131548e3a55db404af523ad4d16ebf
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/simple_idct_arm.S
@@ -0,0 +1,480 @@
