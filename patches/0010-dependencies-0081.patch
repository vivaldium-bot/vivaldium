index 0000000000000000000000000000000000000000..c3e573c00a8ef1ddc670caaf6a8025943961c6f9
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/simple_idct_neon.S
@@ -0,0 +1,375 @@
+/*
+ * ARM NEON IDCT
+ *
+ * Copyright (c) 2008 Mans Rullgard <mans@mansr.com>
+ *
+ * Based on Simple IDCT
+ * Copyright (c) 2001 Michael Niedermayer <michaelni@gmx.at>
