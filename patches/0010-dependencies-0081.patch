diff --git a/third_party/glslang/src/SPIRV/SPVRemapper.cpp b/third_party/glslang/src/SPIRV/SPVRemapper.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..35dda17b7b8f2f62d76acb568bac968efcc47e6b
--- /dev/null
+++ b/third_party/glslang/src/SPIRV/SPVRemapper.cpp
@@ -0,0 +1,1232 @@
+//
+//Copyright (C) 2015 LunarG, Inc.
+//
+//All rights reserved.
+//
+//Redistribution and use in source and binary forms, with or without
+//modification, are permitted provided that the following conditions
