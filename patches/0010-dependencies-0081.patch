index 0000000000000000000000000000000000000000..c04d55c4230dcc85889785b023da58fd707e64d3
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/riffenc.c
@@ -0,0 +1,363 @@
+/*
+ * RIFF muxing functions
+ * Copyright (c) 2000 Fabrice Bellard
+ *
