index 0000000000000000000000000000000000000000..480557f49f78ead1fe9d641e953d51bcb3e32702
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/fft_template.c
@@ -0,0 +1,552 @@
+/*
+ * FFT/IFFT transforms
+ * Copyright (c) 2008 Loren Merritt
+ * Copyright (c) 2002 Fabrice Bellard
+ * Partly based on libdjbfft by D. J. Bernstein
