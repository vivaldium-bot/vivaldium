--- /dev/null
+++ b/third_party/ffmpeg/libavformat/riffdec.c
@@ -0,0 +1,299 @@
+/*
+ * RIFF demuxing functions and data
+ * Copyright (c) 2000 Fabrice Bellard
+ *
