--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mpegvideodec.c
@@ -0,0 +1,91 @@
+/*
+ * RAW MPEG video demuxer
+ * Copyright (c) 2002-2003 Fabrice Bellard
+ * Copyright (c) 2006 Michael Niedermayer <michaelni@gmx.at>
