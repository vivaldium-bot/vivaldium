+/**
+ * @file
+ * internal header for RIFF based (de)muxers
+ * do NOT include this in end user applications
+ */
+
+#ifndef AVFORMAT_RIFF_H
+#define AVFORMAT_RIFF_H
+
+#include "libavcodec/avcodec.h"
+#include "avio.h"
+#include "internal.h"
+#include "metadata.h"
+
