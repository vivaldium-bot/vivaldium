diff --git a/third_party/ffmpeg/libavformat/teeproto.c b/third_party/ffmpeg/libavformat/teeproto.c
new file mode 100644
index 0000000000000000000000000000000000000000..e532bc7750ee2dda6cb9fb6fd2a32bd982ae387e
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/teeproto.c
@@ -0,0 +1,147 @@
+/*
+ * Tee output protocol
+ * Copyright (c) 2016 Michael Niedermayer
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
