new file mode 100644
index 0000000000000000000000000000000000000000..497cf852116fd8dbdc9781377053752a65623ebb
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/subfile.c
@@ -0,0 +1,149 @@
+/*
+ * Copyright (c) 2014 Nicolas George
+ *
+ * This file is part of FFmpeg.
