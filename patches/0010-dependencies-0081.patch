new file mode 100644
index 0000000000000000000000000000000000000000..6edd146000271a56743bd9be0ff1db5a3924fd34
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mp3dec.c
@@ -0,0 +1,613 @@
