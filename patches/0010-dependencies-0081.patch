diff --git a/third_party/ffmpeg/libavcodec/h264idct_template.c b/third_party/ffmpeg/libavcodec/h264idct_template.c
new file mode 100644
index 0000000000000000000000000000000000000000..c62716090cd6ee681ed52a8c5b036ac95fa7ba19
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/h264idct_template.c
@@ -0,0 +1,324 @@
+/*
+ * H.264 IDCT
+ * Copyright (c) 2004-2011 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
