diff --git a/third_party/ffmpeg/libavformat/mxfdec.c b/third_party/ffmpeg/libavformat/mxfdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..118e3e40b44cf2610c2dc6c10182f0fe95e390a9
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mxfdec.c
@@ -0,0 +1,3381 @@
+/*
+ * MXF demuxer.
+ * Copyright (c) 2006 SmartJog S.A., Baptiste Coudurier <baptiste dot coudurier at smartjog dot com>
+ *
+ * This file is part of FFmpeg.
+ *
