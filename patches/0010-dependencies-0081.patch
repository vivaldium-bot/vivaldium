diff --git a/third_party/ffmpeg/libavcodec/arm/vp6dsp_neon.S b/third_party/ffmpeg/libavcodec/arm/vp6dsp_neon.S
new file mode 100644
index 0000000000000000000000000000000000000000..03dd28d1cbf59adac27b3c20c4deec76c496dfab
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/vp6dsp_neon.S
@@ -0,0 +1,121 @@
+/*
