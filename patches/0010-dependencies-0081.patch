diff --git a/third_party/ffmpeg/libavutil/hwcontext_d3d11va.c b/third_party/ffmpeg/libavutil/hwcontext_d3d11va.c
new file mode 100644
index 0000000000000000000000000000000000000000..52683b92cd742934fed701d7569664f6cd8af498
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/hwcontext_d3d11va.c
@@ -0,0 +1,568 @@
+/*
