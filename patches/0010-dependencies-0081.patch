diff --git a/third_party/ffmpeg/libavformat/rsodec.c b/third_party/ffmpeg/libavformat/rsodec.c
new file mode 100644
index 0000000000000000000000000000000000000000..b2d9a7c403ede477febbc6af6beb8e11e3467321
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rsodec.c
@@ -0,0 +1,83 @@
+/*
+ * RSO demuxer
+ * Copyright (c) 2001 Fabrice Bellard (original AU code)
+ * Copyright (c) 2010 Rafael Carre
