diff --git a/third_party/ffmpeg/libavformat/swfdec.c b/third_party/ffmpeg/libavformat/swfdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..57b619fb203d0810c5db874397b9bae1727de8a1
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/swfdec.c
@@ -0,0 +1,549 @@
+/*
+ * Flash Compatible Streaming Format demuxer
+ * Copyright (c) 2000 Fabrice Bellard
+ * Copyright (c) 2003 Tinic Uro
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
