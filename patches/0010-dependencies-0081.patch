index 0000000000000000000000000000000000000000..feeaf335a3d54b770006932d520ec11be9049dab
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/wavdec.c
@@ -0,0 +1,903 @@
+/*
+ * WAV demuxer
+ * Copyright (c) 2001, 2002 Fabrice Bellard
+ *
+ * Sony Wave64 demuxer
+ * RF64 demuxer
+ * Copyright (c) 2009 Daniel Verkamp
+ *
