+typedef struct H264ParseContext {
+    ParseContext pc;
+    H264ParamSets ps;
+    H264DSPContext h264dsp;
+    H264POCContext poc;
+    H264SEIContext sei;
+    int is_avc;
+    int nal_length_size;
+    int got_first;
+    int picture_structure;
+    uint8_t parse_history[6];
+    int parse_history_count;
+    int parse_last_mb;
+    int64_t reference_dts;
+    int last_frame_num, last_picture_structure;
+} H264ParseContext;
