+
+static const uint32_t table_18_vlc_bits[NB_VLC_TABLE_18] = {
+            0,       0x2,       0x7,      0x19,      0x30,      0x36,      0x6f,      0x63,
+         0x69,      0x6b,      0xd1,      0xd4,      0xdc,     0x189,     0x18a,     0x1a0,
