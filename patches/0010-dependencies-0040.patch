+    ];
+    var m = newModel(lines.join('\n'));
+    assert.isFalse(m.hasImportWarnings);
+
+    var threads = m.getAllThreads();
+    // there are 2 threads:
+    //   (1) "exynos_flip_state (pipe:0, fb:25)"
