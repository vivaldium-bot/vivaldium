+<link rel="import" href="/tracing/model/slice_group.html">
+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var Slice = tr.model.Slice;
+  var SliceGroup = tr.model.SliceGroup;
