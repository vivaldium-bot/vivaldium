+  TestUTF8UTF8("\x20\x20\xc3\xa7\xc2\x92\xc2\xb0"
+               "\xc3\xa5\xc2\xa2\xc2\x83\xc3\xa3"
+               "\xc2\x83\xc2\xbb\xc3\xa5\xc2\x85"
