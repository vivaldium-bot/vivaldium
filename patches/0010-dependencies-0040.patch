+
+      Body of text.
+      """,
+      """line o text
+
+      Body and comments on
+      more than one line.
+
+      Args:
+        moo: cow
+
+      Returns:
+        some value
+
+      Raises:
+        something else
+      """,
+      """Short summary.
+
+      Args:
+        fat: cat
+
+      Yields:
+        a spoon
+      """,
+  )
+
+  BAD_FUNC_DOCSTRINGS = (
+      """
+      bad first line
+      """,
+      """The first line is good
+      but the second one isn't
+      """,
+      """ whitespace is wrong""",
+      """whitespace is wrong	""",
+      """ whitespace is wrong
+
+      Multiline tickles differently.
+      """,
+      """Should be no trailing blank lines
+
+      Returns:
+        a value
+
+      """,
+      """ok line
+
+      cuddled end""",
+      """we want Args/Returns not Arguments/Return
+
+      Arguments:
+      Return:
+      """,
+      """section order is wrong here
+
+      Raises:
+      Returns:
+      """,
+      """sections lack whitespace between them
+
+      Args:
+        foo: bar
+      Returns:
+        yeah
+      """,
+      """yields is misspelled
+
+      Yield:
+        a car
+      """,
