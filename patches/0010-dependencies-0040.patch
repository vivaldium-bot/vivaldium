+{
+	m_gl.genProgramPipelines(1, &m_pipeline);
+	GLU_EXPECT_NO_ERROR(m_gl.getError(), "glGenProgramPipelines()");
+}
+
+ProgramPipeline::ProgramPipeline (const glw::Functions& gl)
+	: m_gl			(gl)
+	, m_pipeline	(0)
+{
+	m_gl.genProgramPipelines(1, &m_pipeline);
+	GLU_EXPECT_NO_ERROR(m_gl.getError(), "glGenProgramPipelines()");
+}
