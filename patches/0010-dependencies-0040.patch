+    _, _, patch = self._CommonGitSetup()
+    patch.project = constants.CHROMITE_PROJECT
+    self.assertTrue(trybot_patch_pool.ChromiteFilter(patch))
+    patch.project = 'foooo'
+    self.assertFalse(trybot_patch_pool.ChromiteFilter(patch))
