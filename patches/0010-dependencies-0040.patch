+          'exynos_page_flip_state: pipe=0, fb=25, state=wait_flip',
+      '     kworker/0:1-25931 [000] .... 1000.000007: ' +
+          'exynos_page_flip_state: pipe=0, fb=25, state=flipped'
+    ];
