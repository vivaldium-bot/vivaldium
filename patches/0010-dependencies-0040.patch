--- /dev/null
+++ b/third_party/deqp/src/framework/opengl/simplereference/sglrShaderProgram.cpp
@@ -0,0 +1,224 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
