+  if (count == 0) {count = 1;}    // adoid zdiv
+  int x_bar = x_sum / count;
+  int y_bar = y_sum / count;
+  printf("center %02X,%02X\n", x_bar, y_bar);
+
+  double closest_dist = 999.0;
+  int closest = 0;
+  for (int j = 0; j < destatep->rankedencoding_list_len; j++) {
