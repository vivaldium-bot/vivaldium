+		case GL_UNSIGNED_BYTE:	return rr::INDEXTYPE_UINT8;
+		case GL_UNSIGNED_SHORT:	return rr::INDEXTYPE_UINT16;
+		case GL_UNSIGNED_INT:	return rr::INDEXTYPE_UINT32;
+		default:
+			DE_ASSERT(false);
+			return rr::INDEXTYPE_LAST;
+	}
