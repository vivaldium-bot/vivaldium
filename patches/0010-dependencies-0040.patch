+    """Run the given config"""
+    try:
+      with cros_build_lib_unittest.RunCommandMock() as rc:
+        rc.SetDefaultCmdResult()
+        if mock_configurator:
+          mock_configurator(rc)
+        with self.OutputCapturer():
+          with cros_test_lib.LoggingCapturer():
+            self.RunStage()
