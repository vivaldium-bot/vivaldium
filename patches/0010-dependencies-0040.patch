+void ReferenceContext::drawArraysInstanced (deUint32 mode, int first, int count, int instanceCount)
+{
+	// Error conditions
+	{
+		RC_IF_ERROR(first < 0 || count < 0 || instanceCount < 0, GL_INVALID_VALUE, RC_RET_VOID);
+
+		if (!predrawErrorChecks(mode))
