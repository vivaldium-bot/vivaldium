+tcu::IVec2 GLContext::getReadOffset (void) const
+{
+	if (m_readFramebufferBinding)
+		return tcu::IVec2(0, 0);
+	else
+		return tcu::IVec2(m_baseViewport.x(), m_baseViewport.y());
+}
