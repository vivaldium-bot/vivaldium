+#import <UIKit/UIKit.h>
+
+#import "tcuIOSApp.h"
+
+@interface tcuIOSViewController : UIViewController {
+    BOOL			isIterating;
+    CADisplayLink*	displayLink;
+	tcuIOSApp*		app;
+}
+
+- (void)startTestIteration;
+- (void)stopTestIteration;
+
+@end
