+    // The last event will not be closed, so it's not a slice
+    assert.equal(gfxFbId25Thread.sliceGroup.length, 3);
+    assert.equal(gfxFbId26Thread.sliceGroup.length, 3);
+  });
+
+  test('exynosPageFlipFastRequestImport', function() {
