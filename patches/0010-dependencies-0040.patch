+#ifndef _TCUANDROIDRENDERACTIVITY_HPP
+#define _TCUANDROIDRENDERACTIVITY_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Tester Core
+ * ----------------------------------------
+ *
