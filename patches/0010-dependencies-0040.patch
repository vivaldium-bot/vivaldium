+	return de::getSizedArrayElement<GLSL_VERSION_LAST>(s_names, version);
+}
+
+const char* getGLSLVersionDeclaration (GLSLVersion version)
+{
+	static const char* s_decl[] =
+	{
+		"#version 100",
+		"#version 300 es",
+		"#version 310 es",
+		"#version 130",
