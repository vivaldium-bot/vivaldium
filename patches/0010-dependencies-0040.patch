+class _CustomObject(object):
+  """Simple object. For testing deepcopy."""
+
+  def __init__(self, x):
+    self.x = x
+
+  def __eq__(self, other):
+    return self.x == other.x
+
+
+class _CustomObjectWithSlots(object):
+  """Simple object with slots. For testing deepcopy."""
+
+  __slots__ = ['x']
+
+  def __init__(self, x):
+    self.x = x
+
+  def __eq__(self, other):
+    return self.x == other.x
