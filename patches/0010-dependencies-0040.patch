+ * \file
+ * \brief Image comparison utilities.
+ *//*--------------------------------------------------------------------*/
+
+#include "tcuImageCompare.hpp"
+#include "tcuSurface.hpp"
+#include "tcuFuzzyImageCompare.hpp"
+#include "tcuBilinearImageCompare.hpp"
+#include "tcuTestLog.hpp"
