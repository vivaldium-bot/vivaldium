+         for _ in range(lab_fail)])
+    messages.extend(
+        [GetFailedMessage([failures_lib.InfrastructureFailure()])
+         for _ in range(infra_fail)])
+    messages.extend(
+        [GetFailedMessage(Exception()) for _ in range(other_fail)])
+    return messages
