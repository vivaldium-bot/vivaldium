+typedef enum ProcessState_e
+{
+	PROCESSSTATE_NOT_STARTED = 0,
+	PROCESSSTATE_RUNNING,
+	PROCESSSTATE_FINISHED,
+
+	PROCESSSTATE_LAST
+} ProcessState;
+
+struct deProcess_s
+{
