+    alerts.SendEmailLog('mail', 'root@localhost')
+    self.assertEqual(send_mock.call_count, 1)
+
+  def testGmail(self):
+    """Gmail sanity check."""
+    send_mock = self.PatchObject(alerts.GmailServer, 'Send')
+    alerts.SendEmailLog('mail', 'root@localhost',
+                        server=alerts.GmailServer(token_cache_file='fakefile'))
+    self.assertEqual(send_mock.call_count, 1)
+
+
+def main(_argv):
