+
+	TextureFormatInfo (const Vec4& valueMin_, const Vec4& valueMax_, const Vec4& lookupScale_, const Vec4& lookupBias_)
+		: valueMin		(valueMin_)
+		, valueMax		(valueMax_)
+		, lookupScale	(lookupScale_)
+		, lookupBias	(lookupBias_)
