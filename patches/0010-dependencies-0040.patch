+                                  //  1xxxxxxx0xxxxxxx 1xxxxxxx1xxxxxx
+  int binary_8x4_count;           // Number of 8x4 buckets seen:
+  uint32 binary_quadrants_seen;   // Bit[i] set if bigram i.......i....... seen
+  uint32 binary_8x4_seen;         // Bit[i] set if bigram iii.....ii...... seen
