+			CommandLine			cmdLine;
+			std::ostringstream	err;
+			bool				parseOk	= parser.parse(DE_LENGTH_OF_ARRAY(args), &args[0], &cmdLine, err);
+
+			DE_TEST_ASSERT(!parseOk);
+			DE_TEST_ASSERT(!err.str().empty());
+		}
+
+		// Invalid int value
+		{
+			const char*			args[]	= { "--int", "1x" };
+			CommandLine			cmdLine;
+			std::ostringstream	err;
+			bool				parseOk	= parser.parse(DE_LENGTH_OF_ARRAY(args), &args[0], &cmdLine, err);
+
+			DE_TEST_ASSERT(!parseOk);
+			DE_TEST_ASSERT(!err.str().empty());
