+}
+
+deBool deProcess_closeStdErr (deProcess* process)
+{
+	if (process->standardErr)
+	{
+		deFile_destroy(process->standardErr);
+		process->standardErr = DE_NULL;
+		return DE_TRUE;
+	}
+	else
+		return DE_FALSE;
+}
+
+#else
+#	error Implement deProcess for your OS.
+#endif
