+@contextlib.contextmanager
+def TemporaryManifest():
+  with tempfile.NamedTemporaryFile() as f:
+    # Create fake but empty manifest file.
+    new_doc = minidom.getDOMImplementation().createDocument(
+        None, 'manifest', None)
+    print(new_doc.toxml())
+    new_doc.writexml(f)
+    f.flush()
+    yield f
