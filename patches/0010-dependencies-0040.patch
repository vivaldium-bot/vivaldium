+              'interp': None,
+              'libs': [],
+              'runpath': [],
+              'rpath': [],
+              'path': p,
+              'realpath': realpath,
+            }
+            _ActionCopy(options, elf)
+            continue
+        ret = 1
+        warn('%s: %s' % (p, e))
+        continue
+      except IOError as e:
+        ret = 1
+        warn('%s: %s' % (p, e))
+        continue
+
+      if options.dest is None:
+        _ActionShow(options, elf)
+      else:
+        _ActionCopy(options, elf)
+
+    if not matched:
+      ret = 1
+      warn('%s: did not match any paths' % (path,))
+
+  return ret
+
+
+if __name__ == '__main__':
+  sys.exit(main(sys.argv[1:]))
