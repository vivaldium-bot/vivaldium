+      'code-creation,LazyCompile,0,0x2905d0c0,1800,"InstantiateFunction native apinatives.js:26:29",0x56b19124,', // @suppress longLineCheck
+      'tick,0x7fd7f75c,518328,0,0x81d86da8,2,0x2904d6e8',
