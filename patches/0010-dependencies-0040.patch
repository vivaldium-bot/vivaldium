+
+	virtual void		onContentRectChanged		(const ARect* rect);
+	virtual void		onConfigurationChanged		(void);
+	virtual void		onLowMemory					(void);
+
+	ANativeActivity*	getNativeActivity			(void) { return m_activity; }
