+#ifndef _TCUFUNCTIONLIBRARY_HPP
+#define _TCUFUNCTIONLIBRARY_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Tester Core
+ * ----------------------------------------
+ *
