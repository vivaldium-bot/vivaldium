+      toolchain_overlay_tarball_args.append(['--toolchains-overlay-tarball',
+                                             tarball_arg])
+
+    # Fake out toolchain tarballs.
+    tarball_dir = os.path.join(self._buildroot, constants.DEFAULT_CHROOT_DIR,
