+  clearStepping() { %ClearStepping(); };
+
+  // Returns the resulting breakpoint id.
+  setBreakPoint(func, opt_line, opt_column, opt_condition) {
+    assertTrue(%IsFunction(func));
+    assertFalse(%FunctionIsAPIFunction(func));
