-    // 2: { "X": "a", "Y": "d" }
-    // 3: { "X": "b", "Y": "c" }
-    // 4: { "X": "b", "Y": "d" }
-    //
-    // and each will be sent to |func| with the corresponding prefixed
-    // id (modulo order).
