+  2: ('changes to rsp are not allowed', Instruction(0x2: 49 8d 24 07  lea (%r15,%rax,1),%rsp))
+----------------------------------------------------------------------
+@hex:
+  89 c0
+  4a 8d 24 38
+@dis:
+     0:	89 c0                                        	mov    %eax,%eax
+     2:	4a 8d 24 38                                  	lea    (%rax,%r15,1),%rsp
