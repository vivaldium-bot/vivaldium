+@hex:
+  8d 65 00 \\
+  4c 01 fc
+@dis:
+     0:	8d 65 00                                     	lea    0x0(%rbp),%esp
+     3:	4c 01 fc                                     	add    %r15,%rsp
+@rdfa_output:
+  return code: 0
