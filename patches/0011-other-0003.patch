+  TSREQ_PTHREAD_RWLOCK_UNLOCK_PRE,
+  TSREQ_PTHREAD_SPIN_LOCK_INIT_OR_UNLOCK,
+  TSREQ_POSIX_SEM_INIT_POST,
+  TSREQ_POSIX_SEM_DESTROY_PRE,
+  TSREQ_SIGNAL,
+  TSREQ_WAIT,
+  TSREQ_CYCLIC_BARRIER_INIT,
