+class TestLegacyPrefixes(unittest.TestCase):
+
+  def test_empty(self):
+    self.assertEquals(
+        gen_dfa.GenerateLegacyPrefixes(64, [], []),
+        [()])
+
+  def test_one(self):
+    self.assertEquals(
+        gen_dfa.GenerateLegacyPrefixes(64, ['req'], []),
+        [('req',)])
+    self.assertEquals(
+        set(gen_dfa.GenerateLegacyPrefixes(64, [], ['opt'])),
+        set([
+            (),
+            ('opt',)]))
+
+  def test_many(self):
+    self.assertEquals(
+        set(gen_dfa.GenerateLegacyPrefixes(64, ['req'], ['opt1', 'opt2'])),
+        set([
+            ('req',),
+            ('opt1', 'req'),
+            ('opt2', 'req'),
+            ('req', 'opt1'),
+            ('req', 'opt2'),
+            ('opt1', 'opt2', 'req'),
+            ('opt1', 'req', 'opt2'),
+            ('opt2', 'opt1', 'req'),
+            ('opt2', 'req', 'opt1'),
+            ('req', 'opt1', 'opt2'),
+            ('req', 'opt2', 'opt1')]))
+
