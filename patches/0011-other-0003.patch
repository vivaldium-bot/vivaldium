+    sdk_base = os.path.join(root, archdir[env['TARGET_FULLARCH']] + '_bc-nacl')
+  if env.Bit('nacl_pic'):
+    pnacl_cc_flags += ' -fPIC'
+    pnacl_cxx_flags += ' -fPIC'
