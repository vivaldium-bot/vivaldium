+          '<(DEPTH)/testing/gtest/include',
+        ],
+        'cflags_cc!': [
+          '-fno-rtti',
+          '-Wno-missing-field-initializers'
+        ],
+        'cflags!': [
+          '-pedantic',
+          '-Wswitch-enum',
+          '-Wno-missing-field-initializers'
+        ],
+        'xcode_settings': {
+          'WARNING_CFLAGS!': [
+            '-pedantic',
+            '-Wswitch-enum'
+          ]
+        },
+        'sources': [
+          '<(DEPTH)/testing/gtest/src/gtest-all.cc',
+        ],
+        'conditions': [
+          ['OS=="mac"', {
+            'xcode_settings': {
