+#  define  NACL___PRIdS_PREFIX "I64"
+#  define  NACL___PRIuS_PREFIX "I64"
+# else
+#  define  NACL___PRIdS_PREFIX
+#  define  NACL___PRIuS_PREFIX
+# endif
+#elif NACL_OSX
