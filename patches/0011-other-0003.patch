+     8:	41 8b 1c 3f                                  	mov    (%r15,%rdi,1),%ebx
+@rdfa_output:
+  8: improper memory address - bad index
+  return code: 1
+@spec:
+  8: register %rdi should be restricted, while in fact None is restricted
+----------------------------------------------------------------------
+@hex:
