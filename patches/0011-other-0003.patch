+/*
+ * NaCl Service Runtime.  I/O Descriptor / Handle abstraction.
+ */
+
+#ifndef NATIVE_CLIENT_SRC_TRUSTED_DESC_NACL_DESC_BASE_H_
+#define NATIVE_CLIENT_SRC_TRUSTED_DESC_NACL_DESC_BASE_H_
+
+#include <limits.h>
+#include <sys/types.h>
+#include <sys/stat.h>
