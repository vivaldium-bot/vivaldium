+int NaClProtMap(int abi_prot) {
+  int host_os_prot;
+
+  host_os_prot = 0;
+#define M(H) do { \
+    if (0 != (abi_prot & NACL_ABI_ ## H)) { \
+      host_os_prot |= H; \
+    } \
+  } while (0)
+  M(PROT_READ);
+  M(PROT_WRITE);
+  M(PROT_EXEC);
+#if PROT_NONE != 0
+# error "NaClProtMap:  PROT_NONE is not zero -- are mprotect flags bit values?"
+#endif
+  return host_os_prot;
+#undef M
+}
