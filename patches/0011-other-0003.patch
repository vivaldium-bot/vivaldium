+
+#define GLOBAL_SYM(name) .global IDENTIFIER(name); IDENTIFIER(name):
+
+.data
+
+#if NACL_BUILD_SUBARCH == 32
+
+GLOBAL_SYM(no_rewrite_code)
+    movntq %mm0, (%ebx)
+GLOBAL_SYM(no_rewrite_code_end)
