+static int NaClHostDescCtor(struct NaClHostDesc  *d,
+                            int fd,
+                            int flags) {
+  NaClHostDescInit();
+  d->d = fd;
+  d->flags = flags;
+  NaClLog(3, "NaClHostDescCtor: success.\n");
+  return 0;
+}
