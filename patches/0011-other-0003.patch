+@hex:
+  87 25 00 00 00 00
+  4c 01 fc
+@dis:
+     0:	87 25 00 00 00 00                            	xchg   %esp,0x0(%rip)        # 0x6
+     6:	4c 01 fc                                     	add    %r15,%rsp
+@rdfa_output:
