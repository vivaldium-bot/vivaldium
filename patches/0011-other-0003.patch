diff --git a/native_client/src/trusted/validator_ragel/testdata/64/xchg_zero_ext.test b/native_client/src/trusted/validator_ragel/testdata/64/xchg_zero_ext.test
new file mode 100644
index 0000000000000000000000000000000000000000..5752e80ac67b84ff31c9c0eeda923a32058b4608
--- /dev/null
+++ b/native_client/src/trusted/validator_ragel/testdata/64/xchg_zero_ext.test
@@ -0,0 +1,40 @@
+@hex:
+  # Since we can only track one restricted register at a time,
+  # first operand of xchg is not considered zero-extended.
+  87 d9 \\
+  41 8a 04 1f
+@dis:
+     0:	87 d9                                        	xchg   %ebx,%ecx
+     2:	41 8a 04 1f                                  	mov    (%r15,%rbx,1),%al
+@rdfa_output:
+  2: improper memory address - bad index
+  return code: 1
+@spec:
+  2: register %rbx should be restricted, while in fact '%rcx' is restricted
+----------------------------------------------------------------------
+@hex:
+  # Second operand is zero-extended fine.
+  87 d9 \\
+  41 8a 04 0f
+@dis:
+     0:	87 d9                                        	xchg   %ebx,%ecx
+     2:	41 8a 04 0f                                  	mov    (%r15,%rcx,1),%al
+@rdfa_output:
+  return code: 0
+@spec:
+  SAFE
+----------------------------------------------------------------------
+@hex:
+  # But we can't just ignore first operand: if it's rsp or rbp, that would
+  # break sandboxing.
+  87 e9 \\
+  41 8a 04 0f
+@dis:
