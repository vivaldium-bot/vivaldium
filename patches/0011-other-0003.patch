+  31 ec \\
+  4a 8d 24 3c
+@dis:
+     0:	31 ec                                        	xor    %ebp,%esp
+     2:	4a 8d 24 3c                                  	lea    (%rsp,%r15,1),%rsp
+@rdfa_output:
+  return code: 0
+@spec:
+  SAFE
+----------------------------------------------------------------------
+@hex:
+  31 e5 \\
+  4a 8d 6c 3d 00
+@dis:
+     0:	31 e5                                        	xor    %esp,%ebp
+     2:	4a 8d 6c 3d 00                               	lea    0x0(%rbp,%r15,1),%rbp
+@rdfa_output:
+  return code: 0
+@spec:
+  SAFE
+----------------------------------------------------------------------
+@hex:
+  89 c0
+  49 8d 24 07
+@dis:
+     0:	89 c0                                        	mov    %eax,%eax
+     2:	49 8d 24 07                                  	lea    (%r15,%rax,1),%rsp
+@rdfa_output:
