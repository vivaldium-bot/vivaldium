new file mode 100644
index 0000000000000000000000000000000000000000..fda9868a8a66ba497676e8543bf0b86be6c59e6d
--- /dev/null
+++ b/native_client/src/shared/imc/win/nacl_imc.cc
@@ -0,0 +1,602 @@
+/*
