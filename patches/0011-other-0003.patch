+
+int irt_clear_cache(void *addr, size_t size) {
+  /*
+   * The third argument of cacheflush is just ignored for now and should
+   * always be zero.
+   */
+  int result = linux_syscall3(__NR_ARM_cacheflush,
+                              (uint32_t) addr,
+                              (uintptr_t) addr + size,
