+static const AnnotatedInstruction examples_of_invalid_masks[] = {
+  { 0x01A01003, "mov r1, r3: not even a mask" },
+  { 0x03C31000, "bic r1, r3, #0: doesn't mask anything" },
+  { 0x03C31102, "bic r1, r3, #0x80000000: doesn't mask enough bits" },
