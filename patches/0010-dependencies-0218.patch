+  void UnregisterChannel(WebRtcVoiceMediaChannel* channel);
+
+  VoEWrapper* voe() { return voe_wrapper_.get(); }
+  int GetLastEngineError();
+
+  // Starts AEC dump using an existing file. A maximum file size in bytes can be
