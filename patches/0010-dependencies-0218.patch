+  auto states = CreateControllerManager();
+  // |network_metrics| are empty, and the controllers are supposed to follow the
+  // default order.
+  CheckControllersOrder(&states, rtc::Optional<int>(), rtc::Optional<float>(),
+                        {0, 1, 2, 3});
+}
