+                                                          available_bitrate);
+  EXPECT_EQ(min_audio_bitrate + even_bitrate_increase, allocations[0]);
+  EXPECT_EQ(min_video_bitrate + even_bitrate_increase, allocations[1]);
+  EXPECT_EQ(min_other_bitrate + even_bitrate_increase, allocations[2]);
+}
