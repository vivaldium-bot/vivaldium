index 0000000000000000000000000000000000000000..199979f61be71e737f8d21f4f9b11cc06492fb29
--- /dev/null
+++ b/third_party/webrtc/examples/androidapp/src/org/appspot/apprtc/DirectRTCClient.java
@@ -0,0 +1,347 @@
+/*
+ *  Copyright 2016 The WebRTC Project Authors. All rights reserved.
+ *
