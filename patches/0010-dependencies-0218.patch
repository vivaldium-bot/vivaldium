+void VideoSender::OnNetworkChanged(uint32_t target_bitrate_bps,
+                                   uint8_t fraction_lost,
+                                   int64_t rtt) {
+  source_->SetBitrateBps(target_bitrate_bps);
+  RecordBitrate();
+}
