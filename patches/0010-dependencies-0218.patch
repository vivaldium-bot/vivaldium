+  EXPECT_EQ(2u, factory.supported_codecs().size());
+  EXPECT_EQ("H264", factory.supported_codecs()[0].name);
+  EXPECT_EQ("VP8", factory.supported_codecs()[1].name);
+
+  // The codec list doesn't grow when called repeatedly.
+  EXPECT_EQ(2u, factory.supported_codecs().size());
+}
