+
+class RTCTestStats1 : public RTCStats {
+ public:
+  WEBRTC_RTCSTATS_DECL();
+
+  RTCTestStats1(const std::string& id, int64_t timestamp_us)
+      : RTCStats(id, timestamp_us),
+        integer("integer") {}
+
+  RTCStatsMember<int32_t> integer;
+};
