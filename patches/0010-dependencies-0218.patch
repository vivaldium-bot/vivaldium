+TEST(ApmHelpersTest, EcMetrics_NoStatsUnlessEcMetricsAndEcEnabled) {
+  TestHelper helper;
+  EXPECT_FALSE(helper.CanGetEcMetrics());
+
+  apm_helpers::SetEcMetricsStatus(helper.apm(), true);
+  EXPECT_FALSE(helper.CanGetEcMetrics());
+
+  apm_helpers::SetEcStatus(helper.apm(), true, kEcConference);
