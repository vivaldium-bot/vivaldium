+class DataEngineInterface {
+ public:
+  virtual ~DataEngineInterface() {}
+  virtual DataMediaChannel* CreateChannel(const MediaConfig& config) = 0;
+  virtual const std::vector<DataCodec>& data_codecs() = 0;
+};
