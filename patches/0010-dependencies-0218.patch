+      : owner_(owner) {
+  }
+  ~RtcpBandwidthObserverImpl() override = default;
+  // Received RTCP REMB or TMMBR.
+  void OnReceivedEstimatedBitrate(uint32_t bitrate) override {
+    owner_->OnReceivedEstimatedBitrate(bitrate);
