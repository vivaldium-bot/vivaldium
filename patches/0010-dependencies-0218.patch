+int32_t FakeEncoder::SetRateAllocation(const BitrateAllocation& rate_allocation,
+                                       uint32_t framerate) {
+  rtc::CritScope cs(&crit_sect_);
+  target_bitrate_ = rate_allocation;
+  configured_input_framerate_ = framerate;
+  return 0;
+}
