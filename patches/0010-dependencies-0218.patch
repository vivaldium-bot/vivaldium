+  EXPECT_EQ(clock_.TimeInMilliseconds() - capture_time_ms,
+            send_bucket_->QueueInMs());
+
+  // Fails to send second packet.
+  EXPECT_CALL(callback_, TimeToSendPacket(ssrc, sequence_number,
+                                          capture_time_ms, false, _))
