+std::unique_ptr<FrameGenerator> FrameGenerator::CreateFromYuvFile(
+    std::vector<std::string> filenames,
+    size_t width,
+    size_t height,
+    int frame_repeat_count) {
+  RTC_DCHECK(!filenames.empty());
