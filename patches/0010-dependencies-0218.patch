+
+  RTC_CHECK(rtc::InitializeSSL()) << "Failed to InitializeSSL()";
+  LoadGlobalClassReferenceHolder();
+  unity_plugin::LoadGlobalClassReferenceHolder();
+
+  return ret;
+}
