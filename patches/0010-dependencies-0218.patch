index 0000000000000000000000000000000000000000..2da8164ec73e8008199f74be37c7df2138fbbdc1
--- /dev/null
+++ b/third_party/webrtc/examples/androidjunit/src/org/appspot/apprtc/DirectRTCClientTest.java
@@ -0,0 +1,155 @@
+/*
