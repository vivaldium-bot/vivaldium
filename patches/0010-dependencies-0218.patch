+bool EventLogAnalyzer::IsRtxSsrc(StreamId stream_id) const {
+  return rtx_ssrcs_.count(stream_id) == 1;
+}
+
+bool EventLogAnalyzer::IsVideoSsrc(StreamId stream_id) const {
+  return video_ssrcs_.count(stream_id) == 1;
