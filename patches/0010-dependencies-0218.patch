diff --git a/third_party/webrtc/system_wrappers/source/aligned_array_unittest.cc b/third_party/webrtc/system_wrappers/source/aligned_array_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e5a3c18fcc6a2e8ae1895b38f597c49fcd61622a
--- /dev/null
