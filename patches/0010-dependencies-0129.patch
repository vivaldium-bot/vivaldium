diff --git a/third_party/mesa/src/src/gbm/main/gbmint.h b/third_party/mesa/src/src/gbm/main/gbmint.h
new file mode 100644
index 0000000000000000000000000000000000000000..a467beaed2067448723ec3317b62bb7c2e5d4857
--- /dev/null
+++ b/third_party/mesa/src/src/gbm/main/gbmint.h
@@ -0,0 +1,116 @@
+/*
