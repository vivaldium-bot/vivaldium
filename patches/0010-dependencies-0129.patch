+}
+void SkAndroidSDKCanvas::onDrawVertices(VertexMode vMode,
+                                                 int vertexCount,
+                                                 const SkPoint vertices[],
+                    const SkPoint texs[], const SkColor colors[], SkXfermode* xMode,
+                    const uint16_t indices[], int indexCount,
+                    const SkPaint& paint) {
+    FILTER(paint);
