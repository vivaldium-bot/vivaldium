+static double testOneFailure(const CubicLineFailures& failure) {
+    const SkDCubic& cubic = failure.c;
+    const SkDPoint& pt = failure.p;
+    double A, B, C, D;
+    SkDCubic::Coefficients(&cubic[0].fY, &A, &B, &C, &D);
