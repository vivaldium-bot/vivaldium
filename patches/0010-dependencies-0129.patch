+  if (pChild == NULL || iCount < 1) {
+    return NULL;
+  }
+  CFX_DSPATemplate<FX_WORD> search;
+  int32_t index = search.Lookup(eChild, pChild, iCount);
+  if (index < 0) {
+    return NULL;
+  }
+  const XFA_ELEMENTINFO* pInfo = XFA_GetElementByID(eChild);
+  ASSERT(pInfo);
+  if (dwPacket == XFA_XDPPACKET_UNKNOWN)
