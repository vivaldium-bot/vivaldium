+            if (newT >= 0) {
+                diff = fabs(t - newT);
+                break;
+            }
+            step *= 1.5;
+            SK_ALWAYSBREAK(step < 1);
+        } while (true);
+        worstStep[largeBits] = SkTMax(worstStep[largeBits], diff);
+#if 0
+        {
+            cubic.dump();
