+    sar r0, 8
+    imul r0, r0
+    mov r1, SQR_CUR
+    sar r1, 8
+    sub r1, r0
+    mov [r4+2], r1w                               ; to store uiTextureIndex
+
+    POP_XMM
+    LOAD_5_PARA_POP
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+
