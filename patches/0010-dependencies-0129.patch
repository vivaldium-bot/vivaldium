+                                           const CFX_ByteStringC& szName);
+  static void SetUpDynPropHandler(CFXJSE_Context* pContext,
+                                  CFXJSE_Value* pValue,
+                                  const FXJSE_CLASS* lpClassDefinition);
+  static void SetUpNamedPropHandler(
+      v8::Isolate* pIsolate,
+      v8::Local<v8::ObjectTemplate>& hObjectTemplate,
