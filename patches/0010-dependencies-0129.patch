+                                           int32_t height,
+                                           int32_t width,
+                                           int32_t startRow,
+                                           int32_t startColumn,
+                                           int32_t* pattern,
+                                           int32_t patternLength);
+  static CFX_Int32Array* findGuardPattern(CBC_CommonBitMatrix* matrix,
+                                          int32_t column,
