+{
+   return (struct gbm_dri_surface *) surface;
+}
+
+char *
+dri_fd_get_driver_name(int fd);
+
+#endif
diff --git a/third_party/mesa/src/src/gbm/main/backend.c b/third_party/mesa/src/src/gbm/main/backend.c
