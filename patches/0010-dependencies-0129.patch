+  if (CXFA_Margin mgWidget = m_pDataAcc->GetMargin()) {
+    XFA_RectWidthoutMargin(rect, mgWidget);
+  }
+  CFX_Matrix mtRotate;
+  GetRotateMatrix(mtRotate);
+  if (pMatrix) {
+    mtRotate.Concat(*pMatrix);
+  }
+  DrawBorder(pGS, rtObj, rect, &mtRotate);
+}
