+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    paddd xmm7,           xmm6
+    movd  [r6+8], xmm6
+    psrldq        xmm6,           8
+    movd  [r6+12],        xmm6
+
+    add           r6,     16
+    sub           r0,     r12
+    sub           r1,     r12
+    add           r0,     16
+    add           r1,     16
+
+    dec           r13
+    jnz           width_loop
+
+    pop           r1
+    pop           r0
+    add           r0,     r12
+    add           r1,     r12
+
+    dec   r3
+    jnz           height_loop
+
+    ;mov          r13,    [psadframe]
+    movdqa        xmm5,   xmm7
+    psrldq        xmm7,   8
+    paddd xmm7,   xmm5
+    movd  [psadframe],    xmm7
