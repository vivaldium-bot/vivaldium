+FX_BOOL CXFA_FFTextEdit::GetSuggestWords(
+    CFX_PointF pointf,
+    std::vector<CFX_ByteString>& sSuggest) {
+  if (m_pDataAcc->GetUIType() != XFA_ELEMENT_TextEdit) {
