+  static int32_t MAX_PIXEL_DRIFT;
+  static int32_t MAX_PATTERN_DRIFT;
+  static int32_t SKIPPED_ROW_COUNT_MAX;
+  static int32_t ROW_STEP;
+  static int32_t BARCODE_MIN_HEIGHT;
