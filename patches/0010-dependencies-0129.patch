+static void test_no_key(skiatest::Reporter* reporter) {
+    Mock mock(10, 30000);
+    GrContext* context = mock.context();
+    GrResourceCache* cache = mock.cache();
+
+    // Create a bunch of resources with no keys
+    TestResource* a = new TestResource(context->getGpu());
