+CXFA_Node::~CXFA_Node() {
+  FXSYS_assert(m_pParent == NULL);
+  RemoveMapModuleKey();
+  CXFA_Node *pNext, *pNode = m_pChild;
+  while (pNode) {
+    pNext = pNode->m_pNext;
+    pNode->m_pParent = NULL;
+    delete pNode;
+    pNode = pNext;
+  }
+  if (m_pXMLNode && HasFlag(XFA_NODEFLAG_OwnXMLNode)) {
+    m_pXMLNode->Release();
+  }
