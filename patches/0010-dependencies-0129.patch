+    if (pInstanceMgr) {
+      FXJSE_Value_Set(
+          hValue,
+          m_pDocument->GetScriptContext()->GetJSValueFromMap(pInstanceMgr));
+    } else {
+      FXJSE_Value_SetNull(hValue);
