+                }
+            }
+            if (!reporter->allowExtendedTest()) goto finish;
+        }
+    }
+finish:
+    testRunner.render();
+    ShowTestArray("loopOp");
+}
diff --git a/third_party/skia/tests/PathOpsOpRectThreadedTest.cpp b/third_party/skia/tests/PathOpsOpRectThreadedTest.cpp
