+def get_sublang_name_for_lang( lang_value, sublang_value ):
+    lang_name = LANG.get(lang_value, '*unknown*')
+    for sublang_name in SUBLANG.get(sublang_value, list()):
+        # if the main language is a substring of sublang's name, then
+        # return that
