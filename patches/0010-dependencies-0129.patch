--- /dev/null
+++ b/third_party/mesa/src/src/glsl/builtins/ir/asin.ir
@@ -0,0 +1,109 @@
+((function asin
+   (signature float
+     (parameters
+       (declare (in) float x))
+     ((return (expression float *
+	       (expression float sign (var_ref x))
+	       (expression float -
+		(constant float (1.5707964))
+		(expression float *
+		 (expression float sqrt
+		  (expression float -
+		   (constant float (1.0))
+		   (expression float abs (var_ref x))))
+		 (expression float +
+		  (constant float (1.5707964))
+		  (expression float *
+		   (expression float abs (var_ref x))
+		   (expression float +
+		    (constant float (-0.21460183))
+		    (expression float *
+		     (expression float abs (var_ref x))
+                     (expression float +
+                      (constant float (0.086566724))
+                      (expression float *
