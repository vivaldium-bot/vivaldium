+{
+   /* just pick a i945 hw id */
+   *device_id = 0x27A2;
+}
+
+static void
+i915_sw_destroy(struct i915_winsys *iws)
+{
+   struct i915_sw_winsys *isws = i915_sw_winsys(iws);
+   FREE(isws);
+}
