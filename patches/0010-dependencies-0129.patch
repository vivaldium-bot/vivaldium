+                     RuntimeDisposeCallback lpfnDisposeCallback);
+  void RemoveAllRuntimes(RuntimeDisposeCallback lpfnDisposeCallback);
+
+ protected:
+  CFX_ArrayTemplate<v8::Isolate*> m_RuntimeList;
+};
