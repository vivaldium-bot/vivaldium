+        nExponent = nExponent * 10 + str[cc] - '0';
+        cc++;
+      }
+      nExponent = bExpSign ? -nExponent : nExponent;
+    }
+    FX_DOUBLE dValue = (dwFractional / 4294967296.0);
+    dValue = nIntegral + (nIntegral >= 0 ? dValue : -dValue);
