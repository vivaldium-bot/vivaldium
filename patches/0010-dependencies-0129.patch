+    push r13
+    %assign push_num 2
+    LOAD_7_PARA
+    PUSH_XMM 8
+    SIGN_EXTENSION r2,r2d
+    SIGN_EXTENSION r3,r3d
+    SIGN_EXTENSION r4,r4d
+
+    mov   r12,r4
+    shr           r2,     4                                       ; iPicWidth/16
+    shr           r3,     4                                       ; iPicHeight/16
+
+    shl           r12,    4                                                               ; iPicStride*16
+    pxor  xmm0,   xmm0
+    pxor  xmm7,   xmm7            ; iFrameSad
+height_loop:
+    mov           r13,    r2
+    push  r0
+    push  r1
+width_loop:
+    pxor  xmm6,   xmm6
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    WELS_SAD_16x2_SSE2 r0,r1,r4
+    paddd xmm7,           xmm6
+    movd  [r6],           xmm6
+    psrldq        xmm6,           8
+    movd  [r6+4], xmm6
