diff --git a/third_party/stp/src/tests/query-files/unit_test/unit_test.sh b/third_party/stp/src/tests/query-files/unit_test/unit_test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..16c7c0fe077deace2ffdae9b9f980047f43b48be
--- /dev/null
+++ b/third_party/stp/src/tests/query-files/unit_test/unit_test.sh
@@ -0,0 +1,20 @@
+#!/bin/bash     
+
+#Each input should be simplified down to either true or false.
+#We no longer generate a CNF for trivially true/false instances,
+#so there should be no CNF generated for these.
+
+
+rm -f output_*.cnf
+
+files=`ls -1 -S *.smt2 *.smt`
+for f in $files; do
+	stp --output-CNF $f
+	#cnf=`cat output_*.cnf  | grep -v "^c" | grep -v "^$" |  wc -l`
+	if [ -e output_0.cnf ] ; then
+		echo --fail $f
+		exit 10
+	fi
+
+done
+
