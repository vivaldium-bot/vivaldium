+    return FWLTHEME_STATE_Hover;
+  } else if (dwFWLStates & FWL_PARTSTATE_MCD_Pressed) {
+    return FWLTHEME_STATE_Pressed;
+  }
+  return FWLTHEME_STATE_Normal;
