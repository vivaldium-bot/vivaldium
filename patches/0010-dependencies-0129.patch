+void
+glsl_type::generate_120_types(glsl_symbol_table *symtab, bool add_deprecated)
+{
+   generate_110_types(symtab, add_deprecated);
+
+   add_types_to_symbol_table(symtab, builtin_120_types,
+			     Elements(builtin_120_types), false);
+}
