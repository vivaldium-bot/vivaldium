+    psrlw   xmm4,   1
+
+    dec     r3
+    jg      FAST_HEIGHT
+
+
+FAST_LAST_ROW:
+    shr     r14, 15
+    imul    r14, r5
+    add     r4, r14
+    mov     r15, 32768
+
+FAST_LAST_ROW_WIDTH:
+    mov     rdi, r15
+    shr     rdi, 16
+    mov     bl,  [r4+rdi]
+    mov     [r0],bl
+    inc     r0
+
+    add     r15, r6
+    dec     r2
+    jg      FAST_LAST_ROW_WIDTH
+
+FAST_LAST_ROW_END:
+
+    POP_XMM
+    pop     rbp
+    pop     rbx
+    pop     rdi
+    pop     rsi
+    pop     r15
+    pop     r14
+    pop     r13
+    pop     r12
+    ret
