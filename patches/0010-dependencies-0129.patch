+void CXFA_Document::SetRoot(CXFA_Node* pNewRoot) {
+  if (m_pRootNode) {
+    AddPurgeNode(m_pRootNode);
+  }
+  m_pRootNode = pNewRoot;
+  RemovePurgeNode(pNewRoot);
+}
+IXFA_Notify* CXFA_Document::GetNotify() const {
