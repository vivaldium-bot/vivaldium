+CXFA_Document::CXFA_Document(IXFA_DocParser* pParser)
+    : m_pParser(pParser),
+      m_pScriptContext(nullptr),
+      m_pLayoutProcessor(nullptr),
+      m_pRootNode(nullptr),
+      m_pLocalMgr(nullptr),
