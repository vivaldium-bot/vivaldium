+        for (int i = 0; i < 1000; ++i) {
+            rand_op(canvas, rand);
+        }
+        SkAutoTUnref<SkPicture> picture(recorder.endRecording());
+
+        rand = rand2;
+    }
+
+    {
+        SkCanvas* canvas = recorder.beginRecording(100, 100);
+        SkRect rect = SkRect::MakeWH(50, 50);
+
+        for (int i = 0; i < 100; ++i) {
+            canvas->save();
+        }
+        while (canvas->getSaveCount() > 1) {
+            canvas->clipRect(rect);
+            canvas->restore();
+        }
+        SkAutoTUnref<SkPicture> picture(recorder.endRecording());
+    }
