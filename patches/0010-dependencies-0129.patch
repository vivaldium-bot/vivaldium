+    const XFA_ELEMENTINFO* pElementInfo = XFA_GetElementByName(wsExpression);
+    bHas = (GetProperty(iIndex, pElementInfo->eName) != NULL);
+  }
+  FXJSE_HVALUE hValue = pArguments->GetReturnValue();
+  if (hValue) {
+    FXJSE_Value_SetBoolean(hValue, bHas);
+  }
