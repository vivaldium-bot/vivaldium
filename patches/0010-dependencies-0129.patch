+void CXFA_FM2JSContext::equality_operator(FXJSE_HOBJECT hThis,
+                                          const CFX_ByteStringC& szFuncName,
+                                          CFXJSE_Arguments& args) {
+  if (args.GetLength() == 2) {
+    if (fm_ref_equal(hThis, args)) {
+      FXJSE_Value_SetInteger(args.GetReturnValue(), 1);
