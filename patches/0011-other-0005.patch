+  teqi      $t1, 0
+  tnei      $t1, 0
+  tgei      $t1, 0
+  tgeiu     $t1, 0
+  tlti      $t1, 0
+  tltiu     $t1, 0
+
+  teq       $t1, $zero
+  tne       $t1, $t2
+  tge       $t1, $t2
+  tgeu      $t1, $t2
+  tlt       $t1, $t2
+  tltu      $t1, $t2
