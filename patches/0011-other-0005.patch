+ *
+ *              0: 4? 83 eX e0 and    $~0x1f,E86
+ *              4: 4? 01 fX    add    RBASE,R86
+ *              7: 4? ff eX       jmpq   *R86
+ *                 ^     ^
+ * instruction_begin     current_position
+ *
+ *              0: 4? 83 eX e0 and    $~0x1f,E64
+ *              4: 4? 01 fX    add    RBASE,R64
+ *              7: 4? ff eX    jmpq   *R64
+ *                 ^     ^
+ * instruction_begin     current_position
+ *
