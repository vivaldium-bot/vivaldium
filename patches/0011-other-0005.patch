+                        BaseExtentionFromVEX(GET_VEX_PREFIX2()));
+    break;
+  case 8:
+
+    SET_DISPLACEMENT_FORMAT(DISPNONE);
+    SET_MODRM_BASE(BaseFromSIB(*current_position) |
