diff --git a/native_client/src/untrusted/irt/nacl.scons b/native_client/src/untrusted/irt/nacl.scons
new file mode 100644
index 0000000000000000000000000000000000000000..c5518f99a29564f39dd5dadc0c5907cb7f3ca5dc
