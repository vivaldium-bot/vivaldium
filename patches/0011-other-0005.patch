index 0000000000000000000000000000000000000000..c465a7af0bbbeb175df32ac74d419d72fc894232
--- /dev/null
+++ b/native_client/src/trusted/validator_arm/inst_classes_inline.h
@@ -0,0 +1,511 @@
+/*
