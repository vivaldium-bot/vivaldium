+######## PMULHRSW ##############################################################
+pmulhrsw Qpi Ppi, 0x0f 0x38 0x0b, CPUFeature_SSSE3
+######## PMULLW ################################################################
+pmullw Qq Pq, 0x0f 0xd5, CPUFeature_MMX
+######## PMULUDQ ###############################################################
+pmuludq Qq Pq, 0x0f 0xf4, CPUFeature_SSE2
