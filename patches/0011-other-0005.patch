+movq2dq Nq Vdq, 0xf3 0x0f 0xd6, CPUFeature_SSE2
+######## PABSB #################################################################
+pabsb Qpk Ppk, 0x0f 0x38 0x1c, CPUFeature_SSSE3
+######## PABSD #################################################################
+pabsd Qpj Ppj, 0x0f 0x38 0x1e, CPUFeature_SSSE3
+######## PABSW #################################################################
+pabsw Qpi Ppi, 0x0f 0x38 0x1d, CPUFeature_SSSE3
