+  f2 0f 11 54 24 10
+@dis:
+     0:	f2 0f 11 54 24 10                            	movsd  %xmm2,0x10(%rsp)
+@rdfa_output:
+  return code: 0
+@spec:
+  SAFE
+----------------------------------------------------------------------
+@hex:
+  # The following is an example of an instruction that can get a REP prefix.
+  #    insb
+  6c
