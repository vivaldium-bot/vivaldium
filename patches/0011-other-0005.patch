+}
+
+Bool IsNameInList(const char *name, ...) {
+  va_list value_list;
+
+  va_start(value_list, name);
+
+  for (;;) {
+    const char *element = va_arg(value_list, const char*);
+    if (element) {
+      if (strcmp(name, element) == 0) {
+        va_end(value_list);
+        return TRUE;
+      }
+    } else {
+      va_end(value_list);
+      return FALSE;
+    }
+  }
+}
