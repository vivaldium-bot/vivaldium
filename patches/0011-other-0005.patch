+int stream_printf(std::ostream& out_stream, const char *format, ...) {
+  va_list ap;
+  va_start(ap, format);
+
+  char buf[1024];
+  int result = vsprintf(buf, format, ap);
+  out_stream << buf;
+  return result;
+}
