+  0: ('prefix repz is not allowed', Instruction(0x0: f3 a6  repz cmpsb %es:(%rdi),%ds:(%rsi)))
+----------------------------------------------------------------------
+@hex:
+  # The same instruction with a REPNE prefix
+  f2 a6
+@dis:
