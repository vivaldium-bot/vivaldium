+class TestInstructionPrinter(unittest.TestCase):
+
+  def test_no_modrm(self):
+    printer = gen_dfa.InstructionPrinter(gen_dfa.DECODER, 32)
+    instr = gen_dfa.Instruction.Parse(
+        'mov Ob !ab, 0xa0, ia32')
+
+    printer.PrintInstructionWithoutModRM(instr)
+
+    self.assertEquals(
+        printer.GetContent().split(),
+        """
+        0xa0
+        @instruction_mov
+        @operands_count_is_2
+        @operand0_8bit
+        @operand1_8bit
+        @operand1_rax
+        @operand0_absolute_disp
+        disp32
+        """.split())
+
+  def test_relative(self):
+    printer = gen_dfa.InstructionPrinter(gen_dfa.DECODER, 32)
+    instr = gen_dfa.Instruction.Parse('jmp Jb, 0xeb')
+
+    printer.PrintInstructionWithoutModRM(instr)
+
+    self.assertEquals(
+        printer.GetContent().split(),
+        """
+        0xeb
+        @instruction_jmp
+        @operands_count_is_1
+        @operand0_8bit
+        rel8
+        @operand0_jmp_to
+        """.split())
+
+  def test_immediates(self):
+    printer = gen_dfa.InstructionPrinter(gen_dfa.DECODER, 32)
+    instr = gen_dfa.Instruction.Parse('adc =Ib &ab, 0x14')
+
+    printer.PrintInstructionWithoutModRM(instr)
+
+    self.assertEquals(
+        printer.GetContent().split(),
+        """
+        0x14
+        @instruction_adc
+        @operands_count_is_2
+        @operand0_8bit
+        @operand1_8bit
+        @operand1_rax
+        imm8
+        @operand0_immediate
