diff --git a/native_client/src/untrusted/nacl/nacl_irt.c b/native_client/src/untrusted/nacl/nacl_irt.c
new file mode 100644
index 0000000000000000000000000000000000000000..d623090264c334cf48c10a5f251f1e7e87a82866
--- /dev/null
+++ b/native_client/src/untrusted/nacl/nacl_irt.c
@@ -0,0 +1,129 @@
+/*
