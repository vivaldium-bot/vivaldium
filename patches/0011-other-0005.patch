+                   BaseExtentionFromREX(GET_REX_PREFIX()) |
+                   BaseExtentionFromVEX(GET_VEX_PREFIX2()));
+    SET_MODRM_INDEX(NC_NO_REG);
+    SET_MODRM_SCALE(0);
+    break;
+  case 2:
+current_state = 2; current_position++; goto _again;
+  break;
+  case 3:
+
