+    self.assertEquals(
+        set(['%rax', '%rbx', '%rcx', '%rdx', '%rsi', '%rdi',
+             '%r8', '%r9', '%r10', '%r11', '%r12', '%r13', '%r14', '%r15']),
+        indexes)
+
+    self.assertEquals(
+        set(['%rsp', '%r15', '%rbp', '%rip']),
+        bases)
+
+if __name__ == '__main__':
+  unittest.main()
