+  # Here 0xf3 prefix is used as part of SSE instruction encoding, not as REP.
+  f3 0f 10 45 00
+@dis:
+     0:	f3 0f 10 45 00                               	movss  0x0(%rbp),%xmm0
+@rdfa_output:
+  return code: 0
+@spec:
+  SAFE
