+    if (first) {
+      value = NaClSexpNodeToInt(v);
+      first = 0;
+    } else {
+      value /= NaClSexpNodeToInt(v);
+    }
+    NaClSexpFreeNode(v);
+  }
+  return NaClSexpNodeWrapInt(value);
+}
