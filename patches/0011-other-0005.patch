+      trie_diffs,
+      expected_adds=OpsProd(MnemonicOp('vpminsd'), mem|ymm, ymm, ymm),
+      expected_removes=set())
+
+
+if __name__ == '__main__':
+  proof_tools.RunProof(proof_tools.ParseStandardOpts(), Validate)
