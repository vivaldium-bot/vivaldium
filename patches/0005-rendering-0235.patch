-        <!-- ============================================== -->
-        <g id="patternContent" stroke="none" opacity="1">
-            <rect x="0" y="0" width="20" height="20" fill="black" />
-
-            <g fill="crimson">
-                <rect width="5" height="5" />
-                <rect x="5" y="5" width="5" height="5" />
