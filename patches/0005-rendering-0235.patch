-<!-- Tests various text on a path                                           -->
-<!--                                                                        -->
-<!-- @author bella.robinson@cmis.csiro.au                                   -->
-<!-- @version $Id: longTextOnPath.svg,v 1.4 2004/08/18 07:12:21 vhardy Exp $   -->
