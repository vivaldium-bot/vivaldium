-    <td class="described"><a
-      href="#lang-pseudo">The :lang()
-      pseudo-class</a></td>
-    <td class="origin">2</td></tr>
-  <tr>
-    <td class="pattern">E:enabled<br>E:disabled</td>
-    <td class="meaning">a user interface element E which is enabled or
