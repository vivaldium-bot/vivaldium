-        if (callerId.match(/\bselScrollbarRect_/)) {
-            this.scrollBarMove(evt);
-        }
-    }
-    if (evt.type == "mouseup") {
-        if (myRegExp.test(callerId)) {
-            if (callerId.match(/\bselHighlightSelection_/)) {
-                this.mouseDownStatus = false;
-                if (this.panStatus) {
-                    this.scrollBarMove(evt);                    
-                }
