+#ifdef LLVM_ON_UNIX
+#include "Unix/TimeValue.inc"
+#endif
+#ifdef LLVM_ON_WIN32
+#include "Windows/TimeValue.inc"
+#endif
diff --git a/third_party/swiftshader/third_party/LLVM/lib/Support/Timer.cpp b/third_party/swiftshader/third_party/LLVM/lib/Support/Timer.cpp
