index 0000000000000000000000000000000000000000..59f14fcd1ce51864a9882aed78688f6e59bd32a3
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/quadradic-exit-value.ll
@@ -0,0 +1,18 @@
+; RUN: opt < %s -analyze -iv-users | grep {\{1,+,3,+,2\}<%loop> (post-inc with loop %loop)}
+
+; The value of %r is dependent on a polynomial iteration expression.
+
+define i64 @foo(i64 %n) {
+entry:
+  br label %loop
+
+loop:
+  %indvar = phi i64 [ 0, %entry ], [ %indvar.next, %loop ]
+  %indvar.next = add i64 %indvar, 1
+  %c = icmp eq i64 %indvar.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  %r = mul i64 %indvar.next, %indvar.next
+  ret i64 %r
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/related_indvars.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/related_indvars.ll
