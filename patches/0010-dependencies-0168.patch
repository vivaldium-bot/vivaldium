+/// createTDListDAGScheduler - This creates a top-down list scheduler.
+ScheduleDAGSDNodes *
+llvm::createTDListDAGScheduler(SelectionDAGISel *IS, CodeGenOpt::Level) {
+  return new ScheduleDAGList(*IS->MF, new LatencyPriorityQueue());
+}
