diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/ARM/ARMRegisterInfo.h b/third_party/swiftshader/third_party/LLVM/lib/Target/ARM/ARMRegisterInfo.h
new file mode 100644
index 0000000000000000000000000000000000000000..8edfb9a2057fc4886eac7593ac828cd78fdc1d8b
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/lib/Target/ARM/ARMRegisterInfo.h
@@ -0,0 +1,33 @@
