diff --git a/third_party/swiftshader/third_party/LLVM/lib/Transforms/Scalar/ScalarReplAggregates.cpp b/third_party/swiftshader/third_party/LLVM/lib/Transforms/Scalar/ScalarReplAggregates.cpp
