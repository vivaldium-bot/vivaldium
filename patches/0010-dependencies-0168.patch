diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/Alpha/AlphaISelDAGToDAG.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/Alpha/AlphaISelDAGToDAG.cpp
