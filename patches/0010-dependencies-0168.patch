diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2007-08-27-VolatileLoadsStores.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/Mem2Reg/2007-08-27-VolatileLoadsStores.ll
