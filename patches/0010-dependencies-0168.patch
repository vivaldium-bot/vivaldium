@@ -0,0 +1,7 @@
+; RUN: opt < %s -basicaa -aa-eval -disable-output 2>/dev/null
+; Test for a bug in BasicAA which caused a crash when querying equality of P1&P2
+define void @test({[2 x i32],[2 x i32]}* %A, i64 %X, i64 %Y) {
+	%P1 = getelementptr {[2 x i32],[2 x i32]}* %A, i64 0, i32 0, i64 %X
+	%P2 = getelementptr {[2 x i32],[2 x i32]}* %A, i64 0, i32 1, i64 %Y
+	ret void
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-04-22-GEPProblem.ll b/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-04-22-GEPProblem.ll
