+declare void @Z_fatal(i8*) noreturn nounwind
+
+declare noalias i8* @calloc(i32, i32) nounwind
+
+define i32 @main(i32 %argc, i8** nocapture %argv) nounwind {
+; CHECK: main:
+; CHECK: tbb
+entry:
+	br label %bb42.i
+
+bb1.i2:		; preds = %bb42.i
+	br label %bb40.i
+
+bb5.i:		; preds = %bb42.i
