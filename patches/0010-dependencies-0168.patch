diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-09-30-CMOV-JumpTable-PHI.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2010-09-30-CMOV-JumpTable-PHI.ll
