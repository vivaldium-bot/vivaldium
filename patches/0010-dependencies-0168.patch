diff --git a/third_party/swiftshader/third_party/LLVM/test/Analysis/ScalarEvolution/2008-11-18-Stride1.ll b/third_party/swiftshader/third_party/LLVM/test/Analysis/ScalarEvolution/2008-11-18-Stride1.ll
