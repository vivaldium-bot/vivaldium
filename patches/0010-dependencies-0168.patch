+  public void enableStatsEvents(boolean enable, int periodMs) {
+    if (enable) {
+      try {
+        statsTimer.schedule(new TimerTask() {
+          @Override
+          public void run() {
+            executor.execute(new Runnable() {
+              @Override
+              public void run() {
+                getStats();
+              }
+            });
+          }
+        }, 0, periodMs);
+      } catch (Exception e) {
+        Log.e(TAG, "Can not schedule statistics timer", e);
+      }
+    } else {
+      statsTimer.cancel();
+    }
+  }
