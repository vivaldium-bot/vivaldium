+private:
+  bool ShouldChangeType(Type *From, Type *To) const;
+  Value *dyn_castNegVal(Value *V) const;
+  Value *dyn_castFNegVal(Value *V) const;
+  Type *FindElementAtOffset(Type *Ty, int64_t Offset, 
+                                  SmallVectorImpl<Value*> &NewIndices);
