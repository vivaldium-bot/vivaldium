+  private void reportError(final String errorMessage) {
+    Log.e(TAG, "Peerconnection error: " + errorMessage);
+    executor.execute(new Runnable() {
+      @Override
+      public void run() {
+        if (!isError) {
+          events.onPeerConnectionError(errorMessage);
+          isError = true;
+        }
+      }
+    });
+  }
