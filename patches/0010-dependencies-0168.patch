diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopSimplify/2003-04-25-AssertFail.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopSimplify/2003-04-25-AssertFail.ll
