diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/udiv-simplify-bug-1.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/udiv-simplify-bug-1.ll
