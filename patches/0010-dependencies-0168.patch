diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LICM/2003-02-27-PreheaderExitNodeUpdate.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LICM/2003-02-27-PreheaderExitNodeUpdate.ll
