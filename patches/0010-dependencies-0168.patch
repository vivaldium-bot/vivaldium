diff --git a/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-02-26-AccessSizeTest.ll b/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-02-26-AccessSizeTest.ll
new file mode 100644
index 0000000000000000000000000000000000000000..54baecc3d9132646b63b3c81552844337c13a372
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-02-26-AccessSizeTest.ll
@@ -0,0 +1,18 @@
+; This testcase makes sure that size is taken to account when alias analysis 
+; is performed.  It is not legal to delete the second load instruction because
+; the value computed by the first load instruction is changed by the store.
+
+; RUN: opt < %s -basicaa -gvn -instcombine -S | grep DONOTREMOVE
+
+define i32 @test() {
+	%A = alloca i32
+	store i32 0, i32* %A
+    %X = load i32* %A
+    %B = bitcast i32* %A to i8*
+    %C = getelementptr i8* %B, i64 1
+	store i8 1, i8* %C    ; Aliases %A
+    %Y.DONOTREMOVE = load i32* %A
+	%Z = sub i32 %X, %Y.DONOTREMOVE
+    ret i32 %Z
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-03-04-GEPCrash.ll b/third_party/swiftshader/third_party/LLVM/test/Analysis/BasicAA/2003-03-04-GEPCrash.ll
new file mode 100644
index 0000000000000000000000000000000000000000..cbc39ddb95a4a2b39663458a42324b37c7f3e3e9
--- /dev/null
