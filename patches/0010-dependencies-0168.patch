diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-02-20-InlineAsmClobber.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/2008-02-20-InlineAsmClobber.ll
