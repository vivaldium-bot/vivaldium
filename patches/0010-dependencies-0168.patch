+  // Check RTX settings.
+  ASSERT_EQ(static_cast<int>(config.rtp.rtx.ssrcs.size()),
+            sender_config.rtx_ssrcs_size());
+  for (int i = 0; i < sender_config.rtx_ssrcs_size(); i++) {
