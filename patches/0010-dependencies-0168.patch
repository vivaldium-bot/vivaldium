+ private:
+  const int order_;
+  const size_t length_;
+  const size_t complex_length_;
+  // These are work arrays for Ooura. The names are based on the comments in
+  // fft4g.c.
+  const std::unique_ptr<size_t[]> work_ip_;
+  const std::unique_ptr<float[]> work_w_;
