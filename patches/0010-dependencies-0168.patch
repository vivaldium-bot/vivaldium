diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/quadradic-exit-value.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopStrengthReduce/quadradic-exit-value.ll
