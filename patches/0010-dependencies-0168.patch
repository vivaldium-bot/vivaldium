diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopDeletion/multiple-exit-conditions.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopDeletion/multiple-exit-conditions.ll
