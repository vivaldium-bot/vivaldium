diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopSimplify/indirectbr-backedge.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/LoopSimplify/indirectbr-backedge.ll
