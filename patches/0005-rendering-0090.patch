-         * ```js
-         * const watcher = new EventWatcher(t, div, [ 'animationstart',
-         *                                            'animationiteration',
-         *                                            'animationend' ]);
-         * return watcher.wait_for([ 'animationstart', 'animationend' ],
-         *                         { record: 'all' }).then(evts => {
-         *   assert_equals(evts[0].elapsedTime, 0.0);
-         *   assert_equals(evts[1].elapsedTime, 2.0);
-         * });
-         * ```
