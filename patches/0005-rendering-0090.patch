-        // 'resources/doctype01.dat',
-        // 'resources/scriptdata01.dat',
-        // 'resources/entities01.dat',
-        // 'resources/comments01.dat'
-    ],
-    tests = [],
-    iframe = document.getElementsByTagName("iframe")[0],
-    stat = document.getElementsByTagName("p")[0].firstChild,
-    file = "",
-    test_number = 1,
-    subtest_number = 0,
-    fail_list = [],
