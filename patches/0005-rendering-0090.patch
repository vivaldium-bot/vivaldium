-        sab = new SharedArrayBuffer(length * type.BYTES_PER_ELEMENT);
-        ta = new type(sab);
-    }
-
-    var i;
-    for (i = 0; i < length; ++i)
-        ta[i] = i;
-
-    // Without Atomics, we can't safely test modifying the contents of the
