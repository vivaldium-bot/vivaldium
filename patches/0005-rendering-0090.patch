-        fail_list.push(test_number + "." + subtest_number);
-        log += "\n\nTest " + (test_number) + " of " + (test_number + tests.length) + " in " + file + " failed. Input:\n" + input + "\nGot:\n" + result + "\nExpected:\n" + expected;
-    }
-    test_number++;
-    if (async)
-        test();
-}
-</script>
