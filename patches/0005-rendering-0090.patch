-// Converts an instance of mojo.common.mojom.String16 to an ECMAScript String.
-function stringToMojoString16(string) {
-  let array = new Array(string.length);
-  for (var i = 0; i < string.length; ++i) {
-    array[i] = string.charCodeAt(i);
-  }
-  return { data: array }
