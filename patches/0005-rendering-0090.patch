-function wait_for_message(msg) {
-  return new Promise(function(resolve, reject) {
-    window.addEventListener('message', function onMsg(evt) {
-      if (evt.data.type === msg) {
-        resolve();
-      }
-    });
-  });
-}
-
-function with_window(url) {
