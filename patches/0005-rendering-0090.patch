-        this.wait_for = function(types, options) {
-            if (waitingFor) {
-                return Promise.reject('Already waiting for an event or events');
-            }
-            if (typeof types == 'string') {
-                types = [types];
-            }
-            if (options && options.record && options.record === 'all') {
-                recordedEvents = [];
-            }
