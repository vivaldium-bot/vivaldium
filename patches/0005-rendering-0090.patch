-function readDB() {
-  return new Promise(function(resolve, reject) {
-      var openRequest = indexedDB.open('db');
-
-      openRequest.onerror = reject;
-      openRequest.onsuccess = function() {
-          var db = openRequest.result;
-          var tx = db.transaction('store');
