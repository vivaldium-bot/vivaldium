+
+#define GLUE(a, b) a ## b
+#define JOIN(a, b) GLUE(a, b)
+#define X(s) JOIN(EXTERN_ASM, s)
+
+#if __APPLE__
+#define R(n) r ## n
+#else
+#define R(n) n
