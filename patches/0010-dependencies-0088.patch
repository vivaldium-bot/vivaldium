diff --git a/third_party/ffmpeg/libavcodec/qsvenc_hevc.c b/third_party/ffmpeg/libavcodec/qsvenc_hevc.c
new file mode 100644
index 0000000000000000000000000000000000000000..7d4d55bb618d2ae3939c07cff4860c6d8654eb03
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/qsvenc_hevc.c
@@ -0,0 +1,272 @@
+/*
+ * Intel MediaSDK QSV based HEVC encoder
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
