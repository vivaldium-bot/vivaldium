diff --git a/third_party/ffmpeg/libavcodec/nellymoserdec.c b/third_party/ffmpeg/libavcodec/nellymoserdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..b0deb79cf5d03b596c57851fdc8afa2f39700655
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/nellymoserdec.c
@@ -0,0 +1,211 @@
+/*
+ * NellyMoser audio decoder
+ * Copyright (c) 2007 a840bda5870ba11f19698ff6eb9581dfb0f95fa5,
+ *                    539459aeb7d425140b62a3ec7dbf6dc8e408a306, and
