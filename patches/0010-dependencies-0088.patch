--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpeg4videodec.c
@@ -0,0 +1,2857 @@
+/*
+ * MPEG-4 decoder
+ * Copyright (c) 2000,2001 Fabrice Bellard
+ * Copyright (c) 2002-2010 Michael Niedermayer <michaelni@gmx.at>
