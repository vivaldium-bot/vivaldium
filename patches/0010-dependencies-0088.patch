index 0000000000000000000000000000000000000000..efa9fd5fed3371dc938c085024b6f3d8f56e0695
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ppc/mpegaudiodsp_altivec.c
@@ -0,0 +1,141 @@
+/*
+ * Altivec optimized MP3 decoding functions
+ * Copyright (c) 2010 Vitor Sessak
+ *
