+++ b/third_party/ffmpeg/libavcodec/ppc/hevcdsp.c
@@ -0,0 +1,106 @@
+/*
+ * SIMD-optimized IDCT functions for HEVC decoding
+ * Copyright (c) Alexandra Hajkova
+ *
