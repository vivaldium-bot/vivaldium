+
+/* dc encoding for MPEG-4 */
+const uint8_t ff_mpeg4_DCtab_lum[13][2] =
+{
+    {3,3}, {3,2}, {2,2}, {2,3}, {1,3}, {1,4}, {1,5}, {1,6}, {1,7},
+    {1,8}, {1,9}, {1,10}, {1,11},
+};
+
+const uint8_t ff_mpeg4_DCtab_chrom[13][2] =
