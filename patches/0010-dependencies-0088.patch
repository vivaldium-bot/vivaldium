new file mode 100644
index 0000000000000000000000000000000000000000..e0e869999883d06b7389ba48de949cfb3597f134
--- /dev/null
+++ b/third_party/icu/source/common/ucnvsel.cpp
@@ -0,0 +1,820 @@
+/*
