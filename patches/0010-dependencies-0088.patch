--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/rv40dsp.c
@@ -0,0 +1,715 @@
+/*
+ * RV40 decoder motion compensation functions
+ * Copyright (c) 2008 Konstantin Shishkov
+ *
