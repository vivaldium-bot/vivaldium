+#if _MIPS_SIM != _ABIO32
+void ff_vc1_inv_trans_8x4_mmi(uint8_t *dest, ptrdiff_t linesize, int16_t *block)
+{
+    int16_t *src = block;
+    int16_t *dst = block;
+    double ftmp[16];
+    uint32_t tmp[1];
+    mips_reg addr[1];
+    DECLARE_VAR_LOW32;
+
+    // 1st loop
+    __asm__ volatile (
+        MMI_LDC1(%[ftmp1], %[src], 0x00)
