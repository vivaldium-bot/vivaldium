index 0000000000000000000000000000000000000000..f1b3c8eab55f63923ae17fb5a1496eda3f65d2a6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ra288.c
@@ -0,0 +1,254 @@
+/*
+ * RealAudio 2.0 (28.8K)
+ * Copyright (c) 2003 The FFmpeg project
