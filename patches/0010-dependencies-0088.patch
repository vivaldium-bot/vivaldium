+    {  2592,  2829,  5588,  2839, -7306}, { -3049, -4918,  5955,  9201, -4447},
+    {   697,  3908,  5798, -4451, -4644}, { -2121,  5444, -2570,   321, -1202},
+    {  2846, -2086,  3532,   566,  -708}, { -4279,   950,  4980,  3749,   452},
