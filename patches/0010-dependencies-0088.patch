diff --git a/third_party/ffmpeg/libavcodec/opus_rc.c b/third_party/ffmpeg/libavcodec/opus_rc.c
new file mode 100644
index 0000000000000000000000000000000000000000..85268bd2842d4130e50e277e73b62ca57cd597d5
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/opus_rc.c
@@ -0,0 +1,408 @@
+/*
+ * Copyright (c) 2012 Andrew D'Addesio
+ * Copyright (c) 2013-2014 Mozilla Corporation
+ * Copyright (c) 2017 Rostislav Pehlivanov <atomnuker@gmail.com>
+ *
+ * This file is part of FFmpeg.
