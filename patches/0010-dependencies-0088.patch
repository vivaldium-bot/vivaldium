+++ b/third_party/icu/source/common/uresbund.cpp
@@ -0,0 +1,3010 @@
+/*
+******************************************************************************
+* Copyright (C) 1997-2015, International Business Machines Corporation and
+* others. All Rights Reserved.
+******************************************************************************
+*
+* File uresbund.cpp
+*
+* Modification History:
