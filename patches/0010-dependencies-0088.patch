+        MMI_LWC1(%[ftmp6], %[addr0], 0x00)
+        PTR_ADDU   "%[addr0],   %[addr0],   %[linesize]                 \n\t"
+        MMI_LWC1(%[ftmp7], %[addr0], 0x00)
+        PTR_ADDU   "%[addr0],   %[addr0],   %[linesize]                 \n\t"
