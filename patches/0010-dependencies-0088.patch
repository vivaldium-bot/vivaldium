+        "1:                                                             \n\t"
+        MMI_ULWC1(%[ftmp1], %[src], -0x02)
+        MMI_ULWC1(%[ftmp2], %[src], -0x01)
+        MMI_ULWC1(%[ftmp3], %[src],  0x00)
+        MMI_ULWC1(%[ftmp4], %[src],  0x01)
+        MMI_ULWC1(%[ftmp5], %[src],  0x02)
