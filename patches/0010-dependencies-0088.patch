diff --git a/third_party/ffmpeg/libavcodec/proresdec2.c b/third_party/ffmpeg/libavcodec/proresdec2.c
new file mode 100644
index 0000000000000000000000000000000000000000..73b161f9a5c4806d3eb88eb136212305c488f483
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/proresdec2.c
@@ -0,0 +1,708 @@
+/*
