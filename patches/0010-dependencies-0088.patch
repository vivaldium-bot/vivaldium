+
+        VC1_INV_TRANCS_4_STEP2_MMI(%[ftmp1], %[ftmp2], %[ftmp3], %[ftmp4],
+                                   %[ftmp5], %[ftmp6], %[ftmp7], %[ftmp8],
+                                   %[ftmp0])
+
+        MMI_SWC1(%[ftmp1], %[dest], 0x00)
+        PTR_ADDU   "%[addr0],   %[dest],    %[linesize]                 \n\t"
+        MMI_SWC1(%[ftmp2], %[addr0], 0x00)
