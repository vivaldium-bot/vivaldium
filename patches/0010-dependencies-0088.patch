index 0000000000000000000000000000000000000000..c3f245eb8568140d347bf01d6c2a25fc1af4de6e
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/rv34dsp.c
@@ -0,0 +1,143 @@
+/*
+ * RV30/40 decoder common dsp functions
+ * Copyright (c) 2007 Mike Melanson, Konstantin Shishkov
+ * Copyright (c) 2011 Janne Grunau
+ *
