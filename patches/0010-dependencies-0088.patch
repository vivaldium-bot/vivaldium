+
+typedef enum {
+  /* merge all input slices into a single slice */
+  GRPC_SLICE_SPLIT_MERGE_ALL,
+  /* leave slices as is */
+  GRPC_SLICE_SPLIT_IDENTITY,
+  /* split slices into one byte chunks */
+  GRPC_SLICE_SPLIT_ONE_BYTE
