index 0000000000000000000000000000000000000000..68ed3911957487b504c3e1c8bcb1b4f089aa6a60
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/put_bits.h
@@ -0,0 +1,268 @@
+/*
+ * copyright (c) 2004 Michael Niedermayer <michaelni@gmx.at>
+ *
