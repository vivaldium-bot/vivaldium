index 0000000000000000000000000000000000000000..c33d8f7cdb63b12b8e85920f6700ac19cb1ffc8b
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/h264pred_init_mips.c
@@ -0,0 +1,155 @@
+/*
