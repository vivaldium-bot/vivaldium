index 0000000000000000000000000000000000000000..cab3129f8f387a1b905a07562cf51357c5e93edf
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/pafvideo.c
@@ -0,0 +1,397 @@
+/*
+ * Packed Animation File video decoder
+ * Copyright (c) 2012 Paul B Mahol
+ *
