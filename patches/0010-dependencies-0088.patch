diff --git a/third_party/ffmpeg/libavcodec/mips/idctdsp_mmi.c b/third_party/ffmpeg/libavcodec/mips/idctdsp_mmi.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7979650fdde7e03826c94690fd9e1ceb326532a
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/idctdsp_mmi.c
@@ -0,0 +1,224 @@
+/*
+ * Loongson SIMD optimized idctdsp
+ *
+ * Copyright (c) 2015 Loongson Technology Corporation Limited
+ * Copyright (c) 2015 Zhou Xiaoyong <zhouxiaoyong@loongson.cn>
+ *
+ * This file is part of FFmpeg.
+ *
