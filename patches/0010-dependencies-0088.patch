index 0000000000000000000000000000000000000000..d3f9acb0e2ea9ca30406a911e8c2fb22baf0aa47
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/xvid_idct_mmi.c
@@ -0,0 +1,253 @@
+/*
+ * Loongson SIMD optimized xvid idct
+ *
+ * Copyright (c) 2015 Loongson Technology Corporation Limited
+ * Copyright (c) 2015 Zhou Xiaoyong <zhouxiaoyong@loongson.cn>
+ *
