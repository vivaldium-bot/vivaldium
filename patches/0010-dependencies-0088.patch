diff --git a/third_party/ffmpeg/libavcodec/mpegvideoencdsp.c b/third_party/ffmpeg/libavcodec/mpegvideoencdsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..0af3d8bef8b8a3d74aab40038a8751b0a04122cc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mpegvideoencdsp.c
@@ -0,0 +1,256 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
