+    }else{\
+        const int E = B + C;\
+        const ptrdiff_t step = C ? stride : 1;\
+        for(i = 0; i < h; i++){\
+            OP(dst[0], (A*src[0] + E*src[step+0] + bias));\
+            OP(dst[1], (A*src[1] + E*src[step+1] + bias));\
