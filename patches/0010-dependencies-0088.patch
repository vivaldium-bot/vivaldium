+        specs.append(self.config.job_spec(cmdline,
+                                          None,
+                                          shortname='csharp.coverage.%s' % assembly,
+                                          cpu_cost=run_exclusive,
+                                          environ=_FORCE_ENVIRON_FOR_WRAPPERS))
+    return specs
