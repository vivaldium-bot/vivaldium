+void CancelRpc(ClientContext* context, int delay_us, TestServiceImpl* service) {
+  gpr_sleep_until(gpr_time_add(gpr_now(GPR_CLOCK_REALTIME),
+                               gpr_time_from_micros(delay_us, GPR_TIMESPAN)));
+  while (!service->signal_client()) {
+  }
+  context->TryCancel();
+}
