diff --git a/third_party/ffmpeg/libavcodec/mips/mpegvideo_mmi.c b/third_party/ffmpeg/libavcodec/mips/mpegvideo_mmi.c
new file mode 100644
index 0000000000000000000000000000000000000000..18058e492d6d809d021b51283b69b27c03c9afd3
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/mpegvideo_mmi.c
@@ -0,0 +1,506 @@
+/*
+ * Loongson SIMD optimized mpegvideo
+ *
+ * Copyright (c) 2015 Loongson Technology Corporation Limited
+ * Copyright (c) 2015 Zhou Xiaoyong <zhouxiaoyong@loongson.cn>
+ *                    Zhang Shuangshuang <zhangshuangshuang@ict.ac.cn>
