index 0000000000000000000000000000000000000000..bafe0f92ac68aec4bfdf5b19966e415c63655305
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/mips/h264chroma_mmi.c
@@ -0,0 +1,704 @@
+/*
+ * Loongson SIMD optimized h264chroma
+ *
+ * Copyright (c) 2015 Loongson Technology Corporation Limited
+ * Copyright (c) 2015 Zhou Xiaoyong <zhouxiaoyong@loongson.cn>
+ *                    Zhang Shuangshuang <zhangshuangshuang@ict.ac.cn>
