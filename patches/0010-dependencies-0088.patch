diff --git a/third_party/ffmpeg/libavcodec/ppc/fdctdsp.c b/third_party/ffmpeg/libavcodec/ppc/fdctdsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..4ab516c6b3529a17a4b35c552686772aad56b16c
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ppc/fdctdsp.c
@@ -0,0 +1,478 @@
+/*
