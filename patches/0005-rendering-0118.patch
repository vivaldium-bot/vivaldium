-        <textarea rows="5" dir="rtl">
-!123@
-!123@
-!123@
-!123@
-        </textarea>
-      </div>
-      <div dir="rtl">
-        <textarea rows="5" dir="ltr">
-@123!
-@123!
-@123!
-@123!
-        </textarea>
