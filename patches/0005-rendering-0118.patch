-<script>
-function t(type, expected) {
-  assert_equals(canPlayType(type), expected, type);
-}
-
-function mime(type, codecs) {
-  if (codecs.length) {
-    return type + '; codecs="' + codecs.join(', ') + '"';
-  }
-  return type;
-}
-
-test(function() {
-  assert_equals(mime('video/webm', []), 'video/webm');
