-    // [a-z] (PCENChar)* '-' (PCENChar)*
-    // https://html.spec.whatwg.org/multipage/scripting.html#valid-custom-element-name
-    'a-',
-    'a-a',
-    'aa-',
-    'aa-a',
-    'a-.-_',
-    'a-0123456789',
-    'a-\u6F22\u5B57', // Two CJK Unified Ideographs
