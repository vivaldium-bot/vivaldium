-    undefined,
-    null,
-    '',
-    '-',
-    'a',
-    'input',
-    'mycustomelement',
-    'A',
-    'A-',
-    '0-',
-    'a-A',
-    'a-Z',
-    'A-a',
-    'a-a\u00D7',
-    'a-a\u3000',
-    'a-a\uDB80\uDC00', // Surrogate pair U+F0000
-    // name must not be any of the hyphen-containing element names.
-    'annotation-xml',
-    'color-profile',
-    'font-face',
-    'font-face-src',
-    'font-face-uri',
-    'font-face-format',
-    'font-face-name',
-    'missing-glyph',
