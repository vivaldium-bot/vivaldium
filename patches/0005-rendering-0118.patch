-              // Assign a value whose first strong is LTR.
-              input.value =
-                  '@\u200E123\u200F!\n' +
-                  '!\u200F123\u200E@\n' +
-                  '@123\u200E\u200F!\n' +
-                  '!123\u200F\u200E@\n';
-            }
-          }
-        }
-      </script>
