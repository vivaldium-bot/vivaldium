+pass2 [@3456]%lownum1-10 ?
+pass2 [@456-34-3456]%lownum1-10 ?
+
+# pass3 processing
+pass3 @346%lownum1-10[@12456] ?
+pass3 @16[%lownum1-10]@12456 *
+pass3 {mfrac[@3456%upnum1-10%lownum1-10]}mfrac *
