new file mode 100644
index 0000000000000000000000000000000000000000..41e3ebd3305553e4763df68d70ea16f1e12c0781
--- /dev/null
+++ b/third_party/webrtc/rtc_tools/event_log_visualizer/chart.proto
@@ -0,0 +1,38 @@
+// Describes a chart generated from WebRTC event log data.
+syntax = "proto3";
+option optimize_for = LITE_RUNTIME;
+
+package webrtc.analytics;
+
+message ChartStyle {
+  enum Type {
+    UNDEFINED = 0;
+    LINE_CHART = 1;
+    BAR_CHART = 2;
+    LINE_STEP_CHART = 3;
+    SCATTER_CHART = 4;
+  }
+}
+
+message DataSet {
+  repeated float x_values = 1;
+  repeated float y_values = 2;
+  string label = 3;
+  ChartStyle.Type style = 4;
+  bool highlight_points = 5;
+}
+
+message Chart {
+  repeated DataSet data_sets = 1;
+  float xaxis_min = 2;
+  float xaxis_max = 3;
+  string xaxis_label = 4;
+  float yaxis_min = 5;
+  float yaxis_max = 6;
+  string yaxis_label = 7;
+  string title = 8;
+}
+
+message ChartCollection {
+  repeated Chart charts = 1;
+}
