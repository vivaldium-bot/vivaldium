+// Adds a MediaStream with tracks that can be used as a |selector| in a call
+// to GetStats.
+void StatsCollector::AddStream(MediaStreamInterface* stream) {
+  RTC_DCHECK(pc_->session()->signaling_thread()->IsCurrent());
