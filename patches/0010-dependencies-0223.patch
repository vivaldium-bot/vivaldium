+static bool BadSdp(const std::string& source,
+                   const std::string& type,
+                   const std::string& reason,
+                   std::string* err_desc) {
+  std::ostringstream desc;
+  desc << "Failed to set " << source;
+  if (!type.empty()) {
+    desc << " " << type;
+  }
+  desc << " sdp: " << reason;
+
+  if (err_desc) {
+    *err_desc = desc.str();
+  }
+  LOG(LS_ERROR) << desc.str();
+  return false;
+}
