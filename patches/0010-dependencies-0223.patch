diff --git a/third_party/webrtc/rtc_base/sha1digest_unittest.cc b/third_party/webrtc/rtc_base/sha1digest_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..24c30faede26066130751d8fb0886dc81668f9de
--- /dev/null
