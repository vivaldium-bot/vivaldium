+    tdesc_factory_->set_certificate(
+        rtc::RTCCertificate::Create(std::unique_ptr<rtc::SSLIdentity>(
+            rtc::SSLIdentity::Generate(identity_name, rtc::KT_DEFAULT))));
+    tdesc_factory_->set_secure(cricket::SEC_REQUIRED);
+  }
