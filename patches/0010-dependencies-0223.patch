+#include <string>
+
+#include "webrtc/rtc_base/gunit.h"
+#include "webrtc/rtc_base/task_queue.h"
+#include "webrtc/rtc_base/weak_ptr.h"
+
+namespace rtc {
+
+namespace {
+
+struct Base {
+  std::string member;
+};
+struct Derived : public Base {};
+
+struct Target {};
+
+struct Arrow {
+  WeakPtr<Target> target;
