diff --git a/third_party/webrtc/rtc_base/helpers.cc b/third_party/webrtc/rtc_base/helpers.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f7b1fa8d630cfd168c664b3ec00a0e5fd80a972f
