+  JsepSessionDescription* CreateRemoteOfferWithVersion(
+        cricket::MediaSessionOptions options,
+        cricket::SecurePolicy secure_policy,
+        const std::string& session_version,
+        const SessionDescriptionInterface* current_desc) {
