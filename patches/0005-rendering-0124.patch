-/**
- * Helper functions to tests.
- */
-
-function createStreams(constraints, numStreams, streamsSoFar = []) {
-  if (numStreams == 0) {
-    return Promise.resolve(streamsSoFar);;
-  }
-  return navigator.mediaDevices.getUserMedia(constraints)
-    .then(function(stream) {
