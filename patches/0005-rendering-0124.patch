-        var definer = document.getElementById('definer');
-        var type = 'reverse';
-	if (definer.scrollLeft > 0) {
-	    type = 'default';
-	}
-	else {
-	    definer.scrollLeft = 1;
-	    if (definer.scrollLeft === 0) {
-		type = 'negative';
-	    }
