-
-    function bringBack()
-    {
-        InspectorTest.addResult("\nBringing things back\n");
-        InspectorTest.domModel.undo(InspectorTest._dumpOuterHTML.bind(InspectorTest, true, next));
-    }
-}
-
-InspectorTest.innerSetOuterHTML = function(newText, last, next)
