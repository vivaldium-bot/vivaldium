-  ["http://host/a", "///another/path", "http://another/path"],
-  ["http://host/a", "//Another\\\\path", "http://another/path"],
-  ["http://host/a", "//", "http:"],
-  // IE will also allow one or the other to be a backslash to get the same
-  // behavior.
-  ["http://host/a", "\\\\/another/path", "http://another/path"],
-  ["http://host/a", "/\\\\Another\\\\path", "http://another/path"],
-];
