-
-function runRepaintTest() {
-    drawAll(0);
-    if (window.testRunner) {
-        testRunner.waitUntilDone();
-        testRunner.layoutAndPaintAsyncThen(repaintOnHiddenPage);
-    } else {
-        setTimeout(repaintOnHiddenPage, 50);
-    }
-}
-</script>
