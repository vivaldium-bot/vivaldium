+  std::vector<std::unique_ptr<TemporalLayers>> temporal_layers_;
+  std::vector<std::unique_ptr<TemporalLayersChecker>> temporal_layers_checkers_;
+  std::vector<uint16_t> picture_id_;
+  std::vector<uint8_t> tl0_pic_idx_;
