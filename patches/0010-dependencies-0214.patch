+bool RembReceiver::LatestEstimate(uint32_t* estimate_bps) {
+  if (latest_estimate_bps_ < 0) {
+    std::vector<uint32_t> ssrcs;
+    uint32_t bps = 0;
+    if (!estimator_->LatestEstimate(&ssrcs, &bps)) {
+      return false;
+    }
+    latest_estimate_bps_ = bps;
+  }
+  *estimate_bps = latest_estimate_bps_;
+  return true;
+}
