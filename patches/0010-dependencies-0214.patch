+  int SetEcStatus(bool enable, EcModes mode = kEcUnchanged) override;
+  int GetEcStatus(bool& enabled, EcModes& mode) override;
+  int EnableDriftCompensation(bool enable) override;
+  bool DriftCompensationEnabled() override;
