+    int32_t PCP(int32_t& PCP) const override;
+    int32_t EnableIpV6() override;
+    bool IpV6Enabled() const override;
+    int32_t SetFilterIP(
+        const char filterIPAddress[kIpAddressVersion6Length]) override;
