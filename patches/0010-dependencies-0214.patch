+  int payload_type;
+  int clockrate_hz;
+};
+
+const CngCodecSpec kCngCodecs[] = {{13, 8000},
+                                   {103, 16000},
+                                   {104, 32000},
+                                   {105, 48000}};
+
+bool IsComfortNoisePayload(uint8_t payload_type) {
+  for (const auto& c : kCngCodecs) {
+    if (c.payload_type == payload_type)
+      return true;
+  }
+
+  return false;
+}
