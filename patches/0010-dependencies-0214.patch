+  // temporal layers dependencies returned by TemporalLayers class created in
+  // the same factory.
+  std::unique_ptr<webrtc::TemporalLayersChecker> CreateChecker(
+      int simulcast_id,
+      int temporal_layers,
+      uint8_t initial_tl0_pic_idx) const override;
+};
