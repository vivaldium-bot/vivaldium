+    return;  // Since it's same ssrc, don't reset anything.
+  }
+  ssrc_.emplace(ssrc);
+  if (!sequence_number_forced_) {
+    sequence_number_ = random_.Rand(1, kMaxInitRtpSeqNumber);
+  }
