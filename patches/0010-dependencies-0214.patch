diff --git a/third_party/webrtc/call/audio_receive_stream.h b/third_party/webrtc/call/audio_receive_stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..d6924256c56db6a0a29b6ac3638531d8ddc91dd3
--- /dev/null
+++ b/third_party/webrtc/call/audio_receive_stream.h
@@ -0,0 +1,148 @@
+/*
