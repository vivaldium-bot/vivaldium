+bool RtpStreamReceiverController::OnRtpPacket(const RtpPacketReceived& packet) {
+  rtc::CritScope cs(&lock_);
+  return demuxer_.OnRtpPacket(packet);
+}
+
+void RtpStreamReceiverController::AddSink(uint32_t ssrc,
