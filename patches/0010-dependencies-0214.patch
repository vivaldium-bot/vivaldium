+void PythonPlotCollection::Draw() {
+  printf("import matplotlib.pyplot as plt\n");
+  printf("import colorsys\n");
+  for (size_t i = 0; i < plots_.size(); i++) {
+    printf("plt.figure(%zu)\n", i);
+    plots_[i]->Draw();
+  }
+  printf("plt.show()\n");
+}
