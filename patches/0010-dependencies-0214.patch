+  for (int i = 0; i < num_of_playout_devices; ++i) {
+    EXPECT_EQ(0, voe_hardware_->GetPlayoutDeviceName(
+        i, device_name, guid_name));
+    EXPECT_GT(strlen(device_name), 0u) <<
