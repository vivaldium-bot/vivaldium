--- /dev/null
+++ b/third_party/webpagereplay/third_party/ipfw_win32/README.web-page-replay
@@ -0,0 +1,12 @@
+Name: Windows XP NDIS module for Dummynet.
+Short Name: ipfw3
+URL: http://info.iet.unipi.it/~luigi/dummynet/
+Version: 20100322 v.3.0.0.2
+License: BSD
+License File: LICENSE
+
+Description:
+Used by Web Page Replay to simulate network delays and bandwidth throttling on Windows XP.
+
+Local Modifications:
+Dropped files: cyg-ipfw.exe, cygwin1.dll, testme.bat, wget.exe.
\ No newline at end of file
diff --git a/third_party/webpagereplay/third_party/ipfw_win32/ipfw.exe b/third_party/webpagereplay/third_party/ipfw_win32/ipfw.exe
