+
+TEST(AudioEncoderFactoryTemplateTest, OneEncoderType) {
+  auto factory = CreateAudioEncoderFactory<AudioEncoderFakeApi<BogusParams>>();
+  EXPECT_THAT(factory->GetSupportedEncoders(),
