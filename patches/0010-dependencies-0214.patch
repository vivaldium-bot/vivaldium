+  }
+}
+
+TEST_F(HardwareBeforeStreamingTest,
+       AllEnumeratedPlayoutDevicesCanBeSetAsPlayoutDevice) {
+  // Check playout side (see recording side test for more info on GUIDs).
+  int num_of_playout_devices = 0;
