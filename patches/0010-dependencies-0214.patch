+
+#ifndef WEBRTC_API_VIDEO_VIDEO_FRAME_BUFFER_H_
+#define WEBRTC_API_VIDEO_VIDEO_FRAME_BUFFER_H_
+
+#include <stdint.h>
+
+#include "webrtc/base/refcount.h"
