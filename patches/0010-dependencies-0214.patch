+
+  histogram_.Add(20);
+  EXPECT_EQ(10ul, histogram_.NumValues());
+  EXPECT_EQ(2ul, histogram_.InverseCdf(0.5f));
+  EXPECT_EQ(5ul, histogram_.InverseCdf(0.5000001f));
+}
+
+}  // namespace video_coding
+}  // namespace webrtc
