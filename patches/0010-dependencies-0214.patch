+  void SetDelayOffsetMs(int offset) override;
+  int DelayOffsetMs() override;
+
+  int SetAecmMode(AecmModes mode = kAecmSpeakerphone,
+                  bool enableCNG = true) override;
+
+  int GetAecmMode(AecmModes& mode, bool& enabledCNG) override;
