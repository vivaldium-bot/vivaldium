+
+  ExtractFrameFromY4mFile(video_file.c_str(),
+                          frame_width, frame_height,
+                          frame_number, result_frame);
+
+  EXPECT_EQ(*expected_frame, *result_frame);
+  fclose(input_file);
+  delete[] result_frame;
+  delete[] expected_frame;
+}
