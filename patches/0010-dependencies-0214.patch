+  EXPECT_EQ(
+      rtc::Optional<AudioCodecInfo>({16000, 2, 23456}),
+      factory->QueryAudioEncoder({"sham", 16000, 2, {{"param", "value"}}}));
+  EXPECT_EQ(nullptr, factory->MakeAudioEncoder(17, {"bar", 16000, 1}));
+  auto enc1 = factory->MakeAudioEncoder(17, {"bogus", 8000, 1});
