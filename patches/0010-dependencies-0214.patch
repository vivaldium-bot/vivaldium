index 0000000000000000000000000000000000000000..96ac03c5307e498004606f70870e44051f49ae39
--- /dev/null
+++ b/third_party/webrtc/voice_engine/test/auto_test/standard/file_before_streaming_test.cc
@@ -0,0 +1,132 @@
+/*
