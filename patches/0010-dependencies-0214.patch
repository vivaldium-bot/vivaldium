+  const int kOutputLengthMs = 10000;
+  const std::string kRefChecksum = "e41d7e1dac8aeae9f21e8e03cd7ecd71";
+
+  PlayFileAndCheck(kFileName, kRefChecksum, kOutputLengthMs);
+}
+
+}  // namespace webrtc
