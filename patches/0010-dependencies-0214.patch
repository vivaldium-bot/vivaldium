diff --git a/third_party/webrtc/voice_engine/include/voe_network.h b/third_party/webrtc/voice_engine/include/voe_network.h
new file mode 100644
index 0000000000000000000000000000000000000000..e659394f81842d04a52abccc68e34f6e2af9d0fd
--- /dev/null
