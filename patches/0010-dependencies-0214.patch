+// Holder mean, Manhattan distance for p=1, EuclidianNorm/sqrt(n) for p=2.
+template <typename T>
+double NormLp(T sum, size_t size, double p) {
+  return pow(sum / size, 1.0 / p);
+}
+}
+
+const double kP = 1.0;  // Used for Norm Lp.
