+  for (uint32_t i = 10; i < 50; ++i) {
+    packets.push_back(new MediaPacket(i * 100, i));
+  }
+  delay.RunFor(1000, &packets);
+  acc.splice(acc.end(), packets);
+  ASSERT_TRUE(IsTimeSorted(acc));
+  ASSERT_TRUE(IsSequenceNumberSorted(acc));
+
+  for (auto* packet : acc)
+    delete packet;
+}
