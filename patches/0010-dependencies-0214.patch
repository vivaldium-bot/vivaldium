+
+#include "webrtc/voice_engine/file_recorder.h"
+
+#include <list>
+
+#include "webrtc/base/platform_thread.h"
+#include "webrtc/common_audio/resampler/include/resampler.h"
+#include "webrtc/common_types.h"
