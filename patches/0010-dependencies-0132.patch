index 0000000000000000000000000000000000000000..bcc546557b85f7c37739d96cba832516af8e825f
--- /dev/null
+++ b/third_party/mesa/src/src/egl/main/eglapi.c
@@ -0,0 +1,1579 @@
+/**************************************************************************
