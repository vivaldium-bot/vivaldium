index 0000000000000000000000000000000000000000..8e4e026a211e1cb8685d945d106990f182819763
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/vl/vl_winsys_dri.c
@@ -0,0 +1,400 @@
+/**************************************************************************
+ *
+ * Copyright 2009 Younes Manton.
+ * All Rights Reserved.
+ *
