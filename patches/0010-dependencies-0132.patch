+++ b/third_party/mesa/src/src/gallium/auxiliary/os/os_thread.h
@@ -0,0 +1,509 @@
+/**************************************************************************
+ * 
+ * Copyright 1999-2006 Brian Paul
+ * Copyright 2008 Tungsten Graphics, Inc., Cedar Park, Texas.
+ * All Rights Reserved.
