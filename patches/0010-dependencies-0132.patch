diff --git a/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_init.c b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..2dc29ac5b4b4efd368d506aa02c7b07ab50471e6
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/postprocess/pp_init.c
@@ -0,0 +1,279 @@
+/**************************************************************************
+ *
+ * Copyright 2011 Lauri Kasanen
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including
