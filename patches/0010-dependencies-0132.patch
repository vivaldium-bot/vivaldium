+#define ATTRIB( NAME, SZ, SRCTYPE, DSTTYPE, TO )        \
+static void						\
+emit_##NAME(const void *attrib, void *ptr)		\
+{  \
+   unsigned i;						\
+   SRCTYPE *in = (SRCTYPE *)attrib;                     \
+   DSTTYPE *out = (DSTTYPE *)ptr;			\
+							\
+   for (i = 0; i < SZ; i++) {				\
+      out[i] = TO(in[i]);				\
+   }							\
+}
