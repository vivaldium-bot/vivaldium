index 0000000000000000000000000000000000000000..6223fabf577f63204f2d711b432368f9609a99f4
--- /dev/null
+++ b/third_party/mesa/src/src/gallium/auxiliary/vl/vl_vlc.h
@@ -0,0 +1,277 @@
+/**************************************************************************
+ *
+ * Copyright 2011 Christian König.
+ * All Rights Reserved.
+ *
