-        amp.gain.linearRampToValueAtTime(gain, now + toneDuration * 0.1);
-        amp.gain.setValueAtTime(gain, now + toneDuration * 0.9);
-        amp.gain.linearRampToValueAtTime(0.0, now + toneDuration);
