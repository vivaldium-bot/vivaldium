-<script>
-
-var sourceCanvas3D = document.createElement('canvas');
-var sourceCtx = sourceCanvas3D.getContext('webgl');
-var destCanvas3D = document.createElement('canvas');
-var destCtx = destCanvas3D.getContext('webgl');
