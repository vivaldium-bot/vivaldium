-  <tr>
-    <td class="pattern">E::first-letter</td>
-    <td class="meaning">the first formatted letter of an E element</td>
-    <td class="described"><a
-      href="#first-letter">The ::first-letter
-      pseudo-element</a></td>
-    <td class="origin">1</td></tr>
-  <tr>
