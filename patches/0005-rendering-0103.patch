-    var xValue = element[attributeName];
-    element.setAttribute(scriptAttributeName, "");
-    var emptyValue = element[attributeName];
-    if (tag !== "html")
-        document.body.removeChild(element);
-
-    if (xValue === undefined)
-        return "none";
