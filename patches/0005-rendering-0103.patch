-window.jsTestIsAsync = true;
-
-function escapeUnicodeCharacter(codePoint)
-{
-    var hexCode = codePoint.toString(16);
-    while (hexCode.length < 4)
-        hexCode = "0" + hexCode;
-    return "\\u" + hexCode;
-}
-
-var url = "ws://127.0.0.1:8880/accept-first-subprotocol";
-var separators = "()<>@,;:\\\"/[]?={} \t";
-
-function runTest(codePoint)
-{
