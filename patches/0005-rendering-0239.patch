-                    for (var attrib in this.highlightStyles) {
-                        mySelEl.setAttributeNS(null,attrib,this.highlightStyles[attrib]);
-                    }        
-                    this.elementsArray[idNr].value = true;
-                }
-            }
-            else {
-                if (evt.shiftKey) {
-                    var selectedArray = new Array();
