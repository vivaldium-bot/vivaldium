-                                distance = tempDist;
-                                nearestElement = selectedArray[i];
-                            }
-                        }
-                        if (nearestElement < idNr) {
-                            var lowerIndex = nearestElement;
-                            var upperIndex = idNr;
-                        }
-                        else {
-                            var lowerIndex = idNr;
