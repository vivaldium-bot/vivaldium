-
-    <path id="test2" d="M 10 190 H 190" />
-    <path id="test3" d="" />
-    <path id="test4" />
-</svg>
-<script>
-'use strict';
-test(function() {
-    var test = document.getElementById("test");
-    assert_equals(test.getTotalLength(), 70);
