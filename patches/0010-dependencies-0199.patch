+RtpState RTPSender::GetRtxRtpState() const {
+  rtc::CritScope lock(&send_critsect_);
+
+  RtpState state;
+  state.sequence_number = sequence_number_rtx_;
+  state.start_timestamp = timestamp_offset_;
+
+  return state;
+}
