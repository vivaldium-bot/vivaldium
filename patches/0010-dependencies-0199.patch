+bool VCMCodecDataBase::SendCodec(VideoCodec* current_send_codec) const {
+  if (!ptr_encoder_) {
+    return false;
+  }
+  memcpy(current_send_codec, &send_codec_, sizeof(VideoCodec));
+  return true;
+}
