+
+    webrtc::RTPHeader rtp_header;
+    size_t length = static_cast<size_t>(rtp_sender_->BuildRtpHeader(
+        packet_, kPayload, expect_cvo /* marker_bit */, kTimestamp, 0));
+    if (expect_cvo) {
+      ASSERT_EQ(kRtpHeaderSize + rtp_sender_->RtpHeaderExtensionLength(),
+                length);
