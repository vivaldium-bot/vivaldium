+      "'total_packets': ('number', 'Total packets'),\n"
+      "'ssim': ('number', 'SSIM'),\n"
+      "'psnr': ('number', 'PSNR (dB)'),\n"
+      "}\n");
+  printf("frame_data = [");
+  for (unsigned int i = 0; i < stats.stats_.size(); ++i) {
+    const webrtc::test::FrameStatistic& f = stats.stats_[i];
