+  int64_t process_interval_ms_ GUARDED_BY(crit_sect_.get());
+  bool uma_recorded_;
+
+  RTC_DISALLOW_IMPLICIT_CONSTRUCTORS(RemoteBitrateEstimatorSingleStream);
+};
