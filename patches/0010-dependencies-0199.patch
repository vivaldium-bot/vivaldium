+// See comment below for why we need to use a pointer to a unique_ptr.
+bool SetRawAudioSink_w(VoiceMediaChannel* channel,
+                       uint32_t ssrc,
+                       std::unique_ptr<webrtc::AudioSinkInterface>* sink) {
