+ProtectionType RtpPacketizerH264::GetProtectionType() {
+  return kProtectedPacket;
+}
+
+StorageType RtpPacketizerH264::GetStorageType(
+    uint32_t retransmission_settings) {
+  return kAllowRetransmission;
+}
