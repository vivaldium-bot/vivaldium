+// static
+DeviceInfoDS* DeviceInfoDS::Create(const int32_t id)
+{
+    DeviceInfoDS* dsInfo = new DeviceInfoDS(id);
+    if (!dsInfo || dsInfo->Init() != 0)
+    {
+        delete dsInfo;
+        dsInfo = NULL;
+    }
