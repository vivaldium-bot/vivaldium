+    audio_rtp_extensions_ = extensions;
+  }
+  const RtpHeaderExtensions& audio_rtp_header_extensions() const {
+    return audio_rtp_extensions_;
+  }
+  const VideoCodecs& video_codecs() const { return video_codecs_; }
