+      layers_->FrameEncoded(frame_size_, timestamp, kDefaultQp - 8);
+      bumped_tl0_quality = true;
+    } else {
+      layers_->FrameEncoded(frame_size_, timestamp, kDefaultQp - 8);
+      if (bumped_tl0_quality) {
+        EXPECT_TRUE(vp8_info.layerSync);
+        EXPECT_EQ(ScreenshareLayers::kTl1SyncFlags, flags);
