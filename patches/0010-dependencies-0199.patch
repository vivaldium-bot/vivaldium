+RTPSenderVideo::RTPSenderVideo(Clock* clock, RTPSender* rtp_sender)
+    : rtp_sender_(rtp_sender),
+      clock_(clock),
+      fec_bitrate_(1000, RateStatistics::kBpsScale),
+      video_bitrate_(1000, RateStatistics::kBpsScale) {}
+
+RTPSenderVideo::~RTPSenderVideo() {}
