+class NadaBweSender : public BweSender {
+ public:
+  static const int kMinNadaBitrateKbps;
+
+  NadaBweSender(int kbps, BitrateObserver* observer, Clock* clock);
+  NadaBweSender(BitrateObserver* observer, Clock* clock);
