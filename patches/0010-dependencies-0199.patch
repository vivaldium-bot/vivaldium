+  bool recv;
+
+  RtpTransceiverDirection(bool send, bool recv) : send(send), recv(recv) {}
+
+  bool operator==(const RtpTransceiverDirection& o) const {
+    return send == o.send && recv == o.recv;
+  }
+
+  bool operator!=(const RtpTransceiverDirection& o) const {
+    return !(*this == o);
+  }
