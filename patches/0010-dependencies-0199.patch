+    fShaderId: "fshaderLengthOfConstructor",
+    fShaderSuccess: false,
+    linkSuccess: false,
+    passMsg: "Fragment shader which tries to evaluate the length of a newly constructed array should fail."
+  }
+], 2);
+</script>
+</body>
+</html>
