+#endif  // WEBRTC_MODULES_VIDEO_CODING_UTILITY_IVF_FILE_WRITER_H_
diff --git a/third_party/webrtc/modules/video_coding/utility/ivf_file_writer_unittest.cc b/third_party/webrtc/modules/video_coding/utility/ivf_file_writer_unittest.cc
