+void GetSupportedCryptoSuiteNames(void (*func)(const rtc::CryptoOptions&,
+                                      std::vector<int>*),
+                                  const rtc::CryptoOptions& crypto_options,
+                                  std::vector<std::string>* names) {
+#ifdef HAVE_SRTP
