+  uint32_t timestamp = 0;
+  for (int i = 0; i < 7; ++i) {
+    EXPECT_EQ(expected_flags[i], tl.EncodeFlags(timestamp));
+    tl.PopulateCodecSpecific(true, &vp8_info, 0);
