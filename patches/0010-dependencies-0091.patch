+    int i;
+    float f;
+	lunarStruct1 s1_1;
+};
+
+
+uniform lunarStruct1 foo;
+uniform lunarStruct2 foo2;
+uniform lunarStruct3 foo3;
+
+void main()
+{
+	lunarStruct2 locals2;
+
+	if (foo3.s2_1.i > 0)
+		locals2 = foo3.s2_1;
