+            return;
+        else if (b)
+            color.z++;
+        else {
+            if (color.x < minimum) {
+                discard;
+            } else {
+                color++;
+            }
+        }
+    } else {
+        if (b)
+            discard;
+        else
+            return;
+    }
+
+
+    // // Two path, shared rest
