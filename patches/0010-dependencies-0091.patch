+{
+    vec4 color = BaseColor;
+    vec4 color2;
+
+    color2 = otherColor;
+
+    if (c > d)
+        color += bigColor;
+    else
+        color += smallColor;
+
+    if (color.z < minimum)
+        return;
+
+    color.z++;
+
+    if (color.z > threshhold)
