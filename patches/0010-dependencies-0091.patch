--- /dev/null
+++ b/third_party/ffmpeg/libavformat/gif.c
@@ -0,0 +1,256 @@
+/*
+ * Animated GIF muxer
+ * Copyright (c) 2000 Fabrice Bellard
+ *
+ * first version by Francois Revol <revol@free.fr>
+ *
+ * This file is part of FFmpeg.
+ *
