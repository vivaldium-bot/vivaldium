new file mode 100644
index 0000000000000000000000000000000000000000..1a2d6cdd2b2587bfac2d8ef7ae53880910408459
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/hevc.c
@@ -0,0 +1,1153 @@
