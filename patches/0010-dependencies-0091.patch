+/* XXX: put an inline version */
+int avio_r8(AVIOContext *s)
+{
+    if (s->buf_ptr >= s->buf_end)
+        fill_buffer(s);
+    if (s->buf_ptr < s->buf_end)
+        return *s->buf_ptr++;
+    return 0;
+}
