+}
+
+// TODO: for mats:
+//    asfloat(inU0); \
+//    asint(inF0); \
+//    asuint(inF0); \
+
+// TODO: FXC doesn't accept this with (), but glslang doesn't accept it without.
+#define MATFNS() \
+    all(inF0); \
+    abs(inF0); \
+    acos(inF0); \
+    any(inF0); \
+    asin(inF0); \
+    atan(inF0); \
