diff --git a/third_party/ffmpeg/libavformat/gopher.c b/third_party/ffmpeg/libavformat/gopher.c
new file mode 100644
index 0000000000000000000000000000000000000000..3070b24caf2cfa2ac654c69a126afc365bbcae99
