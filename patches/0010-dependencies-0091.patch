+    track->tag = MKTAG('t','e','x','t');
+    track->timescale = MOV_TIMESCALE;
+    track->par = avcodec_parameters_alloc();
+    if (!track->par)
+        return AVERROR(ENOMEM);
+    track->par->codec_type = AVMEDIA_TYPE_SUBTITLE;
