index 0000000000000000000000000000000000000000..876a6e6a7532a21ff9bf1596eaa54b388c215562
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rawdec.c
@@ -0,0 +1,193 @@
+/*
+ * RAW demuxers
