+/**
+ * mov 'chan' tag reading/writing.
+ * @author Justin Ruggles
+ */
+
+#include <stdint.h>
+
+#include "libavutil/channel_layout.h"
+#include "libavcodec/avcodec.h"
+#include "mov_chan.h"
