diff --git a/third_party/ffmpeg/libavformat/filmstripdec.c b/third_party/ffmpeg/libavformat/filmstripdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..0bf5a80830322318922cf75283ebb82494ab49d8
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/filmstripdec.c
@@ -0,0 +1,115 @@
+/*
+ * Adobe Filmstrip demuxer
+ * Copyright (c) 2010 Peter Ross
+ *
