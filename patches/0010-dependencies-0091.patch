index 0000000000000000000000000000000000000000..acea2e93a641c86d87303e046395e42963ef3f7c
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mpegtsenc.c
@@ -0,0 +1,1984 @@
+/*
+ * MPEG-2 transport stream (aka DVB) muxer
+ * Copyright (c) 2003 Fabrice Bellard
+ *
+ * This file is part of FFmpeg.
+ *
