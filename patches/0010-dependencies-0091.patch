+#include "avformat.h"
+#include "avio_internal.h"
+#include "id3v1.h"
+#include "id3v2.h"
+#include "rawenc.h"
+#include "libavutil/avstring.h"
+#include "libavcodec/mpegaudio.h"
+#include "libavcodec/mpegaudiodata.h"
+#include "libavcodec/mpegaudiodecheader.h"
