diff --git a/third_party/ffmpeg/libavformat/voc_packet.c b/third_party/ffmpeg/libavformat/voc_packet.c
new file mode 100644
index 0000000000000000000000000000000000000000..1e2e19e1c36b97b34b032e74f7c76348d21bacbe
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/voc_packet.c
@@ -0,0 +1,146 @@
+/*
+ * Copyright (c) 2006  Aurelien Jacobs <aurel@gnuage.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
