--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rtpdec_ilbc.c
@@ -0,0 +1,74 @@
+/*
+ * RTP iLBC Depacketizer, RFC 3952
+ * Copyright (c) 2012 Martin Storsjo
