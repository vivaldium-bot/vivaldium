--- /dev/null
+++ b/third_party/ffmpeg/libavformat/flacenc.c
@@ -0,0 +1,214 @@
+/*
+ * raw FLAC muxer
+ * Copyright (c) 2006-2009 Justin Ruggles
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
