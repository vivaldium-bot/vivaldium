+    //     else
+    //         return;
+    // }
+
+
+    // // One path
+    // if (color.w > threshhold2) {
+    //     if (color.z > threshhold2)
+    //         return;
+    //     else {
+    //         if (color.x < minimum) {
+    //             discard;
+    //         } else {
