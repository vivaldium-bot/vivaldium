index 0000000000000000000000000000000000000000..6232c70da243d0aca165779a448b28f9fc15551f
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/dashenc.c
@@ -0,0 +1,1091 @@
+/*
+ * MPEG-DASH ISO BMFF segmenter
+ * Copyright (c) 2014 Martin Storsjo
+ *
