+uint64_t ffio_read_varlen(AVIOContext *bc){
+    uint64_t val = 0;
+    int tmp;
+
+    do{
+        tmp = avio_r8(bc);
+        val= (val<<7) + (tmp&127);
+    }while(tmp&128);
+    return val;
+}
