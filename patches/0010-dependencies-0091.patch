--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rawenc.c
@@ -0,0 +1,416 @@
+/*
+ * RAW muxers
+ * Copyright (c) 2001 Fabrice Bellard
+ * Copyright (c) 2005 Alex Beregszaszi
+ *
