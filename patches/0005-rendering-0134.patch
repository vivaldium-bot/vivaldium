-                expectedEndTimes[currentTimeRange] = currentTime;
-            }
-        } else {
-            expectedEndTimes.splice(currentTimeRange, 0, currentTime);
-        }
-        testRanges(expectedStartTimes, expectedEndTimes);
-        if (nextFunc)
-            nextFunc();
-        else
-            t.done();
-    });
-}
-
-function willCreateNewRange(expectedStartTimes) {
