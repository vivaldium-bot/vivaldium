-<html>
-<head>
-<title>colSpan test</title>
-
-<script type="text/javascript">
-
-function colSpanOne() {
-var x=document.getElementById('myTable1').rows[0].cells
-x[0].colSpan=""
-x[1].colSpan="7"
-}
-
-function colSpanTwo() {
-var x=document.getElementById('myTable2').rows[0].cells
-x[0].colSpan="0"
-x[1].colSpan="0"
-}
-
