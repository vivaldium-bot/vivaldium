+description(
+"This tests that inlining preserves function.arguments functionality if the arguments are reassigned."
+);
+
+function foo() {
+    return bar.arguments;
+}
+
+function bar(a,b,c) {
+    b = a;
+    return foo(a,b,c);
+}
+
+function baz(a,b,c) {
+    return bar(a,b,c);
+}
+
+function argsToStr(args) {
+    var str = args + ": ";
+    for (var i = 0; i < args.length; ++i) {
+        if (i)
+            str += ", ";
+        str += args[i];
+    }
+    return str;
+}
+
