+// loop iteration.
+for (var i = 0; i < 1000; ++i) {
+    var o = baz(i, i + 1);
+    shouldBe("o.a", "bar(2 * i + 1, i)");
+    shouldBe("o.b", "bar(2 * i, i)");
+    shouldBe("o.c", "i");
+}
