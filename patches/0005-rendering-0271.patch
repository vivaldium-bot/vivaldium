+    var array1 = bar(a,b,c);
+    var array2 = fuzz(a,b,c);
+    var result = [];
+    for (var i = 0; i < array1.length; ++i)
+        result.push(array1[i]);
+    for (var i = 0; i < array2.length; ++i)
+        result.push(array2[i]);
+    return result;
+}
