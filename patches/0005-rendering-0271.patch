+            }
+            var getResult = date["get" + functionNameRoot]();
+            if (!isNaN(getResult)) {
+                testFailed("date.get" + functionNameRoot + "() was "
+                                      + getResult + " instead of NaN");
+                result = false;
+            }
+        } else if (!makeIEHappy(functionNameRoot))
