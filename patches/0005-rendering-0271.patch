+MachineType kMachineTypes[] = {
+    MachineType::AnyTagged(), MachineType::AnyTagged(),
+    MachineType::AnyTagged(), MachineType::AnyTagged(),
+    MachineType::AnyTagged(), MachineType::AnyTagged(),
+    MachineType::AnyTagged(), MachineType::AnyTagged()};
