+TEST_F(WasmDecoderTest, BreakNesting_6_levels) {
+  for (int mask = 0; mask < 64; mask++) {
+    for (int i = 0; i < 14; i++) {
+      byte code[] = {
+          kExprBlock, 1,  // --
+          kExprBlock, 1,  // --
+          kExprBlock, 1,  // --
+          kExprBlock, 1,  // --
+          kExprBlock, 1,  // --
+          kExprBlock, 1,  // --
+          kExprBr,    static_cast<byte>(i),
+          kExprNop  // --
+      };
+
+      int depth = 6;
+      for (int l = 0; l < 6; l++) {
+        if (mask & (1 << l)) {
+          code[l * 2] = kExprLoop;
+          depth++;
+        }
+      }
+
+      if (i < depth) {
+        EXPECT_VERIFIES(&env_v_v, code);
+      } else {
+        EXPECT_FAILURE(&env_v_v, code);
+      }
+    }
+  }
+}
