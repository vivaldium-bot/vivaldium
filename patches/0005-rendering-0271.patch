+
+    z = bar(1);
+
+    return z.length;
+}
+
+function bar(x) {
+    var a = [];
+    a[x] = 1;
+
+    return a;
+}
+
+for (var i = 0; i < 1000; ++i) {
+    shouldBe("foo()", "2");
