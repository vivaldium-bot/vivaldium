+void LCodeGen::DoCheckValue(LCheckValue* instr) {
+  Register reg = ToRegister(instr->value());
+  __ Cmp(reg, instr->hydrogen()->object().handle());
+  DeoptimizeIf(not_equal, instr, DeoptimizeReason::kValueMismatch);
+}
