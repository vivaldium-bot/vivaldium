-		<image x="25" y="187" width="430" height="48" xlink:href="resources/gam200.png"/>
-		<text x="25" y="285" font-size="40">Gamma correction</text>
-	</g>
-	<text id="revision" x="10" y="340" font-size="40" stroke="none" fill="black">$Revision: 1.6 $</text>
