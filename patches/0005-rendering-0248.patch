+bool HValue::CanReplaceWithDummyUses() {
+  return FLAG_unreachable_code_elimination &&
+      !(block()->IsReachable() ||
+        IsBlockEntry() ||
+        IsControlInstruction() ||
+        IsArgumentsObject() ||
+        IsCapturedObject() ||
+        IsSimulate() ||
+        IsEnterInlined() ||
+        IsLeaveInlined());
