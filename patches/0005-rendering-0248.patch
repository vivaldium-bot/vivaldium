+    HInstruction* result = AddInstruction(NewUncasted<I>(p1, p2));
+    // Specializations must have their parameters properly casted
+    // to avoid landing here.
+    DCHECK(!result->IsSimulate());
+    return result;
+  }
+
+  template<class I, class P1, class P2>
