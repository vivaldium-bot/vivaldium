+static void ThrowV8Exception(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  ApiTestFuzzer::Fuzz();
+  v8::Local<String> foo = v8_str("foo");
+  v8::Local<String> message = v8_str("message");
