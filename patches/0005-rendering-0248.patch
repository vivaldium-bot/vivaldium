+  LocalContext context;
+  bool should_be_neuterable = !i::FLAG_turbo_asm;
+  const char* load =
+      "function Module(stdlib, foreign, heap) {"
+      "  'use asm';"
+      "  var MEM32 = new stdlib.Int32Array(heap);"
