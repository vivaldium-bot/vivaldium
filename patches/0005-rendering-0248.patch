+Local<String> SourceGroup::ReadFile(Isolate* isolate, const char* name) {
+  int size;
+  char* chars = ReadChars(isolate, name, &size);
+  if (chars == NULL) return Local<String>();
+  Local<String> result =
+      String::NewFromUtf8(isolate, chars, NewStringType::kNormal, size)
+          .ToLocalChecked();
+  delete[] chars;
+  return result;
+}
