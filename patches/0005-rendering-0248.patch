+    CHECK(!initial_map->IsInobjectSlackTrackingInProgress());
+    CHECK(!IsObjectShrinkable(*obj));
+
+    // No slack left.
+    CHECK_EQ(kMaxInobjectProperties, obj->map()->GetInObjectProperties());
+  }
