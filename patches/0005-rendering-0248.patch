+    Label break_label_;
+  };
+
+  // An iteration statement such as a while, for, or do loop.
+  class Iteration : public Breakable {
+   public:
+    Iteration(FullCodeGenerator* codegen, IterationStatement* statement)
+        : Breakable(codegen, statement) {
