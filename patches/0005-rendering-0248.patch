+    }
+
+    template<class Condition, class P2>
+    Condition* AndIf(HValue* p1, P2 p2) {
+      And();
+      return If<Condition>(p1, p2);
+    }
+
+    template<class Condition, class P2, class P3>
+    Condition* AndIf(HValue* p1, P2 p2, P3 p3) {
+      And();
+      return If<Condition>(p1, p2, p3);
+    }
