+class LockUnlockLockThread : public JoinableThread {
+ public:
+  LockUnlockLockThread(v8::Isolate* isolate, v8::Local<v8::Context> context)
+      : JoinableThread("LockUnlockLockThread"),
+        isolate_(isolate),
+        context_(isolate, context) {}
