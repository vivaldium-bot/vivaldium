+
+  DCHECK(graph != NULL);
+  BailoutReason bailout_reason = kNoReason;
+  if (!graph->Optimize(&bailout_reason)) {
+    FATAL(GetBailoutReason(bailout_reason));
+  }
+  LChunk* chunk = LChunk::NewChunk(graph);
+  if (chunk == NULL) {
+    FATAL(GetBailoutReason(graph->info()->bailout_reason()));
+  }
+  return chunk;
+}
