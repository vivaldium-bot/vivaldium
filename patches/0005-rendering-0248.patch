+
+void LiveEdit::FunctionSourceUpdated(Handle<JSArray> shared_info_array) {
+  SharedInfoWrapper shared_info_wrapper(shared_info_array);
+  Handle<SharedFunctionInfo> shared_info = shared_info_wrapper.GetInfo();
