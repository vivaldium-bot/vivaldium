+int LPlatformChunk::GetNextSpillIndex(RegisterKind kind) {
+  // Skip a slot if for a double-width slot.
+  if (kind == DOUBLE_REGISTERS) {
+    current_frame_slots_++;
+    current_frame_slots_ |= 1;
+    num_double_slots_++;
+  }
+  return current_frame_slots_++;
+}
