+  if (expected_input_types_.Contains(ToBooleanICStub::HEAP_NUMBER)) {
+    return Representation::Double();
+  }
+  if (expected_input_types_.Contains(ToBooleanICStub::SMI)) {
+    return Representation::Smi();
+  }
+  return Representation::None();
