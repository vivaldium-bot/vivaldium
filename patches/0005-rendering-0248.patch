+  env->GetIsolate()->EnqueueMicrotask(
+      Function::New(env.local(), MicrotaskTwo).ToLocalChecked());
+  CompileRun("1+1;");
+  CHECK_EQ(2, CompileRun("ext1Calls")->Int32Value(env.local()).FromJust());
