+  class SaveDoublesBits : public BitField<bool, 0, 1> {};
+  class ArgvMode : public BitField<bool, 1, 1> {};
+  class FrameTypeBits : public BitField<bool, 2, 1> {};
+  class ResultSizeBits : public BitField<int, 3, 3> {};
