+Debug.setListener = function(listener, opt_data) {
+  if (!IS_FUNCTION(listener) && !IS_UNDEFINED(listener) && !IS_NULL(listener)) {
+    throw MakeTypeError(kDebuggerType);
+  }
+  %SetDebugEventListener(listener, opt_data);
+};
