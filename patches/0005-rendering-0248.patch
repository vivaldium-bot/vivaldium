+
+static void IDeleter(uint32_t index,
+                     const v8::PropertyCallbackInfo<v8::Boolean>& info) {
+  if (index != 2) {
+    return;  // not intercepted
+  }
+
+  info.GetReturnValue().Set(false);  // intercepted, don't delete the property
+}
