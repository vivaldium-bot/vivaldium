-    <TD WIDTH=2   BGCOLOR="#99cccc"> blue </TD>
-    <TD WIDTH=198>                   that </TD>
-  </TR>
-  <TR>
-<td width=80>x</td>
-    <TD COLSPAN=3 BGCOLOR="#99cccc"> blue (colspan=3) --- spans correctly</TD>
-  </TR></TABLE>
-
-
-<BR>
-
-
-
-
-</body></html>
