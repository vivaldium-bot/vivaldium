+HValue* HCheckInstanceType::Canonicalize() {
+  if ((check_ == IS_JS_RECEIVER && value()->type().IsJSReceiver()) ||
+      (check_ == IS_JS_ARRAY && value()->type().IsJSArray()) ||
+      (check_ == IS_STRING && value()->type().IsString())) {
