+
+void Schedule::SetBlockForNode(BasicBlock* block, Node* node) {
+  if (node->id() >= nodeid_to_block_.size()) {
+    nodeid_to_block_.resize(node->id() + 1);
+  }
+  nodeid_to_block_[node->id()] = block;
+}
