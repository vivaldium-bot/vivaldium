+void StackGuard::set_interrupt_limits(const ExecutionAccess& lock) {
+  DCHECK(isolate_ != NULL);
+  thread_local_.set_jslimit(kInterruptLimit);
+  thread_local_.set_climit(kInterruptLimit);
+  isolate_->heap()->SetStackLimits();
+}
