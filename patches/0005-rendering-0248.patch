+void HValue::AddNewRange(Range* r, Zone* zone) {
+  if (!HasRange()) ComputeInitialRange(zone);
+  if (!HasRange()) range_ = new(zone) Range();
+  DCHECK(HasRange());
+  r->StackUpon(range_);
+  range_ = r;
+}
