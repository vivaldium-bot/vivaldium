+  // 6. Fallback to the runtime to create new object.
+  __ bind(&new_object);
+  {
+    FrameScope scope(masm, StackFrame::MANUAL);
+    FastNewObjectStub stub(masm->isolate());
+    __ SmiTag(r6);
+    __ EnterBuiltinFrame(cp, r1, r6);
+    __ Push(r2);  // first argument
+    __ CallStub(&stub);
