+  mov(FieldOperand(result, HeapObject::kMapOffset),
+      Immediate(isolate()->factory()->one_byte_string_map()));
+  mov(scratch1, length);
+  SmiTag(scratch1);
+  mov(FieldOperand(result, String::kLengthOffset), scratch1);
