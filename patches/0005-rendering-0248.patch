+static void* expected_ptr;
+static void callback(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  void* ptr = v8::External::Cast(*args.Data())->Value();
+  CHECK_EQ(expected_ptr, ptr);
+  args.GetReturnValue().Set(true);
+}
