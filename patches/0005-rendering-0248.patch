+  PrepareForBailoutForId(prop->LoadId(), BailoutState::TOS_REGISTER);
+
+  // Replace home_object with target function.
+  __ mov(Operand(esp, kPointerSize), eax);
+
+  // Stack here:
+  // - target function
+  // - this (receiver)
+  EmitCall(expr);
+}
