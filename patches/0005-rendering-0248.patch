+  F2 f = FUNCTION_CAST<F2>(code->entry());
+
+  uint32_t res = reinterpret_cast<uint32_t>(CALL_GENERATED_CODE(
+      isolate, f, rs_value, rt_value, 0, 0, 0));
+
+  return res;
+}
