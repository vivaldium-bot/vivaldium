+  __ push(StoreDescriptor::ValueRegister());
+  __ push(Immediate(Smi::FromInt(language_mode)));
+  __ push(ebx);  // return address
+
+  // Do tail-call to runtime routine.
+  __ TailCallRuntime(Runtime::kSetProperty);
+}
