-<!-- Basic test of 'textLength' and 'lengthAdjust' attributes.             -->
-<!--                                                                       -->
-<!-- Author : Lofton Henderson, 29-aug-2000.                               -->
-<!--          1.1 revision by Rick Graham                                  -->
-<!-- Revised for SVGT/B : Mathias Larsson Carlander Aug/20/2002               -->
