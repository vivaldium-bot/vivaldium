+  CHECK_EQ(2, weak_entries);
+  const v8::HeapGraphNode* wm_s =
+      GetProperty(wm, v8::HeapGraphEdge::kProperty, "str");
+  CHECK(wm_s);
+  CHECK_EQ(s->GetId(), wm_s->GetId());
