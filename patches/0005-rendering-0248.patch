diff --git a/v8/test/js-perf-test/Object/entries.js b/v8/test/js-perf-test/Object/entries.js
new file mode 100644
index 0000000000000000000000000000000000000000..0658b7983d77bfac6e96e6f98514d2fe1a051c75
--- /dev/null
