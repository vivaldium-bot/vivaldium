+LargeObjectSpace::LargeObjectSpace(Heap* heap, AllocationSpace id)
+    : Space(heap, id, NOT_EXECUTABLE),  // Managed on a per-allocation basis
+      first_page_(NULL),
+      size_(0),
+      page_count_(0),
+      objects_size_(0),
+      chunk_map_(base::HashMap::PointersMatch, 1024) {}
