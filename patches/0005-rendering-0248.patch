+      return MarkAsWord32(node), VisitInt32x4ExtractLane(node);
+    default:
+      V8_Fatal(__FILE__, __LINE__, "Unexpected operator #%d:%s @ node #%d",
+               node->opcode(), node->op()->mnemonic(), node->id());
+      break;
+  }
+}
