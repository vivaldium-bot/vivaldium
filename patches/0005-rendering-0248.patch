+  DCHECK(ToRegister(instr->key()).is(LoadDescriptor::NameRegister()));
+
+  EmitVectorLoadICRegisters<LLoadKeyedGeneric>(instr);
+
+  Handle<Code> ic = CodeFactory::KeyedLoadICInOptimizedCode(isolate()).code();
