+
+  // Assemble a simple function that adds arguments returning the sum.
+  __ movq(rax, arg2);
+  __ addq(rax, arg1);
+  __ ret(0);
+
+  CodeDesc desc;
+  assm.GetCode(&desc);
+  // Call the function from C++.
+  int result =  FUNCTION_CAST<F2>(buffer)(3, 2);
+  CHECK_EQ(5, result);
+}
