+void LCodeGen::DoIsSmiAndBranch(LIsSmiAndBranch* instr) {
+  Condition is_smi;
+  if (instr->value()->IsRegister()) {
+    Register input = ToRegister(instr->value());
+    is_smi = masm()->CheckSmi(input);
+  } else {
+    Operand input = ToOperand(instr->value());
+    is_smi = masm()->CheckSmi(input);
+  }
+  EmitBranch(instr, is_smi);
+}
