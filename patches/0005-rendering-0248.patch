+  this.column_ = opt_column;
+  this.groupId_ = opt_groupId;
+  this.position_alignment_ = IS_UNDEFINED(opt_position_alignment)
+      ? Debug.BreakPositionAlignment.Statement : opt_position_alignment;
+  this.active_ = true;
+  this.condition_ = null;
+  this.break_points_ = [];
