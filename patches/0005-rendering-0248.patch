+    NestedStatement* Exit(int* context_length) override {
+      auto block_scope = statement()->AsBlock()->scope();
+      if (block_scope != nullptr) {
+        if (block_scope->ContextLocalCount() > 0) ++(*context_length);
+      }
+      return previous_;
+    }
