+void ApiTestFuzzer::ContextSwitch() {
+  // If the new thread is the same as the current thread there is nothing to do.
+  if (NextThread()) {
+    // Now it can start.
+    v8::Unlocker unlocker(CcTest::isolate());
+    // Wait till someone starts us again.
+    gate_.Wait();
+    // And we're off.
+  }
+}
