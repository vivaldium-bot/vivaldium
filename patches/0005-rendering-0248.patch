+static void NamedGetterWithCallingContextCheck(
+    v8::Local<v8::String> name,
+    const v8::PropertyCallbackInfo<v8::Value>& info) {
+  CHECK_EQ(0, strcmp(*v8::String::Utf8Value(name), "a"));
