+template <class Iterator, class EndMark>
+bool SubStringEquals(Iterator* current,
+                     EndMark end,
+                     const char* substring) {
+  DCHECK(**current == *substring);
+  for (substring++; *substring != '\0'; substring++) {
+    ++*current;
+    if (*current == end || **current != *substring) return false;
+  }
+  ++*current;
+  return true;
+}
