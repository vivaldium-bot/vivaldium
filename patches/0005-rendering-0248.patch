- <tr id='tr'>
-   <!-- this div is just here to demonstrate that the crash
-        only happens with a dhtml-generated div -->
-  <div id="popup" style="position:absolute;">
-   div
-  </div>
-  <td id='td'>
-   table
-  </td>
- </tr>
-</table>
-
-</body>
-</html>
