+    __ mov(edx, Immediate(4));
+
+    __ inc(eax);
+    __ sarx(ebx, ecx, edx);
+    __ cmp(ebx, Immediate(0x05566778u));  // expected result
+    __ j(not_equal, &exit);
+
+    __ inc(eax);
+    __ sarx(ebx, Operand(esp, 0), edx);
+    __ cmp(ebx, Immediate(0x05566778u));  // expected result
+    __ j(not_equal, &exit);
+
+    // shlx
+    __ mov(edx, Immediate(4));
+
+    __ inc(eax);
