+  JSObject::DefinePropertyOrElementIgnoreAttributes(array, name, value_smi,
+                                                    NONE)
+      .Check();
+  CHECK_EQ(array->map(), *previous_map);
+  CHECK_EQ(array->map()->elements_kind(), FAST_HOLEY_SMI_ELEMENTS);
+  CHECK_EQ(2, Smi::cast(array->length())->value());
