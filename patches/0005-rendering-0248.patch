+function argv0() {
+  return arguments[index];
+}
+
+function argv1(i) {
+  return arguments[index];
+}
+
+function argv2(i, j) {
+  return arguments[index];
+}
+
+index = 0;
+assertEquals(7, argv0(7));
+assertEquals(7, argv0(7, 8));
+assertEquals(7, argv0(7, 8, 9));
+assertEquals(7, argv1(7));
+assertEquals(7, argv1(7, 8));
