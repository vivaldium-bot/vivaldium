+      status_(UNUSED),
+      current_block_(-1),
+      current_instruction_(-1),
+      instructions_(chunk->instructions()),
+      deoptimizations_(4, info->zone()),
+      deoptimization_literals_(8, info->zone()),
+      translations_(info->zone()),
+      inlined_function_count_(0),
