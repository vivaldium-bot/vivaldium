+#define HARNESS_PREAMBLE()                          \
+  const char test_function[] =                      \
+      "function Module(stdlib, foreign, buffer) { " \
+      "\"use asm\"; " HARNESS_STDLIB() HARNESS_HEAP()
+
+#define HARNESS_POSTAMBLE() \
+  "return { foo: foo }; "   \
+  "} ";
