+
+  Handle<JSArray> array =
+      factory->NewJSArray(ElementsKind::FAST_SMI_ELEMENTS, 0, 0);
+  Handle<Map> previous_map(array->map());
+  CHECK_EQ(previous_map->elements_kind(), FAST_SMI_ELEMENTS);
