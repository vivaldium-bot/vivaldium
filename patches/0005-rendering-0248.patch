+  if (*file == NULL) {
+    Throw(args.GetIsolate(), "Error loading file");
+    return;
+  }
+  Local<String> source = ReadFile(args.GetIsolate(), *file);
+  if (source.IsEmpty()) {
+    Throw(args.GetIsolate(), "Error loading file");
+    return;
+  }
+  args.GetReturnValue().Set(source);
+}
