+UNINITIALIZED_TEST(StartupSerializerTwiceRunScript) {
+  DisableTurbofan();
+  v8::Isolate* isolate = TestIsolate::NewInitialized(true);
+  Vector<const byte> blob1 = Serialize(isolate);
