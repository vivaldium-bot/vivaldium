+
+	ctx.beginSection("GL_INVALID_OPERATION is generated if zero is bound to target.");
+	ctx.glBindBuffer			(GL_ARRAY_BUFFER, 0);
+	ctx.glFlushMappedBufferRange(GL_ARRAY_BUFFER, 0, 8);
+	ctx.expectError				(GL_INVALID_OPERATION);
