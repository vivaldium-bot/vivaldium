+enum
+{
+	VIEWPORT_WIDTH			= 64,
+	VIEWPORT_HEIGHT			= 64,
+
+	TEXTURE_2D_WIDTH		= 64,
+	TEXTURE_2D_HEIGHT		= 64,
+	TEXTURE_2D_FORMAT		= GL_RGBA,
+	TEXTURE_2D_DATA_TYPE	= GL_UNSIGNED_BYTE,
+
