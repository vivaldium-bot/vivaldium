+    mov          r6d, r4d
+    shl          r4d, 8
+    sub           r4, r6
+    mov           r6, 8
+    add           r4, 8           ; x*288+8 = x<<8 | (8-x)
+    sub          r6d, r5d
+    imul          r6, r4          ; (8-y)*(x*255+8) = (8-y)*x<<8 | (8-y)*(8-x)
