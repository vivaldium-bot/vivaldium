+class CaseFactory
+{
+public:
+	virtual						~CaseFactory	(void) {}
+	virtual MovePtr<TestNode>	createCase		(const Context& ctx) const = 0;
+	virtual string				getName			(void) const = 0;
+	virtual string				getDesc			(void) const = 0;
