diff --git a/third_party/ffmpeg/libavcodec/x86/blockdsp.asm b/third_party/ffmpeg/libavcodec/x86/blockdsp.asm
new file mode 100644
index 0000000000000000000000000000000000000000..9d203df8f5217d582c890789971db30260c46887
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/blockdsp.asm
@@ -0,0 +1,88 @@
+;******************************************************************************
+;* SIMD-optimized clear block functions
+;* Copyright (c) 2002 Michael Niedermayer
+;* Copyright (c) 2008 Loren Merritt
+;* Copyright (c) 2009 Fiona Glaser
+;*
