+int InterfaceBlockDataSizeTestCase::getBlockMinDataSize (const glu::InterfaceBlock& block) const
+{
+	int dataSize = 0;
+
+	for (int ndx = 0; ndx < (int)block.variables.size(); ++ndx)
+		dataSize += getVarTypeSize(block.variables[ndx].varType);
+
+	return dataSize;
+}
