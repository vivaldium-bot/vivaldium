+template <typename T>
+ExprP<T> alternatives (const ExprP<T>& arg0,
+					   const ExprP<T>& arg1)
+{
+	return createApply<typename Alternatives<T>::Sig>(instance<Alternatives<T> >(), arg0, arg1);
+}
