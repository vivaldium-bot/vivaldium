+enum RenderBits
+{
+	RENDERBITS_NONE					= 0,
+	RENDERBITS_AS_VERTEX_ARRAY		= (0x1<<0),
+	RENDERBITS_AS_INDEX_ARRAY		= (0x1<<1),
+	RENDERBITS_AS_VERTEX_TEXTURE	= (0x1<<2),
+	RENDERBITS_AS_FRAGMENT_TEXTURE	= (0x1<<3)
+};
