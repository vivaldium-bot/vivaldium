+static const char* const s_colorFragmentShader =		"#version 310 es\n"
+														"in mediump vec4 v_color;\n"
+														"layout(location = 0) out mediump vec4 fragColor;\n"
+														"void main (void)\n"
+														"{\n"
+														"	fragColor = v_color;\n"
+														"}\n";
