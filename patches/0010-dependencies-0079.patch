+    [NSException raise:NSInvalidArgumentException format:@"host, path and name must be provided."];
+  }
+  NSError *error = nil;
+  NSString *certs = [NSString stringWithContentsOfFile:certsPath
+                                                      encoding:NSUTF8StringEncoding
+                                                      error:&error];
+  if (error != nil) {
