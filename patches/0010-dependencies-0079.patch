+static inline bool isFormatTypeUnsignedInteger (TextureFormat::ChannelType type)
+{
+	return type == TextureFormat::UNSIGNED_INT8		||
+		   type == TextureFormat::UNSIGNED_INT16	||
+		   type == TextureFormat::UNSIGNED_INT32;
+}
