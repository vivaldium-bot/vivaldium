+
+TCU_DECLARE_VECTOR_BINARY_FUNC(pow, deFloatPow)
+TCU_DECLARE_VECTOR_UNARY_FUNC(exp, deFloatExp)
+TCU_DECLARE_VECTOR_UNARY_FUNC(log, deFloatLog)
