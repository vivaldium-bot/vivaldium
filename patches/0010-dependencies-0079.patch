+glu::ShaderProgram* InterCallTestCase::genReadInterleavedProgram (int seed0, int seed1)
+{
+	const bool			useImageAtomics = m_useAtomic && m_storage == STORAGE_IMAGE;
+	std::ostringstream	buf;
+
+	buf << "#version 310 es\n"
