+#if defined(min)
+#	undef min
+#endif
+#if defined(max)
+#	undef max
+#endif
+
+TCU_DECLARE_VECTOR_UNARY_FUNC(negate, negate)
+TCU_DECLARE_VECTOR_UNARY_FUNC(bitwiseNot, bitwiseNot)
