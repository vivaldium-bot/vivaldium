+int getNBitIntegerMaxValue (bool isSigned, int numBits)
+{
+	DE_ASSERT(numBits < 32);
+
+	if (numBits == 0)
+		return 0;
+	else if (isSigned)
+		return deIntMaxValue32(numBits);
+	else
+		return deUintMaxValue32(numBits);
+}
