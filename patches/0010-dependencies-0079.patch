+	void getInputValues (int numValues, void* const* values) const
+	{
+		const Vec2 ranges[] =
+		{
+			Vec2(-2.0f,		2.0f),	// lowp
+			Vec2(-1e3f,		1e3f),	// mediump
+			Vec2(-1e7f,		1e7f)	// highp
