+	ctx.glScissor(0, 0, 0, -1);
+	ctx.expectError(GL_INVALID_VALUE);
+	ctx.glScissor(0, 0, -1, -1);
+	ctx.expectError(GL_INVALID_VALUE);
+	ctx.endSection();
