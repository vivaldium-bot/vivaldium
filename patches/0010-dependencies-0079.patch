+++ b/third_party/ffmpeg/libavcodec/x86/mdct15_init.c
@@ -0,0 +1,104 @@
+/*
+ * SIMD optimized non-power-of-two MDCT functions
+ *
+ * Copyright (C) 2017 Rostislav Pehlivanov <atomnuker@gmail.com>
+ *
