index 0000000000000000000000000000000000000000..162560d4114d7e022b1b11c13c13cc72725d26fc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/idctdsp_init.c
@@ -0,0 +1,161 @@
+/*
