+		CASE_INTERPOLATE_GLOBAL,
+		CASE_INTERPOLATE_CONSTANT,
+
+		CASE_LAST
+	};
+	enum InterpolatorType
+	{
+		INTERPOLATE_AT_SAMPLE = 0,
+		INTERPOLATE_AT_CENTROID,
+		INTERPOLATE_AT_OFFSET,
+
+		INTERPOLATE_LAST
+	};
