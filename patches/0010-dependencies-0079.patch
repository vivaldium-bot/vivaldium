+		case CUBEFACE_POSITIVE_X:	return str << "CUBEFACE_POSITIVE_X";
+		case CUBEFACE_NEGATIVE_Y:	return str << "CUBEFACE_NEGATIVE_Y";
+		case CUBEFACE_POSITIVE_Y:	return str << "CUBEFACE_POSITIVE_Y";
