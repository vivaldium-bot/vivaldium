index 0000000000000000000000000000000000000000..7b2d1750deb9959417cb8620f24b9a8cf2e5bfa2
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/webvttdec.c
@@ -0,0 +1,110 @@
