+	swizzle.m_swizzle[1] = TEXTURESWIZZLECOMPONENT_G;
+	swizzle.m_swizzle[2] = TEXTURESWIZZLECOMPONENT_B;
+	swizzle.m_swizzle[3] = TEXTURESWIZZLECOMPONENT_A;
