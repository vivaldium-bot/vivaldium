+glu::DataType ImageBindingRenderCase::getImageTexCoordType(void) const
+{
+	switch (m_imageType)
+	{
+		case GL_IMAGE_2D:
+			return glu::TYPE_INT_VEC2;
+
+		case GL_IMAGE_3D:
+			return glu::TYPE_INT_VEC3;
+
+		default:
+			DE_ASSERT(false);
+			return glu::TYPE_INVALID;
+	}
+}
