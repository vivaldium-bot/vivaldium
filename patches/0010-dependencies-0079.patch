+static const char* getVerifierSuffix (QueryType type)
+{
+	switch (type)
+	{
+		case QUERY_TEXTURE_LEVEL_FLOAT:		return "_float";
+		case QUERY_TEXTURE_LEVEL_INTEGER:	return "_integer";
+		default:
+			DE_ASSERT(DE_FALSE);
+			return DE_NULL;
+	}
+}
