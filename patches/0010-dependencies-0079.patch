+enum ModifyBits
+{
+	MODIFYBITS_NONE					= 0,
+	MODIFYBITS_BUFFERDATA			= (0x1<<0),
+	MODIFYBITS_BUFFERSUBDATA		= (0x1<<1),
+	MODIFYBITS_MAPBUFFER_WRITE		= (0x1<<2),
+	MODIFYBITS_MAPBUFFER_READWRITE	= (0x1<<3),
+};
