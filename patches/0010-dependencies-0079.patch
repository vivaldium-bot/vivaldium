+	GS = (1<<glu::SHADERTYPE_GEOMETRY),
+	FS = (1<<glu::SHADERTYPE_FRAGMENT),
+	CS = (1<<glu::SHADERTYPE_COMPUTE),
+
+	SHADER_TYPES = VS|TC|TE|GS|FS|CS
+};
