+	gl.viewport(0, 0, width, height);
+	glu::draw(renderCtx, program.getProgram(), DE_LENGTH_OF_ARRAY(vertexArrays), &vertexArrays[0],
+			  glu::pr::Triangles(DE_LENGTH_OF_ARRAY(indices), &indices[0]));
+}
