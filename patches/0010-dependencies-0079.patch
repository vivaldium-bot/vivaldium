+std::string GridRenderCase::getFragmentSource (void)
+{
+	const char* source = "${VERSION_DECL}\n"
+						 "flat in mediump vec4 v_color;\n"
+						 "layout(location = 0) out mediump vec4 fragColor;\n"
+						 "void main (void)\n"
+						 "{\n"
