+GLuint TextureSamplerTest::createTexture (const glw::Functions& gl, GLenum target)
+{
+	switch (target)
+	{
+		case GL_TEXTURE_2D:
+			return createTexture2D(gl);
+
+		case GL_TEXTURE_3D:
+			return createTexture3D(gl);
+
+		case GL_TEXTURE_CUBE_MAP:
+			return createTextureCube(gl);
+
+		default:
+			DE_ASSERT(false);
+			return (GLuint)-1;
+	}
