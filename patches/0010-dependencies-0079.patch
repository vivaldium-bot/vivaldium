+template <typename T>
+class Sampling
+{
+public:
+	virtual void	genFixeds	(const FloatFormat&, vector<T>&)			const {}
+	virtual T		genRandom	(const FloatFormat&, Precision, Random&)	const { return T(); }
+	virtual double	getWeight	(void)										const { return 0.0; }
+};
