+		ANDROID_NDK_HOST_OS STREQUAL "linux-x86_64" OR
+		ANDROID_NDK_HOST_OS STREQUAL "darwin-x86" OR
+		ANDROID_NDK_HOST_OS STREQUAL "darwin-x86_64")
