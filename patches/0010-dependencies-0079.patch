+ShaderImageLoadStoreTests::ShaderImageLoadStoreTests (Context& context)
+	: TestCaseGroup(context, "image_load_store", "Shader Image Load & Store Tests")
+{
+}
+
+ShaderImageLoadStoreTests::~ShaderImageLoadStoreTests (void)
