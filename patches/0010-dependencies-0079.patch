+static inline bool isFormatTypeSnorm (TextureFormat::ChannelType type)
+{
+	return type == TextureFormat::SNORM_INT8	||
+		   type == TextureFormat::SNORM_INT16	||
+		   type == TextureFormat::SNORM_INT32;
+}
