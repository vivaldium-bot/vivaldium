+		ctx.expectError(GL_INVALID_VALUE);
+		ctx.glTexStorage2D(GL_TEXTURE_CUBE_MAP, 1, GL_RGBA8, 0, 0);
+		ctx.expectError(GL_INVALID_VALUE);
+	}
+	ctx.endSection();
+
+	ctx.glDeleteTextures(2, textures);
