+void ff_h264_idct ## NUM ## _add ## REP ## _ ## DEPTH ## _ ## OPT     \
+    (uint8_t **dst, const int *block_offset,                          \
+     int16_t *block, int stride, const uint8_t nnzc[6 * 8]);
