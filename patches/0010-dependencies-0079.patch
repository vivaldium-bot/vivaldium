+			{
+				const deUint32 inputValue = *(const deUint32*)((const deUint8*)inputs + inputStride*(groupOffset+localNdx));
+				expectedValue |= inputValue;
+			}
+
+			if ((groupOutput & compareMask) != (expectedValue & compareMask))
