+    lea     r4, [stride_q*3]
+    dec     alpha_d        ; alpha-1
+    neg     r4
+    dec     beta_d        ; beta-1
+    add     base3_q, pix_q     ; pix-3*stride
+
+    mova    m0, [base3_q + stride_q]   ; p1
+    mova    m1, [base3_q + 2*stride_q] ; p0
+    mova    m2, [pix_q]      ; q0
+    mova    m3, [pix_q + stride_q]   ; q1
