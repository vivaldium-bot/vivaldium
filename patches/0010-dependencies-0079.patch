+	ctx.glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, tex2DMS);
+	ctx.glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTexSize);
+	ctx.glGetIntegerv(GL_MAX_CUBE_MAP_TEXTURE_SIZE, &maxTexCubeSize);
