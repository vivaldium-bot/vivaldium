+												"uniform mediump ivec4 ivec4_f;\n"
+												"uniform mediump uvec4 uvec4_f;\n"
+												"uniform sampler2D sampler_f;\n"
+												"layout(location = 0) out mediump vec4 fragColor;"
+												"void main (void)\n"
