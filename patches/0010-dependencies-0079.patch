+	, m_glBuffer		(0)
+	, m_bound			(false)
+	, m_attribNdx		(0)
+	, m_size			(0)
+	, m_data			(DE_NULL)
+	, m_componentCount	(1)
+	, m_target			(Array::TARGET_ARRAY)
+	, m_inputType		(Array::INPUTTYPE_FLOAT)
+	, m_outputType		(Array::OUTPUTTYPE_VEC4)
+	, m_normalize		(false)
+	, m_stride			(0)
