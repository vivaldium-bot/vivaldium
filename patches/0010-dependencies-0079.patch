+		: textureType		(texType)
+		, textureUnit		(unit)
+		, width				(width_)
+		, height			(height_)
+		, format			(format_)
+		, dataType			(dataType_)
+		, internalFormat	(internalFormat_)
+		, useMipmap			(useMipmap_)
+		, minFilter			(minFilter_)
+		, magFilter			(magFilter_)
+		, sWrap				(sWrap_)
+		, tWrap				(tWrap_)
+		, minValue			(minValue_)
+		, maxValue			(maxValue_)
