+	}
+	else
+	{
+		for (int levelNdx = 0; levelNdx < (int)spec.levels.size(); ++levelNdx)
+		{
+			const int queryLevel	= spec.levels[levelNdx].level;
+			const int refValue		= getComponentType(spec.levels[levelNdx].internalFormat);
