+	const bool hasFirst		= (m_method == gls::DrawTestSpec::DRAWMETHOD_DRAWARRAYS_INDIRECT);
+
+	const gls::DrawTestSpec::Primitive primitive[] =
+	{
+		gls::DrawTestSpec::PRIMITIVE_POINTS,
