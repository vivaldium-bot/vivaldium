diff --git a/third_party/grpc/src/php/ext/grpc/channel_credentials.c b/third_party/grpc/src/php/ext/grpc/channel_credentials.c
new file mode 100644
index 0000000000000000000000000000000000000000..0b356aa25fc83be05f1cf38a50ab277a0dd83c4d
--- /dev/null
+++ b/third_party/grpc/src/php/ext/grpc/channel_credentials.c
@@ -0,0 +1,231 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
+ *
+ *     * Redistributions of source code must retain the above copyright
