+	int						maxBindings	= -1;
+
+	gl.enableLogging(true);
+
+	gl.glGetIntegerv(m_numBindingsTarget, &maxBindings);
+	GLU_EXPECT_NO_ERROR(gl.glGetError(), "glGetIntegerv");
+
+	{
+		const tcu::ScopedLogSection section(m_testCtx.getLog(), "Initial", "Initial value");
