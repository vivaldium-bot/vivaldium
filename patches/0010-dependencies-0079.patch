+	ctx.beginSection("GL_INVALID_OPERATION is generated if zero is bound to target.");
+	ctx.glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	ctx.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
