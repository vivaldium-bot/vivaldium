diff --git a/third_party/ffmpeg/libavfilter/avf_abitscope.c b/third_party/ffmpeg/libavfilter/avf_abitscope.c
new file mode 100644
index 0000000000000000000000000000000000000000..0e3eaa422e3ba80b66c3b9ed1a1ca4215b3307ef
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/avf_abitscope.c
@@ -0,0 +1,252 @@
+/*
