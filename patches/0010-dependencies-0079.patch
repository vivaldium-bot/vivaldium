diff --git a/third_party/grpc/src/php/ext/grpc/channel.c b/third_party/grpc/src/php/ext/grpc/channel.c
new file mode 100644
index 0000000000000000000000000000000000000000..b5a2c9f6bafd999b1b5a8f95a79bfb1e20e925e4
--- /dev/null
+++ b/third_party/grpc/src/php/ext/grpc/channel.c
@@ -0,0 +1,260 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
