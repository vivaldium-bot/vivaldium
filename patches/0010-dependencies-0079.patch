diff --git a/third_party/ffmpeg/libavdevice/oss_dec.c b/third_party/ffmpeg/libavdevice/oss_dec.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f748f2bc3b170b82f1dc811269fa2cddfa14a02
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/oss_dec.c
@@ -0,0 +1,149 @@
+/*
+ * Linux audio play interface
+ * Copyright (c) 2000, 2001 Fabrice Bellard
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
