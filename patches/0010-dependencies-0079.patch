+	ctx.glUseProgram				(0);
+	ctx.glBeginTransformFeedback	(GL_TRIANGLES);
+	ctx.expectError					(GL_INVALID_OPERATION);
+	ctx.glUseProgram				(program.getProgram());
+	ctx.endSection();
