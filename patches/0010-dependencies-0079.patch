+			<< "layout(binding = 0) buffer Output {\n"
+			<< "    coherent uint values[" << numValues << "];\n"
+			<< "} sb_out;\n\n"
+			<< "shared uint offsets[" << workGroupSize << "];\n\n"
+			<< "void main (void) {\n"
