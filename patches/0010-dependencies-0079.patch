+
+struct BlendState
+{
+	deUint32	equation;
+	deUint32	srcFunc;
+	deUint32	dstFunc;
+
+	BlendState (void)
+		: equation	(0)
+		, srcFunc	(0)
+		, dstFunc	(0)
+	{
+	}
+};
+
+struct StencilState
+{
+	deUint32	function;
+	int			reference;
+	deUint32	compareMask;
+
+	deUint32	stencilFailOp;
+	deUint32	depthFailOp;
+	deUint32	depthPassOp;
+
+	deUint32	writeMask;
+
+	StencilState (void)
+		: function		(0)
+		, reference		(0)
+		, compareMask	(0)
+		, stencilFailOp	(0)
+		, depthFailOp	(0)
+		, depthPassOp	(0)
+		, writeMask		(0)
+	{
+	}
+};
+
+struct RenderState
+{
+	bool				scissorTestEnabled;
+	rr::WindowRectangle	scissorRectangle;
+
+	bool				stencilTestEnabled;
+	StencilState		stencil[rr::FACETYPE_LAST];
+
+	bool				depthTestEnabled;
+	deUint32			depthFunc;
+	bool				depthWriteMask;
+
