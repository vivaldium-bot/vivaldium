+UniformBlock& ShaderInterface::allocBlock (const char* name)
+{
+	m_uniformBlocks.reserve(m_uniformBlocks.size()+1);
+	m_uniformBlocks.push_back(new UniformBlock(name));
+	return *m_uniformBlocks.back();
