+		{
+			tcu::TestCaseGroup* const	async				= new tcu::TestCaseGroup(m_testCtx, "async", "Asynchronous message generation");
+			const int					errorFuncsPerCase	= 2;
+			const int					maxAsyncCaseCount	= 16;
