+	virtual void		bind			(GLuint name) = 0;
+	virtual GLuint		getBinding		(void) = 0;
+	virtual bool		genRequired		(void) const { return true; }
+
+protected:
+						Binder			(const Context& ctx) : ContextWrapper(ctx) {}
+};
