+	ctx.expectError					(GL_INVALID_OPERATION);
+	ctx.endSection();
+
+	ctx.glEndTransformFeedback		();
+	ctx.glDeleteBuffers				(1, &buf);
+	ctx.glDeleteTransformFeedbacks	(2, tfID);
+	ctx.expectError					(GL_NO_ERROR);
