+		'Debug\\de-internal-tests.exe',
+		'Debug\\executor.exe',
+		'Debug\\execserver.exe',
+		'Debug\\testlog-to-junit.exe'
+	),
+	Config(
+		"win32-vs10-release",
+		SRC_PATH,
+		os.path.join(BASE_BUILD_PATH, "win32-vs10-release"),
+		['-GVisual Studio 10', '-DDEQP_TARGET=no_modules'],
