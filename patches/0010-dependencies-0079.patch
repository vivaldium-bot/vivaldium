+		gls::DrawTestSpec::INDEXTYPE_INT,
+	};
+	const UniformWeightArray<DE_LENGTH_OF_ARRAY(indexTypes)> indexTypeWeights;
+
+	gls::DrawTestSpec::InputType inputTypes[] =
+	{
+		gls::DrawTestSpec::INPUTTYPE_FLOAT,
