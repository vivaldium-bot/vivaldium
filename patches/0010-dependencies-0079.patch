index 0000000000000000000000000000000000000000..52755a1fb42d3524c41c8b5185408cff2cb73931
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_afftfilt.c
@@ -0,0 +1,406 @@
+/*
