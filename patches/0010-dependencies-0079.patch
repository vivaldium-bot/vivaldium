+				  enclosing->getType() == TYPE_LAYOUT_QUALIFIER			||
+				  enclosing->getType() == TYPE_INTERPOLATION_QUALIFIER	||
+				  enclosing->getType() == TYPE_INTERFACE_BLOCK			||
+				  enclosing->getType() == TYPE_ARRAY_ELEMENT			||
+				  enclosing->getType() == TYPE_STRUCT_MEMBER			||
