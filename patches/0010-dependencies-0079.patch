+class AttributeCase : public TestCase
+{
+public:
+						AttributeCase		(Context& context, const char* name, const char* desc, QueryType verifier);
+
+	IterateResult		iterate				(void);
+	virtual void		test				(tcu::ResultCollector& result) = 0;
