+	gl.texParameteri(GL_TEXTURE_CUBE_MAP, GL_DEPTH_STENCIL_TEXTURE_MODE, GL_STENCIL_INDEX);
+	GLU_EXPECT_NO_ERROR(gl.getError(), "Texture state setup failed");
+
+	gl.useProgram(program.getProgram());
