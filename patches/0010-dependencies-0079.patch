+	, m_dataType		(dataType)
+	, m_size			(size)
+	, m_depth			(depth)
+	, m_texture			(DE_NULL)
+	, m_renderer		(renderCtx, testCtx.getLog(), glu::GLSL_VERSION_310_ES, glu::PRECISION_HIGHP)
+	, m_curLayerFace	(0)
+{
