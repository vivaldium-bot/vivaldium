+		CASE_PURE_SETTERS(TESTER_TEXTURE_SRGB_DECODE_EXT):
+		case TESTER_TEXTURE_SRGB_DECODE_EXT:
+			return RequiredExtensions("GL_EXT_texture_sRGB_decode");
+
+		default:
+			DE_ASSERT(false);
+			return RequiredExtensions();
+	}
+
+#undef CASE_PURE_SETTERS
+}
