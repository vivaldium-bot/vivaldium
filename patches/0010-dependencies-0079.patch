diff --git a/third_party/ffmpeg/libavdevice/alldevices.c b/third_party/ffmpeg/libavdevice/alldevices.c
new file mode 100644
index 0000000000000000000000000000000000000000..b767b6a7188210ba62d223a33e8d0146aeb8ebc2
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/alldevices.c
@@ -0,0 +1,78 @@
+/*
+ * Register all the grabbing devices.
+ *
+ * This file is part of FFmpeg.
