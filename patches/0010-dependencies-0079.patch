index 0000000000000000000000000000000000000000..ee9462480e2cddf00a3abe6a4d219d799391af5c
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/avdevice.h
@@ -0,0 +1,514 @@
+/*
