+{
+	if (m_storage == STORAGE_BUFFER)
+	{
+		m_ctx.genBuffers(1, &m_glBuffer);
+		GLU_EXPECT_NO_ERROR(m_ctx.getError(), "glGenBuffers()");
+	}
