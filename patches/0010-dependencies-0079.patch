+static const char* const s_vertexSource =		"#version 310 es\n"
+												"out highp vec4 v_color;\n"
+												"void main()\n"
+												"{\n"
+												"	gl_Position = vec4(float(gl_VertexID) * 0.5, float(gl_VertexID+1) * 0.5, 0.0, 1.0);\n"
+												"	v_color = vec4(float(gl_VertexID), 1.0, 0.0, 1.0);\n"
+												"}\n";
