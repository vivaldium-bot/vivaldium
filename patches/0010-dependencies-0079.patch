+			const Vec4	c1	= lookup<float>(level1, sampler, wrap(sampler.wrapS, i1, w1), coordY, 0);
+
+			if (isLinearRangeValid(prec, c0, c1, fBounds, result))
+				return true;
+		}
+	}
+
+	return false;
+}
