index 0000000000000000000000000000000000000000..440fe29bccdd98205ba3195c7d70fe28f9887e46
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/pixblockdsp.asm
@@ -0,0 +1,128 @@
+;*****************************************************************************
+;* SIMD-optimized pixel operations
+;*****************************************************************************
+;* Copyright (c) 2000, 2001 Fabrice Bellard
+;* Copyright (c) 2002-2004 Michael Niedermayer <michaelni@gmx.at>
+;*
+;* This file is part of FFmpeg.
+;*
