+/* {{{ PHP_MINIT_FUNCTION
+ */
+PHP_MINIT_FUNCTION(grpc) {
+  /* If you have INI entries, uncomment these lines
+  REGISTER_INI_ENTRIES();
+  */
+  /* Register call error constants */
