+    pavgb t3, mpb_0
+    pxor  t3, t1
+    pand  t3, mpb_1
+    psubb t1, t3 ; p0'a = (p2+2*p1+2*p0+2*q0+q1+4)/8
+
+    pxor  t3, p0, q1
+    pavgb t2, p0, q1
+    pand  t3, mpb_1
+    psubb t2, t3
+    pavgb t2, p1 ; p0'b = (2*p1+p0+q0+2)/4
+
