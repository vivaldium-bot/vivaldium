index 0000000000000000000000000000000000000000..3dc641e89e7947a96fb3a703fe86db662e743466
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/mlpdsp.asm
@@ -0,0 +1,196 @@
+;******************************************************************************
+;* SIMD-optimized MLP DSP functions
+;* Copyright (c) 2014 James Almer <jamrial@gmail.com>
+;*
+;* This file is part of FFmpeg.
+;*
