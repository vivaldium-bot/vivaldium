index 0000000000000000000000000000000000000000..1201be514bb2b027f4e9bedf58043f5914c002e6
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/mpegvideoenc_template.c
@@ -0,0 +1,423 @@
