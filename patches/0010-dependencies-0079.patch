+class CombinedGeometryUniformLimitCase : public GeometryShaderFeartureTestCase
+{
+public:
+						CombinedGeometryUniformLimitCase	(Context& context, const char* name, const char* desc);
+private:
+	IterateResult		iterate								(void);
+};
