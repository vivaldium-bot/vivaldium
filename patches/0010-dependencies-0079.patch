+    movq          m1, [r1+r2*1   ]
+    movq          m2, [r1+r2*1+1]
+    movq          m3, [r1+r2*2  ]
+    movq          m4, [r1+r2*2+1]
+    lea           r1, [r1+r2*2]
+    punpcklbw     m1, m2
+    movdqa        m2, m1
+    punpcklbw     m3, m4
+    movdqa        m4, m3
+    pmaddubsw     m0, m7
+    pmaddubsw     m1, m6
+    pmaddubsw     m2, m7
+    pmaddubsw     m3, m6
+    paddw         m0, m5
+    paddw         m2, m5
+    paddw         m1, m0
+    paddw         m3, m2
+    psrlw         m1, 6
+    movdqa        m0, m4
+    psrlw         m3, 6
