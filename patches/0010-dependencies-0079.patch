+{
+public:
+	typedef typename	Reflect::Ret		Ret;
+	typedef typename	Reflect::Arg0		Arg0;
+	typedef typename	Reflect::Arg1		Arg1;
+	typedef typename	Reflect::ArgExprs	ArgExprs;
