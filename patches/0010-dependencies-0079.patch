+MV = mv
+LN = cp -fp
+RM = rm -f
+@SET_MAKE@
+
+# Programs used by "make install":
+INSTALL = @INSTALL@
+INSTALL_PROGRAM = @INSTALL_PROGRAM@
+INSTALL_DATA = @INSTALL_DATA@
+MKINSTALLDIRS = $(SHELL) $(srcdir)/../mkinstalldirs
+
+#### End of system configuration section. ####
+
+VERSION=3.0.2
+MAJOR=3
+MINOR=0
+
+SHELL = /bin/sh
+
+VPATH = $(srcdir) $(resdir)
+
+EXEEXT=@EXEEXT@
+
