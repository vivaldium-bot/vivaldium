+	{
+		const ExprP<Arg0>&	i		= args.a;
+		const ExprP<Arg1>&	n		= args.b;
+
+		return ApplyReflect<Size, Ret, Arg0, Arg1>::apply(ctx, i, n);
+	}
+};
