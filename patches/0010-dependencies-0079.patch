+{
+	const Sampler::FilterMode filterMode = scaleMode == TEX_LOOKUP_SCALE_MAGNIFY ? sampler.magFilter : sampler.minFilter;
+	return isLevelSampleResultValid(access, sampler, filterMode, prec, coordX, coordY, result);
