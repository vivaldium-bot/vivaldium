+void application_messages (DebugMessageTestContext& ctx)
+{
+	ctx.beginSection("Messages with source of GL_DEBUG_SOURCE_APPLICATION");
+	emitMessages(ctx, GL_DEBUG_SOURCE_APPLICATION);
+	ctx.endSection();
+}
