+%macro mv0_pixels_mc8 0
+    lea           r4, [r2*2 ]
+.next4rows:
+    movq         mm0, [r1   ]
+    movq         mm1, [r1+r2]
+    add           r1, r4
+    CHROMAMC_AVG mm0, [r0   ]
+    CHROMAMC_AVG mm1, [r0+r2]
+    movq     [r0   ], mm0
+    movq     [r0+r2], mm1
+    add           r0, r4
+    movq         mm0, [r1   ]
+    movq         mm1, [r1+r2]
+    add           r1, r4
+    CHROMAMC_AVG mm0, [r0   ]
+    CHROMAMC_AVG mm1, [r0+r2]
+    movq     [r0   ], mm0
+    movq     [r0+r2], mm1
+    add           r0, r4
+    sub          r3d, 4
