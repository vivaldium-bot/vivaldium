+ *//*--------------------------------------------------------------------*/
+
+#include "tcuDefs.hpp"
+#include "tcuTestCase.hpp"
+#include "glsUniformBlockCase.hpp"
+
+namespace de
+{
+class Random;
+} // de
+
+namespace deqp
+{
+namespace gls
+{
+
+namespace ub
+{
+
+enum FeatureBits
+{
+	FEATURE_VECTORS				= (1<<0),
+	FEATURE_MATRICES			= (1<<1),
+	FEATURE_ARRAYS				= (1<<2),
+	FEATURE_STRUCTS				= (1<<3),
+	FEATURE_NESTED_STRUCTS		= (1<<4),
+	FEATURE_INSTANCE_ARRAYS		= (1<<5),
+	FEATURE_VERTEX_BLOCKS		= (1<<6),
