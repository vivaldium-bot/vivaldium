+void framebuffer_texture2d (NegativeTestContext& ctx)
+{
+	GLuint	fbo				= 0x1234;
+	GLuint	tex2D			= 0x1234;
+	GLuint	texCube			= 0x1234;
+	GLuint	tex2DMS			= 0x1234;
