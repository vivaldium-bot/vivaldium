diff --git a/third_party/ffmpeg/libavfilter/af_apad.c b/third_party/ffmpeg/libavfilter/af_apad.c
new file mode 100644
index 0000000000000000000000000000000000000000..f7a4199c6486c8d81f33e1c1073be4ce53357b15
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_apad.c
@@ -0,0 +1,161 @@
+/*
+ * Copyright (c) 2012 Michael Niedermayer
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
