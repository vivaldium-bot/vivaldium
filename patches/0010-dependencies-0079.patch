+		for (int ndx = 0; ndx < maxDrawBuffers; ++ndx)
+			verifyStateIndexedInteger(result, gl, GL_BLEND_DST_ALPHA, ndx, GL_ONE_MINUS_DST_ALPHA, m_verifierType);
