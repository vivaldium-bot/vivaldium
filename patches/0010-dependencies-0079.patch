+static inline bool isFormatTypeUnorm (TextureFormat::ChannelType type)
+{
+	return type == TextureFormat::UNORM_INT8	||
+		   type == TextureFormat::UNORM_INT16	||
+		   type == TextureFormat::UNORM_INT32;
