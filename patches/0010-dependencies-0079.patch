+template<class T>
+class SeedBuilderTest : public tcu::TestCase
+{
+public:
+	SeedBuilderTest (tcu::TestContext& testCtx, const T& value, deUint32 seed, const char* name, const char* description)
+		: tcu::TestCase	(testCtx, name, description)
+		, m_value		(value)
