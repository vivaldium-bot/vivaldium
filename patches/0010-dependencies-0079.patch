+template <typename T>
+struct Range
+{
+	typedef const T*	const_iterator;
+
+	const T*	m_begin;
+	const T*	m_end;
+
+	const T*	begin		(void) const { return m_begin; }
+	const T*	end			(void) const { return m_end; }
+};
