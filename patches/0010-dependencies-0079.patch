+            c->weight_h264_pixels_tab[2] = ff_h264_weight_4_10_sse2;
+
+            c->biweight_h264_pixels_tab[0] = ff_h264_biweight_16_10_sse2;
+            c->biweight_h264_pixels_tab[1] = ff_h264_biweight_8_10_sse2;
