+class ACos : public ArcTrigFunc
+{
+public:
+	ACos (void) : ArcTrigFunc("acos", deAcos, 4096.0,
+							  Interval(-1.0, 1.0),
+							  Interval(0.0, DE_PI_DOUBLE)) {}
+};
