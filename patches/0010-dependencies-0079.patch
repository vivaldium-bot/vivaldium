index 0000000000000000000000000000000000000000..cdddbaf31d427e7c09c9c3c3bdb4a13f7269af2a
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/aeval.c
@@ -0,0 +1,490 @@
