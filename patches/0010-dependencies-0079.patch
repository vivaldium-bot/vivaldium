+BadDrawModeCase::BadDrawModeCase (Context& context, const char* name, const char* desc, DrawType type)
+	: TestCase			(context, name, desc)
+	, m_drawType		(type)
+{
+	DE_ASSERT(type < DRAW_LAST);
+}
+
