index 0000000000000000000000000000000000000000..43c1ebf02cffaaed80584df1460b20c7430c06a3
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_volumedetect.c
@@ -0,0 +1,166 @@
+/*
