+	gl.samplerParameteri(sampler, GL_TEXTURE_WRAP_R, state.wrapR);
+	GLU_EXPECT_NO_ERROR(gl.getError(), "glSamplerParameteri(sampler, GL_TEXTURE_WRAP_R, state.wrapR)");
