+local_prefix = /usr/local
+exec_prefix = @exec_prefix@
+bindir = @bindir@
+resdir = ../res
+
+# Programs used by "make":
+# C compiler
+CC = @CC@
+CFLAGS = @CFLAGS@
+CPP = @CPP@
+# C++ compiler
+CXX = @CXX@
+CXXFLAGS = @CXXFLAGS@
+CXXCPP = @CXXCPP@
