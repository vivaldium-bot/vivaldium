+template<>
+const deUint32* getRawReference<float> (TextureFormat format)
+{
+	return s_formatData[format.type].floatRef;
+}
+
+template<>
+const deUint32* getRawReference<deInt32> (TextureFormat format)
+{
+	return s_formatData[format.type].intRef;
+}
