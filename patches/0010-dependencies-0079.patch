+{
+	if (m_storage == STORAGE_BUFFER)
+	{
+		m_ctx.deleteBuffers(1, &m_glBuffer);
+		GLU_EXPECT_NO_ERROR(m_ctx.getError(), "glDeleteBuffers()");
+	}
+	else if (m_storage == STORAGE_USER)
+		delete[] m_data;
+	else
+		DE_ASSERT(false);
