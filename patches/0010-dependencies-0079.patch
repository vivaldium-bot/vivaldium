+class TrieParserTests : public tcu::TestCaseGroup
+{
+public:
+	TrieParserTests (tcu::TestContext& testCtx)
+		: tcu::TestCaseGroup(testCtx, "trie", "Test case trie parser tests")
+	{
+	}
