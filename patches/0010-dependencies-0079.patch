+	const UniformWeightArray<DE_LENGTH_OF_ARRAY(drawMethods)> drawMethodWeights;
+
+	gls::DrawTestSpec::IndexType indexTypes[] =
+	{
+		gls::DrawTestSpec::INDEXTYPE_BYTE,
