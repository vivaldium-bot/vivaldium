+static const char* const s_positionColorOffsetShader =	"#version 310 es\n"
+														"in highp vec4 a_position;\n"
+														"in highp vec4 a_offset;\n"
+														"in highp vec4 a_color;\n"
+														"out highp vec4 v_color;\n"
+														"void main (void)\n"
