+	std::string			genMSTextureLayerFetchSource	(int numTargetSamples) const;
+	virtual bool		verifyImage						(const tcu::Surface& resultImage) = 0;
+	virtual bool		verifySampleBuffers				(const std::vector<tcu::Surface>& resultBuffers);
