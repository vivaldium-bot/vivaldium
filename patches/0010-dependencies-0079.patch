+  }
+
+  GRPCHost *hostConfig = [GRPCHost hostWithAddress:host];
+  [hostConfig setTLSPEMRootCerts:certs withPrivateKey:nil withCertChain:nil error:nil];
+  hostConfig.hostNameOverride = testName;
+}
