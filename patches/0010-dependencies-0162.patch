+
+ WebRtcIlbcfix_Smooth_odata.c
+
+******************************************************************/
+
+#include "defines.h"
+#include "constants.h"
+
+int32_t WebRtcIlbcfix_Smooth_odata(
+    int16_t *odata,
+    int16_t *psseq,
+    int16_t *surround,
+    int16_t C)
+{
+  int i;
+
+  int16_t err;
+  int32_t errs;
+
+  for(i=0;i<80;i++) {
+    odata[i]= (int16_t)((C * surround[i] + 1024) >> 11);
+  }
+
+  errs=0;
+  for(i=0;i<80;i++) {
+    err = (psseq[i] - odata[i]) >> 3;
+    errs += err * err;  /* errs in Q-6 */
+  }
+
+  return errs;
+}
