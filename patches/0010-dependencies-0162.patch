+    return rtc::scoped_refptr<webrtc::AudioState>();
+  }
+
+  VoiceMediaChannel* CreateChannel(webrtc::Call* call,
+                                   const MediaConfig& config,
+                                   const AudioOptions& options) {
+    if (fail_create_channel_) {
