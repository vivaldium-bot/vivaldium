+bool WebRtcVideoChannel2::SetSend(bool send) {
+  LOG(LS_VERBOSE) << "SetSend: " << (send ? "true" : "false");
+  if (send && !send_codec_) {
+    LOG(LS_ERROR) << "SetSend(true) called before setting codec.";
+    return false;
+  }
+  if (send) {
+    StartAllSendStreams();
+  } else {
+    StopAllSendStreams();
+  }
+  sending_ = send;
+  return true;
+}
