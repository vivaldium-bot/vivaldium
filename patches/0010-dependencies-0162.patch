index 0000000000000000000000000000000000000000..5d8a86050e86522714c89e06ba8afdebe21eb441
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/hp_input.c
@@ -0,0 +1,88 @@
+/*
