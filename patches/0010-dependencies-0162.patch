+		std::set<std::string> attributeBinding[MAX_VERTEX_ATTRIBS];
+		glsl::Attribute linkedAttribute[MAX_VERTEX_ATTRIBS];
+		int attributeStream[MAX_VERTEX_ATTRIBS];
+
+		struct Sampler
+		{
+			bool active;
