+					case GL_R8I:
+					case GL_R8_SNORM:
+					case GL_RED:
+					case GL_RED_INTEGER:
+					case GL_ALPHA:
+					case GL_ALPHA8_EXT:
+					case GL_LUMINANCE:
+					case GL_LUMINANCE8_EXT:
