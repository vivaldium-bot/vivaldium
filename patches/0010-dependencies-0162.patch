+	{
+		const void *mPointer;
+		intptr_t mOffset;
+	};
+
+	BindingPointer<Buffer> mBoundBuffer;   // Captured when glVertexAttribPointer is called.
+
+	bool mArrayEnabled;   // From glEnable/DisableVertexAttribArray
+	float mCurrentValue[4];   // From glVertexAttrib
+};
