+	int getNumBlocks(int w, int h, int blockSizeX, int blockSizeY)
+	{
+		return ((w + blockSizeX - 1) / blockSizeX) * ((h + blockSizeY - 1) / blockSizeY);
+	}
+
+	enum DataType
+	{
+		Bytes_1,
+		Bytes_2,
+		Bytes_4,
+		Bytes_8,
+		Bytes_16,
+		ByteRGB,
+		UByteRGB,
+		ShortRGB,
