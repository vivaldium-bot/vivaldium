+int TextureCubeMap::getLevelCount() const
+{
+	ASSERT(isSamplerComplete());
+	int levels = 0;
+
+	while(levels < IMPLEMENTATION_MAX_TEXTURE_LEVELS && image[0][levels])
+	{
+		levels++;
+	}
+
+	return levels;
+}
