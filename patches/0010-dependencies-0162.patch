+                                  const Jid& lookup_server_jid,
+                                  const std::string& room_name,
+                                  const std::string& room_domain);
+  static MucRoomLookupTask*
+      CreateLookupTaskForRoomJid(XmppTaskParentInterface* parent,
+                                 const Jid& lookup_server_jid,
