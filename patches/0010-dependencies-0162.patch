+template<class T>
+class VideoEngineOverride : public T {
+ public:
+  VideoEngineOverride() : T() {
+  }
+  virtual ~VideoEngineOverride() {
+  }
+  bool is_camera_on() const { return T::GetVideoCapturer()->IsRunning(); }
+
+  void TriggerMediaFrame(uint32_t ssrc,
