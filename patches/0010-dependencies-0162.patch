+int reference(int *p, int y)
+{
+	int x = p[-1];
+	int z = 4;
+
+	for(int i = 0; i < 10; i++)
+	{
+		z += (2 << i) - (i / 3);
+	}
+
+	int sum = x + y + z;
+
+	return sum;
+}
