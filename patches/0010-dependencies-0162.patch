+		IntRGB,
+		UIntRGB,
+		RGB565,
+		FloatRGB,
+		HalfFloatRGB,
+		RGBA4444,
+		RGBA5551,
+		RGB10A2UI,
+		R11G11B10F,
+		RGB9E5,
+		SRGB,
+		SRGBA,
+		D16,
+		D24,
+		D32,
+		D32F,
