+		return;
+	}
+
+	sw::SliceRect sourceRect = {x, y, x + width, y + height, 0};
+	sourceRect.clip(0, 0, renderbuffer->getWidth(), renderbuffer->getHeight());
+
+	copy(renderTarget, sourceRect, image[level]->getFormat(), xoffset, yoffset, zoffset, image[level]);
