+Texture2D::Texture2D(GLuint name) : Texture(name)
+{
+	for(int i = 0; i < IMPLEMENTATION_MAX_TEXTURE_LEVELS; i++)
+	{
+		image[i] = nullptr;
+	}
+
+	mSurface = nullptr;
+
+	mColorbufferProxy = nullptr;
+	mProxyRefs = 0;
+}
+
+Texture2D::~Texture2D()
+{
+	for(int i = 0; i < IMPLEMENTATION_MAX_TEXTURE_LEVELS; i++)
+	{
+		if(image[i])
+		{
+			image[i]->unbind(this);
+			image[i] = nullptr;
+		}
+	}
+
+	if(mSurface)
+	{
+		mSurface->setBoundTexture(nullptr);
+		mSurface = nullptr;
+	}
+
+	mColorbufferProxy = nullptr;
+}
+
+// We need to maintain a count of references to renderbuffers acting as
+// proxies for this texture, so that we do not attempt to use a pointer
+// to a renderbuffer proxy which has been deleted.
+void Texture2D::addProxyRef(const Renderbuffer *proxy)
+{
+	mProxyRefs++;
+}
+
+void Texture2D::releaseProxy(const Renderbuffer *proxy)
+{
+	if(mProxyRefs > 0)
+	{
+		mProxyRefs--;
+	}
+
+	if(mProxyRefs == 0)
+	{
+		mColorbufferProxy = nullptr;
+	}
+}
+
+void Texture2D::sweep()
+{
+	int imageCount = 0;
+
+	for(int i = 0; i < IMPLEMENTATION_MAX_TEXTURE_LEVELS; i++)
+	{
+		if(image[i] && image[i]->isChildOf(this))
+		{
+			if(!image[i]->hasSingleReference())
+			{
+				return;
+			}
+
+			imageCount++;
+		}
+	}
+
+	if(imageCount == referenceCount)
+	{
+		destroy();
+	}
+}
