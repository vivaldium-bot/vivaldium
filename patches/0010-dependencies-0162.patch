+    void* state1_;
+    void* state2_;
+    void* state3_;
+
+    // Storage if needed
+    int16_t* in_buffer_;
+    int16_t* out_buffer_;
+    int in_buffer_size_;
+    int out_buffer_size_;
+    int in_buffer_size_max_;
+    int out_buffer_size_max_;
