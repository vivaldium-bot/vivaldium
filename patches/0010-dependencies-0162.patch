+	void PixelPipeline::TEXM3X2DEPTH(Vector4s &dst, Float4 &u, Float4 &v, Float4 &s, Vector4s &src, bool signedScaling)
+	{
+		TEXM3X2PAD(u, v, s, src, 1, signedScaling);
+
+		// z / w
+		u_ *= Rcp_pp(v_);   // FIXME: Set result to 1.0 when division by zero
