+    return;
+  }
+
+  ConvertToI420(kI420, res_i420_buffer.get(), 0, 0, width_, height_, 0,
+                kVideoRotation_0, &res_i420_frame);
+  psnr = I420PSNR(&orig_frame_, &res_i420_frame);
