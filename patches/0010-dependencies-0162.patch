index 0000000000000000000000000000000000000000..cf05ce3310a2587e1c2e2329418813d5b45e3353
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/codecs/ilbc/get_cd_vec.c
@@ -0,0 +1,111 @@
+/*
