+						break;
+					case GL_RGBA8:
+					case GL_RGBA8I:
+					case GL_RGBA8_SNORM:
+					case GL_RGBA:
+					case GL_RGBA_INTEGER:
+					case GL_BGRA_EXT:
+					case GL_BGRA8_EXT:
