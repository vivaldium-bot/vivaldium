+
+  virtual cricket::VideoCapturer* Create(const ScreencastId& window) {
+    if (window_capturer_ != NULL) {
+      return NULL;
+    }
+    window_capturer_ = new cricket::FakeVideoCapturer;
+    window_capturer_->SignalDestroyed.connect(
