+#ifndef sw_Routine_hpp
+#define sw_Routine_hpp
+
+namespace sw
+{
+	class Routine
+	{
+	public:
+		Routine();
+
+		virtual ~Routine();
+
+		virtual const void *getEntry() = 0;
+
+		// Reference counting
+		void bind();
+		void unbind();
+
+	private:
+		volatile int bindCount;
+	};
+}
