+  virtual int32_t SetRates(uint32_t newBitRate, uint32_t frameRate) {
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  int GetNumEncodedFrames() {
+    rtc::CritScope lock(&crit_);
+    return num_frames_encoded_;
+  }
+
+ private:
