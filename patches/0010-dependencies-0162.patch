+  rtc::scoped_ptr<uint8_t[]> res_i420_buffer(new uint8_t[frame_length_]);
+  VideoFrame yv12_frame;
+  EXPECT_EQ(0, ConvertFromI420(orig_frame_, kYV12, 0, outYV120Buffer.get()));
+  yv12_frame.CreateFrame(outYV120Buffer.get(),
