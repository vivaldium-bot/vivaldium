+TEST_F(CodecTest, TestCodecOperators) {
+  Codec c0(96, "D", 1000, 0);
+  c0.SetParam("a", 1);
+
+  Codec c1 = c0;
+  EXPECT_TRUE(c1 == c0);
+
+  int param_value0;
