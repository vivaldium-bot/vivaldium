+			}
+			break;
+		case DRAW_INDEXEDTRIANGLESTRIP16:
+			{
+				const unsigned short *index = (const unsigned short*)indices + start;
+
+				for(unsigned int i = 0; i < triangleCount; i++)
+				{
+					batch[i][0] = index[0];
