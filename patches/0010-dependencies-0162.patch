++++ lib/VMCore/Function.cpp	(working copy)
+@@ -178,9 +178,9 @@
+     ParentModule->getFunctionList().push_back(this);
+ 
+   // Ensure intrinsics have the right parameter attributes.
+-  if (unsigned IID = getIntrinsicID())
