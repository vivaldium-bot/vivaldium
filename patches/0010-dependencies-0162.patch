diff --git a/third_party/swiftshader/src/Renderer/Point.cpp b/third_party/swiftshader/src/Renderer/Point.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e7e33dd27a61f759fd1421944c6f8b08e259f829
