+  // Tests that we can add and remove capturer as unique sources.
+  void AddRemoveCapturerMultipleSources() {
+    // WebRTC implementation will drop frames if pushed to quickly. Wait the
+    // interval time to avoid that.
+    // WebRTC implementation will drop frames if pushed to quickly. Wait the
+    // interval time to avoid that.
