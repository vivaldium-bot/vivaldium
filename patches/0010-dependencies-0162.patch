+
+  virtual bool SendData(const SendDataParams& params,
+                        const rtc::Buffer& payload,
+                        SendDataResult* result) {
+    if (send_blocked_) {
+      *result = SDR_BLOCK;
+      return false;
+    } else {
+      last_sent_data_params_ = params;
+      last_sent_data_ = std::string(payload.data<char>(), payload.size());
