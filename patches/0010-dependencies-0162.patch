+void WebRtcVideoChannel2::WebRtcVideoReceiveStream::RecreateWebRtcStream() {
+  if (stream_ != NULL) {
+    call_->DestroyVideoReceiveStream(stream_);
+  }
+  stream_ = call_->CreateVideoReceiveStream(config_);
+  stream_->Start();
+}
