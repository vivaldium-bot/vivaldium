+void CoordinatedVideoAdapter::set_cpu_smoothing(bool enable) {
+  LOG(LS_INFO) << "CPU smoothing is now "
+               << (enable ? "enabled" : "disabled");
+  cpu_smoothing_ = enable;
+}
