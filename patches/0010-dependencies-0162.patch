+void Context::deleteFramebuffer(GLuint framebuffer)
+{
+	Framebuffer *framebufferObject = mFramebufferNameSpace.remove(framebuffer);
+
+	if(framebufferObject)
+	{
+		detachFramebuffer(framebuffer);
+
+		delete framebufferObject;
+	}
+}
