+  ASSERT_NEAR(window[0], 0.598066f, 1e-6f);
+  ASSERT_NEAR(window[1], 0.922358f, 1e-6f);
+  ASSERT_NEAR(window[2], 0.598066f, 1e-6f);
+  ASSERT_NEAR(window[3], 0.0f, 1e-6f);
