+	if(textureMaxAnisotropy < 1.0f)
+	{
+		return false;
+	}
+
+	if(mMaxAnisotropy != textureMaxAnisotropy)
+	{
+		mMaxAnisotropy = textureMaxAnisotropy;
+	}
+
+	return true;
