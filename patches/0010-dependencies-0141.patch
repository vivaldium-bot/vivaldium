+// Convert a FX_ARGB to a FX_COLORREF.
+FX_COLORREF ARGBToColorRef(FX_ARGB argb) {
+  return (((static_cast<uint32_t>(argb) & 0x00FF0000) >> 16) |
+          (static_cast<uint32_t>(argb) & 0x0000FF00) |
+          ((static_cast<uint32_t>(argb) & 0x000000FF) << 16));
+}
