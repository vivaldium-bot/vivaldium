+
+  annot = FPDFPage_GetAnnot(page, 1);
+  ASSERT_TRUE(FPDFAnnot_GetRect(annot, &rect));
+  EXPECT_NEAR(149.8127f, rect.left, 0.001f);
+  FPDFPage_CloseAnnot(annot);
+
+  annot = FPDFPage_GetAnnot(page, 2);
