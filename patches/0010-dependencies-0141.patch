+CPDF_ContentMarkItem::CPDF_ContentMarkItem(const CPDF_ContentMarkItem& src) {
+  m_MarkName = src.m_MarkName;
+  m_ParamType = src.m_ParamType;
+  if (m_ParamType == DirectDict) {
+    m_pParam = ToDictionary(src.m_pParam->Clone());
