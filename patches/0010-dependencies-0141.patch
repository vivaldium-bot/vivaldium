+        VkPtr<PFN_vkCmdResetQueryPool> fCmdResetQueryPool;
+        VkPtr<PFN_vkCmdWriteTimestamp> fCmdWriteTimestamp;
+        VkPtr<PFN_vkCmdCopyQueryPoolResults> fCmdCopyQueryPoolResults;
