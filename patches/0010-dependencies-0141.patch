+.ns-0 .ambox, 
+.ns-0 .navbox, 
+.ns-0 .vertical-navbox, 
+.ns-0 .infobox.sisterproject, 
+.ns-0 .dablink, 
+.ns-0 .metadata,
+.editlink,
+.navbar,
