+int CPDF_Font::GetStringWidth(const FX_CHAR* pString, int size) {
+  int offset = 0;
+  int width = 0;
+  while (offset < size) {
+    uint32_t charcode = GetNextChar(pString, size, offset);
+    width += GetCharWidthF(charcode);
+  }
+  return width;
+}
