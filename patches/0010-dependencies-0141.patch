+CFX_ByteStringC PDF_FindFullName(const PDF_AbbrPair* table,
+                                 size_t count,
+                                 const CFX_ByteStringC& abbr) {
+  auto it = std::find_if(
+      table, table + count,
+      [abbr](const PDF_AbbrPair& pair) { return pair.abbr == abbr; });
+  return it != table + count ? CFX_ByteStringC(it->full_name)
+                             : CFX_ByteStringC();
+}
