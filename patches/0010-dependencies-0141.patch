+bool CPDFSDK_Widget::GetBorderColor(FX_COLORREF& color) const {
+  CPDF_FormControl* pFormCtrl = GetFormControl();
+  int iColorType = 0;
+  color = ARGBToColorRef(pFormCtrl->GetBorderColor(iColorType));
+  return iColorType != CFX_Color::kTransparent;
+}
