+  FX_DATETIMETYPE GetDateTimeFormat(const WideString& wsPattern,
+                                    IFX_Locale** pLocale,
+                                    WideString* wsDatePattern,
+                                    WideString* wsTimePattern);
+
+  CXFA_LocaleMgr* m_pLocaleMgr;
+};
