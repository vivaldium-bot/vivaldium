+
+  uint32_t dwFlag = XFA_RESOLVENODE_Siblings | XFA_RESOLVENODE_ALL;
+  WideString wsExpression = GetAttribute(XFA_Attribute::Name) + L"[*]";
+  ResolveNodeList(pValue, wsExpression, dwFlag, nullptr);
+}
