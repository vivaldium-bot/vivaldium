index 0000000000000000000000000000000000000000..21d4a8bc1e960af9a95ab202cc951d14c04601b3
--- /dev/null
+++ b/third_party/opus/src/silk/x86/NSQ_del_dec_sse.c
@@ -0,0 +1,857 @@
