+LOCAL_PATH:= $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_CFLAGS += \
+	local_cflags
+
+LOCAL_CPPFLAGS := \
+	local_cppflags
+
+LOCAL_SRC_FILES := \
+	local_src_files
