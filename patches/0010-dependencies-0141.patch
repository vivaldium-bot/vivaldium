+    return m_pObject->GetBoundingBox(line_width, miter_limit);
+  }
+
+  FX_BOOL IsRect() const { return m_pObject->IsRect(); }
+
+  void Transform(const CFX_Matrix* pMatrix) { GetModify()->Transform(pMatrix); }
