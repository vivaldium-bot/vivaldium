+  std::unique_ptr<CFFL_InteractiveFormFiller> m_pFormFiller;
+  std::unique_ptr<CFX_SystemHandler> m_pSysHandler;
+  bool m_bChangeMask;
+  bool m_bBeingDestroyed;
+};
+
+#endif  // FPDFSDK_CPDFSDK_FORMFILLENVIRONMENT_H_
