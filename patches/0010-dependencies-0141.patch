+  // Verify all the filters for an image object with a list of filters.
+  obj = FPDFPage_GetObject(page, 38);
+  ASSERT_EQ(FPDF_PAGEOBJ_IMAGE, FPDFPageObj_GetType(obj));
+  ASSERT_EQ(2, FPDFImageObj_GetImageFilterCount(obj));
