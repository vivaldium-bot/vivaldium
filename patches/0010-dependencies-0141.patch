+FX_BOOL CPDF_ColorSpace::sRGB() const {
+  if (m_Family == PDFCS_DEVICERGB) {
+    return TRUE;
+  }
+  if (m_Family != PDFCS_ICCBASED) {
+    return FALSE;
+  }
+  CPDF_ICCBasedCS* pCS = (CPDF_ICCBasedCS*)this;
+  return pCS->m_pProfile->m_bsRGB;
+}
