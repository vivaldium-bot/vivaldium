+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDF_GetFileVersion(FPDF_DOCUMENT doc,
+                                                        int* fileVersion) {
+  if (!fileVersion)
+    return false;
+
+  *fileVersion = 0;
+  CPDF_Document* pDoc = CPDFDocumentFromFPDFDocument(doc);
+  if (!pDoc)
+    return false;
+
+  const CPDF_Parser* pParser = pDoc->GetParser();
+  if (!pParser)
+    return false;
+
+  *fileVersion = pParser->GetFileVersion();
+  return true;
+}
