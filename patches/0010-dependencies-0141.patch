+  *                           0-Error(default);
+  *                           1-Warning;
+  *                           2-Question;
+  *                           3-Status.
+  *                           4-Asterisk
+  * Return Value:
+  *           The return value could be the folowing type:
+  *                           1-OK;
+  *                           2-Cancel;
+  *                           3-NO;
+  *                           4-Yes;
+  */
+  int (*app_alert)(struct _IPDF_JsPlatform* pThis,
+                   FPDF_WIDESTRING Msg,
+                   FPDF_WIDESTRING Title,
+                   int Type,
+                   int Icon);
