+#include "SkColorFilter.h"
+#include "SkRefCnt.h"
+
+// This colorfilter can be used to perform pixel-by-pixel conversion between linear and 
+// power-law color spaces. A gamma of 2.2 is interpreted to mean convert from sRGB to linear
