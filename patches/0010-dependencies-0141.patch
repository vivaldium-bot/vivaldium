+    return m_pEdit->GetSelectedText();
+
+  return WideString();
+}
+
+void CPWL_EditCtrl::ReplaceSelection(const WideString& text) {
+  if (!m_pEdit)
+    return;
+
+  m_pEdit->ClearSelection();
+  m_pEdit->InsertText(text, FX_CHARSET_Default);
+}
