+        return SkColorFilter::MakeMatrixFilterRowMajor255(array).release();
+    }
+    static SkColorFilter* CreateLightingFilter(SkColor mul, SkColor add) {
+        return MakeLightingFilter(mul, add).release();
+    }
+#endif
