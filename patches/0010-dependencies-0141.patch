+
+bool CPSPrinterDriver::StartDIBits(const RetainPtr<CFX_DIBSource>& pBitmap,
+                                   int bitmap_alpha,
+                                   uint32_t color,
+                                   const CFX_Matrix* pMatrix,
+                                   uint32_t render_flags,
+                                   std::unique_ptr<CFX_ImageRenderer>* handle,
+                                   int blend_type) {
+  if (blend_type != FXDIB_BLEND_NORMAL)
+    return false;
+
+  if (bitmap_alpha < 255)
+    return false;
