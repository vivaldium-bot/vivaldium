+      `value` : ``str``
+        The config value
+
+    :Return: The boolean value
+    :Rtype: ``bool``
+
+    :Exceptions:
+      - `ValueError` : The value could not be recognized
+    """
+    try:
+        return _util.strtobool(str(value).strip().lower() or 'no')
+    except ValueError:
+        raise ValueError("Unrecognized config value: %s = %s" % (name, value))
