+void CPWL_Wnd::ReleaseCapture() {
+  for (auto* pChild : m_Children) {
+    if (pChild)
+      pChild->ReleaseCapture();
+  }
+  if (CPWL_MsgControl* pMsgCtrl = GetMsgControl())
+    pMsgCtrl->ReleaseCapture();
