+void CPDF_StreamContentParser::OnOperator(const FX_CHAR* op) {
+  int i = 0;
+  uint32_t opid = 0;
+  while (i < 4 && op[i]) {
+    opid = (opid << 8) + op[i];
+    i++;
+  }
+  while (i < 4) {
+    opid <<= 8;
+    i++;
+  }
+
+  static const OpCodes s_OpCodes = InitializeOpCodes();
+
+  auto it = s_OpCodes.find(opid);
+  if (it != s_OpCodes.end())
+    (this->*it->second)();
+}
