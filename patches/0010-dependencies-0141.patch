+int RI_StringToId(const CFX_ByteString& ri) {
+  uint32_t id = ri.GetID();
+  if (id == FXBSTR_ID('A', 'b', 's', 'o'))
+    return 1;
+
+  if (id == FXBSTR_ID('S', 'a', 't', 'u'))
+    return 2;
+
+  if (id == FXBSTR_ID('P', 'e', 'r', 'c'))
+    return 3;
+
+  return 0;
+}
