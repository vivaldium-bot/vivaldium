+void CPDF_ColorSpace::GetDefaultColor(FX_FLOAT* buf) const {
+  if (!buf || m_Family == PDFCS_PATTERN) {
+    return;
+  }
+  FX_FLOAT min, max;
+  for (uint32_t i = 0; i < m_nComponents; i++) {
+    GetDefaultValue(i, buf[i], min, max);
+  }
+}
