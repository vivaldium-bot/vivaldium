+
+  void OnProcessMessageToForm(CFWL_Message* pMessage);
+  void OnDrawWidget(CFWL_Widget* pWidget,
+                    CXFA_Graphics* pGraphics,
+                    const CFX_Matrix& matrix);
+
+  CFWL_Widget* GetParentWidget(CFWL_Widget* pWidget) const;
