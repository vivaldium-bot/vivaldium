index 0000000000000000000000000000000000000000..7983f1db80ccceca58bd7a762ea9054cfa54b6b9
--- /dev/null
+++ b/third_party/opus/src/silk/VQ_WMat_EC.c
@@ -0,0 +1,120 @@
