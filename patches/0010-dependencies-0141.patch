+struct FXCMAP_CMap {
+  enum MapType { None, Single, Range, Reverse };
+
+  const char* m_Name;
+  MapType m_WordMapType;
+  const uint16_t* m_pWordMap;
+  int m_WordCount;
+  MapType m_DWordMapType;
+  const uint16_t* m_pDWordMap;
+  int m_DWordCount;
+  int m_UseOffset;
+};
