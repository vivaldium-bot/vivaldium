+void CPDF_StreamContentParser::Handle_EndMarkedContent() {
+  if (m_CurContentMark.IsNull())
+    return;
+
+  int count = m_CurContentMark.GetObject()->CountItems();
+  if (count == 1) {
+    m_CurContentMark.SetNull();
+    return;
+  }
+  m_CurContentMark.GetModify()->DeleteLastMark();
+}
