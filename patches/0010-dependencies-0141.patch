+template<class T> struct rect_base  {
+    typedef rect_base<T> self_type;
+    T x1;
+    T y1;
+    T x2;
+    T y2;
+    rect_base() {}
+    rect_base(T x1_, T y1_, T x2_, T y2_) :
+        x1(x1_), y1(y1_), x2(x2_), y2(y2_) {}
+    const self_type& normalize()
+    {
+        T t;
+        if(x1 > x2) {
+            t = x1;
+            x1 = x2;
+            x2 = t;
+        }
+        if(y1 > y2) {
+            t = y1;
+            y1 = y2;
+            y2 = t;
+        }
+        return *this;
+    }
+    bool clip(const self_type& r)
+    {
+        if(x2 > r.x2) {
+            x2 = r.x2;
+        }
+        if(y2 > r.y2) {
+            y2 = r.y2;
+        }
+        if(x1 < r.x1) {
+            x1 = r.x1;
+        }
+        if(y1 < r.y1) {
+            y1 = r.y1;
+        }
+        return x1 <= x2 && y1 <= y2;
+    }
