+
+  void SetFont(const RetainPtr<CFGAS_GEFont>& pFont);
+  void SetFontSize(float fFontSize);
+  void SetTabWidth(float fTabWidth);
+  int32_t GetTabWidth() const { return m_iTabWidth; }
