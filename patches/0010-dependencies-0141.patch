+                                 SkScalar outerMax, SkImageFilter* input = nullptr) {
+        return Make(region, innerMin, outerMax, sk_ref_sp<SkImageFilter>(input)).release();
+    }
+#endif
+
+    SK_DECLARE_FLATTENABLE_REGISTRAR_GROUP();
+};
+
+#endif
diff --git a/third_party/skia/include/effects/SkArcToPathEffect.h b/third_party/skia/include/effects/SkArcToPathEffect.h
