+  CPVT_WordRange range = m_SelState.ConvertToWordRange();
+  if (bAddUndo && m_bEnableUndo) {
+    AddEditUndoItem(
+        pdfium::MakeUnique<CFXEU_Clear>(this, range, GetSelectedText()));
