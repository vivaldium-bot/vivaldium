+WideString app::SysPathToPDFPath(const WideString& sOldPath) {
+  WideString sRet = L"/";
+  for (const wchar_t& c : sOldPath) {
+    if (c != L':')
+      sRet += (c == L'\\') ? L'/' : c;
+  }
+  return sRet;
+}
