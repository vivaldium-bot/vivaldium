+
+  double dResult = 0;
+  if (nRate) {
+    double nTemp = 1;
+    for (int i = 0; i < nPeriod; ++i) {
+      nTemp *= 1 + nRate;
+    }
+    dResult = nAmount * (nTemp - 1) / nRate;
+  } else {
+    dResult = nAmount * nPeriod;
+  }
+
+  args.GetReturnValue()->SetDouble(dResult);
+}
