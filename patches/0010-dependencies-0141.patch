+        3 * sizeof(float),        // kVec3f_GrSLType
+        4 * sizeof(float),        // kVec4f_GrSLType
+        2 * 2 * sizeof(float),    // kMat22f_GrSLType
+        3 * 3 * sizeof(float),    // kMat33f_GrSLType
+        4 * 4 * sizeof(float),    // kMat44f_GrSLType
