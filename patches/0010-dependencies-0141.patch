+      std::max(0, static_cast<int32_t>(ValueToFloat(pThis, endValue.get())));
+
+  iStart -= 1;
+  args.GetReturnValue()->SetString(
+      szSourceStr.Mid(iStart, iCount).AsStringView());
+}
