+class CFDE_TextEditEngineTest : public testing::Test {
+ public:
+  class Delegate : public CFDE_TextEditEngine::Delegate {
+   public:
+    void Reset() {
+      text_is_full = false;
+      fail_validation = false;
+    }
+
+    void NotifyTextFull() override { text_is_full = true; }
+
