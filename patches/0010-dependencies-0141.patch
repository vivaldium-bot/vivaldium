+bool CFX_Barcode::SetPrintChecksum(bool checksum) {
+  switch (GetType()) {
+    case BC_CODE39:
+    case BC_CODABAR:
+    case BC_CODE128:
+    case BC_CODE128_B:
+    case BC_CODE128_C:
+    case BC_EAN8:
+    case BC_EAN13:
+    case BC_UPCA:
+      return m_pBCEngine ? (static_cast<CBC_OneCode*>(m_pBCEngine.get())
+                                ->SetPrintChecksum(checksum),
+                            true)
+                         : false;
+    default:
+      return false;
+  }
+}
+
+bool CFX_Barcode::SetDataLength(int32_t length) {
+  switch (GetType()) {
+    case BC_CODE39:
+    case BC_CODABAR:
+    case BC_CODE128:
+    case BC_CODE128_B:
+    case BC_CODE128_C:
+    case BC_EAN8:
