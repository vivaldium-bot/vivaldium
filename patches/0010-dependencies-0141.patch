index 0000000000000000000000000000000000000000..4502b7130e970e657ff44587f1f3bf4b68176076
--- /dev/null
+++ b/third_party/opus/src/silk/fixed/apply_sine_window_FIX.c
@@ -0,0 +1,101 @@
