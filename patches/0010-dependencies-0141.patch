+void CRYPT_AESDecrypt(void* context,
+                      uint8_t* dest,
+                      const uint8_t* src,
+                      uint32_t len) {
+  aes_decrypt_cbc(dest, src, len, (AESContext*)context);
+}
+void CRYPT_AESEncrypt(void* context,
+                      uint8_t* dest,
+                      const uint8_t* src,
+                      uint32_t len) {
+  aes_encrypt_cbc(dest, src, len, (AESContext*)context);
+}
