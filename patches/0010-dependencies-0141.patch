+            PDF_FindValueAbbreviationForTesting(CFX_ByteStringC("DCT")));
+  EXPECT_EQ(CFX_ByteStringC(""),
+            PDF_FindValueAbbreviationForTesting(CFX_ByteStringC("")));
+  EXPECT_EQ(CFX_ByteStringC(""),
+            PDF_FindValueAbbreviationForTesting(CFX_ByteStringC("NoInList")));
