+FX_BOOL CPDF_ContentMarkItem::HasMCID() const {
+  if (m_pParam &&
+      (m_ParamType == DirectDict || m_ParamType == PropertiesDict)) {
+    return m_pParam->KeyExist("MCID");
+  }
+  return FALSE;
+}
