+void CPDF_Font::LoadUnicodeMap() const {
+  m_bToUnicodeLoaded = TRUE;
+  CPDF_Stream* pStream = m_pFontDict->GetStreamBy("ToUnicode");
+  if (!pStream) {
+    return;
+  }
+  m_pToUnicodeMap = new CPDF_ToUnicodeMap;
+  m_pToUnicodeMap->Load(pStream);
+}
