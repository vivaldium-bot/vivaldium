+                   int length,
+                   FPDF_BOOL bUI,
+                   FPDF_WIDESTRING To,
+                   FPDF_WIDESTRING Subject,
+                   FPDF_WIDESTRING CC,
+                   FPDF_WIDESTRING BCC,
+                   FPDF_WIDESTRING Msg);
+
+  /*
+  * Method: Doc_print
+  *           Prints all or a specific number of pages of the document.
+  * Interface Version:
+  *           1
+  * Implementation Required:
+  *           yes
+  * Parameters:
