index 0000000000000000000000000000000000000000..b2e03a86a49038f2e1e201fc8d1991e77829c87b
--- /dev/null
+++ b/third_party/opus/src/silk/float/residual_energy_FLP.c
@@ -0,0 +1,117 @@
