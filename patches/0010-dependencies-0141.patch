+void CPWL_Wnd::RemoveChild(CPWL_Wnd* pWnd) {
+  for (auto it = m_Children.rbegin(); it != m_Children.rend(); ++it) {
+    if (*it && *it == pWnd) {
+      m_Children.erase(std::next(it).base());
+      break;
+    }
+  }
