+               {"3 <> 4", true},
+               {"\"abc\" eq \"def\"", false},
+               {"\"def\" ne \"abc\"", true},
+               {"5 + 5 == 10", true},
+               {"5 + 5 <> \"10\"", false},
+               {"3 < 3", false},
+               {"3 > 4", false},
+               {"\"abc\" <= \"def\"", true},
+               {"\"def\" > \"abc\"", true},
