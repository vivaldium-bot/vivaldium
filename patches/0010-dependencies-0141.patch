+
+  CPWL_MsgControl* GetMsgControl() const;
+
+  CreateParams m_CreationParams;
+  std::vector<CPWL_Wnd*> m_Children;
+  UnownedPtr<CPWL_ScrollBar> m_pVScrollBar;
