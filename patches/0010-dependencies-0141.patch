+
+class SkAdd : public SkADrawable {
+    DECLARE_MEMBER_INFO(Add);
+    SkAdd();
+
+    enum Mode {
+        kMode_indirect,
+        kMode_immediate
+    };
+
+    SkDisplayable* deepCopy(SkAnimateMaker* ) override;
+    bool draw(SkAnimateMaker& ) override;
