+    TEXTURETYPE_CUBE_ARRAY: 4,
+    TEXTURETYPE_1D: 5,
+    TEXTURETYPE_1D_ARRAY: 6,
+    TEXTURETYPE_BUFFER: 7
+};
+
+/**
+ * @enum
+ */
+glsTextureTestUtil.samplerType = {
+    SAMPLERTYPE_FLOAT: 0,
+    SAMPLERTYPE_INT: 1,
+    SAMPLERTYPE_UINT: 2,
+    SAMPLERTYPE_SHADOW: 3,
+
+    SAMPLERTYPE_FETCH_FLOAT: 4,
