diff --git a/third_party/webgl/src/extensions/standards.xsl b/third_party/webgl/src/extensions/standards.xsl
new file mode 100644
index 0000000000000000000000000000000000000000..0cbc16e5e3c93875c1b75b23ece4b0e4fa6d1758
