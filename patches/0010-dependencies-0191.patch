diff --git a/third_party/webgl/src/other/get.webgl.org/emit1.glsl b/third_party/webgl/src/other/get.webgl.org/emit1.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..3c434023039cfc941b113285b3852c1b722137e7
--- /dev/null
+++ b/third_party/webgl/src/other/get.webgl.org/emit1.glsl
@@ -0,0 +1,24 @@
+
+precision highp float;
+
+uniform sampler2D GLGE_EMIT;
+
+varying vec2 texCoord;
+
+float blurSize=0.007;
+
+
+void main(void){
+	vec4 color=vec4(0.0,0.0,0.0,0.0);
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x - 4.0*blurSize, texCoord.y)) * 0.05;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x - 3.0*blurSize, texCoord.y)) * 0.09;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x - 2.0*blurSize, texCoord.y)) * 0.12;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x - blurSize, texCoord.y)) * 0.15;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x, texCoord.y)) * 0.16;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x + blurSize, texCoord.y)) * 0.15;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x + 2.0*blurSize, texCoord.y)) * 0.12;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x + 3.0*blurSize, texCoord.y)) * 0.09;
+	color += texture2D(GLGE_EMIT, vec2(texCoord.x + 4.0*blurSize, texCoord.y)) * 0.05;
+    gl_FragColor = vec4(color.rgb,1.0);
+}
+	
diff --git a/third_party/webgl/src/other/get.webgl.org/emit2.glsl b/third_party/webgl/src/other/get.webgl.org/emit2.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..90cbef459831d841dec62b3f511d745eab9d2135
--- /dev/null
+++ b/third_party/webgl/src/other/get.webgl.org/emit2.glsl
@@ -0,0 +1,26 @@
+
+precision highp float;
+
+uniform sampler2D GLGE_PASS0;
+uniform sampler2D GLGE_RENDER;
+
+varying vec2 texCoord;
+
+float blurSize=0.007;
+
+
+
+void main(void){
+	vec4 color=vec4(0.0,0.0,0.0,0.0);
+	color += texture2D(GLGE_PASS0, vec2(texCoord.x, texCoord.y - 4.0*blurSize)) * 0.05;
