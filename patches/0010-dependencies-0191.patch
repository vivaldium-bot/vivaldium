+    </revision>
+    <revision date="2014/07/15">
+      <change>Added NoInterfaceObject extended attribute.</change>
+    </revision>
+  </history>
+</extension>
diff --git a/third_party/webgl/src/extensions/EXT_shader_texture_lod/extension.xml b/third_party/webgl/src/extensions/EXT_shader_texture_lod/extension.xml
new file mode 100644
