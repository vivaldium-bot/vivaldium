+                            [tcuRGBA.newRGBAFromArray(screen.getPixel(x, y)).getRed(),
+                            (tcuRGBA.newRGBAFromArray(screen.getPixel(x, y)).getGreen() + 255) / 2,
+                            tcuRGBA.newRGBAFromArray(screen.getPixel(x, y)).getBlue(), 255]
