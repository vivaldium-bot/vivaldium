+    for (var name in this.subFolders) {
+      checked = this.subFolders[name].checked();
+      if (checked) {
+        break;
+      }
+    }
+    for (var ii = 0; ii < this.pages.length && checked == false; ++ii) {
+      checked = this.pages[ii].checked();
+    }
