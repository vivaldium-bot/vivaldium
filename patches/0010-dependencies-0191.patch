index 0000000000000000000000000000000000000000..0970a3842c50180af2cee4ee934a9771eb6aef3e
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/2.0.0/extra/slow-shader-example.html
@@ -0,0 +1,133 @@
+<!--
+
+/*
