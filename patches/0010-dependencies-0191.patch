+    } else {
+        testFailed(_a + " is not an instance of " + _type);
+    }
+}
+
+/**
+ * Shows a message in case expression test fails.
+ * @param {boolean} exp
+ * @param {straing} message
+ */
+function checkMessage(exp, message) {
