+    // Note: the math in this function must match that in the vertex and
+    // fragment shader templates above.
+    function computeTexCoord(x) {
+      return x * 0.5 + 0.5;
+    }
+
+    function computeVertexColor(texCoordX, texCoordY) {
+      return [ texCoordX,
