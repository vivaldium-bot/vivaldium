+                                      "h4", "h5", "h6", "head", "hr", "i", "img",
+                                      "li", "listing", "menu", "meta", "nobr", 
+                                      "ol", "p", "pre", "ruby", "s",  "small", 
+                                      "span", "strong", "strike",  "sub", "sup", 
