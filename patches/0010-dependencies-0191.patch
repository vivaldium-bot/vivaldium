+            return ret;
+        }
+
+        if (input instanceof Array) {
+            var size = input.length;
+            for (var i = 0, j = 0; j < size; j++, i++) {
+                ret[i] = input[j].m_hasNaN;
+                i++;
+                ret[i] = input[j].m_lo;
+                i++;
+                ret[i] = input[j].m_hi;
+            }
+            return ret;
+        }
+        return ret;
