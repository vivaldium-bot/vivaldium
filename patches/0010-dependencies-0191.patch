+// Defines a bunch of DesktopGL constants so we can make sure WebGL
+// implementations disallow them.
+
+// Some of these are also GLES2/GLES3 constants that have been removed from
+// WebGL.
+
+var desktopGL = {
+  'MIN': 0x8007,
+  'MAX': 0x8008,
+  'QUADS': 0x0007,
+  'QUAD_STRIP': 0x0008,
+  'POLYGON': 0x0009,
+  '1': 0x0001,
+  '2': 0x0002,
+  '3': 0x0003,
