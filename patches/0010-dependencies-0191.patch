+                    j++;
+                    cpp_lo = ref[i + index].reference[j];
+                    ref_lo = ref1[j];
+                    j++;
+                    cpp_hi = ref[i + index].reference[j];
+                    ref_hi = ref1[j];
+
+                    if (ref_nan == cpp_nan) {
