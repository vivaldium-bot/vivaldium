+        this.m_bound = bound;
+        this.m_inputType = inputType;
+        this.m_outputType = outType;
+        this.m_normalize = normalized;
+        this.m_stride = stride;
+        this.m_offset = offset;
+        this.m_defaultAttrib = defaultAttrib;
