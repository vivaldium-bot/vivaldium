+
+        <div><a href="http://khronos.org/webgl">khronos.org/webgl</a></div>
+      </div>
+      <div id="hostedby">Hosted by <a href="https://www.digitalocean.com/?refcode=645028c23608">Digital Ocean</a></div>
+      </div>
