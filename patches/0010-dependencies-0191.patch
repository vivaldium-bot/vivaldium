+    PROGRAM_3D_UINT: 34,
+
+    PROGRAM_3D_FLOAT_BIAS: 35,
+    PROGRAM_3D_INT_BIAS: 36,
+    PROGRAM_3D_UINT_BIAS: 37,
+
+    PROGRAM_CUBE_ARRAY_FLOAT: 38,
