+  var success = true;
+  for (var ii = 0; ii < 0x10000; ++ii) {
+    if (!validArguments[ii]) {
+      var result = func(ii);
+      if (result !== null) {
+        success = false;
+        testFailed(funcName + " returned " + result + " instead of null for invalid " + argumentName + " enum: " + wtu.glEnumToString(gl, ii));
