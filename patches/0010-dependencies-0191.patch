+<script type="application/javascript" src="js/webgl-test-harness.js"></script>
+<script>
+"use strict";
+var DEFAULT_CONFORMANCE_TEST_VERSION = "2.0.0";
+
+var OPTIONS = {
+  version: DEFAULT_CONFORMANCE_TEST_VERSION,
+  frames: 1,
+  allowSkip: 0,
