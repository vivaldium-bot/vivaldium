+    /**
+     * @param {string} imageSetName
+     * @param {string} imageSetDesc
+     * @param {tcuSurface.Surface} reference
+     * @param {tcuSurface.Surface} result
+     * @param {Array<number>} compareThreshold
+     * @param {Array<number>} renderTargetThreshold
