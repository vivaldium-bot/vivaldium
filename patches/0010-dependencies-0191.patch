+            positions[baseNdx + 2] = fx0; positions[baseNdx + 3] = fy1;
+            positions[baseNdx + 4] = fx1; positions[baseNdx + 5] = fy0;
+            positions[baseNdx + 6] = fx1; positions[baseNdx + 7] = fy1;
