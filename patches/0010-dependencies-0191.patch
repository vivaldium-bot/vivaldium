+    glsBuiltinPrecisionTestsUnitTests.Compare = function(num1, num2, diff) {
+        if (isFinite(num1))
+            if (Math.abs(Math.abs(num1) - Math.abs(num2)) <= diff)
+                return true;
+            else
+                return false;
+        else
+            if (isFinite(num2))
+                return false;
+            else
+                return true;
+    };
