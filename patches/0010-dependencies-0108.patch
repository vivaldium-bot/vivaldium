index 0000000000000000000000000000000000000000..b4c21103ace20891d4f1cfd85eb60b969fb017d9
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/rand_source.h
@@ -0,0 +1,91 @@
+/*
+ * rand_source.h
+ *
+ * implements a random source based on /dev/random
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+/*
