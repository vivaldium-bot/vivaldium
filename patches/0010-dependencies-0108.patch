index 0000000000000000000000000000000000000000..80774f962478d20f8189958682be6159c3b35316
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/xfm.h
@@ -0,0 +1,175 @@
+/*
+ * xfm.h
+ *
+ * interface for abstract crypto transform
+ * 
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
+ *	
+ * Copyright (c) 2001-2006, Cisco Systems, Inc.
+ * All rights reserved.
