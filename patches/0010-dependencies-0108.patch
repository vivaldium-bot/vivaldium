index 0000000000000000000000000000000000000000..f1744ced1e6444753e50884ffdd4fcdbbb67858c
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/sha1.h
@@ -0,0 +1,152 @@
+/*
+ * sha1.h
+ *
+ * interface to the Secure Hash Algorithm v.1 (SHA-1), specified in
+ * FIPS 180-1
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
