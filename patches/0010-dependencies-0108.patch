+            formatter_->InputDigit(UnicodeString("\xEF\xBC\x95" /* "５" */)[0],
+                                   &result_));
+  EXPECT_EQ("650 253",
+            formatter_->InputDigit(UnicodeString("\xEF\xBC\x93" /* "３" */)[0],
+                                   &result_));
+  EXPECT_EQ("650 2532",
+            formatter_->InputDigit(UnicodeString("\xEF\xBC\x92" /* "２" */)[0],
+                                   &result_));
+  EXPECT_EQ("650 253 22",
+            formatter_->InputDigit(UnicodeString("\xEF\xBC\x92" /* "２" */)[0],
+                                   &result_));
+  EXPECT_EQ("650 253 222",
+            formatter_->InputDigit(UnicodeString("\xEF\xBC\x92" /* "２" */)[0],
