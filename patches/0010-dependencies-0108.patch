+  EXPECT_EQ(PhoneNumberUtil::INVALID_NUMBER,
+            phone_util_.IsNumberMatchWithTwoStrings("4", "3 331 6043"));
+  // Invalid numbers that can't be parsed.
+  EXPECT_EQ(PhoneNumberUtil::INVALID_NUMBER,
+            phone_util_.IsNumberMatchWithTwoStrings("+43", "+64 3 331 6005"));
+  EXPECT_EQ(PhoneNumberUtil::INVALID_NUMBER,
+            phone_util_.IsNumberMatchWithTwoStrings("+43", "64 3 331 6005"));
