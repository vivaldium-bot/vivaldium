+++ b/third_party/libsrtp/srtp/crypto/kernel/err.c
@@ -0,0 +1,152 @@
+/*
+ * err.c
+ *
+ * error status reporting functions
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+/*
