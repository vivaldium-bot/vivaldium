--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/rng/prng.c
@@ -0,0 +1,184 @@
+/*
+ * prng.c 
+ *
+ * pseudorandom source
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+/*
+ *	
