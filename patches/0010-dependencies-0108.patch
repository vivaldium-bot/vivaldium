--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/crypto_kernel.h
@@ -0,0 +1,281 @@
+/*
+ * crypto_kernel.h
+ *
+ * header for the cryptographic kernel
+ *
+ * David A. McGrew
