index 0000000000000000000000000000000000000000..4ca0f03e6a6afe6a6a6ea652c26197b2faf6d533
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/hash/auth.c
@@ -0,0 +1,187 @@
+/*
+ * auth.c
+ *
+ * some bookkeeping functions for authentication functions
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
