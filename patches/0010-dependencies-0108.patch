index 0000000000000000000000000000000000000000..c200437b72a9f4b7644a4e13481b49a72112077c
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/hash/sha1.c
@@ -0,0 +1,408 @@
+/*
+ * sha1.c
+ *
+ * an implementation of the Secure Hash Algorithm v.1 (SHA-1),
+ * specified in FIPS 180-1
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
+ *	
+ * Copyright (c) 2001-2006, Cisco Systems, Inc.
+ * All rights reserved.
