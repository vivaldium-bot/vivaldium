index 0000000000000000000000000000000000000000..5b5e4b21d470fedd5a5f106a56fd2639a9d12e13
--- /dev/null
+++ b/third_party/libsrtp/srtp/crypto/include/auth.h
@@ -0,0 +1,171 @@
+/*
+ * auth.h
+ *
+ * common interface to authentication functions
+ *
+ * David A. McGrew
+ * Cisco Systems, Inc.
+ */
+
+/*
+ *	
+ * Copyright (c) 2001-2006, Cisco Systems, Inc.
