--- /dev/null
+++ b/chrome/installer/mac/third_party/xz/xz/src/liblzma/common/stream_decoder.h
@@ -0,0 +1,21 @@
+///////////////////////////////////////////////////////////////////////////////
+//
+/// \file       stream_decoder.h
