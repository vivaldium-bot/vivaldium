+  'variables': {
+    'mac_product_name': 'Vivaldi',
+    'mac_packaging_dir':
+        '<(PRODUCT_DIR)/<(mac_product_name) Packaging',
+    # <(PRODUCT_DIR) expands to $(BUILT_PRODUCTS_DIR), which doesn't
+    # work properly in a shell script, where ${BUILT_PRODUCTS_DIR} is
+    # needed.
+    'mac_packaging_sh_dir':
