+msgid "Unknown-6"
+msgstr "Sconosc6"
+
+#: src/xz/list.c:74
+msgid "Unknown-7"
+msgstr "Sconosc7"
+
+#: src/xz/list.c:75
+msgid "Unknown-8"
+msgstr "Sconosc8"
+
+#: src/xz/list.c:76
+msgid "Unknown-9"
+msgstr "Sconosc9"
+
+#: src/xz/list.c:78
+msgid "Unknown-11"
+msgstr "Sconosc11"
+
+#: src/xz/list.c:79
+msgid "Unknown-12"
+msgstr "Sconosc12"
+
+#: src/xz/list.c:80
+msgid "Unknown-13"
+msgstr "Sconosc13"
+
+#: src/xz/list.c:81
