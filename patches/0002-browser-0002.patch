+        "name": "onMainMenuCommand",
+        "type": "function",
+        "description": "Fired when a main menu command is selected.",
+        "parameters": [
+          {
+            "type": "integer",
+            "name": "commandId",
+            "minimum": 0,
+            "description":"id of the command selected."
+          }
