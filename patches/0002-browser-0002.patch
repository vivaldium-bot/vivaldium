+                  <<< $DPKG_SHLIB_DEPS)
+DPKG_SHLIB_DEPS=$(sed 's/\(libc6-i386 (\([^)]*\))\), /\1 | libc6 (\2), /g' \
+                  <<< $DPKG_SHLIB_DEPS)
+
 COMMON_DEPS="${DPKG_SHLIB_DEPS}, ${ADDITION_DEPS}"
 COMMON_PREDEPS="dpkg (>= 1.14.0)"
 
