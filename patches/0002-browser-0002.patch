+ protected:
+  void DestroyBrowser() override;
+
+ private:
+  // The Browser object we are associated with.
+  scoped_ptr<Browser> browser_;
+
+  // Is the window active.
+  bool is_active_;
+
+  // The window bounds.
+  gfx::Rect bounds_;
