+#!/bin/sh
+
+###############################################################################
+#
+# Author: Lasse Collin
+#
+# This file has been put into the public domain.
+# You can do whatever you want with this file.
+#
+###############################################################################
+
+# If both xz and xzdec were not build, skip this test.
+XZ=../src/xz/xz
+XZDEC=../src/xzdec/xzdec
+test -x "$XZ" || XZ=
+test -x "$XZDEC" || XZDEC=
+if test -z "$XZ$XZDEC"; then
+	(exit 77)
+	exit 77
+fi
+
+for I in "$srcdir"/files/good-*.xz
+do
+	if test -z "$XZ" || "$XZ" -dc "$I" > /dev/null 2>&1; then
+		:
+	else
+		echo "Good file failed: $I"
+		(exit 1)
+		exit 1
+	fi
+
+	if test -z "$XZDEC" || "$XZDEC" "$I" > /dev/null 2>&1; then
+		:
+	else
+		echo "Good file failed: $I"
+		(exit 1)
+		exit 1
+	fi
+done
+
+for I in "$srcdir"/files/bad-*.xz
+do
+	if test -n "$XZ" && "$XZ" -dc "$I" > /dev/null 2>&1; then
+		echo "Bad file succeeded: $I"
+		(exit 1)
+		exit 1
+	fi
+
+	if test -n "$XZDEC" && "$XZDEC" "$I" > /dev/null 2>&1; then
+		echo "Bad file succeeded: $I"
+		(exit 1)
+		exit 1
+	fi
+done
+
+(exit 0)
+exit 0
diff --git a/chrome/installer/mac/third_party/xz/xz/tests/test_filter_flags.c b/chrome/installer/mac/third_party/xz/xz/tests/test_filter_flags.c
