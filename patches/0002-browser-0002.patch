+#: src/xz/list.c:74
+msgid "Unknown-7"
+msgstr "Unbek.7"
+
+#: src/xz/list.c:75
+msgid "Unknown-8"
+msgstr "Unbek.8"
+
+#: src/xz/list.c:76
+msgid "Unknown-9"
+msgstr "Unbek.9"
+
+#: src/xz/list.c:78
+msgid "Unknown-11"
+msgstr "Unbek.11"
+
+#: src/xz/list.c:79
+msgid "Unknown-12"
+msgstr "Unbek.12"
