+  def testFollowupUpdateDependenciesNoOverlap(self):
+    dep_manager = dependency_manager.DependencyManager([])
+    dep = 'dependency'
+    dep1 = 'dependency1'
+    dep2 = 'dependency2'
+    dep3 = 'dependency3'
