+      var entryTime = timeutil.convertTimeTicksToTime(entry.orig.time);
+      addRowWithTime(tablePrinter, entryTime - baseTime, startTime - baseTime);
+
+      for (var j = entry.getDepth(); j > 0; --j)
+        tablePrinter.addCell('  ');
