new file mode 100644
index 0000000000000000000000000000000000000000..7feb1615fbc1b6eef336f8000ac1fcbc27660a16
--- /dev/null
+++ b/third_party/boringssl/src/ssl/ssl_buffer.c
@@ -0,0 +1,311 @@
