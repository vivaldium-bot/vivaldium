+OPENSSL_EXPORT void CRYPTO_THREADID_current(CRYPTO_THREADID *id);
+
+/* CRYPTO_set_id_callback does nothing. */
+OPENSSL_EXPORT void CRYPTO_set_id_callback(unsigned long (*func)(void));
