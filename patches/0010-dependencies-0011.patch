+int SSL_set_session(SSL *ssl, SSL_SESSION *session) {
+  /* SSL_set_session may only be called before the handshake has started. */
+  if (ssl->state != SSL_ST_INIT || ssl->s3->initial_handshake_complete) {
+    abort();
+  }
+
+  ssl_set_session(ssl, session);
+  return 1;
+}
