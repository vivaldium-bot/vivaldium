+      archive_path = shutil.make_archive(base_path, 'zip', dir_path)
+      self.assertTrue(os.path.exists(archive_path))
+      self.assertTrue(zipfile.is_zipfile(archive_path))
+    except:
+      if os.path.isfile(archive_path):
