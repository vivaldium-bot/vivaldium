+# Output of lsusb.lsusb().
+# We just test that the dictionary is working by creating an
+# "ID number" equal to (bus_num*1000)+device_num and seeing if
+# it is picked up correctly. Also we test the description
+
+DEVLIST = [(1, 11, 'foo'),
+           (1, 12, 'bar'),
+           (1, 13, 'baz'),
+           (2, 11, 'quux'),
+           (2, 20, 'My Test HUB'),
