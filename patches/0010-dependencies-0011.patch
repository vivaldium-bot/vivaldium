+def _GetPathsToPrepend(input_api):
+  project_dir = input_api.PresubmitLocalPath()
+  catapult_dir = input_api.os_path.join(project_dir, '..')
+  return [
+      project_dir,
+
+      input_api.os_path.join(catapult_dir, 'third_party', 'mock'),
+  ]
