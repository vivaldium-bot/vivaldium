+        // Order some ciphers backwards by strength.
+        "ALL:-CHACHA20:-AES256:-AES128:-ALL:"
+        // Select ECDHE ones and sort them by strength. Ties should resolve
+        // based on the order above.
+        "kECDHE:@STRENGTH:-ALL:"
