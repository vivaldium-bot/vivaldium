+    self.assertEquals(0, pb.distribution.underflow)
+    self.assertEquals(0, pb.distribution.overflow)
+    self.assertEquals(30, pb.distribution.mean)
+
+    pb = metrics_pb2.MetricsData()
+    d = distribution.Distribution(
