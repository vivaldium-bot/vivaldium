+  # were not checked in.
+  Rake::Task['build'].invoke
+
+  release do
+    # Put other release-related stuff here, such as publishing docs;
+    # if anything fails, gl-matrix will be untagged and not pushed.
+    #
+    # Example:
+    #
+    #   Rake::Task['doc:publish'].invoke
+    #
+  end
+end
