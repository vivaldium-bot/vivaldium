+        assert.closeTo(0.97725, dist.computePercentile(
+            dist.mean + 2 * dist.standardDeviation), 1e-5);
+        assert.closeTo(1, dist.computePercentile(1e10), 1e-5);
+      }
+    }
+  });
+
+  test('logNormalDistribution', function() {
