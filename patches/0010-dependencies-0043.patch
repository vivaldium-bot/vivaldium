+class TestBase(unittest.TestCase):
+  def setUp(self):
+    self.mock_state = stubs.MockState()
+    self.state_patcher = mock.patch('infra_libs.ts_mon.common.interface.state',
+                                    new=self.mock_state)
+    self.state_patcher.start()
+
+  def tearDown(self):
+    self.state_patcher.stop()
