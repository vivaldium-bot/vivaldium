+    assert.deepEqual(zFunction('', 0), []);
+    assert.deepEqual(zFunction('A', 1), []);
+    assert.deepEqual(zFunction('ABC', 3), []);
+
+    // Singleton list/string.
+    checkZFunction([1], [0]);
