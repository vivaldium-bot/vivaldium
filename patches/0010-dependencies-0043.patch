+        httplib.BadStatusLine('[BadStatusLine] forced test fail'),
+        urllib2.HTTPError(upload_url, 400, '[HTTPError] forced test fail',
+                          {}, None),
+        urllib2.URLError('[URLError] forced test fail'),
+    )
+    raise random.choice(exceptions)
+  else:
+    return result
