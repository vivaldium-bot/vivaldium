+        cros_build_lib.RunCommand(cmd, print_cmd=False, redirect_stdout=True,
+                                  combine_stdout_stderr=True)
+
+    # If requested, remove the eclass.
+    if missing:
+      os.remove(eclass_path)
+
+    return eclass_path
