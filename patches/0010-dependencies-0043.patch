+      expect('..foo').not.toMatchPath(   ['a', 'foo', 'a']);
+      expect('..foo').toMatchPath(       ['a', 'foo', 'foo']);
+      expect('..foo').toMatchPath(       ['a', 'a', 'foo']);
+      expect('..foo').not.toMatchPath(   ['a', 'a', 'foot']);
+      expect('..foo').not.toMatchPath(   ['a', 'foo', 'foo', 'a']);
