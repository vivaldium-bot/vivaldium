+
+<script>
+
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var V8LogImporter = tr.e.importer.v8.V8LogImporter;
+
+  function newModel(events) {
+    return tr.c.TestUtils.newModelWithEvents([events], {
