+
+        )).toSpecifyNode({name:  'Jack',  email: 'jack@example.com'});
+
+      });
+
+      it('can duck on two levels of a path', function(){
+
+        var rootJson = {
+          people:{
+            jack:{
+              name:  'Jack'
+              ,  email: 'jack@example.com'
+            }
+          }
