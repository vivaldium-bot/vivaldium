+              },
+              'inferred_strong_root2/inferred_strong_child/desc3_strong': {
+                guid: '13', attrs: {}
+              },
+              'inferred_strong_root2/weak_child': {
+                guid: '14', attrs: {}, flags: 1
+              },
+
+              // A desdendant dump should be removed if it has a weak ancestor.
