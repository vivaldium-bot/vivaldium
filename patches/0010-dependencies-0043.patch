+  test('cpuProcessMetric_singleSnapshots', function() {
+    var histograms = new tr.v.HistogramSet();
+    var events = [
+      {
+        'name': 'CPUSnapshots',
+        'args': {
+          'snapshot': {
+            'processes': [
+              {'path': '/usr/sbin/crudd', 'pCpu': '99.0', 'pid': '13495',
+                'pMem': '0.0', 'name': 'crudd'},
