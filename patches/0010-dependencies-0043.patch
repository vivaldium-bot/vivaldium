+    range.addValue(1);
+    assert.isFalse(range.isEmpty);
+    assert.equal(1, range.min);
+    assert.equal(1, range.max);
+
+    range.addValue(2);
+    assert.isFalse(range.isEmpty);
+    assert.equal(1, range.min);
+    assert.equal(2, range.max);
+  });
+
+  test('addNonEmptyRange', function() {
