+++ b/third_party/elfutils/src/libelf/gelf.h
@@ -0,0 +1,332 @@
+/* This file defines generic ELF types, structures, and macros.
+   Copyright (C) 1999, 2000, 2001, 2002, 2004, 2005, 2007 Red Hat, Inc.
+   This file is part of elfutils.
