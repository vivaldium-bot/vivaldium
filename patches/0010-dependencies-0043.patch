+
+    // No duplicate elements.
+    checkZFunction([1, 2, 3, 4, 5], [0, 0, 0, 0, 0]);
+    checkZFunction('ABCDEF', [0, 0, 0, 0, 0, 0]);
+
+    // No substring is a suffix.
+    checkZFunction([1, 2, 3, 2], [0, 0, 0, 0]);
+    checkZFunction('ABBB', [0, 0, 0, 0]);
