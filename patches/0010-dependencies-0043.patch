+   not, see <http://www.gnu.org/licenses/>.  */
+
+#ifdef HAVE_CONFIG_H
+# include <config.h>
+#endif
+
+#include "cfi.h"
+#include <search.h>
+#include <stdlib.h>
+
+
+static void
+free_cie (void *arg)
+{
+  struct dwarf_cie *cie = arg;
+
+  free ((Dwarf_Frame *) cie->initial_state);
+  free (cie);
+}
+
+#define free_fde	free
+
+static void
+free_expr (void *arg)
+{
+  struct loc_s *loc = arg;
+
+  free (loc->loc);
+  free (loc);
+}
+
+void
+internal_function
+__libdw_destroy_frame_cache (Dwarf_CFI *cache)
+{
+  /* Most of the data is in our two search trees.  */
+  tdestroy (cache->fde_tree, free_fde);
+  tdestroy (cache->cie_tree, free_cie);
+  tdestroy (cache->expr_tree, free_expr);
+}
diff --git a/third_party/elfutils/src/libdw/libdw.h b/third_party/elfutils/src/libdw/libdw.h
new file mode 100644
index 0000000000000000000000000000000000000000..0d94c526c027ecd528b20c2ddd47c3505edc1d1d
--- /dev/null
+++ b/third_party/elfutils/src/libdw/libdw.h
@@ -0,0 +1,902 @@
+/* Interfaces for libdw.
+   Copyright (C) 2002-2010, 2013 Red Hat, Inc.
+   This file is part of elfutils.
+
