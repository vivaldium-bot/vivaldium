+        for (var i = 0; i < singleDimensionPathLength; i++)
+          node = this.getOrCreateChildNode_(node, d, singleDimensionPath[i]);
+      }
+
+      for (var v = 0; v < this.valueCount_; v++) {
+        var addedValue = values[v];
