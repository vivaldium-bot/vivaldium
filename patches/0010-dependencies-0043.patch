+#endif
+
+#include <dwarf.h>
+#include "libdwP.h"
+
+
+int
+dwarf_formflag (attr, return_bool)
+     Dwarf_Attribute *attr;
+     bool *return_bool;
+{
+  if (attr == NULL)
+    return -1;
+
+  if (attr->form == DW_FORM_flag_present)
+    {
+      *return_bool = true;
+      return 0;
+    }
+
+  if (unlikely (attr->form != DW_FORM_flag))
+    {
+      __libdw_seterrno (DWARF_E_NO_FLAG);
+      return -1;
+    }
+
+  *return_bool = *attr->valp != 0;
+
+  return 0;
+}
diff --git a/third_party/elfutils/src/libdw/dwarf_formref.c b/third_party/elfutils/src/libdw/dwarf_formref.c
new file mode 100644
index 0000000000000000000000000000000000000000..86da7eae351e7b73c37bd481588e95599f44c639
--- /dev/null
+++ b/third_party/elfutils/src/libdw/dwarf_formref.c
@@ -0,0 +1,99 @@
+/* Return reference offset represented by attribute.
+   Copyright (C) 2003-2010 Red Hat, Inc.
+   This file is part of elfutils.
+   Written by Ulrich Drepper <drepper@redhat.com>, 2003.
