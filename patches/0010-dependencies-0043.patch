diff --git a/third_party/elfutils/src/backends/s390_unwind.c b/third_party/elfutils/src/backends/s390_unwind.c
new file mode 100644
index 0000000000000000000000000000000000000000..752bc2873f9abfe9fcb9372bb420cd501fd3d151
--- /dev/null
+++ b/third_party/elfutils/src/backends/s390_unwind.c
@@ -0,0 +1,139 @@
+/* Get previous frame state for an existing frame state.
+   Copyright (C) 2013 Red Hat, Inc.
+   This file is part of elfutils.
+
+   This file is free software; you can redistribute it and/or modify
+   it under the terms of either
+
