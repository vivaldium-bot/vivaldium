+  var MeasureAsyncSlice = tr.e.measure.MeasureAsyncSlice;
+
+  test('basic', function() {
+    var s = new MeasureAsyncSlice(
+      'blink.user_timing', 'createImports', 7, 0, {});
+    s.duration = 100;
