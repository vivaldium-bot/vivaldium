+  returncode = random.randint(1, 100) <= 80
+  logging.debug('would run (and return %i): %s', returncode,
+                cros_build_lib.CmdToStr(cmd))
+  if returncode:
+    output = 'Failed to send the symbol file.'
+  else:
+    output = 'Successfully sent the symbol file.'
