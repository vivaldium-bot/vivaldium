diff --git a/third_party/catapult/tracing/third_party/oboe/test/libs/prettyPrintEvents.js b/third_party/catapult/tracing/third_party/oboe/test/libs/prettyPrintEvents.js
new file mode 100644
index 0000000000000000000000000000000000000000..6ed953607fce6ad157a197cf9f37e712fa44abea
--- /dev/null
+++ b/third_party/catapult/tracing/third_party/oboe/test/libs/prettyPrintEvents.js
@@ -0,0 +1,13 @@
+function prettyPrintEvent(event){
+
+   switch(event) {
+      case     HTTP_START:  return 'start';
+      case     STREAM_DATA: return 'data';
+      case     STREAM_END:  return 'end';
+      case     SAX_KEY          : return 'sax_key';
+      case     SAX_VALUE_OPEN   : return 'sax_open';
+      case     SAX_VALUE_CLOSE  : return 'sax_close';
+      case     FAIL_EVENT       : return 'fail';
+      default: return 'unknown(' + event + ')'
+   }
+}
