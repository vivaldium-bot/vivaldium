+      }
+      ,
+      'single-minified': {
+        browsers: autoStartBrowsers,
+        configFile: 'test/min.conf.js'
+      }
+
+      ,
+      'single-amd': {
+        browsers: autoStartBrowsers,
+        configFile: 'test/amd.conf.js'
+      }
+
+      ,
+      'single-browser-http': {
+        browsers: autoStartBrowsers,
+        configFile: 'test/http.conf.js'
+      }
+
+      ,
+      'persist': {
+        // for setting up a persistent karma server.
+        // To start the server, the task is:
