+    r1.addValue(1);
+    r1.addValue(2);
+
+    var r = new Range();
+    r.addRange(r1);
+    assert.equal(1, r.min);
+    assert.equal(2, r.max);
+
+    var r2 = Range.fromDict(r.toJSON());
+    assert.equal(r2.isEmpty, r.isEmpty);
+    assert.equal(r2.max, r.max);
+    assert.equal(r2.min, r.min);
+  });
+
+  test('addEmptyRange', function() {
