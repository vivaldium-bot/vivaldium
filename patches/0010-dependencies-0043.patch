diff --git a/third_party/elfutils/src/libelf/gelf_getnote.c b/third_party/elfutils/src/libelf/gelf_getnote.c
new file mode 100644
index 0000000000000000000000000000000000000000..1a36855331b8f9a764444e8b06ced6bfb0bf6567
--- /dev/null
+++ b/third_party/elfutils/src/libelf/gelf_getnote.c
@@ -0,0 +1,98 @@
+/* Get note information at the supplied offset.
+   Copyright (C) 2007 Red Hat, Inc.
+   This file is part of elfutils.
+
+   This file is free software; you can redistribute it and/or modify
+   it under the terms of either
