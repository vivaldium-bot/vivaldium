+    d.add(5)
+    d.add(15)
+    d.add(25)
+
+    m._populate_value(pb, d, 1234)
+    self.assertEquals([1], pb.distribution.bucket)
+    self.assertEquals(0, pb.distribution.underflow)
+    self.assertEquals(2, pb.distribution.overflow)
+    self.assertEquals(15, pb.distribution.mean)
