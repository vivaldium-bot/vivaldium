+        if m is not None:
+            self.msgout(3, "import_module ->", m)
+            if parent:
+                self._updateReference(m, parent, edge_data=DependencyInfo(
+                    conditional=False, fromlist=False, function=False, tryexcept=False
+                ))
+            return m
