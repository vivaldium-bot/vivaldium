+  static_assert(sizeof(cert->sid_ctx) < 256, "sid_ctx too large");
+  cert->sid_ctx_length = (uint8_t)sid_ctx_len;
+  OPENSSL_memcpy(cert->sid_ctx, sid_ctx, sid_ctx_len);
+  return 1;
+}
