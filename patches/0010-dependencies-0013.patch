+    def assertNoMethods(self, klass):
+        d = dict(klass.__dict__)
+        del d['__doc__']
+        del d['__module__']
+        if '__qualname__' in d:
+            # New in Python 3.3
+            del d['__qualname__']
+        if '__dict__' in d:
+            # New in Python 3.4
+            del d['__dict__']
+        self.assertEqual(d, {})
+
+    def assertHasExactMethods(self, klass, *methods):
+        d = dict(klass.__dict__)
+        del d['__doc__']
+        del d['__module__']
+        if '__qualname__' in d:
+            # New in Python 3.3
+            del d['__qualname__']
+        if '__dict__' in d:
+            # New in Python 3.4
+            del d['__dict__']
+
+        for nm in methods:
+            self.assertTrue(nm in d, "%s doesn't have attribute %r"%(klass, nm))
+            del d[nm]
+
+        self.assertEqual(d, {})
+
