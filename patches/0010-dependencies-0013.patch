+    # Make a request to t migrate a test and then execute tasks on the queue.
+    self.testapp.post('/migrate_test_names', {
+        'old_pattern': '*/*/moz/read_op_b/r_op_b',
+        'new_pattern': '*/*/moz/read_operations_browser',
