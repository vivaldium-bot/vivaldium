+    mean_pixels_value = self.metric._ComputeMeanPixelsCheckerboarded(
+        self.page, stats)
+    self.assertEquals(None, mean_pixels_value.value)
+    self.assertEquals('test error',
+                      mean_pixels_value.none_value_reason)
