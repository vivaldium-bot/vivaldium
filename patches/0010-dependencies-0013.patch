+  def testPost_MigrationFinished_EmailsSheriff(self):
+    self._AddMockData()
+
+    # Add a sheriff for one test.
+    test_path = 'ChromiumPerf/mac/moz/read_op_b/r_op_b'
+    test = utils.TestKey(test_path).get()
