+
+  def testFlattenTrace_ListValue_WithLongs(self):
+    """Tests that lists of scalars can include longs."""
+    trace = self._SampleTrace()
+    trace.update({
+        'type': 'list_of_scalar_values',
+        'values': [1000000000L, 2000000000L],
+    })
