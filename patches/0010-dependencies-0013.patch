+class GitilesTest(unittest.TestCase):
+
+  def testCommitInfo(self, mock_fetch):
+    return_value = {
+        'commit': 'commit_hash',
+        'tree': 'tree_hash',
+        'parents': ['parent_hash'],
+        'author': {
+            'name': 'username',
