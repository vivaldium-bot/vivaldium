+import types
+
+from py_trace_event.trace_event_impl import decorators
+
+
+class TracedMetaClass(type):
+  def __new__(cls, name, bases, attrs):
+    for attr_name, attr_value in attrs.iteritems():
+      if isinstance(attr_value, types.FunctionType):
