+    self.assertEqual(
+        {'foo': 'bar'},
+        update_test_suites.FetchCachedTestSuites())
+    self._AddSampleData()
+    # Because there is something cached, the cache is
+    # not automatically updated when new data is added.
+    self.assertEqual(
+        {'foo': 'bar'},
+        update_test_suites.FetchCachedTestSuites())
