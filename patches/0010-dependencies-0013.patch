+<!DOCTYPE html>
+<!--
+Copyright 2016 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+<!--
+Most of this code is duplicated in bisect-form.
+TODO(qyearsley): This should be resolved for better code health.
+See https://github.com/catapult-project/catapult/issues/1905
+-->
+
+<link rel="import" href="/components/paper-button/paper-button.html">
+
+<link rel="import" href="/dashboard/elements/trace-form.html">
+<link rel="import" href="/dashboard/static/simple_xhr.html">
+
+<dom-module id="trace-button">
+  <template>
+    <style>
+      /*
+       * FIXME: This style is duplicated from the bisect-form style.
+       * See the comments there.
+       */
+      #button:not([disabled]) {
+        background-color: #4285f4;
+        color: white;
+      }
+
+      :host(.mini) #button {
+        height: 22px;
+        line-height: 0.5em;
+        margin-left: 5px;
+        padding-top: 0;
+      }
+    </style>
+    <paper-button raised
+        id="button"
+        disabled$={{!traceInfo.canBisect}}
+        on-click="onTrace">Trace</paper-button>
+    <trace-form
+        id="trace"
+        xsrf-token="{{xsrfToken}}"
+        earlier-revision="{{traceInfo.goodRev}}"
+        later-revision="{{traceInfo.badRev}}"
+        test-path="{{traceInfo.testPath}}"
+        rerun-info="{{traceInfo.traceRerunInfo}}"
+        bug-id="{{bugId}}"></trace-form>
+  </template>
+  <script>
+    'use strict';
+    (function() {
+      Polymer({
+
+        is: 'trace-button',
+        properties: {
+          bugId: { notify: true },
+          traceInfo: {
+            notify: true
+          },
+          xsrfToken: { notify: true }
+        },
+
+        /**
+         * Displays the trace-form when the trace button is clicked.
+         */
+        onTrace() {
+          this.$.trace.show();
+        }
+      });
+    })();
+  </script>
+</dom-module>
diff --git a/third_party/catapult/dashboard/dashboard/elements/trace-form.html b/third_party/catapult/dashboard/dashboard/elements/trace-form.html
new file mode 100644
index 0000000000000000000000000000000000000000..355b8d65d98e0d8bba5b764d2a99165af89a551a
--- /dev/null
+++ b/third_party/catapult/dashboard/dashboard/elements/trace-form.html
@@ -0,0 +1,269 @@
+<!DOCTYPE html>
+<!--
+Copyright 2016 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+<!--
+The trace-form element includes the form for all of the different stages of
+the trace process after the user clicks on the trace button.
+-->
+
+<link rel="import" href="/components/paper-button/paper-button.html">
+<link rel="import" href="/components/paper-dialog/paper-dialog.html">
+<link rel="import" href="/components/paper-spinner/paper-spinner.html">
+
+<link rel="import" href="/dashboard/static/simple_xhr.html">
+
+<dom-module is="trace-form">
+  <template>
+
+    <paper-dialog id="container" autoCloseDisabled="true">
+      <!-- Styling for paper-dialog's children. -->
+      <style>
+        #loading {
+          background-color: white;
+          height: 100%;
+          width: 100%;
+          position: absolute;
+          left: 0;
+          top: 0;
+          display: -webkit-flex;
+          display: flex;
+          -webkit-align-items: center;
+          align-items: center;
+          justify-content: center;
+          -webkit-justify-content: center;
+        }
+
+        input[type=text], input[type=number] {
+          border-radius: 1px;
+          border: 1px solid #d9d9d9;
+          border-top: 1px solid #c0c0c0;
+          font-size: 13px;
+          height: 25px;  /* 29 px total height including padding + border */
+          width: 300px;
+          padding: 1px 2px;
+        }
+
+        paper-button[dialog-confirm] {
+          background: #4285f4;
+          color: #fff;
+        }
+      </style>
+
+      <form on-submit="onSendToTrybot">
+        <table>
+          <tr>
+            <td>Record a before/after trace profile.</td>
+          </tr>
+          <tr>
+            <td>Perf try bot:</td>
+            <td>
+              <input type="text" list="bot-list" id="bot" value="{{bot::input}}">
+              <datalist id="bot-list">
+                <template is="dom-repeat" items="{{botList}}" as="name">
+                  <option value="{{name}}"></option>
+                </template>
+              </datalist>
+            </td>
+          </tr>
+          <tr>
+            <td>Trace Options:</td>
+            <td>
+              <select id="rerun-options">
+                <template is="dom-repeat" items="{{rerunInfo}}">
+                  <option value="{{item.option}}">{{item.name}}</option>
+                </template>
+              </select>
+            </td>
+          </tr>
+          <tr>
+            <td>Earlier revision:</td>
+            <td><input type="text" value="{{earlierRevision::input}}"></td>
+          </tr>
+          <tr>
+            <td>Later revision:</td>
+            <td><input type="text" value="{{laterRevision::input}}"></td>
+          </tr>
+        </table>
+      </form>
+
+      <p class="error">{{error}}</p>
+
+      <paper-button dialog-confirm raised autofocus disabled$="{{computeHasError(error)}}"
+                    on-click="onSendToTrybot">Send to perf try bot</paper-button>
+      <paper-button dialog-dismiss raised>Close</paper-button>
+
+      <template is="dom-if" if="{{loading}}">
+        <div id="loading">
+          <paper-spinner active></paper-spinner>
+        </div>
+      </template>
+      <div id="toasts" hidden>
+        <div id="jobsubmitted">
+          <b>Job submitted!</b>
+          <a href="https://codereview.chromium.org/{{lastSubmittedJobId}}"
+             target="_blank">View issue {{lastSubmittedJobId}} in Rietveld.</a>
+        </div>
+      </div>
+    </paper-dialog>
+
+  </template>
+  <script>
+    'use strict';
+    (function() {
+      /**
+       * Checks whether a revision appears to be OK to use for bisect.
+       * TODO(qyearsley): Extract common code in trace-form and bisect-form.
+       */
+      function validateRev(rev) {
+        if (/^[a-fA-F0-9]{40}$/.test(rev)) {
+          return true;
+        }
+        if (!/^\d+/.test(rev)) {
+          return false;
+        }
+        rev = Number(rev);
+        return rev > 200000 && rev < 500000;
+      }
+
+      Polymer({
+        is: 'trace-form',
+        properties: {
+          bugId: { notify: true },
+          error: { type: String, value: '', notify: true},
+          earlierRevision: {
+            notify: true,
+            observer: 'earlierRevisionChanged'
+          },
+          laterRevision: {
+            notify: true,
+            observer: 'laterRevisionChanged'
+          },
+          rerunInfo: { notify: true },
+          testPath: { notify: true },
+          xsrfToken: { notify: true }
+        },
+
+        computeHasError: errorMessage => !!errorMessage,
+
+        /**
+         * Initializes and shows the trace form.
+         */
+        show() {
+          this.open();
+          this.loading = true;
+
+          simple_xhr.send('/start_try_job',
+              {
+                'test_path': this.testPath,
+                'step': 'prefill-info',
+                'xsrf_token': this.xsrfToken
+              },
+              function successCallback(info) {
+                this.bot = info.bisect_bot;
+                this.botList = info.all_bots;
+
+                Polymer.dom.flush();
+
+                this.email = info.email;
+                this.suite = info.suite;
+                this.page = info.page;
+                this.loading = false;
+              }.bind(this),
+              function errorCallback(msg) {
+                this.fire('display-toast', {
+                  'text': 'An error occurred: ' + msg,
+                  'error': true
+                });
+                this.close();
+              }.bind(this));
+        },
+
+        /**
+         * Gets the currently selected rerun option from the select menu.
+         */
+        getRerunOptions() {
+          const selected = this.$['rerun-options'].selectedOptions[0];
+          if (selected) {
+            return selected.value;
+          }
+          return null;
+        },
+
+        /**
+         * Makes a request to /start_try_job to perform a perf try job.
+         */
+        onSendToTrybot(event) {
+          event.preventDefault();
+          this.loading = true;
+          const params = {
+            'step': 'perform-perf-try',
+            'bisect_bot': this.bot,
+            'suite': this.suite,
+            'good_revision': this.earlierRevision,
+            'bad_revision': this.laterRevision,
+            'page': this.page,
+            'rerun_option': this.getRerunOptions(),
+            'xsrf_token': this.xsrfToken
+          };
+          if (this.bugId) {
+            params.bug_id = this.bugId;
+          }
+          simple_xhr.send(
+              '/start_try_job', params,
+              function(info) {
+                this.lastSubmittedJobId = info.issue_id;
+                this.fire('display-toast', {'content': this.$.jobsubmitted});
+                this.close();
+              }.bind(this),
+              function(msg) {
+                this.fire('display-toast', {
+                  'text': 'An error occurred: ' + msg,
+                  'error': true
+                });
+                this.close();
+              }.bind(this));
+        },
+
+        earlierRevisionChanged() {
+          this.error = '';
+          if (!validateRev(this.earlierRevision)) {
+            this.error = 'Revisions should be git commit positions or hashes.';
+            return;
+          }
+          this.onRevisionsChange();
+        },
+
+        laterRevisionChanged() {
+          this.error = '';
+          if (!validateRev(this.laterRevision)) {
+            this.error = 'Revisions should be git commit positions or hashes.';
+            return;
+          }
+          this.onRevisionsChange();
+        },
+
+        onRevisionsChange() {
+          if (!/^\d+$/.test(this.earlierRevision) ||
+              !/^\d+$/.test(this.laterRevision)) {
+            return;
+          }
+          if (Number(this.earlierRevision) > Number(this.laterRevision)) {
+            this.error = (
+                '"Earlier revision" should be less than "later revision".');
+          }
+        },
+
+        open() {
+          this.$.container.open();
+        },
+
+        close() {
+          this.$.container.close();
+        }
+      });
+    })();
+  </script>
+</dom-module>
diff --git a/third_party/catapult/dashboard/dashboard/elements/triage-dialog.html b/third_party/catapult/dashboard/dashboard/elements/triage-dialog.html
