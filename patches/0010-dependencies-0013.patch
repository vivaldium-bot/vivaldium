+
+    self.assertEquals(0, len(results.failures))
+    v_foo = results.FindAllPageSpecificValuesNamed('foo')
+    v_bar = results.FindAllPageSpecificValuesNamed('bar')
+    v_baz_avg = results.FindAllPageSpecificValuesNamed('baz_avg')
