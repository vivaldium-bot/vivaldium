+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link rel="import" href="/dashboard/elements/benchmark-health-report-page.html">
+<link rel="import" href="/dashboard/static/testing_common.html">
+
+<link rel="import" href="/tracing/core/test_utils.html">
+
+<script>
+'use strict';
+
+
+tr.b.unittest.testSuite(function() {
+  var originalGetParameter;
+
+  var testOptions = {
+    setUp: function() {
+      originalGetParameter = uri.getParameter;
+      d.BugDetails.reset();
+      var obj = {};
+      obj[12345] = Promise.resolve(mockBugResponse0);
+      obj[687592] = Promise.resolve(mockBugResponse1);
