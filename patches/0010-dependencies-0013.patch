+
+  Returns:
+    A string to use as a layered_cache key, or None if we don't want
+    to merge any bugs based on this bisect result.
+  """
+  if results_data.get('culprit_data'):
+    return _COMMIT_HASH_CACHE_KEY % results_data['culprit_data']['cl']
