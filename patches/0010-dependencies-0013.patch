+  @mock.patch.object(bench_find_anomalies, '_AddReportToLog')
+  def testBenchFindChangePoints_Basic(self, add_report_to_log_mock):
+    test = self._AddTestData('test', _SAMPLE_SERIES, anomaly.DOWN)
