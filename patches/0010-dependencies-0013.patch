+<dom-module id="benchmark-health-report-page">
+  <template>
+    <template is="dom-if" if="{{computeShowList(pageType)}}">
+      <benchmark-health-report-list
+          master="{{master}}"
+          num-days="{{numDays}}"></benchmark-health-report-list>
