+
+<dom-module id="jobs-page">
+  <template>
+    <style>
+    .error {
+      color: #dd4b39;
+      font-weight: bold;
+    }
+
+    .center {
+      margin: auto;
+      padding: 10px;
+    }
+
+    /* The content container contains everything below the sheriff select menu.
+     */
+    #content {
+      display: inline-flex;
+      display: -webkit-inline-flex;
+      flex-direction: column;
+      -webkit-flex-direction: column;
+      align-items: flex-start;
+      -webkit-align-items: flex-start;
+    }
+
+    #loading-spinner {
+      width: 100%;
+      display: flex;
+      justify-content: center;
+    }
+    </style>
+
+    <app-route route="{{route}}" pattern="/:sortBy:sortDescending" query-params="{{queryParams}}"></app-route>
+
+    <template is="dom-if" if="{{loading}}">
+      <div id="loading-spinner"><img src="//www.google.com/images/loading.gif"></div>
+    </template>
+    <template is="dom-if" if="{{!loading}}">
+      <template is="dom-if" if="{{error}}">
+        <div class="error">{{error}}</div>
+      </template>
+      <template is="dom-if" if="{{!error}}">
+        <div id="content">
+          <h1>Pinpoint Jobs</h1>
+          <div id="action-bar">
+          </div>
+          <h2>Running Jobs</h2>
+          <p id='num-alerts'>
+            {{computeJobCountString(totalJobsCount, totalJobsCountMax)}}
+          </p>
+          <jobs-table id="jobs-table"
+              xsrf-token="{{xsrfToken}}"
+              jobs-list="{{jobs}}"
+              sort-by="{{queryParams.sortBy}}"
+              sort-descending="{{queryParams.sortDescending}}">
+          </jobs-table>
+        </div>
+      </template>
+    </template>
+  </template>
+  <script>
+    'use strict';
+    Polymer({
+
+      is: 'jobs-page',
+      properties: {
+        totalJobsCount: {
+          type: Number,
+          value: 0
+        },
+        totalJobsCountMax: {
+          type: Number
+        },
+        jobs: {
+          type: Array,
+          value: () => []
+        },
+        loading: {
+          type: Boolean,
+          value: true,
+          notify: true
+        },
+        error: {
+          type: String,
+          value: '',
+          notify: true
+        },
+        xsrfToken: {
+          type: String,
+          value: ''
+        }
+      },
+
+      computeIsSingular: count => count === 1,
+
+      computeJobCountString() {
+        if (this.totalJobsCount === 1) {
+          return '1 job';
+        }
+        if (this.totalJobsCount < this.totalJobsCountMax) {
+          return String(this.totalJobsCount) + ' jobs.';
+        }
+        return String(this.totalJobsCountMax) + ' or more jobs.';
+      },
+
+      getJobCount() {
+        return this.jobs.length;
+      },
+
+      deselected() {
+        this.jobs = [];
+      },
+
+      selected() {
+        this.loading = true;
+        const params = {};
+        simple_xhr.send('/api/jobs', params,
+            function(response) {
+              this.jobs = response.jobs_list;
+              this.totalJobsCount = response.jobs_count;
+              this.totalJobsCountMax = response.jobs_count_max;
+              this.xsrfToken = response.xsrf_token;
+              this.loading = false;
+            }.bind(this),
+            function(msg) {
+              this.error = msg;
+              this.loading = false;
+            }.bind(this));
+      }
+    });
+  </script>
+</dom-module>
