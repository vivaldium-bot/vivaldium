+Heatmap = function(canvas, resolutionSlider, data) {
+  this.canvas = canvas.get(0);
+  this.context = this.canvas.getContext('2d');
+  this.scaleCanvas();
+
+  this.calculate(data);
+  this.installInputHandlers(canvas, resolutionSlider);
+
+  this.draw();
+};
diff --git a/third_party/catapult/experimental/heatmap/input.js b/third_party/catapult/experimental/heatmap/input.js
new file mode 100644
index 0000000000000000000000000000000000000000..7a6cf539df600fbdeb7220950a160729c8ba6575
--- /dev/null
+++ b/third_party/catapult/experimental/heatmap/input.js
@@ -0,0 +1,69 @@
+var DEFAULT_RESOLUTION = 5;
+
