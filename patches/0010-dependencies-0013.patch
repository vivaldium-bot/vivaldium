+const struct ssl_cipher_preference_list_st *ssl_get_cipher_preferences(
+    const SSL *ssl) {
+  if (ssl->cipher_list != NULL) {
+    return ssl->cipher_list;
+  }
+
+  return ssl->ctx->cipher_list;
+}
