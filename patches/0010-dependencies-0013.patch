+          timestamp=deprecated_time).put()
+      graph_data.Row(
+          id=i, value=i * 100, parent=trace_b_test_container_key,
+          timestamp=(now if i == 4 else deprecated_time)).put()
+      graph_data.Row(
+          id=i, value=(i * 100), parent=trace_a_ref_test_container_key,
+          timestamp=deprecated_time).put()
