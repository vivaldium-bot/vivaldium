+class AdbCompatibilityTest(device_test_case.DeviceTestCase):
+
+  @classmethod
+  def setUpClass(cls):
+    custom_adb_path = os.environ.get('ADB_PATH')
+    custom_deps = {
+      'config_type': 'BaseConfig',
