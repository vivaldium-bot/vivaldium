+                "value_store is not an instance of the Value class")
+        self._value_store = value_store
+
+    def equals(self, rhs):
+        self._value_store.store_value(rhs)
+        return True
+
+    def __repr__(self):
+        return "<Remember %d>" % id(self._value_store)
