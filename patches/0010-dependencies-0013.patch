+      is: 'login-warning',
+      properties: {
+        loginLink: { notify: true },
+        missing: {
+          value: null,
+          notify: true
+        }
+      },
+      get messageElement() {
+        return this.$.message;
+      }
+    });
+  </script>
+</dom-module>
