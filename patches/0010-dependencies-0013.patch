+
+        n = self.mf.findNode('pkg.mod1')
+        self.assertIsInstance(n, modulegraph.SourceModule)
+
+        n = self.mf.findNode('pkg.mod3')
+        self.assertIsInstance(n, modulegraph.SourceModule)
+
+if __name__ == "__main__":
