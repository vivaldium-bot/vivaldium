+            var testPath = testPathAndSelected[i][0];
+            var selectedTraces = testPathAndSelected[i][1];
+            selectedTraces = arrayUnique(selectedTraces);
+            var seriesGroup = {
+              path: testPath,
+              tests: [],
+              collapse: collapse,
+              numPendingRequests: 0
