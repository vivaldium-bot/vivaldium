+
+  def testGetAbsFilenameForHref(self):
+    app = dev_server.DevServerApp(self.pds, self.args)
+
+    cfg = tracing_dev_server_config.TracingDevServerConfig()
+    base_html_filename = os.path.join(cfg.project.tracing_src_path,
