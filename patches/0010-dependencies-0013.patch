+    h = histograms[0]
+    self.assertEqual(TEST_HISTOGRAM, h.data)
+    self.assertEqual(test_key, h.test)
+    self.assertEqual(123, h.revision)
+    self.assertFalse(h.internal_only)
+
+  def testPostHistogram_Internal(self):
+    stored_object.Set(
