+
+  def testDep(self):
+    dep = change.Dep('src', 'aaa7336')
+
+    self.assertEqual(dep, change.Dep('src', 'aaa7336'))
+    self.assertEqual(str(dep), 'src@aaa7336')
+    self.assertEqual(dep.repository, 'src')
+    self.assertEqual(dep.git_hash, 'aaa7336')
