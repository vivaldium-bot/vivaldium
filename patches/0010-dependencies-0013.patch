diff --git a/third_party/catapult/dashboard/dashboard/elements/bad-bisect-page.html b/third_party/catapult/dashboard/dashboard/elements/bad-bisect-page.html
new file mode 100644
index 0000000000000000000000000000000000000000..4a8edf8db872dd8bcf7074adbebebe17390e40cc
--- /dev/null
+++ b/third_party/catapult/dashboard/dashboard/elements/bad-bisect-page.html
@@ -0,0 +1,132 @@
+<!DOCTYPE html>
+<!--
+Copyright 2017 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<link type="text/css" rel="stylesheet" href="/dashboard/static/base.css">
+<link rel="import" href="/components/paper-button/paper-button.html">
+<link rel="import" href="/components/paper-item/paper-item.html">
+<link rel="import" href="/components/polymer/polymer.html">
+<link rel="import" href="/dashboard/static/simple_xhr.html">
+<link rel="import" href="/dashboard/static/uri.html">
+
+<link rel="import" href="/tracing/base/unit.html">
+
+<dom-module id="bad-bisect-page">
+  <template>
+    <style>
+      a {
+        text-decoration: none;
+      }
+      #confirm {
+        background: #4285f4;
+        color: #fff;
+      }
+    </style>
+
+    <template is="dom-if" if="{{loading}}">
+      <div id="loading-spinner"><img src="//www.google.com/images/loading.gif"></div>
+    </template>
+    <template is="dom-if" if="{{!loading}}">
+      <template is="dom-if" if="{{error}}">
+        <div class="error">{{error}}</div>
+      </template>
+      <template is="dom-if" if="{{computeIsFormShowing(error, headline)}}">
+        <div id="content">
+        <form action="/bad_bisect" id="bisect_form" method="POST">
+          <input type="hidden" name="try_job_id" value="{{try_job_id}}">
+          <p>
+            <paper-button id="confirm" on-click="onConfirm">Confirm</paper-button>
+            that bisect job <a href="#">{{try_job_id}}</a> is incorrect.
+          </p>
+        </form>
+        </div>
+      </template>
+      <template is="dom-if" if="{{computeIsHeadlineShowing(error, headline)}}">
+        <div class="error">{{headline}}</div>
+      </template>
+    </template>
+  </template>
+  <script>
+    'use strict';
+    Polymer({
+
+      is: 'bad-bisect-page',
+      properties: {
+        loading: {
+          type: Boolean,
+          value: true,
+          notify: true
+        },
+        headline: {
+          type: String,
+          value: '',
+          notify: true
+        },
+        try_job_id: {
+          type: String,
+          value: '',
+        },
+        error: {
+          type: String,
+          value: '',
+          notify: true
+        },
+        xsrfToken: {
+          type: String,
+          value: ''
+        }
+      },
+
+      computeIsFormShowing(error, headline) {
+        return !error && !headline;
+      },
+
+      computeIsHeadlineShowing(error, headline) {
+        return !error && headline;
+      },
+
+      updateFromURIParameters() {
+        this.try_job_id = uri.getParameter('try_job_id', '');
+      },
+
+      onConfirm() {
+        const params = {
+          'try_job_id': this.try_job_id,
+          'xsrf_token': this.xsrfToken
+        };
+
+        this.loading = true;
+
+        simple_xhr.send('/bad_bisect', params,
+            function(response) {
+              this.headline = response.headline;
+              this.loading = false;
+            }.bind(this),
+            function(msg) {
+              this.error = msg;
+              this.loading = false;
+            }.bind(this));
+      },
+
+      ready() {
+        const params = {
+          try_job_id: uri.getParameter('try_job_id', '')
+        };
+
+        simple_xhr.send('/bad_bisect', params,
+            function(response) {
+              this.loading = false;
+              this.xsrfToken = response.xsrf_token;
+              this.updateFromURIParameters();
+            }.bind(this),
+            function(msg) {
+              this.error = msg;
+              this.loading = false;
+            }.bind(this));
+      }
+    });
+  </script>
+</dom-module>
diff --git a/third_party/catapult/dashboard/dashboard/elements/benchmark-health-report-details.html b/third_party/catapult/dashboard/dashboard/elements/benchmark-health-report-details.html
new file mode 100644
index 0000000000000000000000000000000000000000..45225c60f68c4c315acd958d2f275d7a185c4b22
--- /dev/null
+++ b/third_party/catapult/dashboard/dashboard/elements/benchmark-health-report-details.html
@@ -0,0 +1,181 @@
+<!DOCTYPE html>
+<!--
+Copyright 2017 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+<link rel="import" href="/components/polymer/polymer.html">
+
+<link rel="import" href="/dashboard/elements/alerts-table.html">
+<link rel="import" href="/dashboard/elements/bug-details.html">
+<link rel="import" href="/dashboard/static/simple_xhr.html">
+
+<dom-module id="benchmark-health-report-details">
+  <style>
+    .error {
+      color: #dd4b39;
+      font-weight: bold;
+    }
+
+    #loading-spinner {
+      width: 100%;
+      display: flex;
+      justify-content: center;
+    }
+  </style>
+  <template>
+    <template is="dom-if" if="{{loading}}">
+      <div id="loading-spinner"><img src="//www.google.com/images/loading.gif"></div>
+    </template>
+    <template is="dom-if" if="{{error}}">
+      <div class="error">{{error}}</div>
+    </template>
+    <template is="dom-if" if="{{computeSuccessfulLoad(loading, error)}}">
+      <h1>Report for {{benchmark}} on {{master}}</h1>
+      <h2>{{benchmark}} is on {{bots.length}} bots:</h2>
+      <ul>
+      <template is="dom-repeat" items="{{bots}}">
+        <li>{{item}}
+      </template>
+      </ul>
+
+      <template is="dom-if" if="{{!monitored}}">
+        <h2 class="error">{{benchmark}} is not monitored.</h2>
+      </template>
+      <template is="dom-if" if="{{monitored}}">
+        <h2>{{alerts.length}} alerts for {{benchmark}} in the last {{numDays}} days</h2>
+        <h3>{{computeNumValid(alerts)}} valid and {{computeNumInvalid(alerts)}} invalid and {{computeNumUntriaged(alerts)}} untriaged</h3>
+        <alerts-table id="alerts-table"
+                      alert-list="{{alerts}}"
+                      extra-columns="{{extraColumns}}"></alerts-table>
+
+        <h2>{{bugIds.length}} bugs for {{benchmark}} in the last {{numDays}} days</h2>
+        <template is="dom-repeat" items="{{bugIds}}">
+          <bug-details bug-id="{{item}}"></bug-details>
+      </template>
+      </template>
+    </template>
+
+  </template>
+  <script>
+    'use strict';
+    Polymer({
+      is: 'benchmark-health-report-details',
+      properties: {
+        alerts: {
+          notify: true,
+          type: Array
+        },
+        benchmark: {
+          notify: true,
+          type: String
+        },
+        bots: {
+          notify: true,
+          type: Array
+        },
+        bugIds: {
+          notify: true,
+          type: Array
+        },
+        extraColumns: {
+          type: Array,
+          notify: true,
+          value: () => ([
+            {
+              'key': 'percent_changed',
+              'label': 'Delta %'
+            },
+            {
+              'key': 'absolute_delta',
+              'label': 'Abs Delta'
+            },
+            {
+              'key': 'units',
+              'label': 'Units'
+            }
+          ])
+        },
+        error: {
+          notify: true,
+          type: Boolean,
+          value: false
+        },
+        loading: {
+          notify: true,
+          type: Boolean,
+          value: true
+        },
+        master: {
+          notify: true,
+          type: String
+        },
+        monitored: {
+          notify: true,
+          type: Boolean
+        },
+        numDays: {
+          notify: true,
+          type: Number
+        }
+      },
+
+      countAlerts(bugCheck, alerts) {
+        let count = 0;
+        for (const alert of alerts) {
+          if (bugCheck(alert.bug_id)) {
+            count++;
+          }
+        }
+        return count;
+      },
+
+      computeSuccessfulLoad: (loading, error) => !(loading || error),
+
+      computeNumInvalid(alerts) {
+        return this.countAlerts(this.isInvalidAlert, alerts);
+      },
+
+      computeNumValid(alerts) {
+        return this.countAlerts(this.isValidAlert, alerts);
+      },
+
+      computeNumUntriaged(alerts) {
+        return this.countAlerts(this.isUntriagedAlert, alerts);
+      },
+
+      // Using != and == here and below since bugId could be null or undefined
+      isValidAlert: bugId => (bugId != null && bugId >= 0),
+
+      isInvalidAlert: bugId => (bugId != null && bugId < 0),
+
+      isUntriagedAlert: bugId => (bugId == null),
+
+      ready() {
+        const params = {
+          'master': this.master,
+          'benchmark': this.benchmark,
+          'num_days': this.numDays
+        };
+        simple_xhr.send('/benchmark_health_report', params,
+            response => {
+              this.alerts = response.alerts;
+              this.bots = response.bots;
+              this.monitored = response.monitored;
+              this.loading = false;
+              const bugIds = new Set();
+              for (const alert of this.alerts) {
+                if (alert.bug_id && alert.bug_id > 0) {
+                  bugIds.add(alert.bug_id);
+                }
+              }
+              this.set('bugIds', Array.from(bugIds));
+            },
+            errorMsg => {
+              this.error = errorMsg;
+              this.loading = false;
+            });
+      }
+    });
+  </script>
+</dom-module>
