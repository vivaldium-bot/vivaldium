+  def testRunChecksShowsErrorForOutOfOrderImports(self):
+    f = MockAffectedFile('foo/x.html', [
+        '<!DOCTYPE html>',
+        '<link rel="import" href="b.html">',
+        '<link rel="import" href="a.html">',
+    ])
+    errors = html_checks.RunChecks(MockInputApi([f]), MockOutputApi())
