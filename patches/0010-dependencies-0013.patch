+      return
+    ui.EnableTestMode()
+    categories = 'cycles'
+    agent = perf_tracing_agent.PerfProfilerAgent(self.device)
+
+    try:
+      agent.StartAgentTracing(perf_tracing_agent.PerfConfig(categories,
