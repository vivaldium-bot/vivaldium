+  def testGetNewTestPath_WithAsterisks(self):
+    self.assertEqual(
+        'A/b/c/X',
+        migrate_test_names._ValidateAndGetNewTestPath('A/b/c/d', '*/*/*/X'))
+    self.assertEqual(
+        'A/b/c/d',
+        migrate_test_names._ValidateAndGetNewTestPath('A/b/c/d', '*/*/*/*'))
