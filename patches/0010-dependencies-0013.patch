+
+class CallableClass(object):
+
+    def __init__(self, one, two, nine=None):
+        pass
+
+    def __call__(self, one):
+        return 'Not mock'
+
+    def Value(self):
+        return 'Not mock'
+
+
+def MyTestFunction(one, two, nine=None):
