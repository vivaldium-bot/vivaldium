+{
+    "extends": "google",
+    "parserOptions": {
+      "ecmaVersion": 2017,
+    },
+    "plugins": ["html"],
+    "rules": {
+      "accessor-pairs": "off",
+      "array-bracket-spacing": ["error", "never"],
+      "array-callback-return": "off",
+      "arrow-body-style": ["error", "as-needed", {
+        "requireReturnForObjectLiteral": true
+      }],
+      "arrow-parens": "off",
