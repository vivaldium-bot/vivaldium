+        """Check to see if RHS is almost equal to float_value
+
+        Args:
+            rhs: the value to compare to float_value
+
+        Returns:
+            bool
+        """
+
+        try:
+            return round(rhs - self._float_value, self._places) == 0
+        except Exception:
+            # Probably because either float_value or rhs is not a number.
+            return False
