+        '/benchmark_health_report',
+        {'benchmark': 'page_cycler', 'num_days': '5', 'master': 'ChromiumPerf'})
+    bots = self.GetJsonValue(response, 'bots')
+    self.assertItemsEqual(bots, ['linux'])
+    self.assertTrue(self.GetJsonValue(response, 'monitored'))
