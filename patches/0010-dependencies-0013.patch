+    v = value.Value.FromDict(d, {})
+    self.assertEquals(v.grouping_keys, {})
+
+  def testListOfValuesFromListOfDicts(self):
+    d0 = {
+          'type': 'value_for_from_dict_test',
+          'name': 'x',
+          'units': 'unit'
+        }
+    d1 = {
+          'type': 'value_for_from_dict_test',
