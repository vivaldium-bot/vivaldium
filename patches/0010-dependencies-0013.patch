+'use strict';
+
+// Anonymous namespace
+(function() {
+
+// @return {Array<object>} List of events for an abbreviated URL request.
+function urlRequestEvents(id) {
+  return [
+    {
+      'phase': EventPhase.PHASE_BEGIN,
+      'source': {
+        'id': id,
+        'type': EventSourceType.URL_REQUEST
+      },
+      'time': '953534778',
+      'type': EventType.REQUEST_ALIVE
+    },
