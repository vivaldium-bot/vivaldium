+<strong>SNOWLEOPARD</strong> = 'snowleopard'<br>
+<strong>VISTA</strong> = 'vista'<br>
+<strong>WIN7</strong> = 'win7'<br>
+<strong>WIN8</strong> = 'win8'<br>
