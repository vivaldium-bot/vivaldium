+def _hostAdbPids():
+  ps_status, ps_output = cmd_helper.GetCmdStatusAndOutput(
+      ['pgrep', '-l', 'adb'])
+  if ps_status != 0:
+    return []
+
+  pids_and_names = (line.split() for line in ps_output.splitlines())
+  return [int(pid) for pid, name in pids_and_names
+          if name == 'adb']
