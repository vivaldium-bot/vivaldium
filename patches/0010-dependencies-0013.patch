+SYSTRACE_HOST_CMD_DEFAULT = ['./systrace.py', '--target=linux']
+FT_DIR = "/sys/kernel/debug/tracing/"
+FT_EVENT_DIR = FT_DIR + "events/"
+FT_TRACE_ON = FT_DIR + "tracing_on"
+FT_TRACE = FT_DIR + "trace"
