+
+  def testGetMemoryUsageWithAllocators(self):
+    process_dump1 = TestProcessDumpEvent(
+        mmaps={'/dev/ashmem/other-ashmem': {'pss': 5}},
+        allocators={'v8': {'size': 10, 'allocated_objects_size' : 5}})
