+  'annotations': {
+    '0': {
+      '0': {
+        'a_trace_rerun_options': null,
+        'error': 0,
+        'r_webkit_rev': '202058',
+        'a_stdio_uri': '[Buildbot stdio](//dromaeo/stdio)',
+        'r_commit_pos': '348164',
+        'timestamp': (new Date).getTime(),
+        'r_chromium': '0c554b0e1233639e7428facc13ff674741368fb2'
+      }
+    },
+    'series': {
+      '0': {
+        'name': 'Total',
+        'description': null,
+        'better': 'Higher',
+        'units': 'runs/s',
+        'path': 'Chromium/win/sunspider/Total'
+      }
