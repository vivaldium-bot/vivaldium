+]
+
+_TESTS_WITH_ROWS = [
+    'ChromiumPerf/mac/SunSpider/Total/t',
+    'ChromiumPerf/mac/SunSpider/3d-cube',
+    'ChromiumPerf/mac/moz',
+    'ChromiumPerf/win7/SunSpider/Total/t',
+    'ChromiumPerf/win7/SunSpider/3d-cube',
