+
+typedef bool (*tool_func_t)(const std::vector<std::string> &args);
+
+struct Tool {
+  const char *name;
+  tool_func_t func;
+};
+
+static const Tool kTools[] = {
+  { "ciphers", Ciphers },
+  { "client", Client },
+  { "isfips", IsFIPS },
+  { "generate-ed25519", GenerateEd25519Key },
+  { "genrsa", GenerateRSAKey },
