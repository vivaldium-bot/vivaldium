-function removeNextKeyHilight() {
-    var curr = document.getElementById(_keyTable[_currKey][KEYINFO_CODE]);
-    if (curr) {
-        removeClass(curr, "nextKey")
-    }
-}
-
-function addNextKeyHilight() {
-    var curr = document.getElementById(_keyTable[_currKey][KEYINFO_CODE]);
