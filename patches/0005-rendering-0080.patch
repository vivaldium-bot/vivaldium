-    { currentTime:  2, phase: 'after'  } ]
-  .forEach(function(test) {
-    assert_phase_at_time(animation, test.phase, test.currentTime);
-  });
-}, 'Phase calculation for a simple animation effect with negative playback'
-   + ' rate');
-
-</script>
-</body>
