-<!DOCTYPE html>
-<meta charset=utf-8>
-<title>Tests for current time</title>
-<link rel="help" href="https://w3c.github.io/web-animations/#current-time">
-<script src="/resources/testharness.js"></script>
-<script src="/resources/testharnessreport.js"></script>
