+                                '\nConflict while rebasing this branch.\n'
+                                'Fix the conflict and run gclient again.\n'
+                                'See man git-rebase for details.\n'
+                                % (self.relpath, revision))
+
+    if verbose:
+      self.Print('Checked out revision %s' % self.revinfo(options, (), None),
+                 timestamp=False)
+
