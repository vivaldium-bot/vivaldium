+void PsCopyHeader(FILE* psfile) {
+  // Write all but the trailing NUL
+  fwrite(kDetailHead, 1, sizeof(kDetailHead) - 1, psfile);
+  if (FLAGS_trackme >= 0) {
+    fprintf(psfile, "/track-me %d def\n\n", FLAGS_trackme);
+  }
