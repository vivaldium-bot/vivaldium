+// Turn a pair of bytes into the subscript for UTF8UTF8 tables above
+int UTF88Sub(char s0, char s1) {
+  int sub = (s1 >> 4) & 0x03;
+  uint8 u0 = static_cast<uint8>(s0);
+  if (u0 == 0xc3) {
+    sub += 12;
+  } else if ((u0 & 0xf0) == 0xc0) {
+    if ((u0 == 0xc2) || (u0 == 0xc5) || (u0 == 0xc6) || (u0 == 0xcb)) {
+      sub += 8;
+    }
+  } else if (u0 == 0xe2) {
+    sub += 4;
+  }
+  return sub;
+}
