+def GetScmName(url):
+  if not url:
+    return None
+  url, _ = gclient_utils.SplitUrlRevision(url)
+  if url.endswith('.git'):
+    return 'git'
+  protocol = url.split('://')[0]
+  if protocol in (
+      'file', 'git', 'git+http', 'git+https', 'http', 'https', 'ssh', 'sso'):
+    return 'git'
+  return None
+
