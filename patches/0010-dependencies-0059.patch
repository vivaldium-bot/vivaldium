+  if always:
+    stdout.write(header)
+  else:
+    filter_fn = kwargs.get('filter_fn')
+    def filter_msg(line):
+      if line is None:
+        stdout.write(header)
+      elif filter_fn:
+        filter_fn(line)
+    kwargs['filter_fn'] = filter_msg
+    kwargs['call_filter_on_first_line'] = True
