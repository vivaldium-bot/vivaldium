+string PsStr(const char* str) {
+  string res("");
+  for (size_t i = 0; i < strlen(str); ++i) {
+    char c = str[i];
+    if (c == '(') {res.append("\\(");}
+    else if (c == ')') {res.append("\\)");}
+    else if (c == '\\') {res.append("\\\\");}
+    else {res.append(1, c);}
+  }
+  return res;
+}
