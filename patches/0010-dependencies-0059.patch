+// Single character to represent (printable ASCII) gap between bigrams
+char DetailOffsetChar(int delta) {
+  if (delta == 0) {return ' ';}
+  if (delta <= 2) {return '=';}
+  if (delta <= 15) {return '_';}
+  if (delta <= 31) {return '+';}
+  {return ' ';}
+}
