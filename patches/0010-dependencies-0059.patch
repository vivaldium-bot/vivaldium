index 0000000000000000000000000000000000000000..ffbd716ecdc7ed0ddb126d3c1e24488ad648dba7
--- /dev/null
+++ b/third_party/ced/src/util/encodings/encodings.pb.h
@@ -0,0 +1,181 @@
