+]
+
+def GenerateFilename(group, count, index):
+  """Generate test filename."""
+  assert index >= 0 and index < count
+  filename = group
+  if count > 1:
+    index_str = str(index)
+    if index < 10:
+      index_str = "0" + index_str
+    filename += "_" + index_str
+  filename += ".html"
+  return filename
+
+def WriteTest(filename, start, end):
