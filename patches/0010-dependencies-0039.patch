+        model.samples.push(new Sample(undefined, thread, 'instructions_retired',
+                                      40, fAD, 10));
+
+        model.samples.push(new Sample(undefined, thread, 'page_fault',
+                                      25, fAB, 10));
+        model.samples.push(new Sample(undefined, thread, 'page_fault',
