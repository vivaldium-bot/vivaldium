+_QUERIES = {
+    # CLs that are open and not vetoed.
+    'open': 'status:open AND -label:CodeReview=-2 AND -label:Verified=-1',
+
+    # CLs that are approved and verified.
+    'approved': 'label:Code-Review=+2 AND label:Verified=+1',
