diff --git a/third_party/catapult/tracing/tracing/base/color_test.html b/third_party/catapult/tracing/tracing/base/color_test.html
new file mode 100644
index 0000000000000000000000000000000000000000..208ab9939c678d8e7efaf81c313bce7d69d782b7
--- /dev/null
