+<script>
+'use strict';
+
+tr.exportTo('tr.e.chrome', function() {
+  var SAME_AS_PARENT = 'same-as-parent';
+
+  var TITLES_FOR_USER_FRIENDLY_CATEGORY = {
+    composite: [
+      'CompositingInputsUpdater::update',
