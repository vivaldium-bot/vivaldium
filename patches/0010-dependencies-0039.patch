+    changes = [self.kernel_patch, self.power_manager_patch] + suspects
+    self._AssertSuspects(changes, suspects, lab_fail=False, infra_fail=True)
+    self._AssertSuspects(changes, suspects, lab_fail=False, infra_fail=True,
+                         sanity=False)
