+    // Mutate x.
+    vec2.set(x, 11, 11);
+
+    // Bbox shouldn't have changed.
+    assert.equal(bbox.minVec2[0], 10);
+    assert.equal(bbox.minVec2[1], 10);
+    assert.equal(bbox.maxVec2[0], 10);
+    assert.equal(bbox.maxVec2[1], 10);
+  });
+});
+</script>
diff --git a/third_party/catapult/tracing/tracing/base/category_util.html b/third_party/catapult/tracing/tracing/base/category_util.html
new file mode 100644
