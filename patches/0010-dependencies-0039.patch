++                     GoogleSqlDriver.NAME, options.user, options.password)
+   sql_cmd = GoogleSqlCmd(sql_cmd_config)
+   sql_cmd.set_output_encoding(options.output_encoding)
+   sql_cmd.set_database(instance_alias)
