+    arg_parser.assert_called_with(caching=True, default_log_level='notice')
diff --git a/third_party/chromite/scripts/cros_workon.py b/third_party/chromite/scripts/cros_workon.py
new file mode 100644
index 0000000000000000000000000000000000000000..087c0a8286c3a05fc869df94b6a24a9cbc86a34b
