+    'Char',
+    'ContextMenu',
+    'GestureClick',
+    'GestureFlingCancel',
+    'GestureFlingStart',
+    'GestureScrollBegin',
+    'GestureScrollEnd',
+    'GestureScrollUpdate',
+    'GestureShowPress',
+    'GestureTap',
+    'GestureTapCancel',
+    'GestureTapDown',
+    'GesturePinchBegin',
+    'GesturePinchEnd',
+    'GesturePinchUpdate',
+    'KeyDown',
+    'KeyUp',
+    'MouseDown',
+    'MouseEnter',
+    'MouseLeave',
+    'MouseMove',
+    'MouseUp',
+    'MouseWheel',
+    'RawKeyDown',
+    'ScrollUpdate',
+    'TouchCancel',
+    'TouchEnd',
+    'TouchMove',
+    'TouchStart'
+  ];
