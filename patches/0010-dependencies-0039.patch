+  def _CreateVersionFile(self, version=None):
+    if version is None:
+      version = self.DEFAULT_VERSION
+    version_file = os.path.join(self.build_root, constants.VERSION_FILE)
+    manifest_version_unittest.VersionInfoTest.WriteFakeVersionFile(
