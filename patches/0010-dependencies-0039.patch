index 0000000000000000000000000000000000000000..5aba2cf644cfcf8c9635eec287e1fb25f3c5ffca
--- /dev/null
+++ b/third_party/catapult/tracing/tracing/base/running_statistics_test.html
@@ -0,0 +1,155 @@
+<!DOCTYPE html>
+<!--
+Copyright (c) 2016 The Chromium Authors. All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+<link rel="import" href="/tracing/base/running_statistics.html">
+<link rel="import" href="/tracing/base/statistics.html">
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  var RunningStatistics = tr.b.RunningStatistics;
+  var Statistics = tr.b.Statistics;
+
+  function run(data) {
+    var running = new RunningStatistics();
+    data.forEach(x => running.add(x));
+    return running;
+  }
+
+  test('sum', function() {
+    var data;
+    data = [];
+    assert.closeTo(Statistics.sum(data), run(data).sum, 1e-6);
+    data = [1];
+    assert.closeTo(Statistics.sum(data), run(data).sum, 1e-6);
+    data = [1, 2, 3];
+    assert.closeTo(Statistics.sum(data), run(data).sum, 1e-6);
+    data = [2, 4, 4, 2];
+    assert.closeTo(Statistics.sum(data), run(data).sum, 1e-6);
