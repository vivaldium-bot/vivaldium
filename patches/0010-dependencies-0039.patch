+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  test('addVec2', function() {
+    var bbox = new tr.b.BBox2();
+    var x = vec2.create();
+    vec2.set(x, 10, 10);
+    bbox.addVec2(x);
+    assert.equal(bbox.minVec2[0], 10);
