+        if (a.start !== b.start)
+          return a.start - b.start;
+        return a.guid - b.guid;
+      });
+    },
+
+    // Find rasterization slices that have the source_prepare_tiles_id
+    // same as the prepare_tiles_id of TileManager::PrepareTiles
