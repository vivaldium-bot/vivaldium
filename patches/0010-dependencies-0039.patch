+
+      # Check archive.download_url.
+      expected = '%s%s/%s/%s' % (
+          cbuildbot_run.archive_lib.gs.PRIVATE_BASE_HTTPS_DOWNLOAD_URL,
+          DEFAULT_ARCHIVE_GS_PATH, DEFAULT_BOT_NAME, DEFAULT_VERSION)
+      self.assertEqual(expected, archive.download_url)
