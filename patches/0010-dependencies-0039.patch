+    checkZFunction('AAABAAB', [0, 2, 1, 0, 2, 1, 0]);
+
+    // Complex patterns.
+    checkZFunction([7, 9, 7, 9, 7, 9, 7, 9], [0, 0, 6, 0, 4, 0, 2, 0]);
+    checkZFunction('CCGTCCCGTACC', [0, 1, 0, 0, 2, 4, 1, 0, 0, 0, 2, 1]);
