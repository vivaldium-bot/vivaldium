+  SIGNER_RESULT = """
+    { "status": { "status": "passed" }, "board": "link",
+    "keyset": "link-mp-v4", "type": "recovery", "channel": "stable" }
+    """
+
+  INSNS_URLS_PER_CHANNEL = {
+      'chan1': ['chan1_uri1', 'chan1_uri2'],
+      'chan2': ['chan2_uri1'],
+  }
+
+  def setUp(self):
+    self._Prepare()
+
+  def ConstructStage(self):
