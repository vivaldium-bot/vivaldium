+    expectedResults = [
+        ('Pass', results_lib.Results.SUCCESS),
+        ('Pass2', results_lib.Results.SUCCESS),
+        ('Fail', FailStage.FAIL_EXCEPTION),
+    ]
+    self._verifyRunResults(expectedResults)
