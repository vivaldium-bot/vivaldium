+     *   [['Loop::Run()', 'Execute()', 'FunctionBig']]:       self=99000
+     *   [['Loop::Run()', 'Execute()', 'FunctionSmall1']]:    self=1
+     *   [['Loop::Run()', 'Execute()', 'FunctionSmall2']]:    self=1
