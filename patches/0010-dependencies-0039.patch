+    metadata = metadata_lib.CBuildbotMetadata(multiprocess_manager=m)
+
+    metadata.UpdateKeyDictWithDict('my_dict', expected_dict)
+
+    self.assertEqual(expected_dict, metadata.GetDict()['my_dict'])
