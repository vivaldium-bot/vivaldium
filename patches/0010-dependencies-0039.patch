+    stage.Run()
+    calls = [mock.call(mock.ANY, mock.ANY, 'metadata.json', False,
+                       update_list=True, acl=mock.ANY)]
+    self.assertEquals(calls, commands.UploadArchivedFile.call_args_list)
+
+  def testCommitQueueResults(self):
