+if(PNACL_BROWSER_TRANSLATOR)
+  add_definitions(
+  -DALLOW_DUMP=0
+  -DALLOW_LLVM_CL=0
+  -DALLOW_LLVM_IR=0
+  -DALLOW_LLVM_IR_AS_INPUT=0
+  -DALLOW_TIMERS=0
+  -DALLOW_MINIMAL_BUILD=1
+  -DALLOW_WASM=0
+  -DPNACL_BROWSER_TRANSLATOR=1
