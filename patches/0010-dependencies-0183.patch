+NACKStringBuilder::NACKStringBuilder()
+    : stream_(""), count_(0), prevNack_(0), consecutive_(false) {}
+
+NACKStringBuilder::~NACKStringBuilder() {}
+
+void NACKStringBuilder::PushNACK(uint16_t nack) {
+  if (count_ == 0) {
+    stream_ << nack;
+  } else if (nack == prevNack_ + 1) {
+    consecutive_ = true;
+  } else {
+    if (consecutive_) {
+      stream_ << "-" << prevNack_;
+      consecutive_ = false;
+    }
+    stream_ << "," << nack;
+  }
+  count_++;
+  prevNack_ = nack;
+}
+
+std::string NACKStringBuilder::GetResult() {
+  if (consecutive_) {
+    stream_ << "-" << prevNack_;
+    consecutive_ = false;
+  }
+  return stream_.str();
+}
