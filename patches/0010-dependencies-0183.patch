+  void initParserThread() {
+    ThreadContext *Tls = new ThreadContext();
+    auto Timers = getTimers();
+    Timers->initInto(Tls->Timers);
+    AllThreadContexts.push_back(Tls);
+    ICE_TLS_SET_FIELD(TLS, Tls);
