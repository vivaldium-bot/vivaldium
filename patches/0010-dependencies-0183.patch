+    Target->_ret(RetAddr, RetValue);
+  }
+  auto *T6 = Target->makeReg(IceType_i32, RegMIPS32::Reg_T6);
+  Target->Context.insert<InstFakeDef>(T6);
+  createAutoBundle();
+  Target->_and(RetAddr, RetAddr, T6);
+  Target->_ret(RetAddr, RetValue);
