+// TEQ $0, $0 - Trap if equal
+static constexpr uint8_t TrapBytesRaw[] = {0x00, 0x00, 0x00, 0x34};
+
+const auto TrapBytes =
+    llvm::ArrayRef<uint8_t>(TrapBytesRaw, llvm::array_lengthof(TrapBytesRaw));
+
