+///
+/// \file
+/// \brief Declares the interface for translation from PNaCl bitcode files to
+/// ICE to machine code.
+///
+//===----------------------------------------------------------------------===//
+
+#ifndef SUBZERO_SRC_PNACLTRANSLATOR_H
+#define SUBZERO_SRC_PNACLTRANSLATOR_H
+
+#include "IceTranslator.h"
+
+#include <string>
+
+namespace llvm {
+class MemoryBuffer;
+class MemoryObject;
+} // end of namespace llvm
