+}
+; COMMON-LABEL: cond_br_sle
+; MIPS32: slt
+; MIPS32: bnez {{.*}} .Lcond_br_sle$branch2
+; MIPS32-NEXT: .Lcond_br_sle$branch1
+; MIPS32-OM1: slt
