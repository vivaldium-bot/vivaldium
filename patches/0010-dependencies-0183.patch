+; MIPS32OM1: li {{.*}},123
+; MIPS32OM1: slt {{.*}},{{.*}},{{.*}}
+; MIPS32OM1: xori {{.*}},{{.*}},{{.*}}
+; MIPS32OM1: beqz
+; MIPS32OM1: nop
+; MIPS32OM1: b
