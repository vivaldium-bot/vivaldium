+void AssemblerMIPS32::xor_(const Operand *OpRd, const Operand *OpRs,
+                           const Operand *OpRt) {
+  static constexpr IValueT Opcode = 0x00000026;
+  emitRdRsRt(Opcode, OpRd, OpRs, OpRt, "xor");
+}
