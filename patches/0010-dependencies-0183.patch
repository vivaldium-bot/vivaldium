+; MIPS32: 	lw	s8,{{.*}}(sp)
+; MIPS32: 	addiu	sp,sp,{{.*}}
+
+; Test that a sequence with greater than stack alignment and dynamic size
+; get folded and referenced correctly;
+
+define internal void @fused_large_align_with_dynamic(i32 %arg) {
+entry:
+  %a1 = alloca i8, i32 8, align 32
