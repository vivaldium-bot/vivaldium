+
+; CHECK:       Initial CFG
+; CHECK:     entry:
+; CHECK-NEXT:  %iv = load i16, i16* %addr_arg, align 1
+; CHECK-NEXT:  ret void
+}
+
+; MIPS32-LABEL: load_i16
