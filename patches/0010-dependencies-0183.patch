diff --git a/third_party/webgl/src/conformance-suites/1.0.0/conformance/more/functions/uniformMatrixBadArgs.html b/third_party/webgl/src/conformance-suites/1.0.0/conformance/more/functions/uniformMatrixBadArgs.html
