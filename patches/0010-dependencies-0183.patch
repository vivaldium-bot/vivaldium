+void Assembler::Bind(Label* label) {
+  const ARMVersion version = TargetCPUFeatures::arm_version();
+  if ((version == ARMv5TE) || (version == ARMv6)) {
+    BindARMv6(label);
+  } else {
+    ASSERT(version == ARMv7);
+    BindARMv7(label);
+  }
+}
