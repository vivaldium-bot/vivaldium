+void AssemblerMIPS32::emitTextInst(const std::string &Text, SizeT InstSize) {
+  AssemblerFixup *F = createTextFixup(Text, InstSize);
+  emitFixup(F);
+  for (SizeT I = 0; I < InstSize; ++I) {
+    AssemblerBuffer::EnsureCapacity ensured(&Buffer);
+    Buffer.emit<char>(0);
+  }
+}
