+  if (Ty == IceType_i16)
+    emitOperandSizeOverride();
+  emitRexRB(Ty, src, dst);
+  if (isByteSizedType(Ty)) {
+    emitUint8(0x88);
+  } else {
+    emitUint8(0x89);
+  }
+  emitRegisterOperand(gprEncoding(src), gprEncoding(dst));
+}
