+void TargetX8664::_push_reg(Variable *Reg) {
+  Variable *rbp =
+      getPhysicalRegister(Traits::RegisterSet::Reg_rbp, Traits::WordType);
+  if (Reg != rbp || !NeedSandboxing) {
+    _push(Reg);
+  } else {
+    _push_rbp();
+  }
+}
