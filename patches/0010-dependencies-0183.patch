+                              const size_t channels,
+                              const uint32_t rate) override {
+    if (payloadType == 96) {
+      EXPECT_EQ(test_rate, rate) <<
+          "The rate should be 64K for this payloadType";
+    }
+    return 0;
+  }
+};
