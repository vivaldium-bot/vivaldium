+template <typename TraitsType>
+bool InstImpl<TraitsType>::InstX86Br::repointEdges(CfgNode *OldNode,
+                                                   CfgNode *NewNode) {
+  bool Found = false;
+  if (TargetFalse == OldNode) {
+    TargetFalse = NewNode;
+    Found = true;
+  }
+  if (TargetTrue == OldNode) {
+    TargetTrue = NewNode;
+    Found = true;
+  }
+  return Found;
+}
