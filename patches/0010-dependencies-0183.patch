+        // cos_c is always bound in the range [-1.0, 1.0)
+        cos_c += pow(abs(c), exp)*(sum/fact_odd);
+
+        sign = -sign;
+    }
+
+    gl_FragColor = vec4(0.5 * cos_c + 0.5, 1.0);
+}
