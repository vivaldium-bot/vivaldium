+; ARM32: tst r0, #1
+; ARM32: bne
+; ARM32: tst r1, #1
+; ARM32: beq
+; ARM32: tst r2, #1
+; ARM32: bne
+; ARM32: tst     r3, #1
+; ARM32: beq     [[TARGET:.*]]
+; ARM32: tst     r4, #1
+; ARM32: beq     [[TARGET]]
