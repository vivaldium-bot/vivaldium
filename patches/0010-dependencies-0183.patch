+namespace test {
+
+class StatsTest : public testing::Test {
+ protected:
+  StatsTest() {}
+
+  virtual ~StatsTest() {}
+
+  void SetUp() { stats_ = new Stats(); }
+
+  void TearDown() { delete stats_; }
+
+  Stats* stats_;
+};
