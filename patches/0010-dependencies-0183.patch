+}
+; CHECK-LABEL: test_returning32_arg5
+; CHECK-NEXT: mov eax,{{.*}} [esp+0x18]
+; CHECK-NEXT: ret
+; ARM32-LABEL: test_returning32_arg5
+; ARM32-NEXT: ldr r0, [sp, #4]
+; ARM32-NEXT: bx lr
+
