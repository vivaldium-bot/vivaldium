+    sh.destroy();
+    sh = new Filter(gl, 'vert-t', 'frag-t');
+    sh.apply();
+    time("textureDraw", function() {
+        for (var i=0; i<1000; i++)
+            gl.drawArrays(gl.TRIANGLES, 0, 6);
