+  EXPECT_EQ(1, stats.GetMax());
+
+  stats.Push(3);
+  EXPECT_EQ(1, stats.GetMin());
+  EXPECT_EQ(3, stats.GetMax());
+
+  stats.Push(-4);
+  EXPECT_EQ(-4, stats.GetMin());
+  EXPECT_EQ(3, stats.GetMax());
+}
