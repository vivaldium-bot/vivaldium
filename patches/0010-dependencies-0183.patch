+; CHECK:       Initial CFG
+; CHECK:     entry:
+; CHECK-NEXT:  %iv = load i32, i32* %addr_arg, align 1
+; CHECK-NEXT:  ret void
+}
+
+; MIPS32-LABEL: load_i32
+; MIPS32: lw {{.*}},0({{.*}})
+
+define internal void @load_i16(i32 %addr_arg) {
+entry:
+  %__1 = inttoptr i32 %addr_arg to i16*
