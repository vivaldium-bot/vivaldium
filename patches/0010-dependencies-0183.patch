+  // 111100100D10nnn0ddd00001N1M1mmm0 where Dddd=OpQd, Nnnn=OpQm, and Mmmm=OpQm.
+  constexpr const char *Vorrq = "vorrq";
+  constexpr IValueT VorrqOpcode = B21 | B8 | B4;
