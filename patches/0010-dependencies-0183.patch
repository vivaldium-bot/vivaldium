+
+Type getPointerType() { return TargetLowering::getPointerType(); }
+
+bool isVectorType(Type Ty) {
+  if (Ty < IceType_NUM)
+    return TypePropertiesTable[Ty].TypeIsVectorType;
+  llvm_unreachable("Invalid type for isVectorType()");
+  return false;
