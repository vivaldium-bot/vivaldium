+
+  void on_availability_changed(P2P::Peer *peer) override;
+  void on_initialized(P2P::Peer *peer) override {};
+
+ private:
+  std::unique_ptr<P2P::Client> p2p_client_;
+  std::unique_ptr<Sink> sink_;
+  P2P::Peer *peer_;
+};
