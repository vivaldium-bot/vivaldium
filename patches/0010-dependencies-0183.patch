+  else
+    assert(Ty == IceType_i32 || (Traits::Is64Bit && Ty == IceType_i64));
+  emitAddrSizeOverridePrefix();
+  emitRex(Ty, src, dst);
+  emitUint8(0x0F);
+  emitUint8(0x40 + cond);
+  emitOperand(gprEncoding(dst), src);
