+template <class Machine>
+void TargetX86Base<Machine>::emit(const ConstantRelocatable *C) const {
+  if (!BuildDefs::dump())
+    return;
+  assert(!getFlags().getUseNonsfi() ||
+         C->getName().toString() == GlobalOffsetTable);
