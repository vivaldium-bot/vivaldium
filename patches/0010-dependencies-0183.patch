+#include "webrtc/modules/remote_bitrate_estimator/overuse_estimator.h"
+
+#include <assert.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <algorithm>
+
+#include "webrtc/base/logging.h"
