+    assert((is64) || (is32) || (is16) || (is8) ||                              \
+           getBaseReg(RegisterSet::val) == RegisterSet::Reg_rsp);              \
+    constexpr RegisterSet::AllRegisters FirstGprWithRegNumSize =               \
