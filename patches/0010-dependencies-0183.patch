+    Mul,
+    Mvn,
+    Orr,
+    Pop,
+    Push,
+    Rbit,
+    Ret,
+    Rev,
+    Rsb,
+    Rsc,
+    Sbc,
+    Sdiv,
+    Str,
+    Strex,
+    Sub,
+    Sxt,
+    Trap,
+    Tst,
+    Udiv,
+    Umull,
+    Uxt,
+    Vabs,
+    Vadd,
