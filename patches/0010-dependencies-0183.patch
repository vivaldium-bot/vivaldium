+void RTPSender::ProcessBitrate() {
+  rtc::CritScope lock(&send_critsect_);
+  total_bitrate_sent_.Process();
+  nack_bitrate_.Process();
+  if (audio_configured_) {
+    return;
+  }
+  video_->ProcessBitrate();
+}
