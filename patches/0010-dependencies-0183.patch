+  }
+
+^[[:alpha:]][[:alnum:]\-\_]* {
+    yylval->sval = new std::string(yytext, yyleng);
+    return WFD_GENERIC_PROPERTY_ERROR;
+  }
+
+{DIGITS} {
+    std::string str(yytext, yyleng);
+    str += '\0';
+    errno = 0;
+    yylval->nval = strtoull(str.c_str(), NULL, 10);
+    if (errno)
+      yyterminate();
+    return WFD_NUM;
+  }
+
+ /* all unmatched */
+<*>. {}
+%%
