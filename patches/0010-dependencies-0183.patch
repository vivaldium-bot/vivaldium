+  // section A5.2.3).
+  void emitType01(CondARM32::Cond Cond, IValueT InstType, IValueT Opcode,
+                  bool SetFlags, IValueT Rn, IValueT Rd, IValueT imm12,
+                  EmitChecks RuleChecks, const char *InstName);
