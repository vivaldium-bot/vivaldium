+            function(){gl.uniform3fv(uniFloat, [2,3,4]);});
+        assertGLError(gl, gl.INVALID_OPERATION, "2fv on float",
+            function(){gl.uniform2fv(uniFloat, [2,3]);});
+        assertGLError(gl, gl.INVALID_OPERATION, "3fv on 4fv",
