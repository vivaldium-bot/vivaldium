+; MIPS32: 	sw	a0,{{.*}}(sp)
+; MIPS32: 	addiu	v0,sp,129
+; MIPS32: 	addiu	sp,sp,{{.*}}
+
+; Test that a fixed alloca gets referenced by the frame pointer.
+define internal void @fused_small_align_with_dynamic(i32 %arg) {
+entry:
+  %a1 = alloca i8, i32 8, align 16
+  br label %next
+next:
+  %a2 = alloca i8, i32 12, align 1
