+void AssemblerMIPS32::trunc_w_d(const Operand *OpFd, const Operand *OpFs) {
+  static constexpr IValueT Opcode = 0x4400000D;
+  emitCOP1FmtFsFd(Opcode, DoublePrecision, OpFd, OpFs, "trunc.w.d");
+}
