+    while (1) {                                                                \
+      prev = __sync_val_compare_and_swap(ptr, oldval, newval);                 \
+      if (prev == oldval)                                                      \
+        break;                                                                 \
+      succeeded_first_try = 0;                                                 \
+      oldval = prev;                                                           \
+    }                                                                          \
+    return succeeded_first_try;                                                \
+  }
+
+ATOMIC_TYPE_TABLE
+#undef X
