+  print("Run failures:")
+  print("=============\n")
+  for f in run_failures:
+    print("    \033[1;33m" + f + "\033[1;m")
+
+print("\n\033[1;32m{}\033[1;m / \033[1;33m{}\033[1;m / {} tests passed"
+      .format(run_count, compile_count - run_count,
+              run_count + len(compile_failures) + len(run_failures)))
