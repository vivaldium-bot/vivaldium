+; Check for a valid ARM mul instruction where operands have to be registers.
+; On the other hand x86-32 does allow an immediate.
+define internal i32 @MulImm(i32 %a, i32 %b) {
+entry:
+  %mul = mul i32 %a, 99
+  ret i32 %mul
