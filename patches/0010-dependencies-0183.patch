+
+  std::map<uint32_t, RTCPCnameInformation*>::const_iterator it =
+      _receivedCnameMap.find(remoteSSRC);
+
+  if (it == _receivedCnameMap.end()) {
+    return NULL;
+  }
+  return it->second;
+}
