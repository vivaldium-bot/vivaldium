+  AssemblerBuffer::EnsureCapacity ensured(&Buffer);
+  assert(Ty == IceType_i16 || Ty == IceType_i32);
+  assert(imm.is_int8());
+  if (Ty == IceType_i16)
+    emitOperandSizeOverride();
+  emitRexRB(Ty, src, dst);
+  emitUint8(0x0F);
+  emitUint8(0xA4);
+  emitRegisterOperand(gprEncoding(src), gprEncoding(dst));
+  emitUint8(imm.value() & 0xFF);
+}
