+; CHECK:     Type: SHT_PROGBITS
+; CHECK:     Flags [ (0x6)
+; CHECK:       SHF_ALLOC
+; CHECK:       SHF_EXECINSTR
+; CHECK:     ]
+; CHECK:   }
+
+; CHECK:   Section {
+; CHECK:     Name: .text._start
+; CHECK:     Type: SHT_PROGBITS
+; CHECK:     Flags [ (0x6)
+; CHECK:       SHF_ALLOC
+; CHECK:       SHF_EXECINSTR
+; CHECK:     ]
+; CHECK:   }
+; CHECK:   Section {
+; CHECK:     Name: .rel.text._start
+; CHECK:     Type: SHT_REL
+; CHECK:     Flags [ (0x0)
+; CHECK:     ]
+; CHECK:     )
+; CHECK:   }
+
+; CHECK: Relocations [
+; CHECK:   Section ({{[0-9]+}}) .rel.text.foo {
+; CHECK:     0x1E R_386_PC32 memcpy 0x0
+; CHECK:   }
+;   Relocation can be against the start of the section or
