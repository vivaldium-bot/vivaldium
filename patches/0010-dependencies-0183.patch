+define internal void @icmpNeZero64() {
+entry:
+  %cmp = icmp ne i64 123, 0
+  br i1 %cmp, label %if.then, label %if.end
+
+if.then:                                          ; preds = %entry
+  call void @func()
+  br label %if.end
+
