+      GetReceiveInformation(rtcpPacket.FIR.SenderSSRC);
+
+  RTCPUtility::RTCPPacketTypes pktType = rtcpParser.Iterate();
+  while (pktType == RTCPPacketTypes::kPsfbFirItem) {
