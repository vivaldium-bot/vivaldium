+  nada_sender_.AcceleratedRampDown(congested_fb);
+  int bitrate_2_kbps = std::max(nada_sender_.bitrate_kbps(), kMinBitrateKbps);
+  EXPECT_EQ(bitrate_2_kbps, bitrate_1_kbps);
