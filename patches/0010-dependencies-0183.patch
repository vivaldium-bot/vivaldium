+        parsed_url = urlparse.urlparse(url)
+        auth = None
+        password_manager = None
+        if parsed_url.username:
+            netloc = parsed_url.hostname
+            if parsed_url.port:
+                netloc += ":%s" % parsed_url.port
+            cleaned_url = urlparse.urlunparse((parsed_url.scheme, netloc, parsed_url.path,
