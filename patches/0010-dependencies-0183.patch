+        }
+        *MemOperand = Target->_sandbox_mem_reference(*MemOperand);
+      }
+    }
+
+    ~AutoMemorySandboxer() {
+      if (Bundler != nullptr) {
+        Bundler->~AutoBundle();
+      }
+    }
