+; MIPS32-LABEL: caller1
+; MIPS32: 	addiu	sp,sp,{{.*}}
+; MIPS32: 	sw	ra,{{.*}}(sp)
+; MIPS32: 	move	v0,a0
+; MIPS32: 	sw	v0,{{.*}}(sp)
