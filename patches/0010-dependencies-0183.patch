+  Ostream &Str = Func->getContext()->getStrEmit();
+  Variable *Dest = getDest();
+  auto *SrcLo = llvm::cast<Variable>(getSrc(0));
+  auto *SrcHi = llvm::cast<Variable>(getSrc(1));
+
+  assert(SrcHi->hasReg());
+  assert(SrcLo->hasReg());
+  assert(Dest->hasReg());
+  assert(getSrcSize() == 2);
+
+  Str << "\t"
+         "vmov" << getPredicate() << "\t";
+  Dest->emit(Func);
+  Str << ", ";
+  SrcLo->emit(Func);
+  Str << ", ";
+  SrcHi->emit(Func);
