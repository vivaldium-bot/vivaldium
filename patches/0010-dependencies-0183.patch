+      varying vec4 texCoord0;
+      void main()
+      {
+        int i=0;
+        if (texture2D(Texture, texCoord0.st).a > 0.0) {
+          vec4 sum = vec4(0.0);
+          for (i=0; i<7; i++) {
+            vec4 tmp = texture2D(Texture, texCoord0.st + vec2(0,i*step));
+            sum += tmp * kernel[i];
