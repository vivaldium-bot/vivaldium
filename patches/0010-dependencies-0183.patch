+void GlobalContext::popTimer(TimerIdT ID, TimerStackIdT StackID) {
+  auto *Timers = &ICE_TLS_GET_FIELD(TLS)->Timers;
+  assert(StackID < Timers->size());
+  Timers->at(StackID).pop(ID);
