+        """
+        if len(args) == 1:
+            converted_args = args[0]
+        else:
+            converted_args = list(args)
+        converted_args = list(args)
+        return self.execute(Command.EXECUTE_ASYNC_SCRIPT,
+            {'script': script, 'args':converted_args})['value']
