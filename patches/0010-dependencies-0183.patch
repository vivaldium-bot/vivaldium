+  TargetLowering *getTarget() const { return Target.get(); }
+  VariablesMetadata *getVMetadata() const { return VMetadata.get(); }
+  Liveness *getLiveness() const { return Live.get(); }
+  template <typename T = Assembler> T *getAssembler() const {
