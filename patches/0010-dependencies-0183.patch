+
+template <typename Ty, typename T, typename... A>
+typename std::enable_if<!is_cl_initializer<T>::value, Ty>::type
+flagInitOrStorageTypeDefault(T &&, A &&... Other) {
+  return flagInitOrStorageTypeDefault<Ty>(std::forward<A>(Other)...);
