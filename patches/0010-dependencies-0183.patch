+  global args
+  global compile_count
+  global compile_failures
+  global results_lock
+  global run_count
+  global run_failures
+  global OUT_DIR
+  global IGNORED_TESTS
+
+  run_test = not args.translate_only
+
+  test_name = os.path.basename(test_file)
