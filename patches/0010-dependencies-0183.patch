+void TargetHeaderMIPS32::lower() {
+  if (!BuildDefs::dump())
+    return;
+  OstreamLocker L(Ctx);
+  Ostream &Str = Ctx->getStrEmit();
+  Str << "\t.set\t"
+      << "nomicromips\n";
+  Str << "\t.set\t"
+      << "nomips16\n";
+  Str << "\t.set\t"
+      << "noat\n";
+  if (getFlags().getUseSandboxing())
+    Str << "\t.bundle_align_mode 4\n";
+}
