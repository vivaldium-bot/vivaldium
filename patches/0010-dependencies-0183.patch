+}
+
+%{
+#include <string>
+
+#include "parser.h"
+#define yyterminate() return(END)
+%}
+
+%x MATCH_STRING_STATE
+%x MATCH_RESPONSE_CODE_STATE
+
+%s SUPPORTED_METHODS_STATE
+%s CONTENT_TYPE_STATE
+%s SESSION_STATE
+%s MATCH_PRESENTATION_URL
+%s NUM_AS_HEX_MODE
+%s MATCH_EDID_STATE
+
+DIGIT [0-9]
