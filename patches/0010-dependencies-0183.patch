diff --git a/third_party/webgl/src/conformance-suites/1.0.0/conformance/context-attributes-alpha-depth-stencil-antialias.html b/third_party/webgl/src/conformance-suites/1.0.0/conformance/context-attributes-alpha-depth-stencil-antialias.html
