+; CHECK-LABEL: Or
+; CHECK: or e
+; ARM32-LABEL: Or
+; ARM32: orr r
+; MIPS32-LABEL: Or
+; MIPS32: or
+
+define internal i32 @Xor(i32 %a, i32 %b) {
