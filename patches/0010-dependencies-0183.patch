+  if (!r) {
+    testFailed(
+      "assertThrowNoGError: should have thrown exception", name, f);
+    return false;
+  } else {
+    if (glErr !== undefined) {
+      testFailed(
+        "assertThrowNoGError: should be no GL error but generated: " +
+        getGLErrorAsString(gl, glErr), name, f);
+      return false;
+    } else {
+      // console.log("threw:" + exp);
+    }
+  }
+  return true;
+}
