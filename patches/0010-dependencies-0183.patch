+INPUT                  = "../src" \
+                         "../../llvm/include/llvm/ADT" \
+                         "../../llvm/include/llvm/Bitcode" \
+                         "../../llvm/include/llvm/Config" \
+                         "../../llvm/include/llvm/IR" \
+                         "../../llvm/include/llvm/IRReader" \
+                         "../../llvm/include/llvm/Support" \
