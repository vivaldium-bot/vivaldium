+TargetARM32::Sandboxer::Sandboxer(TargetARM32 *Target,
+                                  InstBundleLock::Option BundleOption)
+    : Target(Target), BundleOption(BundleOption) {}
+
+TargetARM32::Sandboxer::~Sandboxer() {}
