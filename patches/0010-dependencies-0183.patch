+; MIPS32O2: jal {{.*}} dummy
+; MIPS32O2: nop
+; MIPS32O2: jr
+; MIPS32O2: nop
+; MIPS32O2: .LtestCondTargetNextBlock$target
+; MIPS32O2: jal {{.*}} dummy
+; MIPS32O2: nop
+; MIPS32O2: jr
+; MIPS32O2: nop
+
