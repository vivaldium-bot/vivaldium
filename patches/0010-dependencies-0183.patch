+; CHECK: ret
+; ARM32-LABEL: test_returning64_arg1
+; ARM32-NEXT: mov r0, r2
+; ARM32-NEXT: mov r1, r3
+; ARM32-NEXT: bx lr
+; MIPS32-LABEL: test_returning64_arg1
+; MIPS32-NEXT: move v0,a2
+; MIPS32-NEXT: move v1,a3
