index 0000000000000000000000000000000000000000..fb1e9b2f71c5e7c691dc5c79fbd82df43c583484
--- /dev/null
+++ b/third_party/wds/src/sink/main.cpp
@@ -0,0 +1,132 @@
+/*
+ * This file is part of Wireless Display Software for Linux OS
+ *
