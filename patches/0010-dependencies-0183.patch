+; MIPS32OM1: jal {{.*}} dummy
+; MIPS32OM1: nop
+; MIPS32OM1: jr
+; MIPS32OM1: nop
+; MIPS32OM1: .LtestCondTargetNextBlock$target
+; MIPS32OM1: jal {{.*}} dummy
+; MIPS32OM1: nop
+; MIPS32OM1: jr
+; MIPS32OM1: nop
+
+; Unconditional branches to the block after a contracted block should be
+; removed.
+define internal void @testUncondToBlockAfterContract() {
+entry:
+  call void @dummy()
+  br label %target
+contract:
+  br label %target
+target:
+  call void @dummy()
+  ret void
