+
+    enum RequestType { ForRenderer, ForComputedStyle };
+
+    PseudoStyleRequest(PseudoId pseudoId, LayoutScrollbar* scrollbar = 0, ScrollbarPart scrollbarPart = NoPart)
+        : pseudoId(pseudoId)
+        , type(ForRenderer)
+        , scrollbarPart(scrollbarPart)
+        , scrollbar(scrollbar)
