+void CSSMediaRule::reattach(StyleRuleBase* rule)
+{
+    CSSGroupingRule::reattach(rule);
+    if (m_mediaCSSOMWrapper && mediaQueries())
+        m_mediaCSSOMWrapper->reattach(mediaQueries());
+}
