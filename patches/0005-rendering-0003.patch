+void StyleResolver::resetAuthorStyle(TreeScope& treeScope)
+{
+    m_treeBoundaryCrossingRules.removeScope(treeScope.rootNode());
+
+    ScopedStyleResolver* resolver = treeScope.scopedStyleResolver();
+    if (!resolver)
+        return;
