+static const CoreException* getErrorEntry(ExceptionCode ec)
+{
+    size_t tableSize = WTF_ARRAY_LENGTH(coreExceptions);
+    size_t tableIndex = ec - IndexSizeError;
+
+    return tableIndex < tableSize ? &coreExceptions[tableIndex] : 0;
+}
