+    resetRuleFeatures();
+
+    if (treeScope.rootNode().isDocumentNode()) {
+        resolver->resetAuthorStyle();
+        return;
+    }
+
+    // resolver is going to be freed below.
+    treeScope.clearScopedStyleResolver();
