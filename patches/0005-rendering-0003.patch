-}, [
-  {at: -0.3, is: 'ray(2deg farthest-corner)'},
-  {at: 0, is: 'ray(-10deg farthest-corner)'},
-  {at: 0.3, is: 'ray(-22deg farthest-corner)'},
-  {at: 0.6, is: 'ray(-34deg farthest-corner)'},
-  {at: 1, is: 'ray(-50deg farthest-corner)'},
