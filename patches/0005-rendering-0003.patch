+        break;
+    case Page:
+        rule = CSSPageRule::create(toStyleRulePage(self), parentSheet);
+        break;
+    case FontFace:
+        rule = CSSFontFaceRule::create(toStyleRuleFontFace(self), parentSheet);
+        break;
+    case Media:
+        rule = CSSMediaRule::create(toStyleRuleMedia(self), parentSheet);
