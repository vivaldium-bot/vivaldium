+    return LengthBox(convertLengthOrAuto(state, rect->top()),
+        convertLengthOrAuto(state, rect->right()),
+        convertLengthOrAuto(state, rect->bottom()),
+        convertLengthOrAuto(state, rect->left()));
+}
