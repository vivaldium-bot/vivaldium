+};
+
+inline bool operator==(const StyleColor& a, const StyleColor& b)
+{
+    if (a.isCurrentColor() || b.isCurrentColor())
+        return a.isCurrentColor() && b.isCurrentColor();
+    return a.color() == b.color();
+}
+
+inline bool operator!=(const StyleColor& a, const StyleColor& b)
+{
+    return !(a == b);
+}
+
+
+} // namespace blink
+
+#endif // StyleColor_h
