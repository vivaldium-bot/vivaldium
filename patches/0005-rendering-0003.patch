+    virtual ~AXObjectCache();
+    DEFINE_INLINE_VIRTUAL_TRACE() { }
+
+    enum AXNotification {
+        AXActiveDescendantChanged,
+        AXAlert,
+        AXAriaAttributeChanged,
+        AXAutocorrectionOccured,
+        AXBlur,
+        AXCheckedStateChanged,
