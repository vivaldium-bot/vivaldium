+static StylePropertySet* leftToRightDeclaration()
+{
+    DEFINE_STATIC_REF_WILL_BE_PERSISTENT(MutableStylePropertySet, leftToRightDecl, (MutableStylePropertySet::create()));
+    if (leftToRightDecl->isEmpty())
