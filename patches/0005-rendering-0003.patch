+}
+
+String CSSMediaRule::cssText() const
+{
+    StringBuilder result;
+    result.appendLiteral("@media ");
+    if (mediaQueries()) {
+        result.append(mediaQueries()->mediaText());
+        result.append(' ');
+    }
+    result.appendLiteral("{ \n");
+    appendCSSTextForItems(result);
+    result.append('}');
+    return result.toString();
+}
