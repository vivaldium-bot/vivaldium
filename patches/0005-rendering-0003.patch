+    }
+
+    PseudoStyleRequest(PseudoId pseudoId, RequestType requestType)
+        : pseudoId(pseudoId)
+        , type(requestType)
+        , scrollbarPart(NoPart)
+        , scrollbar(0)
+    {
+    }
+
+    // The spec disallows inheritance for ::backdrop.
