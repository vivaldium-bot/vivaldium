+static unsigned computeNumberOfTracks(CSSValueList* valueList)
+{
+    unsigned numberOfTracks = 0;
+    for (auto& value : *valueList) {
+        if (value->isGridLineNamesValue())
+            continue;
+        ++numberOfTracks;
+    }
+    return numberOfTracks;
+}
