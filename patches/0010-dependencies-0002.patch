+    }
+    | BVEC3 {
+        $$.initialize(EbtBool, @1);
+        $$.setAggregate(3);
+    }
+    | BVEC4 {
+        $$.initialize(EbtBool, @1);
+        $$.setAggregate(4);
+    }
