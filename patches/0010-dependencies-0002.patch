+    }
+    else if (readdraw == EGL_DRAW)
+    {
+        SetGlobalError(Error(EGL_SUCCESS));
+        return GetGlobalDrawSurface();
+    }
+    else
+    {
+        SetGlobalError(Error(EGL_BAD_PARAMETER));
+        return EGL_NO_SURFACE;
+    }
+}
