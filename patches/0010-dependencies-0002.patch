+static FormatSet BuildAllSizedInternalFormatSet()
+{
+    FormatSet result;
+
+    for (auto iter : GetInternalFormatMap())
+    {
+        if (iter.second.pixelBytes > 0)
+        {
+            // TODO(jmadill): Fix this hack.
+            if (iter.first == GL_BGR565_ANGLEX)
+                continue;
+
+            result.insert(iter.first);
+        }
+    }
