+      case EOpConstructMat4: return "mat4";
+      // Note: EOpConstructStruct can't be handled here
+
+      case EOpAssign: return "=";
+      case EOpInitialize: return "=";
+      case EOpAddAssign: return "+=";
+      case EOpSubAssign: return "-=";
