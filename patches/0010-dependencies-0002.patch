+#endif // LIBANGLE_RENDERER_GL_PROGRAMGL_H_
diff --git a/third_party/angle/src/libANGLE/renderer/gl/QueryGL.cpp b/third_party/angle/src/libANGLE/renderer/gl/QueryGL.cpp
