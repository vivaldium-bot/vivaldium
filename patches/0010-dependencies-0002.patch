+#include "loadimage.inl"
+
+#endif // LIBANGLE_RENDERER_D3D_LOADIMAGE_H_
diff --git a/third_party/angle/src/libANGLE/renderer/d3d/loadimage.inl b/third_party/angle/src/libANGLE/renderer/d3d/loadimage.inl
new file mode 100644
index 0000000000000000000000000000000000000000..920e667db1538207c8a383c90772b846949660f5
