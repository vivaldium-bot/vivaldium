+        $$.initialize(EbtVoid, @1);
+    }
+    | FLOAT_TYPE {
+        $$.initialize(EbtFloat, @1);
+    }
+    | INT_TYPE {
+        $$.initialize(EbtInt, @1);
+    }
+    | UINT_TYPE {
+        $$.initialize(EbtUInt, @1);
+    }
+    | BOOL_TYPE {
+        $$.initialize(EbtBool, @1);
+    }
