+    elif component_type == 'unorm':
+        return 'ANGLE_FORMAT_R{}G{}B{}A{}_UNORM'.format(b, b, b, b)
+    elif component_type == 'snorm':
+        return 'ANGLE_FORMAT_R{}G{}B{}A{}_SNORM'.format(b, b, b, b)
+    elif component_type == 'float':
