diff --git a/third_party/angle/src/compiler/translator/ValidateMultiviewWebGL.cpp b/third_party/angle/src/compiler/translator/ValidateMultiviewWebGL.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..56ba423e0122a60962f590721666e1744c2b28de
