+                params[i] = currentValueData.IntValues[i];
+            }
+        }
+        else
+        {
+            const VertexAttribute &attribState = context->getState().getVertexArray()->getVertexAttribute(index);
+            *params = QuerySingleVertexAttributeParameter<GLint>(attribState, pname);
+        }
+    }
+}
