+ShaderVariable &ShaderVariable::operator=(const ShaderVariable &other)
+{
+    type       = other.type;
+    precision  = other.precision;
+    name       = other.name;
+    mappedName = other.mappedName;
+    arraySize  = other.arraySize;
+    staticUse  = other.staticUse;
+    fields     = other.fields;
