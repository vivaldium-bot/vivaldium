+  HeapObjectIterator iterator(heap()->map_space());
+  for (HeapObject* obj = iterator.Next(); obj != NULL; obj = iterator.Next()) {
+    Map* map = Map::cast(obj);
+    map->VerifyOmittedMapChecks();
+  }
