+   public:
+    explicit NoUseRealAbortsScope(TurboAssembler* tasm)
+        : saved_(tasm->use_real_aborts_), tasm_(tasm) {
+      tasm_->use_real_aborts_ = false;
+    }
+    ~NoUseRealAbortsScope() { tasm_->use_real_aborts_ = saved_; }
+
+   private:
+    bool saved_;
+    TurboAssembler* tasm_;
+  };
