+
+void CallPrinter::VisitCountOperation(CountOperation* node) {
+  Print("(");
+  if (node->is_prefix()) Print(Token::String(node->op()));
+  Find(node->expression(), true);
+  if (node->is_postfix()) Print(Token::String(node->op()));
+  Print(")");
+}
