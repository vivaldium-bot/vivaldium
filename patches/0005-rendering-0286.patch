+class LoadIC : public IC {
+ public:
+  LoadIC(Isolate* isolate, FeedbackNexus* nexus)
+      : IC(NO_EXTRA_FRAME, isolate, nexus) {
+    DCHECK(nexus != NULL);
+    DCHECK(IsAnyLoad());
