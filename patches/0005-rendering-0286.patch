+// Instantiate TailCallBytecodeDispatch() for argument counts used by
+// CSA-generated code
+template V8_EXPORT_PRIVATE Node* CodeAssembler::TailCallBytecodeDispatch(
+    const CallInterfaceDescriptor& descriptor, Node* target, Node*, Node*,
+    Node*, Node*);
