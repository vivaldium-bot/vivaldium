+Node* GraphAssembler::Allocate(PretenureFlag pretenure, Node* size) {
+  return current_effect_ =
+             graph()->NewNode(simplified()->Allocate(Type::Any(), NOT_TENURED),
+                              size, current_effect_, current_control_);
+}
