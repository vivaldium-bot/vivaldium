+const char* EhFrameDisassembler::DwarfRegisterCodeToString(int code) {
+  switch (code) {
+    case kFpDwarfCode:
+      return "fp";
+    case kLrDwarfCode:
+      return "lr";
+    case kJsSpDwarfCode:
+      return "jssp";
+    case kCSpDwarfCode:
+      return "csp";  // This could be zr as well
+    default:
+      UNIMPLEMENTED();
+      return nullptr;
+  }
+}
+
+#endif
