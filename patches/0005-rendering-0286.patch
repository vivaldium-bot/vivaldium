+#ifndef V8_PROFILER_ALLOCATION_TRACKER_H_
+#define V8_PROFILER_ALLOCATION_TRACKER_H_
+
+#include <map>
+
+#include "include/v8-profiler.h"
+#include "src/base/hashmap.h"
+#include "src/handles.h"
+#include "src/list.h"
