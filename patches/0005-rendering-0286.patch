+Scanner::Scanner(UnicodeCache* unicode_cache)
+    : unicode_cache_(unicode_cache),
+      octal_pos_(Location::invalid()),
+      octal_message_(MessageTemplate::kNone),
+      found_html_comment_(false) {}
