+// PopContext <context>
+//
+// Pops the current context and sets <context> as the new context.
+IGNITION_HANDLER(PopContext, InterpreterAssembler) {
+  Node* reg_index = BytecodeOperandReg(0);
+  Node* context = LoadRegister(reg_index);
+  SetContext(context);
+  Dispatch();
+}
