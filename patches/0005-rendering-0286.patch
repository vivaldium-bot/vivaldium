+template <int entrysize>
+bool WeakHashTableShape<entrysize>::IsMatch(Handle<Object> key, Object* other) {
+  if (other->IsWeakCell()) other = WeakCell::cast(other)->value();
+  return key->IsWeakCell() ? WeakCell::cast(*key)->value() == other
+                           : *key == other;
+}
