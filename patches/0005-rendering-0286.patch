+    if (vform == kFormatS) {                                            \
+      float result = OP(src.Float<float>(0), src.Float<float>(1));      \
+      dst.SetFloat(0, result);                                          \
+    } else {                                                            \
+      DCHECK_EQ(vform, kFormatD);                                       \
+      double result = OP(src.Float<double>(0), src.Float<double>(1));   \
+      dst.SetFloat(0, result);                                          \
+    }                                                                   \
+    dst.ClearForWrite(vform);                                           \
+    return dst;                                                         \
+  }
