+
+bool Value::IsUint32() const {
+  i::Handle<i::Object> obj = Utils::OpenHandle(this);
+  if (obj->IsSmi()) return i::Smi::ToInt(*obj) >= 0;
+  if (obj->IsNumber()) {
+    double value = obj->Number();
+    return !i::IsMinusZero(value) &&
+        value >= 0 &&
+        value <= i::kMaxUInt32 &&
+        value == i::FastUI2D(i::FastD2UI(value));
+  }
+  return false;
+}
