+#define MSA_LD_ST(name, opcode)                                \
+  void Assembler::name(MSARegister wd, const MemOperand& rs) { \
+    if (is_int10(rs.offset())) {                               \
+      GenInstrMsaMI10(opcode, rs.offset(), rs.rm(), wd);       \
+    } else {                                                   \
+      LoadRegPlusOffsetToAt(rs);                               \
+      GenInstrMsaMI10(opcode, 0, at, wd);                      \
+    }                                                          \
+  }
