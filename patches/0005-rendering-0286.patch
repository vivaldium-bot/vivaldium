+
+void MacroAssembler::StoreRoot(Register source,
+                               Heap::RootListIndex index) {
+  DCHECK(Heap::RootCanBeWrittenAfterInitialization(index));
+  Str(source, MemOperand(root, index << kPointerSizeLog2));
