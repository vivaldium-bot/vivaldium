+
+inline int CPURegister::SizeInBytes() const {
+  DCHECK(IsValid());
+  DCHECK(SizeInBits() % 8 == 0);
+  return reg_size / 8;
+}
+
+inline bool CPURegister::Is8Bits() const {
+  DCHECK(IsValid());
+  return reg_size == 8;
+}
+
+inline bool CPURegister::Is16Bits() const {
+  DCHECK(IsValid());
+  return reg_size == 16;
+}
+
+inline bool CPURegister::Is32Bits() const {
+  DCHECK(IsValid());
+  return reg_size == 32;
