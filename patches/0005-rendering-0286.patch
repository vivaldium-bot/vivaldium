+
+void MacroAssembler::UntagAndJumpIfSmi(Register dst, Register src,
+                                       Label* smi_case) {
+  STATIC_ASSERT(kSmiTag == 0);
+  TestBitRange(src, kSmiTagSize - 1, 0, r0);
+  SmiUntag(dst, src);
+  beq(smi_case, cr0);
+}
