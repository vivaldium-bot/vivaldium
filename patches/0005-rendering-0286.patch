+ProfileTree::ProfileTree(Isolate* isolate)
+    : root_entry_(CodeEventListener::FUNCTION_TAG, "(root)"),
+      next_node_id_(1),
+      root_(new ProfileNode(this, &root_entry_, nullptr)),
+      isolate_(isolate),
+      next_function_id_(1),
+      function_ids_(ProfileNode::CodeEntriesMatch) {}
