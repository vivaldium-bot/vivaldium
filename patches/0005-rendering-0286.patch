+
+void RegExpMacroAssemblerMIPS::PushRegister(int register_index,
+                                            StackCheckFlag check_stack_limit) {
+  __ lw(a0, register_location(register_index));
+  Push(a0);
+  if (check_stack_limit) CheckStackLimit();
+}
