+  ENTER_V8_DO_NOT_USE(isolate);
+  i::HandleScope scope(isolate);
+  Local<Context> context = v8_isolate->GetCurrentContext();
+  TryCatch try_catch(v8_isolate);
+  Local<String> str;
+  if (!obj->ToString(context).ToLocal(&str)) return;
