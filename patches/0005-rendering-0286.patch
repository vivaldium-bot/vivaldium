+void MacroAssembler::Movn(Register rd, Register rs, Register rt) {
+  if (IsMipsArchVariant(kLoongson) || IsMipsArchVariant(kMips32r6)) {
+    Label done;
+    Branch(&done, eq, rt, Operand(zero_reg));
