+                                             feedback_vector);
+  AccessorAssembler accessor_asm(state());
+  accessor_asm.LoadIC_BytecodeHandler(&params, &exit_point);
+
+  BIND(&done);
+  {
+    SetAccumulator(var_result.value());
+    Dispatch();
+  }
