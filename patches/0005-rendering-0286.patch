+      : Expression(pos, kCallRuntime),
+        function_(function),
+        arguments_(arguments) {}
+  CallRuntime(int context_index, ZoneList<Expression*>* arguments, int pos)
+      : Expression(pos, kCallRuntime),
+        context_index_(context_index),
+        function_(NULL),
+        arguments_(arguments) {}
