+  for (int slot = 0; slot < slot_count;) {
+    FeedbackSlotKind kind = This()->GetKind(FeedbackSlot(slot));
+    int entry_size = FeedbackMetadata::GetSlotSize(kind);
+    DCHECK_LT(0, entry_size);
+    os << "\n Slot #" << slot << " " << kind;
+    slot += entry_size;
+  }
+  os << "\n";
