+void Map::VerifyOmittedMapChecks() {
+  if (!FLAG_omit_map_checks_for_leaf_maps) return;
+  if (!is_stable() ||
+      is_deprecated() ||
+      is_dictionary_map()) {
+    CHECK(dependent_code()->IsEmpty(DependentCode::kPrototypeCheckGroup));
+  }
+}
