+void Object::Print(std::ostream& os) {  // NOLINT
+  if (IsSmi()) {
+    os << "Smi: " << std::hex << "0x" << Smi::cast(this)->value();
+    os << std::dec << " (" << Smi::cast(this)->value() << ")\n";
+  } else {
+    HeapObject::cast(this)->HeapObjectPrint(os);
+  }
+}
