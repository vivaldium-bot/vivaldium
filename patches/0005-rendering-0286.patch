+                        /* store second source.      */ \
+  V_(Rs, 20, 16, Bits)  /* Store-exclusive status    */ \
+  V_(PrefetchMode, 4, 0, Bits)                          \
+                                                        \
+  /* Common bits */                                     \
+  V_(SixtyFourBits, 31, 31, Bits)                       \
+  V_(FlagsUpdate, 29, 29, Bits)                         \
