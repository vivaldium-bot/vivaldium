+
+  switch (EXT2 | (instr->BitField(10, 2))) {
+    case SRADIX: {
+      Format(instr, "sradi'.  'ra,'rs,'sh");
+      return;
+    }
+  }
+
+  switch (EXT2 | (instr->BitField(10, 0))) {
