+                                  generator, JS_ASYNC_GENERATOR_OBJECT_TYPE));
+
+  Node* const value = __ LoadObjectField(
+      generator, JSAsyncGeneratorObject::kAwaitInputOrDebugPosOffset);
+
+  return value;
+}
