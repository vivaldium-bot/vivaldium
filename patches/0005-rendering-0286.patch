+
+void Map::DictionaryMapVerify() {
+  MapVerify();
+  CHECK(is_dictionary_map());
+  CHECK(instance_descriptors()->IsEmpty());
+  CHECK_EQ(0, unused_property_fields());
+  CHECK_EQ(Heap::GetStaticVisitorIdForMap(this), visitor_id());
+}
