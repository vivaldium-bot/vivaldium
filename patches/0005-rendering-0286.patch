+uint64_t Heap::PromotedExternalMemorySize() {
+  if (external_memory_ <= external_memory_at_last_mark_compact_) return 0;
+  return static_cast<uint64_t>(external_memory_ -
+                               external_memory_at_last_mark_compact_);
+}
