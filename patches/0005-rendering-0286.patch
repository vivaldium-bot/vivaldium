+#define RETURN_FAILURE_IF_SCHEDULED_EXCEPTION(isolate)    \
+  do {                                                    \
+    Isolate* __isolate__ = (isolate);                     \
+    if (__isolate__->has_scheduled_exception()) {         \
+      return __isolate__->PromoteScheduledException();    \
+    }                                                     \
