+      result = LowerCheckBounds(node, frame_state);
+      break;
+    case IrOpcode::kCheckMaps:
+      result = LowerCheckMaps(node, frame_state);
+      break;
+    case IrOpcode::kCheckNumber:
+      result = LowerCheckNumber(node, frame_state);
