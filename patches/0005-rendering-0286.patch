+void Simulator::set_dw_register(int dreg, const int* dbl) {
+  DCHECK((dreg >= 0) && (dreg < num_d_registers));
+  registers_[dreg] = dbl[0];
+  registers_[dreg + 1] = dbl[1];
+}
