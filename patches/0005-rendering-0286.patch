+    "source",
+    "name",
+    "source_url",
+    "source_mapping_url",
+    "line_offset",
+    "column_offset"
+  ], [
+    "locationFromPosition", ScriptLocationFromPosition,
+    "nameOrSourceURL", ScriptNameOrSourceURL,
+  ]
+);
+
+});
