+
+SemiSpaceIterator::SemiSpaceIterator(NewSpace* space) {
+  Initialize(space->bottom(), space->top());
+}
+
+
+void SemiSpaceIterator::Initialize(Address start, Address end) {
+  SemiSpace::AssertValidRange(start, end);
+  current_ = start;
+  limit_ = end;
+}
