+void JSGenericLowering::LowerJSCreate(Node* node) {
+  CallDescriptor::Flags flags = FrameStateFlagForCall(node);
+  Callable callable =
+      Builtins::CallableFor(isolate(), Builtins::kFastNewObject);
+  ReplaceWithStubCall(node, callable, flags);
