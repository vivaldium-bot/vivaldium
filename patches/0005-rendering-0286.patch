+      bool success =
+          ObjectMarking::WhiteToGrey<access_mode>(to, marking_state(to));
+      DCHECK(success);
+      USE(success);
+    } else if (ObjectMarking::IsBlack<access_mode>(from, marking_state(from))) {
+      bool success =
+          ObjectMarking::WhiteToBlack<access_mode>(to, marking_state(to));
