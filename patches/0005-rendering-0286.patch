+void MacroAssembler::Ror(Register rd, Register rs, const Operand& rt) {
+  if (rt.is_reg()) {
+    rotrv(rd, rs, rt.rm());
+  } else {
+    int64_t ror_value = rt.imm64_ % 32;
+    if (ror_value < 0) {
+      ror_value += 32;
+    }
+    rotr(rd, rs, ror_value);
+  }
+}
