+   private:
+    uc32 from_;
+    uc32 to_;
+    OutSet* out_set_;
+  };
+
+  class Config {
+   public:
+    typedef uc32 Key;
+    typedef Entry Value;
+    static const uc32 kNoKey;
+    static const Entry NoValue() { return Value(); }
+    static inline int Compare(uc32 a, uc32 b) {
+      if (a == b)
+        return 0;
+      else if (a < b)
+        return -1;
+      else
+        return 1;
+    }
