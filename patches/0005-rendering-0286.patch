+  void AddRange(CharacterRange range, int value, Zone* zone);
+  OutSet* Get(uc32 value);
+  void Dump();
+
+  template <typename Callback>
+  void ForEach(Callback* callback) {
+    return tree()->ForEach(callback);
+  }
