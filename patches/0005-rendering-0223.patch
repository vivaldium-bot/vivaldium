-
-                <rect x="-6" y="-6" width="12" height="12" fill="rgb(204,0,102)">
-                    <set attributeName="x" to="74" max="-6s" end="5s"/>
-                </rect>
-
-                <g transform="translate(20, 0)">
-                    <use xlink:href="#shadow" x="0"/>
