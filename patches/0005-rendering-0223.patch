-    <g id="units-test" fill="black" font-size="10pt" transform="translate(0, 60)">
-      <!-- ====================================================================== -->
-      <!-- Now, draw rectangles using the various unit specifiers                 -->
-      <!-- ====================================================================== -->
-      <!-- User Space -->
-      <text x="20" y="18">200</text>
