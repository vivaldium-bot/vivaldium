-      <line x1="0" y1="40" x2="50" y2="40" stroke="#cccccc" stroke-width="1"/>
-      <text x="60" y="15">Percentage</text>
-      <text x="60" y="35">Fraction</text>
-      <text x="60" y="55">User Space</text>
-    </g>
