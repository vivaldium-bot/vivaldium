-
-            <text>2 offsets</text>
-
-            <text y="25">2 sync bases</text>
-
-            <text y="50">2 repeat</text>
-
-
-
-            <text y="100">2 event base</text>
-
-            <text y="125">2 accessKeys</text>
-
-
-
-            <text y="150">misc</text>
-
-        </g>
-
-
