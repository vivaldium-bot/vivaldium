-                    <animate id="an1" attributeName="height" calcMode="spline" keySplines="0,0,1,1;0,0,1,1;.75,0,0,.75" values="210;177;121;10" begin="0s" dur="9s" fill="freeze"/>
-                </rect>
-            </g>
-
-            <g transform="translate(250,50)">
