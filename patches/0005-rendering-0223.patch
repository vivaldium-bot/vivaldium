-<!--  27-Apr-2000, LH=" fix missing "#" on url(clip2)" ser#3.             -->
-<!--  03-Aug-2000, LH=" update DOCTYPE for CR DTD, 20000802" ser# .       -->
-<!--  16-Aug-2000, LH="rename" ser#4.                                     -->
-<!--                                                                      -->
