-                    LayoutText {#text} at (0,0) size 179x215
-                      text run at (0,0) width 167: "Known as ``Wilt the Stilt''"
-                      text run at (0,18) width 171: "and ``The Big Dipper,'' the"
-                      text run at (0,36) width 140: "7-foot-1 Chamberlain"
-                      text run at (0,54) width 164: "dominated the NBA from"
-                      text run at (0,72) width 165: "1959 through 1973, when"
-                      text run at (0,90) width 108: "he played for the"
-                      text run at (0,108) width 170: "Philadelphia (later the San"
-                      text run at (0,126) width 155: "Francisco) Warriors, the"
-                      text run at (0,144) width 160: "76ers and the Lakers. He"
-                      text run at (0,162) width 179: "scored 31,419 points during"
-                      text run at (0,180) width 165: "his career, averaging 30.1"
-                      text run at (0,198) width 131: "points for his career."
-                  LayoutBlockFlow {P} at (0,232) size 440x54
-                    LayoutText {#text} at (0,0) size 158x53
-                      text run at (0,0) width 158: "He also led the league in"
-                      text run at (0,18) width 149: "career rebounding with"
-                      text run at (0,36) width 48: "23,924."
-                  LayoutBlockFlow {P} at (0,302) size 440x90
-                    LayoutText {#text} at (0,0) size 419x89
-                      text run at (0,0) width 136: "One of only two men"
-                      text run at (0,18) width 419: "named MVP and rookie of the year in the same season (1959), he"
-                      text run at (0,36) width 415: "was also MVP in 1966 through 1968. He led the NBA in scoring"
-                      text run at (0,54) width 375: "seven straight seasons, 1960 to 1966, and led the league in"
-                      text run at (0,72) width 210: "rebounding 11 of his 14 seasons."
-                  LayoutBlockFlow {P} at (0,408) size 440x54
-                    LayoutText {#text} at (0,0) size 439x53
-                      text run at (0,0) width 406: "One of his most famous records is the 100 points he scored in a"
-                      text run at (0,18) width 439: "single game in the Philadelphia Warriors' 169-147 defeat of the New"
-                      text run at (0,36) width 304: "York Knicks on March 2, 1962, in Hershey, Pa."
