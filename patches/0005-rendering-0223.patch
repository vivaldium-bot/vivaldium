-			</g>
-			<g cursor="default">
-				<rect stroke="none" fill="#666" x="148" y="118" width="80" height="32" />
-				<text stroke="none" fill="#FFF" font-family="Geneva, Arial, Helvetica, sans-serif" font-weight="bold" font-size="16" x="154" y="138">default</text>
-			</g>
-			<g cursor="pointer">
