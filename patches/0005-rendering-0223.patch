-<!--                                                                       -->
-<!-- Tests Marker support                                                  -->
-<!--                                                                       -->
-<!-- Author : Dean Jackson  06-08-2000                                     -->
-<!--          1.1 revision by Rick Graham                                  -->
-<!--                                                                       -->
-<!-- History:                                                              -->
