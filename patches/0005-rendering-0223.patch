-// TODO(ortuno): According to the testing spec errorUUID(0x101) to
-// errorUUID(0x1ff) should be use for the uuids of the characteristics.
-var gatt_errors_tests = [{
-  testName: 'GATT Error: Unknown.',
-  uuid: errorUUID(0xA1),
-  error: new DOMException(
-      'GATT Error Unknown.',
-      'NotSupportedError')
