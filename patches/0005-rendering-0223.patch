-  </rect>
-  <rect color="black" fill="#f00" x="360" y="50" height="100" width="90">
-    <animate attributeName="fill"
-                  to="#008000" from="currentColor"
-                  begin="0s" dur="5s" fill="freeze" />
-  </rect>
