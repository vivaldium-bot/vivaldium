-            <g transform="translate(50, 50)">
-               <rect x="0" y="0" width="20" height="2" fill="blue" />
-               <rect x="0" y="0" width="2" height="20" fill="red" />
-            </g>
-            <!-- Rotate -90 deg about (150, 70) -->
-            <g transform="translate(150, 70) rotate(-90)">
-               <rect x="0" y="0" width="20" height="2" fill="blue" />
-               <rect x="0" y="0" width="2" height="20" fill="red" />
-            </g>
