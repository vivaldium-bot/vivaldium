+
+  rtc_config->type = JavaToNativeIceTransportsType(jni, j_ice_transports_type);
+  rtc_config->bundle_policy = JavaToNativeBundlePolicy(jni, j_bundle_policy);
+  rtc_config->rtcp_mux_policy =
