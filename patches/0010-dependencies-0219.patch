+};
+
+class AndroidVideoBuffer : public AndroidVideoFrameBuffer {
+ public:
+  // Creates a native VideoFrameBuffer from a Java VideoFrame.Buffer.
+  static rtc::scoped_refptr<AndroidVideoBuffer> Create(
