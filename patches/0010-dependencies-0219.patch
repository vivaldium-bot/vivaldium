+    // Wait until the camera has been switched.
+    barrier.await();
+
+    // Check result.
+    assertTrue(cameraSwitchSuccessful[0]);
+    // Ensure that frames are received.
+    assertTrue(videoTrackWithRenderer.rendererCallbacks.waitForNextFrameToRender() > 0);
