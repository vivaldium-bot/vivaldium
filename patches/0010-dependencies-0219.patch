+    enum TestState {
+      kBeforeSuspend,
+      kDuringSuspend,
+      kWaitingForPacket,
+      kWaitingForStats
+    };
+
+    virtual void SendRtcpFeedback(int remb_value)
+        RTC_EXCLUSIVE_LOCKS_REQUIRED(crit_) {
