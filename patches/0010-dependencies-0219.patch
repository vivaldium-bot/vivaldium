new file mode 100644
index 0000000000000000000000000000000000000000..c4d0d0c54c14a5941048eb72038fc9e018cdc477
--- /dev/null
+++ b/third_party/webrtc/sdk/objc/Framework/Classes/Audio/RTCAudioSession+Configuration.mm
@@ -0,0 +1,172 @@
+ /*
