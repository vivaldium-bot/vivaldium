index 0000000000000000000000000000000000000000..3f6fae702a56c355a5d2bcc56ddf846fc093774f
--- /dev/null
+++ b/third_party/xdg-utils/scripts/xdg-file-dialog
@@ -0,0 +1,603 @@
+#!/bin/sh
+#---------------------------------------------
+#   xdg-file-dialog
+#
+#   Utility script to file selection dialogs
+#   on XDG compliant systems.
+#
+#   Refer to the usage() function below for usage.
+#
+#   Copyright 2006, Kevin Krammer <kevin.krammer@gmx.at>
