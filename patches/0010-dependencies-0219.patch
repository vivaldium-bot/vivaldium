+    void PerformTest() override {
+      Clock* clock = Clock::GetRealTimeClock();
+      int64_t now = clock->TimeInMilliseconds();
+      int64_t stop_time = now + test::CallTest::kLongTimeoutMs;
+      bool receive_ok = false;
+      bool send_ok = false;
