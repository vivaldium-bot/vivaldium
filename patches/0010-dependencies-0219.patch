+            # look for both vendor-app.desktop, vendor/app.desktop
+            if [ -r "$x/applications/$default" ]; then
+              file="$x/applications/$default"
+            elif [ -r "$x/applications/`echo $default | sed -e 's|-|/|'`" ]; then
+              file="$x/applications/`echo $default | sed -e 's|-|/|'`"
+            fi
+
