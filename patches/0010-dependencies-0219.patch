+class ReceiveStatisticsProxy : public VCMReceiveStatisticsCallback,
+                               public RtcpStatisticsCallback,
+                               public RtcpPacketTypeCounterObserver,
+                               public StreamDataCountersCallback,
+                               public CallStatsObserver {
+ public:
