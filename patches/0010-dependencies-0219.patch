+import glob
+import optparse
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+
+# Used to time-stamp output files and directories
+CURRENT_TIME = time.strftime("%d_%m_%Y-%H:%M:%S")
+
+
+class Error(Exception):
+  pass
+
+
+class FfmpegError(Error):
+  pass
+
+
+class MagewellError(Error):
+  pass
+
+
+class CompareVideosError(Error):
+  pass
