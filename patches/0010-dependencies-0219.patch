diff --git a/third_party/webrtc/sdk/objc/Framework/Classes/PeerConnection/RTCVideoTrack.mm b/third_party/webrtc/sdk/objc/Framework/Classes/PeerConnection/RTCVideoTrack.mm
new file mode 100644
