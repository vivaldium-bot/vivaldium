index 0000000000000000000000000000000000000000..f0c173973f85ecaf8a6099eceabeec139d7185a6
--- /dev/null
+++ b/third_party/webrtc/sdk/objc/Framework/UnitTests/RTCFileVideoCapturer_xctest.mm
@@ -0,0 +1,113 @@
+/*
+ *  Copyright 2017 The WebRTC project authors. All Rights Reserved.
+ *
