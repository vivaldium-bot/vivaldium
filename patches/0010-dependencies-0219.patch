index 0000000000000000000000000000000000000000..b862f1dd7234f0bce21f004ccaf0188a90d31307
--- /dev/null
+++ b/third_party/webrtc/sdk/android/src/java/org/webrtc/TextureBufferImpl.java
@@ -0,0 +1,105 @@
+/*
