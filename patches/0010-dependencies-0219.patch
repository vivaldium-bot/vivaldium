+
+  def testReturnsSetOfHeadersFromFileContent(self):
+    file_content = """
+    # Some comments
+    if (is_android) {
+      import("//a/b/c.gni")
+      import("//d/e/f.gni")
+    }
+    source_set("foo") {
+      sources = ["foo.h"]
+      deps = [":bar"]
+    }
+    rtc_static_library("bar") {
+      # Public headers should also be included.
+      public = [
+        "public_foo.h",
+      ]
+      sources = [
+        "bar.h",
+        "bar.cc",
+      ]
+      deps = [":bar"]
+    }
