+TEST_P(EndToEndTest, GetStats) {
+  static const int kStartBitrateBps = 3000000;
+  static const int kExpectedRenderDelayMs = 20;
+
+  class ReceiveStreamRenderer : public rtc::VideoSinkInterface<VideoFrame> {
+   public:
