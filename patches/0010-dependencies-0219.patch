+#!/bin/bash
+
+. "$XDG_TEST_DIR/include/testassertions.sh"
+. "$XDG_TEST_DIR/include/testcontrol.sh"
+
+
+test_nodisplay() {
+
+test_start "$FUNCNAME: verify display is not set."
+
+test_init
+
