+void VideoSendStreamImpl::SignalEncoderActive() {
+  RTC_DCHECK_RUN_ON(worker_queue_);
+  RTC_LOG(LS_INFO) << "SignalEncoderActive, Encoder is active.";
+  bitrate_allocator_->AddObserver(
