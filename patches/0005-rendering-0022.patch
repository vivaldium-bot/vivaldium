+  DisallowHeapAllocation no_gc;
+  if (result_len == 0) return *result_array;
+
+  ElementsAccessor* accessor = object->GetElementsAccessor();
+  accessor->CopyElements(
+      elms, k, kind, handle(result_array->elements(), isolate), 0, result_len);
+  return *result_array;
+}
