+class TickSampleEventRecord {
+ public:
+  // The parameterless constructor is used when we dequeue data from
+  // the ticks buffer.
+  TickSampleEventRecord() { }
+  explicit TickSampleEventRecord(unsigned order) : order(order) { }
+
+  unsigned order;
