+#elif V8_LIBC_MSVCRT
+# define V8_INFINITY HUGE_VAL
+#elif V8_OS_AIX
+#define V8_INFINITY (__builtin_inff())
+#else
+# define V8_INFINITY INFINITY
+#endif
