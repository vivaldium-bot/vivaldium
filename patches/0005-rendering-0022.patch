+void JavaScriptFrame::SaveOperandStack(FixedArray* store) const {
+  int operands_count = store->length();
+  DCHECK_LE(operands_count, ComputeOperandsCount());
+  for (int i = 0; i < operands_count; i++) {
+    store->set(i, GetOperand(i));
+  }
+}
