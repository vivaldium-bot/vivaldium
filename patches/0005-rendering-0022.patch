+void AstGraphBuilder::VisitDebuggerStatement(DebuggerStatement* stmt) {
+  Node* node = NewNode(javascript()->CallRuntime(Runtime::kDebugBreak, 0));
+  PrepareFrameState(node, stmt->DebugBreakId());
+  environment()->MarkAllLocalsLive();
+}
