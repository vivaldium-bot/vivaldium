+// Structure used to hold a collection of arguments to the JavaScript code.
+struct JSArguments {
+ public:
+  inline const char*& operator[](int idx) const { return argv[idx]; }
+  static JSArguments Create(int argc, const char** argv) {
+    JSArguments args;
+    args.argc = argc;
+    args.argv = argv;
+    return args;
+  }
