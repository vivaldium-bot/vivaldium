+        Debug.State.currentSourceLine = -1;
+        Debug.State.displaySourceStartLine = -1;
+        Debug.State.displaySourceEndLine = -1;
+        Debug.State.currentFrame = kNoFrame;
+      }
+      details.text = result;
+      break;
