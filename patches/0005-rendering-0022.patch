+
+intptr_t Heap::PromotedSpaceSizeOfObjects() {
+  return old_space_->SizeOfObjects() + code_space_->SizeOfObjects() +
+         map_space_->SizeOfObjects() + lo_space_->SizeOfObjects();
+}
