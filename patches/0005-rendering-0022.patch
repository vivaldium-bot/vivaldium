+struct HandleScopeData {
+  internal::Object** next;
+  internal::Object** limit;
+  int level;
+
+  void Initialize() {
+    next = limit = NULL;
+    level = 0;
+  }
+};
+
+} }  // namespace v8::internal
+
+#endif  // V8_HANDLES_H_
