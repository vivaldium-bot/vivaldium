+
+void VariableProxy::SetFirstFeedbackICSlot(FeedbackVectorICSlot slot,
+                                           ICSlotCache* cache) {
+  variable_feedback_slot_ = slot;
+  if (var()->IsUnallocatedOrGlobalSlot()) {
+    cache->Put(var(), slot);
+  }
+}
