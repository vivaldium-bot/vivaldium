+//
+// Note that this isn't necessarily an object, since webpages can write, for
+// example, "window.vivaldi = true".
+v8::Local<v8::Value> GetOrCreateVivaldi(ScriptContext* context) {
+  v8::Local<v8::String> vivaldi_string(
