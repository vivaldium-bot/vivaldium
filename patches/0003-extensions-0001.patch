+WebViewInternalGetThumbnailFunction::WebViewInternalGetThumbnailFunction()
+    : image_format_(core_api::extension_types::IMAGE_FORMAT_JPEG),  // Default
+                                                                   // format is
+                                                                   // PNG.
+      image_quality_(90 /*kDefaultQuality*/),  // Default quality setting.
