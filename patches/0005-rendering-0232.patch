-        /* falls through */
-        default:
-            try {
-                return typeof val + ' "' + truncate(String(val), 1000) + '"';
-            } catch(e) {
-                return ("[stringifying object threw " + String(e) +
-                        " with type " + String(typeof e) + "]");
-            }
-        }
-    }
