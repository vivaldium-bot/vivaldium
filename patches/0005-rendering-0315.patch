+  __ Store(Operand(rsp, 0 * kPointerSize), rcx, Representation::UInteger8());
+  __ movq(rcx, Operand(rsp, 0 * kPointerSize));
+  __ movl(rdx, Immediate(255));
+  __ cmpq(rcx, rdx);
+  __ j(not_equal, &exit);
