+      thread->Reset();
+      WasmValue args[] = {WasmValue(*a), WasmValue(b)};
+      thread->InitFrame(r.function(), args);
+
+      // Run instructions one by one.
+      for (int i = 0; i < kTraceLength - 1; i++) {
+        thread->Step();
+        // Check the thread stopped.
