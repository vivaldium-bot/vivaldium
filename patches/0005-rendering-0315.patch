+    __ Sw(a7, MemOperand(a0, offsetof(T, swr_3)));
+    __ Lw(a7, MemOperand(a0, offsetof(T, reg_init)));
+    __ swr(a7, MemOperand(a0, offsetof(T, swr_3) + 3));
