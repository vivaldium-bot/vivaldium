+
+      "return true;\n",
+
+      "return false;\n",
+
+      "return 0;\n",
+
+      "return +1;\n",
+
+      "return -1;\n",
+
+      "return +127;\n",
+
+      "return -128;\n",
+
+      "return 2.0;\n",
+  };
+
+  CHECK(CompareTexts(BuildActual(printer, snippets),
+                     LoadGolden("PrimitiveReturnStatements.golden")));
+}
