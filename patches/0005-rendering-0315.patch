+      CHECK_EQ(static_cast<int32_t>(0x223344DD), t.lwl_1);
+      CHECK_EQ(static_cast<int32_t>(0x3344CCDD), t.lwl_2);
+      CHECK_EQ(static_cast<int32_t>(0x44BBCCDD), t.lwl_3);
