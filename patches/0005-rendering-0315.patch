+
+  tester.OnBytesReceived(buffer.begin(), buffer.end() - buffer.begin());
+
+  tester.RunCompilerTasks();
+  tester.FinishStream();
+  tester.RunCompilerTasks();
+
+  CHECK(tester.IsPromiseFulfilled());
+}
