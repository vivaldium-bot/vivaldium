+TEST(ExternalAllocatedMemory) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope outer(isolate);
+  v8::Local<Context> env(Context::New(isolate));
+  CHECK(!env.IsEmpty());
