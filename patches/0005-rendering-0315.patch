+static void ThrowingGetter(Local<String> name,
+                           const v8::PropertyCallbackInfo<v8::Value>& info) {
+  ApiTestFuzzer::Fuzz();
+  info.GetIsolate()->ThrowException(Local<Value>());
+  info.GetReturnValue().SetUndefined();
+}
