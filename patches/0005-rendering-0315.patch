+  CheckEntry(entry, nullptr, "mm", "m", 0);
+  entry = descriptor->regular_imports()
+              .find(declarations->AtForTest(10)->proxy()->raw_name())
+              ->second;
+  CheckEntry(entry, nullptr, "aa", "aa", 0);
+}
