+bool ApiTestFuzzer::fuzzing_ = false;
+v8::base::Semaphore ApiTestFuzzer::all_tests_done_(0);
+int ApiTestFuzzer::active_tests_;
+int ApiTestFuzzer::tests_being_run_;
+int ApiTestFuzzer::current_;
