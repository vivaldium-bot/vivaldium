+                break;
+              default:
+                value = this.propertiesToObject(
+                    this.getProperties(obj.objectId));
+                break;
+            }
+            break;
+          }
+        }
+        break;
+      }
+      case "undefined": {
+        value = undefined;
+        isUndefined = true;
+        break;
+      }
+      case "number": {
+        if (obj.description === "NaN") {
+          value = NaN;
+        }
+        break;
+      }
+      case "string":
+      case "boolean": {
+        break;
+      }
+      default: {
+        break;
+      }
+    }
