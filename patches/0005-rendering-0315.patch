+      }
+    }
+
+    // And that parsing a script does not.
+    {
+      i::Handle<i::Script> script = factory->NewScript(source);
+      i::ParseInfo info(script);
+      CHECK(!i::parsing::ParseProgram(&info, isolate));
+      isolate->clear_pending_exception();
+    }
+  }
+}
