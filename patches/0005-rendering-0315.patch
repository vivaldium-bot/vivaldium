+    __ Sw(t3, MemOperand(a0, offsetof(T, result_rotr_28)));
+
+    // ROTRV instruction (called through the Ror macro).
+    __ li(t3, 0x0004);
+    __ Ror(a5, a4, t3);
+    __ li(t3, 0x0008);
+    __ Ror(a6, a4, t3);
+    __ li(t3, 0x000C);
+    __ Ror(a7, a4, t3);
+    __ li(t3, 0x0010);
+    __ Ror(t0, a4, t3);
