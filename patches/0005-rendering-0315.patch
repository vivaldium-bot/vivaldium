+      Function::New(env.local(), MicrotaskExceptionOne).ToLocalChecked());
+  isolate->EnqueueMicrotask(
+      Function::New(env.local(), MicrotaskExceptionTwo).ToLocalChecked());
+  TryCatch try_catch(isolate);
+  CompileRun("1+1;");
