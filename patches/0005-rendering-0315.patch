+    CHECK_EQ(*map1, transitions.SearchTransition(*name1, kData, attributes));
+    CHECK_EQ(1, transitions.NumberOfTransitions());
+    CHECK_EQ(*name1, transitions.GetKey(0));
+    CHECK_EQ(*map1, transitions.GetTarget(0));
