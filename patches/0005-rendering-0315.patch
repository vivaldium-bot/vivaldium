+template <typename T>
+static inline Handle<T> RunI(v8::Local<v8::Script> script) {
+  return OpenHandle<T>(Run(script));
+}
+
+template <typename T>
+static inline Handle<T> CompileRunI(const char* script) {
+  return OpenHandle<T>(CompileRun(script));
+}
