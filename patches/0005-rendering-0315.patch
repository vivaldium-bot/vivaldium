+
+  // Create a reference to env2 global from env1 global.
+  env1->Global()
+      ->GetPrototype()
+      .As<v8::Object>()
+      ->SetPrototype(env1.local(), env2->Global()->GetPrototype())
+      .FromJust();
+  // Set some global variables in global2
