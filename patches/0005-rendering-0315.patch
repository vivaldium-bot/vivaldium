+  TestReconfigureDataFieldAttribute_GeneralizeFieldTrivial(
+      {kMutable, Representation::HeapObject(), any_type},
+      {kMutable, Representation::HeapObject(), new_type},
+      {kMutable, Representation::HeapObject(), any_type}, false);
