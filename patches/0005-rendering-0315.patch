+  CHECK(obj->Delete(env.local(), prop_name).FromJust());
+  CHECK_EQ(2002, obj->GetPrivate(env.local(), key)
+                     .ToLocalChecked()
+                     ->Int32Value(env.local())
+                     .FromJust());
+
+  CcTest::CollectAllGarbage();
+
+  CHECK(obj->SetPrivate(env.local(), key, v8::Integer::New(isolate, 2002))
