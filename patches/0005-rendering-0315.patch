+      {0, 0, 0xF6759D85F23B5A2B, 0x5C042AE42C6D12C1, 61}};
+
+#define SLLI_SRLI_DF(lanes, mask, func)      \
+  [](uint64_t wd, uint64_t ws, uint32_t m) { \
+    uint64_t res = 0;                        \
+    int elem_size = kMSARegSize / lanes;     \
+    for (int i = 0; i < lanes / 2; ++i) {    \
+      int shift = elem_size * i;             \
