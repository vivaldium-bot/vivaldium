+static inline v8::Local<v8::Value> Run(v8::Local<v8::Script> script) {
+  v8::Local<v8::Value> result;
+  if (script->Run(v8::Isolate::GetCurrent()->GetCurrentContext())
+          .ToLocal(&result)) {
+    return result;
+  }
+  return v8::Local<v8::Value>();
+}
