+      i::ParseInfo info(script);
+      info.set_module();
+      if (!i::parsing::ParseProgram(&info, isolate)) {
+        i::Handle<i::JSObject> exception_handle(
+            i::JSObject::cast(isolate->pending_exception()));
+        i::Handle<i::String> message_string = i::Handle<i::String>::cast(
