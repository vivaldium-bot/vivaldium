+                  ->Int32Value(context)
+                  .FromJust();
+  if (depth == kTargetRecursionDepth) return;
+  CHECK(args.This()
+            ->Set(context, v8_str("depth"),
+                  v8::Integer::New(args.GetIsolate(), depth + 1))
+            .FromJust());
+  args.GetReturnValue().Set(
+      call_recursively_script->Run(context).ToLocalChecked());
+}
