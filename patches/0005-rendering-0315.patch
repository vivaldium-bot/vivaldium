+  CHECK(!GetGlobalProperty(&context, "obj2")
+             ->SetAccessor(context.local(), v8_str("x"), GetXValue, nullptr,
+                           v8_str("donut"))
+             .FromJust());
+
+  ExpectString("obj1.x", "z");
+  ExpectString("obj2.x", "z");
