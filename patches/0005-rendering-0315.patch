+static void StartJoinAndDeleteThreads(
+    const std::vector<JoinableThread*>& threads) {
+  for (const auto& thread : threads) {
+    thread->Start();
+  }
+  for (const auto& thread : threads) {
+    thread->Join();
+  }
+  for (const auto& thread : threads) {
+    delete thread;
+  }
+}
