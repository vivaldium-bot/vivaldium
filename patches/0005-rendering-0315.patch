+    x = {a:3,b:1};
+    with (x) {
+      debugger;  // Breakpoint.
+    }
+  }
+};
+
+f();
+
+var foo = "global";
+eval("with({bar:'with'}) { (function g() { var foo = 'local'; debugger; })(); }");
+
+// Make sure that the debug event listener vas invoked.
+assertEquals(3, breakPointCount);
+assertFalse(exception, "exception in listener")
