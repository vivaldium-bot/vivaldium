+      isolate->factory()->NewCode(desc, Code::STUB, Handle<Code>());
+
+  auto f = GeneratedCode<FV>::FromCode(*code);
+
+  uint64_t res = reinterpret_cast<uint64_t>(f.Call(rt, rs, 0, 0, 0));
+
+  return res;
+}
