+      test.a = inputs_D[i];
+      test.b = inputs_S[i];
+      f.Call(&test, 0, 0, 0, 0);
+      if ((test.isNaN2008 & kFCSRNaN2008FlagMask) &&
+              kArchVariant == kMips64r6) {
+        CHECK_EQ(test.c, outputsNaN2008[i]);
+      } else {
+        CHECK_EQ(test.c, outputs[i]);
+      }
+      CHECK_EQ(test.d, test.c);
+    }
+  }
