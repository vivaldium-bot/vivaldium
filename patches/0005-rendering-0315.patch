+std::unique_ptr<const uint8_t[]> CreatePayload(const uint8_t* start,
+                                               size_t size) {
+  uint8_t* ret = new uint8_t[size];
+  memcpy(ret, start, size);
+  return std::unique_ptr<const uint8_t[]>(const_cast<const uint8_t*>(ret));
+}
