+        SLLI_SRLI_DF(kMSALanesByte, UINT8_MAX, (elem << (m % elem_size))));
+    run_msa_bit(
+        &tc[i],
+        [](MacroAssembler& assm, uint32_t m) { __ slli_h(w2, w0, m % 16); },
+        SLLI_SRLI_DF(kMSALanesHalf, UINT16_MAX, (elem << (m % elem_size))));
