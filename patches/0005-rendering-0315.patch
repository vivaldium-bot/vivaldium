+  v8::Local<v8::Context> context = info.GetIsolate()->GetCurrentContext();
+  result->Set(context, 0, v8_str("x")).FromJust();
+  result->Set(context, 1, v8::Symbol::GetIterator(info.GetIsolate()))
+      .FromJust();
+  info.GetReturnValue().Set(result);
