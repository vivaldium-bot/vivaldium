+static void CheckTryCatchSourceInfo(v8::Local<v8::Script> script,
+                                    const char* resource_name,
+                                    int line_offset) {
+  v8::HandleScope scope(CcTest::isolate());
+  v8::TryCatch try_catch(CcTest::isolate());
