+  two_byte_source[14] = two_byte_source[78] = two_byte_name[6] = 0x010D;
+  v8::Local<v8::String> source =
+      v8::String::NewFromTwoByte(isolate, two_byte_source,
+                                 v8::NewStringType::kNormal)
