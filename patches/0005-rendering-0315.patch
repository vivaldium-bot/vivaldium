+    int i = 0;
+    // last kLanes - bias bytes of first vector.
+    for (int j = bias; j < kLanes; j++) {
+      expected[i++] = j;
+    }
+    // first bias lanes of second vector
+    for (int j = 0; j < bias; j++) {
+      expected[i++] = j + kLanes;
+    }
+    RunBinaryLaneOpTest(lower_simd, kExprS8x16Shuffle, expected);
+  }
+}
