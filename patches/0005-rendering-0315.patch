+    __ movq(rdx, uint64_t{0x0123456789ABCDEF});
+    __ vmovq(xmm6, rdx);
+    __ vpsrlq(xmm7, xmm6, 4);
+    __ vmovq(rdx, xmm7);
+    __ movq(rcx, uint64_t{0x00123456789ABCDE});
+    __ cmpq(rdx, rcx);
+    __ j(not_equal, &exit);
+    __ vpsllq(xmm7, xmm6, 12);
+    __ vmovq(rdx, xmm7);
+    __ movq(rcx, uint64_t{0x3456789ABCDEF000});
+    __ cmpq(rdx, rcx);
+    __ j(not_equal, &exit);
