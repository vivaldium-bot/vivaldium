+  FOR_FLOAT32_INPUTS(i) {
+    if (SkipFPValue(*i)) continue;
+    FOR_FLOAT32_INPUTS(j) {
+      if (SkipFPValue(*j)) continue;
+      float diff = *i - *j;
+      if (SkipFPExpectedValue(diff)) continue;
+      CHECK_EQ(1, r.Call(*i, *j, expected_op(*i, *j)));
