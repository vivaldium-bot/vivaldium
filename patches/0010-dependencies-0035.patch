+message(STATUS "DEQP_SUPPORT_WGL        = ${DEQP_SUPPORT_WGL}")
+message(STATUS "DEQP_SUPPORT_GLX        = ${DEQP_SUPPORT_GLX}")
+
+# Defines
+add_definitions(-DDEQP_TARGET_NAME="${DEQP_TARGET_NAME}")
