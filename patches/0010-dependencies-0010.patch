+            if (i < dataIndex) {
+              amount = '-' + (dataIndex - i) + ': ';
+            } else if (i > dataIndex) {
+              amount = '+' + (i - dataIndex) + ': ';
+            }
+            nudgeList.push({
+              startRevision: data[i - 1][0] + 1,
+              endRevision: data[i][0],
+              displayEndRevision: displayRevision,
