+      }
+    </style>
+
+    <nav id="navbar">
+      <ul class="menu">
+        <li><a href="/">Home</a></li>
+        <li><a href="/alerts">Alerts</a></li>
+        <li><a href="/report">Browse Graphs</a></li>
