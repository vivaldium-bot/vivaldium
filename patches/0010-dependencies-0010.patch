+      }
+
+      /* The graph-link elements are for links to view associated graphs. */
+      .graph-link, .graph-link:visited {
+        vertical-align: middle;
+        font-size: 1.2em;
+        color: #222;
+      }
+
+      /* The kd-button class is used for the numbers next to rows
+         with grouped alerts. */
+      #alerts .kd-button {
+        background-color: #f5f5f5;
