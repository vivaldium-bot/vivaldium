+      /**
+       * Gets standard deviation for list of numbers and a mean.
+       *
+       * @return {number} A number.
+       */
+      function calculateStdDev(values, mean) {
+        var squaredDevianceSum = values.reduce(
+            function(v1, v2) {return v1 + Math.pow(v2 - mean, 2);}, 0);
