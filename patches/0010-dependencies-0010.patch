+
+  # Mocks fetching bugs from issue tracker.
+  @mock.patch('issue_tracker_service.discovery.build', mock.MagicMock())
+  @mock.patch.object(
+      issue_tracker_service.IssueTrackerService, 'List',
+      mock.MagicMock(return_value={
