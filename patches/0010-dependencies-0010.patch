+
+  def testGetNewTestPath_WithBrackets(self):
+    # Brackets are just used to delete parts of names, no other functionality.
+    self.assertEqual(
+        'A/b/c/x',
+        migrate_test_names._GetNewTestPath('A/b/c/xxxx', '*/*/*/[xxx]'))
+    self.assertEqual(
+        'A/b/c',
