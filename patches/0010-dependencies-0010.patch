+    return self;
+}
+
+#pragma mark -
+
+- (void)pushSearchPaths:(NSArray *)searchPaths;
+{
+    [self.searchPathStack addObject:searchPaths];
+}
+
+- (void)popSearchPaths;
+{
+    if ([self.searchPathStack count] > 0) {
