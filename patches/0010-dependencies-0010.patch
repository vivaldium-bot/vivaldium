+            return null;
+          }
+          var defaultRevType = annotation['a_default_rev'];
+          if (defaultRevType && annotation[defaultRevType]) {
+            return annotation[defaultRevType];
+          }
+
+          // Otherwise, use the x-value of the point (aka the point ID).
