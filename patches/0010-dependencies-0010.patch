+class DebugAlertTest(testing_common.TestCase):
+
+  def setUp(self):
+    super(DebugAlertTest, self).setUp()
+    app = webapp2.WSGIApplication(
+        [('/debug_alert', debug_alert.DebugAlertHandler)])
+    self.testapp = webtest.TestApp(app)
