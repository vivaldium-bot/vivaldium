+
+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+
+  var GRAPH_JSON = {
+    'data': {
+      '0': {
+        'color': 0,
+        'data': [[348164, 24290], [348167, 22206], [348182, 24170],
+                 [348198, 22847], [348224, 25224]],
+        'id': 'line_0'
+      }
+    },
+    'error_bars': {
+      '0': [
+        {
+          'fillBetween': 'line_0',
+          'clickable': false,
+          'hoverable': false,
+          'data': [[348164, 24290], [348167, 22206], [348182, 24170],
+                   [348198, 22847], [348224, 25224]],
+          'color': 0,
+          'id': 'bottom_0',
+          'lines': {
+            'fill': 0.2,
+            'lineWidth': 0,
+            'show': true
+          }
+        },
+        {
+          'fillBetween': 'line_0',
