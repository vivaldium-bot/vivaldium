+    (304613, 1059949.777),
+    (304632, 1056992.888),
+    (304650, 1061859.111),
+    (304666, 1053670.222),
+    (304685, 1068547.111),
+    (304714, 1059868.444),
+    (304739, 1056345.777),
+    (304759, 1051712.0),
+    (304767, 1058595.555),
+    (304772, 1081055.555),
+    (304783, 1080473.777),
+    (304791, 1088900.0),
+    (304794, 1083874.222),
+    (304797, 1082668.444),
+    (304809, 1086152.444),
+    (304822, 1090828.444),
+    (304839, 1094134.666),
+    (304868, 1087627.555),
+    (304892, 1085648.444),
+    (304916, 1082401.777),
+    (304957, 1090009.777),
+    (304968, 1080076.444),
+    (304984, 1085424.888),
+    (304990, 1085520.444),
+    (304995, 1089851.111),
+    (305001, 1077174.222),
+    (305003, 1085427.111),
+    (305007, 1080062.222),
+]
+
+# Sample data where there is no clear step pattern.
+_NOT_STEPPISH = [
+    (301306, 965.568),
+    (301307, 962.378),
+    (301310, 962.355),
+    (301313, 959.623),
+    (301315, 967.824),
+    (301317, 956.898),
+    (301321, 1090.237),
+    (301324, 957.379),
+    (301330, 961.496),
+    (301335, 951.585),
+    (301340, 950.437),
+    (301349, 952.022),
+    (301354, 965.407),
+    (301364, 962.668),
+    (301366, 960.527),
+    (301386, 1198.086),
+    (301403, 979.097),
+    (301405, 955.033),
+    (301430, 952.072),
+    (301456, 1026.557),
+    (301467, 952.001),
+    (301490, 993.909),
+    (301529, 960.194),
+    (301548, 960.707),
+    (301557, 976.913),
+    (301558, 980.134),
+    (301568, 1144.155),
+    (301576, 1234.563),
