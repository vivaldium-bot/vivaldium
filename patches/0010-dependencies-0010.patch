+    }
+
+    SSL_CTX_set_alpn_select_cb(ctx, ALPNSelectCallback, nullptr);
+    SSL_CTX_set_next_protos_advertised_cb(ctx, NPNAdvertiseCallback, nullptr);
+    SSL_CTX_set_early_data_enabled(ctx, 1);
+  }
+
+  ~GlobalState() {
+    SSL_CTX_free(ctx);
+  }
