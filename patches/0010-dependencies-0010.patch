+        var outlierDirections = [];
+        for (var i = 0; i < values.length; i++) {
+          var direction = 0;
+          var value = values[i];
+          var multDevFromMean = Math.abs(value - mean) / stddev;
+          if (multDevFromMean > MULTIPLE_OF_STD_DEV) {
+            if (value >= mean) {
