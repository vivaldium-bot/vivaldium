+      function calculateMean(values) {
+        var len = values.length;
+        var sum = values.reduce(function(v1, v2) { return v1 + v2;}, 0);
+        return sum / len;
+        var squaredDevianceSum = values.reduce(
+            function(v1, v2) {return v1 + Math.pow(v2 - mean, 2);}, 0);
