+class DependencyManagerMock(object):
+  def __init__(self, _):
+    self._fetch_return = 'path'
+
+  def FetchPath(self, _, *unused):
+    del unused
+    return self._fetch_return
+
+
+class PopenMock(object):
+  def __init__(self, *unused):
+    pass
+
