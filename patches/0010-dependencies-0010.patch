+class LsusbTest(mock_calls.TestCase):
+  """Test Lsusb parsing."""
+
+  def testLsusb(self):
+    with self.assertCalls(
+        (mock.call.devil.utils.cmd_helper.GetCmdStatusAndOutputWithTimeout(
