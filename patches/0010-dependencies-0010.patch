+      triage-dialog {
+        position: absolute;
+        margin-top: 30px;
+        z-index: 1000;
+      }
+    </style>
+    <div>
+      <triage-dialog id="triage" on-triaged="{{onTriaged}}" xsrfToken="{{xsrfToken}}">
+      </triage-dialog>
+      <paper-button raised id="file-bug-button" on-click="{{showTriageDialog}}">
