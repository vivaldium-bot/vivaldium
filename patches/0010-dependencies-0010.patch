+
+    def __init__(self):
+      pass
+
+    def execute(self, http):
+      _ = http
+      return {'build': {'id': 'fake_id'}}
+
+  class FakeService(object):
+
+    def __init__(self):
+      self.bodies = []
+
+    def put(self, body):
+      self.bodies.append(body)
+      return BuildbucketServiceTest.FakeRequest()
+
+    def get(self, **kwargs):
+      self.bodies.append(kwargs)
+      return BuildbucketServiceTest.FakeRequest()
