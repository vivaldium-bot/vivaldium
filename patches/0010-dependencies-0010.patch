+        margin-left: -10px; /* Ignore body's padding left. */
+        padding-right: 20px; /* Ignore body's padding right. */
+      }
+
+      #navbar > ul {
+        display: flex;
+        display: -webkit-flex;
+        width: 100%;
+        background-color: #2D2D2D;
