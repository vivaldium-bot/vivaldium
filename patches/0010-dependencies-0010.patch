+
+  def _AddSampleData(self):
+    """Adds TestMetadata and Row entities, and returns the TestMetadata key."""
+    testing_common.AddTests(['M'], ['b'], {'suite': {'foo': {}}})
+    test_path = 'M/b/suite/foo'
