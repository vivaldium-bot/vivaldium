+class SSRow(object):
+  """Class for simulating spreadsheet row."""
+  def __init__(self, row, cols=None):
+    self.custom = {}
+
+    if not cols:
+      # If columns not specified, then column order doesn't matter.
+      cols = row.keys()
+    for col in cols:
+      ss_col = gdata_lib.PrepColNameForSS(col)
+      val = row[col]
+      ss_val = gdata_lib.PrepValForSS(val)
