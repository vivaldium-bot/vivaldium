-    replace(/([(){},.:\[\]])/mg, ' $1 ').
-    replace(/(\w+)/mg, ' $1 ').
-    replace(/<(\/)? (\w+) (\/)?>/mg, '<$1$2$3>').
-    replace(/\s+/mg, ' ').
-    replace(/new (\w+)\s*\(\s*\)/mg, 'new $1');
-
