-        imagesLeftToLoad--;
-        if (imagesLeftToLoad == 0) {
-            onComplete();
-        }
-        if (imagesLeftToLoad < 0)
-            testFailed('Got more load/error callbacks than expected.');
-    }
-
-    for (var i = 0; i < imagesToLoad.length; i++) {
