+		locals2.s1_1.f = coord.x;
+		localFArray[4] = 1.0;
+		localIArray[2] = 0;
+	}
+
+	if (localIArray[2] == 0)
+		++localFArray[4];
+
+ 	float localArray[16];
+	int x = 5;
