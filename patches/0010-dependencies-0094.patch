+++ b/third_party/glslang/src/Test/spv.420.geom
@@ -0,0 +1,43 @@
+#version 420 core
+
+layout(triangles) in;
+
+in gl_PerVertex {
+    float gl_PointSize;
+} gl_in[];
+
+out gl_PerVertex {
+    float gl_PointSize;
+};
+
+layout(line_strip) out;
+layout(max_vertices = 127) out;
