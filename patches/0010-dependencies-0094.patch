diff --git a/third_party/grpc/test/core/statistics/rpc_stats_test.c b/third_party/grpc/test/core/statistics/rpc_stats_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..14def4bfe12323b643aee492beb167a57c6f0ffd
--- /dev/null
+++ b/third_party/grpc/test/core/statistics/rpc_stats_test.c
@@ -0,0 +1,198 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
+ *
+ *     * Redistributions of source code must retain the above copyright
+ * notice, this list of conditions and the following disclaimer.
