+    usampler1D             (utex1D, s);
+    isampler1D             (itex1D, s);
+    usampler1DArray        (utex1DArray, s);
+    samplerBuffer          (texBuffer, s);
+    samplerCubeShadow      (texCube, sShadow);
+    sampler2DArray         (tex2DArray, s);
