@@ -0,0 +1,141 @@
+#version 430
+
+const int a = 1;
+const int b = 2;
+const int c = a + b; // 3
+const int d = c - a; // 2
+const float e = float(d); // 2.0
+const float f = e * float(c); // 6.0
+const float g = f / float(d); // 3.0
+
+const vec2 pytho = vec2(3.0, 4.0);
+
+in vec4 inv;
+out vec4 FragColor;
+out vec2 out2;
+out vec4 out3;
