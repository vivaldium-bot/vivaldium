+    vpbroadcastq xmm0, [HSumSubDB1]
+    vpbroadcastq ymm6, [HSumSubDB1 + 8]
+    vpblendd     ymm6, ymm0, ymm6, 11110000b
+    lea          r5, [3 * r1]
+    lea          r6, [3 * r3]
+    vpxor        ymm5, ymm5, ymm5
+.loop:
+    AVX2_GetSatd16x4 ymm0, r0, r1, r5, r2, r3, r6, ymm6, ymm1, ymm2, ymm3, ymm4
