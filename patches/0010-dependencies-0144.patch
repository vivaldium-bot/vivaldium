+  for (i = 0; i < 8; i++) { // y
+    for (j = 0; j < 8; j++) { // x
+      if (i == 7 && j == 7) { // 8-95
+        pPred[j + iStride[i]] = (uiPixelFilterT[14] + 3 * uiPixelFilterT[15] + 2) >> 2;
+      } else { // 8-96
+        pPred[j + iStride[i]] = (uiPixelFilterT[i + j] + (uiPixelFilterT[i + j + 1] << 1) + uiPixelFilterT[i + j + 2] + 2) >> 2;
