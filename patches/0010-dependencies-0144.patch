+// doUpload indicates whether the given Job should upload its results.
+func doUpload(name string) bool {
+	skipUploadBots := []string{
+		"ASAN",
+		"Coverage",
+		"MSAN",
+		"TSAN",
+		"UBSAN",
+		"Valgrind",
+	}
+	for _, s := range skipUploadBots {
+		if strings.Contains(name, s) {
+			return false
+		}
+	}
+	return true
+}
