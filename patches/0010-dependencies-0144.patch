+%macro LOAD_3_PARA_TO_5_PARA_IDCT 0
+%ifdef X86_32
+    push r3
+    push r4
+    %assign push_num push_num+2
+    mov r0, [esp + push_num*4 + 4]
+    mov r1, [esp + push_num*4 + 8]
+    mov r4, [esp + push_num*4 + 12]
+%else
