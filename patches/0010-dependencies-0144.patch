+    mov         r0, 0
+    add         r4, 16
+    jmp         .loop16x16_get_satd
+ .loop16x16_get_satd_end:
+    MMX_DW_1_2REG    xmm0, xmm1
+    psrlw       xmm4, 1 ;/2
+    psrlw       xmm5, 1 ;/2
+    psrlw       xmm6, 1 ;/2
+    SSE41_HSum8W     xmm4, xmm0, xmm1
+    SSE41_HSum8W     xmm5, xmm0, xmm1
+    SSE41_HSum8W     xmm6, xmm0, xmm1
+
+%ifdef UNIX64
+    pop r4
+%endif
