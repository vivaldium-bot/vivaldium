+    MATRIX_TRANSFORM_EACH_16BITS    d0, d1, d2, d3
+
+    ROW_TRANSFORM_1_STEP_TOTAL_16BITS       d0, d1, d2, d3, d4, d5, d6, d7
+
+    TRANSFORM_TOTAL_16BITS      d0, d1, d2, d3, d4, d5, d6, d7
+    vrshr.s16       d0, d0, #6
+    vrshr.s16       d1, d1, #6
+    vrshr.s16       d2, d2, #6
+    vrshr.s16       d3, d3, #6
