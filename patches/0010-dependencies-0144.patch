+const uint8_t g_kuiZeroLeftTable5[8][2] = { //read 3 bits
+  {1, 3}, {2, 3}, {4, 3}, {3, 3}, {6, 3}, {5, 3}, {0, 2}, {0, 2}
+};
+
+const uint8_t g_kuiZeroLeftTable6[8][2] = { //read 3 bits
