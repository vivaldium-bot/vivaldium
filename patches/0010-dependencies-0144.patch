+    movd      r3d, xmm6 ;DC
+    movd      r1d, xmm5 ;H
+    movd      r0d, xmm4 ;V
+%ifndef X86_32
+    pop r12
+%endif
+    shl       r5d, 1
+    add       r1d, r5d
+    add       r3d, r5d
+    mov       r4, arg5
+    cmp       r3d, r1d
+    jge near   not_dc_16x16
+    cmp        r3d, r0d
+    jge near   not_dc_h_16x16
