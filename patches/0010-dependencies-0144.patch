+    //after rounding 6, clip into [0, 255]
+    vmovl.u8        q2,d16
+    vadd.s16        q0,q2
+    vqmovun.s16 d16,q0
+    vst1.32     {d16[0]},[r0],r1
+    vst1.32     {d16[1]},[r0],r1
+
+    vmovl.u8        q2,d17
+    vadd.s16        q1,q2
+    vqmovun.s16 d17,q1
+    vst1.32     {d17[0]},[r0],r1
+    vst1.32     {d17[1]},[r0]
+
+    pop         {r4}
+WELS_ASM_FUNC_END
+
+
+WELS_ASM_FUNC_BEGIN WelsIDctFourT4Rec_neon
