+      'sources': [
+        '<!@(python read_gni.py ../gn/utils.gni skia_utils_sources)',
+      ],
+      'conditions': [
+        [ 'skia_os == "mac"', {
+          'link_settings': {
+            'libraries': [
+              '$(SDKROOT)/System/Library/Frameworks/AGL.framework',
