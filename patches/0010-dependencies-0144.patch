+    paddw   %1, %6
+    movdqa  %8, %3
+    movdqa  %7, %2
+    paddw   %1, [h264_w0x10_1]
+    paddw   %8, %4
+    paddw   %7, %5
+    psllw   %8, 2
+    psubw   %8, %7
+    paddw   %1, %8
+    psllw   %8, 2
+    paddw   %1, %8
+    psraw   %1, 5
+    WELS_Zero %8
+    packuswb %1, %8
+    movq    %9, %1
+%endmacro
+
+
+%macro FILTER_HV_W4 9
+paddw   %1, %6
+movdqa  %8, %3
+movdqa  %7, %2
+paddw   %1, [h264_w0x10_1]
+paddw   %8, %4
+paddw   %7, %5
+psllw   %8, 2
+psubw   %8, %7
+paddw   %1, %8
+psllw   %8, 2
+paddw   %1, %8
+psraw   %1, 5
+WELS_Zero %8
+packuswb %1, %8
+movd    %9, %1
+%endmacro
