+%macro SSE41_I16x16Get8WSumSub 3 ;xmm5 HSumSubDB1, xmm6 HSumSubDW1, xmm7 PDW1 : in %1, pOut %1, %3
+    pmaddubsw    %1, xmm5
+    movdqa       %2, %1
+    pmaddwd      %1, xmm7
+    pmaddwd      %2, xmm6
+    movdqa       %3, %1
+    punpckldq    %1, %2
+    punpckhdq    %2, %3
+    movdqa       %3, %1
+    punpcklqdq   %1, %2
+    punpckhqdq   %3, %2
+    paddd        xmm4, %1 ;for dc
+    paddd        xmm4, %3 ;for dc
+    packssdw     %1, %3
+    psllw        %1, 2
+%endmacro
