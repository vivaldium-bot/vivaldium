+.macro SELECT_MAX_IN_ABS_COEF arg0, arg1, arg2, arg3, arg4, arg5
+//  {   //  input:  coef_0, coef_1, coef_2, coef_3, max_q (identy to follow two)
+    umax    \arg0\().8h, \arg0\().8h, \arg1\().8h
+    umaxv   \arg4\(), \arg0\().8h
+    umax    \arg2\().8h, \arg2\().8h, \arg3\().8h
+    umaxv   \arg5\(), \arg2\().8h
