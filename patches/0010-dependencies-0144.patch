+#endif//WELS_MAX
+
+#ifndef WELS_MIN
+#define WELS_MIN(x, y) ((x) < (y) ? (x) : (y))
+#endif//WELS_MIN
+#else // Alternative implementation of WELS_MAX and WELS_MIN
+#ifndef WELS_MAX
+#define WELS_MAX(x, y) ((x) - (((x)-(y))&(((x)-(y))>>31)))
+#endif//WELS_MAX
+
+#ifndef WELS_MIN
+#define WELS_MIN(x, y) ((y) + (((x)-(y))&(((x)-(y))>>31)))
