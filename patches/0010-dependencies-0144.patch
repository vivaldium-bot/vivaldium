+    TRANSFORM_TOTAL_16BITS      q0, q1, q2, q3, q8, q9, q10, q11
+    vrshr.s16       q0, q0, #6
+    vrshr.s16       q1, q1, #6
+    vrshr.s16       q2, q2, #6
+    vrshr.s16       q3, q3, #6
