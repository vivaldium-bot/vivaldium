+#define MB_BS_MV(sCurMv, sNeighMv, uiBIdx, uiBnIdx) \
+  (\
+  ( WELS_ABS( sCurMv[uiBIdx].iMvX - sNeighMv[uiBnIdx].iMvX ) >= 4 ) ||\
+  ( WELS_ABS( sCurMv[uiBIdx].iMvY - sNeighMv[uiBnIdx].iMvY ) >= 4 )\
+  )
