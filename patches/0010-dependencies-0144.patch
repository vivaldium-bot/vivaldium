+/*down pLeft*/
+void WelsI8x8LumaPredDDLTop_c (uint8_t* pPred, const int32_t kiStride, bool bTLAvail, bool bTRAvail) {
+  // Top available and Top-right unavailable
+  int32_t iStride[8];
+  uint8_t uiPixelFilterT[16];
+  int32_t i, j;
+
+  for (iStride[0] = 0, i = 1; i < 8; i++) {
