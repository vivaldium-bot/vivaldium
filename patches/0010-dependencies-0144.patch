+inline int32_t  WelsDecodeConstructSlice (PWelsDecoderContext pCtx, PNalUnit pCurNal) {
+  int32_t  iRet = WelsTargetSliceConstruction (pCtx);
+
+  if (iRet) {
+    HandleReferenceLostL0 (pCtx, pCurNal);
+  }
+
+  return iRet;
+}
