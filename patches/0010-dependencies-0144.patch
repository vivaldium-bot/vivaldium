+     */
+    class ColorCubeProcesingCache {
+    public:
+        ColorCubeProcesingCache(int cubeDimension);
+
+        void getProcessingLuts(const int* (*colorToIndex)[2],
+                               const SkScalar* (*colorToFactors)[2],
+                               const SkScalar** colorToScalar);
+
