index 0000000000000000000000000000000000000000..54fae51fe19e1abc082c405ac68f635cfda0232f
--- /dev/null
+++ b/third_party/skia/include/core/SkFilterQuality.h
@@ -0,0 +1,26 @@
+/*
+ * Copyright 2015 Google Inc.
