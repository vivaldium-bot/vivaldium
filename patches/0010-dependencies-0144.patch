+    pinsrb      xmm0,   byte[r0-1],     4
+    pinsrb      xmm0,   byte[r0+r1-1], 5
+    lea         r0,    [r0+2*r1]
+    pinsrb      xmm0,   byte[r0-1],     6
+    pinsrb      xmm0,   byte[r0+r1-1], 7
+    lea         r0,    [r0+2*r1]
+    pinsrb      xmm0,   byte[r0-1],     8
+    pinsrb      xmm0,   byte[r0+r1-1], 9
+    lea         r0,    [r0+2*r1]
+    pinsrb      xmm0,   byte[r0-1],     10
