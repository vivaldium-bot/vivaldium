+    vld1.u32        {d17[0]}, [r2], r3
+    vld1.u32        {d17[1]}, [r2], r3          // q7 is pred
+
+    ROW_TRANSFORM_1_STEP_TOTAL_16BITS       d0, d1, d2, d3, d4, d5, d6, d7
+
+    TRANSFORM_TOTAL_16BITS      d0, d1, d2, d3, d4, d5, d6, d7
