+# This test is disabled because the interactions with GS can be flaky.
+#class GSStoreTest(StoreTest):
+#  """Test the GS store."""
+#  def setUp(self):
+#    super(GSStoreTest, self).setUp()
+#    self._store = asset_utils.GSStore(gsutil=None, bucket=GS_BUCKET)
+#
