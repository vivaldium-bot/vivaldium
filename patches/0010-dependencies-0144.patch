+    punpcklqdq  xmm0,   xmm0
+    punpcklqdq  xmm1,   xmm1
+    SSE41_I16x16Get8WSumSub xmm0, xmm2, xmm3
+    SSE41_I16x16Get8WSumSub xmm1, xmm2, xmm3
