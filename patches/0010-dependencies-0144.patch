+  struct tm   sTimeNow;
+  int32_t iRc;
+
+  localtime_s (&sTimeNow, &kpTp->time);
+
+  iRc = (int32_t)strftime (pBuffer, iSize, kpFormat, &sTimeNow);
+  if (iRc == 0)
+    pBuffer[0] = '\0';
+  return iRc;
+}
