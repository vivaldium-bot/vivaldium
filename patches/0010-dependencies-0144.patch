+  'includes': [
+    'apptype_console.gypi',
+  ],
+  'targets': [
+    {
+      # Build all executable targets defined below.
+      'target_name': 'tools',
+      'type': 'none',
+      'dependencies': [
+        'chrome_fuzz',
+        'dump_record',
+        'get_images_from_skps',
+        'get_current_monitor_profile',
+        'gpuveto',
+        'imgblur',
