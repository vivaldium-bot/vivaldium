+    lea         r0,    [r0+2*r1]
+    pinsrb      xmm0,   byte[r0-1],     12
+    pinsrb      xmm0,   byte[r0+r1-1], 13
+    lea         r0,    [r0+2*r1]
+    pinsrb      xmm0,   byte[r0-1],     14
+    pinsrb      xmm0,   byte[r0+r1-1], 15
