-    args = vars(parser.parse_args([]))
-    wpt_root = os.path.join(root, "w3c", "web-platform-tests")
-    args.update(browser.wptrunner_args(root))
-    args.update({
-        "tests_root": wpt_root,
-        "metadata_root": wpt_root,
-        "repeat": iterations,
