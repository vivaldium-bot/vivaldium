-                      text run at (0,0) width 164: "Known as ``Wilt the Stilt''"
-                      text run at (0,20) width 170: "and ``The Big Dipper,'' the"
-                      text run at (0,40) width 136: "7-foot-1 Chamberlain"
-                      text run at (0,60) width 162: "dominated the NBA from"
-                      text run at (0,80) width 164: "1959 through 1973, when"
-                      text run at (0,100) width 106: "he played for the"
-                      text run at (0,120) width 165: "Philadelphia (later the San"
-                      text run at (0,140) width 151: "Francisco) Warriors, the"
-                      text run at (0,160) width 158: "76ers and the Lakers. He"
-                      text run at (0,180) width 176: "scored 31,419 points during"
-                      text run at (0,200) width 162: "his career, averaging 30.1"
-                      text run at (0,220) width 128: "points for his career."
-                  LayoutBlockFlow {P} at (0,256) size 440x60
-                    LayoutText {#text} at (0,0) size 155x59
-                      text run at (0,0) width 155: "He also led the league in"
-                      text run at (0,20) width 146: "career rebounding with"
-                      text run at (0,40) width 48: "23,924."
-                  LayoutBlockFlow {P} at (0,332) size 440x80
-                    LayoutText {#text} at (0,0) size 437x79
-                      text run at (0,0) width 437: "One of only two men named MVP and rookie of the year in the same"
-                      text run at (0,20) width 422: "season (1959), he was also MVP in 1966 through 1968. He led the"
-                      text run at (0,40) width 412: "NBA in scoring seven straight seasons, 1960 to 1966, and led the"
-                      text run at (0,60) width 268: "league in rebounding 11 of his 14 seasons."
-                  LayoutBlockFlow {P} at (0,428) size 440x60
-                    LayoutText {#text} at (0,0) size 439x59
-                      text run at (0,0) width 439: "One of his most famous records is the 100 points he scored in a single"
-                      text run at (0,20) width 426: "game in the Philadelphia Warriors' 169-147 defeat of the New York"
-                      text run at (0,40) width 266: "Knicks on March 2, 1962, in Hershey, Pa."
