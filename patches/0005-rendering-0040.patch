-<script>
-runTests();
-function runTests() {
-  var before = next.offsetTop;
-  target.style.lineHeightStep = "40px";
-  var after = next.offsetTop;
-  forceRelayout(document.documentElement);
-  var afterRelayout = next.offsetTop;
-
-  test(function () {
