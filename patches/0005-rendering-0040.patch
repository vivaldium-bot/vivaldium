-<!DOCTYPE html>
-<meta charset=utf-8>
-<title>CORS - preflight cache</title>
-<meta name=author title="Odin Hørthe Omdal" href="mailto:odiho@opera.com">
-
-<script src=/resources/testharness.js></script>
