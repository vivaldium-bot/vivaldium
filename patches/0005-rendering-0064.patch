-  channel.onmessage = t.step_func(({ data }) => {
-    if(data === "hi") {
-      startCounter++;
-      if(startCounter === 2) {
-        const sab = new SharedArrayBuffer();
-        channel.postMessage(sab);
-      } else if(startCounter > 2) {
-        assert_unreached();
-      }
-    } else if(data === "dw-success") {
-      dwStatus = "success";
-    } else if(data === "sw-success") {
-      swStatus = "success";
-    } else {
-      assert_unreached();
-    }
-    if(dwStatus === "success" && swStatus === "success") {
-      t.done();
-    }
-  });
-});
