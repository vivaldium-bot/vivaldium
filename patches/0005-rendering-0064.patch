-
-  <div class="blue-relatively-positioned" id="top-right">TR</div>
-
-  <div class="blue-relatively-positioned" id="bottom-left">BL</div>
-
-  <div class="blue-relatively-positioned" id="bottom-right">BR</div>
-
- </body>
