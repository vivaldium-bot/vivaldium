-    assert_idl_attribute(walker, 'previousSibling');
-    assert_idl_attribute(walker, 'nextSibling');
-    assert_idl_attribute(walker, 'previousNode');
-    assert_idl_attribute(walker, 'nextNode');
-}
-
-test(function ()
