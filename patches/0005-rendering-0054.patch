-  // quadrants III and IV, anticlockwise
-  var n2 = p.length;
-  for (i = n2-4; i > 0; i -= 2)
-    p.push(p[i], -p[i+1]);
-
-  // compute start and end indexes from start and extent
-  e %= 360;
-  if (e < 0) {
-    s += e;
-    e = -e;
-  }
-  s %= 360;
-  if (s < 0)
-    s += 360;
-  var is = Math.floor(s/359 * p.length/2);
-  var ie = Math.floor(e/359 * p.length/2)+1;
