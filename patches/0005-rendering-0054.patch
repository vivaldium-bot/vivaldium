-  // quadrant I, anticlockwise
-  p.push(x,-y);
-  while (a2*(y-1/2) > b2*(x+1)) {
-    if (d1 < 0) {
-      d1 += b2*(2*x+3);
-    } else {
-      d1 += b2*(2*x+3) + a2*(-2*y + 2);
-      y -= 1;
-    }
-    x += 1;
-    p.unshift(x,-y);
-  }
-  var d2 = b2*(x+1/2)*(x+1/2) + a2*(y-1)*(y-1) - a2*b2;
