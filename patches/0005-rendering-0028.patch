+// Calling non-objects directly or via Function.prototype.call should
+// not mess up the stack.
+// http://code.google.com/p/v8/issues/detail?id=603
+
+var re = /b../;
+assertThrows(function() {
+  return re('abcdefghijklm') + 'z';
+});
