+
+  assertDoesNotThrow(function() { date.toLocaleDateString("de-DE", undefined); });
+  assertDoesNotThrow(function() { date.toLocaleDateString("de-DE"); });
+  assertThrows(function() { date.toLocaleDateString("de-DE", null); }, TypeError);
+}
