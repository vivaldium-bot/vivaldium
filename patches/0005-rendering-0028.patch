+(function() {
+1 + reference_error //@ sourceURL=evaltest
+})
+*/
+test("2:5", new Function(
+    '1 + reference_error //@ sourceURL=evaltest'));
+/*
+(function(x
+/\**\/) {
+
+ 1 + reference_error //@ sourceURL=evaltest
+})
+*/
+test("4:6", new Function(
+    'x', '\n 1 + reference_error //@ sourceURL=evaltest'));
+/*
+(function(x
+
+,z//
