diff --git a/third_party/webgl/src/conformance-suites/1.0.1/conformance/renderbuffers/framebuffer-object-attachment.html b/third_party/webgl/src/conformance-suites/1.0.1/conformance/renderbuffers/framebuffer-object-attachment.html
