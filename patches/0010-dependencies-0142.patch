+    add             edx,            8
+    mov             [p_sd8x8],      edx
+
+    mov                     edx,            [p_mad8x8]
+    WELS_MAX_REG_SSE2       xmm5
+    ;movdqa         xmm1,   xmm5
+    ;punpcklbw      xmm1,   xmm0
+    ;punpcklwd      xmm1,   xmm0
+    ;movd           [edx],  xmm1
+    ;punpckhbw      xmm5,   xmm0
+    ;punpcklwd      xmm5,   xmm0
+    ;movd           [edx+4],        xmm5
+    ;add                    edx,            8
+    ;mov                    [p_mad8x8],     edx
