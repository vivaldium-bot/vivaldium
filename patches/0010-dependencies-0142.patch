+const wchar_t* tokenStrings[] = {
+    L"TOKand",        L"TOKlparen",     L"TOKrparen",   L"TOKmul",
+    L"TOKplus",       L"TOKcomma",      L"TOKminus",    L"TOKdot",
+    L"TOKdiv",        L"TOKlt",         L"TOKassign",   L"TOKgt",
