+int32_t CXFA_FFDoc::DoLoad() {
+  int32_t iStatus = m_pDocumentParser->DoParse();
+  if (iStatus == XFA_PARSESTATUS_Done && !m_pPDFDoc)
+    return XFA_PARSESTATUS_SyntaxErr;
+  return iStatus;
+}
