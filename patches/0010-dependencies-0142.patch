+
+class CXFA_FMToJavaScriptDepth {
+ public:
+  CXFA_FMToJavaScriptDepth() { depth_++; }
+  ~CXFA_FMToJavaScriptDepth() { depth_--; }
+
+  bool IsWithinMaxDepth() const { return depth_ <= max_depth_; }
+
+  static void Reset();
+
+ private:
+  static unsigned long depth_;
+  static unsigned long max_depth_;
+};
