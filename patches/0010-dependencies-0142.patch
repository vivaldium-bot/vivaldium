+void CXFA_Document::AddPurgeNode(CXFA_Node* pNode) {
+  m_PurgeNodes.insert(pNode);
+}
+
+bool CXFA_Document::RemovePurgeNode(CXFA_Node* pNode) {
+  return !!m_PurgeNodes.erase(pNode);
+}
