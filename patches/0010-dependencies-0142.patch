+%ifdef HAVE_AVX2
+; Max unsigned byte per quadword
+; out=%1 in=%2 tmp=%3
+%macro AVX2_Maxubq 3
+    vpsrlq         %3, %2, 32
+    vpmaxub        %1, %2, %3
+    vpsrlq         %3, %1, 16
+    vpmaxub        %1, %1, %3
+    vpsrlq         %3, %1,  8
+    vpmaxub        %1, %1, %3
+%endmacro
+
+; Max unsigned byte per quadword. 2 register input.
