+         cos(z * 4.0) * 0.5 + 0.5,
+         1 ];
+      },
+      tolerance: 7,
+    },
+    {
+      source: ["$(output) = ",
+           "    $(func)($(input) * vec4(k2PI, 4.0, kHalfPI, kPI)) *",
+           "    0.5 + vec4(0.5, 0.5, 0.5, 1);",
+          ].join("\n"),
+      generator: function(x, y, z, w) {
+    return [ cos(x * k2PI) * 0.5 + 0.5,
+         cos(y * 4.0) * 0.5 + 0.5,
+         cos(z * kHalfPI) * 0.5 + 0.5,
+         cos(w * kPI) * 0.5 + 1.0 ];
+      },
+    },
+  ]
+});
