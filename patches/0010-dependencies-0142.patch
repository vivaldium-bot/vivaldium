+
+    // NOTE: I'm not 100% confident in this test. I think it is correct.
+
+    wtu = WebGLTestUtils;
+    var gl = initWebGL("example", "vshader", "fshader", [ "vPosition"], [ 0, 0, 0, 1 ], 1);
