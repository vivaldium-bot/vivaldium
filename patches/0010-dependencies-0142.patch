+void CXFA_FWLAdapterWidgetMgr::RepaintWidget(CFWL_Widget* pWidget) {
+  if (!pWidget)
+    return;
+
+  CXFA_FFWidget* pFFWidget = pWidget->GetLayoutItem();
+  if (!pFFWidget)
+    return;
+
+  pFFWidget->AddInvalidateRect();
