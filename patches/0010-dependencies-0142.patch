+    vmovdqu        %9,  [%6]
+    AVX2_Sumbdw    %2,  %8,  %7,  %10, %11
+    AVX2_Sumbdw    %3,  %9,  %7,  %10, %11
+    AVX2_Sadbdw    %1,  %8,  %9,  %10, %11
