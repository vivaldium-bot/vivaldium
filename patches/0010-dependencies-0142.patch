+CXFA_Linear::CXFA_Linear(CXFA_Document* doc, XFA_PacketType packet)
+    : CXFA_Node(doc,
+                packet,
+                (XFA_XDPPACKET_Template | XFA_XDPPACKET_Form),
+                XFA_ObjectType::Node,
+                XFA_Element::Linear,
+                kPropertyData,
+                kAttributeData,
+                kName,
+                pdfium::MakeUnique<CJX_Linear>(this)) {}
