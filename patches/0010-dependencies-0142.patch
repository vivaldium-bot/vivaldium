+    mov             r0,     r10
+    mov             r1,     r11
+    add             r0,     r13
+    add             r1,     r13
+
+    dec     r3
+    jnz             sqdiff_bgd_height_loop
+
+    mov             r14,    psadframe
+    movd    [r14],  xmm8
+
+    POP_XMM
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+%assign push_num 0
+%undef          cur_data
+%undef          ref_data
+%undef          iPicWidth
+%undef          iPicHeight
+%undef          iPicStride
+%undef          psadframe
+%undef          psad8x8
+%undef          psum16x16
+%undef          psqsum16x16
+%undef          psqdiff16x16
+%undef          p_sd8x8
+%undef          p_mad8x8
+%undef          tmp_esi
+%undef          tmp_edi
+%undef          pushsize
+%undef          localsize
