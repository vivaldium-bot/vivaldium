+%macro AVX2_Maxubq2 4
+    vpblendd       %4, %2, %3, 10101010b
+    vpshufd        %4, %4, 10110001b
+    vpblendd       %1, %2, %3, 01010101b
+    vpmaxub        %1, %4, %1
+    vpsrld         %4, %1, 16
+    vpmaxub        %1, %1, %4
+    vpsrld         %4, %1,  8
+    vpmaxub        %1, %1, %4
+%endmacro
