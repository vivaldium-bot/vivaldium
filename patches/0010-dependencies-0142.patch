+      L"}\n"
+      L"}\nelse\n{\n"
+      L"if (pfm_rt.is_obj(pfm_rt.dot_acc(pfm_rt.dot_acc(pfm_rt.dot_acc("
+      L"border, \"border\", \"fill\", 0, 0), \"\", \"color\", 0, 0), \"\", "
