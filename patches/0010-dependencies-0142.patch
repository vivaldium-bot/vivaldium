+    WELS_SAD_SD_MAD_16x1_SSE2       xmm7,   xmm6,   xmm5,   xmm4 ,esi ,edi, ebx
+    WELS_SAD_SD_MAD_16x1_SSE2       xmm7,   xmm6,   xmm5,   xmm4 ,esi ,edi, ebx
+    WELS_SAD_SD_MAD_16x1_SSE2       xmm7,   xmm6,   xmm5,   xmm4 ,esi ,edi, ebx
+    WELS_SAD_SD_MAD_16x1_SSE2       xmm7,   xmm6,   xmm5,   xmm4 ,esi ,edi, ebx
+
+    mov                     edx,            [p_mad8x8]
+    WELS_MAX_REG_SSE2       xmm4
+
+    ;movdqa         xmm1,   xmm4
+    ;punpcklbw      xmm1,   xmm0
+    ;punpcklwd      xmm1,   xmm0
