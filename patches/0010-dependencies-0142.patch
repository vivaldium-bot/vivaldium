+%define         p_mad8x8                        arg12
+
+    push r12
+    push r13
+    push r14
+    push r15
+%assign push_num 4
+    PUSH_XMM 10
+%ifdef WIN64
+    mov r4,arg5
+    ;mov r5,arg6
+%endif
