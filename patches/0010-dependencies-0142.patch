+    L"TOKeq",         L"TOKge",         L"TOKdo",       L"TOKkseq",
+    L"TOKksge",       L"TOKksgt",       L"TOKif",       L"TOKin",
+    L"TOKksle",       L"TOKkslt",       L"TOKksne",     L"TOKksor",
+    L"TOKnull",       L"TOKbreak",      L"TOKksand",    L"TOKend",
+    L"TOKeof",        L"TOKfor",        L"TOKnan",      L"TOKksnot",
