index 0000000000000000000000000000000000000000..abc229cf8888360e2030b70d8701ea81f7bec7a9
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.1/extra/fbo-lost-context.html
@@ -0,0 +1,199 @@
+<!--
