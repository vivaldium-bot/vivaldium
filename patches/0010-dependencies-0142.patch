index 0000000000000000000000000000000000000000..ead15b5f9786a43f888b32f9bc7324ab14981bb9
--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.1/conformance/misc/object-deletion-behaviour.html
@@ -0,0 +1,428 @@
+<!--
+Copyright (c) 2011 The Chromium Authors.
+Copyright (c) 2011 Mozilla Foundation.
+
+All rights reserved.
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
