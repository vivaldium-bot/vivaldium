+    add             r14,                    4
+    mov             psqsum16x16,    r14
+
+    mov             r14,            p_sd8x8
+    pshufd  xmm1,           xmm6,           11110101b                       ; Sref1 Sref1 Sref0 Sref0
+    psubd   xmm6,           xmm1            ; 00 diff1 00 diff0
+    pshufd  xmm1,           xmm6,           00001000b                       ;  xx xx diff1 diff0
+    movq    [r14],          xmm1
+    add             r14,            8
+    mov             p_sd8x8,        r14
+
+    mov             r14,            p_mad8x8
+    WELS_MAX_REG_SSE2       xmm5
+
+
+    movhlps         xmm1,   xmm5
+    push r0
+    movd            r0d,    xmm5
+    mov                     [r14],  r0b
+    movd            r0d,    xmm1
+    mov                     [r14+1],r0b
+    pop r0
+    add                     r14,    2
+    mov                     p_mad8x8,       r14
+
+    mov             r14,            psqdiff16x16
+    pshufd  xmm1,           xmm4,           00001110b
+    paddd   xmm4,           xmm1
+    pshufd  xmm1,           xmm4,           00000001b
+    paddd   xmm4,           xmm1
