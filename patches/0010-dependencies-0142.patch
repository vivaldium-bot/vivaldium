+  void Unload();
+  const std::vector<std::unique_ptr<CXFA_PieceLine>>* GetPieceLines() const {
+    return &m_pieceLines;
+  }
+
+  bool m_bHasBlock;
+  std::vector<int32_t> m_Blocks;
