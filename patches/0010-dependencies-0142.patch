+    mov             r14,            psad8x8
+    movdqa  xmm2,           xmm7
+    pshufd  xmm1,           xmm2,           00001110b
+    movd    [r14],          xmm2
+    movd    [r14+4],        xmm1
+    add             r14,            8
+    mov             psad8x8,        r14                     ; sad8x8
+
+    paddd   xmm1,                           xmm2
+    movd    r14d,                           xmm1
+    movd    xmm9,r14d
+    paddd           xmm8,           xmm9                    ; iFrameSad
+
+    mov             r14,            psum16x16
+    movdqa  xmm1,           xmm6
+    pshufd  xmm2,           xmm1,           00001110b
+    paddd   xmm1,           xmm2
