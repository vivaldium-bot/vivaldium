+bool CXFA_WidgetAcc::CalculatePushButtonAutoSize(CXFA_FFDoc* doc,
+                                                 CFX_SizeF& size) {
+  CalcCaptionSize(doc, size);
+  return CalculateWidgetAutoSize(size);
+}
