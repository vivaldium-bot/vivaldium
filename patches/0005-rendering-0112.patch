-    }
-
-  table#left-first
-    {
-      padding-right: 25px;
-      margin-right: 25px;
-    }
-
-  table#right-second
-    {
-      padding-left: 25px;
-      margin-left: 25px;
-    }
-
-  div#reference-overlapped
-    {
