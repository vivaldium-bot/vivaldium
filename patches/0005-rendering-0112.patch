-        return "FAIL";
-
-    var result = [ a.name, a.nodeName ];
-    return result.join(",");
-}
-
-shouldBe("testAttribNodeNamePreservesCaseGetNode()", '"a,a"');
-
-function testAttribNodeNamePreservesCaseGetNode2()
-{
-    // getAttributeNode doesn't work on DIVs, use body element
