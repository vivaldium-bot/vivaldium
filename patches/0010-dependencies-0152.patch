diff --git a/third_party/skia/src/gpu/GrProcessorUnitTest.h b/third_party/skia/src/gpu/GrProcessorUnitTest.h
new file mode 100644
index 0000000000000000000000000000000000000000..739b2f0c263cc09ff5792e336c557e5ca12e8f97
