+    def args_to_files(self, args, tail=None):
+        """
+        Takes a list of arguments, expands any glob patterns, and
+        returns the last "tail" files from the list.
+        """
+        files = []
+        for a in args:
+            files.extend(sorted(glob.glob(a)))
+
+        if tail:
+            files = files[-tail:]
+
+        return files
