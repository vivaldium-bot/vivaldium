+
+    if (_paPlayStream && (LATE(pa_stream_get_state)(_paPlayStream)
+        != PA_STREAM_UNCONNECTED))
+    {
+        // We can only get the mute status if we have a connected stream
+        if (!GetSinkInputInfo())
+          return -1;
