+DEF_TEST(CanvasState_test_soft_clips, reporter) {
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(10, 10);
+    SkCanvas canvas(bitmap);
+
+    SkRRect roundRect;
+    roundRect.setOval(SkRect::MakeWH(5, 5));
