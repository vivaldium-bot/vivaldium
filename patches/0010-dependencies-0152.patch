+#ifndef GrContextFactory_DEFINED
+#define GrContextFactory_DEFINED
+
+#include "GrContext.h"
+#include "GrContextOptions.h"
+
+#include "gl/GLTestContext.h"
+#include "vk/VkTestContext.h"
+#include "SkTArray.h"
