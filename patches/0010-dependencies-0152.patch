+#include <iostream>
+
+#include "SkDebugCanvas.h"
+#include "SkNullCanvas.h"
+#include "SkStream.h"
+
+#ifdef SK_BUILD_FOR_WIN
+#include <fcntl.h>
+#include <io.h>
