+    SkDConic dChopped[2];
+    if (!conic.chopAt(SkDoubleToScalar(t), chopped)) {
+        return;
+    }
+    dChopped[0] = dConic.subDivide(0, t);
+    dChopped[1] = dConic.subDivide(t, 1);
+#if DEBUG_VISUALIZE_CONICS
+    dConic.dump();
+#endif
+    chopCompare(chopped, dChopped);
