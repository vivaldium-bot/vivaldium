+SkCanvas::SkCanvas()
+    : fMCStack(sizeof(MCRec), fMCRecStorage, sizeof(fMCRecStorage))
+    , fProps(SkSurfaceProps::kLegacyFontHost_InitType)
+    , fConservativeRasterClip(false)
+{
+    inc_canvas();
+
+    this->init(nullptr, kDefault_InitFlags);
+}
