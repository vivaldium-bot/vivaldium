index 0000000000000000000000000000000000000000..6bdaadc28d11642143c3bd24ca2ea0e1978714c2
--- /dev/null
+++ b/third_party/skia/tools/skdiff/skdiff.h
@@ -0,0 +1,272 @@
+/*
