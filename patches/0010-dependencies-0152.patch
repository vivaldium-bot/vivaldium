+    SkFindAndPlaceGlyph::ProcessPosText(paint.getTextEncoding(), (const char*) text, byteLength,
+                                        SkPoint::Make(0, 0), SkMatrix(), (const SkScalar*) pos, 2,
+                                        paint.getTextAlign(), cache.get(), processBounds);
+}
