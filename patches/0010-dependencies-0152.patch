+    bool playIsAvailable(false);
+    uint8_t nPlayChannels(0);
+    uint8_t nRecChannels(0);
+    uint8_t loopCount(0);
+
+    while (loopCount < 2)
+    {
+        if (SelectRecordingDevice() == -1)
+        {
+            TEST_LOG("\nERROR: Device selection failed!\n \n");
+            return -1;
+        }
+
+        EXPECT_EQ(0, audioDevice->RecordingIsAvailable(&recIsAvailable));
