+    //  Select an endpoint rendering device given the specified role
+    SAFE_RELEASE(_ptrDeviceOut);
+    hr = _ptrEnumerator->GetDefaultAudioEndpoint(
+                           eRender,
+                           role,
+                           &_ptrDeviceOut);
+    if (FAILED(hr))
