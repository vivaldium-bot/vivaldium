+
+int32_t AudioDeviceLinuxALSA::MaxSpeakerVolume(
+    uint32_t& maxVolume) const
+{
+
+    uint32_t maxVol(0);
+
+    if (_mixerManager.MaxSpeakerVolume(maxVol) == -1)
