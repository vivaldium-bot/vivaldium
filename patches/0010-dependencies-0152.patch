+static void from_565(U16 _565, F* r, F* g, F* b, K* k) {
+    U32 wide = expand(_565);
+    *r = cast(wide & k->r_565_mask) * k->r_565_scale;
+    *g = cast(wide & k->g_565_mask) * k->g_565_scale;
+    *b = cast(wide & k->b_565_mask) * k->b_565_scale;
