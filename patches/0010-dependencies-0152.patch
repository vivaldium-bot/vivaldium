+    EXPECT_EQ(0, audio_device_->SetStereoPlayout(false));
+    EXPECT_EQ(0, audio_device_->StereoPlayout(&enabled));
+    EXPECT_FALSE(enabled);
+    EXPECT_EQ(0, audio_device_->SetStereoPlayout(true));
