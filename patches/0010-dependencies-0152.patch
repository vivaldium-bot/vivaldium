+    const GrRRectBlurEffect& rrbe = other.cast<GrRRectBlurEffect>();
+    return fRRect.getSimpleRadii().fX == rrbe.fRRect.getSimpleRadii().fX &&
+           fSigma == rrbe.fSigma &&
