+    SkAutoMutexAcquire ma(gGetDefaultFaceMutex);
+
+    static SkTypeface* gDefaultFace;
+
+    if (nullptr == gDefaultFace) {
+        gDefaultFace = create_from_name(FONT_DEFAULT_NAME, SkFontStyle());
+    }
+    return gDefaultFace;
+}
