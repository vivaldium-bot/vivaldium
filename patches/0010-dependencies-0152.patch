+        try: i = path_elems.index(dir)
+        except ValueError: pass
+        else: path_elems = path_elems[i+1:]
+        path_elems = [n.name for n in path_elems]
+        return os.sep.join(path_elems)
+
+    def set_src_builder(self, builder):
