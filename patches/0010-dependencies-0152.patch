+using Key = SkTArray<uint32_t>;
+
+static bool make_key(Key* key, const GrShape& shape) {
+    int size = shape.unstyledKeySize();
+    if (size <= 0) {
+        key->reset(0);
+        return false;
+    }
+    SkASSERT(size);
+    key->reset(size);
+    shape.writeUnstyledKey(key->begin());
+    return true;
+}
