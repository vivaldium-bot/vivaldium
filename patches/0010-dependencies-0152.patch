+{
+    CriticalSectionScoped lock(&_critSect);
+    type = _playBufType;
+
+    if (type == AudioDeviceModule::kFixedBufferSize)
+    {
+        sizeMS = _playBufDelayFixed;
+    }
+    else
+    {
+        // Use same value as for PlayoutDelay
+        sizeMS = static_cast<uint16_t>(_sndCardPlayDelay);
+    }
+
+    return 0;
+}
