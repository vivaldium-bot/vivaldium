diff --git a/third_party/skia/src/ports/SkOSLibrary_win.cpp b/third_party/skia/src/ports/SkOSLibrary_win.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b6d8dd3183437a140867df07e24358b584df4254
--- /dev/null
+++ b/third_party/skia/src/ports/SkOSLibrary_win.cpp
