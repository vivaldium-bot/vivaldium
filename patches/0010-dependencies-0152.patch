index 0000000000000000000000000000000000000000..5c459e7cd429964d94902ab4e1c2d0c76d28d979
--- /dev/null
+++ b/third_party/re2/src/kokoro/macos-cmake.cfg
@@ -0,0 +1 @@
+build_file: "re2/kokoro/macos-cmake.sh"
diff --git a/third_party/re2/src/kokoro/macos-cmake.sh b/third_party/re2/src/kokoro/macos-cmake.sh
new file mode 100755
index 0000000000000000000000000000000000000000..dbe94cb9cc092af8078bc0a52cfa53d0b9b4a1b4
--- /dev/null
+++ b/third_party/re2/src/kokoro/macos-cmake.sh
@@ -0,0 +1,14 @@
+#!/bin/bash
+set -eux
+
+cd git/re2
+
+cmake -D CMAKE_BUILD_TYPE=Debug .
+cmake --build . --config Debug --clean-first
+ctest -C Debug --output-on-failure -E dfa\|exhaustive\|random
+
+cmake -D CMAKE_BUILD_TYPE=Release .
+cmake --build . --config Release --clean-first
+ctest -C Release --output-on-failure -E dfa\|exhaustive\|random
+
+exit 0
