+double Linear2Loudness(double rms);
+
+double Db2Loudness(double db);
+
+double Dbfs2Loudness(double dbfs);
+
+#endif  // WEBRTC_MODULES_AUDIO_PROCESSING_AGC_UTILITY_H_
