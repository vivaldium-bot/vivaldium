+    canvas.clipRRect(roundRect, SkCanvas::kIntersect_Op, true);
+
+    SkSetErrorCallback(error_callback, nullptr);
+
+    SkCanvasState* state = SkCanvasStateUtils::CaptureCanvasState(&canvas);
