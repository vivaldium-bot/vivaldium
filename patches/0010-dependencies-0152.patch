+     * Takes ownership of the imageSrc
+     * Refs the data
+     */
+    SkImageGeneratorCG(const SkImageInfo& info, const void* imageSrc, SkData* data);
+
+    SkAutoTCallVProc<const void, CFRelease> fImageSrc;
+    sk_sp<SkData>                           fData;
