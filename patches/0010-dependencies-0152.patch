+#if !defined(SK_BUILD_FOR_WIN32)
+
+#include "SkOSLibrary.h"
+
+#include <dlfcn.h>
+
+void* DynamicLoadLibrary(const char* libraryName) {
+    void* result = dlopen(libraryName, RTLD_LAZY);
+    if (!result) {
+        SkDebugf("Error loading %s {\n %s\n}\n", libraryName, dlerror());
+    }
+    return result;
