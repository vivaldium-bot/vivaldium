+
+DEFINE_string(test_tmpdir, "/var/tmp", "temp directory");
+
+struct Test {
+  void (*fn)(void);
+  const char *name;
+};
+
+static Test tests[10000];
+static int ntests;
+
+void RegisterTest(void (*fn)(void), const char *name) {
+  tests[ntests].fn = fn;
+  tests[ntests++].name = name;
+}
+
+int main(int argc, char** argv) {
+  for (int i = 0; i < ntests; i++) {
