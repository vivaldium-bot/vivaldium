+class SkLiteDL final {
+public:
+    ~SkLiteDL();
+
+    void draw(SkCanvas* canvas) const;
+
+    void reset();
+    bool empty() const { return fUsed == 0; }
+
+#ifdef SK_SUPPORT_LEGACY_DRAWFILTER
+    void setDrawFilter(SkDrawFilter*);
