+    bool fileRecording(false);
+    EXPECT_TRUE(scanf(" %c", &ch) > 0);
+    ch = toupper(ch);
+    if (ch == 'Y')
+    {
+        fileRecording = true;
+    }
+
+    uint32_t startVolume(0);
+    bool enabled(false);
+
