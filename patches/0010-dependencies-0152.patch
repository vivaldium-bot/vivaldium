+    this->getProps(&props);
+    SkAutoGlyphCache cache(paint, &props, 0, &this->getTotalMatrix());
+    SkFindAndPlaceGlyph::ProcessText(paint.getTextEncoding(), (const char*) text, byteLength,
+                                     SkPoint::Make(x, y), SkMatrix(), paint.getTextAlign(),
