+        TEST_LOG("\nERROR: Playout is not available for the selected "
+            "device!\n \n");
+        return -1;
+    }
+
+    TEST_LOG("\nEnable recording of microphone input to file (%s) during this"
+        " test (Y/N)?\n: ",
+             RecordedMicrophoneVolumeFile);
