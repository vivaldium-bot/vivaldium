+
+#include "SkColorFilterImageFilter.h"
+
+#include "SkCanvas.h"
+#include "SkColorFilter.h"
+#include "SkColorSpaceXformer.h"
+#include "SkImageFilterPriv.h"
+#include "SkReadBuffer.h"
+#include "SkSpecialImage.h"
+#include "SkSpecialSurface.h"
