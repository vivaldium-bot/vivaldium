+}
+
+void SkGraphics::Init() {
+    // SkGraphics::Init() must be thread-safe and idempotent.
+    SkCpu::CacheRuntimeFeatures();
+    SkOpts::Init();
+
+#ifdef SK_DEBUG
+    skRTConfRegistry().possiblyDumpFile();
