+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+#include "SkCpu.h"
+#include "SkHalf.h"
+#include "SkOnce.h"
+#include "SkOpts.h"
+
+#define SK_OPTS_NS sk_default
+#include "SkBlend_opts.h"
+#include "SkBlitMask_opts.h"
+#include "SkBlitRow_opts.h"
