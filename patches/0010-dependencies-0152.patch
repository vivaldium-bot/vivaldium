+///////////////////////////////////////////////////////////////////////////////
+
+void SkBitmap::freePixels() {
+    if (fPixelRef) {
+        if (fPixelLockCount > 0) {
+            fPixelRef->unlockPixels();
+        }
+        fPixelRef->unref();
+        fPixelRef = nullptr;
+        fPixelRefOrigin.setZero();
+    }
+    fPixelLockCount = 0;
+    fPixels = nullptr;
+    fColorTable = nullptr;
+}
+
+uint32_t SkBitmap::getGenerationID() const {
+    return (fPixelRef) ? fPixelRef->getGenerationID() : 0;
+}
