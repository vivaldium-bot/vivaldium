+
+/* digital_agc.c
+ *
+ */
+
+#include "webrtc/modules/audio_processing/agc/legacy/digital_agc.h"
+
+#include <assert.h>
+#include <string.h>
+#ifdef WEBRTC_AGC_DEBUG_DUMP
+#include <stdio.h>
+#endif
+
+#include "webrtc/modules/audio_processing/agc/legacy/gain_control.h"
