+void GrRenderTargetContext::insertEventMarker(const SkString& str) {
+    std::unique_ptr<GrOp> op(GrDebugMarkerOp::Make(fRenderTargetProxy.get(), str));
+    this->getRTOpList()->addOp(std::move(op), *this->caps());
+}
