+int32_t AudioDeviceLinuxPulse::PlayoutIsAvailable(bool& available)
+{
+    RTC_DCHECK(thread_checker_.CalledOnValidThread());
+    available = false;
+
+    // Try to initialize the playout side
+    int32_t res = InitPlayout();
+
+    // Cancel effect of initialization
+    StopPlayout();
+
+    if (res != -1)
+    {
+        available = true;
+    }
+
+    return res;
+}
