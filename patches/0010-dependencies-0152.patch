+int32_t AudioDeviceWindowsWave::RecordingIsAvailable(bool& available)
+{
+
+    available = false;
+
+    // Try to initialize the recording side
+    int32_t res = InitRecording();
+
+    // Cancel effect of initialization
+    StopRecording();
+
+    if (res != -1)
+    {
+        available = true;
+    }
+
+    return 0;
+}
