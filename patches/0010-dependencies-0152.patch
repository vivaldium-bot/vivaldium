+int32_t AudioMixerManagerLinuxPulse::Close()
+{
+    RTC_DCHECK(thread_checker_.CalledOnValidThread());
+    WEBRTC_TRACE(kTraceInfo, kTraceAudioDevice, _id, "%s",
+                 __FUNCTION__);
+
+    CloseSpeaker();
+    CloseMicrophone();
+
+    _paMainloop = NULL;
+    _paContext = NULL;
+    _paObjectsSet = false;
+
+    return 0;
+
+}
