+class AutoCallLua : public SkLua {
+public:
+    AutoCallLua(lua_State* L, const char func[], const char verb[]) : INHERITED(L) {
+        lua_getglobal(L, func);
+        if (!lua_isfunction(L, -1)) {
+            int t = lua_type(L, -1);
+            SkDebugf("--- expected function %d\n", t);
