+
+bool SkView::Click::isType(const char type[]) const {
+    const char* t = fType;
+
+    if (type == t) {
+        return true;
+    }
+    if (type == nullptr) {
+        type = "";
+    }
+    if (t == nullptr) {
+        t = "";
+    }
+    return !strcmp(t, type);
