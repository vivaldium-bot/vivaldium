+SkFontConfigInterface* SkFontConfigInterface::RefGlobal() {
+    SkAutoMutexAcquire ac(gFontConfigInterfaceMutex);
+
+    if (gFontConfigInterface) {
+        return SkRef(gFontConfigInterface);
