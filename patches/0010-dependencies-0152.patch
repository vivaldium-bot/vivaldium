+    SkImageInfo info = SkImageInfo::MakeN32Premul(128, 128);
+    auto surface(SkSurface::MakeRenderTarget(ctxInfo.grContext(), SkBudgeted::kNo, info));
+    SkCanvas* canvas = surface->getCanvas();
