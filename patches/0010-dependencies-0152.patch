+
+#ifndef SkBitmapProcState_DEFINED
+#define SkBitmapProcState_DEFINED
+
+#include "SkBitmap.h"
+#include "SkBitmapController.h"
+#include "SkBitmapFilter.h"
+#include "SkBitmapProvider.h"
+#include "SkFloatBits.h"
+#include "SkMatrix.h"
+#include "SkMipMap.h"
+#include "SkPaint.h"
+#include "SkShader.h"
