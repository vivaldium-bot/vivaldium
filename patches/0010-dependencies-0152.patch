new file mode 100644
index 0000000000000000000000000000000000000000..1b58ef45e4adac07b282b186511b92bb92bab285
--- /dev/null
+++ b/third_party/skia/src/gpu/GrBufferAllocPool.h
@@ -0,0 +1,294 @@
+/*
