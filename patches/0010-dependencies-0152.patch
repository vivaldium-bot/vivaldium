+
+int stoi(std::string s) {
+    return atoi(s.c_str());
+}
+
+double stod(std::string s) {
+    return atof(s.c_str());
+}
+
+long stol(std::string s) {
+    return atol(s.c_str());
+}
+
+void sksl_abort() {
