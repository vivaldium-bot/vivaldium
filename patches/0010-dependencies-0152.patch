+GrContext* GrContext::Create(GrBackend backend, GrBackendContext backendContext,
+                             const GrContextOptions& options) {
+    sk_sp<GrContext> context(new GrContext);
+
+    if (!context->init(backend, backendContext, options)) {
+        return nullptr;
+    }
