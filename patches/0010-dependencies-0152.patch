+
+namespace {
+
+/* Note: Skia requires glx 1.3 or newer */
+
+/* This struct is taken from a mesa demo.  Please update as required */
+static const std::vector<std::pair<int, int>> gl_versions = {
+   {1, 0},
+   {1, 1},
