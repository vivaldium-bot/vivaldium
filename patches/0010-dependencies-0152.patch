+DEFINE_bool(verboseFontNames, false, "verbose FontNames test.");
+
+DEF_TEST(FontNames, reporter) {
+    test_synthetic(reporter, FLAGS_verboseFontNames);
+    test_systemfonts(reporter, FLAGS_verboseFontNames);
+}
