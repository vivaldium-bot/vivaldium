new file mode 100644
index 0000000000000000000000000000000000000000..1d08a6adc0bff332d0961da81b6b7392e6d86dc2
--- /dev/null
+++ b/third_party/webrtc/modules/audio_device/android/audio_manager.cc
@@ -0,0 +1,235 @@
+/*
