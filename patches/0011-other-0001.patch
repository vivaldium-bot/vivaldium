+          'INCLUDE_SERVER_PORT',
+          'LINK',
+          'CHROME_BUILD_TYPE',
+          'CHROMIUM_BUILD',
+          'OFFICIAL_BUILD',
+        ],
+        'configurations': {
+          'Debug_Base': {
+            'variables': {
