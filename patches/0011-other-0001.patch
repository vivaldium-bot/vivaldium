+                  a.v[3] - b.v[3], a.v[4] - b.v[4], a.v[5] - b.v[5],
+                  a.v[6] - b.v[6], a.v[7] - b.v[7], a.v[8] - b.v[8],
+                  a.v[9] - b.v[9], a.v[10] - b.v[10], a.v[11] - b.v[11],
+                  a.v[12] - b.v[12], a.v[13] - b.v[13], a.v[14] - b.v[14],
