index 0000000000000000000000000000000000000000..6142ad124a1580a287ba0f3dae8637417062c78c
--- /dev/null
+++ b/breakpad/src/client/mac/handler/protected_memory_allocator.cc
@@ -0,0 +1,92 @@
+// Copyright (c) 2006, Google Inc.
+// All rights reserved.
+//
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
