diff --git a/breakpad/src/common/linux/libcurl_wrapper.cc b/breakpad/src/common/linux/libcurl_wrapper.cc
new file mode 100644
index 0000000000000000000000000000000000000000..fd4e34cd8f13eb577a3d1867982e69209c588b42
--- /dev/null
+++ b/breakpad/src/common/linux/libcurl_wrapper.cc
@@ -0,0 +1,241 @@
+// Copyright (c) 2009, Google Inc.
+// All rights reserved.
+//
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
