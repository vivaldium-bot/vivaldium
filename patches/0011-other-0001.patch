+  def test_TranslateHelpMessage(self):
+    env.set('SCRIPT_NAME', 'pnacl-translate')
+    help_str = pnacl_translate.get_help(self.default_argv)
+    self.assertNotEqual(help_str, driver_tools.HelpNotAvailable())
