+def SetArch(arch):
+  arch = FixArch(arch)
+  env.set('ARCH', arch)
+  base_arch = MaybeStripNonSFISuffix(arch)
+  env.set('BASE_ARCH', base_arch)
+  env.setbool('NONSFI_NACL', arch != base_arch)
+
+
+def GetArch(required = False):
+  arch = env.getone('ARCH')
+  if arch == '':
+    arch = None
+
+  if required and not arch:
+    Log.Fatal('Missing -arch!')
+
+  return arch
