+
+#if defined(_DEBUG)
+int nacl_check_debug_mode = 1;
+#else
+int nacl_check_debug_mode = 0;
+#endif
+
+void NaClCheckSetDebugMode(int mode) {
+  nacl_check_debug_mode = mode;
+}
+
+void NaClCheckIntern(const char *fmt, ...) {
