index 0000000000000000000000000000000000000000..702526af753779c450fdff184e15f35595ae7a4c
--- /dev/null
+++ b/breakpad/src/common/linux/http_upload.cc
@@ -0,0 +1,230 @@
+// Copyright (c) 2006, Google Inc.
+// All rights reserved.
+//
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
