index 0000000000000000000000000000000000000000..6a19865e55cbeb2eb368246ae200aaf37d5d6fd8
--- /dev/null
+++ b/native_client/src/shared/platform/nacl_host_desc_pread_pwrite_test.c
@@ -0,0 +1,747 @@
+/*
