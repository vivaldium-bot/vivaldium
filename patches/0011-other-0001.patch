+libcxxabi=de05b63efeb5df83abe927c08f330c35995c82a7
+#
+# Three lines avoid merge conflicts.
+#
+nacl_newlib=784956835fd318fa64e513ead7774d897386a7be
+#
+# Three lines avoid merge conflicts.
+#
+llvm_test_suite=6438a2b505fa29f82eb850aed1785db1738b971c
+#
+# Three lines avoid merge conflicts.
+#
+compiler_rt=9ded361c356ebc38a115e8134b8f7ca4f1d61eb0
+#
+# Three lines avoid merge conflicts.
+#
+subzero=4b1bdae3955769f62e563e826065d10ddfe040ea
+#
+# Three lines avoid merge conflicts.
