+    IRT_DATA_REGION_START = '%#.8x' % irt_compatible_rodata_addr,
+    # Load addresses of the IRT's code and data segments.
+    IRT_BLOB_CODE_START = '%#.8x' % irt_code_addr,
+    IRT_BLOB_DATA_START = '%#.8x' % irt_data_addr,
+    )
