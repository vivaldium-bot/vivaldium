+
+void MyPerror(nacl::string s) {
+  char error_msg[512];
+  int err = errno;
+  if (0 == NaClGetLastErrorString(error_msg, sizeof error_msg)) {
+    printf("%s: %s\n", s.c_str(), error_msg);
+  } else {
+    printf("%s: errno %d\n", s.c_str(), err);
+  }
+  errno = err;
+}
