+cd toolchain/linux_x86/arm_trusted
+tar xfz ../../../arm-trusted.tgz
+# Check that we can go into a part of it.
+cd arm-2009q3
+cd ../../..
+
+if [[ "${BUILDBOT_SLAVE_TYPE:-Trybot}" != "Trybot" ]]; then
+  echo @@@BUILD_STEP archive_build@@@
