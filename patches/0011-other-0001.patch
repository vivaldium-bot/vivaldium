diff --git a/breakpad/src/client/linux/dump_writer_common/thread_info.cc b/breakpad/src/client/linux/dump_writer_common/thread_info.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0a1041d62d3059d29982ba8e380fbe7960c7b1fd
--- /dev/null
+++ b/breakpad/src/client/linux/dump_writer_common/thread_info.cc
@@ -0,0 +1,305 @@
+// Copyright (c) 2014, Google Inc.
+// All rights reserved.
+//
+// Redistribution and use in source and binary forms, with or without
+// modification, are permitted provided that the following conditions are
+// met:
+//
