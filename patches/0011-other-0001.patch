+    self.assertNotEqual(help_str, driver_tools.HelpNotAvailable())
+    self.assertTrue(len(help_str) > 0)
+
+  def test_BCLDHelpMessage(self):
+    env.set('SCRIPT_NAME', 'pnacl-ld')
