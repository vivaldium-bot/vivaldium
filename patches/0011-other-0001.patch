+
+/* NaCl inter-module communication primitives. */
+
+/* Disables the generation of the min and max macro in <windows.h> */
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+
+#include <algorithm>
+#include <ctype.h>
+#include <limits.h>
