+# Populate the internal include directory when AddHeaderToSdk
+# is used inside nacl_env.
+def AddHeaderInternal(env, nodes, subdir='nacl'):
+  dir = '${INCLUDE_DIR}'
+  if subdir is not None:
+    dir += '/' + subdir
+  n = env.Replicate(dir, nodes)
+  return n
