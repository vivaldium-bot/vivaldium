diff --git a/third_party/angle/src/common/string_utils_unittest.cpp b/third_party/angle/src/common/string_utils_unittest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1ab03d003a5165c6d04603e20ae1618fee4dda8f
