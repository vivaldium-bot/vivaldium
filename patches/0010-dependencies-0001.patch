+        {R"("1-2")", "1-2"},
+        {R"("123a")", "123a"},
+        {R"("12.2.3")", "12.2.3"},
+        {R"("\"")", "\""},
+        {R"("\\")", "\\"},
+        {"\"\\foo\nbar\"", "foo\nbar"},
+        {"\"\\foo\\\nbar\"", "foo\nbar"},
+        {"\"\xE4\xBA\xB2\"", "\xE4\xBA\xB2"},
+        {"\"\\\xE4\xBA\xB2\"", "\xE4\xBA\xB2"},
