+{
+  public:
+    DirectiveParser(Tokenizer *tokenizer,
+                    MacroSet *macroSet,
+                    Diagnostics *diagnostics,
+                    DirectiveHandler *directiveHandler,
+                    int maxMacroExpansionDepth);
+
+    void lex(Token *token) override;
