+
+#ifndef LIBSPIRV_VALIDATE_H_
+#define LIBSPIRV_VALIDATE_H_
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "assembly_grammar.h"
