diff --git a/third_party/angle/src/compiler/translator/DeferGlobalInitializers.cpp b/third_party/angle/src/compiler/translator/DeferGlobalInitializers.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..67ccdf65fc6d78199a400635232e99c5d58f4920
--- /dev/null
