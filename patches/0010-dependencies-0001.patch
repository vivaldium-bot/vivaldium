+
+    {
+        (yyval) = (yyvsp[-2]) * (yyvsp[0]);
+    }
+
+    break;
+
+  case 25:
+
+    {
+        (yyval) = ! (yyvsp[0]);
+    }
+
+    break;
+
+  case 26:
+
+    {
+        (yyval) = ~ (yyvsp[0]);
+    }
+
+    break;
+
+  case 27:
+
+    {
+        (yyval) = - (yyvsp[0]);
+    }
+
+    break;
+
+  case 28:
+
+    {
+        (yyval) = + (yyvsp[0]);
+    }
+
+    break;
+
+  case 29:
