+      boolean parseUnknownField(
+          FieldSet<ExtensionDescriptor> extensions,
+          MessageType defaultInstance,
+          CodedInputStream input,
+          CodedOutputStream unknownFieldsCodedOutput,
+          ExtensionRegistryLite extensionRegistry,
