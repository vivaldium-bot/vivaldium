+            'AyzB2Uo74W4EYxyi5dp_-r68jz8rtbvshsv4TX7srJVkJ57CxTY5Dw2')
+        tmpdir = self._MakeTempDir()
+        invalid_upload_id_tracker_file_name = os.path.join(tmpdir,
+            'invalid_upload_id_tracker')
