+class Is(Comparator):
+    """Comparison class used to check identity, instead of equality."""
+
+    def __init__(self, obj):
+        self._obj = obj
+
+    def equals(self, rhs):
+        return rhs is self._obj
+
+    def __repr__(self):
+        return "<is %r (%s)>" % (self._obj, id(self._obj))
