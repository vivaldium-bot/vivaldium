+_crc8r(PyObject* self, PyObject* args)
+{
+    UINT8 crc;
+    UINT8* data;
+    Py_ssize_t dataLen;
+    UINT8* table;
+    Py_ssize_t tableLen;
+
+    if (!PyArg_ParseTuple(args, INPUT8, &data, &dataLen, &crc,
+                            &table, &tableLen))
