+// what should be a platform independent manner.
+#define BYTE0(x) ((UINT8)(x))
+#define BYTE1(x) ((UINT8)((x) >> 8))
+#define BYTE2(x) ((UINT8)((x) >> 16))
+#define BYTE3(x) ((UINT8)((x) >> 24))
