+            'CreatedAfter': date.strftime(boto.utils.ISO8601),
+            'Version': '2009-03-31'
+        })
+
+    def test_list_clusters_states(self):
+        self.set_http_response(status_code=200)
+        response = self.service_connection.list_clusters(cluster_states=[
+            'RUNNING',
