+  def testSlashesAreNotCollapsed(self):
+    """Tests that '/' is not treated specially if the path separator is '|'.
+
+    In particular, multiple slashes should not be collapsed.
+    """
+    self.assertEqual('/', self.filesystem.CollapsePath('/'))
