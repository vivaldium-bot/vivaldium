+class GsAccessTokenRefreshError(Exception):
+  """Transient error when requesting access token."""
+  def __init__(self, e):
+    super(Exception, self).__init__(e)
+
+
+class GsInvalidRefreshTokenError(Exception):
+  def __init__(self, e):
+    super(Exception, self).__init__(e)
