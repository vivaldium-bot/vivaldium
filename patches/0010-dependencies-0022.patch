+    def equals(self, rhs):
+        """Check to see whether the predicate is False.
+
+        Args:
+            rhs: A value that will be given in argument of the predicate.
+
+        Returns:
+            bool
+        """
+
+        try:
+            return not self._predicate.equals(rhs)
+        except Exception:
+            return False
