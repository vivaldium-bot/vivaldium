+
+    def test_set_session_store(self):
+        app = webapp2.WSGIApplication(config={
+            'webapp2_extras.sessions': {
+                'secret_key': 'my-super-secret',
+            }
+        })
+        req = webapp2.Request.blank('/')
+        req.app = app
