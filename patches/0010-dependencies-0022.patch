+
+SAMPLE_XML = b"""
+<DescribeStacksResponse xmlns="http://cloudformation.amazonaws.com/doc/2010-05-15/">
+  <DescribeStacksResult>
+    <Stacks>
+      <member>
+        <Tags>
+          <member>
+            <Value>value0</Value>
+            <Key>key0</Key>
+          </member>
+          <member>
+            <Key>key1</Key>
+            <Value>value1</Value>
+          </member>
+        </Tags>
+        <StackId>arn:aws:cloudformation:ap-southeast-1:100:stack/Name/id</StackId>
