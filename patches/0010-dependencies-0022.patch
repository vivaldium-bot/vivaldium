+        """
+        url = "http://d604721fxaaqy9.cloudfront.net/horizon.jpg?large=yes&license=yes"
+        expire_time = 1258237200
+        expected_sig = ("Nql641NHEUkUaXQHZINK1FZ~SYeUSoBJMxjdgqrzIdzV2gyE"
