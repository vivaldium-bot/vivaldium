+        if isinstance(value, (int, long)):
+            code = int(value)
+        else:
+            if isinstance(value, unicode):
+                # Status messages have to be ASCII safe, so this is OK.
+                value = str(value)
+
+            if not isinstance(value, str):
+                raise TypeError(
+                    'You must set status to a string or integer (not %s)' %
+                    type(value))
+
+            parts = value.split(' ', 1)
+            code = int(parts[0])
+            if len(parts) == 2:
+                message = parts[1]
