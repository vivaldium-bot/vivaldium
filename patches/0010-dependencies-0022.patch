+    @attr(sqs=True)
+    def test_message_attribute_response(self):
+        self.set_http_response(status_code=200)
+
+        queue = Queue(
+            url='http://sqs.us-east-1.amazonaws.com/123456789012/testQueue/',
+            message_class=RawMessage)
