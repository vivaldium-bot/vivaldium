+        except swf_exceptions.SWFTypeAlreadyExistsError:
+            pass
+
+    def tearDown(self):
+        # Delete what we can...
+        pass
+
+
+
+
+class SimpleWorkflowLayer1Test(SimpleWorkflowLayer1TestBase):
+
+    def test_list_domains(self):
