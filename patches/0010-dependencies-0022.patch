+              <AssumeRoleResult>
+                <AssumedRoleUser>
+                  <Arn>arn:role</Arn>
+                  <AssumedRoleId>roleid:myrolesession</AssumedRoleId>
+                </AssumedRoleUser>
+                <Credentials>
+                  <SessionToken>session_token</SessionToken>
+                  <SecretAccessKey>secretkey</SecretAccessKey>
