+class _MyResponse(io.BytesIO):
+    def __init__(self, body, **kwargs):
+        io.BytesIO.__init__(self, body)
+        self.headers = kwargs
+
+    def items(self):
+        return self.headers.items()
+
+    def iteritems(self):
+        return iter(self.headers.items())
+
