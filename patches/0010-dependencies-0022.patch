diff --git a/third_party/catapult/third_party/Paste/tests/test_recursive.py b/third_party/catapult/third_party/Paste/tests/test_recursive.py
new file mode 100644
index 0000000000000000000000000000000000000000..1cb198449b9b1d0c4cab83bdc14161b10c888ded
