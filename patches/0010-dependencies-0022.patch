+              headers=None, **kwargs): # pragma: no cover
+        """Adds parameters compatible with WebOb >= 1.0: POST and **kwargs."""
+        try:
+            return super(Request, cls).blank(path, environ=environ,
+                                             base_url=base_url,
+                                             headers=headers, **kwargs)
+        except TypeError:
