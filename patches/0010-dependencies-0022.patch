+    def default_value(self):
+        if self.auto_now or self.auto_now_add:
+            return self.now()
+        return super(DateProperty, self).default_value()
+
+    def validate(self, value):
+        value = super(DateProperty, self).validate(value)
+        if value is None:
+            return
