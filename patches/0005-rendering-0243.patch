-    }
-
-    // Schedule a new requestIdleCallback.
-    if (--idle_callbacks_remaining > 0) {
-      previous_deadline = now + remaining;
-      requestIdleCallback(rIC);
-    } else {
-      self.done();
-    }
-  }));
