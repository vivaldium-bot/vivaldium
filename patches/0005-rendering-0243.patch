index 0000000000000000000000000000000000000000..3b090cebc10d00292021b8ec49c8fb7e863977fb
--- /dev/null
+++ b/v8/test/mjsunit/readonly.js
@@ -0,0 +1,233 @@
+// Copyright 2011 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
