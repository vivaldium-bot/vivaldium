-        // AudioParamTimeline.cpp.  This is to account for round-off in the actual implementation
-        // (which uses a filter and not the formula.)
-        var limitThreshold = 1e-21;
-
-        runTest({
-            sampleRate: sampleRate,
-            v0: 1,
-            v1: 0,
-            timeConstant: timeConstant,
