-  playbackRate: 1,
-  expected: [0,1,2,3,4,5,6,7,0,1,2,3,4,5,6,7] },
-
-{ description: "loop from middle to end of buffer",
-  loopStartFrame: 4,
-  loopEndFrame: 8,
-  renderFrames: 16,
-  playbackRate: 1,
-  expected: [0,1,2,3,4,5,6,7,4,5,6,7,4,5,6,7] },
-
-{ description: "loop from start to middle of buffer",
