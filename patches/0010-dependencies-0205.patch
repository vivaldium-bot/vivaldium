+  var aLen = argExpA.length;
+  var bLen = argExpB.length;
+  if (aLen !== bLen)
+    return (aLen < bLen);
+
+  // Argument type expression lengths are equal
+  for (var aa = aLen - 1; aa >= 0; --aa) {
+    var argA = argExpA[aa];
+    var argB = argExpB[aa];
