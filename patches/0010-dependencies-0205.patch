+                                  sourceSubRectangle[2], sourceSubRectangle[3], 0,
+                                  gl[pixelFormat], gl[pixelType], imageData);
+                }
+            } else {
+                if (useTexSubImage2D) {
+                    // Initialize the texture to black first
