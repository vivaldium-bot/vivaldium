+            finishTest();
+        };
+        newImage.src = imgCanvas.toDataURL();
+    }
+
+    function runTest2(image) {
+        runTestOnImage(image);
+
+        wtu.makeImageFromCanvas(imgCanvas, function() {
+            runTest3(this);
+        });
+    }
+
+    function runTest3(image) {
+        runTestOnImage(image);
+
+        wtu.glErrorShouldBe(gl, gl.NO_ERROR, "should be no errors");
+        finishTest();
+    }
+
+    return init;
+}
