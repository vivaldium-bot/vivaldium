+        // make triangle coverage and error pixels obvious by converting coverage to grayscale
+        if (c == 0x000000)
+            return 0;
+        else
+            return 50 + Math.floor((((c >> 16) & 0xff) + ((c >> 8) & 0xff) + (c & 0xff)) / 8);
+    };
