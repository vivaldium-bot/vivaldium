diff --git a/third_party/webgl/src/sdk/tests/resources/intArrayUniformShader.vert b/third_party/webgl/src/sdk/tests/resources/intArrayUniformShader.vert
new file mode 100644
index 0000000000000000000000000000000000000000..d82074e4737011e38202a63c4ac966c2310ea00c
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/resources/intArrayUniformShader.vert
@@ -0,0 +1,8 @@
+uniform int ival;
+uniform int ival2[2];
+
+void main()
+{
+    int sum = ival + ival2[0] + ival2[1];
+    gl_Position = vec4(sum, 0.0, 0.0, 1.0);
+}
diff --git a/third_party/webgl/src/sdk/tests/resources/intUniformShader.vert b/third_party/webgl/src/sdk/tests/resources/intUniformShader.vert
