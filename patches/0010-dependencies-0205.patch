+    var gluVarType = framework.opengl.gluVarType;
+    var gluShaderUtil = framework.opengl.gluShaderUtil;
+    var gluShaderProgram = framework.opengl.gluShaderProgram;
+    var gluDrawUtil = framework.opengl.gluDrawUtil;
