+
+                // check for EOL comment
+                if (m_input.charAt(m_curPtr) === '#') {
+                    // if m_input is to be an array of lines then this probably wont work very well
+                    while (
+                        m_curPtr < m_input.length &&
+                        !glsShaderLibrary.isEOL(m_input.charAt(m_curPtr))
+                    ) ++m_curPtr;
+                } else {
