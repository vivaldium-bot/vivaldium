+            TOKEN_EOF: 1,
+            TOKEN_STRING: 2,
+            TOKEN_SHADER_SOURCE: 3,
+
+            TOKEN_INT_LITERAL: 4,
+            TOKEN_FLOAT_LITERAL: 5,
+
+            // identifiers
+            TOKEN_IDENTIFIER: 6,
+            TOKEN_TRUE: 7,
+            TOKEN_FALSE: 8,
+            TOKEN_DESC: 9,
+            TOKEN_EXPECT: 10,
+            TOKEN_GROUP: 11,
