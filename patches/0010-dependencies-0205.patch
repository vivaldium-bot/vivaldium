+functional.gles3.es3fTextureWrapTests.run(gl, [%(start)s, %(end)s]);
+</script>
+</body>
+</html>
+"""
+
+_GROUPS = [
+    'rgba8_pot',
+    'rgba8_npot',
+    'eac_r11_pot',
+    'eac_r11_npot',
+    'eac_signed_r11_pot',
+    'eac_signed_r11_npot',
+    'eac_rg11_pot',
+    'eac_rg11_npot',
+    'eac_signed_rg11_pot',
+    'eac_signed_rg11_npot',
+    'etc2_rgb8_pot',
+    'etc2_rgb8_npot',
+    'etc2_srgb8_pot',
