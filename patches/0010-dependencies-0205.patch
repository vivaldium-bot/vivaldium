+                    /** @type {number} */ var x2 = min + rnd.getInt() % (max - x1);
+
+                    /** @type {number} */ var y1 = min + rnd.getInt() % (max - min);
+                    /** @type {number} */ var y2 = min + rnd.getInt() % (max - y1);
