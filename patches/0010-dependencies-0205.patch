+
+
+// Returns true if two argument expressions are equal
+function areArgExpEqual(expA, expB) {
+  if (expA.length !== expB.length)
+    return false;
+
+  for (var aa = 0; aa < expA.length; ++aa)
+    if (expA[aa] !== expB[aa])
+      return false;
+
+  return true;
