+    shader += 'precision ' + prec + ' float;\n';
+    shader += 'precision ' + prec + ' int;\n';
+    shader += '\n';
+
+    if (customColorOut) {
+        shader += 'layout(location = 0) out mediump vec4 dEQP_FragColor;\n';
+        shader += '\n';
+    }
