index 0000000000000000000000000000000000000000..3a17f09b267643b0b7b77af3cb941ce5c665e15c
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/js/tests/gl-enum-tests.js
@@ -0,0 +1,140 @@
+/*
+** Copyright (c) 2015 The Khronos Group Inc.
+**
