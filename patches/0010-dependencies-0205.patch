+        var height = rnd.getInt(0, FRAMEBUFFER_SIZE);
+        var x = rnd.getInt(0, FRAMEBUFFER_SIZE - width);
+        var y = rnd.getInt(0, FRAMEBUFFER_SIZE - height);
+        var r1 = rnd.getFloat();
+        var g1 = rnd.getFloat();
+        var b1 = rnd.getFloat();
+        var a1 = rnd.getFloat();
