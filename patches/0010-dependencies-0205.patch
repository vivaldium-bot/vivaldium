+        var i = 0;
+        while (str[i] != undefined) {
+            if (str[i]  == '\\') {
+                switch (str[i + 1]) {
+                    case undefined:
+                        break;
+                    case 'n':
+                        result += '\n';
+                        break;
+                    case 't':
+                        result += '\t';
+                        break;
+                    default:
+                        result += str[i + 1];
+                        break;
+                }
+                i += 2;
+            } else {
+                result += str[i];
+                i++;
+            }
+        }
+        return result;
+
+    };
+
+    /**
+     * glsShaderLibrary.Parser class
+     * @constructor
+     */
+    glsShaderLibrary.Parser = function() {
+
+    /* data members */
+
+        /**
+         * The Token constants
+         * @enum {number}
