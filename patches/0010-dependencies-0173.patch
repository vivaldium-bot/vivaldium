+            <div class='square' style='background-color:black'></div>
+            <div class='square'></div>
+        </div>
+        <hr />
+        <div class="pattern">
+            <canvas id='c4'></canvas>
+            <canvas id='c5'></canvas>
+            <canvas id='c6'></canvas>
+        </div>
+        <span>should look like</span>
+        <div class="pattern">
+            <div class='square'></div>
+            <div class='square'></div>
+            <div class='square'></div>
+        </div>
