index 0000000000000000000000000000000000000000..a76addc9942b09b588616deebb781b6dc68af67f
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/select-2.ll
@@ -0,0 +1,18 @@
+; RUN: opt < %s -instcombine -S | grep select | count 2
+
+; Make sure instcombine don't fold select into operands. We don't want to emit
+; select of two integers unless it's selecting 0 / 1.
+
+define i32 @t1(i32 %c, i32 %x) nounwind {
+       %t1 = icmp eq i32 %c, 0
+       %t2 = lshr i32 %x, 18
+       %t3 = select i1 %t1, i32 %t2, i32 %x
+       ret i32 %t3
+}
+
+define i32 @t2(i32 %c, i32 %x) nounwind {
+       %t1 = icmp eq i32 %c, 0
+       %t2 = and i32 %x, 18
+       %t3 = select i1 %t1, i32 %t2, i32 %x
+       ret i32 %t3
+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/select-crash.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/select-crash.ll
