+        ret i1 %C
+}
+
diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/setcc-strength-reduce.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/setcc-strength-reduce.ll
