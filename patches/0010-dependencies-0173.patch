diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/IndVarSimplify/variable-stride-ivs-0.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/IndVarSimplify/variable-stride-ivs-0.ll
