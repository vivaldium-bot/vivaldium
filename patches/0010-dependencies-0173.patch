diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/bitcast-vec-uniform.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/bitcast-vec-uniform.ll
