+                                                const float right,
+                                                const float bottom)
+{
+    CriticalSectionScoped cs(&_renderWindowsCritsect);
+    VideoRenderCallback* renderCallback = NULL;
+
+    if (!_ptrRendererWin)
+    {
+    }
+    else
+    {
+        renderCallback = _ptrRendererWin->CreateChannel(streamId, zOrder, left,
+                                                        top, right, bottom);
+    }
+
+    return renderCallback;
+}
