+
+    CriticalSectionWrapper& _refD3DCritsect;
+    Trace* _trace;
+    // TODO(pbos): Remove unique_ptr and use PlatformThread directly.
+    std::unique_ptr<rtc::PlatformThread> _screenUpdateThread;
+    EventTimerWrapper* _screenUpdateEvent;
+
+    HWND _hWnd;
+    bool _fullScreen;
