+  template <class RandomAccessIter, class right_shift>
+  inline void float_sort(RandomAccessIter first, RandomAccessIter last, right_shift shift) 
+  {
+  	if(last - first < detail::MIN_SORT_SIZE)
+  		std::sort(first, last);
