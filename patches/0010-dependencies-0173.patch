diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-11-08-FCmp.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-11-08-FCmp.ll
