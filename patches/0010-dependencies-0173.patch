+
+namespace webrtc
+{
+
+class VideoRenderOpenGles20 {
+ public:
+  VideoRenderOpenGles20(int32_t id);
+  ~VideoRenderOpenGles20();
+
+  int32_t Setup(int32_t widht, int32_t height);
