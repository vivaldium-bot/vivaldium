diff --git a/third_party/webrtc/pc/audiomonitor.cc b/third_party/webrtc/pc/audiomonitor.cc
new file mode 100644
index 0000000000000000000000000000000000000000..952ee9fbda8fa836e00b351821427ae493700104
--- /dev/null
+++ b/third_party/webrtc/pc/audiomonitor.cc
@@ -0,0 +1,104 @@
+/*
