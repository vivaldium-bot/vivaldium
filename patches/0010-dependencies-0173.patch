+            { flipY: true, premultiplyAlpha: true },
+            { flipY: false, premultiplyAlpha: true },
+        ];
+
+        for (var i in cases) {
+            runOneIteration(cases[i].flipY, cases[i].premultiplyAlpha,
+                            bindingTarget, program);
+        }
+    }
+
+    return init;
+}
