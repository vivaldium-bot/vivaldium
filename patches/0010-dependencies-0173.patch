diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2007-02-01-LoadSinkAlloca.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2007-02-01-LoadSinkAlloca.ll
