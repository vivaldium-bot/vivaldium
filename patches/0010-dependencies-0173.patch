+}
+
+Tests.testDrawArraysOOBShaderJuggle = function(gl, prog, v,n,t) {
+  var vbo = new VBO(gl,
+    {size:3, data:[0,0,0]},
+    {size:3, data:[0,0,0,0,0,0]});
+  vbo.init();
+  gl.bindBuffer(gl.ARRAY_BUFFER, vbo.vbos[0]);
