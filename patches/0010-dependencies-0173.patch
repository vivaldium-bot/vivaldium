diff --git a/third_party/swiftshader/third_party/LLVM/test/Feature/callingconventions.ll b/third_party/swiftshader/third_party/LLVM/test/Feature/callingconventions.ll
new file mode 100644
index 0000000000000000000000000000000000000000..d33b3c4e23ec84fb087fde433ed7879280ae3221
--- /dev/null
