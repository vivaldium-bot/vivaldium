+     "    0.5,",
+     "    0,",
+     "    1);"].join("\n"),
+    "$(output) = vec4(0, $(func)($(input).xy * 2.0 - vec2(1, 1)), 1);",
+    "$(output) = vec4($(func)($(input).xyz * 2.0 - vec3(1, 1, 1)), 1);",
+    "$(output) = $(func)($(input) * 2.0 - vec4(1, 1, 1, 1));"
+  ]
+});
+var successfullyParsed = true;
