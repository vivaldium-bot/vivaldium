+}
+
+void QuicTransportChannel::OnSelectedCandidatePairChanged(
+    TransportChannel* channel,
+    CandidatePairInterface* selected_candidate_pair,
+    int last_sent_packet_id) {
+  ASSERT(channel == channel_);
