+  assertGLError(gl, gl.INVALID_OPERATION, "2",
+      function(){gl.drawArrays(gl.TRIANGLES, 0, 7);});
+  assertGLError(gl, gl.INVALID_OPERATION, "3",
+      function(){gl.drawArrays(gl.TRIANGLES, 1, 6);});
