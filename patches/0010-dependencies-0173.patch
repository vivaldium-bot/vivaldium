+
+    gl.clearColor(1, 0, 1, 1);
+    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+    ctx2d[2].drawImage(canvas, 0, 0, canvas2d[2].width, canvas2d[2].height);
