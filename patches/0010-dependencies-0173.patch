diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstSimplify/2011-09-05-InsertExtractValue.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstSimplify/2011-09-05-InsertExtractValue.ll
