diff --git a/third_party/webrtc/test/linux/glx_renderer.cc b/third_party/webrtc/test/linux/glx_renderer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d6979c8a58f2b9c7308b92c0e50cec0f8502e87e
--- /dev/null
+++ b/third_party/webrtc/test/linux/glx_renderer.cc
@@ -0,0 +1,178 @@
+/*
