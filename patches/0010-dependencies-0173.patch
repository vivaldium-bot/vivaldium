--- /dev/null
+++ b/third_party/webgl/src/conformance-suites/1.0.3/conformance/extensions/oes-texture-float.html
@@ -0,0 +1,291 @@
+<!--
+
+/*
+** Copyright (c) 2012 The Khronos Group Inc.
+**
