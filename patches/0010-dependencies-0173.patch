+            _id,
+            "Creating RTCP socket since no receive or source socket is\
+ configured");
+
+        _ptrRtcpSocket = _socket_creator->CreateSocket(_id, _mgr, this,
+                                         IncomingRTCPCallback,
+                                         IpV6Enabled(), false);
+
+        // Don't bind to a specific IP address.
