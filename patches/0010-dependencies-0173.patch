diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-06-19-UncondLoad.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-06-19-UncondLoad.ll
