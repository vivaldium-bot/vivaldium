diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2011-05-13-InBoundsGEP.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2011-05-13-InBoundsGEP.ll
