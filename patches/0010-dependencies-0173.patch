diff --git a/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-01-14-DoubleNest.ll b/third_party/swiftshader/third_party/LLVM/test/Transforms/InstCombine/2008-01-14-DoubleNest.ll
