+} \
+TEST_F(YuvScalerTest, name##OptSSE2) { \
+  double error; \
+  EXPECT_TRUE(TestScale(iwidth, iheight, owidth, oheight, \
+                        0, true, true, NOSSSE3, false, 0, &error)); \
+  EXPECT_LE(error, mse); \
