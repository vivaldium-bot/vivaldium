-  top: 72px;
-
-  /*
-
-    16px : max(body's margin-top, p's margin-top) == max(8px, 16px)
-  +
-    20px : p's first line box height
-  +
-    20px : p's second line box height
-  +
-    16px : p's margin-bottom
-  ========
-    72px
-
-  */
-  }
-  ]]></style>
-
- </head>
