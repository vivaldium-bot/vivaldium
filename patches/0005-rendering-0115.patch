-<foo id="2147483646"></foo> <!--  2^31 - 2  -->
-<foo id="2147483647"></foo> <!--  2^31 - 1  -->
-<foo id="2147483648"></foo> <!--  2^31  -->
-<foo id="2147483649"></foo> <!--  2^31 + 1  -->
-
