+const struct rsa_meth_st RSA_default_method = {
+  {
+    0 /* references */,
+    1 /* is_static */,
+  },
+  NULL /* app_data */,
+
+  NULL /* init */,
+  finish,
+
+  size,
+
+  NULL /* sign */,
+  NULL /* verify */,
+
+  encrypt,
+  sign_raw,
+  decrypt,
+  verify_raw,
+
+  private_transform,
+
+  mod_exp /* mod_exp */,
+  BN_mod_exp_mont /* bn_mod_exp */,
+
+  RSA_FLAG_CACHE_PUBLIC | RSA_FLAG_CACHE_PRIVATE,
+
+  keygen,
+  keygen_multiprime,
+};
