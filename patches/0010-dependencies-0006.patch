+    fprintf(stderr, "Serialisation is not stable.\n");
+    return 0;
+  }
+
+  OPENSSL_free(result_data);
+  OPENSSL_free(result2_data);
+  sk_X509_CRL_pop_free(crls, X509_CRL_free);
+  sk_X509_CRL_pop_free(crls2, X509_CRL_free);
+
+  return 1;
+}
