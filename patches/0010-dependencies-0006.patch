+#if defined(BORINGSSL_NO_STATIC_INITIALIZER)
+  do_library_init();
+#endif
+}
+
+const char *SSLeay_version(int unused) {
+  return "BoringSSL";
+}
+
+unsigned long SSLeay(void) {
+  return OPENSSL_VERSION_NUMBER;
+}
