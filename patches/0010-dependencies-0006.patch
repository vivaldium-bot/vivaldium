+
+    uint8_t prk[EVP_MAX_MD_SIZE];
+    size_t prk_len;
+    ASSERT_TRUE(HKDF_extract(prk, &prk_len, test->md_func(), test->ikm,
+                             test->ikm_len, test->salt, test->salt_len));
