index 0000000000000000000000000000000000000000..0f2560b7156396e6ddc005f2013c475c15590b32
--- /dev/null
+++ b/third_party/boringssl/src/include/openssl/asn1t.h
@@ -0,0 +1,907 @@
+/* asn1t.h */
+/* Written by Dr Stephen N Henson (steve@openssl.org) for the OpenSSL
+ * project 2000.
+ */
+/* ====================================================================
+ * Copyright (c) 2000-2005 The OpenSSL Project.  All rights reserved.
+ *
