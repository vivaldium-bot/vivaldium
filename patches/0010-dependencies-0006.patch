+typedef struct ssl3_buffer_st {
+  uint8_t *buf;       /* at least SSL3_RT_MAX_PACKET_SIZE bytes, see
+                         ssl3_setup_buffers() */
+  size_t len;         /* buffer size */
+  int offset;         /* where to 'copy from' */
+  int left;           /* how many bytes left */
