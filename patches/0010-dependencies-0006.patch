new file mode 100644
index 0000000000000000000000000000000000000000..79139e60cb3cd7f8ca657eb20360582833f4eedf
--- /dev/null
+++ b/third_party/boringssl/src/crypto/fipsmodule/cipher/aead.c
@@ -0,0 +1,266 @@
+/* Copyright (c) 2014, Google Inc.
