+#define l2n8(l, c)                           \
+  (*((c)++) = (uint8_t)(((l) >> 56) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 48) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 40) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 32) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 24) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 16) & 0xff), \
+   *((c)++) = (uint8_t)(((l) >> 8) & 0xff),  \
