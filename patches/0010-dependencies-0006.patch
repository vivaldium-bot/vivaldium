+#define n2s(c, s) \
+  ((s = (((unsigned int)(c[0])) << 8) | (((unsigned int)(c[1])))), c += 2)
+
+#define s2n(s, c)                              \
+  ((c[0] = (uint8_t)(((s) >> 8) & 0xff), \
+    c[1] = (uint8_t)(((s)) & 0xff)),     \
