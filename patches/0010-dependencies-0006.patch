+/* To preserve endianness when using BN_bn2bin and BN_bin2bn */
+static void p224_flip_endian(uint8_t *out, const uint8_t *in, size_t len) {
+  for (size_t i = 0; i < len; ++i) {
+    out[i] = in[len - 1 - i];
+  }
+}
