+void SHA512_Transform(SHA512_CTX *c, const uint8_t *data) {
+#ifndef SHA512_BLOCK_CAN_MANAGE_UNALIGNED_DATA
+  if ((size_t)data % sizeof(c->u.d[0]) != 0) {
+    memcpy(c->u.p, data, sizeof(c->u.p));
