+    return NULL;
+  }
+
+  if (s->cipher_list_by_id != NULL) {
+    return s->cipher_list_by_id;
+  }
+
+  if (s->ctx != NULL && s->ctx->cipher_list_by_id != NULL) {
+    return s->ctx->cipher_list_by_id;
+  }
+
+  return NULL;
+}
