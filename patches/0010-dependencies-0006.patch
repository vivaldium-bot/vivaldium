+  const EVP_CIPHER *EVP_aes_##keybits##_##mode(void) { \
+    if (aesni_capable()) {                             \
+      return aesni_##keybits##_##mode();               \
+    } else {                                           \
+      return aes_##keybits##_##mode##_generic();       \
+    }                                                  \
