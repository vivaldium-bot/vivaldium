--- /dev/null
+++ b/third_party/boringssl/src/crypto/x509v3/v3_conf.c
@@ -0,0 +1,462 @@
+/* v3_conf.c */
+/*
+ * Written by Dr Stephen N Henson (steve@openssl.org) for the OpenSSL project
+ * 1999.
