+      HOST_c2l(data, l);
+      T1 = X[11] = l;
+      ROUND_00_15(11, f, g, h, a, b, c, d, e);
+      HOST_c2l(data, l);
+      T1 = X[12] = l;
+      ROUND_00_15(12, e, f, g, h, a, b, c, d);
+      HOST_c2l(data, l);
