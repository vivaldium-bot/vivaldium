+const char *SSL_get_cipher_list(const SSL *ssl, int n) {
+  const SSL_CIPHER *c;
+  STACK_OF(SSL_CIPHER) *sk;
+
+  if (ssl == NULL) {
+    return NULL;
+  }
+
+  sk = SSL_get_ciphers(ssl);
+  if (sk == NULL || n < 0 || (size_t)n >= sk_SSL_CIPHER_num(sk)) {
+    return NULL;
+  }
+
+  c = sk_SSL_CIPHER_value(sk, n);
+  if (c == NULL) {
+    return NULL;
+  }
+
+  return c->name;
+}
