+  /* Used to cache montgomery values. The creation of these values is protected
+   * by |lock|. */
+  BN_MONT_CTX *_method_mod_n;
+  BN_MONT_CTX *_method_mod_p;
+  BN_MONT_CTX *_method_mod_q;
