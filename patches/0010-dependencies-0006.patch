+# asm 1: vst1.8 <x4=reg128#3%bot,[<input_0=int32#1,: 64]
+# asm 2: vst1.8 <x4=d4,[<input_0=r0,: 64]
+vst1.8 d4,[r0,: 64]
+
+# qhasm: return
+add sp,sp,#0
+bx lr
+
+#endif  /* __arm__ && !OPENSSL_NO_ASM && !__APPLE__ */
diff --git a/third_party/boringssl/src/crypto/poly1305/poly1305_test.cc b/third_party/boringssl/src/crypto/poly1305/poly1305_test.cc
