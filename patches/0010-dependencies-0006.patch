+/* NOTE - c is not incremented as per l2c */
+#define l2cn(l1, l2, c, n)                               \
+  {                                                      \
+    c += n;                                              \
+    switch (n) {                                         \
+      case 8:                                            \
+        *(--(c)) = (uint8_t)(((l2) >> 24) & 0xff); \
+      case 7:                                            \
+        *(--(c)) = (uint8_t)(((l2) >> 16) & 0xff); \
+      case 6:                                            \
+        *(--(c)) = (uint8_t)(((l2) >> 8) & 0xff);  \
+      case 5:                                            \
+        *(--(c)) = (uint8_t)(((l2)) & 0xff);       \
+      case 4:                                            \
+        *(--(c)) = (uint8_t)(((l1) >> 24) & 0xff); \
+      case 3:                                            \
+        *(--(c)) = (uint8_t)(((l1) >> 16) & 0xff); \
+      case 2:                                            \
+        *(--(c)) = (uint8_t)(((l1) >> 8) & 0xff);  \
+      case 1:                                            \
+        *(--(c)) = (uint8_t)(((l1)) & 0xff);       \
+    }                                                    \
+  }
