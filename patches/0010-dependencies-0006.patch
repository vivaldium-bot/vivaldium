+          for (i = 0; i < 8; ++i) {
+            ovec[i] <<= num % 8;
+            ovec[i] |= ovec[i + 1] >> (8 - num % 8);
+          }
+        }
+        iv = &ovec[0];
+        c2l(iv, v0);
+        c2l(iv, v1);
+      }
+    }
