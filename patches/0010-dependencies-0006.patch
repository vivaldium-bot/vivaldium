+  size_t sniff_buffer_len;
+
+  SSL3_BUFFER rbuf; /* read IO goes into here */
+  SSL3_BUFFER wbuf; /* write IO goes into here */
+
+  SSL3_RECORD rrec; /* each decoded record goes in here */
+
