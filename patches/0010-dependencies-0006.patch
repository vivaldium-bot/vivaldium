+
+  if (ssl->handshake_func != ssl->method->ssl_connect) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return -1;
+  }
+
+  return ssl->handshake_func(ssl);
