+/* NOTE - c is not incremented as per n2l */
+#define n2ln(c, l1, l2, n)                       \
+  {                                              \
+    c += n;                                      \
+    l1 = l2 = 0;                                 \
+    switch (n) {                                 \
+      case 8:                                    \
+        l2 = ((unsigned long)(*(--(c))));        \
+      case 7:                                    \
+        l2 |= ((unsigned long)(*(--(c)))) << 8;  \
+      case 6:                                    \
+        l2 |= ((unsigned long)(*(--(c)))) << 16; \
+      case 5:                                    \
+        l2 |= ((unsigned long)(*(--(c)))) << 24; \
+      case 4:                                    \
+        l1 = ((unsigned long)(*(--(c))));        \
+      case 3:                                    \
+        l1 |= ((unsigned long)(*(--(c)))) << 8;  \
+      case 2:                                    \
+        l1 |= ((unsigned long)(*(--(c)))) << 16; \
+      case 1:                                    \
+        l1 |= ((unsigned long)(*(--(c)))) << 24; \
+    }                                            \
+  }
