+#include <openssl/rsa.h>
+
+#include <assert.h>
+
+#include <openssl/bn.h>
+
+
+RSA *RSA_generate_key(int bits, unsigned long e_value, void *callback,
+                      void *cb_arg) {
+  assert(callback == NULL);
+  assert(cb_arg == NULL);
+
+  RSA *rsa = RSA_new();
+  BIGNUM *e = BN_new();
+
+  if (rsa == NULL ||
+      e == NULL ||
+      !BN_set_word(e, e_value) ||
+      !RSA_generate_key_ex(rsa, bits, e, NULL)) {
+    goto err;
+  }
+
+  BN_free(e);
+  return rsa;
+
+err:
+  BN_free(e);
+  RSA_free(rsa);
+  return NULL;
+}
