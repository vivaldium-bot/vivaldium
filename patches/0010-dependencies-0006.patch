+static int Main() {
+  CRYPTO_library_init();
+
+  if (!TestVerify() ||
+      !TestCRL() ||
+      !TestPSS() ||
+      !TestBadPSSParameters() ||
+      !TestSignCtx()) {
+    return 1;
+  }
+
+  printf("PASS\n");
+  return 0;
+}
+
+}  // namespace bssl
+
+int main() {
+  return bssl::Main();
+}
