+  int (*private_transform)(RSA *rsa, uint8_t *out, const uint8_t *in,
+                           size_t len);
+
+  int (*mod_exp)(BIGNUM *r0, const BIGNUM *I, RSA *rsa,
+                 BN_CTX *ctx); /* Can be null */
+  int (*bn_mod_exp)(BIGNUM *r, const BIGNUM *a, const BIGNUM *p,
