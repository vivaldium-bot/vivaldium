+  ASSERT_TRUE(BN_mod_exp_mont_consttime(r.get(), a.get(), zero.get(),
+                                        BN_value_one(), nullptr, nullptr));
+  EXPECT_TRUE(BN_is_zero(r.get()));
+
+  ASSERT_TRUE(BN_mod_exp_mont_word(r.get(), 42, zero.get(), BN_value_one(),
+                                   nullptr, nullptr));
+  EXPECT_TRUE(BN_is_zero(r.get()));
+}
