+
+#define n2l3(c, l)                                                         \
+  ((l = (((unsigned long)(c[0])) << 16) | (((unsigned long)(c[1])) << 8) | \
+        (((unsigned long)(c[2])))),                                        \
+   c += 3)
+
+#define l2n3(l, c)                              \
+  ((c[0] = (uint8_t)(((l) >> 16) & 0xff), \
+    c[1] = (uint8_t)(((l) >> 8) & 0xff),  \
+    c[2] = (uint8_t)(((l)) & 0xff)),      \
