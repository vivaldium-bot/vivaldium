-    // sensitive (e.g. font-family) by section 4.1.3 of the CSS 2.1 spec <http://www.w3.org/TR/CSS21/syndata.html#characters>.
-    var cssTextLowerCase = cssText.toLowerCase();
-    var propertyName = propertyName.toLowerCase();
