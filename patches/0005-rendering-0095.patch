-
-        assert_equals(idp, idpDomain,
-          `Expect IdP domain to be ${idpDomain}`);
-
-        assert_equals(name, `alice@${idpDomain}`,
-          `Expect validated identity to be alice@${idpDomain}`);
-
-        assert_equals(pc2.peeridentity, peerIdentityPromise2,
