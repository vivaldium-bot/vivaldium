-    return true;
-  } else if(
-    countAudioLine(sdp1) !== countAudioLine(sdp2) ||
-    countVideoLine(sdp1) !== countVideoLine(sdp2) ||
-    countApplicationLine(sdp1) !== countApplicationLine(sdp2))
-  {
-    return false;
