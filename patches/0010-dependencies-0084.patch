index 0000000000000000000000000000000000000000..58cc3c85ba89d5907095b9d103c9dacb6bc32687
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aasc.c
@@ -0,0 +1,163 @@
+/*
+ * Autodesk RLE Decoder
+ * Copyright (C) 2005 The FFmpeg project
+ *
