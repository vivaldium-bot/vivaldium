index 0000000000000000000000000000000000000000..86054b2483ac628464f034c35eb5adf727b95db1
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_bbox.c
@@ -0,0 +1,134 @@
+/*
