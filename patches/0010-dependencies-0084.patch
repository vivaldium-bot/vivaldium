--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/imdct36.asm
@@ -0,0 +1,742 @@
+;******************************************************************************
+;* 36 point SSE-optimized IMDCT transform
+;* Copyright (c) 2011 Vitor Sessak
+;*
