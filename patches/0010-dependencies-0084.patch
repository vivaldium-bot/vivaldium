index 0000000000000000000000000000000000000000..581471ba02dbac4e473590413d359272c35a0367
--- /dev/null
+++ b/third_party/grpc/src/core/ext/transport/chttp2/transport/hpack_encoder.c
@@ -0,0 +1,581 @@
