index 0000000000000000000000000000000000000000..95a1d6ecfa6204246cf4f150cb66d1fc59b01187
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/pulse_audio_dec.c
@@ -0,0 +1,376 @@
+/*
