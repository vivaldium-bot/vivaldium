index 0000000000000000000000000000000000000000..04a9be9fcb2ceb0c2ddfd73f130027b21b871343
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/audiotoolboxdec.c
@@ -0,0 +1,630 @@
