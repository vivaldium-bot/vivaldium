index 0000000000000000000000000000000000000000..24146ff1df0068f5b46a46b0305969b1340fc0f9
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_stereowiden.c
@@ -0,0 +1,162 @@
