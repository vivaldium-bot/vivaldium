index 0000000000000000000000000000000000000000..3fae38c12aa6f3ca0a9013670d38e0a99ef912f2
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/colorspacedsp_yuv2yuv_template.c
@@ -0,0 +1,98 @@
+/*
+ * Copyright (c) 2016 Ronald S. Bultje <rsbultje@gmail.com>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
