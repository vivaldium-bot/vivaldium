+/**
+ * @file
+ * AAC encoder psychoacoustic model
+ */
+
+#include "libavutil/attributes.h"
+#include "libavutil/ffmath.h"
+
+#include "avcodec.h"
+#include "aactab.h"
+#include "psymodel.h"
