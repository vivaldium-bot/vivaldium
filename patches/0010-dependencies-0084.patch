+++ b/third_party/ffmpeg/libavcodec/atrac1data.h
@@ -0,0 +1,64 @@
+/*
+ * ATRAC 1 compatible decoder data
+ * Copyright (c) 2009 Maxim Poliakovski
+ * Copyright (c) 2009 Benjamin Larsson
+ *
+ * This file is part of FFmpeg.
+ *
