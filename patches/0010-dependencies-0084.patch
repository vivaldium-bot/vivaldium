index 0000000000000000000000000000000000000000..7df841b8063891fe2ddc9cfce192f9026cc2b518
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/decklink_dec.cpp
@@ -0,0 +1,659 @@
+/*
+ * Blackmagic DeckLink input
+ * Copyright (c) 2013-2014 Luca Barbato, Deti Fliegl
+ *
+ * This file is part of FFmpeg.
+ *
