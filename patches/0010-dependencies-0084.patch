index 0000000000000000000000000000000000000000..cdd8a5885c1f01cee433494fe1d462473e8c2680
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/af_channelmap.c
@@ -0,0 +1,427 @@
+/*
