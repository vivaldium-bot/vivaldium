+#define AMRWB_P_DELAY_MAX   231               ///< maximum pitch delay value
+#define AMRWB_P_DELAY_MIN   34
+
+/* Relative mode ordering is sensitive */
+enum Mode {
+    MODE_6k60 = 0,                         ///< 6.60 kbit/s
+    MODE_8k85,                             ///< 8.85 kbit/s
+    MODE_12k65,                            ///< 12.65 kbit/s
