diff --git a/third_party/ffmpeg/libavcodec/x86/idctdsp_init.c b/third_party/ffmpeg/libavcodec/x86/idctdsp_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..bcf7e5be0e2266bdf7832b9d0e1bf5525091be8a
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/idctdsp_init.c
@@ -0,0 +1,126 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
