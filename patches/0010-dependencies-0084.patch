index 0000000000000000000000000000000000000000..b4ceee340e904d80109bbaa90baf478471950ae8
--- /dev/null
+++ b/third_party/grpc/src/core/ext/resolver/dns/native/dns_resolver.c
@@ -0,0 +1,304 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
