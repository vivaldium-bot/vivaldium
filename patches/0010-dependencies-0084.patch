diff --git a/third_party/ffmpeg/libavfilter/vf_gblur.c b/third_party/ffmpeg/libavfilter/vf_gblur.c
new file mode 100644
index 0000000000000000000000000000000000000000..f843e3f376fd89f3f2dc920d9926100b4c27c123
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_gblur.c
@@ -0,0 +1,367 @@
+/*
+ * Copyright (c) 2011 Pascal Getreuer
+ * Copyright (c) 2016 Paul B Mahol
+ *
+ * Redistribution and use in source and binary forms, with or without modification,
+ * are permitted provided that the following conditions are met:
