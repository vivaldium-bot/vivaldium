index 0000000000000000000000000000000000000000..587415175b562d7e87389bf4dca151245495db1d
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/avf_ahistogram.c
@@ -0,0 +1,413 @@
+/*
