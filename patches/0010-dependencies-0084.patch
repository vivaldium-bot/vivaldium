diff --git a/third_party/ffmpeg/libavcodec/aarch64/synth_filter_neon.S b/third_party/ffmpeg/libavcodec/aarch64/synth_filter_neon.S
new file mode 100644
index 0000000000000000000000000000000000000000..65551cbff75ca4fdc2f695e218bf780ff244e6aa
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/aarch64/synth_filter_neon.S
@@ -0,0 +1,119 @@
+/*
+ * Copyright (c) 2010 Mans Rullgard <mans@mansr.com>
+ * Copyright (c) 2015 Janne Grunau <janne-libav@jannau.net>
+ *
