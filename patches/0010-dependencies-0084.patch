--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/x86/lpc.c
@@ -0,0 +1,162 @@
+/*
+ * SIMD-optimized LPC functions
+ * Copyright (c) 2007 Loren Merritt
+ *
