index 0000000000000000000000000000000000000000..3dabf13b1003b3cf285f85c50475908836e0cac0
--- /dev/null
+++ b/third_party/ffmpeg/doc/examples/filtering_video.c
@@ -0,0 +1,280 @@
+/*
