diff --git a/third_party/ffmpeg/libavfilter/ebur128.c b/third_party/ffmpeg/libavfilter/ebur128.c
new file mode 100644
index 0000000000000000000000000000000000000000..e11008078d7f0d55a0776f57c584fbfb34c59c93
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/ebur128.c
@@ -0,0 +1,769 @@
