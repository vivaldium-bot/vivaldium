new file mode 100644
index 0000000000000000000000000000000000000000..185de7569e10a348493be2c922aeb5d796016cf8
--- /dev/null
+++ b/third_party/ffmpeg/libavdevice/xv.c
@@ -0,0 +1,386 @@
