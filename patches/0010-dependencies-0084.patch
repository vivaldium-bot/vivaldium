+};
+
+typedef struct FoSection {
+    double a0, a1, a2, a3, a4;
+    double b0, b1, b2, b3, b4;
+
+    double num[4];
+    double denum[4];
+} FoSection;
+
+typedef struct EqualizatorFilter {
+    int ignore;
+    int channel;
+    int type;
+
+    double freq;
