index 0000000000000000000000000000000000000000..3986347ee2e9116d4f6fff71e2f8c1d916c7b725
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/alsdec.c
@@ -0,0 +1,2151 @@
+/*
+ * MPEG-4 ALS decoder
+ * Copyright (c) 2009 Thilo Borgmann <thilo.borgmann _at_ mail.de>
