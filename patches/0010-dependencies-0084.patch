index 0000000000000000000000000000000000000000..3d4a83d9acacc61cb265dd85097aa44e23027276
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/arm/rv34dsp_neon.S
@@ -0,0 +1,156 @@
+/*
