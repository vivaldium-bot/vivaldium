+"            *kernel = 0;\n" +
+"            *user = 0;\n" +
+"            return FALSE;\n" +
+"        }\n" +
+"        *kernel = (CHUNK_SIZE_T) (kernel64 / 10000);\n" +
+"        *user = (CHUNK_SIZE_T) (user64 / 10000);\n" +
+"        return TRUE;\n" +
+"    } else {\n" +
+"        __int64 creation64, exit64, kernel64, user64;\n" +
+"        int rc = GetThreadTimes (GetCurrentThread (),\n" +
