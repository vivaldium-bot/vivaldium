+"        g_pagesize = getpagesize ();\n" +
+"    if (! g_regionsize)\n" +
+"        g_regionsize = getregionsize ();\n" +
+"    /* Assert preconditions */\n" +
+"    assert ((unsigned) ptr % g_regionsize == 0);\n" +
+"    assert (size % g_pagesize == 0);\n" +
