-class Serializer {
-  /**
-   * @public
-   * @param {!SampleSelection} selection
-   * @param {!Traversal} traversal
-   */
-  constructor(selection, traversal) {
-    /** @type {!SampleSelection} */
-    this.selection_ = selection;
-    /** @type {!Array<string>} */
