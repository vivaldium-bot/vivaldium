+
+function greater_equal_num_strong(x, y) {
+  "use strong";
+  return x >= y;
+}
+
+function typed_add_strong(x, y) {
+  "use strong";
+  return (+x) + (+y);
+}
+
+function typed_sub_strong(x, y) {
+  "use strong";
+  return (+x) - (+y);
+}
+
+function typed_mul_strong(x, y) {
+  "use strong";
+  return (+x) * (+y);
+}
+
+function typed_div_strong(x, y) {
+  "use strong";
+  return (+x) / (+y);
+}
+
+function typed_mod_strong(x, y) {
