+    WebAXTextStyleUnderline = 1 << 2,
+    WebAXTextStyleLineThrough = 1 << 3
+};
+
+// The source of the accessible name of an element. This is needed
+// because on some platforms this determines how the accessible name
+// is exposed.
+enum WebAXNameFrom {
