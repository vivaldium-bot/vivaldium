+static i::Smi* EncodeAlignedAsSmi(void* value, const char* location) {
+  i::Smi* smi = reinterpret_cast<i::Smi*>(value);
+  Utils::ApiCheck(smi->IsSmi(), location, "Pointer is not aligned");
+  return smi;
+}
