+Local<TypeSwitch> TypeSwitch::New(int argc, Local<FunctionTemplate> types[]) {
+  i::Isolate* isolate = i::Isolate::Current();
+  LOG_API(isolate, "TypeSwitch::New");
+  ENTER_V8(isolate);
