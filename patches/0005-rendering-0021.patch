+          }],
+          ['OS == "win"', {
+            'msvs_settings': {
+              'VCCLCompilerTool': {
+                'WarnAsError': 'false',
+              },
+            },
+          }],
+        ],
+      }],
+    ],
+  },
+  'conditions': [
+    ['os_posix==1 and OS!="mac"', {
+      'target_defaults': {
+        'conditions': [
+          # Common options for AddressSanitizer, LeakSanitizer,
