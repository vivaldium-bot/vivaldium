+	GYP_DEFINES="${DEFINES}" \
+	PYTHONPATH="$(shell pwd)/tools/generate_shim_headers:$(shell pwd)/build:$(PYTHONPATH)" \
+	build/gyp/gyp --generator-output="${OUTDIR}" build/all.gyp \
