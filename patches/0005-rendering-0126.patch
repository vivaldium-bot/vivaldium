-        if (deleteKeys.indexOf(key) !== -1)
-            return undefined;
-        return value;
-    }
-    if (!msg.result || !msg.result.nodes || msg.result.nodes.length !== 1) {
-        InspectorTest.log("Expected exactly one node in " + JSON.stringify(msg, null, "  "));
-        return;
-    }
