-        background-color: gray;
-        margin: 10px;
-      }
-
-      .group > * > * { display: block; }
-      .group > *:nth-child(1) > * { width:100%; height:100%; }
-      .group > *:nth-child(2) > * { width:100%; margin-top:15px; }
