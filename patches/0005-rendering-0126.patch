-  codeunits.forEach(function(codeunit) {
-    rv.push(b('11100000') + ((codeunit & b('1111000000000000')) >> 12));
-    rv.push(b('10000000') + ((codeunit & b('0000111111000000')) >> 6));
-    rv.push(b('10000000') +  (codeunit & b('0000000000111111')));
-  });
-  return rv;
-}
