-        }
-        return string;
-    }
-
-    var rawMsg = JSON.stringify(msg, null, "  ");
-    var nodeMap = {};
-    if ("result" in msg && "nodes" in msg.result) {
-        for (var node of msg.result.nodes)
-            nodeMap[node.nodeId] = node;
-    }
-    for (var nodeId in nodeMap) {
-        var node = nodeMap[nodeId];
-        if (node.childIds) {
-            node.children = [];
