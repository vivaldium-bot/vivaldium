-            // no way to make the seek slower, making this test inherently racy.
-            t.done();
-        } else {
-            a.onseeked = t.step_func(function(e)
-            {
-                assert_greater_than(e.target.currentTime, 0);
-                assert_equals(e.target.foo, "bar");
-                t.done();
-            });
-            a = null;
-            gc();
-        }
-    }
-});
