+
+    <!-- Inmarsat Global Limited -->
+    <territory id="001" countryCode="870">
+      <references>
+        <sourceUrl>http://www.itu.int/oth/T0202000065/en</sourceUrl>
+        <sourceUrl>http://www.inmarsat.com</sourceUrl>
