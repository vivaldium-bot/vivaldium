-        test(function() {
-            assert_false(CSS.supports('font-variation-settings', invalidValue));
-        }, 'Value ' + invalidValue + ' invalid for property font-variation-settings');
-    }
-}
-
-window.addEventListener('load', function() {
-    validWriteTests();
-    invalidWriteTests();
-    styleAndComputedStyleReadback();
-    testInheritance();
-    done();
-});
