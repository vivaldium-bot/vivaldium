+
+    if PY3: # pragma: no cover
+        values = itervalues
+    else:
+        def values(self):
+            return [v for k, v in self._items]
+
+_dummy = object()
+
+class GetDict(MultiDict):
+#     def __init__(self, data, tracker, encoding, errors):
+#         d = lambda b: b.decode(encoding, errors)
