+        info = json.loads(json_data)
+        missing_keys = cls._REQUIRED_SERIALIZATION_KEYS - set(info.keys())
+        if missing_keys:
+            raise exceptions.InvalidDataError(
+                'Invalid serialization data, missing keys: %s' % (
+                    ', '.join(missing_keys)))
