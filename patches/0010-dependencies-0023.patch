+        jek = jwe.encrypted_key()
+
+        _decrypt = RSAEncrypter(self.with_digest).decrypt
+
+        _alg = jwe.headers["alg"]
+        if _alg == "RSA-OAEP":
+            cek = _decrypt(jek, key, 'pkcs1_oaep_padding')
+        elif _alg == "RSA1_5":
+            cek = _decrypt(jek, key)
+        else:
