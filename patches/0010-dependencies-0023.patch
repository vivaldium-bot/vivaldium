+
+/**
+ * Wire Variants.
+ * @type {ProtoRpc.Enum}
+ */
+ProtoRpc.Variant = new ProtoRpc.Enum({
+  1: 'DOUBLE',
+  2: 'FLOAT',
+  3: 'INT64',
+  4: 'UINT64',
+  5: 'INT32',
+  8: 'BOOL',
+  9: 'STRING',
+  11: 'MESSAGE',
+  12: 'BYTES',
+  13: 'UINT32',
+  14: 'ENUM',
+  17: 'SINT32',
+  18: 'SINT64'
+});
