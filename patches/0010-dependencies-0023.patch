+        _res = {}
+        for kty, k in [(k.kty, k) for k in self._keys]:
+            if kty not in ["RSA", "EC", "oct"]:
+                if kty in ["rsa", "ec"]:
+                    kty = kty.upper()
+                else:
+                    kty = kty.lower()
+
+            try:
+                _res[kty].append(k)
+            except KeyError:
+                _res[kty] = [k]
+        return _res
+
+    def add(self, item, enc="utf-8"):
+        self._keys.append(keyrep(item, enc))
