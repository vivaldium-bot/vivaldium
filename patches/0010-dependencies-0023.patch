+ */
+ProtoRpc.EnumValue = function(name, number) {
+  /**
+   * @type {string}
+   * @private
+   */
+  this.name_ = name;
+
+  /**
+   * @type {Number}
+   * @private
+   */
+  this.number_ = number;
+};
