+        return False
+
+    has_key = __contains__
+
+    def setdefault(self, key, default=None):
+        c_key = key.lower()
+        for k, v in self._items:
+            if k.lower() == c_key:
+                return v
+        self._items.append((key, default))
+        return default
+
