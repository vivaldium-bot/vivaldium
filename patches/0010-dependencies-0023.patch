+class ResponseHeaders(MultiDict):
+    """
+        Dictionary view on the response headerlist.
+        Keys are normalized for case and whitespace.
+    """
+    def __getitem__(self, key):
+        key = key.lower()
+        for k, v in reversed(self._items):
+            if k.lower() == key:
+                return v
+        raise KeyError(key)
