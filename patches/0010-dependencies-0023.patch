+                         json.loads(encoding.MessageToJson(message)))
+
+        empty_json = ''
+        message = encoding.JsonToMessage(MessageWithEnum, empty_json)
+        self.assertEqual(None, message.field_one)
+
+    def testIgnoredEnumsWithDefaults(self):
