+
+    def iterkeys(self):
+        return iter([])
+
+    if PY3: # pragma: no cover
+        keys = iterkeys
+        items = iterkeys
+        values = iterkeys
+    else:
+        def keys(self):
+            return []
+        items = keys
+        values = keys
+        itervalues = iterkeys
+        iteritems = iterkeys
+
+    __iter__ = iterkeys
+
+def _hide_passwd(items):
+    for k, v in items:
+        if ('password' in k
+            or 'passwd' in k
+            or 'pwd' in k
+        ):
+            yield k, '******'
+        else:
+            yield k, v
