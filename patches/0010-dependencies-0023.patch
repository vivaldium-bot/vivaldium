+    ## All the iteration:
+    ##
+
+    def iterkeys(self):
+        for k, v in self._items:
+            yield k
+    if PY3: # pragma: no cover
+        keys = iterkeys
+    else:
+        def keys(self):
+            return [k for k, v in self._items]
+
+    __iter__ = iterkeys
+
+    def iteritems(self):
+        return iter(self._items)
+
+    if PY3: # pragma: no cover
