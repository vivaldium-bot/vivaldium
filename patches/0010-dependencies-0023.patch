+    var value = this.values_[field.getNumber()];
+    for (var j = 0; j < value.length; j++) {
+      value[j].checkInitialized();
+    }
+
+    if (field.getVariant() == ProtoRpc.Variant.MESSAGE) {
+      this.getValue(field.getNumber()).checkInitialized();
+    }
+
+  }
+};
