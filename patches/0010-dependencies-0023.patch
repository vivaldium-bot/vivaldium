+  def testConvertStringToNumbers(self):
+    """Test that strings passed to integer fields are converted."""
+    message = protojson.decode_message(MyMessage,
+                                       """{"an_integer": "10",
+                                           "a_float": "3.5",
+                                           "a_repeated": ["1", "2"],
+                                           "a_repeated_float": ["1.5", "2", 10]
+                                           }""")
