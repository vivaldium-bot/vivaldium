+        # Get the numbers for this file.
+        nums = analysis.numbers
+
+        if self.has_arcs:
+            missing_branch_arcs = analysis.missing_branch_arcs()
+
+        # These classes determine which lines are highlighted by default.
+        c_run = "run hide_run"
+        c_exc = "exc"
+        c_mis = "mis"
+        c_par = "par " + c_run
