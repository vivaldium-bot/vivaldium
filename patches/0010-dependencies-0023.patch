+            'progress': self.progress,
+            'total_size': self.total_size,
+            'url': self.url,
+        }
+
+    @property
+    def total_size(self):
+        return self.__total_size
+
+    def __str__(self):
+        if not self.initialized:
+            return 'Download (uninitialized)'
