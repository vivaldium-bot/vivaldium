+        """
+        url = self.url
+        host = self.host_url
+        assert url.startswith(host)
+        url = url[len(host):]
+        parts = [bytes_('%s %s %s' % (self.method, url, self.http_version))]
+        #self.headers.setdefault('Host', self.host)
