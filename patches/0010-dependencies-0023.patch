+
+# MANIFEST.in file for coverage.py
+
+include AUTHORS.txt
+include CHANGES.rst
+include LICENSE.txt
+include MANIFEST.in
+include Makefile
+include NOTICE.txt
+include README.rst
+include TODO.txt
+include __main__.py
+include .travis.yml
+include appveyor.yml
+include circle.yml
+include howto.txt
+include igor.py
+include metacov.ini
+include pylintrc
