+        return self.dump_jwks()
+
+    def __str__(self):
+        return self.__repr__()
+
+    def kids(self):
+        return [k.kid for k in self._keys if k.kid]
+
+    def by_kid(self, kid):
+        return [k for k in self._keys if kid == k.kid]
+
+    def wrap_add(self, keyinst, use="", kid=''):
+        self._keys.append(jwk_wrap(keyinst, use, kid))
