+        for k, v in sorted(self.headers.items()):
+            header = bytes_('%s: %s'  % (k, v))
+            parts.append(header)
+
+        if body:
+            parts.extend([b'', body])
+        # HTTP clearly specifies CRLF
+        return b'\r\n'.join(parts)
