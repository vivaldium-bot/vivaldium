+
+    def testNestedFieldMapping(self):
+        nested_msg = AdditionalPropertiesMessage()
+        nested_msg.additional_properties = [
+            AdditionalPropertiesMessage.AdditionalProperty(
+                key='key_one', value='value_one'),
