+if sys.version_info[0] < 3:
+    def to_unicode(i):
+        return ('\U%08x' % i).decode('unicode-escape').encode('UTF-8')
+else:
+    def to_unicode(i):
+        return chr(i)
+o = sys.stdout
+o.write(to_unicode(0xFEFF))
+pack = array.array('I', zlib.decompress(
