+		DisplayList()
+		{
+		}
+
+		~DisplayList()
+		{
+			while(!list.empty())
+			{
+				delete list.back();
+				list.pop_back();
+			}
+		}
+
+		void call()
+		{
+			for(CommandList::iterator command = list.begin(); command != list.end(); command++)
+			{
