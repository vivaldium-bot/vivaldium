+        uint32_t tmmbr;
+        uint32_t packet_oh;
+        uint32_t ssrc;
+    };
+
+    std::vector<SetElement> _data;
+    // Number of places allocated.
+    uint32_t    _sizeOfSet;
+    // NUmber of places currently in use.
+    uint32_t    _lengthOfSet;
