+namespace skiagm {
+
+static SkBitmap make_bitmap() {
+    SkBitmap bm;
+    bm.allocN32Pixels(1, 1);
+    *bm.getAddr32(0, 0) = SkPackARGB32(0x80, 0x80, 0, 0);
+    return bm;
+}
+
+class TinyBitmapGM : public GM {
+public:
+    TinyBitmapGM() {
+        this->setBGColor(sk_tool_utils::color_to_565(0xFFDDDDDD));
+    }
+
