new file mode 100644
index 0000000000000000000000000000000000000000..b1310e3681ccdff38037e787e40d1aea0eeccf27
--- /dev/null
+++ b/third_party/skia/tests/PremulAlphaRoundTripTest.cpp
@@ -0,0 +1,115 @@
+/*
