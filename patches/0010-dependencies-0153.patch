+#include "GrXferProcessor.h"
+const GrXPFactory* SkBlendMode_AsXPFactory(SkBlendMode);
+#endif
+
+#endif
diff --git a/third_party/skia/src/core/SkBlitBWMaskTemplate.h b/third_party/skia/src/core/SkBlitBWMaskTemplate.h
