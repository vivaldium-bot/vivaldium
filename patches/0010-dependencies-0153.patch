+    int outerCount = reporter->allowExtendedTest() ? 100 : 1;
+    for (int index = 0; index < outerCount; ++index) {
+        for (int idx2 = 0; idx2 < 10; ++idx2) {
+            *testRunner.fRunnables.append() =
