+
+  feedback.Build();
+  std::vector<int64_t> deltas = feedback.GetReceiveDeltasUs();
+
+  int64_t accumulated_delta = 0;
+  int num_samples = 0;
+  for (int64_t delta : deltas) {
+    accumulated_delta += delta;
+    int64_t expected_time = num_samples * kTooSmallDelta;
+    ++num_samples;
