+	static Value *createSwizzle4(Value *val, unsigned char select)
+	{
+		int swizzle[4] =
+		{
+			(select >> 0) & 0x03,
+			(select >> 2) & 0x03,
+			(select >> 4) & 0x03,
+			(select >> 6) & 0x03,
+		};
+
+		return Nucleus::createShuffleVector(val, val, swizzle);
+	}
