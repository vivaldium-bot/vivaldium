index 0000000000000000000000000000000000000000..82dc7f713fc2f3dff2a3a3e781355a6a69ee9899
--- /dev/null
+++ b/third_party/skia/src/gpu/GrAuditTrail.cpp
@@ -0,0 +1,298 @@
+/*
