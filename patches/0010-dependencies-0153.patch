+	void Image::addRef()
+	{
+		if(parentTexture)
+		{
+			return parentTexture->addRef();
+		}
+
+		sw::atomicIncrement(&referenceCount);
+	}
+
+	void Image::release()
+	{
+		if(parentTexture)
+		{
+			return parentTexture->release();
+		}
+
+		if(referenceCount > 0)
+		{
+			sw::atomicDecrement(&referenceCount);
+		}
+
+		if(referenceCount == 0)
+		{
+			delete this;
+		}
+	}
