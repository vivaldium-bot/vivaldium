+};
+
+static const size_t testSetCount = SK_ARRAY_COUNT(testSet);
+
+static void oneOffTest(skiatest::Reporter* reporter) {
+    for (size_t index = 0; index < testSetCount; ++index) {
+        const QuadPts& q = testSet[index];
+        SkDQuad quad;
+        quad.debugSet(q.fPts);
