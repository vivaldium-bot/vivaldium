+	Device::~Device()
+	{
+		for(int i = 0; i < RENDERTARGETS; i++)
+		{
+			if(renderTarget[i])
+			{
+				renderTarget[i]->release();
+				renderTarget[i] = nullptr;
+			}
+		}
+
+		if(depthBuffer)
+		{
+			depthBuffer->release();
+			depthBuffer = nullptr;
+		}
+
+		if(stencilBuffer)
+		{
+			stencilBuffer->release();
+			stencilBuffer = nullptr;
+		}
+
+		delete context;
+	}
