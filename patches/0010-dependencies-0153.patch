+    SkPaint p;
+    p.setShader(SkGradientShader::MakeLinear(
+        pts, colors, nullptr, SK_ARRAY_COUNT(colors), SkShader::kRepeat_TileMode));
+    canvas->drawRect(SkRect::MakeXYWH(0, 0, 500, 500), p);
+}
