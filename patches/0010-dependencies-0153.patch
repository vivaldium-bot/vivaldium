index 0000000000000000000000000000000000000000..a3b4038a2fb68d49d3596d1ac7715e3606e1c481
--- /dev/null
+++ b/third_party/skia/src/effects/SkTableMaskFilter.cpp
@@ -0,0 +1,145 @@
+/*
