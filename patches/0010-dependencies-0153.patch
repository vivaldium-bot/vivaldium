+	for(unsigned int ext = 0; ext < sizeof(glExtensions) / sizeof(Extension); ext++)
+	{
+		if(strcmp(procname, glExtensions[ext].name) == 0)
+		{
+			return (__eglMustCastToProperFunctionPointerType)glExtensions[ext].address;
+		}
+	}
+
+	return nullptr;
+}
