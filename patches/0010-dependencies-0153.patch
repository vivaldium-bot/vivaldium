+/** The color input to the returned processor is treated as the src and the passed in processor is
+    the dst. */
+std::unique_ptr<GrFragmentProcessor> MakeFromDstProcessor(std::unique_ptr<GrFragmentProcessor> dst,
+                                                          SkBlendMode mode);
