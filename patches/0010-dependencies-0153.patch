+        canvas->drawRegion(fRegion, paint);
+
+        canvas->translate(-125.0f, 125.0f);
+        paint.setImageFilter(nullptr);
+        SkRect occluder = SkRect::MakeEmpty();
+        paint.setMaskFilter(SkBlurMaskFilter::Make(kNormal_SkBlurStyle, 5.0f, occluder, 0));
+        canvas->drawRegion(fRegion, paint);
+
+        canvas->translate(-125.0f, -125.0f);
