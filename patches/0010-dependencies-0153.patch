+	Nucleus::~Nucleus()
+	{
+		delete ::executionEngine;
+		::executionEngine = nullptr;
+
+		::routineManager = nullptr;
+		::function = nullptr;
+		::module = nullptr;
+
+		::codegenMutex.unlock();
+	}
