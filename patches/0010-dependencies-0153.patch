+				case EOpExp2:
+					switch(getType().getBasicType()) {
+					case EbtFloat: tempConstArray[i].setFConst(exp2f(unionArray[i].getFConst())); break;
+					default:
+						infoSink.info.message(EPrefixInternalError, "Unary operation not folded into constant", getLine());
+						return 0;
