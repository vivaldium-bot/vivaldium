+Query *Context::createQuery(unsigned int handle, GLenum type)
+{
+	if(!mQueryNameSpace.isReserved(handle))
+	{
+		return nullptr;
+	}
+	else
+	{
+		Query *query = mQueryNameSpace.find(handle);
+		if(!query)
+		{
+			query = new Query(handle, type);
+			query->addRef();
+			mQueryNameSpace.insert(handle, query);
