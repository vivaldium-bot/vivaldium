+    static_assert(SkPaint::kAlignCount < 4, "insufficient_align_bits");
+    uint32_t                 fAlign : 2;
+    static_assert(SkPaint::kFull_Hinting < 4, "insufficient_hinting_bits");
+    uint32_t                 fHinting : 2;
+    static_assert((kFlagsMask & 0xffff) == kFlagsMask, "insufficient_flags_bits");
+    uint32_t                 fFlags : 16;
