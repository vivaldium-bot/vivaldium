+                                                             sk_sp<SkImageFilter> input,
+                                                             const CropRect* cropRect)
+    : INHERITED(std::move(light), surfaceScale, std::move(input), cropRect)
+    , fKS(ks)
+    , fShininess(shininess) {
+}
