new file mode 100644
index 0000000000000000000000000000000000000000..2b76b035e19a6a7ca17c73ab2eb6a3876655f07f
--- /dev/null
+++ b/third_party/skia/src/jumper/SkJumper_vectors.h
@@ -0,0 +1,687 @@
+/*
