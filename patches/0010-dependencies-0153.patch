+  nada_sender_.set_bitrate_kbps(5 * kMinBitrateKbps);
+  nada_sender_.set_original_operating_mode(true);
+  for (int i = 0; i < 100; ++i) {
+    // Trigger GradualRateUpdate mode.
+    nada_sender_.GiveFeedback(extremely_congested_fb);
