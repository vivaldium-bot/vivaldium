new file mode 100644
index 0000000000000000000000000000000000000000..739be72182295bbd290288299a1e81693a24f4da
--- /dev/null
+++ b/third_party/skia/src/core/SkCachedData.h
@@ -0,0 +1,112 @@
+/*
