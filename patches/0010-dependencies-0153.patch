+static SK_ALWAYS_INLINE void blur_x_radius_3(
+        const Sk8h& s0,
+        const Sk8h& gauss0, const Sk8h& gauss1, const Sk8h& gauss2, const Sk8h& gauss3, const Sk8h&,
