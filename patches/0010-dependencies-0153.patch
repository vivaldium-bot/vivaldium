new file mode 100644
index 0000000000000000000000000000000000000000..3c08fdcfa41cc54c74158dd9b05e8050cda0f027
--- /dev/null
+++ b/third_party/skia/src/images/SkWebpEncoder.cpp
@@ -0,0 +1,228 @@
+/*
