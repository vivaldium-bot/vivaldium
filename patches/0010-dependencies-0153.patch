+    FOR_SETUP(k, align, setTextAlign)
+    FOR_SETUP(l, caps, setStrokeCap)
+    FOR_SETUP(m, joins, setStrokeJoin)
+    FOR_SETUP(n, encodings, setTextEncoding)
+    FOR_SETUP(p, styles, setStyle)
