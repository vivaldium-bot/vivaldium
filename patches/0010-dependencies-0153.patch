+			return error(GL_INVALID_ENUM);
+		}
+
+		switch(pname)
+		{
+		case GL_TEXTURE_CROP_RECT_OES:
+			texture->setCropRect(params[0], params[1], params[2], params[3]);
+			break;
+		default:
+			return error(GL_INVALID_ENUM);
+		}
+	}
