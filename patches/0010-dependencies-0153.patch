+Texture::Texture(GLuint name) : NamedObject(name)
+{
+	mMinFilter = GL_NEAREST_MIPMAP_LINEAR;
+	mMagFilter = GL_LINEAR;
+	mWrapS = GL_REPEAT;
+	mWrapT = GL_REPEAT;
+	mMaxAnisotropy = 1.0f;
+	mMaxLevel = 1000;
+
+	resource = new sw::Resource(0);
+}
+
+Texture::~Texture()
+{
+	resource->destruct();
+}
+
+sw::Resource *Texture::getResource() const
+{
+	return resource;
+}
