+////////////////////////////////////////////////////////////////////////////
+
+SkView::Click::Click(SkView* target) {
+    SkASSERT(target);
+    fTargetID = target->getSinkID();
+    fType = nullptr;
+    fWeOwnTheType = false;
+    fOwner = nullptr;
+}
