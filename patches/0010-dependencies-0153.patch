+void SkCanvas::internalDrawPaint(const SkPaint& paint) {
+    LOOPER_BEGIN_CHECK_COMPLETE_OVERWRITE(paint, SkDrawFilter::kPaint_Type, nullptr, false)
+
+    while (iter.next()) {
+        iter.fDevice->drawPaint(looper.paint());
+    }
+
