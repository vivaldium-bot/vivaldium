+	Direct3DDevice8::~Direct3DDevice8()
+	{
+		delete renderer;
+		renderer = 0;
+		delete context;
+		context = 0;
+
+		d3d8->Release();
+		d3d8 = 0;
+
+		for(unsigned int i = 0; i < swapChain.size(); i++)
+		{
+			if(swapChain[i])
+			{
+				swapChain[i]->unbind();
+				swapChain[i] = 0;
+			}
+		}
+		
+		if(depthStencil)
+		{
+			depthStencil->unbind();
+			depthStencil = 0;
+		}
+		
+		if(renderTarget)
+		{
+			renderTarget->unbind();
+			renderTarget = 0;
+		}
+
+		for(int i = 0; i < 8; i++)
+		{
+			if(texture[i])
+			{
+				texture[i]->unbind();
+				texture[i] = 0;
+			}
+		}
+
+		for(int i = 0; i < 16; i++)
+		{
+			if(dataStream[i])
+			{
+				dataStream[i]->unbind();
+				dataStream[i] = 0;
+			}
+		}
+
+		if(indexData)
+		{
+			indexData->unbind();
+			indexData = 0;
+		}
+
+		for(unsigned int i = 0; i < pixelShader.size(); i++)
+		{
+			if(pixelShader[i])
+			{
+				pixelShader[i]->unbind();
+				pixelShader[i] = 0;
+			}
+		}
+
+		for(unsigned int i = 0; i < vertexShader.size(); i++)
+		{
+			if(vertexShader[i])
+			{
+				vertexShader[i]->unbind();
+				vertexShader[i] = 0;
+			}
+		}
+
+		for(unsigned int i = 0; i < stateRecorder.size(); i++)
+		{
+			if(stateRecorder[i])
+			{
+				stateRecorder[i]->unbind();
+				stateRecorder[i] = 0;
+			}
+		}
+
+		palette.clear();
+
+		delete cursor;
+		DestroyCursor(nullCursor);
+	}
