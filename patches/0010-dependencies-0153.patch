+private:
+    BezierConicTestOp(sk_sp<GrGeometryProcessor> gp, const SkRect& rect, GrColor color,
+                      const SkMatrix& klm)
+            : INHERITED(std::move(gp), rect, color, ClassID()), fKLM(klm) {}
+
+    struct Vertex {
