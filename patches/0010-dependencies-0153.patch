+		const int height;
+		const D3DFORMAT format;
+		const D3DMULTISAMPLE_TYPE multiSample;
+		const D3DPOOL pool;
+		const bool lockable;
+		const unsigned long usage;
+
+		Direct3DBaseTexture8 *parentTexture;
