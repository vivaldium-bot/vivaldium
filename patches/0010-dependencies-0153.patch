+static int count(const SkClipStack& stack) {
+
+    SkClipStack::Iter iter(stack, SkClipStack::Iter::kTop_IterStart);
+
+    const SkClipStack::Element* element = nullptr;
+    int count = 0;
+
+    for (element = iter.prev(); element; element = iter.prev(), ++count) {
+        ;
+    }
+
+    return count;
+}
