+	template<typename Return, typename... Arguments>
+	Function<Return(Arguments...)>::Function()
+	{
+		core = new Nucleus();
+
+		Type *types[] = {Arguments::getType()...};
+		for(Type *type : types)
+		{
+			if(type != Void::getType())
+			{
+				arguments.push_back(type);
+			}
+		}
+
+		Nucleus::createFunction(Return::getType(), arguments);
+	}
