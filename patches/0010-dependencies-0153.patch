+sk_sp<SkVertices> MakeSpot(const SkPath& path, const SkMatrix& ctm, SkScalar scale,
+                           const SkVector& translate, SkScalar radius, SkColor umbraColor,
+                           SkColor penumbraColor, bool transparent);
