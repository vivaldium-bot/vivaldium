+	      program, uniformCount, uniformNames, uniformIndices);
+
+	if(uniformCount < 0)
+	{
+		return error(GL_INVALID_VALUE);
+	}
+
+	es2::Context *context = es2::getContext();
+
+	if(context)
+	{
