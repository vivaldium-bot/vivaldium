+}
+
+bool TranslatorASM::translate(TIntermNode* root)
+{
+    TParseContext& parseContext = *GetGlobalParseContext();
+    glsl::OutputASM outputASM(parseContext, shaderObject);
+
+	outputASM.output();
+
+	return parseContext.numErrors() == 0;
+}
