+
+    // The cache is initialized on-demand when getCache16/32 is called.
+    class GradientShaderCache : public SkRefCnt {
+    public:
+        GradientShaderCache(U8CPU alpha, bool dither, const SkGradientShaderBase& shader);
+        ~GradientShaderCache();
