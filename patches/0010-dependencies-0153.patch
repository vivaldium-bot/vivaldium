+struct SkPDFType3Font final : public SkPDFFont {
+    SkPDFType3Font(SkPDFFont::Info, const SkAdvancedTypefaceMetrics&);
+    ~SkPDFType3Font() override {}
+    void getFontSubset(SkPDFCanon*) override;
+};
