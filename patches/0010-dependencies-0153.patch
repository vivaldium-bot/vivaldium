+			return true;
+		case GL_RGBA4:
+		case GL_RGB5_A1:
+		case GL_RGB565:
+		case GL_RGB8_EXT:
+		case GL_RGBA8_EXT:
+		case GL_DEPTH_COMPONENT16:
+		case GL_DEPTH_COMPONENT24:
+			return false;
+		default:
+			UNIMPLEMENTED();
