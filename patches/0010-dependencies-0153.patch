+        SkDebugf("------ RENDERER %s\n", renderer);
+        SkDebugf("------ VERSION %s\n",  version);
+        SkDebugf("------ EXTENSIONS\n");
+        this->glContext().extensions().print();
+        SkDebugf("\n");
+        SkDebugf("%s", this->glCaps().dump().c_str());
+    }
