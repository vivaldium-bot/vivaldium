+                { &get_surface_backend_texture_handle, &get_surface_backend_render_target_handle}) {
+                auto surface(surface_func(ctxInfo.grContext(), kPremul_SkAlphaType, nullptr));
+                test_func(reporter, surface.get(), handle_access_func);
