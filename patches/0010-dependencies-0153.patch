+static void test_draw_bitmaps(SkCanvas* canvas) {
+    SkBitmap empty;
+    draw_bitmaps(empty, canvas);
+    empty.setInfo(SkImageInfo::MakeN32Premul(10, 10));
+    draw_bitmaps(empty, canvas);
+}
