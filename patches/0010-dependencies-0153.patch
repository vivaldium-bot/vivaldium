+	{
+		TRACE("");
+
+		return Direct3DResource9::Release();
+	}
+
+	long Direct3DBaseTexture9::FreePrivateData(const GUID &guid)
+	{
+		CriticalSection cs(device);
+
+		TRACE("");
+
+		return Direct3DResource9::FreePrivateData(guid);
+	}
