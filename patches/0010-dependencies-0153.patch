+					error(GL_INVALID_ENUM);
+				}
+
+				context->setOperand0RGB(iParam);
+				break;
+			case GL_OPERAND1_RGB:
+				switch(iParam)
+				{
+				case GL_SRC_COLOR:
+				case GL_ONE_MINUS_SRC_COLOR:
+				case GL_SRC_ALPHA:
+				case GL_ONE_MINUS_SRC_ALPHA:
+					break;
+				default:
+					error(GL_INVALID_ENUM);
+				}
+
+				context->setOperand1RGB(iParam);
+				break;
+			case GL_OPERAND2_RGB:
+				switch(iParam)
+				{
+				case GL_SRC_COLOR:
+				case GL_ONE_MINUS_SRC_COLOR:
+				case GL_SRC_ALPHA:
+				case GL_ONE_MINUS_SRC_ALPHA:
