+            }
+            case 36: {
+                bool usePaint;
+                auto img = make_fuzz_image(fuzz);
+                SkRect dst;
+                fuzz->next(&dst, &usePaint);
+                if (usePaint) {
+                    fuzz_paint(fuzz, &paint, depth - 1);
