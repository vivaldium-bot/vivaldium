+SkCanvas::~SkCanvas() {
+    // free up the contents of our deque
+    this->restoreToCount(1);    // restore everything but the last
+
+    this->internalRestore();    // restore the last, since we're going away
+
+    delete fMetaData;
+
+    dec_canvas();
+}
