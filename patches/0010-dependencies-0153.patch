+                           const SkIRect& srcRect,
+                           const SkIPoint& dstPoint);
+
+    void copySurfaceAsResolve(GrSurface* dst, GrSurfaceOrigin dstOrigin,
+                              GrSurface* src, GrSurfaceOrigin srcOrigin,
+                              const SkIRect& srcRect,
+                              const SkIPoint& dstPoint);
+
+    // helpers for onCreateTexture and writeTexturePixels
