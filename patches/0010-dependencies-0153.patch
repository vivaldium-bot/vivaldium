+function isAlpha(code) {
+    return (code > 64 && code < 91) // upper alpha (A-Z)
+        || (code > 96 && code < 123); // lower alpha (a-z)
+}
+
+function isArray(a) {
+    return a.constructor === Array;
+}
+
+function rgb(r, g, b) {
+    return 0xFF << 24 | r << 16 | g << 8 | b;
