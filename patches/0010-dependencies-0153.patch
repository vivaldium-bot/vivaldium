+    cache->purgeAllUnlocked();
+    REPORTER_ASSERT(reporter, 2 == TestResource::NumAlive());
+
+    // Break the cycle
+    a->setUnrefWhenDestroyed(nullptr);
+    REPORTER_ASSERT(reporter, 2 == TestResource::NumAlive());
+
+    cache->purgeAllUnlocked();
+    REPORTER_ASSERT(reporter, 0 == TestResource::NumAlive());
+}
