+
+class SkSVGRenderContext;
+
+enum class SkSVGAttribute {
+    kClipPath,
+    kCx, // <circle>,<ellipse>: center x position
+    kCy, // <circle>,<ellipse>: center y position
+    kD,
+    kFill,
+    kFillOpacity,
+    kFillRule,
