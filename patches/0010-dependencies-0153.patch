+void SkSVGPath::onSetAttribute(SkSVGAttribute attr, const SkSVGValue& v) {
+    switch (attr) {
+    case SkSVGAttribute::kD:
+        if (const auto* path = v.as<SkSVGPathValue>()) {
+            this->setPath(*path);
