+void SkOpCoincidence::dump() const {
+    SkCoincidentSpans* span = fHead;
+    while (span) {
+        span->dump();
+        span = span->next();
+    }
+    if (!fTop || fHead == fTop) {
+        return;
+    }
+    SkDebugf("top:\n");
+    span = fTop;
+    int count = 0;
+    while (span) {
+        span->dump();
+        span = span->next();
+        SkCoincidentSpans* check = fTop;
+        ++count;
+        for (int index = 0; index < count; ++index) {
+            if (span == check) {
+                SkDebugf("(loops to #%d)\n", index);
+                return;
+            }
+            check = check->next();
+        }
+    }
+}
