+
+// Fence.h: Defines the Fence class, which supports the GL_NV_fence extension.
+
+#ifndef LIBGLESV2_FENCE_H_
+#define LIBGLESV2_FENCE_H_
+
+#include "common/Object.hpp"
+#include <GLES2/gl2.h>
+
+namespace es2
+{
+
+class Fence
+{
+public:
+	Fence();
+	virtual ~Fence();
+
+	GLboolean isFence();
+	void setFence(GLenum condition);
+	GLboolean testFence();
+	void finishFence();
+	void getFenceiv(GLenum pname, GLint *params);
+
+private:
+	bool mQuery;
+	GLenum mCondition;
+	GLboolean mStatus;
+};
+
+class FenceSync : public gl::NamedObject
+{
+public:
+	FenceSync(GLuint name, GLenum condition, GLbitfield flags);
+	virtual ~FenceSync();
+
+	GLenum clientWait(GLbitfield flags, GLuint64 timeout);
+	void serverWait(GLbitfield flags, GLuint64 timeout);
+
+	GLenum getCondition() const { return mCondition; }
+	GLbitfield getFlags() const { return mFlags; }
+
+private:
+	GLenum mCondition;
+	GLbitfield mFlags;
+};
+
+}
+
+#endif   // LIBGLESV2_FENCE_H_
diff --git a/third_party/swiftshader/src/OpenGL/libGLESv2/Framebuffer.cpp b/third_party/swiftshader/src/OpenGL/libGLESv2/Framebuffer.cpp
