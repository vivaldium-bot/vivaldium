diff --git a/third_party/skia/src/views/mac/SkTextFieldCell.m b/third_party/skia/src/views/mac/SkTextFieldCell.m
new file mode 100644
index 0000000000000000000000000000000000000000..c5efc46406e01497b1652771616bf1d6879ccf2e
--- /dev/null
