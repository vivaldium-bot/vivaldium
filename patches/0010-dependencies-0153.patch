+
+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+sk_sp<SkImage> MakeTextureFromMipMap(GrContext*, const SkImageInfo&, const GrMipLevel texels[],
+                                     int mipLevelCount, SkBudgeted) {
