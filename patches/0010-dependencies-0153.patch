+         "void main() { float x = 10; bar(x); sk_FragColor = vec4(x); }",
+         *SkSL::ShaderCapsFactory::Default(),
+         "#version 400\n"
+         "out vec4 sk_FragColor;\n"
+         "float foo(in float v[2]) {\n"
+         "    return v[0] * v[1];\n"
+         "}\n"
+         "void bar(inout float x) {\n"
+         "    float y[2], z;\n"
+         "    y[0] = x;\n"
+         "    y[1] = x * 2.0;\n"
+         "    z = foo(y);\n"
+         "    x = z;\n"
+         "}\n"
+         "void main() {\n"
+         "    float x = 10.0;\n"
+         "    bar(10.0);\n"
+         "    sk_FragColor = vec4(10.0);\n"
+         "}\n");
+}
