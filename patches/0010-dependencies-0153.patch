+}
+
+size_t SkImage::getDeferredTextureImageData(const GrContextThreadSafeProxy&,
+                                            const DeferredTextureImageUsageParams[],
+                                            int paramCnt, void* buffer,
+                                            SkColorSpace* dstColorSpace,
+                                            SkColorType dstColorType) const {
+    return 0;
+}
