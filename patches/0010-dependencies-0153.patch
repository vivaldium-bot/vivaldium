+  ss << reverse_output_rate / 1000;
+  ss << "_d" << file_direction << "_pcm";
+
+  std::string filename = ss.str();
+  if (temp_filenames[filename].empty())
+    temp_filenames[filename] = test::TempFilename(test::OutputPath(), filename);
