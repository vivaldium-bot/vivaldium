+  int bitrate_1_kbps = nada_sender_.bitrate_kbps();
+  EXPECT_LE(bitrate_1_kbps, original_bitrate * 0.9f + 0.5f);
+  EXPECT_LT(bitrate_1_kbps, original_bitrate);
