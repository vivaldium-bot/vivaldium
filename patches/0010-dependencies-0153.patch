+                 int flow_id,
+                 BandwidthEstimatorType bwe_type,
+                 bool plot_delay,
+                 bool plot_bwe,
+                 MetricRecorder* metric_recorder);
+  ~PacketReceiver();
+
+  // Implements PacketProcessor.
+  void RunFor(int64_t time_ms, Packets* in_out) override;
+
+  void LogStats();
+
+  Stats<double> GetDelayStats() const;
+
+  float GlobalPacketLoss();
