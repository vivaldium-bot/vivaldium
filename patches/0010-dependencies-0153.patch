+            fragBuilder->codeAppendf("color.r = %s(color.r);", tfFuncNames[1].c_str());
+            fragBuilder->codeAppendf("color.g = %s(color.g);", tfFuncNames[1].c_str());
+            fragBuilder->codeAppendf("color.b = %s(color.b);", tfFuncNames[1].c_str());
