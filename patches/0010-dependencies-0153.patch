+#include "SkClipStack.h"
+#include "SkTypes.h"
+
+class GrAppliedClip;
+class GrClipStackClip;
+class GrContext;
+class GrDrawContext;
+class GrFixedClip;
+class GrPathRenderer;
+class GrPathRendererChain;
+class GrPipelineBuilder;
+class GrResourceProvider;
+class GrTexture;
+class GrTextureProvider;
+class GrUniqueKey;
+struct GrUserStencilSettings;
