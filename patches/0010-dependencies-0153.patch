index 0000000000000000000000000000000000000000..dc553e03772329aa4f03e9d75970a4acfd34ef4c
--- /dev/null
+++ b/third_party/skia/src/gpu/vk/GrVkGpuCommandBuffer.cpp
@@ -0,0 +1,397 @@
+/*
