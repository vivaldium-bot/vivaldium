+bool Texture::isMipmapFiltered() const
+{
+	switch(mMinFilter)
+	{
+	case GL_NEAREST:
+	case GL_LINEAR:
+		return false;
+	case GL_NEAREST_MIPMAP_NEAREST:
+	case GL_LINEAR_MIPMAP_NEAREST:
+	case GL_NEAREST_MIPMAP_LINEAR:
+	case GL_LINEAR_MIPMAP_LINEAR:
+		return true;
+	default: UNREACHABLE(mMinFilter);
+	}
+
+	return false;
+}
