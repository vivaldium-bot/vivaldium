+        sk_sp<SkData> data;
+    };
+
+    struct NamedDestination {
+        sk_sp<SkData> nameData;
+        SkPoint point;
+    };
+
+    // TODO(vandebo): push most of SkPDFDevice's state into a core object in
+    // order to get the right access levels without using friend.
+    friend class ScopedContentEntry;
