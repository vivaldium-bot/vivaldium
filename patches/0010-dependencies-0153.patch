+		constantVector[1] = Nucleus::createConstantInt(0x7FFFFFFF);
+		constantVector[2] = Nucleus::createConstantInt(0x7FFFFFFF);
+		constantVector[3] = Nucleus::createConstantInt(0x7FFFFFFF);
