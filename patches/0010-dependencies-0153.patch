+TEST(BweTestFramework_VideoSenderTest, Fps50Kpbs80_11s) {
+  // 50 fps, 80 kbps.
+  VideoSource source(0, 50.0f, 80, 0x1234, 0);
+  VideoSender sender(NULL, &source, kNullEstimator);
+  EXPECT_EQ(80000u, source.bits_per_second());
