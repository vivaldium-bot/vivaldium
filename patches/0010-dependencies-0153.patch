+        test.init(dirNo);
+        test.fTestStep = testStep;
+        strcpy(test.fFilename, filename);
+        test.testOne();
+        if (verbose) {
+            SkDebugf("%s", test.status().c_str());
+        }
+    }
+
+    void test(int dirNo, const SkString& filename) {
+        init(dirNo);
+        strcpy(fFilename, filename.c_str());
+        testOne();
+    }
