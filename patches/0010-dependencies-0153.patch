+						LoadImageData<RGBA5551>(xoffset, yoffset, zoffset, width, height, depth, inputPitch, inputHeight, getPitch(), getHeight(), input, buffer);
+						break;
+					default: UNREACHABLE(format);
+					}
+					break;
+				case GL_UNSIGNED_INT_10F_11F_11F_REV:
