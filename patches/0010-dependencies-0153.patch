+DEF_TEST(SkSLOperators, r) {
+    test(r,
+         "void main() {"
+         "float x = 1, y = 2;"
+         "int z = 3;"
+         "x = x - x + y * z * x * (y - z);"
+         "y = x / y / z;"
+         "z = (z / 2 % 3 << 4) >> 2 << 1;"
+         "bool b = (x > 4) == x < 2 || 2 >= sqrt(2) && y <= z;"
+         "x += 12;"
+         "x -= 12;"
+         "x *= y /= z = 10;"
+         "b ||= false;"
+         "b &&= true;"
+         "b ^^= false;"
+         "z |= 0;"
+         "z &= -1;"
+         "z ^= 0;"
+         "z >>= 2;"
+         "z <<= 4;"
+         "z %= 5;"
+         "}",
+         *SkSL::ShaderCapsFactory::Default(),
+         "#version 400\n"
+         "out vec4 sk_FragColor;\n"
+         "void main() {\n"
+         "    float x = 1.0, y = 2.0;\n"
+         "    int z = 3;\n"
+         "    x = -6.0;\n"
+         "    y = -1.0;\n"
+         "    z = 8;\n"
+         "    bool b = false == true || 2.0 >= sqrt(2.0) && true;\n"
+         "    x += 12.0;\n"
+         "    x -= 12.0;\n"
+         "    x *= (y /= float(z = 10));\n"
+         "    b ||= false;\n"
+         "    b &&= true;\n"
+         "    b ^^= false;\n"
+         "    z |= 0;\n"
+         "    z &= -1;\n"
+         "    z ^= 0;\n"
+         "    z >>= 2;\n"
+         "    z <<= 4;\n"
+         "    z %= 5;\n"
+         "}\n");
