+	void Direct3DDevice9::configureFPU()
+	{
+	//	_controlfp(_PC_24, _MCW_PC);     // Single-precision
+		_controlfp(_MCW_EM, _MCW_EM);    // Mask all exceptions
+		_controlfp(_RC_NEAR, _MCW_RC);   // Round to nearest
+	}
