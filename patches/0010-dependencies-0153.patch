+#ifdef SK_DEBUG
+void SkPDFType0Font::emitObject(SkWStream* stream,
+                                const SkPDFObjNumMap& objNumMap) const {
+    SkASSERT(fPopulated);
+    return INHERITED::emitObject(stream, objNumMap);
+}
