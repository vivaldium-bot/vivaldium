+SK_API SkFontMgr* SkFontMgr_New_FCI(SkFontConfigInterface* fci) {
+    SkASSERT(fci);
+    return new SkFontMgr_FCI(fci);
+}
diff --git a/third_party/skia/src/fonts/SkFontMgr_indirect.cpp b/third_party/skia/src/fonts/SkFontMgr_indirect.cpp
