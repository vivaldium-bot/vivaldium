+    void onDraw(SkCanvas* canvas) override {
+        SkPictureRecorder recorder;
+        SkCanvas* rec = recorder.beginRecording(1200, 900, nullptr, 0);
+        SkPath p;
+        SkRect r = {
+            SkIntToScalar(100),
+            SkIntToScalar(200),
+            SkIntToScalar(400),
+            SkIntToScalar(700)
