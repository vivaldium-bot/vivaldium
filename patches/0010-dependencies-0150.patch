+  } else if (typeof gl[i] != "function") {
+    if (!extended) {
+      extended = true;
+      testFailed("Also found the following extra properties:");
+    }
+    testFailed(i);
+  }
+}
+
+if (!extended) {
+  testPassed("No extra properties found on WebGL context.");
+}
