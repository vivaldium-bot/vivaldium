+    fXPFactory = GrCoverageSetOpXPFactory::Make(regionOp, invertCoverage);
+}
+
+void GrPaint::addColorTextureProcessor(GrTexture* texture,
+                                       sk_sp<GrColorSpaceXform> colorSpaceXform,
+                                       const SkMatrix& matrix) {
