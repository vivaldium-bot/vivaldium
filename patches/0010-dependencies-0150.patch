+void SkPath::moveTo(SkScalar x, SkScalar y) {
+    SkDEBUGCODE(this->validate();)
+
+    SkPathRef::Editor ed(&fPathRef);
+
+    // remember our index
+    fLastMoveToIndex = fPathRef->countPoints();
+
+    ed.growForVerb(kMove_Verb)->set(x, y);
+
