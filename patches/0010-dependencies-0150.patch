+SkGradientShaderBase::GradientShaderBase4fContext::
+Interval::Interval(const Sk4f& c0, SkScalar p0,
+                   const Sk4f& c1, SkScalar p1)
+    : fP0(p0)
+    , fP1(p1)
+    , fZeroRamp((c0 == c1).allTrue()) {
+
+    SkASSERT(p0 != p1);
+    const Sk4f dc = (c1 - c0) / (p1 - p0);
+
+    c0.store(&fC0.fVec);
+    dc.store(&fDc.fVec);
+}
