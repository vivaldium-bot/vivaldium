index 0000000000000000000000000000000000000000..608229f485638ca503e667d84cc2cf6f78301f27
--- /dev/null
+++ b/third_party/spirv-tools-angle/src/test/opt/instruction_test.cpp
@@ -0,0 +1,151 @@
+// Copyright (c) 2016 Google Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
