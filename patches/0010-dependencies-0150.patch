+        VkPtr<PFN_vkDestroyPipeline> fDestroyPipeline;
+        VkPtr<PFN_vkCreatePipelineLayout> fCreatePipelineLayout;
+        VkPtr<PFN_vkDestroyPipelineLayout> fDestroyPipelineLayout;
+        VkPtr<PFN_vkCreateSampler> fCreateSampler;
