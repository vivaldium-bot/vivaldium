+#ifndef LIBSPIRV_ASSEMBLY_GRAMMAR_H_
+#define LIBSPIRV_ASSEMBLY_GRAMMAR_H_
+
+#include "operand.h"
+#include "spirv-tools/libspirv.h"
+#include "spirv/1.1/spirv.h"
