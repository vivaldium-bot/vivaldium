index 0000000000000000000000000000000000000000..6fa091db8ebdfa0578c16e7256a0daaac6b16d5c
--- /dev/null
+++ b/third_party/skia/src/pathops/SkPathOpsLine.cpp
@@ -0,0 +1,149 @@
+/*
