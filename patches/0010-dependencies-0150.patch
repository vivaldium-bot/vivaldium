+    SkFontMgr_DirectWrite(IDWriteFactory* factory, IDWriteFontCollection* fontCollection,
+                          IDWriteFontFallback* fallback, WCHAR* localeName, int localeNameLength)
+        : fFactory(SkRefComPtr(factory))
