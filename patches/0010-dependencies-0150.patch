+void GrDrawContextPriv::stencilPath(const GrClip& clip, 
+                                    bool useHWAA,
+                                    const SkMatrix& viewMatrix,
+                                    const GrPath* path) {
+    fDrawContext->getDrawTarget()->stencilPath(fDrawContext, clip, useHWAA, viewMatrix, path);
+}
