diff --git a/third_party/skia/src/core/SkColorSpace.cpp b/third_party/skia/src/core/SkColorSpace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c6bf4b9431300460b4fbe4dd2b6f276de9dda4a2
--- /dev/null
+++ b/third_party/skia/src/core/SkColorSpace.cpp
@@ -0,0 +1,472 @@
+/*
