+        : GrSurface(gpu, desc)
+        , GrGLTexture(gpu, desc, texIDDesc, wasMipMapDataProvided)
+        , GrGLRenderTarget(gpu, desc, rtIDDesc) {
+        this->registerWithCache(budgeted);
