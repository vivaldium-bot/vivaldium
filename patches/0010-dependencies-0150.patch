+        return armv7_vrndmq_f32(fVec);
+    #endif
+    }
+
+
+    AI SkNx rsqrt() const {
+        float32x4_t est0 = vrsqrteq_f32(fVec);
+        return vmulq_f32(vrsqrtsq_f32(fVec, vmulq_f32(est0, est0)), est0);
+    }
+
+    AI SkNx sqrt() const {
+    #if defined(SK_CPU_ARM64)
+        return vsqrtq_f32(fVec);
+    #else
+        float32x4_t est0 = vrsqrteq_f32(fVec),
