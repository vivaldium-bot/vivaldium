+      'target_name': 'skgpu',
+      'product_name': 'skia_skgpu',
+      'type': 'static_library',
+      'standalone_static_library': 1,
+      'dependencies': [
+        'core.gyp:*',
+        'utils.gyp:utils',
+        'etc1.gyp:libetc1',
+        'ktx.gyp:libSkKTX',
+      ],
+      'includes': [
+        'gpu.gypi',
+      ],
+      'include_dirs': [
+        '../include/gpu',
+        '../include/private',
+        '../src/core',
+        '../src/gpu',
+        '../src/image/',
+      ],
+      'sources': [
+        '<@(skgpu_sources)',
+        '<@(skgpu_native_gl_sources)',
+        '<@(skgpu_vk_sources)',
+        'gpu.gypi', # Makes the gypi appear in IDEs (but does not modify the build).
+      ],
+      'conditions': [
+        [ 'skia_gpu_extra_dependency_path', {
+          'dependencies' : [
+              '<(skia_gpu_extra_dependency_path):*',
+          ],
+          'export_dependent_settings': [
+            '<(skia_gpu_extra_dependency_path):*',
+          ],
+        }],
+        [ 'skia_chrome_utils', {
+          'sources': [
