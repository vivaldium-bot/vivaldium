new file mode 100644
index 0000000000000000000000000000000000000000..c523ae833ffdcedc8ab247afd03f3c86607fddc4
--- /dev/null
+++ b/third_party/skia/src/core/SkSpecialImage.cpp
@@ -0,0 +1,530 @@
+/*
