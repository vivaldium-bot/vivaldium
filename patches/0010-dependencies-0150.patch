index 0000000000000000000000000000000000000000..9830669f049bee2ef5900cac7a524a06e15fb659
--- /dev/null
+++ b/third_party/skia/src/effects/SkMergeImageFilter.cpp
@@ -0,0 +1,194 @@
+/*
