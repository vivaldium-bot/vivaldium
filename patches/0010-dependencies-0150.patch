+                                  const GrPrimitiveProcessor& processor) {
+    const DashingLineEffect& de = processor.cast<DashingLineEffect>();
+    if (de.color() != fColor) {
+        float c[4];
+        GrColorToRGBAFloat(de.color(), c);
+        pdman.set4fv(fColorUniform, 1, c);
+        fColor = de.color();
+    }
