+        'sources/': [ ['exclude', '_iOS.(h|cpp|m|mm)$'],
+        ],
+      }],
+      ['skia_os != "android"', {
+        'sources/': [ ['exclude', '_android.(h|cpp)$'],
+        ],
+      }],
+      ['skia_egl == 0', {
