+            return false;
+        }
+        if (y < 40 || y > screenHeight - 80) {
+            return false;
+        }
+        curveT = (y - 40) / (screenHeight - 120);
+        if (curveT < 0 || curveT > 1) {
+            throw "stop execution";
+        }
+        return true;
+    }
+
+    function ptInWControl() {
