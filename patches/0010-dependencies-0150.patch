+class GrVkTexture : public GrTexture, public virtual GrVkImage {
+public:
+    static GrVkTexture* CreateNewTexture(GrVkGpu*, SkBudgeted budgeted, const GrSurfaceDesc&,
+                                         const GrVkImage::ImageDesc&);
