+
+#include <emmintrin.h>
+#include "SkBitmap.h"
+#include "SkBitmapFilter_opts_SSE2.h"
+#include "SkBitmapProcState.h"
+#include "SkColor.h"
+#include "SkColorPriv.h"
+#include "SkConvolver.h"
+#include "SkShader.h"
+#include "SkUnPreMultiply.h"
+
+#if 0
