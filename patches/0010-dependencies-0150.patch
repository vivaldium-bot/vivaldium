+void SkLOGFONTFromTypeface(const SkTypeface* face, LOGFONT* lf) {
+    if (nullptr == face) {
+        *lf = get_default_font();
+    } else {
+        *lf = static_cast<const LogFontTypeface*>(face)->fLogFont;
+    }
+}
