new file mode 100644
index 0000000000000000000000000000000000000000..884f785299925794ee747828ef7d2c6dd4b0ebec
--- /dev/null
+++ b/third_party/skia/src/core/SkScan_Path.cpp
@@ -0,0 +1,777 @@
+/*
