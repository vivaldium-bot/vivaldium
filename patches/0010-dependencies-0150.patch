index 0000000000000000000000000000000000000000..1e1dd24f998ef40a5e1dd07357b8acd9014c3eba
--- /dev/null
+++ b/third_party/skia/include/c/sk_canvas.h
@@ -0,0 +1,159 @@
+/*
