+}
+
+sk_sp<GrTextureProxy> SkMaskFilter::filterMaskGPU(GrContext*,
+                                                  sk_sp<GrTextureProxy> srcProxy,
+                                                  const SkMatrix& ctm,
+                                                  const SkIRect& maskRect) const {
