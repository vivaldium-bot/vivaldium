+    ASSIGN(fShader);
+    ASSIGN(fMaskFilter);
+    ASSIGN(fColorFilter);
+    ASSIGN(fRasterizer);
+    ASSIGN(fDrawLooper);
+    ASSIGN(fImageFilter);
