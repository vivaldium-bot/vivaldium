+
+struct HandlerRec {
+    SkPipeHandler   fProc;
+    const char*     fName;
+};
+
+#define HANDLER(name)   { name##_handler, #name }
+const HandlerRec gPipeHandlers[] = {
+    HANDLER(save),
+    HANDLER(saveLayer),
+    HANDLER(restore),
+    HANDLER(concat),
+    
+    HANDLER(clipRect),
+    HANDLER(clipRRect),
+    HANDLER(clipPath),
+    HANDLER(clipRegion),
+    
+    HANDLER(drawArc),
+    HANDLER(drawAtlas),
+    HANDLER(drawDRRect),
+    HANDLER(drawText),
+    HANDLER(drawPosText),
+    HANDLER(drawPosTextH),
+    HANDLER(drawRegion),
+    HANDLER(drawTextOnPath),
+    HANDLER(drawTextBlob),
+    HANDLER(drawTextRSXform),
+    HANDLER(drawPatch),
+    HANDLER(drawPaint),
+    HANDLER(drawPoints),
+    HANDLER(drawRect),
+    HANDLER(drawPath),
+    HANDLER(drawOval),
+    HANDLER(drawRRect),
+    
+    HANDLER(drawImage),
+    HANDLER(drawImageRect),
+    HANDLER(drawImageNine),
+    HANDLER(drawImageLattice),
+    
+    HANDLER(drawVertices),
+    
+    HANDLER(drawPicture),
+    HANDLER(drawAnnotation),
+
+    HANDLER(defineImage),
+    HANDLER(defineTypeface),
+    HANDLER(defineFactory),
+    HANDLER(definePicture),
+    HANDLER(endPicture),        // handled special -- should never be called
+};
+#undef HANDLER
