new file mode 100644
index 0000000000000000000000000000000000000000..9a5d8e44f046082eacc6e68a4f9b6d7eddd6a9a6
--- /dev/null
+++ b/third_party/skia/src/gpu/GrClipStackClip.cpp
@@ -0,0 +1,495 @@
+/*
