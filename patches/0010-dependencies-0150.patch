+        static const auto kType = Type::DrawPoints;
+        DrawPoints(SkCanvas::PointMode mode, size_t count, const SkPaint& paint)
+            : mode(mode), count(count), paint(paint) {}
+        SkCanvas::PointMode mode;
+        size_t              count;
