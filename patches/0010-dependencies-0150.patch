new file mode 100644
index 0000000000000000000000000000000000000000..0d9e3677908f160f61b323e9d5d3fa7ea8b0f6b2
--- /dev/null
+++ b/third_party/skia/src/core/SkImageFilterCache.cpp
@@ -0,0 +1,134 @@
+/*
