+              '-lEGL',
+              '-lGLESv2',
+            ],
+          },
+        }],
+        [ 'skia_os == "linux" and skia_egl == 0', {
+          'link_settings': {
+            'libraries': [
+              '-lGL',
+              '-lGLU',
+              '-lX11',
+            ],
+          },
+        }],
+        [ 'skia_os == "mac"', {
+          'link_settings': {
