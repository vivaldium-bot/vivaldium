+ */
+
+#ifndef SkPedanticMath_DEFINED
+#define SkPedanticMath_DEFINED
+
+// To avoid UBSAN complaints about 2's compliment overflows
+//
+static inline int32_t SkSub32(int32_t a, int32_t b) {
