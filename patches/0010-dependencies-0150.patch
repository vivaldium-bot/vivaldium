+class GrRenderTarget;
+#endif
+
+class SkWindow : public SkView {
+public:
+            SkWindow();
+    virtual ~SkWindow();
+
+    struct AttachmentInfo {
+        AttachmentInfo()
+            : fSampleCount(0)
