+    SkNx operator >> (int bits) const { SHIFT16(vshr_n_u16, fVec, bits); }
+
+    static SkNx Min(const SkNx& a, const SkNx& b) { return vmin_u16(a.fVec, b.fVec); }
+
+    uint16_t operator[](int k) const {
