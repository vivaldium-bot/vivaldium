+void SkPDFDevice::drawRRect(const SkDraw& draw,
+                            const SkRRect& rrect,
+                            const SkPaint& srcPaint) {
+    SkPaint paint = srcPaint;
+    replace_srcmode_on_opaque_paint(&paint);
+    SkPath  path;
+    path.addRRect(rrect);
+    this->drawPath(draw, path, paint, nullptr, true);
+}
