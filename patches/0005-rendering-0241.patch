-  renderFrames: 16,
-  playbackRate: 1,
-  expected: [0,1,2,3,4,5,6,3,4,5,6,3,4,5,6,3] },
-
-{ loopStartFrame: 4,
-  loopEndFrame: 6,
-  renderFrames: 16,
-  playbackRate: 0.5,
-  expected: [0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 4, 4.5, 5, 5.5] },
