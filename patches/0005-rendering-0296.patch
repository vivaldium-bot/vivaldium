+
+// Test that we correctly restore the stack when continuing from a
+// finally block inside a for-in.
+
+var f = 0;
+var a = [1, 2, 3];
+
+for (x in a) {
+  try{
+    throw 'error';
+  } finally {
+    f++;
+    continue;
+  }
+}
+assertEquals(3, f);
+
+f = 0;
+for (x in a) {
+  try {
+    f++;
+  } finally {
+    f++;
+    continue;
+  }
+}
+assertEquals(6, f);
+
+f = 0;
+for (x in a) {
+  try {
+    f++;
+  } finally {
+    try {
+      throw 'error'
+    } finally {
+      try {
+        f++;
+      } finally {
+        f++;
+        continue;
+      }
+    }
+  }
+}
+assertEquals(9, f);
