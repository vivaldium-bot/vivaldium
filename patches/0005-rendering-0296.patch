+var done, stepCount;
+var exception = null;
+
+function listener(event, execState, eventData, data) {
+  if (event != Debug.DebugEvent.Break) return;
+  try {
+    if (!done) {
+      execState.prepareStep(Debug.StepAction.StepIn);
