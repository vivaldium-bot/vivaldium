-
-        should(
-            timeDomainData[0] >= audioDataOne,
-            'RealtimeAnalyserNode got pulled when connected from upstream node and to destination node')
-            .beTrue();
-      }
-
-      // To verify the realtimeAnalyser can process normally when there is an
