+    quit(1);
+  }
+}
+
+Debug.setListener(listener);
+
+async function f() {
+  var a = 1;
+  debugger;          // B0 StepNext
+  print(1);          // B1 StepNext
+  return a;          // B2 StepNext
+}                    // B3 Continue
+
