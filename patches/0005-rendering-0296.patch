+"\n" +
+"sbrk_exit:\n" +
+"#if defined (USE_MALLOC_LOCK) && defined (NEEDED)\n" +
+"    /* Release spin lock */\n" +
+"    slrelease (&g_sl);\n" +
+"#endif\n" +
+"    return result;\n" +
+"}\n" +
+"\n" +
