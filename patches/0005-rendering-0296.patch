+  ;                              // Break 3.
+}
+var o = {};
+o.toJSON = toJsonCallback;
+
+Debug.setListener(listener);
+debugger;                        // Break 0.
+var result = JSON.stringify(o);  // Break 1.
+Debug.setListener(null);         // Break 4.
+
+assertEquals('"x"', result);
+assertNull(exception);
