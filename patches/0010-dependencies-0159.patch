+%}
+
+%%
+
+"location"                    { return SkSL::Token::LOCATION; }
+"offset"                      { return SkSL::Token::OFFSET; }
+"binding"                     { return SkSL::Token::BINDING; }
+"index"                       { return SkSL::Token::INDEX; }
