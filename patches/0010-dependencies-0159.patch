+}
diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/PowerPC/2007-04-30-InlineAsmEarlyClobber.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/PowerPC/2007-04-30-InlineAsmEarlyClobber.ll
