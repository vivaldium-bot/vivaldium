+}
+
+void SPIRVCodeGenerator::writeString(const char* string, OutputStream& out) {
+    size_t length = strlen(string);
+    out.write(string, length);
+    switch (length % 4) {
+        case 1:
+            out.write8(0);
+            // fall through
+        case 2:
+            out.write8(0);
+            // fall through
+        case 3:
+            out.write8(0);
+            break;
+        default:
+            this->writeWord(0, out);
+    }
+}
