+STAGE(clamp_0) {
+    a = SkNf::Max(a, 0.0f);
+    r = SkNf::Max(r, 0.0f);
+    g = SkNf::Max(g, 0.0f);
+    b = SkNf::Max(b, 0.0f);
+}
+STAGE(clamp_1) {
+    a = SkNf::Min(a, 1.0f);
+    r = SkNf::Min(r, 1.0f);
+    g = SkNf::Min(g, 1.0f);
+    b = SkNf::Min(b, 1.0f);
+}
+STAGE(clamp_a) {
+    a = SkNf::Min(a, 1.0f);
+    r = SkNf::Min(r, a);
+    g = SkNf::Min(g, a);
+    b = SkNf::Min(b, a);
+}
+
+STAGE(unpremul) {
+    auto scale = (a == 0.0f).thenElse(0.0f, 1.0f/a);
+    r *= scale;
+    g *= scale;
+    b *= scale;
+}
+STAGE(premul) {
+    r *= a;
+    g *= a;
+    b *= a;
+}
