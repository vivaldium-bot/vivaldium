+    if (matrix) {
+        extra |= kHasMatrix_DrawPictureExtra;
+    }
+    if (paint) {
+        extra |= kHasPaint_DrawPictureExtra;
+    }
+    SkPipeWriter writer(this);
+    writer.write32(pack_verb(SkPipeVerb::kDrawPicture, extra));
+    if (matrix) {
+        writer.writeMatrix(*matrix);
+    }
+    if (paint) {
