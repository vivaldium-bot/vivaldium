+    const SkMatrix matrix = read_sparse_matrix(reader, tm);
+    if (packedVerb & kSetMatrix_ConcatMask) {
+        canvas->setMatrix(matrix);
+    } else {
+        canvas->concat(matrix);
+    }
+}
