+    virtual void draw(SkCanvas* canvas, const TestData& d,       \
+        skiatest::Reporter* reporter) {                                 \
+        FUNCTION (canvas, d, reporter, this);                    \
+    }                                                                   \
+    virtual const char* name() const {return #NAME ;}                   \
