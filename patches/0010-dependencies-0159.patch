+// FIXME: this should be in a header
+SkOSWindow* create_sk_window(void* hwnd, int argc, char** argv);
+SkOSWindow* create_sk_window(void* hwnd, int argc, char** argv) {
+    if (false) { // avoid bit rot, suppress warning
+        test();
+    }
+    return new SampleWindow(hwnd, argc, argv, nullptr);
+}
