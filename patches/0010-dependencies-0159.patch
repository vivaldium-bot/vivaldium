+void SkPDFDevice::drawRRect(const SkRRect& rrect,
+                            const SkPaint& srcPaint) {
+    SkPaint paint = srcPaint;
+    replace_srcmode_on_opaque_paint(&paint);
+    SkPath  path;
+    path.addRRect(rrect);
+    this->drawPath(path, paint, nullptr, true);
+}
