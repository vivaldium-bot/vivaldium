+void SkCanvas::onDrawAtlas(const SkImage* atlas, const SkRSXform xform[], const SkRect tex[],
+                           const SkColor colors[], int count, SkBlendMode bmode,
+                           const SkRect* cull, const SkPaint* paint) {
