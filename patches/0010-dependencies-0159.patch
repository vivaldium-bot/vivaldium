+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+bool SkBitmapDevice::onShouldDisableLCD(const SkPaint& paint) const {
+    if (kN32_SkColorType != fBitmap.colorType() ||
+        paint.getRasterizer() ||
+        paint.getPathEffect() ||
+        paint.isFakeBoldText() ||
+        paint.getStyle() != SkPaint::kFill_Style ||
+        !paint.isSrcOver())
+    {
+        return true;
+    }
+    return false;
+}
