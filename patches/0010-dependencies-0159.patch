+    if (0 == (fontNameLen = GetTextFace(deviceContext, 0, nullptr))) {
+        call_ensure_accessible(lf);
+        if (0 == (fontNameLen = GetTextFace(deviceContext, 0, nullptr))) {
+            fontNameLen = 0;
