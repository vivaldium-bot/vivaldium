+        canvas->drawLine(start, stop, paint); // should not be green
+        paint.setBlendMode(SkBlendMode::kSrcOver);
+        paint.setColorFilter(nullptr);
+
+        // rectangle
+        paint.setStyle(SkPaint::kFill_Style);
