@@ -0,0 +1,40 @@
+/*
+ * Copyright 2011 Google Inc.
+ *
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+#include "SkTypes.h"
+#if defined(SK_BUILD_FOR_WIN32)
+
+#include "SkHRESULT.h"
+
+void SkTraceHR(const char* file, unsigned long line, HRESULT hr, const char* msg) {
+    if (msg) {
+        SkDebugf("%s\n", msg);
+    }
+    SkDebugf("%s(%lu) : error 0x%x: ", file, line, hr);
+
+    LPSTR errorText = nullptr;
+    FormatMessageA(FORMAT_MESSAGE_ALLOCATE_BUFFER |
+                   FORMAT_MESSAGE_FROM_SYSTEM |
+                   FORMAT_MESSAGE_IGNORE_INSERTS,
+                   nullptr,
+                   hr,
+                   MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
+                   (LPSTR) &errorText,
+                   0,
+                   nullptr
+    );
+
+    if (nullptr == errorText) {
+        SkDebugf("<unknown>\n");
+    } else {
+        SkDebugf("%s", errorText);
+        LocalFree(errorText);
+        errorText = nullptr;
+    }
+}
+
+#endif//defined(SK_BUILD_FOR_WIN32)
diff --git a/third_party/skia/src/utils/win/SkHRESULT.h b/third_party/skia/src/utils/win/SkHRESULT.h
