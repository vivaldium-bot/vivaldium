+
+    c.setConcat(b, a);
+
+    d = a;
+    d.postConcat(b);
+    REPORTER_ASSERT(reporter, d == c);
+
+    c.mapScalars(src, dst); c.mapScalars(src + 4, dst + 4);
+    for (i = 0; i < 3; ++i) {
