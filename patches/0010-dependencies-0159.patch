+}
+
+static int lcanvas_drawRect(lua_State* L) {
+    SkRect rect;
+    lua2rect(L, 2, &rect);
+    const SkPaint* paint = get_obj<SkPaint>(L, 3);
+    get_ref<SkCanvas>(L, 1)->drawRect(rect, *paint);
+    return 0;
+}
