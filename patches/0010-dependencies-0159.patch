+    SkMatrix matrixStorage, *matrix = nullptr;
+    SkPaint paintStorage, *paint = nullptr;
+    if (extra & kHasMatrix_DrawPictureExtra) {
+        reader.readMatrix(&matrixStorage);
+        matrix = &matrixStorage;
+    }
+    if (extra & kHasPaint_DrawPictureExtra) {
