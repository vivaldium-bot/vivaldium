+sk_sp<SkTypeface> SkPipeInflator::makeTypeface(const void* data, size_t size) {
+    if (fTFDeserializer) {
+        return fTFDeserializer->deserialize(data, size);
+    }
+    SkMemoryStream stream(data, size, false);
+    return SkTypeface::MakeDeserialize(&stream);
+}
