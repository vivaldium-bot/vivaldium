index 0000000000000000000000000000000000000000..81e5bb9f30b226fb1485d498461fd53c48c4f60e
--- /dev/null
+++ b/third_party/skia/src/opts/SkXfermode_opts.h
@@ -0,0 +1,360 @@
+/*
