+DEF_TEST(SkAtScopeExit, r) {
+    int x = 5;
+    {
+        SK_AT_SCOPE_EXIT(x--);
+        REPORTER_ASSERT(r, x == 5);
+    }
+    REPORTER_ASSERT(r, x == 4);
+}
