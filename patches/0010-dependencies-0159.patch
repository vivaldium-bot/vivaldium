+class FontScalerTestView : public SampleView {
+    sk_sp<SkTypeface> fFaces[gFaceCount];
+
+public:
+    FontScalerTestView() {
+        for (int i = 0; i < gFaceCount; i++) {
+            fFaces[i] = SkTypeface::MakeFromName(gFaces[i].fName, gFaces[i].fStyle);
+        }
+    }
