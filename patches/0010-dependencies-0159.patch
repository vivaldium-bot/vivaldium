+
+    SkPaint pnt;
+    if (paint) {
+        pnt = *paint;
+    }
+
+    LOOPER_BEGIN(pnt, SkDrawFilter::kPath_Type, nullptr)
+    while (iter.next()) {
+        iter.fDevice->drawAtlas(atlas, xform, tex, colors, count, bmode, pnt);
+    }
+    LOOPER_END
+}
