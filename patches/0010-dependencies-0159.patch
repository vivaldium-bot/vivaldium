+
+static int loopNo = 4;
+
+static void testOpCirclesMain(PathOpsThreadState* data) {
+        SkASSERT(data);
+    PathOpsThreadState& state = *data;
+    SkString pathStr;
+    for (int a = 0 ; a < 6; ++a) {
+        for (int b = a + 1 ; b < 7; ++b) {
+            for (int c = 0 ; c < 6; ++c) {
