+        SkScalar sx = rand.nextSScalar1();
+        REPORTER_ASSERT(reporter, SkScalarCopySign(sx, sx) == sx);
+        REPORTER_ASSERT(reporter, SkScalarCopySign(sx, -sx) == -sx);
+        REPORTER_ASSERT(reporter, SkScalarCopySign(-sx, sx) == sx);
+        REPORTER_ASSERT(reporter, SkScalarCopySign(-sx, -sx) == -sx);
