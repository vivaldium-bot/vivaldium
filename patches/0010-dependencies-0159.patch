diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/PowerPC/mult-alt-generic-powerpc.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/PowerPC/mult-alt-generic-powerpc.ll
