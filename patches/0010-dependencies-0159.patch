+static void newOneOff(skiatest::Reporter* reporter, int outer, int inner) {
+    const CubicPts& cubic1 = newTestSet[outer];
+    const CubicPts& cubic2 = newTestSet[inner];
+    oneOff(reporter, cubic1, cubic2, false);
+}
