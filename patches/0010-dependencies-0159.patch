diff --git a/third_party/skia/src/core/SkColorTable.cpp b/third_party/skia/src/core/SkColorTable.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fab3c3dc1cdfbddc67051bb190337ae2d848cf1b
