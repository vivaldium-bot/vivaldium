+## drawPosTextH
+
+<pre style="padding: 1em 1em 1em 1em;width: 50em; background-color: #f0f0f0">
+void drawPosTextH(const void* text, size_t byteLength, const SkScalar xpos[],
+                  SkScalar constY, const SkPaint& paint)
