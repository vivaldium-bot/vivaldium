+#ifndef GrVkResourceProvider_DEFINED
+#define GrVkResourceProvider_DEFINED
+
+#include "GrGpu.h"
+#include "GrResourceHandle.h"
+#include "GrVkDescriptorPool.h"
+#include "GrVkDescriptorSetManager.h"
+#include "GrVkPipelineState.h"
