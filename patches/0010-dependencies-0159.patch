+
+    for (int i = 0; i < pixmap.info().width(); ++i) {
+        for (int j = 0; j < pixmap.info().height(); ++j) {
+            REPORTER_ASSERT(reporter, *pixmap.addr32(i, j) == 0);
+        }
+    }
+}
