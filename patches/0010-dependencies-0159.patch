+                          SkIntToScalar(R(static_cast<float>(kBitmapSize))));
+}
+
+static SkRegion make_region() {
+    SkIRect iRegion = SkIRect::MakeXYWH(R(static_cast<float>(kBitmapSize)),
+                                        R(static_cast<float>(kBitmapSize)),
