diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/mmx-copy-gprs.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/mmx-copy-gprs.ll
new file mode 100644
index 0000000000000000000000000000000000000000..377875565bf8b343c0e860e7082a72d54bd208b0
--- /dev/null
+++ b/third_party/swiftshader/third_party/LLVM/test/CodeGen/X86/mmx-copy-gprs.ll
@@ -0,0 +1,17 @@
+; RUN: llc < %s -mtriple=x86_64-linux   | FileCheck %s
+; RUN: llc < %s -mtriple=x86_64-win32   | FileCheck %s
+; RUN: llc < %s -march=x86 -mattr=-sse2 | FileCheck %s
+; RUN: llc < %s -march=x86 -mattr=+sse2 | FileCheck %s
+
+; This test should use GPRs to copy the mmx value, not MMX regs.  Using mmx regs,
+; increases the places that need to use emms.
+; CHECK-NOT: %mm
+; CHECK-NOT: emms
+; rdar://5741668
+
+define void @foo(<1 x i64>* %x, <1 x i64>* %y) nounwind  {
+entry:
+	%tmp1 = load <1 x i64>* %y, align 8		; <<1 x i64>> [#uses=1]
+	store <1 x i64> %tmp1, <1 x i64>* %x, align 8
+	ret void
+}
