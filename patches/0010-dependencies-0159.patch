+static void test_unscaled(skiatest::Reporter* reporter) {
+    int w = 10, h = 10;
+    SkRect r = SkRect::MakeWH(SkIntToScalar(w), SkIntToScalar(h));
+
+    SkBitmap filterResult, paintResult;
