index 0000000000000000000000000000000000000000..6d91fda3adcd1bf93b7e0d54df0de25f8125fbd6
--- /dev/null
+++ b/third_party/skia/samplecode/SampleDither.cpp
@@ -0,0 +1,172 @@
+/*
+ * Copyright 2011 Google Inc.
+ *
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+#include "SampleCode.h"
+#include "SkView.h"
+#include "SkCanvas.h"
