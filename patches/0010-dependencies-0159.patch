+static bool inner_simplify(skiatest::Reporter* reporter, const SkPath& path, const char* filename,
+        ExpectSuccess expectSuccess, SkipAssert skipAssert, ExpectMatch expectMatch) {
+#if 0 && DEBUG_SHOW_TEST_NAME
