+#define GL_CALL(IFACE, X)                                 \
+    SkASSERT(IFACE);                                      \
+    do {                                                  \
+        (IFACE)->fFunctions.f##X;                         \
+    } while (false)
+
+#define WM_EVENT_CALLBACK (WM_USER+0)
