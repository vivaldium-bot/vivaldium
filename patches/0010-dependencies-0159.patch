new file mode 100644
index 0000000000000000000000000000000000000000..5639d87b67972170a1cdfb900bfc181daa00202a
--- /dev/null
+++ b/third_party/skia/src/pdf/SkPDFFont.h
@@ -0,0 +1,138 @@
+/*
