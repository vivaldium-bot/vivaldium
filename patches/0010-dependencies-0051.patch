index 0000000000000000000000000000000000000000..acb78f520e48a56b3878eeb2eb72082a39643015
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/x86/yuv2rgb_template.c
@@ -0,0 +1,467 @@
+/*
+ * software YUV to RGB converter
+ *
+ * Copyright (C) 2001-2007 Michael Niedermayer
+ *           (c) 2010 Konstantin Shishkov
