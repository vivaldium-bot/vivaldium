+int CompactEncDet::BackmapEncodingToRankedEncoding(Encoding enc) {
+  for (int i = 0; i < NUM_RANKEDENCODING; ++i) {
+    if (kMapToEncoding[i] == enc) {
+      return i;
+    }
+  }
+  return -1;
