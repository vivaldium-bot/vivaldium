+            """ Set close-on-exec (not implemented, but not an error) """
+            # pylint: disable = W0613
+            pass
+    else:
+        def _set_cloexec(fd):
+            """ Set close-on-exec """
+            try:
+                flags = _fcntl.fcntl(fd, _fcntl.F_GETFD, 0)
+            except IOError:
+                pass
+            else:
+                # flags read successfully, modify
+                flags |= _fcntl.FD_CLOEXEC
+                _fcntl.fcntl(fd, _fcntl.F_SETFD, flags)
