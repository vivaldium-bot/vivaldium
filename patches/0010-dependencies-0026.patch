+def spawn(*argv, **kwargs):
+    """ Spawn a process """
+    if _sys.platform == 'win32':
+        newargv = []
+        for arg in argv:
+            if not arg or ' ' in arg or arg.startswith('"'):
+                arg = '"%s"' % arg.replace('"', '\\"')
+            newargv.append(arg)
+        argv = newargv
+        close_fds = False
+        shell = True
+    else:
+        close_fds = True
+        shell = False
