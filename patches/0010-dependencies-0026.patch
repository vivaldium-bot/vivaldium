+  border-top: 1px solid #36C;
+  background-color: #E5ECF9;
+}
+em {
+  font-style: normal;
+}
+.section {
+  margin: 0 0 0 0;
+  padding: 0 0 0 0;
+}
+.wholepage {
+  padding: 0 10px;
+}
+.body {
+  padding: 0;
+  margin: 0 0 1em 0;
+  margin-left: 203px;
+}
+.body {
+  position: relative;
+}
+code, pre {
+  color: #000;
+}
+span.pre {
+  font-family: monospace;
