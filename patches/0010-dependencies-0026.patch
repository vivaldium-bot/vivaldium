+                dirnames.remove(item)
+
+        dirnames.sort()
+        for name in _fnmatch.filter(dirnames, wildcard):
+            dest = _os.path.join(dirpath, name)
+            if dest.startswith(cwd):
+                dest = dest.replace(cwd, '', 1)
+            aslist = []
+            head, tail = _os.path.split(dest)
+            while tail:
+                aslist.append(tail)
+                head, tail = _os.path.split(head)
+            aslist.reverse()
+            dest = '/'.join(aslist)
+            yield dest
+
+        if not recursive:
