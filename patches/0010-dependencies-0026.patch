+/*
+ * The ABORT macros work with known local variables!
+ */
+#define ABORT_(RET) do {                                         \
+    if (source < ctx->sentinel && !(target < ctx->tsentinel)) {  \
+        *source_ = source;                                       \
+        *target_ = target;                                       \
+    }                                                            \
+    return RET;                                                  \
+} while(0)
+
