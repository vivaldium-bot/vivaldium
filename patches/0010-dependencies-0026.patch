+  margin: 1em 0 .5em;
+  padding: 0;
+}
+div.sphinxsidebar p, div.sphinxsidebar p.topless {
+  margin-top: 0;
+  padding-top: 0;
+}
+div.documentwrapper {
+  width:100%;
+  float:right;
+}
+div.sphinxsidebar ul,
+div.sphinxsidebar ul ul,
+div.sphinxsidebar ul.want-points,
+div.sphinxsidebar ul li {
+    margin-left: 0;
+}
+div.sphinxsidebar ul ul li {
+    margin-left: 1.5em;
+}
+#header {
+  position: relative;
+  min-height: 79px;
+}
+#header #searchbox {
+  position: absolute;
+  top: 15px;
+  left: 272px;
+}
+#header #searchbox .searchtip {
+  color: #AAA;
+  font-size: small;
+  height: 14px;
+  padding: 0;
+  margin: 0;
+}
+a.headerlink {
+  color: #000;
+  text-decoration: none;
+}
+/* API docs */
+dl.docutils {
+  margin-top: 0em;
+}
+dl.class,
+dl.attribute,
+dl.method,
+dl.function {
+  margin-top: 1em;
+  padding-top: 0.8em;
+  border-top: 1px dotted #B3B3B3;
+}
+dl.class, dl.data {
+  margin-top: 2em;
+  padding-top: 1.8em;
+  border-top: 1px solid #999;
+}
+tt, tt.descname, tt.descclassname, dt big, dt em {
+  font-size: 13px;
+}
+blockquote {
+  margin-left: 1em;
+}
+table.indextable, table.genindextable, table.modindextable {
+  border-width: 0 !important;
+  border-color: #FFF !important;
+}
