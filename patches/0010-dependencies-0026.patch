+    def mkstemp(suffix="", prefix=_tempfile.gettempprefix(), dir=None,
+                text=False):
+        """ Create secure temp file """
+        # pylint: disable = W0622
+        if dir is None:
+            dir = _tempfile.gettempdir()
+        if text:
+            flags = _text_openflags
+        else:
+            flags = _bin_openflags
