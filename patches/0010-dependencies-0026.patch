+        return make_manifest(manifest, config, docs, kwargs)
+
+    # monkey-patch crappy manifest writer away.
+    from distutils.command import sdist
+    sdist.sdist.get_file_list = sdist.sdist.read_manifest
+
+    return _core.setup(**kwargs)
