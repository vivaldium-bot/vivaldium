+    _text_openflags = _os.O_RDWR | _os.O_CREAT | _os.O_EXCL
+    _text_openflags |= getattr(_os, 'O_NOINHERIT', 0)
+    _text_openflags |= getattr(_os, 'O_NOFOLLOW', 0)
+
+    _bin_openflags = _text_openflags
+    _bin_openflags |= getattr(_os, 'O_BINARY', 0)
