+// Raw data get
+HRESULT RegKey::GetValue(const wchar_t* value_name,
+                         uint8_t** value,
+                         DWORD* byte_count,
+                         DWORD* type) const {
+  ASSERT(type != NULL);
+  ASSERT(byte_count != NULL);
+  ASSERT(value != NULL);
+
+  return GetValueHelper(value_name, type, value, byte_count);
+}
