+#ifdef GL_ES
+precision mediump float;
+#endif
+varying vec4 color;
+
+void main (void)
+{
+	const float M_PI = 3.14159265358979323846;
+	vec3 c = 2.0 * M_PI * ( fract(abs(color.rgb)) - 0.5 );
+	float sign =  1.0;
+	vec3 cos_c = vec3(-1.0, -1.0, -1.0);
+	float fact_even = 1.0;
+	float fact_odd  = 1.0;
