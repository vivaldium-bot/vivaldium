diff --git a/third_party/webrtc/base/platform_thread_unittest.cc b/third_party/webrtc/base/platform_thread_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..847946aaca4de991ba848f5b89c3ba0af08d7a91
--- /dev/null
