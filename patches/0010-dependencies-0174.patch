diff --git a/third_party/swiftshader/third_party/LLVM/test/ExecutionEngine/2005-12-02-TailCallBug.ll b/third_party/swiftshader/third_party/LLVM/test/ExecutionEngine/2005-12-02-TailCallBug.ll
