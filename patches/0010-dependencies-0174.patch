diff --git a/third_party/webrtc/base/fileutils_unittest.cc b/third_party/webrtc/base/fileutils_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..51396caefbbe000945368e0419223d2b7ec35327
--- /dev/null
