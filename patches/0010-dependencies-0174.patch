diff --git a/third_party/webrtc/base/logging_unittest.cc b/third_party/webrtc/base/logging_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d5bd9d4a0053632e3d65694fc8441f668cfded67
