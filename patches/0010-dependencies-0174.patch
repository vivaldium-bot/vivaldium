+
+        cpsie aif
+@ CHECK: cpsie aif                      @ encoding: [0x67,0xb6]
+
+        mov  r0, pc
+@ CHECK: mov  r0, pc                    @ encoding: [0x78,0x46]
diff --git a/third_party/swiftshader/third_party/LLVM/test/MC/ARM/thumb2-diagnostics.s b/third_party/swiftshader/third_party/LLVM/test/MC/ARM/thumb2-diagnostics.s
