+  bool GetDesktopList(DesktopDescriptionList* descriptions) override;
+  bool GetDesktopDimensions(const DesktopId& id,
+                            int* width,
+                            int* height) override;
+
+ private:
+  void* lib_handle_;
+  void* get_window_list_;
+  void* get_window_list_desc_;
+};
+
+}  // namespace rtc
+
+#endif  // WEBRTC_BASE_MACWINDOWPICKER_H_
