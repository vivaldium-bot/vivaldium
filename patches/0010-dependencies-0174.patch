+		scale.b *= float(i) / float(i + 1);
+	}
+	acos_c.b = M_PI / 2.0 - sign.b * acos_c.b;
+
+	color = vec4(acos_c / M_PI, 1.0);
+	gl_Position = gtf_ModelViewProjectionMatrix * gtf_Vertex;
