+// ----------------------------------------------------------------------------
+//  PlayoutDelay
+// ----------------------------------------------------------------------------
+
+int32_t AudioDeviceWindowsCore::PlayoutDelay(uint16_t& delayMS) const {
+  rtc::CritScope critScoped(&_critSect);
+  delayMS = static_cast<uint16_t>(_sndCardPlayDelay);
+  return 0;
+}
