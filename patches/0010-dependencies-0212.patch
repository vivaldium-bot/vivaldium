+        return tcuTestCase.IterateResult.STOP;
+    };
+
+    /**
+     * @param {tcuSurface.Surface} dst
+     * @param {
+     *  ?WebGLProgram|
+     *  framework.opengl.simplereference.sglrShaderProgram.ShaderProgram
+     * } program
+     * @param {number} width
+     * @param {number} height
