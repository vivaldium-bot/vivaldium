+                 if (e.getReason() == gl.FRAMEBUFFER_UNSUPPORTED) {
+                     // log << e;
+                     // m_testCtx.setTestResult(QP_TEST_RESULT_NOT_SUPPORTED, 'Not supported');
+                     assertMsgOptions(false, 'Not supported', true, false);
+                     return tcuTestCase.IterateResult.STOP;
+                 }
+             throw e;
+         }
