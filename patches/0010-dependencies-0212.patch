+                break;
+
+            case gluShaderUtil.DataType.UINT:
+                for (var i = 0; i < size; i++) {
+                    if (boolValue.val[i])
+                        result.val[i] = rnd.getInt(1, 10);
+                    else
+                        result.val[i] = 0;
+                }
+                break;
+
+            case gluShaderUtil.DataType.FLOAT:
+                for (var i = 0; i < size; i++) {
+                    if (boolValue.val[i]) {
+                        result.val[i] = rnd.getFloat(-10.0, 10.0);
