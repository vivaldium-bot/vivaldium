+  file.write('\n'.join(filelist))
+  file.close
+
+def main(argv):
+  """This is the main function."""
+  filelist = GenerateTests()
+  GenerateTestList(filelist)
+
+if __name__ == '__main__':
+  sys.exit(main(sys.argv[1:]))
