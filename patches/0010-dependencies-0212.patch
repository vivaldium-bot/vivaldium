+TEST_F(H264SpropParameterSetsTest, InvalidData) {
+  EXPECT_FALSE(h264_sprop.DecodeSprop(","));
+  EXPECT_FALSE(h264_sprop.DecodeSprop(""));
+  EXPECT_FALSE(h264_sprop.DecodeSprop(",iA=="));
+  EXPECT_FALSE(h264_sprop.DecodeSprop("iA==,"));
+  EXPECT_TRUE(h264_sprop.DecodeSprop("iA==,iA=="));
+  EXPECT_FALSE(h264_sprop.DecodeSprop("--,--"));
+  EXPECT_FALSE(h264_sprop.DecodeSprop(",,"));
+  EXPECT_FALSE(h264_sprop.DecodeSprop("iA=="));
+}
