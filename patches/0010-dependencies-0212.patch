+int32_t AudioDeviceWindowsCore::MaxSpeakerVolume(uint32_t& maxVolume) const {
+  if (!_speakerIsInitialized) {
+    return -1;
+  }
+
+  maxVolume = static_cast<uint32_t>(MAX_CORE_SPEAKER_VOLUME);
+
+  return 0;
+}
