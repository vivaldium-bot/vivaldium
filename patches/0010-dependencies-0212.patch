+			'${HEADER}\n' +
+			'uniform mediump float uf_one;\n' +
+			'uniform int ui_two;\n' +
+			'' +
+			'struct S {\n' +
+			'    mediump float    a;\n' +
+			'    mediump vec3    b;\n' +
+			'    int                c;\n' +
+			'};\n' +
+			'uniform S a;\n' +
+			'uniform S b;\n' +
+			'uniform S c;\n' +
+			'' +
