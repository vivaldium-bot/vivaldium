+        return gluShaderProgram.containerTypes.TRANSFORM_FEEDBACK_VARYINGS;
+    };
+};
+
+/**
+ * @constructor
+ */
+gluShaderProgram.ProgramSeparable = function(separable) {
+    this.separable = separable;
