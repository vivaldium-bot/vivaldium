+#ifndef WEBRTC_P2P_QUIC_QUICTRANSPORTCHANNEL_H_
+#define WEBRTC_P2P_QUIC_QUICTRANSPORTCHANNEL_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "net/quic/quic_crypto_client_stream.h"
+#include "net/quic/quic_packet_writer.h"
