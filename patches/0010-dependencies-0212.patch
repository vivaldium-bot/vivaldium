+  // Codecs does not support internal FEC, cannot enable FEC.
+  RegisterSendCodec('A', kNameG722, 16000);
+  EXPECT_FALSE(_acmA->REDStatus());
+  EXPECT_EQ(-1, _acmA->SetCodecFEC(true));
+  EXPECT_FALSE(_acmA->CodecFEC());
