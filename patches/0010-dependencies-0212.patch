+  RTC_DCHECK(thread_checker_.CalledOnValidThread());
+  RTC_LOG(LS_VERBOSE) << __FUNCTION__;
+
+  // Reset the index to -1
+  _paInputDeviceIndex = -1;
+  _paRecStream = NULL;
