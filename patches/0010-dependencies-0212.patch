+        PaSetVolumeCallback(pa_context* /*c*/, int success, void* /*pThis*/);
+    void PaSinkInfoCallbackHandler(const pa_sink_info *i, int eol);
+    void PaSinkInputInfoCallbackHandler(const pa_sink_input_info *i, int eol);
