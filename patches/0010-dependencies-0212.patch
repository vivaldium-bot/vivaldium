+  auto* sp = encoder_factory_->codec_manager.GetStackParams();
+  if (sp->speech_encoder)
+    encoder_stack_ = encoder_factory_->rent_a_codec.RentEncoderStack(sp);
+  return 0;
+#else
+  RTC_LOG(LS_WARNING) << "  WEBRTC_CODEC_RED is undefined";
+  return -1;
+#endif
+}
