+  virtual void SetUp() {
+    packet_.is_first_packet_in_frame = true;
+    packet_.dataPtr = data_;
+    packet_.sizeBytes = 1400;
+    packet_.seqNum = 1234;
+    packet_.timestamp = 1;
+    packet_.markerBit = true;
+    packet_.frameType = kVideoFrameKey;
