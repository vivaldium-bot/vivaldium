+            es3fFboStateQueryTests.colorBits[2],
+            es3fFboStateQueryTests.colorBits[3],
+            -1,
+            -1);
+    }
+
+    if (this.attachmentExists(gl.DEPTH)) {
+        checkAttachmentComponentSizeAtLeast.bind(this,
+            gl.FRAMEBUFFER,
+            gl.DEPTH,
+            -1,
+            -1,
+            -1,
+            -1,
+            es3fFboStateQueryTests.depthBits,
+            -1);
+    }
