+    };
+
+    /**
+     * @return {?sglrReferenceContext.AnyRenderbuffer}
+     */
+    es3fFboRenderTest.Framebuffer.prototype.getColorBuffer = function() {
+        return this.m_colorBuffer;
+    };
+
+    /**
+     * @return {?sglrReferenceContext.AnyRenderbuffer}
