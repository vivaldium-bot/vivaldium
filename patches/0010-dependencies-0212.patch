+    return new rtc::RefCountedObject<DummySetSessionDescriptionObserver>();
+  }
+  virtual void OnSuccess() { RTC_LOG(INFO) << __FUNCTION__; }
+  virtual void OnFailure(const std::string& error) {
+    RTC_LOG(INFO) << __FUNCTION__ << " " << error;
+  }
+
+ protected:
