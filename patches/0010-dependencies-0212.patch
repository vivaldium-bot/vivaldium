+
+functional.gles3.es3fTextureFormatTests.run(gl, [%(start)s, %(end)s]);
+</script>
+</body>
+</html>
+"""
+
+_GROUPS = [
+    'unsized_2d',
+    'unsized_2d_array',
+    'unsized_3d',
+    'sized_color_2d_pot_00',
