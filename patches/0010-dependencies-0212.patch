+        }
+        testGroup.addChild(layerTests);
+
+        /** @type {tcuTestCase.DeqpTest} */
+        var sampleTests = tcuTestCase.newTest('sample', 'Tests for multisample attachments');
+        // some short hand
+        var samples = es3fFboCompletenessTests.e_samples;
