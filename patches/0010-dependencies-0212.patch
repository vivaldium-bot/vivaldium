+  /**
+   * Test stopListening() immediately after the SurfaceTextureHelper has been setup.
+   */
+  @Test
+  @SmallTest
+  public void testStopListeningImmediately() throws InterruptedException {
+    final SurfaceTextureHelper surfaceTextureHelper =
