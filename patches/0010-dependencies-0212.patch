+            '#version 300 es\n' +
+            'uniform highp vec4 u_color;\n' +
+            'layout(location = 0) out highp ' + gluShaderUtil.getDataTypeName(outputType) + ' o_color;\n' +
+            'void main (void)\n' +
+            '{\n' +
+            ' o_color = ' + gluShaderUtil.getDataTypeName(outputType) + '(u_color);\n' +
