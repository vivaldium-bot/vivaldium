+        /** @type {tcuTexture.TextureFormat} */
+        var texFmt = this.m_textures[0].getRefTexture().getFormat();
+
+        /** @type {tcuTextureUtil.TextureFormatInfo} */
+        var fmtInfo = tcuTextureUtil.getTextureFormatInfo(texFmt);
