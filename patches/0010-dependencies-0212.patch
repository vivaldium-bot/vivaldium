+        -55.1, 1.1, 98.0, 19.0,
+        41.0, 65.0, 4.0, 12.0
+    ];
+
+    // the values of the matrix are returned in column major order but they can be given in either order
+
+    location = gl.getUniformLocation(program, 'mat2Uniform');
