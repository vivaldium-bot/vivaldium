+    tcuTexLookupVerifier.isLinearSampleResultValid_CoordAsVec3 = function(level, sampler, prec, coord, result) {
+        /** @type {Array<number>} */
+        var uBounds = tcuTexVerifierUtil.computeNonNormalizedCoordBounds(
