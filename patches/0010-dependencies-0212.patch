+    es3fFboRenderTest.getEnablingExtensions = function(format) {
+        /** @type {Array<string>} */ var out = [];
+
+        switch (format) {
+            case gl.RGB16F:
+                assertMsgOptions(false, "Not part of the tested formats", false, true);
+                break;
+
+            case gl.RGBA16F:
+            case gl.RG16F:
+            case gl.R16F:
+            case gl.RGBA32F:
+            case gl.RGB32F:
+            case gl.R11F_G11F_B10F:
+            case gl.RG32F:
+            case gl.R32F:
+                out.push('EXT_color_buffer_float');
+
+            default:
+                break;
+        }
