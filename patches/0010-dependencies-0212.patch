+
+  if (!acm2::RentACodec::IsPayloadTypeValid(rtp_payload_type)) {
+    RTC_LOG_F(LS_ERROR) << "Invalid payload-type " << rtp_payload_type
+                        << " for decoder.";
+    return false;
