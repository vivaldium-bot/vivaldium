+  }
+  if (randomTest) {
+    RunTest('A');
+  } else {
+    CurrentCodec('A');
+    ChangeCodec('A');
+    if (_codecCntrA == 0) {
+      fprintf(stdout, "\nTesting Delay ...\n");
+      TestDelay('A');
