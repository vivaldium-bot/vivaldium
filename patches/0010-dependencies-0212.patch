+            bufferedLogToConsole('gl.INVALID_VALUE is generated if flags is not zero.');
+            gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0x0010);
+            this.expectError(gl.INVALID_VALUE);
