+            gl.beginQuery(gl.TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN, ids[2]);
+            this.expectError(gl.INVALID_OPERATION);
+            gl.endQuery(gl.ANY_SAMPLES_PASSED);
