+        /** @type {gluShaderUtil.DataType} */
+        var fboSamplerType = gluTextureUtil.getSampler2DType(colorFormat);
+        /** @type {gluShaderUtil.DataType} */
+        var fboOutputType = es3fFboTestUtil.getFragmentOutputType(colorFormat);
+        /** @type {tcuTextureUtil.TextureFormatInfo} */
