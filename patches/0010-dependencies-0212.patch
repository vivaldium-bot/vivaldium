+    flatShader.setColor(ctx, flatShaderID, deMath.add(deMath.multiply([0, 0, 1, 1], cScale), cBias));
+    rrUtil.drawQuad(ctx, flatShaderID, [-1, -1, 0], [1, 1, 0]);
