+var deUtil = framework.delibs.debase.deUtil;
+
+/**
+ * @constructor
+ */
+es3fVertexArrayObjectTests.Attribute = function() {
+    this.enabled = false;
+    this.size = 1;
+    this.stride = 0;
+    this.type = gl.FLOAT;
+    this.integer = false;
+    this.divisor = 0;
+    this.offset = 0;
+    this.normalized = false;
+    this.bufferNdx = 0;
+};
+
+/**
+ * @constructor
