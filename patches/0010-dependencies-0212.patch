+     * @enum {number}
+     */
+    es3fInstancedRenderingTests.DrawFunction = {
+            FUNCTION_DRAW_ARRAYS_INSTANCED: 0,
+            FUNCTION_DRAW_ELEMENTS_INSTANCED: 1
+    };
+
+    /**
+     * es3fInstancedRenderingTests.InstancingType
