+#ifndef WEBRTC_PC_CHANNELMANAGER_H_
+#define WEBRTC_PC_CHANNELMANAGER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "webrtc/base/fileutils.h"
