+    es3fFramebufferBlitTests.BlitColorConversionCase.prototype.compare = function(reference, result) {
+        /** @const {tcuTexture.TextureFormat} */ var srcFormat = gluTextureUtil.mapGLInternalFormat(this.m_srcFormat);
