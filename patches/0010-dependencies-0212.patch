+        switch (targetScalarType) {
+            case gluShaderUtil.DataType.INT:
+                for (var i = 0; i < size; i++) {
+                    if (boolValue.val[i]) {
+                        result.val[i] = rnd.getInt(-10, 10);
+                        if (result.val[i] == 0)
