+                )
+            );
+            this.m_cases.push(
+                new es3fTextureFilteringTests.Texture3DFilteringCase.FilterCase(
+                    this.m_gridTex, [-0.8, -2.3, -2.5], [0.2, -0.1, 1.325]
+                )
+            );
