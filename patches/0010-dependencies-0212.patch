+    es3fTransformFeedbackTests.getAttributeName = function(varyingName, path) {
+    /** @type {string} */ var str = 'a_' + varyingName.substr(/^v_/.test(varyingName) ? 2 : 0);
+
+        for (var i = 0; i < path.length; ++i) {
