+
+            group.addChild(new es3fMultisampleTests.LineNumSamplesCase(
+                'num_samples_line',
+                'Test sanity of the sample count, with lines',
+                numFboSamples));
+
+            group.addChild(new es3fMultisampleTests.CommonEdgeCase(
+                'common_edge_small_quads',
