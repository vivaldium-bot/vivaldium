+  virtual bool Read(rtc::ByteBufferReader* buf);
+  virtual bool Write(rtc::ByteBufferWriter* buf) const;
+
+ private:
+  rtc::IPAddress GetXoredIP() const;
+  StunMessage* owner_;
+};
