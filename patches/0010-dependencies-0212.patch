+#ifndef MEDIA_ENGINE_WEBRTCVIDEOCAPTURER_H_
+#define MEDIA_ENGINE_WEBRTCVIDEOCAPTURER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "common_video/libyuv/include/webrtc_libyuv.h"
+#include "media/base/device.h"
