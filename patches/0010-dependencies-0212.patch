+    ctx.enable(gl.DEPTH_TEST);
+    ctx.enable(gl.STENCIL_TEST);
+    ctx.stencilOp(gl.KEEP, gl.KEEP, gl.REPLACE);
+    ctx.stencilFunc(gl.ALWAYS, 1, 0xff);
