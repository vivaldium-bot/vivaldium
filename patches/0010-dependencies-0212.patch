+  TRACE_EVENT0("webrtc", "NetEqImpl::InsertPacket");
+  rtc::CritScope lock(&crit_sect_);
+  if (InsertPacketInternal(rtp_header, payload, receive_timestamp) != 0) {
+    return kFail;
+  }
+  return kOK;
