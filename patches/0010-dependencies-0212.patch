diff --git a/third_party/webrtc/media/base/fakemediaengine.h b/third_party/webrtc/media/base/fakemediaengine.h
new file mode 100644
index 0000000000000000000000000000000000000000..609b62f910a7c1e7e5080d1b8d595778282c7538
--- /dev/null
+++ b/third_party/webrtc/media/base/fakemediaengine.h
