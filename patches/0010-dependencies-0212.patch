+            /** @type {Array<gluShaderUtil.precision>} */ var precisionArray = rnd.choose(precisions, undefined, 1);
+            /** @type {gluShaderUtil.precision} */ var precision = precisionArray[0];
+            /** @type {number} */ var numLocations = useArray ? arrayLen : 1;
