+            '#version 300 es\n' +
+            'in highp vec4 a_position;\n' +
+            'void main (void)\n' +
+            '{\n' +
+            ' gl_Position = a_position;\n' +
+            ' gl_PointSize = ' + pointSize + '.0;\n' +
+            '}\n'));
