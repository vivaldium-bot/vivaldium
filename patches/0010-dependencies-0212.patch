+// Macro that calls a COM method returning HRESULT value.
+#define EXIT_ON_ERROR(hres) \
+  do {                      \
+    if (FAILED(hres))       \
+      goto Exit;            \
+  } while (0)
+
+// Macro that continues to a COM error.
