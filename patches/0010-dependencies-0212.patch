+				es3fShaderStructTests.setUniform1i(programID, "a.c", 2);
+				es3fShaderStructTests.setUniform1f(programID, "b.a", 1.0);
+				es3fShaderStructTests.setUniform3fv(programID, "b.b", [0.0, 1.0, 2.0]);
