+        for (var y = 0; y < renderedImg.getHeight(); y++)
+        for (var x = 0; x < renderedImg.getWidth(); x++) {
+            if (new tcuRGBA.RGBA(renderedImg.getPixel(x, y)).getGreen() > 0) {
