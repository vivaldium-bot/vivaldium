+  ~P2PTestConductor() {
+    if (initiating_client_) {
+      initiating_client_->set_signaling_message_receiver(nullptr);
+    }
+    if (receiving_client_) {
+      receiving_client_->set_signaling_message_receiver(nullptr);
+    }
+  }
