+#endif  // MODULES_AUDIO_CODING_AUDIO_NETWORK_ADAPTOR_DTX_CONTROLLER_H_
diff --git a/third_party/webrtc/modules/audio_coding/audio_network_adaptor/dtx_controller_unittest.cc b/third_party/webrtc/modules/audio_coding/audio_network_adaptor/dtx_controller_unittest.cc
