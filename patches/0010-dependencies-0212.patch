+    if (opts != undefined && opts[0] != undefined && opts[1] != undefined) {
+        if (opts[0] == 0x80000000 && opts[1] == 0x7fffffff) {
+            return deRandom.deRandom_getInt(rnd);
+        } else {
+            return opts[0] + (deRandom.deRandom_getInt(rnd) % (opts[1] - opts[0] + 1));
