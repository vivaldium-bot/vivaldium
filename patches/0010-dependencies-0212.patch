+es3fFboStateQueryTests.AttachmentSizeCase = function(name, description) {
+    es3fApiCase.ApiCase.call(this, name, description, gl);
+};
+
+setParentClass(es3fFboStateQueryTests.AttachmentSizeCase, es3fApiCase.ApiCase);
+
