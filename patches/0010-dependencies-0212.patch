+  EXPECT_EQ_SIMULATED_WAIT(Connection::STATE_WRITABLE, conn2->write_state(),
+                           kSimulatedRtt * 2, fake_clock_);
+
+  turn_port_->Close();
+  SIMULATED_WAIT(false, kSimulatedRtt, fake_clock_);
+  turn_unknown_address_ = false;
+  conn2->Ping(0);
+  SIMULATED_WAIT(false, kSimulatedRtt, fake_clock_);
