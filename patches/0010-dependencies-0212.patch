+            if (ndx == 0) {
+                fbo.m_colorBuffer = buf;
+            } else {
+                fbo.m_depthStencilBuffer = buf;
+            }
+        }
+
+        // Rebind.
+        if (this.m_rebind) {
+            for (var ndx = 0; ndx < 3; ndx++) {
+                var bit = ndx == 0 ? gl.COLOR_BUFFER_BIT :
+                    ndx == 1 ? gl.DEPTH_BUFFER_BIT :
+                    ndx == 2 ? gl.STENCIL_BUFFER_BIT : 0;
