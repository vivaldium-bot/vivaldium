+AudioMixerManagerLinuxPulse::~AudioMixerManagerLinuxPulse() {
+  RTC_DCHECK(thread_checker_.CalledOnValidThread());
+  RTC_LOG(LS_INFO) << __FUNCTION__ << " destroyed";
+
+  Close();
+}
