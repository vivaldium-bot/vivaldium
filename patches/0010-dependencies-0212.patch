+  ProtocolAddress server_address_;
+  TlsCertPolicy tls_cert_policy_ = TlsCertPolicy::TLS_CERT_POLICY_SECURE;
+  RelayCredentials credentials_;
+  AttemptedServerSet attempted_server_addresses_;
