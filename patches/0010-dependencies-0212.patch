new file mode 100644
index 0000000000000000000000000000000000000000..a8d1bdfe0adaff479310045975ef082251fbce7c
--- /dev/null
+++ b/third_party/webrtc/modules/audio_coding/neteq/tools/encode_neteq_input.cc
@@ -0,0 +1,88 @@
+/*
