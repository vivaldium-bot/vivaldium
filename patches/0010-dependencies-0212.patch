+    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(fullscreenQuad), gl.STATIC_DRAW);
+};
+
+es3fDefaultVertexAttributeTests.AttributeCase.prototype.deinit = function() {
+    this.m_loader = null;
+
+    gl.useProgram(null);
+    this.m_program = null;
+
