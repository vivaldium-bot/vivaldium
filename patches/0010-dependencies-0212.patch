+    'add_uniform',
+    'add_dynamic',
+    'sub_const',
+    'sub_uniform',
+    'sub_dynamic',
+    'mul_const_lowp',
+    'mul_const_mediump',
+    'mul_const_highp',
+    'mul_uniform_lowp',
+    'mul_uniform_mediump',
+    'mul_uniform_highp',
+    'mul_dynamic_lowp',
+    'mul_dynamic_mediump',
+    'mul_dynamic_highp',
+    'div_const',
