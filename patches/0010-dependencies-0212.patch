+bool PeerConnection::StartRtcEventLog_w(rtc::PlatformFile file,
+                                        int64_t max_size_bytes) {
+  if (!event_log_) {
+    return false;
+  }
+  return event_log_->StartLogging(file, max_size_bytes);
+}
