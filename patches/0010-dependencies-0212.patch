diff --git a/third_party/webrtc/examples/androidapp/src/org/appspot/apprtc/util/AsyncHttpURLConnection.java b/third_party/webrtc/examples/androidapp/src/org/appspot/apprtc/util/AsyncHttpURLConnection.java
