+            }
+        }
+
+    // .random
+
+        /** @type {Array<tcuTestCase.DeqpTest>} */ var randomGroup = [];
+        var numRandomGroups = 3;
+        for (var ii = 0; ii < numRandomGroups; ++ii) {
