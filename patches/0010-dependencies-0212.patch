+        /** @type {tcuSurface.Surface} */ var refImg = new tcuSurface.Surface(width, height);
+
+        /** @type {string} */ var vtxSource = '#version 300 es\n' +
+            'in highp vec4 a_position;\n' +
+            'void main (void)\n' +
+            '{\n' +
+            ' gl_Position = a_position;\n' +
