+TEST_F(SctpUtilsTest, TestIsOpenMessage) {
+  rtc::CopyOnWriteBuffer open(1);
+  open[0] = 0x03;
+  EXPECT_TRUE(webrtc::IsOpenMessage(open));
+
+  rtc::CopyOnWriteBuffer openAck(1);
+  openAck[0] = 0x02;
+  EXPECT_FALSE(webrtc::IsOpenMessage(openAck));
+
