+        return !this.m_path.length;
+    };
+    gluVarTypeUtil.SubTypeAccess.prototype.is = function(other) {
+        return (
+            gluVarTypeUtil.array_op_equivalent(this.m_path, other.m_path) &&
+            this.m_type.is(other.m_type)
