--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/deqp/functional/gles3/es3fSyncTests.js
@@ -0,0 +1,330 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program OpenGL ES Utilities
+ * ------------------------------------------------
+ *
