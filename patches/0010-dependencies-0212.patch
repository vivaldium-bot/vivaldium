index 0000000000000000000000000000000000000000..02919b6bf8b7328e7fd99338815a5ba205af1158
--- /dev/null
+++ b/third_party/webrtc/pc/jsepsessiondescription.cc
@@ -0,0 +1,199 @@
+/*
+ *  Copyright 2012 The WebRTC project authors. All Rights Reserved.
+ *
