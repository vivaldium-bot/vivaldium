+//     /*std::vector<GenericVec4>*/ this.shaderOutputs = [];
+//     /*std::vector<Fragment>*/ this.shadedFragments = [];
+//     /*float**/ this.fragmentDepthBuffer = depthEnabled ? [] : null;
