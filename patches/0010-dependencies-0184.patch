index 0000000000000000000000000000000000000000..a6e89f2ce674299094fac8d08cab62ca044313ec
--- /dev/null
+++ b/third_party/webgl/src/sdk/demos/mozilla/spore/sporeview.js
@@ -0,0 +1,395 @@
+/* -*- Mode: js2; js2-basic-offset: 2; indent-tabs-mode: nil; tab-width: 40; -*- */
+
+/*
+ Copyright (c) 2009  Mozilla Corporation
+
+ Permission is hereby granted, free of charge, to any person
+ obtaining a copy of this software and associated documentation
+ files (the "Software"), to deal in the Software without
