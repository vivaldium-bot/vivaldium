+	template <typename T, precision P>
+	GLM_FUNC_QUALIFIER typename tmat3x4<T, P>::col_type &
+	tmat3x4<T, P>::operator[]
+	(
+		length_t i
+	)
+	{
+		assert(i < this->length());
+		return this->value[i];
+	}
+
+	template <typename T, precision P>
+	GLM_FUNC_QUALIFIER typename tmat3x4<T, P>::col_type const &
+	tmat3x4<T, P>::operator[]
+	(
