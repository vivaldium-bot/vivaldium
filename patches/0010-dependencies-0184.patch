+"use strict";
+function testPrologue(gl, extensionTypeName) {
+    if (!gl.getExtension(extensionTypeName)) {
+        testPassed("No " + extensionTypeName + " support -- this is legal");
+        return false;
+    }
+    testPassed("Successfully enabled " + extensionTypeName + " extension");
+    return true;
+}
