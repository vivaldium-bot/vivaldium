+  '                            basisZ * rotatedPoint.y) * size +\n' +
+  '                       velocity * localTime +\n' +
+  '                       acceleration * localTime * localTime + \n' +
+  '                       position;\n' +
+  '\n' +
+  '  outputPercentLife = percentLife;\n' +
