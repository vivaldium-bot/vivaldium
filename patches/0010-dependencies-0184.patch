+	// abs
+	template <typename genFIType>
+	GLM_FUNC_QUALIFIER genFIType abs
+	(
+		genFIType const & x
+	)
+	{
+		return detail::compute_abs<genFIType, std::numeric_limits<genFIType>::is_signed>::call(x);
+	}
