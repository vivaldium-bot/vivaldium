index 0000000000000000000000000000000000000000..d5d2d94585a2b0b8dcfab3f017ec855a966bb123
--- /dev/null
+++ b/third_party/webgl/src/sdk/demos/common/webgl-utils.js
@@ -0,0 +1,176 @@
+/*
