+#extension GL_ARB_shading_language_420pack : enable
+layout(std140, binding = 0) uniform buf {
+        mat4 MVP;
+        vec4 position[12*3];
+        vec4 attr[12*3];
+} ubuf;
+
+layout (location = 0) out vec4 texcoord;
+
+out gl_PerVertex {
+        vec4 gl_Position;
