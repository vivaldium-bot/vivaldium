+  '  vec4 qx = orientation.xxxw * q2.xyzx;\n' +
+  '  vec4 qy = orientation.xyyw * q2.xyzy;\n' +
+  '  vec4 qz = orientation.xxzw * q2.xxzz;\n' +
+  '\n' +
+  '  mat4 localMatrix = mat4(\n' +
+  '      (1.0 - qy.y) - qz.z, \n' +
+  '      qx.y + qz.w, \n' +
+  '      qx.z - qy.w,\n' +
+  '      0,\n' +
+  '\n' +
+  '      qx.y - qz.w, \n' +
+  '      (1.0 - qx.x) - qz.z, \n' +
+  '      qy.z + qx.w,\n' +
+  '      0,\n' +
+  '\n' +
+  '      qx.z + qy.w, \n' +
+  '      qy.z - qx.w, \n' +
+  '      (1.0 - qx.x) - qy.y,\n' +
+  '      0,\n' +
+  '\n' +
