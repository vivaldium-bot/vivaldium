+; Look for something like: add BYTE PTR [eax],cl
+; CHECK-LABEL: rmw_add_i8_var
+; CHECK: add BYTE PTR [e{{ax|bx|cx|dx|bp|di|si}}],{{al|bl|cl|dl}}
