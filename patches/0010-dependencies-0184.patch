+		GLM_FUNC_DECL tmat2x3<T, P> & operator-- ();
+		GLM_FUNC_DECL tmat2x3<T, P> operator++(int);
+		GLM_FUNC_DECL tmat2x3<T, P> operator--(int);
+	};
