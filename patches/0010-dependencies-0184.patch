+        var b = Math.sin(rotate[1]);
+        if (b < 0) {
+            // b == -1
+            rotate[0] = Math.acos((row0[2] + row1[1]) / (1 - b)) + rotate[2];
+        } else {
+            // b == 1
+            rotate[0] = Math.asin((row1[2] + row0[1]) / (b + 1)) - rotate[2];
+        }
+    }
