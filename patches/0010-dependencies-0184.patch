+    [xx + (1 - xx) * c,
+     x * y * oneMinusCosine + z * s,
+     x * z * oneMinusCosine - y * s,
+     0],
+    [x * y * oneMinusCosine - z * s,
+     yy + (1 - yy) * c,
+     y * z * oneMinusCosine + x * s,
+     0],
+    [x * z * oneMinusCosine + y * s,
+     y * z * oneMinusCosine - x * s,
+     zz + (1 - zz) * c,
+     0],
+    [0, 0, 0, 1]
