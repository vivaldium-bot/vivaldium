+    discard_server.c
+    echo_server.c
+    ekr_client.c
+    ekr_loop_offload.c
+    ekr_loop.c
+    ekr_peer.c
+    ekr_server.c
+    http_client.c
+    rtcweb.c
+    test_libmgmt.c
+    test_timer.c
+    tsctp.c
+)
+
+foreach (SOURCE_FILE ${CHECK_PROGRAMS})
+    get_filename_component(SOURCE_FILE_WE ${SOURCE_FILE} NAME_WE)
+    add_executable(
+        ${SOURCE_FILE_WE}
+        ${SOURCE_FILE}
+    )
+
+    target_link_libraries(${SOURCE_FILE_WE}
+        ${PROGRAMS_LINK_LIBRARY}
+        ${CMAKE_THREAD_LIBS_INIT}
+    )
+endforeach ()
