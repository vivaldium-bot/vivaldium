+  var cosX = Math.cos(v[0]);
+  var sinY = Math.sin(v[1]);
+  var cosY = Math.cos(v[1]);
+  var sinZ = Math.sin(v[2]);
+  var cosZ = Math.cos(v[2]);
+
+  var cosZSinY = cosZ * sinY;
+  var sinZSinY = sinZ * sinY;
+
+  var r00 = cosZ * cosY;
+  var r01 = sinZ * cosY;
+  var r02 = -sinY;
+  var r10 = cosZSinY * sinX - sinZ * cosX;
+  var r11 = sinZSinY * sinX + cosZ * cosX;
+  var r12 = cosY * sinX;
+  var r20 = cosZSinY * cosX + sinZ * sinX;
+  var r21 = sinZSinY * cosX - cosZ * sinX;
+  var r22 = cosY * cosX;
+
+  var m0 = m[0];
+  var m1 = m[1];
+  var m2 = m[2];
+  var m3 = m[3];
+
+  var m00 = m0[0];
+  var m01 = m0[1];
+  var m02 = m0[2];
+  var m03 = m0[3];
+  var m10 = m1[0];
+  var m11 = m1[1];
+  var m12 = m1[2];
+  var m13 = m1[3];
+  var m20 = m2[0];
+  var m21 = m2[1];
+  var m22 = m2[2];
+  var m23 = m2[3];
+  var m30 = m3[0];
+  var m31 = m3[1];
+  var m32 = m3[2];
+  var m33 = m3[3];
