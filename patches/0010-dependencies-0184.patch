+    ~AssembledTest() {
+      if (ExecutableData != nullptr) {
+#if defined(__unix__)
+        munmap(ExecutableData, Size);
+#elif defined(_WIN32)
+        VirtualFree(ExecutableData, 0, MEM_RELEASE);
+#endif
