+
+    uint32_t esi() const { return contentsOfDword(AssembledTest::EsiSlot); }
+
+    uint32_t ebp() const { return contentsOfDword(AssembledTest::EbpSlot); }
+
+    uint32_t esp() const { return contentsOfDword(AssembledTest::EspSlot); }
