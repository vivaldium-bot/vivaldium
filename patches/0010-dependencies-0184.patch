+define internal i32 @srem_i16(i32 %a.i32, i32 %b.i32) {
+entry:
+  %a = trunc i32 %a.i32 to i16
+  %b = trunc i32 %b.i32 to i16
+  %res = srem i16 %a, %b
+  %res.i32 = zext i16 %res to i32
+  ret i32 %res.i32
+; CHECK-LABEL: srem_i16
