+/**
+ * @fileoverview Functions related to WebGL-relevant capability detection.
+ * @author wiltzius@google.com (Tom Wiltzius)
+ */
+
+self.onMessage = function(event) {
+  // ignore the message
+  return;
+}
+
+/**
+ * Tries to send a small ArrayBuffer to a worker to test if the browser
+ * supports transferable typed arrays. The worker is this file, so the
+ * name of this file matters (capabilities.js).
+ */
+function supportsTransferables() {
+  console.log('Testing browser transferable typed array capability');
+  var worker = new Worker('capabilities.js');
+  worker.postMessage = worker.webkitPostMessage || worker.postMessage;
+  var ab = new ArrayBuffer(1);
+  var supported = false;
+  try {
+    worker.postMessage(ab, [ab]);
+    if (ab.byteLength) {
+      console.log("Transferables aren't supported in this browser " +
+                  "(postMessage signature with transferables exists, " +
+                  "but not working)");
+    } else {
+      console.log('Transferables are supported!')
+      supported = true;
+    }
+  }
+  catch(err) {
+    console.log("Transferables aren't supported in this browser");
+  }
+  finally {
+    worker.terminate();
+    if(supported) {
+      return true;
+    }
+    else {
+      return false;
+    }
+  }
+}
+
