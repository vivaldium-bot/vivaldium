+	template <typename T, precision P>
+	template <typename V1, typename V2, typename V3>
+	GLM_FUNC_QUALIFIER tmat3x2<T, P>::tmat3x2
+	(
+		tvec2<V1, P> const & v1,
+		tvec2<V2, P> const & v2,
+		tvec2<V3, P> const & v3
+	)
+	{
+		this->value[0] = col_type(v1);
+		this->value[1] = col_type(v2);
+		this->value[2] = col_type(v3);
+	}
+
