index 0000000000000000000000000000000000000000..9ee46555df47f8ecbdd5c3acff34f977abb1ea7c
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/conformance/extensions/oes-element-index-uint.html
@@ -0,0 +1,447 @@
+<!--
+
+/*
+** Copyright (c) 2012 The Khronos Group Inc.
+**
+** Permission is hereby granted, free of charge, to any person obtaining a
