+  TestArithSS(64, xmm0, xmm1, xmm2);
+  TestArithSS(64, xmm1, xmm2, xmm3);
+  TestArithSS(64, xmm2, xmm3, xmm4);
+  TestArithSS(64, xmm3, xmm4, xmm5);
+  TestArithSS(64, xmm4, xmm5, xmm6);
