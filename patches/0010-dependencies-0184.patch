+; TEST1: seq=10
+; TEST1: seq=11
+
+; Several ways of expressing 3+4+5+6
+; RUN: %p2i -i %s -o /dev/null --args -verbose status -threads=0 \
+; RUN:   -test-status=3:7 \
+; RUN:   | FileCheck %s --check-prefix=TEST2
+; RUN: %p2i -i %s -o /dev/null --args -verbose status -threads=0 \
