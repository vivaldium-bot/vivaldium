+  TestImpl(eax, ebx, ecx, edx);
+  TestImpl(ebx, ecx, edx, esi);
+  TestImpl(ecx, edx, esi, edi);
+  TestImpl(edx, esi, edi, eax);
+  TestImpl(esi, edi, eax, ebx);
+  TestImpl(edi, eax, ebx, ecx);
