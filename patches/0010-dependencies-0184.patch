+		}
+
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			float func (float a)
+			{
+				for (int i = 0; i < 6; i++)
+				{
+					if (i == 0)
+						continue;
+					else if (i == 1)
+					{
+					}
+					else if (i == 3)
+						break;
+					else
+						return a;
+					a = -a;
+				}
+
+				return 1.0;
+			}
+
+			void main()
+			{
+				${SETUP}
+				out0 = func(in0);
+				${OUTPUT}
+			}
+		""
+	end
