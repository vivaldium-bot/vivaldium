diff --git a/third_party/swiftshader/third_party/subzero/tests_lit/llvm2ice_tests/regalloc_evict_non_overlap.ll b/third_party/swiftshader/third_party/subzero/tests_lit/llvm2ice_tests/regalloc_evict_non_overlap.ll
