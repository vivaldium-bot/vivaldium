+#define TestBlending(Src, Dst)                                                 \
+  do {                                                                         \
+    TestBlendingXmmXmm(                                                        \
+        Dst, (1.0, 2.0, 1.0, 2.0), Src, (-1.0, -2.0, -1.0, -2.0),              \
+        (uint64_t(0x8000000000000000ull), uint64_t(0x0000000080000000ull)),    \
+        blendvps, f32);                                                        \
