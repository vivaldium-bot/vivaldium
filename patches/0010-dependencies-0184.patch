+	{
+		GLM_STATIC_ASSERT(
+			std::numeric_limits<genType>::is_iec559,
+			"'trunc' only accept floating-point inputs");
+
+		// TODO, add C++11 std::trunk
+		return x < 0 ? -floor(-x) : floor(x);
+	}
