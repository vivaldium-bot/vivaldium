+// but we're only interested in one solution.
+//
+// As long as A is solved as above, C can be chosen arbitrarily. Proof for
+// this is omitted.
+//
+J3DIMatrix4.prototype.decompose = function(_translate, _rotate, _scale, _skew, _perspective)
+{
