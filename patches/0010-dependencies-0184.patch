+  m1.splice(0, 4,
+      r10 * m00 + r11 * m10 + r12 * m20,
+      r10 * m01 + r11 * m11 + r12 * m21,
+      r10 * m02 + r11 * m12 + r12 * m22,
+      r10 * m03 + r11 * m13 + r12 * m23);
