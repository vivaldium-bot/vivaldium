+#define TestImplValue(Value0, Src, Value1, Size)                               \
+  do {                                                                         \
+    TestImplOp(mul, Value0, Src, Value1, uint, Size);                          \
+    TestImplOp(imul, Value0, Src, Value1, int, Size);                          \
+  } while (0)
