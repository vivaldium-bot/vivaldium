+void dumpMatrix(const char *note, mat4x4 MVP) {
+    int i;
+
+    printf("%s: \n", note);
+    for (i = 0; i < 4; i++) {
+        printf("%f, %f, %f, %f\n", MVP[i][0], MVP[i][1], MVP[i][2], MVP[i][3]);
+    }
+    printf("\n");
+    fflush(stdout);
+}
+
+void dumpVec4(const char *note, vec4 vector) {
+    printf("%s: \n", note);
+    printf("%f, %f, %f, %f\n", vector[0], vector[1], vector[2], vector[3]);
+    printf("\n");
+    fflush(stdout);
+}
