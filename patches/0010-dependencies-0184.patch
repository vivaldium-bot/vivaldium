diff --git a/third_party/swiftshader/third_party/subzero/tests_lit/llvm2ice_tests/nacl-atomic-fence-all.ll b/third_party/swiftshader/third_party/subzero/tests_lit/llvm2ice_tests/nacl-atomic-fence-all.ll
