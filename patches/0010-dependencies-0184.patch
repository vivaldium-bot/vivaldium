+<body>
+<div id="description"></div>
+<div id="console"></div>
+<script>
+"use strict";
+GLSLGenerator.runFeatureTest({
+  feature: "ceil",
+  testFunc: "$(func)($(arg0))",
+  emuFunc: ["float $(func)_base(float value) {",
+            "  float m = mod(value, 1.0);",
+            "  return m != 0.0 ? (value + 1.0 - m) : value;",
+            "}"].join("\n"),
