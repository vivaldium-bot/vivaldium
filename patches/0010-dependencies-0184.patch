+  // 3D (oriented) vertex shader
+  'uniform mat4 worldViewProjection;\n' +
+  'uniform mat4 world;\n' +
+  'uniform vec3 worldVelocity;\n' +
+  'uniform vec3 worldAcceleration;\n' +
