+		this->value[1] = m[1];
+		this->value[2] = col_type(T(0));
+	}
+
+	template <typename T, precision P>
+	GLM_FUNC_QUALIFIER tmat3x2<T, P>::tmat3x2
+	(
+		tmat3x3<T, P> const & m
+	)
+	{
+		this->value[0] = col_type(m[0]);
+		this->value[1] = col_type(m[1]);
+		this->value[2] = col_type(m[2]);
