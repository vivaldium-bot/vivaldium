+				test c = test(in0.x, vec3(-in0.y, in0.z, -in0.x));
+
+				test[] x = test[3] (a, b, c);
+				test[] y = test[] (c, a, b, b, a);
+				test[13] z;
+
+				out0 = ivec3(x.length(), y.length(), z.length());
+				${OUTPUT}
+			}
+		""
+	end
+
+end # length
+
+group invalid "Invalid Functions"
+
+	case multidimensional_array1
+		version 300 es
+		expect compile_fail
+
+		both ""
+			#version 300 es
+			precision mediump float;
+			${DECLARATIONS}
+
+			void main ()
