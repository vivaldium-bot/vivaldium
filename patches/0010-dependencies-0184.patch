+	case return_after_loop_sequence
+		values
+		{
+			input float in0		= [ -0.5 | 1.5 ];
+			output float out0	= [ 0.5 | -1.5 ];
+		}
+
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			float func (float a)
+			{
+				for (int i = 0; i < 6; i++) // negate a
+				{
+					a = -a;
+					if (i == 4)
+						a = -a;
+				}
+
+				for (int i = 6; i < 10; i++) // keep a
+				{
+					if (i == 8)
+						continue;
+					else if (i == 9)
+						break;
+					a = -a;
+				}
+
+				return a;
+			}
+
+			void main()
+			{
+				${SETUP}
+				out0 = func(in0);
+				${OUTPUT}
+			}
+		""
+	end
