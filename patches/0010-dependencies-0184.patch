+static void configureLightAndMaterial()
+{
+    static GLfloat light0Position[] = { -0x40000 / 65536., 0x10000 / 65536., 0x10000 / 65536., 0  / 65536.};
+    static GLfloat light0Diffuse[] = { 0x10000 / 65536., 0x6666 / 65536., 0 / 65536., 0x10000  / 65536.};
+    static GLfloat light1Position[] = { 0x10000 / 65536., -0x20000 / 65536., -0x10000 / 65536., 0  / 65536.};
+    static GLfloat light1Diffuse[] = { 0x11eb / 65536., 0x23d7 / 65536., 0x5999 / 65536., 0x10000  / 65536.};
+    static GLfloat light2Position[] = { -0x10000 / 65536., 0 / 65536., -0x40000 / 65536., 0  / 65536.};
+    static GLfloat light2Diffuse[] = { 0x11eb / 65536., 0x2b85 / 65536., 0x23d7 / 65536., 0x10000  / 65536.};
+    static GLfloat materialSpecular[] = { 0x10000 / 65536., 0x10000 / 65536., 0x10000 / 65536., 0x10000  / 65536.};
+    // static GLfloat materialSpecular[] = { 0., 0., 0., 0. };
+
+    glLightfv(GL_LIGHT0, GL_POSITION, light0Position);
+    glLightfv(GL_LIGHT0, GL_DIFFUSE, light0Diffuse);
+    glLightfv(GL_LIGHT1, GL_POSITION, light1Position);
+    glLightfv(GL_LIGHT1, GL_DIFFUSE, light1Diffuse);
+    glLightfv(GL_LIGHT2, GL_POSITION, light2Position);
+    glLightfv(GL_LIGHT2, GL_DIFFUSE, light2Diffuse);
+    glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, materialSpecular);
+
+    glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 60. );
+    glEnable(GL_COLOR_MATERIAL);
+}
