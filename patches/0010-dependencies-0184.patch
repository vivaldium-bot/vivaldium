+}
+
+define <4 x float> @InsertV4xfloat(<4 x float> %v, i32 %i) {
+  %r0 = insertelement <4 x float> %v, float 3.0, i32 %i
+; CHECK: Error{{.*}} not {{.*}} constant
+; MIN: Error{{.*}} Invalid function record: <7 5 1 4>
