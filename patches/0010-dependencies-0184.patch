+    [coszsiny * sinx - sinz * cosx,
+     sinzsiny * sinx + cosz * cosx,
+     cosy * sinx,
+     0],
+    [coszsiny * cosx + sinz * sinx,
+     sinzsiny * cosx - cosz * sinx,
+     cosy * cosx,
+     0],
+    [0, 0, 0, 1]
+  ];
+};
