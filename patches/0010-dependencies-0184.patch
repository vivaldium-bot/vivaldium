+    test_url = path.join("sdk", "tests");
+  }
+
+  test_url = path.join(test_url, "webgl-conformance-tests.html");
+
+  if (!fs.existsSync(path.join(__dirname, "../..", test_url))) {
+    console.error("ERROR: Could not find test", test_url);
+    process.exit(1);
+  }
