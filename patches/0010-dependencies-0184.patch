+  m0.splice(0, 4,
+      r00 * m00 + r01 * m10 + r02 * m20,
+      r00 * m01 + r01 * m11 + r02 * m21,
+      r00 * m02 + r01 * m12 + r02 * m22,
+      r00 * m03 + r01 * m13 + r02 * m23);
