+    static constexpr char TestString[] = "(" #Size ", " #__VA_ARGS__ ")";      \
+    __ nop(Size);                                                              \
+    ASSERT_EQ(Size##u, codeBytesSize()) << TestString;                         \
+    ASSERT_TRUE(verifyBytes<Size>(codeBytes(), __VA_ARGS__)) << TestString;    \
