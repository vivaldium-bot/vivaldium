+var pass_re = /Tests PASSED: (\d+)/;
+var fail_re = /Tests FAILED: (\d+)/;
+var timeout_re = /Tests TIMED OUT: (\d+)/;
+
+function to_int(str) {
+  var val = parseInt(str);
+  if (isNaN(val)) {
+    return 0;
+  }
+  return val;
+}
