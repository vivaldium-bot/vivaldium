+; MIPS32: lw [[T1:.*]],
+; MIPS32: lw [[T2:.*]],
+; MIPS32: lw [[T3:.*]],
+; MIPS32: xor [[T4:.*]],a0,[[T0]]
+; MIPS32: sltiu [[T4]],[[T4]],1
+; MIPS32: xor [[T5:.*]],a1,[[T1]]
