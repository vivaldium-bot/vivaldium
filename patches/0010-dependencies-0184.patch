+	end
+
+	case return_in_nested_loop
+		values
+		{
+			input float in0		= [ -0.5 | 1.5 ];
+			output float out0	= [ 0.5 | -1.5 ];
+		}
+
+		both ""
+			precision mediump float;
+			${DECLARATIONS}
+
+			float func (float a)
+			{
+				for (int i = 0; i < 6; i++)
+				{
+					a = -a;
+					for (int j = 0; j < 4; j++)
+					{
+						a = -a;
+						if (i == 1)
+							return a;
+					}
+					if (i == 4)
+						return 1.0;
+				}
+				return 1.0;
+			}
+
+			void main()
+			{
+				${SETUP}
+				out0 = func(in0);
+				${OUTPUT}
+			}
