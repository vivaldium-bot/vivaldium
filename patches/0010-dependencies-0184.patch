+				{
+					highp vec4 val;
+				};
+
+				${VERTEX_DECLARATIONS}
+				out mediump float res;
+				void main()
+				{
+					res = val.x;
+					${VERTEX_OUTPUT}
+				}
+			""
+			fragment ""
+				#version 300 es
+
+				layout(packed) uniform Block
+				{
+					highp vec4 val;
+				};
+
+				precision mediump float;
+				${FRAGMENT_DECLARATIONS}
