+	// floor
+	template <typename genType>
+	GLM_FUNC_QUALIFIER genType floor(genType const & x)
+	{
+		GLM_STATIC_ASSERT(
+			std::numeric_limits<genType>::is_iec559,
+			"'floor' only accept floating-point inputs");
