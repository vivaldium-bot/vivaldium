+
+// TODO(joshualitt) - Break this file up during GrOp post implementation cleanup
+
+namespace {
+
+struct EllipseVertex {
+    SkPoint fPos;
+    GrColor fColor;
+    SkPoint fOffset;
+    SkPoint fOuterRadii;
+    SkPoint fInnerRadii;
+};
+
+struct DIEllipseVertex {
+    SkPoint fPos;
+    GrColor fColor;
