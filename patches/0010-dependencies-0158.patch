+        "OpName %1 \"\n\n\nfoo\nbar\"\n",         // multiple newlines
+        "OpName %1 \"\\\"foo\nbar\\\"\"\n",       // escaped quote
+        "OpName %1 \"\\\\foo\nbar\\\\\"\n",       // escaped backslash
