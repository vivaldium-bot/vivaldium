+			return INVALIDCALL();   // Shader contains unsupported operations
+		}
+
+		*shader = new Direct3DVertexShader9(this, function);
+
+		if(!*shader)
+		{
+			return OUTOFMEMORY();
+		}
+
+		(*shader)->AddRef();
+
+		return D3D_OK;
+	}
