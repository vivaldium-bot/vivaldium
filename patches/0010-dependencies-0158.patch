+TEST(Types, AllTypes) {
+  // Types in this test case are only equal to themselves, nothing else.
+  std::vector<std::unique_ptr<Type>> types;
+
+  // Forward Pointer
+  types.emplace_back(new ForwardPointer(10000, SpvStorageClassInput));
