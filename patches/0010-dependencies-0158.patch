index 0000000000000000000000000000000000000000..4704d406bc13c54c998757cb7da01d9e28c037ec
--- /dev/null
+++ b/third_party/spirv-tools-angle/src/source/opt/aggressive_dead_code_elim_pass.cpp
@@ -0,0 +1,436 @@
+// Copyright (c) 2017 The Khronos Group Inc.
