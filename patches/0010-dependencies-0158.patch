+	void SamplerCore::convertFixed12(Vector4s &cs, Vector4f &cf)
+	{
+		convertFixed12(cs.x, cf.x);
+		convertFixed12(cs.y, cf.y);
+		convertFixed12(cs.z, cf.z);
+		convertFixed12(cs.w, cf.w);
+	}
