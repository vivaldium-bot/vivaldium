+# License. See LICENSE.TXT for details.
+# 
+##===----------------------------------------------------------------------===##
+# 
+# This is the makefile for the Objective Caml Llvm_analysis interface.
+# 
+##===----------------------------------------------------------------------===##
+
+LEVEL := ../../..
+LIBRARYNAME := llvm_analysis
+UsedComponents := analysis
+UsedOcamlInterfaces := llvm
+
+include ../Makefile.ocaml
diff --git a/third_party/swiftshader/third_party/LLVM/bindings/ocaml/analysis/analysis_ocaml.c b/third_party/swiftshader/third_party/LLVM/bindings/ocaml/analysis/analysis_ocaml.c
