+#ifndef SkImage_Gpu_DEFINED
+#define SkImage_Gpu_DEFINED
+
+#include "GrClip.h"
+#include "GrContext.h"
+#include "GrGpuResourcePriv.h"
+#include "GrSurfaceProxyPriv.h"
