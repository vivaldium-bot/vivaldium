+(*===----------------------------------------------------------------------===
+ * Lexer Tokens
+ *===----------------------------------------------------------------------===*)
+
+(* The lexer returns these 'Kwd' if it is an unknown character, otherwise one of
+ * these others for known things. *)
+type token =
+  (* commands *)
+  | Def | Extern
+
+  (* primary *)
+  | Ident of string | Number of float
+
+  (* unknown *)
+  | Kwd of char
+
+  (* control *)
+  | If | Then | Else
+  | For | In
diff --git a/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter5/toplevel.ml b/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter5/toplevel.ml
