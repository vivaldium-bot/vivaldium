+        ExpectedOpCodeCapabilities{SpvOpFunction, CapabilitySet()},
+        ExpectedOpCodeCapabilities{SpvOpConvertFToS, CapabilitySet()},
+        ExpectedOpCodeCapabilities{SpvOpEmitStreamVertex,
