+        {"%1 = OpTypeFloat 32 %2 = OpTypePointer Workgroup %1", 2,
+         "_ptr_Workgroup_float"},
+        {"%1 = OpTypeBool %2 = OpTypePointer Private %1", 2,
+         "_ptr_Private_bool"},
+        // OpTypeForwardPointer doesn't force generation of the name for its
+        // target type.
