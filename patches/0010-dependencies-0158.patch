+
+private:
+    GrClearStencilClipOp(const GrFixedClip& clip, bool insideStencilMask,
+                         GrRenderTargetContext* rtc)
+            : INHERITED(ClassID())
+            , fClip(clip)
+            , fInsideStencilMask(insideStencilMask)
