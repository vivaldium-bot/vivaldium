+                             SPV_ENV_UNIVERSAL_1_1),
+              Eq("Expected id to start with %."));
+  EXPECT_THAT(CompileFailure("%1 = OpCreatePipeFromPipeStorage %2 3",
+                             SPV_ENV_UNIVERSAL_1_1),
