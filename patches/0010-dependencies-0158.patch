+			}
+			break;
+		case FORMAT_G8R8I:
+			{
+				signed char* gr = (signed char*)element;
+
+				r = gr[0];
+				g = gr[1];
+			}
+			break;
+		case FORMAT_G8R8UI:
+			{
+				unsigned char* gr = (unsigned char*)element;
+
+				r = gr[0];
+				g = gr[1];
+			}
+			break;
+		case FORMAT_R16I:
+			r = *((short*)element);
+			break;
+		case FORMAT_R16UI:
+			r = *((unsigned short*)element);
+			break;
+		case FORMAT_G16R16I:
+			{
+				short* gr = (short*)element;
+
+				r = gr[0];
+				g = gr[1];
+			}
+			break;
+		case FORMAT_G16R16:
+			{
+				unsigned int gr = *(unsigned int*)element;
+
+				g = (gr & 0xFFFF0000) * (1.0f / 0xFFFF0000);
