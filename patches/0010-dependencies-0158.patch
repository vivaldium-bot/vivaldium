+    SkDEBUGCODE(GrSingleOwner::AutoEnforce debug_SingleOwner(fContext->debugSingleOwner());)
+
+#if 0
+    extern bool (*gShouldDrawProc)();
+    #define CHECK_SHOULD_DRAW()                                 \
+        do {                                                    \
+            if (gShouldDrawProc && !gShouldDrawProc()) return;  \
+        } while (0)
+#else
