+			}
+		}
+
+		if(nPatchModeCaptured)
+		{
+			device->SetNPatchMode(nPatchMode);
+		}
+
+		for(int stage = 0; stage < 8; stage++)
+		{
+			for(int state = D3DTSS_COLOROP; state <= D3DTSS_CONSTANT; state++)
+			{
+				if(textureStageStateCaptured[stage][state])
