+                                                        const SkMatrix& viewMatrix,
+                                                        const SkRect& rect,
+                                                        const SkRect* localRect,
+                                                        const SkMatrix* localMatrix) {
+    return std::unique_ptr<GrLegacyMeshDrawOp>(
+            new NonAAFillRectPerspectiveOp(color, viewMatrix, rect, localRect, localMatrix));
+}
+};
+
