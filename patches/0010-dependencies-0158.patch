+		SetRenderState(D3DRS_CLIPPING, TRUE);
+		SetRenderState(D3DRS_LIGHTING, TRUE);
+		SetRenderState(D3DRS_AMBIENT, 0);
+		SetRenderState(D3DRS_FOGVERTEXMODE, D3DFOG_NONE);
