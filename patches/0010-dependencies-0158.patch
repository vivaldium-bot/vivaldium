+            : INHERITED(ClassID(), std::move(semaphore)) {}
+
+    void onExecute(GrOpFlushState* state) override {
+        state->gpu()->waitSemaphore(fSemaphore);
+    }
+
+    typedef GrSemaphoreOp INHERITED;
+};
