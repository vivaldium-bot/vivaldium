+      nullptr);
+  EXPECT_EQ(EncodeNumberStatus::kSuccess, rc);
+
+  // Hex parsing
+  rc = ParseAndEncodeIntegerNumber(
+      "0x7fff", type, [](uint32_t word) { EXPECT_EQ(0x00007fffu, word); },
+      nullptr);
+  EXPECT_EQ(EncodeNumberStatus::kSuccess, rc);
+  rc = ParseAndEncodeIntegerNumber(
+      "0xffff", type, [](uint32_t word) { EXPECT_EQ(0xffffffffu, word); },
