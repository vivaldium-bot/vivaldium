+				r = bgr[0];
+				g = bgr[1];
+				b = bgr[2];
+			}
+			break;
+		case FORMAT_G8R8I_SNORM:
+			{
+				signed char* gr = (signed char*)element;
+
+				r = (gr[0] & 0xFF00) * (1.0f / 0xFF00);
