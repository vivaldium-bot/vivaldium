+
+	long Direct3DVolumeTexture8::GetVolumeLevel(unsigned int level, IDirect3DVolume8 **volume)
+	{
+		TRACE("");
+
+		*volume = 0;   // FIXME: Verify
+
+		if(level >= GetLevelCount() || !volumeLevel[level])
+		{
+			return INVALIDCALL();
+		}
+
+		volumeLevel[level]->AddRef();
+		*volume = volumeLevel[level];
+
+		return D3D_OK;
