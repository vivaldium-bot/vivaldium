+			SetTextureStageState(i, D3DTSS_RESULTARG, D3DTA_CURRENT);
+			SetTextureStageState(i, D3DTSS_CONSTANT, 0x00000000);
+		}
+
+		for(int i = 0; i <= D3DVERTEXTEXTURESAMPLER3; i = (i != 15) ? (i + 1) : D3DVERTEXTEXTURESAMPLER0)
+		{
