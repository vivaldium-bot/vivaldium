+			captureSamplerState(sampler, D3DSAMP_MAXMIPLEVEL);
+			captureSamplerState(sampler, D3DSAMP_MAXANISOTROPY);
+			captureSamplerState(sampler, D3DSAMP_SRGBTEXTURE);
+			captureSamplerState(sampler, D3DSAMP_ELEMENTINDEX);
+		}
