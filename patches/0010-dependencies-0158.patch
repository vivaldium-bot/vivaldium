+			pixelShader->Release();
+		}
+
+		device->GetPixelShaderConstantF(0, pixelShaderConstantF[0], 32);
+		device->GetPixelShaderConstantI(0, pixelShaderConstantI[0], 16);
+		device->GetPixelShaderConstantB(0, pixelShaderConstantB, 16);
