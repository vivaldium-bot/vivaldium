+	void PixelProgram::ENDSWITCH()
+	{
+		loopRepDepth--;
+
+		BasicBlock *endBlock = loopRepEndBlock[loopRepDepth];
+
+		Nucleus::createBr(loopRepEndBlock[loopRepDepth]);
+		Nucleus::setInsertBlock(endBlock);
+
