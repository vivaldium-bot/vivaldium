+      %float = OpTypeFloat 32
+ %_ptr_float = OpTypePointer Uniform %float
+       %zero = OpConstantNull %float
+     %target = OpVariable %_ptr_float Uniform %zero
+  )";
+  CompileSuccessfully(spirv);
