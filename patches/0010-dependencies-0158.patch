+				case D3DSTENCILOP_DECR:
+					renderer->setStencilZFailOperation(sw::OPERATION_DECR);
+					break;
+				default:
+					ASSERT(false);
+				}
+				break;
+			case D3DRS_STENCILPASS:
+				switch(value)
+				{
+				case D3DSTENCILOP_KEEP:
