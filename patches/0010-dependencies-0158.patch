+	long Direct3D8::QueryInterface(const IID &iid, void **object)
+	{
+		TRACE("");
+
+		if(iid == IID_IDirect3D8 ||
+		   iid == IID_IUnknown)
+		{
+			AddRef();
+			*object = this;
+
+			return S_OK;
+		}
+
+		*object = 0;
+
+		return NOINTERFACE(iid);
+	}
