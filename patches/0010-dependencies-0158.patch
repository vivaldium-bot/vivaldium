+	void VertexProgram::M3X2(Vector4f &dst, Vector4f &src0, Src &src1)
+	{
+		Vector4f row0 = fetchRegister(src1, 0);
+		Vector4f row1 = fetchRegister(src1, 1);
+
+		dst.x = dot3(src0, row0);
+		dst.y = dot3(src0, row1);
+	}
