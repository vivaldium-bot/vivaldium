+				default:
+					ASSERT(false);
+				}
+				break;
+			case D3DRS_DITHERENABLE:
+			//	if(!init) UNIMPLEMENTED();
+				break;
+			case D3DRS_ALPHABLENDENABLE:
+				renderer->setAlphaBlendEnable(value != FALSE);
+				break;
+			case D3DRS_FOGENABLE:
+				renderer->setFogEnable(value != FALSE);
+				break;
+			case D3DRS_FOGCOLOR:
+				renderer->setFogColor(value);
