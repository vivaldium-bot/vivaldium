+	void Direct3DDevice8::SetCursorPosition(int x, int y, unsigned long flags)
+	{
+		TRACE("");
+
+		POINT point = {x, y};
+		HWND window = focusWindow ? focusWindow : presentParameters.hDeviceWindow;
