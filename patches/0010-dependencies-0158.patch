+
+		uniforms.luminanceScale4[0] = uniforms.luminanceScale4[1] = uniforms.luminanceScale4[2] = uniforms.luminanceScale4[3] = scale;
+	}
+
+	void TextureStage::setLuminanceOffset(float value)
