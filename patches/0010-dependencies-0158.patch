+		case D3DFMT_A1R5G5B5:
+		case D3DFMT_A4R4G4B4:
+		case D3DFMT_DXT1:
+		case D3DFMT_DXT2:
+		case D3DFMT_DXT3:
+		case D3DFMT_DXT4:
+		case D3DFMT_DXT5:
+		case D3DFMT_ATI1:
+		case D3DFMT_ATI2:
+			return true;
+		default:
+			return false;
+		}
+
+		return false;
+	}
