+    const uint64_t bits = i >> (64 - num_bits);
+    writer.WriteBits(bits, size_t(num_bits));
+  }
+
+  BitReaderWord64 reader(writer.GetDataCopy());
+  for (uint64_t i = 0; i < 65000; i += 25) {
+    const uint64_t num_bits = i % 64 + 1;
