+  bool RemoveDuplicatesExtInstImports(ir::IRContext* irContext) const;
+  bool RemoveDuplicateTypes(ir::IRContext* irContext) const;
+  bool RemoveDuplicateDecorations(ir::IRContext* irContext) const;
+};
