+			break;
+		case FORMAT_G16R16UI:
+			{
+				unsigned short* gr = (unsigned short*)element;
+
+				r = gr[0];
+				g = gr[1];
+			}
+			break;
+		case FORMAT_A2R10G10B10:
+			{
+				unsigned int argb = *(unsigned int*)element;
