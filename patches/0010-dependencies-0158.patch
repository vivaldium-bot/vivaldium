diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/PTX/MCTargetDesc/PTXBaseInfo.h b/third_party/swiftshader/third_party/LLVM/lib/Target/PTX/MCTargetDesc/PTXBaseInfo.h
