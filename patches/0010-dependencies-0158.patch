+	unsigned long Direct3D8::AddRef()
+	{
+		TRACE("");
+
+		return Unknown::AddRef();
+	}
+
+	unsigned long Direct3D8::Release()
+	{
+		TRACE("");
+
+		return Unknown::Release();
+	}
