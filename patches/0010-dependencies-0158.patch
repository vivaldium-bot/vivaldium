+#include <stdio.h>
+
+/* putchard - putchar that takes a double and returns 0. */
+extern double putchard(double X) {
+  putchar((char)X);
+  return 0;
+}
+
+/* printd - printf that takes a double prints it as "%f\n", returning 0. */
+extern double printd(double X) {
+  printf("%f\n", X);
+  return 0;
+}
diff --git a/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter7/codegen.ml b/third_party/swiftshader/third_party/LLVM/examples/OCaml-Kaleidoscope/Chapter7/codegen.ml
