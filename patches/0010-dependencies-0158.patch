diff --git a/third_party/swiftshader/third_party/LLVM/lib/Target/PowerPC/MCTargetDesc/PPCMCCodeEmitter.cpp b/third_party/swiftshader/third_party/LLVM/lib/Target/PowerPC/MCTargetDesc/PPCMCCodeEmitter.cpp
