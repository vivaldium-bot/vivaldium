+             OpEntryPoint Fragment %main "main" %img
+%void      = OpTypeVoid
+%int       = OpTypeInt 32 0
+%float     = OpTypeFloat 32
+%fnt       = OpTypeFunction %void
+%coord     = OpConstantNull %float
