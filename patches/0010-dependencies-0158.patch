+    GR_VK_CALL(gpu->vkInterface(), CmdCopyImage(fCmdBuffer,
+                                                srcImage->image(),
+                                                srcLayout,
+                                                dstImage->image(),
+                                                dstLayout,
+                                                copyRegionCount,
+                                                copyRegions));
