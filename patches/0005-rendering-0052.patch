-                return "HIERARCHY_REQUEST_ERR";
-            }
-
-            if (child.nodeType == Node.DOCUMENT_TYPE_NODE) {
-                return "HIERARCHY_REQUEST_ERR";
-            }
-
-            if (child && [].slice.call(parent_.childNodes, indexOf(child) + 1)
-                           .filter(isDoctype)) {
-                return "HIERARCHY_REQUEST_ERR";
