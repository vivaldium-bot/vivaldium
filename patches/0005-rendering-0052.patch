-var iStart = 0;
-var iStop = testRanges.length;
-
-if (/subtest=[0-9]+/.test(location.search)) {
-  var matches = /subtest=([0-9]+)/.exec(location.search);
-  iStart = Number(matches[1]);
-  iStop = Number(matches[1]) + 1;
-}
-
-var domTests = [];
-var positionTests = [];
-var fragTests = [];
