-  var cssInlineGrid = document.getElementById("css-inline-grid");
-  test(function() {
-      testComputedStyleDisplay(cssInlineGrid, "inline-grid");
-    }, "Test CSS display 'inline-grid'");
-
-  var jsGrid = document.getElementById("js-grid");
