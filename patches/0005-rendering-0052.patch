-	{c.fillStyle = (x%2 == 0)?'navy':'white';
-	c.beginPath();
-	c.moveTo(x,x);
-	c.lineTo(100-x,x);
-	c.lineTo(100-x,100-x);
-	c.lineTo(x,100-x);
-	c.closePath();
-	c.fill();}
-</script>
-</body>
