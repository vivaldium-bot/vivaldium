-                && parent_.nodeType == Node.DOCUMENT_NODE)
-            || (node.nodeType == Node.DOCUMENT_TYPE_NODE
-                && parent_.nodeType != Node.DOCUMENT_NODE)) {
-                    return "HIERARCHY_REQUEST_ERR";
