index 0000000000000000000000000000000000000000..e3b46de80d65c8159e43d317a73daf16bff8399f
--- /dev/null
+++ b/third_party/webrtc/modules/video_coding/frame_buffer.cc
@@ -0,0 +1,269 @@
+/*
