+  void SetMetricsObserver(webrtc::MetricsObserverInterface* observer) override {
+    channel_->SetMetricsObserver(observer);
+  }
+
+  void SetIceConfig(const IceConfig& config) override {
+    channel_->SetIceConfig(config);
+  }
