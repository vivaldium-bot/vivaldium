+#include "webrtc/modules/video_coding/video_coding_impl.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "webrtc/base/criticalsection.h"
+#include "webrtc/common_types.h"
+#include "webrtc/common_video/include/video_bitrate_allocator.h"
