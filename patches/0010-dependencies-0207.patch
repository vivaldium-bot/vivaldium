+    Port* port1 = CreateTcpPort(kLocalAddr1);
+    port1->SetIceRole(cricket::ICEROLE_CONTROLLING);
+    Port* port2 = CreateRelayPort(kLocalAddr2, rtype, proto, PROTO_TCP);
