+class Remb : public Psfb {
+ public:
+  static constexpr uint8_t kFeedbackMessageType = 15;
+  static constexpr size_t kMaxNumberOfSsrcs = 0xff;
+
+  Remb() : bitrate_bps_(0) {}
+  ~Remb() override {}
+
