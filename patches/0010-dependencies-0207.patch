+                                             &layer_sync, 0);
+    EXPECT_EQ(0, temporal_layer);
+    EXPECT_TRUE(layer_sync);
+    int key_frame_picture_id = picture_id;
+
+    // Change color.
+    plane_offset[kYPlane] += 1;
