+      else:
+        key_us_timestamp = key.last_modified.rstrip('Z') + '.000000Z'
+      fmt = '%Y-%m-%dT%H:%M:%S.%fZ'
+      try:
+        return datetime.datetime.strptime(key_us_timestamp, fmt)
+      except ValueError:
