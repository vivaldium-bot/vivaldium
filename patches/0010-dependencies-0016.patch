+
+    def build_tag_param_list(self, params, tags):
+        keys = sorted(tags.keys())
+        i = 1
+        for key in keys:
+            value = tags[key]
+            params['Tag.%d.Key' % i] = key
+            if value is not None:
+                params['Tag.%d.Value' % i] = value
+            i += 1
