+    DeleteTrackerFile(tracker_file_name)
+    src_obj_metadata = apitools_messages.Object(
+        bucket='bk1', name='obj1', etag='etag1', md5Hash='12345')
+    src_obj2_metadata = apitools_messages.Object(
