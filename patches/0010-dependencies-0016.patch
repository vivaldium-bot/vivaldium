+                    slave_instance_type='m1.small', num_instances=1,
+                    action_on_failure='TERMINATE_JOB_FLOW', keep_alive=False,
+                    enable_debugging=False,
+                    hadoop_version=None,
+                    steps=[],
+                    bootstrap_actions=[],
+                    instance_groups=None,
+                    additional_info=None,
