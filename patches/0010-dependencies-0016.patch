+      prev_corners = np.asfarray(([1000, 1000], [0, 1000], [0, 0], [1000, 0]))
+      self.assertFalse(sf._HasMovedFast(prev_corners, prev_corners))
+      not_moved = copy.deepcopy(prev_corners)
