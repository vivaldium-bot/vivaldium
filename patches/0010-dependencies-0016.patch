+    import setuptools
+except ImportError:
+    from ez_setup import use_setuptools
+    use_setuptools()
+    import setuptools
+
+# Configure the required packages and scripts to install, depending on
+# Python version and OS.
+REQUIRED_PACKAGES = [
+    'httplib2>=0.8',
+    'oauth2client>=1.4.8',
+    'protorpc>=0.9.1',
+    'six>=1.9.0',
