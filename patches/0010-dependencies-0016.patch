+        + Google: `accounts.google.com`
+        + Amazon: `www.amazon.com`
+
+        """
+        params = {
+            'AccountId': account_id,
+            'IdentityPoolId': identity_pool_id,
+        }
+        if logins is not None:
+            params['Logins'] = logins
