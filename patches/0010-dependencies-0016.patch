+    # Check that |test_input_id| is not accessible from outside webview context
+    self.assertFalse(self._extension.EvaluateJavaScript(
+                    'document.getElementById("test_input_id") != null'))
diff --git a/third_party/catapult/telemetry/telemetry/internal/browser/network_quiescence.js b/third_party/catapult/telemetry/telemetry/internal/browser/network_quiescence.js
