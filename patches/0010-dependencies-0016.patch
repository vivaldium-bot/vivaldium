+        pairs = []
+        for pname in parameter_names:
+            pval = boto.utils.get_utf8_value(http_request.params[pname])
+            pairs.append(urllib.parse.quote(pname, safe='') + '=' +
+                         urllib.parse.quote(pval, safe='-_~'))
