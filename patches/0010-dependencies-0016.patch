+
+
+class TestBase(unittest.TestCase):
+  def setUp(self):
+    story_set = story.StorySet(base_dir=os.path.dirname(__file__))
+    story_set.AddStory(
+        page_module.Page("http://www.bar.com/", story_set, story_set.base_dir,
