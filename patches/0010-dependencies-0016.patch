+
+  UNPACKED_APP_ID = 'cbcdidchbppangcjoddlpdjlenngjldk'
+  UNPACKED_HASH_BYTES = \
+      '{0x21, 0x23, 0x83, 0x27, 0x1f, 0xf0, 0xd6, 0x29,' \
+      ' 0xe3, 0x3b, 0xf3, 0x9b, 0x4d, 0xd6, 0x9b, 0x3a,' \
