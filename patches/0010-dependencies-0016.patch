+        schema['type'] = 'object'
+        schema['properties'] = collections.OrderedDict()
+        if 'parameterOrder' not in method_description:
+            ordered_parameters = list(method_description.get('parameters', []))
+        else:
+            ordered_parameters = method_description['parameterOrder'][:]
