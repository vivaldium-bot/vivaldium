+    self.assertTrue(_HasValueNamed(d['per_page_values'], 'foo'))
+    self.assertTrue(_HasValueNamed(d['per_page_values'], 'bar'))
+
+  def testAsDictWithSummaryValueOnly(self):
+    results = page_test_results.PageTestResults()
