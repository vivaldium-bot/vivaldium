+dwarf2_line_op_bc_destroy(void *contents)
+{
+    dwarf2_line_op *line_op = (dwarf2_line_op *)contents;
+    if (line_op->operand)
+        yasm_intnum_destroy(line_op->operand);
+    if (line_op->ext_operand_int)
+        yasm_intnum_destroy(line_op->ext_operand_int);
+    yasm_xfree(contents);
+}
