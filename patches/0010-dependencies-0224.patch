+class CoreVideoFrameBuffer : public VideoFrameBuffer {
+ public:
+  explicit CoreVideoFrameBuffer(CVPixelBufferRef pixel_buffer);
+  CoreVideoFrameBuffer(CVPixelBufferRef pixel_buffer,
+                       int adapted_width,
+                       int adapted_height,
+                       int crop_width,
