diff --git a/third_party/webrtc/system_wrappers/include/static_instance.h b/third_party/webrtc/system_wrappers/include/static_instance.h
new file mode 100644
index 0000000000000000000000000000000000000000..f85a9121c4ccd5eb87bc3a8534bcf7b549cf1a61
--- /dev/null
+++ b/third_party/webrtc/system_wrappers/include/static_instance.h
@@ -0,0 +1,147 @@
+/*
