index 0000000000000000000000000000000000000000..2b71302a0855d9b44bc9b6c8c01fbda9f4dce39a
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/modules/dbgfmts/codeview/cv-symline.c
@@ -0,0 +1,1104 @@
+/*
+ * CodeView debugging format - symbol and line information
+ *
+ *  Copyright (C) 2006-2007  Peter Johnson
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
