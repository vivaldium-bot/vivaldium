+                       jobject j_video_frame_buffer);
+
+  void OnOutputFormatRequest(int width, int height, int fps);
+
+  rtc::scoped_refptr<SurfaceTextureHelper> surface_texture_helper() {
+    return surface_texture_helper_;
+  }
