+yasm_intnum *
+yasm_intnum_copy(const yasm_intnum *intn)
+{
+    yasm_intnum *n = yasm_xmalloc(sizeof(yasm_intnum));
+
+    switch (intn->type) {
+        case INTNUM_L:
+            n->val.l = intn->val.l;
+            break;
+        case INTNUM_BV:
+            n->val.bv = BitVector_Clone(intn->val.bv);
+            break;
+    }
+    n->type = intn->type;
+
+    return n;
+}
