index 0000000000000000000000000000000000000000..f7b341306eff5d58b04a7cbd77c90930b8993030
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/libyasm/tests/bitvect_test.c
@@ -0,0 +1,176 @@
+/*
+ *
+ *  Copyright (C) 2001-2007  Peter Johnson
