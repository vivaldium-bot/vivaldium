+
+extern "C" JNIEXPORT void JNICALL
+Java_org_webrtc_VideoTrack_nativeRemoveSink(JNIEnv* jni,
+                                            jclass,
+                                            jlong j_native_track,
+                                            jlong j_native_sink) {
+  reinterpret_cast<VideoTrackInterface*>(j_native_track)
