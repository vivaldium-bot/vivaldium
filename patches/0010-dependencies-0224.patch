+    mediaRecorder.setVideoFrameRate(profile.videoFrameRate);
+    mediaRecorder.setVideoSize(profile.videoFrameWidth, profile.videoFrameHeight);
+    mediaRecorder.setVideoEncodingBitRate(profile.videoBitRate);
