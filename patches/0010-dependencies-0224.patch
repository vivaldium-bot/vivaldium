index 0000000000000000000000000000000000000000..9b06fe3495b79db216bac78c25724ccc4e4de08b
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/modules/dbgfmts/codeview/cv-dbgfmt.c
@@ -0,0 +1,107 @@
+/*
+ * CodeView debugging formats implementation for Yasm
