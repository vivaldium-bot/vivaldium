+add rbx, strict byte 4
+add rbx, dword 4
+add rbx, strict dword 4
+add rbx, 400
+add rbx, strict 400
+add rbx, byte 400		; generates warning
+add rbx, strict byte 400	; generates warning
+add rbx, dword 400
+add rbx, strict dword 400
+
