+    opersize=16,
+    opcode=[0x0F, 0xA6],
+    operands=[Operand(type="Reg", size=16, dest="Spare"),
+              Operand(type="Mem", size=16, relaxed=True, dest="EA")])
+add_group("xbts",
+    cpu=["Undoc", "Obs", "386"],
+    opersize=32,
+    opcode=[0x0F, 0xA6],
+    operands=[Operand(type="Reg", size=32, dest="Spare"),
