+add [eax], byte 4		; same as byte [eax], 4
+add [eax], strict byte 4	; same as byte [eax], 4
+add [eax], dword 4		; generates dword [eax], byte 4
+add [eax], strict dword 4	; generates dword [eax], dword 4
