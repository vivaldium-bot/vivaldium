diff --git a/third_party/webrtc/sdk/objc/Framework/Classes/Metal/RTCMTLNV12Renderer.mm b/third_party/webrtc/sdk/objc/Framework/Classes/Metal/RTCMTLNV12Renderer.mm
new file mode 100644
