+r8b,	REG,	X86_REG8,	8,	64
+r9b,	REG,	X86_REG8,	9,	64
+r10b,	REG,	X86_REG8,	10,	64
+r11b,	REG,	X86_REG8,	11,	64
+r12b,	REG,	X86_REG8,	12,	64
+r13b,	REG,	X86_REG8,	13,	64
+r14b,	REG,	X86_REG8,	14,	64
