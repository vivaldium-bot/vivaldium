+++ b/third_party/yasm/source/patched-yasm/modules/arch/lc3b/lc3barch.h
@@ -0,0 +1,70 @@
+/*
+ * LC-3b Architecture header file
+ *
+ *  Copyright (C) 2003-2007  Peter Johnson
