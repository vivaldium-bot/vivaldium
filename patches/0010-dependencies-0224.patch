index 0000000000000000000000000000000000000000..2b3cf7a355c48999d444c481824b11a7ed71b821
--- /dev/null
+++ b/third_party/yasm/source/patched-yasm/modules/arch/lc3b/lc3bid.re
@@ -0,0 +1,480 @@
+/*
+ * LC-3b identifier recognition and instruction handling
+ *
