-                      text run at (0,0) width 167: "Known as ``Wilt the Stilt''"
-                      text run at (0,18) width 171: "and ``The Big Dipper,'' the"
-                      text run at (0,36) width 140: "7-foot-1 Chamberlain"
-                      text run at (0,54) width 164: "dominated the NBA from"
-                      text run at (0,72) width 165: "1959 through 1973, when"
-                      text run at (0,90) width 108: "he played for the"
-                      text run at (0,108) width 170: "Philadelphia (later the San"
-                      text run at (0,126) width 155: "Francisco) Warriors, the"
-                      text run at (0,144) width 160: "76ers and the Lakers. He"
-                      text run at (0,162) width 179: "scored 31,419 points during"
-                      text run at (0,180) width 165: "his career, averaging 30.1"
-                      text run at (0,198) width 131: "points for his career."
