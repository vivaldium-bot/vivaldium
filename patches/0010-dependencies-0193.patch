+// Check if the current host is big endian.
+inline bool IsHostBigEndian() {
+  static const int number = 1;
+  return 0 == *reinterpret_cast<const char*>(&number);
+}
+
+inline uint16_t HostToNetwork16(uint16_t n) {
+  uint16_t result;
+  SetBE16(&result, n);
+  return result;
+}
+
