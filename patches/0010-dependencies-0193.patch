diff --git a/third_party/webrtc/base/applefilesystem.mm b/third_party/webrtc/base/applefilesystem.mm
new file mode 100644
index 0000000000000000000000000000000000000000..9f015edf071502e02f24d1f9f7e8994388a88c55
--- /dev/null
+++ b/third_party/webrtc/base/applefilesystem.mm
@@ -0,0 +1,53 @@
+/*
