+#ifndef WEBRTC_BASE_HTTPCLIENT_H__
+#define WEBRTC_BASE_HTTPCLIENT_H__
+
+#include <memory>
+
+#include "webrtc/base/common.h"
+#include "webrtc/base/httpbase.h"
