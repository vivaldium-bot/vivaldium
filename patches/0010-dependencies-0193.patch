+  return result;
+}
+
+inline uint16_t NetworkToHost16(uint16_t n) {
+  return GetBE16(&n);
+}
+
+inline uint32_t NetworkToHost32(uint32_t n) {
+  return GetBE32(&n);
+}
+
+inline uint64_t NetworkToHost64(uint64_t n) {
+  return GetBE64(&n);
+}
