+  MOCK_METHOD1(Method1, std::string(std::string));
+  MOCK_CONST_METHOD1(ConstMethod1, std::string(std::string));
+
+  MOCK_METHOD2(Method2, std::string(std::string, std::string));
+
+ protected:
+  Fake() {}
+  ~Fake() {}
+};
