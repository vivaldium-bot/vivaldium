+namespace rtc {
+
+File::File(PlatformFile file) : file_(file) {}
+
+File::File() : file_(kInvalidPlatformFileValue) {}
+
+File::~File() {
+  Close();
+}
+
+File File::Open(const std::string& path) {
+  return File(OpenPlatformFile(path));
+}
+
+File File::Create(const std::string& path) {
