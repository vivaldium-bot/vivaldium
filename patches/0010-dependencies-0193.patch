+#ifndef WEBRTC_API_CALL_AUDIO_SEND_STREAM_H_
+#define WEBRTC_API_CALL_AUDIO_SEND_STREAM_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "webrtc/config.h"
+#include "webrtc/modules/audio_coding/codecs/audio_encoder.h"
