+#include <memory>
+
+#include "webrtc/api/test/peerconnectiontestwrapper.h"
+// Notice that mockpeerconnectionobservers.h must be included after the above!
+#include "webrtc/api/test/mockpeerconnectionobservers.h"
+#ifdef WEBRTC_ANDROID
