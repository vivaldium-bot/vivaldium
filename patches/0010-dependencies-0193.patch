+// This file contains structures used for retrieving statistics from an ongoing
+// libjingle session.
+
+#ifndef WEBRTC_API_STATSTYPES_H_
+#define WEBRTC_API_STATSTYPES_H_
+
+#include <algorithm>
+#include <list>
