-
-var socketsOpened = 0;
-var sockets = [];
-
-function createNewWebSocket()
-{
-    var ws = new WebSocket("ws://127.0.0.1:8880/echo");
-    sockets.push(ws);
-    ws.onopen = function() {
-        if (sockets.length < SOCKETS_TO_OPEN) {
-            createNewWebSocket();
-        }
-        ++socketsOpened;
-        if (socketsOpened == SOCKETS_TO_OPEN) {
-            cleanUpSocketsAndFinish();
-        }
-    };
-    ws.onclose = function() {
