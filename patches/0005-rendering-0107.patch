-        cleanUpSocketsAndFinish();
-    };
-}
-
-function cleanUpSocketsAndFinish()
-{
-    for (var ws of sockets) {
-        ws.onclose = null;
-        ws.close();
-    }
-    shouldBeEqualToNumber("socketsOpened", SOCKETS_TO_OPEN);
-    finishJSTest();
-}
-
-for (var i = 0; i < PARALLELISM; ++i) {
-    createNewWebSocket();
-}
-</script>
