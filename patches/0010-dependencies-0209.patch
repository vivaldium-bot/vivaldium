+typedef struct _QOS_DESTADDR
+{
+    QOS_OBJECT_HDR ObjectHdr;
+    const struct sockaddr* SocketAddress;
+    ULONG SocketAddressLength;
+} QOS_DESTADDR, *LPQOS_DESTADDR;
