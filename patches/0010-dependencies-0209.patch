+    gl.clearBufferfv(gl.COLOR, 1, [0.0,0.25,0.0,1.0]);
+    gl.clearBufferfv(gl.COLOR, 2, [0.0,0.0,0.25,1.0]);
+    gl.clearBufferfi(gl.DEPTH_STENCIL, 0, 1.0, 0);
