diff --git a/third_party/webrtc/api/video/video_timing.cc b/third_party/webrtc/api/video/video_timing.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3ccbe4eae5bf224b86e1e86e7ae41e3a00b4b494
--- /dev/null
