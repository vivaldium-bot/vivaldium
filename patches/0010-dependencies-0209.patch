+class AndroidDevice(object):
+    def __init__(self, id):
+        self.id = id
+
+    def get_prop(self, key):
+        cmd = AdbShellCmd('getprop | grep %s' % key, device_id=self.id)
+        match = re.search('\[%s\]: \[(.*)\]' % key, cmd.output)
