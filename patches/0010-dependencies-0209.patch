+int VoEAudioProcessingImpl::SetAgcConfig(AgcConfig config) {
+  WEBRTC_TRACE(kTraceApiCall, kTraceVoice, VoEId(_shared->instance_id(), -1),
+               "SetAgcConfig()");
+  if (!_shared->statistics().Initialized()) {
