+
+  rtc::scoped_refptr<IDirect3DTexture9> texture_;
+  rtc::scoped_refptr<IDirect3DVertexBuffer9> vertex_buffer_;
+};
+}  // namespace test
+}  // namespace webrtc
+
+#endif  // WEBRTC_TEST_WIN_D3D_RENDERER_H_
