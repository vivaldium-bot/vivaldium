+TEST(AudioSendStreamTest, ConfigToString) {
+  AudioSendStream::Config config(nullptr);
+  config.rtp.ssrc = kSsrc;
+  config.rtp.c_name = kCName;
+  config.voe_channel_id = kChannelId;
