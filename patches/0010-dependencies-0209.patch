+                         destruction_event, codec_width_, codec_height_),
+                     99, 99, kVideoRotation_0);
+    frame.set_ntp_time_ms(ntp_time_ms);
+    return frame;
+  }
+
+  VideoFrame CreateFrame(int64_t ntp_time_ms, int width, int height) const {
