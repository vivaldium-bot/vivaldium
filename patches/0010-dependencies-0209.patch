+  allocator_->AddObserver(&bitrate_observer_1, 100000, 400000, 0, false, "");
+  EXPECT_EQ(300000, allocator_->GetStartBitrate(&bitrate_observer_1));
+  allocator_->AddObserver(&bitrate_observer_2, 200000, 400000, 0, false, "");
