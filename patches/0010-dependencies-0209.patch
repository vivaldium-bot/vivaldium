+    Config config) {
+  switch (config.num_channels) {
+    case 1:
+      return rtc::MakeUnique<AudioDecoderG722Impl>();
+    case 2:
+      return rtc::MakeUnique<AudioDecoderG722StereoImpl>();
+    default:
