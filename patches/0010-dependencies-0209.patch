+    std::set<uint16_t> retransmitted_packets_;
+    uint64_t sent_rtp_packets_;
+    int packets_left_to_drop_;
+    int nacks_left_ GUARDED_BY(&crit_);
+  } test;
+
+  RunBaseTest(&test);
