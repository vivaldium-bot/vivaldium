+  MOCK_METHOD2(OnSsrcBoundToMid, void(const std::string& mid, uint32_t ssrc));
+  MOCK_METHOD3(OnSsrcBoundToMidRsid,
+               void(const std::string& mid,
+                    const std::string& rsid,
