+                                 uploadWidth, uploadHeight,
+                                 gl[pixelFormat], gl[pixelType], canvas);
+            } else {
+                gl.texImage2D(targets[tt], 0, gl[internalFormat],
+                              uploadWidth, uploadHeight, 0,
+                              gl[pixelFormat], gl[pixelType], canvas);
+            }
+        }
