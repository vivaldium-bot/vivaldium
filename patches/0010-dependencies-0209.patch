+VoEBase* VoEBase::GetInterface(VoiceEngine* voiceEngine) {
+  if (nullptr == voiceEngine) {
+    return nullptr;
+  }
+  VoiceEngineImpl* s = static_cast<VoiceEngineImpl*>(voiceEngine);
+  s->AddRef();
+  return s;
+}
