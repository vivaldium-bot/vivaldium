+          <a class="nonnormative" href="https://www.khronos.org/opengles/sdk/docs/man3/html/glDeleteSync.xhtml">man page</a>)
+        </span>.
+    </p>
+    <p>
+    </p>
+    <pre class="idl">interface <dfn id="WebGLSync">WebGLSync</dfn> : WebGLObject {
