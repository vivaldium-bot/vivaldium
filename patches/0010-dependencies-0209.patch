+  webrtc::EcModes ec_mode = webrtc::kEcDefault;
+
+  EXPECT_EQ(0, voe_apm_->GetEcStatus(ec_enabled, ec_mode));
+  EXPECT_FALSE(ec_enabled);
+  EXPECT_EQ(webrtc::kEcAecm, ec_mode);
