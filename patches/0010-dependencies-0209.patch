+    }
+
+    function setupSourceCanvasWebGL(canvas) {
+        var width = canvas.width;
+        var height = canvas.height;
+        var halfWidth = Math.floor(width / 2);
+        var halfHeight = Math.floor(height / 2);
+
+        var ctx = canvas.getContext('webgl');
