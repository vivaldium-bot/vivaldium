index 0000000000000000000000000000000000000000..636ff95e214f7ce69a57b0e9eab802a4346c2f63
--- /dev/null
+++ b/third_party/webgl/src/sdk/tests/js/tests/webgl-compressed-texture-size-limit.js
@@ -0,0 +1,243 @@
+/*
