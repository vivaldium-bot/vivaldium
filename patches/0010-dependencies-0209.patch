+TEST_F(VolumeTest, DefaultMicrophoneVolumeIsAtMost255) {
+  unsigned int volume = 1000;
+  bool could_get_mic_volume = voe_volume_control_->GetMicVolume(volume) == 0;
+#if !defined(WEBRTC_LINUX)
