+    "../rtc_base:rtc_base_approved",
+    "audio_codecs:audio_codecs_api",
+  ]
+}
+
+rtc_static_library("libjingle_peerconnection_api") {
+  cflags = []
+  sources = [
+    "candidate.cc",
+    "candidate.h",
+    "cryptoparams.h",
+    "datachannelinterface.h",
+    "dtmfsenderinterface.h",
+    "jsep.h",
