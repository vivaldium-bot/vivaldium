+TEST_F(VolumeTest, ManualTestChannelPanning) {
+  TEST_LOG("Panning left.\n");
+  EXPECT_EQ(0, voe_volume_control_->SetOutputVolumePan(channel_, 0.8f, 0.1f));
+  Sleep(1000);
