-        text run at (0,60) width 303: "been fixed in subsequent builds."
-    LayoutBlockFlow {H2} at (0,422.42) size 512x29
-      LayoutText {#text} at (0,-4) size 93x36
-        text run at (0,-4) width 93: "Bug 2"
-    LayoutBlockFlow {P} at (0,477.97) size 512x58
-      LayoutText {#text} at (0,7) size 504x44
-        text run at (0,7) width 504: "Fonts also render substantially smaller than other browsers, which is not a good thing"
