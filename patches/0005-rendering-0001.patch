+    if (!dictionary.get(key, v8Value))
+        return false;
+
+    int64_t int64Value;
+    if (!v8Call(v8Value->IntegerValue(dictionary.v8Context()), int64Value))
+        return false;
+    value = int64Value;
+    return true;
+}
