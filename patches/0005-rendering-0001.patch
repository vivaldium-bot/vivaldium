+    'idl_compiler_files': [
+      'idl_compiler.py',
+      # Blink IDL front end (ex-lexer/parser)
+      'idl_definitions.py',
+      'idl_reader.py',
+      'idl_types.py',
+      'idl_validator.py',
+      'interface_dependency_resolver.py',
