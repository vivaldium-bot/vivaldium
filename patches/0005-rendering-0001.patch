@@ -0,0 +1,195 @@
+// -*- Mode: c++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+//
+// Copyright (C) 2015 Opera Software ASA.  All rights reserved.
+//
