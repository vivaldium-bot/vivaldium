index 0000000000000000000000000000000000000000..dfb53df956529a2c8cc037083ce7cbc977b0280a
--- /dev/null
+++ b/third_party/WebKit/Source/bindings/core/v8/CallbackPromiseAdapter.h
@@ -0,0 +1,269 @@
+/*
