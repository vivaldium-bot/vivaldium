+    'idl_cache_files': [
+      '<(bindings_scripts_output_dir)/lextab.py',
+      '<(bindings_scripts_output_dir)/parsetab.pickle',
+      '<(bindings_scripts_output_dir)/cached_jinja_templates.stamp',
