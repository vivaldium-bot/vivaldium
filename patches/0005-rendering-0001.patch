+    v8::Local<v8::Value> v8Value;
+    if (!dictionary.get(key, v8Value))
+        return false;
+
+    double doubleValue;
+    if (!v8Call(v8Value->NumberValue(dictionary.v8Context()), doubleValue))
+        return false;
+    doubleToInteger(doubleValue, value);
+    return true;
+}
