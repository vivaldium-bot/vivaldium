+    int id = info[0].As<v8::Int32>()->Value();
+    String groupName = injectedScriptNative->groupName(id);
+    if (!groupName.isEmpty())
+        info.GetReturnValue().Set(v8String(info.GetIsolate(), groupName));
+}
