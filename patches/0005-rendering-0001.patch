+int SerializedScriptValueWriter::bytesNeededToWireEncode(uint32_t value)
+{
+    int bytes = 1;
+    while (true) {
+        value >>= SerializedScriptValue::varIntShift;
+        if (!value)
+            break;
+        ++bytes;
+    }
+
+    return bytes;
+}
