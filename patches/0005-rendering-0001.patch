+WMFMediaPipeline::AudioTimestampCalculator::AudioTimestampCalculator()
+    : channel_count_(0),
+      bytes_per_sample_(0),
+      samples_per_second_(0),
+      frame_sum_(0),
+      frame_offset_(0),
+      must_recapture_position_(false) {
+}
