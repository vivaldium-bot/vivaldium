+
+    EXPECT_EQ("undefined", onFulfilled);
+    EXPECT_EQ(String(), onRejected);
+}
+
+TEST_F(ScriptPromiseResolverTest, rejectVoid)
+{
+    RefPtrWillBeRawPtr<ScriptPromiseResolver> resolver = nullptr;
