+namespace blink {
+
+#if ENABLE(ASSERT)
+OnStackObjectChecker::~OnStackObjectChecker()
+{
+    // All dictionaries must be removed before the checker is destructed.
+    ASSERT(m_dictionaries.isEmpty());
+}
