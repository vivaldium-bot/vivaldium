+// Helper function that counts how many bits are set in the input number.
+int NumberOfSetBits(uint32_t i) {
+  int number_of_set_bits = 0;
+  while (i > 0) {
+    if (i & 1) {
+      number_of_set_bits++;
+    }
+    i = i >> 1;
+  }
+  return number_of_set_bits;
+}
