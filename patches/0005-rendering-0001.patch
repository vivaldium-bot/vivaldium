+  } else {
+    // On OS X, the expected hashes can be different, because our solution
+    // doesn't necessarily process frames one by one, see AVFMediaDecoder.
+    EXPECT_EQ("-4.97,-3.80,-3.26,-3.75,-4.90,-5.83,", GetAudioHash());
