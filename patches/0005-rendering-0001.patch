+void V8MediaQueryList::addListenerMethodEpilogueCustom(const v8::FunctionCallbackInfo<v8::Value>& info, MediaQueryList* impl)
+{
+    if (info.Length() >= 1 && info[0]->IsObject() && !impl->toNode())
