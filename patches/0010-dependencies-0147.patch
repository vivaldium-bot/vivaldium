+#if SK_SUPPORT_GPU
+#define kBogusContextType GrContextFactory::kNativeGL_ContextType
+#define kBogusContextOverrides GrContextFactory::ContextOverrides::kNone
+#else
+#define kBogusContextType 0
+#define kBogusContextOverrides 0
