+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  CCodec_IccModule icc_module;
+  uint32_t nComponent = 0;
+  void* transform = icc_module.CreateTransform_sRGB(data, size, nComponent);
+
+  if (transform) {
+    float src[4];
+    float dst[4];
