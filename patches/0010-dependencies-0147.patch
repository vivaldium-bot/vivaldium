+CFX_Matrix CPWL_Wnd::GetChildMatrix() const {
+  if (HasFlag(PWS_CHILD))
+    return m_sPrivateParam.mtChild;
+
+  return CFX_Matrix(1, 0, 0, 1, 0, 0);
+}
