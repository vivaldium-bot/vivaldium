diff --git a/third_party/skia/gm/bigtileimagefilter.cpp b/third_party/skia/gm/bigtileimagefilter.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..429ef1e877faf75c622ea0c9db808da4035b9a84
