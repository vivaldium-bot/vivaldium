index 0000000000000000000000000000000000000000..4812101e7a27415bc246918e0a422183a149d08d
--- /dev/null
+++ b/third_party/pdfium/testing/resources/javascript/globals.in
@@ -0,0 +1,159 @@
+{{header}}
