+bool CBC_OnedUPCAWriter::CheckContentValidity(const CFX_WideStringC& contents) {
+  for (FX_STRSIZE i = 0; i < contents.GetLength(); ++i) {
+    if (contents.GetAt(i) < '0' || contents.GetAt(i) > '9')
+      return false;
+  }
+  return true;
+}
