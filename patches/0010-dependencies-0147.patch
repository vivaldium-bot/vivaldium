+void make_pos(Fuzz* fuzz, SkScalar* pos, int colorCount) {
+    SkScalar totalPos = 0;
+    for (int i = 0; i < colorCount; ++i) {
+        fuzz->nextRange(&pos[i], 1.0f, 1024.0f);
+        totalPos += pos[i];
+    }
+    totalPos = 1.0f / totalPos;
+    for (int i = 0; i < colorCount; ++i) {
+        pos[i] *= totalPos;
+    }
+    //SkASSERT(fabs(pos[colorCount - 1] - 1.0f) < 0.00001f);
+    pos[colorCount - 1] = 1.0f;
+}
