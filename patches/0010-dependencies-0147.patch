+int CJS_PublicMethods::ParseStringInteger(const CFX_WideString& str,
+                                          int nStart,
+                                          int& nSkip,
+                                          int nMaxStep) {
+  int nRet = 0;
+  nSkip = 0;
+  for (int i = nStart, sz = str.GetLength(); i < sz; i++) {
+    if (i - nStart > 10)
+      break;
+
+    wchar_t c = str.GetAt(i);
+    if (!FXSYS_iswdigit(c))
+      break;
+
+    nRet = nRet * 10 + FXSYS_toDecimalDigit(c);
+    nSkip = i - nStart + 1;
+    if (nSkip >= nMaxStep)
+      break;
+  }
+
+  return nRet;
+}
+
+CFX_WideString CJS_PublicMethods::ParseStringString(const CFX_WideString& str,
+                                                    int nStart,
+                                                    int& nSkip) {
+  CFX_WideString swRet;
+  nSkip = 0;
+  for (int i = nStart, sz = str.GetLength(); i < sz; i++) {
+    wchar_t c = str.GetAt(i);
+    if (!FXSYS_iswdigit(c))
+      break;
+
+    swRet += c;
+    nSkip = i - nStart + 1;
+  }
+
+  return swRet;
+}
