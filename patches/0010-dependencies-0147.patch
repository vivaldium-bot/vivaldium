+void CPWL_EditCtrl::SetCursor() {
+  if (IsValid()) {
+    if (CFX_SystemHandler* pSH = GetSystemHandler()) {
+      if (IsWndHorV())
+        pSH->SetCursor(FXCT_VBEAM);
+      else
+        pSH->SetCursor(FXCT_HBEAM);
+    }
+  }
