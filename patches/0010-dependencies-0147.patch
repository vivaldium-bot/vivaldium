+}
+
+static void make1(ColorPos* rec) {
+    const SkColor colors[] = {
+        SK_ColorBLACK, SK_ColorWHITE, SK_ColorBLACK, SK_ColorWHITE,
+        SK_ColorBLACK, SK_ColorWHITE, SK_ColorBLACK, SK_ColorWHITE,
+        SK_ColorBLACK,
+    };
+    rec->construct(colors, nullptr, SK_ARRAY_COUNT(colors));
+}
+
+static void make2(ColorPos* rec) {
+    const SkColor colors[] = {
