+static void push_src(const char* tag, ImplicitString options, Src* s) {
+    std::unique_ptr<Src> src(s);
+    if (in_shard() &&
+        FLAGS_src.contains(tag) &&
+        !SkCommandLineFlags::ShouldSkip(FLAGS_match, src->name().c_str())) {
+        TaggedSrc& s = gSrcs.push_back();
