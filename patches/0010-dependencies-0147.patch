+    if (strValue.IsEmpty())
+      return true;
+
+    CFX_WideString sFormat = params[0].ToCFXWideString(pRuntime);
+    bool bWrongFormat = false;
+    double dRet = MakeRegularDate(strValue, sFormat, &bWrongFormat);
+    if (bWrongFormat || JS_PortIsNan(dRet)) {
