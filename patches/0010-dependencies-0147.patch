+
+#ifndef SkV8Example_DrawingMethods_DEFINED
+#define SkV8Example_DrawingMethods_DEFINED
+
+#include <v8.h>
+
+class SkCanvas;
+class Global;
+
+// DrawingMethods contains common functionality for both Context, Image2Builder,
