+  }
+  BCFORMAT format = BCFORMAT_CODE_128;
+  int32_t outWidth = 0;
+  int32_t outHeight = 0;
+  CFX_WideString content(contents);
+  if (contents.GetLength() % 2 &&
+      static_cast<CBC_OnedCode128Writer*>(m_pBCWriter.get())->GetType() ==
