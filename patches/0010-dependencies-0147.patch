+        SK_ColorBLACK,
+    };
+    const int N = SK_ARRAY_COUNT(colors);
+    SkScalar pos[N];
+    for (int i = 0; i < N; ++i) {
+        pos[i] = SK_Scalar1 * i / (N - 1);
+    }
+    rec->construct(colors, pos, N);
+}
