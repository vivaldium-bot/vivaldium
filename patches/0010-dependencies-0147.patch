+        if (!item->isSelected()) {
+            continue;
+        }
+
+        if (fDebugger.isCommandVisible(row)) {
+            item->setData(Qt::UserRole + 2, QPixmap(":/delete.png"));
+            fDebugger.setCommandVisible(row, false);
+            fSkipCommands[row] = true;
