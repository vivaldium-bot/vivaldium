+    QVBoxLayout fVerticalLayout;
+
+    QGroupBox fMatrixGroup;
+    QGridLayout fMatrixLayout;
+    QLineEdit fMatrixEntry[9];
+
+    QGroupBox fClipGroup;
+    QGridLayout fClipLayout;
+    QLineEdit fClipEntry[4];
+
+    void setupMatrix();
+    void setupClip();
+};
