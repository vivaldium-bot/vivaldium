+ * found in the LICENSE file.
+ */
+
+#include "gm.h"
+
+#include "Resources.h"
+#include "SkCanvas.h"
+#include "SkOSFile.h"
+
+namespace skiagm {
+
+/**
+ *  Test copying an image from 8888 to 4444.
+ */
+class CopyTo4444GM : public GM {
+public:
+    CopyTo4444GM() {}
+
+protected:
+    virtual SkString onShortName() {
