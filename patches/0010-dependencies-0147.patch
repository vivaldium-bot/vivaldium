+group trivial "Trivial expressions"
+
+	case float
+		values { output float out0 = 5.0; }
+		both ""
+
+			precision highp float;
+			${DECLARATIONS}
+
+			void main()
+			{
+				const float a = 5.0;
+				out0 = a;
+				${OUTPUT}
+			}
+		""
+	end
+
+	case int
+		values { output int out0 = 5; }
+		both ""
+			precision highp float;
+			${DECLARATIONS}
+
+			void main()
+			{
+				const int a = 5;
+				out0 = a;
