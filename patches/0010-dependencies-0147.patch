+                                bool bKeyDown,
+                                bool bModifier,
+                                bool bShift,
+                                CPDF_FormField* pTarget,
+                                CFX_WideString& Value,
+                                bool& bRc) = 0;
+
+  virtual void OnScreen_Focus(bool bModifier,
