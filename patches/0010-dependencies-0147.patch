+    m_bCalculate = (bool)bVP;
+    pRuntime->GetFormFillEnv()->GetInterForm()->EnableCalculate(
+        (bool)m_bCalculate);
+  } else {
+    vp << (bool)m_bCalculate;
+  }
+  return true;
+}
