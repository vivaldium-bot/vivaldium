+        FX_POSITION pos = m_ObjectList.GetHeadPosition();
+        while (pos) {
+            delete (CPDF_PageObject*)m_ObjectList.GetNext(pos);
+        }
+    }
+    m_ObjectList.RemoveAll();
+}
