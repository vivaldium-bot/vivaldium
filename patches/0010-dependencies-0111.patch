+    }
+    CFontFaceInfo* pFont = (CFontFaceInfo*)hFont;
+    name = pFont->m_FaceName;
+    return TRUE;
+}
+FX_BOOL CFX_FolderFontInfo::GetFontCharset(void* hFont, int& charset)
+{
+    return FALSE;
+}
