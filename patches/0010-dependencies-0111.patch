index 0000000000000000000000000000000000000000..764a10ef3ea5d2a2f6854f3ae534151a51a018bc
--- /dev/null
+++ b/third_party/opus/src/silk/fixed/schur64_FIX.c
@@ -0,0 +1,92 @@
