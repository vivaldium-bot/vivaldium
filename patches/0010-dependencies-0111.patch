+        CPDF_Point ptRightBottom = OutToIn(CPDF_Point(rect.right, rect.bottom));
+        return CPVT_FloatRect(ptLeftTop.x, ptLeftTop.y, ptRightBottom.x, ptRightBottom.y);
+    };
+
+private:
+    CPDF_Rect								m_rcPlate;
+    CPVT_FloatRect							m_rcContent;
