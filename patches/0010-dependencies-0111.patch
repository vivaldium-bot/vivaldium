+    friend	FX_BOOL		operator != (const FXT_PSV &obj1, const FXT_PSV &obj2)
+    {
+        return obj1.x != obj2.x || obj1.y != obj2.y;
+    }
+    friend	FXT_PSV		operator + (const FXT_PSV &obj1, const FXT_PSV &obj2)
+    {
+        CFX_PSVTemplate obj;
+        obj.x = obj1.x + obj2.x;
+        obj.y = obj1.y + obj2.y;
