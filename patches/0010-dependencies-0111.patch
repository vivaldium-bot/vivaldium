+FX_DWORD CPDF_Bookmark::GetColorRef() const
+{
+    if (!m_pDict) {
+        return 0;
+    }
+    CPDF_Array* pColor = m_pDict->GetArray("C");
+    if (!pColor) {
+        return FXSYS_RGB(0, 0, 0);
+    }
+    int r = FXSYS_round(pColor->GetNumber(0) * 255);
