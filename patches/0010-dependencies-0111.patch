+    if (m_AllocSize < m_DataSize + (FX_STRSIZE)(len * sizeof(FX_WCHAR))) {
+        ExpandBuf(len * sizeof(FX_WCHAR));
+    }
+    ASSERT(m_pBuffer != NULL);
+    FX_WCHAR* str = (FX_WCHAR*)(m_pBuffer + m_DataSize);
+    for (FX_STRSIZE j = 0; j < len; j ++) {
