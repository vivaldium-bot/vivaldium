+    fDiff = src.bottom - src.top;
+    d = FXSYS_fabs(fDiff) < 0.001f ? 1 : (dest.bottom - dest.top) / fDiff;
+    e = dest.left - src.left * a;
+    f = dest.bottom - src.bottom * d;
+    b = 0;
+    c = 0;
