+            temp[2] = W[i * 8 + 2];
+            temp[3] = W[i * 8 + 3];
+            temp[4] = W[i * 8 + 4];
+            temp[5] = W[i * 8 + 5];
+            temp[6] = W[i * 8 + 6];
+            temp[7] = W[i * 8 + 7];
