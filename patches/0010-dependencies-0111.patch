+{
+}
+int32_t CPVT_Provider::GetCharWidth(int32_t nFontIndex, FX_WORD word, int32_t nWordStyle)
+{
+    if (CPDF_Font* pPDFFont = m_pFontMap->GetPDFFont(nFontIndex)) {
+        FX_DWORD charcode = pPDFFont->CharCodeFromUnicode(word);
