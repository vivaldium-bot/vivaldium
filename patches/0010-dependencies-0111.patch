+{
+    if (m_AllocSize < m_DataSize + (FX_STRSIZE)sizeof(FX_WCHAR)) {
+        ExpandBuf(sizeof(FX_WCHAR));
+    }
+    ASSERT(m_pBuffer != NULL);
+    *(FX_WCHAR*)(m_pBuffer + m_DataSize) = ch;
+    m_DataSize += sizeof(FX_WCHAR);
