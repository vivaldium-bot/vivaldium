+                    }
+                case 4: {
+                        uint8_t left = 0;
+                        if (byte >= BytesPerPixel) {
+                            left = pDestData[byte - BytesPerPixel];
+                        }
+                        uint8_t up = 0;
+                        if (row) {
+                            up = pDestData[byte - row_size];
