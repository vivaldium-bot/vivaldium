+	CLST_Size(FX_FLOAT other_x, FX_FLOAT other_y)
+	{
+		x = other_x;
+		y = other_y;
+	}
+
+	void Default()
+	{
+		x = 0.0f;
+		y = 0.0f;
+	}
+
+	FX_BOOL operator != (const CLST_Size & size) const
+	{
+		return FXSYS_memcmp(this, &size, sizeof(CLST_Size)) != 0;
+	}
+
+	FX_FLOAT x,y;
+};
