+class CPDF_CalRGB : public CPDF_ColorSpace
+{
+public:
+    explicit CPDF_CalRGB(CPDF_Document* pDoc)
+        : CPDF_ColorSpace(pDoc, PDFCS_CALRGB, 3) {
+    }
