+void sRGB_to_AdobeCMYK(FX_FLOAT R, FX_FLOAT G, FX_FLOAT B, FX_FLOAT& c, FX_FLOAT& m, FX_FLOAT& y, FX_FLOAT& k)
+{
+    c = 1.0f - R;
+    m = 1.0f - G;
+    y = 1.0f - B;
+    k = c;
+    if (m < k) {
+        k = m;
+    }
+    if (y < k) {
+        k = y;
+    }
+}
