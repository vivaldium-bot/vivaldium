+CPDF_Dictionary* CPDF_Action::GetAnnot() const
+{
+    if (m_pDict == NULL) {
+        return NULL;
+    }
+    CFX_ByteString csType = m_pDict->GetString("S");
+    if (csType == FX_BSTRC("Rendition")) {
+        return m_pDict->GetDict("AN");
+    } else if (csType == FX_BSTRC("Movie")) {
+        return m_pDict->GetDict("Annotation");
+    }
