+FX_FLOAT CFX_Matrix::GetUnitArea() const
+{
+    FX_FLOAT A = FXSYS_sqrt(a * a + b * b);
+    FX_FLOAT B = FXSYS_sqrt(c * c + d * d);
+    FX_FLOAT ac = a + c, bd = b + d;
+    FX_FLOAT C = FXSYS_sqrt(ac * ac + bd * bd);
+    FX_FLOAT P = (A + B + C ) / 2;
+    return FXSYS_sqrt(P * (P - A) * (P - B) * (P - C)) * 2;
