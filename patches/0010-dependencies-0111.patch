+FX_HFILE FX_File_Open(const CFX_ByteStringC& fileName, FX_DWORD dwMode)
+{
+    IFXCRT_FileAccess* pFA = FXCRT_FileAccess_Create();
+    if (pFA && !pFA->Open(fileName, dwMode)) {
+        pFA->Release();
+        return NULL;
