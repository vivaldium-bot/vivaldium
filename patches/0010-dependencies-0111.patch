+{
+public:
+
+    int                                 GetType() const
+    {
+        return m_Type;
+    }
+
+    FX_DWORD                            GetObjNum() const
+    {
+        return m_ObjNum;
+    }
+
+    FX_DWORD                            GetGenNum() const
+    {
+        return m_GenNum;
+    }
+
+    FX_BOOL                             IsIdentical(CPDF_Object* pObj) const;
