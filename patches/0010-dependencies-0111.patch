+    void* FPDFAPI_FlateInit(void* (*alloc_func)(void*, unsigned int, unsigned int),
+                            void (*free_func)(void*, void*))
+    {
+        z_stream* p = (z_stream*)alloc_func(0, 1, sizeof(z_stream));
+        if (p == NULL) {
+            return NULL;
+        }
+        FXSYS_memset(p, 0, sizeof(z_stream));
+        p->zalloc = alloc_func;
+        p->zfree = free_func;
+        inflateInit(p);
