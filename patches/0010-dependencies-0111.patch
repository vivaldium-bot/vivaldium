+    CPDF_Number() : CPDF_Object(PDFOBJ_NUMBER), m_bInteger(false), m_Integer(0) { }
+
+    CPDF_Number(FX_BOOL bInteger, void* pData);
+
+    CPDF_Number(int value);
+
+    CPDF_Number(FX_FLOAT value);
