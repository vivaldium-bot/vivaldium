+    inline CPDF_Point						OutToIn(const CPDF_Point & point) const
+    {
+        return CPDF_Point(point.x - GetBTPoint().x, GetBTPoint().y - point.y);
+    };
+    inline CPDF_Rect						InToOut(const CPVT_FloatRect & rect) const
+    {
