+                                   GetNumber16(2), GetNumber(1), GetNumber(0));
+    OnChangeTextMatrix();
+    m_pCurStates->m_TextX = 0;
+    m_pCurStates->m_TextY = 0;
+    m_pCurStates->m_TextLineX = 0;
