+void ArgbDecode(FX_DWORD argb, int& a, int& r, int& g, int& b)
+{
+    a = FXARGB_A(argb);
+    r = FXARGB_R(argb);
+    g = FXARGB_G(argb);
+    b = FXARGB_B(argb);
