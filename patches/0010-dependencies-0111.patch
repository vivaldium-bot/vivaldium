+            temp[1] = SHA384_R(i * 8 + 1);
+            temp[2] = SHA384_R(i * 8 + 2);
+            temp[3] = SHA384_R(i * 8 + 3);
+            temp[4] = SHA384_R(i * 8 + 4);
+            temp[5] = SHA384_R(i * 8 + 5);
+            temp[6] = SHA384_R(i * 8 + 6);
+            temp[7] = SHA384_R(i * 8 + 7);
