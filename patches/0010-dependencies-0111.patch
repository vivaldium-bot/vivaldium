+        CPDF_Point ptRightBottom = InToOut(CPDF_Point(rect.right, rect.bottom));
+        return CPDF_Rect(ptLeftTop.x, ptRightBottom.y, ptRightBottom.x, ptLeftTop.y);
+    };
+    inline CPVT_FloatRect					OutToIn(const CPDF_Rect & rect) const
+    {
