+class CFX_UnicodeEncoding : public IFX_FontEncoding
+{
+public:
+    CFX_UnicodeEncoding(CFX_Font* pFont);
+    virtual FX_DWORD		GlyphFromCharCodeEx(FX_DWORD charcode, int encoding = ENCODING_UNICODE);
+private:
