+void CPDF_StreamContentParser::Handle_ClosePath()
+{
+    if (m_Options.m_bTextOnly) {
+        return;
+    }
+    if (m_PathPointCount == 0) {
+        return;
+    }
+    if (m_PathStartX != m_PathCurrentX || m_PathStartY != m_PathCurrentY) {
