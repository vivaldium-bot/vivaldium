+{
+}
+void CPDF_VariableText_Iterator::SetAt(int32_t nWordIndex)
+{
+    ASSERT(m_pVT != NULL);
+    m_CurPos = m_pVT->WordIndexToWordPlace(nWordIndex);
+}
