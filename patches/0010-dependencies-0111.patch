+FX_BOOL PDF_FormField_IsUnison(CPDF_FormField *pField)
+{
+    FX_BOOL bUnison = FALSE;
+    if (pField->GetType() == CPDF_FormField::CheckBox) {
+        bUnison = TRUE;
+    } else {
+        FX_DWORD dwFlags = pField->GetFieldFlags();
+        bUnison = ((dwFlags & 0x2000000) != 0);
+    }
+    return bUnison;
+}
