+static int _CompareFileSize(const void* p1, const void* p2)
+{
+    FX_FILESIZE ret = (*(FX_FILESIZE*)p1) - (*(FX_FILESIZE*)p2);
+    if (ret > 0) {
+        return 1;
+    }
+    if (ret < 0) {
+        return -1;
+    }
+    return 0;
