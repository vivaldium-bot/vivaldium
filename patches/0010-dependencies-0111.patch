+void CPDF_StreamContentParser::Handle_CurveTo_13()
+{
+    if (m_Options.m_bTextOnly) {
+        return;
+    }
+    AddPathPoint(GetNumber(3), GetNumber(2), FXPT_BEZIERTO);
+    AddPathPoint(GetNumber(1), GetNumber(0), FXPT_BEZIERTO);
+    AddPathPoint(GetNumber(1), GetNumber(0), FXPT_BEZIERTO);
+}
