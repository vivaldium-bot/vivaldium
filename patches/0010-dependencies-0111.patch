+    PUT_FX_64DWORD(ctx->state[2], digest, 16);
+    PUT_FX_64DWORD(ctx->state[3], digest, 24);
+    PUT_FX_64DWORD(ctx->state[4], digest, 32);
+    PUT_FX_64DWORD(ctx->state[5], digest, 40);
+    PUT_FX_64DWORD(ctx->state[6], digest, 48);
