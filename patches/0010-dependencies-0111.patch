+    int iCount = m_ControlList.GetSize();
+    for (int i = 0; i < iCount; i ++) {
+        CPDF_FormControl* pFind = (CPDF_FormControl*)m_ControlList.GetAt(i);
+        if (pFind == pControl) {
+            return i;
+        }
+    }
+    return -1;
+}
+int CPDF_FormField::GetFieldType()
+{
+    switch (m_Type) {
+        case PushButton:
+            return FIELDTYPE_PUSHBUTTON;
+        case CheckBox:
