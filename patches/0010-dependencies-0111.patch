+    FX_FLOAT				GetFloat() const
+    {
+        return m_bInteger ? (FX_FLOAT)m_Integer : m_Float;
+    }
+protected:
+
+    FX_BOOL					m_bInteger;
+
+    union {
+
+        int					m_Integer;
+
+        FX_FLOAT			m_Float;
+    };
+    friend class			CPDF_Object;
+};
