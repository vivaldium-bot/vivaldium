+void CFX_FontMgr::FreeCache()
+{
+    FX_POSITION pos = m_FaceMap.GetStartPosition();
+    while(pos) {
+        CFX_ByteString Key;
+        CTTFontDesc* face;
+        m_FaceMap.GetNextAssoc(pos, Key, (void*&)face);
