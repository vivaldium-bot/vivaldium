+static const _GlyphNameMap g_GlyphNameSubsts[] = {
+    {"ff", "uniFB00"},
+    {"fi", "uniFB01"},
+    {"fl", "uniFB02"},
+    {"ffi", "uniFB03"},
+    {"ffl", "uniFB04"}
+};
+extern "C" {
+    static int compareString(const void* key, const void* element)
+    {
