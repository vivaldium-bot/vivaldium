+    low  = ( ctx->total[0] <<  3 );
+    PUT_FX_64DWORD( high, msglen, 0 );
+    PUT_FX_64DWORD( low,  msglen, 8 );
+    last = (FX_DWORD)ctx->total[0] & 0x7F;
