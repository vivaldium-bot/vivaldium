+    FX_FLOAT j = -i;
+    a = m.d / i;
+    b = m.b / j;
+    c = m.c / j;
+    d = m.a / i;
+    e = (m.c * m.f - m.d * m.e) / i;
+    f = (m.a * m.f - m.b * m.e) / j;
