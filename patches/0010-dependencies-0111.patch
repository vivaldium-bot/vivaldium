+    pPages->SetAtNumber("Count", 0);
+    pPages->SetAt("Kids", new CPDF_Array);
+    objnum = AddIndirectObject(pPages);
+    m_pRootDict->SetAtReference("Pages", this, objnum);
+    m_pInfoDict = new CPDF_Dictionary;
+    AddIndirectObject(m_pInfoDict);
