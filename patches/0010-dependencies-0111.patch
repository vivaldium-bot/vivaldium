+void CFX_FontMgr::ReleaseFace(FXFT_Face face)
+{
+    if (face == NULL) {
+        return;
+    }
+    FX_POSITION pos = m_FaceMap.GetStartPosition();
+    while(pos) {
+        CFX_ByteString Key;
+        CTTFontDesc* ttface;
+        m_FaceMap.GetNextAssoc(pos, Key, (void*&)ttface);
+        if (ttface->ReleaseFace(face)) {
+            m_FaceMap.RemoveKey(Key);
+        }
+    }
+}
