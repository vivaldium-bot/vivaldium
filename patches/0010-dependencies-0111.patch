+{
+    CPDF_ColorStateData* pData = GetModify();
+    SetColor(pData->m_FillColor, pData->m_FillRGB, pCS, pValue, nValues);
+}
+void CPDF_ColorState::SetStrokeColor(CPDF_ColorSpace* pCS, FX_FLOAT* pValue, int nValues)
+{
+    CPDF_ColorStateData* pData = GetModify();
