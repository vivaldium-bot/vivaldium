+        str.appendf("%d: Color: 0x%08x Trans: %.2f,%.2f Runs: %d\n",
+                    i,
+                    fGeoData[i].fColor,
+                    fGeoData[i].fX,
+                    fGeoData[i].fY,
+                    fGeoData[i].fBlob->runCount());
