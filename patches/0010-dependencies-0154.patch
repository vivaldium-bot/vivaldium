+void SkPDFDevice::cleanUp(bool clearFontUsage) {
+    fGraphicStateResources.unrefAll();
+    fXObjectResources.unrefAll();
+    fFontResources.unrefAll();
+    fShaderResources.unrefAll();
+
+    if (clearFontUsage) {
+        fFontGlyphUsage->reset();
+    }
+}
