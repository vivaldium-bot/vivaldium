+      const SoundDeviceLocator *device,
+      const OpenParams &params) override;
+  SoundInputStreamInterface *OpenCaptureDevice(
+      const SoundDeviceLocator *device,
+      const OpenParams &params) override;
+
+ protected:
+  SoundSystemInterface *wrapped_;
+};
+
+}  // namespace rtc
