diff --git a/third_party/skia/tools/gpu/gl/win/CreatePlatformGLTestContext_win.cpp b/third_party/skia/tools/gpu/gl/win/CreatePlatformGLTestContext_win.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..49d774315b729f9784dfc4e96bd4a3b83a7e6372
--- /dev/null
