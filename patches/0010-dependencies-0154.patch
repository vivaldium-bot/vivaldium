+void Viewer::setStartupSlide() {
+
+    if (!FLAGS_slide.isEmpty()) {
+        int count = fSlides.count();
+        for (int i = 0; i < count; i++) {
+            if (fSlides[i]->getName().equals(FLAGS_slide[0])) {
+                fCurrentSlide = i;
+                return;
+            }
+        }
+
+        fprintf(stderr, "Unknown slide \"%s\"\n", FLAGS_slide[0]);
+        this->listNames();
+    }
+
+    fCurrentSlide = 0;
+}
