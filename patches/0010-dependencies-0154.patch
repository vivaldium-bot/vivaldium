+
+  for (AndroidStreamMap::iterator it = _streamsMap.begin();
+       it != _streamsMap.end();
+       ++it) {
+    delete it->second;
+  }
+  delete &_javaShutdownEvent;
+  delete &_javaRenderEvent;
+  delete &_critSect;
+}
