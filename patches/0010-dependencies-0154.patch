index 0000000000000000000000000000000000000000..f0805b5432b96b9f38d77713728a0599811b7795
--- /dev/null
+++ b/third_party/skia/src/svg/SkSVGDevice.cpp
@@ -0,0 +1,818 @@
+/*
+ * Copyright 2015 Google Inc.
+ *
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+#include "SkSVGDevice.h"
+
+#include "SkBase64.h"
+#include "SkBitmap.h"
+#include "SkChecksum.h"
+#include "SkClipStack.h"
+#include "SkData.h"
+#include "SkDraw.h"
+#include "SkImageEncoder.h"
