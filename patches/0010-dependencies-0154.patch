new file mode 100644
index 0000000000000000000000000000000000000000..ad0faf1596e33370e55a8555ff97855525af7746
--- /dev/null
+++ b/third_party/skia/src/gpu/vk/GrVkCaps.h
@@ -0,0 +1,179 @@
+/*
