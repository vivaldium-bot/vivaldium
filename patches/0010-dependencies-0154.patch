+DEF_GPUTEST_FOR_RENDERING_CONTEXTS(ComposedImageFilterOffset_Gpu, reporter, ctxInfo) {
+    test_composed_imagefilter_offset(reporter, ctxInfo.grContext());
+}
+#endif
