+
+    bool isCoincident() const {
+        SkASSERT(!!fCoincident == fCoincident);
+        return SkToBool(fCoincident);
+    }
+
+    void init() {
+        fPerpT = -1;
+        fCoincident = false;
+        fPerpPt.fX = fPerpPt.fY = SK_ScalarNaN;
+    }
+
+    void markCoincident() {
+        if (!fCoincident) {
+            fPerpT = -1;
+        }
