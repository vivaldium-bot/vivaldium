+    AppendedZeroesTest(hash,hashbits);
+    printf("\n");
+  }
+
+  //-----------------------------------------------------------------------------
+  // Speed tests
+
+  if(g_testSpeed || g_testAll)
+  {
+    printf("[[[ Speed Tests ]]]\n\n");
+
+    BulkSpeedTest(info->hash,info->verification);
+    printf("\n");
+
+    for(int i = 1; i < 32; i++)
