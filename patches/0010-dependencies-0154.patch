+                     __FUNCTION__, res, env);
+        env = NULL;
+      }
+      else {
+        isAttached = true;
+      }
+    }
+
+    env->DeleteGlobalRef(_javaRenderObj);
+    env->DeleteGlobalRef(_javaRenderClass);
+
+    if (isAttached) {
+      if (g_jvm->DetachCurrentThread() < 0) {
+        WEBRTC_TRACE(kTraceWarning, kTraceVideoRenderer, _id,
