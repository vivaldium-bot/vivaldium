index 0000000000000000000000000000000000000000..a4d0cf45433b34f7b8c3b6bfd62e271fd551986a
--- /dev/null
+++ b/third_party/webrtc/modules/video_coding/timing.h
@@ -0,0 +1,126 @@
+/*
+ *  Copyright (c) 2011 The WebRTC project authors. All Rights Reserved.
+ *
