+
+    // /ops
+    if (0 == strcmp(method, MHD_HTTP_METHOD_GET)) {
+        int n = request->getLastOp();
+
+        sk_sp<SkData> data(request->getJsonOpList(n));
+        return SendData(connection, data.get(), "application/json");
+    }
+
+    return MHD_NO;
+}
