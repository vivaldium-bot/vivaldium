+static int GetRelayPreference(cricket::ProtocolType proto, bool secure) {
+  int relay_preference = ICE_TYPE_PREFERENCE_RELAY;
+  if (proto == cricket::PROTO_TCP) {
+    relay_preference -= 1;
+    if (secure)
+      relay_preference -= 1;
+  }
+
+  ASSERT(relay_preference >= 0);
+  return relay_preference;
+}
