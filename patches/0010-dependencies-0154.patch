+VideoChannelNSOpenGL::~VideoChannelNSOpenGL()
+{
+    if (_buffer)
+    {
+        delete [] _buffer;
+        _buffer = NULL;
+    }
+
+    if (_texture != 0)
+    {
+        [_nsglContext makeCurrentContext];
+        glDeleteTextures(1, (const GLuint*) &_texture);
+        _texture = 0;
+    }
+}
