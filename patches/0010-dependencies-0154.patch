+bool VideoRenderNSOpenGL::HasChannel(int channel)
+{
+
+    CriticalSectionScoped cs(&_nsglContextCritSec);
+
+    std::map<int, VideoChannelNSOpenGL*>::iterator it = _nsglChannels.find(channel);
+
+    if (it != _nsglChannels.end())
+    {
+        return true;
+    }
+    return false;
+}
