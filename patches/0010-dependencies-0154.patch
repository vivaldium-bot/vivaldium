+        paint.setAntiAlias(true);
+        paint.setTypeface(fColorType);
+
+        for (SkScalar size = 10; size <= 100; size += 10) {
+            paint.setTextSize(size);
+            canvas->translate(0, paint.getFontMetrics(nullptr));
