+bool VideoRenderNSOpenGL::HasChannels()
+{
+    CriticalSectionScoped cs(&_nsglContextCritSec);
+
+    if (_nsglChannels.begin() != _nsglChannels.end())
+    {
+        return true;
+    }
+    return false;
+}
