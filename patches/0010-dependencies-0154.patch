+    { -9.55f,  47.55f },
+    { -25.00f,  50.00f },
+    { -40.45f,  47.55f },
+    { -54.39f,  40.45f },
+    { -65.45f,  29.39f },
+    { -72.55f,  15.45f },
+    { -75.00f,   0.00f },
+    { -72.55f, -15.45f },
+    { -65.45f, -29.39f },
+    { -54.39f, -40.45f },
+    { -40.45f, -47.55f },
+    { -25.0f,  -50.0f },
+    { -9.55f, -47.55f },
