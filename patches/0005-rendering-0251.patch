+  CHECK_EQ(-4, point);
+
+  CHECK(FastFixedDtoa(0.000001, 10, buffer, &length, &point));
+  CHECK_EQ(0, strcmp("1", buffer.start()));
+  CHECK_EQ(-5, point);
