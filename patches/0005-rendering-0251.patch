+  assertEquals(2, O.countArgs(...[1, 2]));
+  assertEquals(3, O.countArgs(...[1, 2, 3]));
+  assertEquals(4, O.countArgs(...[1, 2, 3, 4]));
+  assertEquals(5, O.countArgs(...[1, 2, 3, 4, 5]));
+  assertEquals(6, O.countArgs(...[1, 2, 3, 4, 5, 6]));
+
