+void RunOneTruncationTestWithTest(ConvertDToICallWrapper callWrapper,
+                                  ConvertDToIFunc func,
+                                  double from,
+                                  int32_t to) {
+  int32_t result = (*callWrapper)(func, from);
+  CHECK_EQ(to, result);
+}
+
+
+int32_t DefaultCallWrapper(ConvertDToIFunc func,
+                           double from) {
+  return (*func)(from);
+}
