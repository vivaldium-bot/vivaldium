+      Handle<Object>(Smi::FromInt(25 * kPageSize), isolate)};
+  testing::RunWasmModuleForTesting(isolate, instance, 1, params,
+                                   ModuleOrigin::kWasmOrigin);
+  CHECK(try_catch.HasCaught());
+  isolate->clear_pending_exception();
+}
diff --git a/v8/test/cctest/wasm/test-run-wasm-relocation.cc b/v8/test/cctest/wasm/test-run-wasm-relocation.cc
