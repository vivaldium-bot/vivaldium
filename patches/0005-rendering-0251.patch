+  v8::HandleScope scope(context->GetIsolate());
+  Isolate* isolate = CcTest::i_isolate();
+  Zone zone(isolate->allocator());
+
+  FeedbackVectorSpec spec(&zone);
+  // Set metadata.
+  for (int i = 0; i < 40; i++) {
+    switch (i % 4) {
+      case 0:
+        spec.AddGeneralSlot();
+        break;
+      case 1:
+        spec.AddCallICSlot();
+        break;
+      case 2:
+        spec.AddLoadICSlot();
+        break;
+      case 3:
+        spec.AddKeyedLoadICSlot();
+        break;
