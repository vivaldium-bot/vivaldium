-    else
-      result = 'transform "<code>' + curTest.transform + '</code>" expected "<code>' + curTest.result + '</code>", got "<code>' + computedTransform + '</code>" : FAIL';
-    resultsBox.innerHTML += result + '<br>';
-  });
-}
