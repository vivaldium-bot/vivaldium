+  assertSame(undefined, (new A).s.call(a));
+  assertSame(undefined, (new A).s.call(undefined));
+  assertSame(undefined, (new A).s.call(42));
+  assertSame(undefined, (new A).s.call(null));
+  assertSame(undefined, (new A).s.call("abc"));
+})();
