+static void TestSimpleRangeCaseIndependence(Isolate* isolate,
+                                            CharacterRange input,
+                                            CharacterRange expected) {
+  EmbeddedVector<CharacterRange, 1> vector;
+  vector[0] = expected;
+  TestRangeCaseIndependence(isolate, input, vector);
+}
