+  // cause another break.
+  f->Call(context, env->Global(), 0, NULL).ToLocalChecked();
+  CHECK_EQ(2, message_handler_break_hit_count);
+  // Calling g will not cause any additional breaks.
+  g->Call(context, env->Global(), 0, NULL).ToLocalChecked();
+  CHECK_EQ(2, message_handler_break_hit_count);
+}
