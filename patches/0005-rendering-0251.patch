+assertEquals(1, o());
+assertEquals(2, o());
+assertEquals(3, o());
+%OptimizeFunctionOnNextCall(o);
+assertEquals(4, o());
diff --git a/v8/test/mjsunit/harmony/dataview-accessors.js b/v8/test/mjsunit/harmony/dataview-accessors.js
