+
+// ----------------------------------------------------------------------
+// Constant function access.
+// ----------------------------------------------------------------------
+runTest = function() {
+  function fun() { };
+
+  var o = new Object();
+  o.f = fun;
+  o.x = 42;
+
+  var initial_F = 'f';
+  var F = initial_F;
+  var X = 'x'
+
+  function constantFunctionTest(change_index) {
+    for (var i = 0; i < 10; i++) {
+      var property = o[F];
+      if (i <= change_index) {
+        assertEquals(fun, property);
+      } else {
+        assertEquals(42, property);
+      }
+      if (i == change_index) F = X;
+    }
+    F = initial_F;
+  };
+
+  for (var i = 0; i < 10; i++) constantFunctionTest(i);
+}
+
+runTest();
+
+// ----------------------------------------------------------------------
+// Keyed store field.
+// ----------------------------------------------------------------------
+
+runTest = function() {
+  var o = { x: 42, y: 43 }
+
+  var initial_X = 'x';
+  var X = initial_X;
+  var Y = 'y';
+
+  function fieldTest(change_index) {
+    for (var i = 0; i < 10; i++) {
+      o[X] = X;
+      var property = o[X];
+      if (i <= change_index) {
+        assertEquals('x', property);
+      } else {
+        assertEquals('y', property);
+      }
+      if (i == change_index) X = Y;
+    }
+    X = initial_X;
+  };
+
+  for (var i = 0; i < 10; i++) fieldTest(i);
+}
+
+runTest();
