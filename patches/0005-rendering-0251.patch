+void TerminateOrReturnObject(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  if (++call_count == 10) {
+    CHECK(!args.GetIsolate()->IsExecutionTerminating());
+    args.GetIsolate()->TerminateExecution();
