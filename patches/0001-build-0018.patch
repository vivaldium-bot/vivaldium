+      def unescape(x):
+        """Replaces '\\' with '\' and '\?' (where ? is anything) with ?."""
+        out = []
+        escaped = False
+        for i in x:
+          if i == '\\' and not escaped:
+            escaped = True
+            continue
+          escaped = False
+          out.append(i)
+        return ''.join(out)
+
+      return [unescape(i) for i in text.split('\\001')]
