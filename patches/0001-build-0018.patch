+      ('count', ctypes.wintypes.DWORD), ('privileges', LUID_AND_ATTRIBUTES*0),
+    ]
+
+    def get_array(self):
+      array_type = LUID_AND_ATTRIBUTES * self.count
+      return ctypes.cast(self.privileges, ctypes.POINTER(array_type)).contents
+
+
