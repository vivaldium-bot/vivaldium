+    _fields_ = [
+      ('low_part', ctypes.wintypes.DWORD), ('high_part', ctypes.wintypes.LONG),
+    ]
+
+
+  class LUID_AND_ATTRIBUTES(ctypes.Structure):
+    _fields_ = [('LUID', LUID), ('attributes', ctypes.wintypes.DWORD)]
