+  GetTokenInformation.argtypes = (
+      ctypes.wintypes.HANDLE, ctypes.c_uint, ctypes.c_void_p,
+      ctypes.wintypes.DWORD, ctypes.POINTER(ctypes.wintypes.DWORD))
+  GetTokenInformation.restype = ctypes.wintypes.BOOL
