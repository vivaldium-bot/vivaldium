+        proc = self.Process(self.blacklist, pid, self._process_lookup[ppid].cwd)
+        self._process_lookup[ppid].children.append(proc)
+      else:
+        # Another process tree, ignore.
+        return
+      self._process_lookup[pid] = proc
+      logging.debug(
