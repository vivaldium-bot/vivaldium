+int32_t NaClSysClockGetTime(struct NaClAppThread  *natp,
+                            int                   clk_id,
+                            uint32_t              tsp) {
+  return NaClSysClockGetCommon(natp, clk_id, (uintptr_t) tsp,
+                               NaClClockGetTime, 0);
+}
