+int32_t NaClSysClockGetRes(struct NaClAppThread *natp,
+                           int                  clk_id,
+                           uint32_t             tsp) {
+  return NaClSysClockGetCommon(natp, clk_id, (uintptr_t) tsp,
+                               NaClClockGetRes, 1);
+}
