+TEST(ContextDeathTest, X86BadEndianness) {
+  Dump dump(0, kBigEndian);
+  MDRawContextX86 raw;
+  raw.context_flags = MD_CONTEXT_X86;
+  ASSERT_DEATH(Context context(dump, raw);,
+               "dump\\.endianness\\(\\) == kLittleEndian");
+}
