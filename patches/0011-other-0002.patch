+    { 63, (void *) 0xdeadbeef, 67 },
+  };
+  struct DynArray da;
+  size_t          ix;
+  int             nerrors = 0;
+
+  printf("\nFFS test\n");
+
+  if (!DynArrayCtor(&da, 32)) {
