+    ++nerrors;
+    goto done;
+  }
+
+  for (ix = 0; ix < NACL_ARRAY_SIZE(test_data); ++ix) {
+    if (!DynArraySet(&da, test_data[ix].pos, test_data[ix].val)) {
+      fprintf(stderr,
