diff --git a/native_client/src/trusted/service_runtime/arch/mips/nacl_signal_mips.h b/native_client/src/trusted/service_runtime/arch/mips/nacl_signal_mips.h
new file mode 100644
index 0000000000000000000000000000000000000000..0aaf8e892806c38d453a35c9e2de8dfa950fe4e9
--- /dev/null
