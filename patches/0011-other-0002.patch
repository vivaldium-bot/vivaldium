+    case NACL_ABI_CLOCK_REALTIME:
+    case NACL_ABI_CLOCK_MONOTONIC:
+    case NACL_ABI_CLOCK_PROCESS_CPUTIME_ID:
+    case NACL_ABI_CLOCK_THREAD_CPUTIME_ID:
+      return 1;
+  }
+  return 0;
+}
