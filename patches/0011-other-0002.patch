+
+
+int main(void) {
+  char buf[100];
+
+  sprintf(buf, "%"NACL_PRIxS, (size_t) -1);
+  printf("got:%s\n", buf);
+  if (sizeof(size_t) == 4) {
+    ASSERT_EQ(strcmp(buf, "ffffffff"), 0);
