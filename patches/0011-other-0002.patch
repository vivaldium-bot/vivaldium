+}
+
+int32_t NaClSysChdir(struct NaClAppThread *natp,
+                     uint32_t             pathname) {
+  struct NaClApp *nap = natp->nap;
+  char           path[NACL_CONFIG_PATH_MAX];
+  int32_t        retval = -NACL_ABI_EINVAL;
+
+  if (!NaClFileAccessEnabled()) {
