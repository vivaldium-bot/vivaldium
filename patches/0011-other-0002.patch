+  else:
+    env.Append(CPPDEFINES=['-DNACL_X86_64_ZERO_BASED_SANDBOX=0'])
+elif env.Bit('build_arm'):
+  ldr_inputs += [
+    'arch/arm/nacl_app.c',
+    'arch/arm/nacl_switch_to_app_arm.c',
+    'arch/arm/sel_rt.c',
+    'arch/arm/nacl_tls.c',
