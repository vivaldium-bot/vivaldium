+  'RANLIB'         : '${BINUTILS_BASE}ranlib${EXEC_EXT}',
+  'READELF'        : '${BINUTILS_BASE}readelf${EXEC_EXT}',
+  'STRIP'          : '${BINUTILS_BASE}strip${EXEC_EXT}',
