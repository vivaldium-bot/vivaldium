index 0000000000000000000000000000000000000000..5757b6c90454ff9bfe57c2a959ddb69b195f5ae4
--- /dev/null
+++ b/native_client/src/trusted/service_runtime/arch/x86_32/sel_rt_32.c
@@ -0,0 +1,159 @@
+/*
