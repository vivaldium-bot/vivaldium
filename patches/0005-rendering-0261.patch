+
+  var action = actions.shift();
+  if (!action) {
+    Protocol.Debugger.resume().then(InspectorTest.completeTest);
+    return;
+  }
+  InspectorTest.log("Perform " + action);
+  Protocol.Debugger[action]();
+}
