+y } [ aáeéiíoóuú] → ʝ ;
+y                 → i ;
+#
+#
+[aeo]      { u } [^aáeéiíoó  ] → u\u032F ;
+u } [ aáeéiíoó  ] → w ;
+ü } [   eéií    ] → w ;
+u                 → u ;
+ü                 → u ;  # Should not be needed, but just in case.
+#
+#
+[aá] → a ;
+[eé] → e ;
+í    → i ;
+[oó] → o ;
+ú    → u ;
+#
+#
+#
+# Consonants.
+#
+b → β ;
+cch → ʧ ;
+ch → ʧ ;
+cc } [^eéií] → k ;
+c } [eéií] → θ ;
+c → k ;
+d → ð ;
+f → f;
+gu } [eéiíy] → ɣ ;
+g } [eéiíy] → x ;
+g → ɣ ;
+hi } [aáeéoóuú] → ʝ ;
+h → $syll ;
+j → x ;
+k → k ;
+ll → ʎ ;
+l → l ;
+m → m ;
+n → n ;
+ñ → ɲ ;
+p → p ;
+qu } [eéiíy] → k ;
+q → k ;
