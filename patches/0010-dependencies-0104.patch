+$Ji = ᄌ;
+$JJi = ᄍ;
+$CHi = ᄎ;
+$Ki = ᄏ;
+$Ti = ᄐ;
+$Pi = ᄑ;
+$Hi = ᄒ;
+$A = ᅡ;
+$AE = ᅢ;
+$YA = ᅣ;
+$YAE = ᅤ;
+$EO = ᅥ;
+$E = ᅦ;
+$YEO = ᅧ;
+$YE = ᅨ;
+$O = ᅩ;
