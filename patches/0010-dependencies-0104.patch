+  }
+
+  private void createViewForCountry() {
+    if (!formOptions.isHidden(AddressField.COUNTRY)) {
+      // For initialization when the form is first created.
+      if (!inputWidgets.containsKey(AddressField.COUNTRY)) {
+        buildCountryListBox();
+      }
+      createView(
+          rootView,
