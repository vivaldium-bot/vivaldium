+#endif  // I18N_ADDRESSINPUT_ADDRESS_VALIDATOR_H_
diff --git a/third_party/libaddressinput/src/cpp/include/libaddressinput/callback.h b/third_party/libaddressinput/src/cpp/include/libaddressinput/callback.h
new file mode 100644
index 0000000000000000000000000000000000000000..57117c695f289ad25372d634e509581b97a74d0a
--- /dev/null
+++ b/third_party/libaddressinput/src/cpp/include/libaddressinput/callback.h
@@ -0,0 +1,95 @@
+// Copyright (C) 2013 Google Inc.
