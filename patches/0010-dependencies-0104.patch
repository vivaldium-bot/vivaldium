+std::ostream& operator<<(std::ostream& o, AddressField field) {
+  static const char* const kFieldNames[] = {
+    "COUNTRY",
+    "ADMIN_AREA",
+    "LOCALITY",
+    "DEPENDENT_LOCALITY",
+    "SORTING_CODE",
+    "POSTAL_CODE",
+    "STREET_ADDRESS",
+    "ORGANIZATION",
+    "RECIPIENT"
+  };
+  static_assert(COUNTRY == 0, "bad_base");
+  static_assert(RECIPIENT == size(kFieldNames) - 1, "bad_length");
