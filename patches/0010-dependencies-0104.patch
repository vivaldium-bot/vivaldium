+\u0650 → e ; # ARABIC KASRA
+\u064Fو → ū ; # ARABIC DAMMA + WAW
+\u064F → o ; # ARABIC DAMMA
+\u0652 →  ; # ARABIC SUKUN
+::NFC (NFD) ;
+#
+#
+########################################################################
