+$sep ← [^$latinMedial] [y] e {} $IEUNG [$O $OE];
+$sep ← [^$latinMedial] e {} $IEUNG [$O $OE $U];
+$sep ← [^$latinMedial] [o a] {} $IEUNG [$E $EO $EU];
+$sep ← [^$latinMedial] [w y] a {} $IEUNG [$E $EO $EU];
