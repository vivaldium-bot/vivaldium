diff --git a/third_party/libaddressinput/src/common/src/main/java/com/google/i18n/addressinput/common/StandardAddressVerifier.java b/third_party/libaddressinput/src/common/src/main/java/com/google/i18n/addressinput/common/StandardAddressVerifier.java
