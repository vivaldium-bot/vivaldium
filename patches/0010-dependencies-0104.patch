+#
+[-\ ] → ;
+#
+#
+[mnɲŋ  $] { β → b ;
+[mnɲŋlʎ$] { ð → d ;
+[mnɲŋ  $] { ɣ → g ;
+#
+#
+n } [gɣk] → ŋ ;
+#
+#
+# Optional: Place assimilation of n before labial consonants.
+#
+# n } [bβpfm] → m ;
+#
+# Optional: Voicing of [s].
+#
+# s } [bβdð] → z ;
+# s } [gɣ][^ei] → z ;
+# s } [mnɲŋlʎrɾ] → z ;
