+زه → z·h ; # ARABIC LETTER ZAIN + HEH
+سه → s·h ; # ARABIC LETTER SEEN + HEH
+گه → g·h ; # ARABIC LETTER GAF + HEH
+#
+#
+########################################################################
+#
+# End Rule 4
+#
+########################################################################
