+ز\u0651 → zz ; # ARABIC LETTER ZAIN + SHADDA
+ژ\u0651 → zhzh ; # ARABIC LETTER JEH + SHADDA
+س\u0651 → ss ; # ARABIC LETTER SEEN + SHADDA
+ش\u0651 → shsh ; # ARABIC LETTER SHEEN + SHADDA
