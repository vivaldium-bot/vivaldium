+		ungetc (c, stdin);
+		buffer[i++] = 0;
+		tok = isupper ((unsigned char) buffer[0]) ? TYPENAME : ID;
+		yylval = new_term (strcpy ((char *) malloc (i), buffer));
+	      }
+	    else
+	      {
+		colNum += 1;
+		tok = c;
+		yylval = 0;
+	      }
