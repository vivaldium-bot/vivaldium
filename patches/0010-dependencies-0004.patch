+  return res;
+}
+
+static void
+unget_char (YYSTYPE *lvalp, YYLTYPE *llocp,  int c)
+{
+  (void) lvalp;(void) llocp;
+
+  /* Wrong when C == `\n'. */
+  (*llocp) = last_yylloc;
+
+  ungetc (c, input);
