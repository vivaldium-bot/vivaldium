+%%
+
+top:
+	optional_separator
+	| element_list
+	;
+
+element_list:
+	optional_separator middle_element_list optional_separator
+	;
+
+middle_element_list:
+	element
+	| middle_element_list separator element
+	;
+
+optional_separator:
+	/* empty */
+	| separator
+	;
+
+separator:
+	';'
+	| separator ';'
+	;
+
+placeless_element:
+	VARIABLE '=' any_expr
+	| VARIABLE ':' '=' any_expr
