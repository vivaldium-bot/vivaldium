+static YYLTYPE last_yylloc;
+
+static int
+get_char (void)
+{
+  int res = getc (input);
+  ;
+
+  last_yylloc = (calclloc);
+  if (res == '\n')
+    {
+      (calclloc).last_line++;
+      (calclloc).last_column = 1;
+    }
+  else
+    (calclloc).last_column++;
+
+  return res;
+}
+
+static void
+unget_char ( int c)
+{
+  ;
+
+  /* Wrong when C == `\n'. */
+  (calclloc) = last_yylloc;
+
+  ungetc (c, input);
