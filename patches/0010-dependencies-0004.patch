+
+static void
+yyerror (
+
+         const char *s)
+{
+
+
+  fprintf (stderr, "%s\n", s);
+}
+
+
+
+static int
+power (int base, int exponent)
+{
+  int res = 1;
+  if (exponent < 0)
+    exit (3);
+  for (/* Niente */; exponent; --exponent)
+    res *= base;
+  return res;
+}
+
+
+int
+main (int argc, const char **argv)
+{
+  semantic_value result = 0;
+  int count = 0;
+  int status;
+
+  /* This used to be alarm (10), but that isn't enough time for
