+print_arg:
+	expr							%prec ','
+	| text
+	| position						%prec ','
+	;
+
+simple_if:
+	IF any_expr THEN
+		{}
+	DELIMITED
+	;
+
+until:
+	/* empty */
+	| UNTIL TEXT
+	;
+
+any_expr:
+	expr
+	| text_expr
+	;
+
+text_expr:
+	text EQUALEQUAL text
+	| text NOTEQUAL text
+	| text_expr ANDAND text_expr
+	| text_expr ANDAND expr
+	| expr ANDAND text_expr
+	| text_expr OROR text_expr
+	| text_expr OROR expr
+	| expr OROR text_expr
+	| '!' text_expr
