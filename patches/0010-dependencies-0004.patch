+++ b/third_party/bison/src/bison/2.4.1/bison-2.4.1-src/data/xslt/bison.xsl
@@ -0,0 +1,93 @@
+<?xml version="1.0" encoding="UTF-8"?>
+
+<!--
+    bison.xsl - common templates for Bison XSLT.
+
