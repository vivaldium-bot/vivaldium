+
+/* Exercise %union. */
+%union
+{
+  semantic_value ival;
+};
+
+%code provides {
+#include <stdio.h>
+/* The input.  */
+extern FILE *input;
+#ifndef YYLTYPE
+# define YYLTYPE yy::location
+#endif
+#define first_line   begin.line
+#define first_column begin.column
+#define last_line    end.line
+#define last_column  end.column
