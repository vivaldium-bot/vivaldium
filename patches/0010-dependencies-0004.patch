+%%
+
+static int
+yylex (void)
+{
+  yylval.node = (count_node*) malloc (sizeof *yylval.node);
+  if (!yylval.node)
+    {
+      fprintf (stderr, "Test inconclusive.\n");
+      exit (EXIT_FAILURE);
+    }
+  yylval.node->count = 0;
+  yylval.node->prev = tail;
+  tail = yylval.node;
+  return 'a';
