+"  -v, --verbose              samme som \"--report=state\"\n"
+"  -b, --file-prefix=PR∆FIKS  angiv et PR∆FIKS for uddatafiler\n"
+"  -o, --output=FIL           lÊg uddata i FIL\n"
+"  -g, --graph                lav ogsÂ en VCG-beskrivelse af automaten\n"
