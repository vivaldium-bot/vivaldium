+int
+yyparse ()
+{
+  calc::parser parser;
+#if YYDEBUG
+  parser.set_debug_level (1);
+#endif
+  return parser.parse ();
+}
+
+
+
+
+static int
+power (int base, int exponent)
+{
+  int res = 1;
+  if (exponent < 0)
+    exit (3);
+  for (/* Niente */; exponent; --exponent)
+    res *= base;
+  return res;
+}
+
