+      (calclloc).last_line++;
+      (calclloc).last_column = 1;
+    }
+  else
+    (calclloc).last_column++;
+
+  return res;
+}
+
+static void
+unget_char ( int c)
+{
+  ;
+
+  /* Wrong when C == `\n'. */
+  (calclloc) = last_yylloc;
+
+  ungetc (c, input);
