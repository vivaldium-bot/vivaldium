+	| DOWN
+	| LEFT
+	| RIGHT
+	| COMMAND_LINE
+	| COMMAND print_args
+	| PRINT print_args
+	| SH
+		{}
+	  DELIMITED
+	| COPY TEXT
+	| COPY TEXT THRU
+		{}
+	  DELIMITED
+		{}
+	  until
+	| COPY THRU
+		{}
+	  DELIMITED
+		{}
+	  until
