+TEST_P(ClearTest, ClearIssue)
+{
+    // TODO(geofflang): Figure out why this is broken on Intel OpenGL
+    if (isIntel() && getPlatformRenderer() == EGL_PLATFORM_ANGLE_TYPE_OPENGL_ANGLE)
+    {
