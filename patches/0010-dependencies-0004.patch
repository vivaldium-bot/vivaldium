index 0000000000000000000000000000000000000000..cc403145acf13457d64bc5663cc42616b5c8e040
--- /dev/null
+++ b/third_party/bison/src/bison/2.4.1/bison-2.4.1-src/lib/argmatch.h
@@ -0,0 +1,102 @@
+/* argmatch.h -- definitions and prototypes for argmatch.c
+
+   Copyright (C) 1990, 1998, 1999, 2001, 2002, 2004, 2005 Free Software
+   Foundation, Inc.
+
