+"  -v, --verbose              ar comhbhrÌ le `--report=state'\n"
+"  -b, --file-prefix=R…IMÕR   R…IMÕR ar aschomhaid\n"
+"  -o, --output=COMHAD        scrÌobh aschur sa CHOMHAD\n"
