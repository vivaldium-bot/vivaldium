+      perror (argv[1]);
+      return 3;
+    }
+
+  yydebug = 1;
+  status = yyparse (&result, &count);
+  fclose (input);
+  if (global_result != result)
+    abort ();
+  if (global_count != count)
+    abort ();
+  return status;
+}
