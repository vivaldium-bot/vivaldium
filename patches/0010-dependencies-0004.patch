+# YYLTYPE should be defined, and MY_LLOC declared.
+AT_DATA([caller.c],
+[[#include "input.h"
+YYLTYPE *my_llocp = &my_lloc;
+
+int my_parse (void);
+
+int
+main (void)
+{
+  return my_parse ();
+}
+]])
