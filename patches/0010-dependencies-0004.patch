+print $out <<EOF;
+%%
+input:
+  exp        { if (\$1 != 0) abort (); \$\$ = \$1; }
+| input exp  { if (\$2 != \$1 + 1) abort (); \$\$ = \$2; }
+;
+
+exp:
+  END
+    { \$\$ = 0; }
+EOF
+
+for my $size (1 .. $max)
+  {
+    use Text::Wrap;
+    print $out wrap ("| ", "   ",
+		     (map { "\"$_\"" } (1 .. $size)),
+		     " END \n"),
+               "    { \$\$ = $size; }\n";
+  };
