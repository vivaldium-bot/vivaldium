+   and Florian Krohm <florian@edamail.fishkill.ibm.com>.  */
+
+#include <config.h>
+
+#include "subpipe.h"
+
+#include <errno.h>
+
+#include <signal.h>
+#if ! defined SIGCHLD && defined SIGCLD
+# define SIGCHLD SIGCLD
+#endif
