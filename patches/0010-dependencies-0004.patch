diff --git a/third_party/angle/util/osx/OSXTimer.cpp b/third_party/angle/util/osx/OSXTimer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c3f6e27d311a982fd392c889851cce272da405d
