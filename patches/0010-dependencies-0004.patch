+  [\\/]* | ?:[\\/]* )
+    at_path=$at_path$as_dir
+    ;;
+  * )
+    if test -z "$at_top_build_prefix"; then
+      # Stand-alone test suite.
+      at_path=$at_path$as_dir
+    else
+      # Embedded test suite.
+      at_path=$at_path$at_top_build_prefix$as_dir$PATH_SEPARATOR
+      at_path=$at_path$at_top_srcdir/$as_dir
+    fi
+    ;;
+esac
+done
+IFS=$as_save_IFS
