-        used.push(false);
-    }
-    for (i = 0; i < expected.length; i++) {
-        var found = false;
-        for ( var j = 0; j < actual.length; j++) {
-            if (used[j] == false && expected[i] == actual[j]) {
-                used[j] = true;
-                found = true;
-                break;
-            }
-        }
-        if (!found) {
-            assert_unreached(message + ". Fail reason:  element not found: "
-                    + expected[i]);
-        }
-    }
-}
