-            if element.attrib.get('id') == 'expected':
-                self.expected = json.loads(unicode(element.text))
-                continue
-
-        if not name:
-            raise ValueError('No name found in file: %s' % filename)
-
-        super(HTMLItem, self).__init__(name, parent)
-
-
-    def reportinfo(self):
