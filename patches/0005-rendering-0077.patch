-function newIFrame(context, src) {
-    if (typeof (context) === 'undefined'
-            || typeof (context.iframes) !== 'object') {
-        assert_unreached('Illegal context object in newIFrame');
-    }
-
-    var iframe = document.createElement('iframe');
