-        function t(input, output)
-        {
-            element.setAttribute(attribute, input);
-            assert_equals(element[attribute], output);
-        }
-
-        t("", 0);
-        t("0", 0);
-        t("1", 1);
-        t("2147483647", 2147483647);
-        t("2147483648", 0);
-        t("-1", 0);
-        t("+42", 42);
-        t(" 42", 42);
-        t("42!", 42);
