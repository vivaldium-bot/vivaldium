new file mode 100644
index 0000000000000000000000000000000000000000..8b950b496cd6663af04887cfeaf823d198012070
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_decimate.c
@@ -0,0 +1,416 @@
