+        });
+        return;
+      }
+
+      const pid = event.pid;
+      if (pid === undefined) {
+        this.model_.importWarning({
+          type: 'memory_dump_parse_error',
+          message: 'Memory dump event (phase\'' + event.ph + '\', dump ID \'' +
+              dumpId + '\') without a PID.'
+        });
+        return;
+      }
