+    if (displayed === undefined) return true;
+    return displayed.indexOf('none') === -1;
+  }
+
+  /**
+   * Convert a list of ContainerMemoryDump(s) to a list of dictionaries of the
+   * underlying ProcessMemoryDump(s).
