index 0000000000000000000000000000000000000000..a7f93a27b1fe5b18b5ca6ccc6e5343b38d353b21
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/a64.c
@@ -0,0 +1,68 @@
+/*
+ * a64 muxer
+ * Copyright (c) 2009 Tobias Bindhammer
+ *
