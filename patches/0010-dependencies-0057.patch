index 0000000000000000000000000000000000000000..137df110efd90897b7b4f2e65bf6ab3b3ce48858
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/amr.c
@@ -0,0 +1,189 @@
+/*
+ * amr file format
+ * Copyright (c) 2001 ffmpeg project
