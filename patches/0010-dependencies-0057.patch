diff --git a/third_party/ffmpeg/libavformat/nistspheredec.c b/third_party/ffmpeg/libavformat/nistspheredec.c
new file mode 100644
index 0000000000000000000000000000000000000000..2f17f9eeb01c45bff4775e369b449288f08ccbd4
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/nistspheredec.c
@@ -0,0 +1,131 @@
+/*
+ * NIST Sphere demuxer
+ * Copyright (c) 2012 Paul B Mahol
+ *
