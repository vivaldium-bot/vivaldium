+      swapped: 1536
+    });
+    checkVMRegions(vmRegions, [
+      {
+        mappedFile: 'mock.so',
+        sizeInBytes: 6000,
+        byteStats: {
+          privateDirtyResident: 4096,
+          proportionalResident: 5120,
+          swapped: 1536
+        }
+      },
+      {
