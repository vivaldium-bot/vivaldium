+    const events = [
+      {name: 'createImports', args: {}, pid: 1, ts: 100,
+        cat: 'blink.user_timing', tid: 2, ph: 'b', id: 71},
+      {name: 'createImports', args: {}, pid: 1, ts: 200,
+        cat: 'blink.user_timing', tid: 2, ph: 'e', id: 71}
