index 0000000000000000000000000000000000000000..95a645b35c22b1e9c5ecbb3e749b3543866eb42d
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/avformat.h
@@ -0,0 +1,2806 @@
+/*
