+            ts: 10,
+            ph: 'v',
+            id: '0x0001',
+            cat: 'memory-infra',
+            args: {
+              dumps
+            }
+          });
+        });
+      });
+      checkParsedAndStreamInput(events, checkModel);
+    }
+
+    // Legacy trace events (without levels of detail).
