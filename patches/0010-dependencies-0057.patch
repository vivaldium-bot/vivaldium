new file mode 100644
index 0000000000000000000000000000000000000000..3925768fefd9b026360bb6846f474a1b385e9638
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/flvenc.c
@@ -0,0 +1,719 @@
