+// Older version without is_plain_text or offsetmap
+int UTF8GenericReplace(const UTF8ReplaceObj* st,
+                    const StringPiece& istr,
+                    StringPiece& ostr,
+                    int* bytes_consumed,
+                    int* bytes_filled,
+                    int* chars_changed) {
+  bool is_plain_text = false;
+  return UTF8GenericReplace(st,
+                    istr,
+                    ostr,
+                    is_plain_text,
+                    bytes_consumed,
+                    bytes_filled,
+                    chars_changed,
+                    NULL);
+}
