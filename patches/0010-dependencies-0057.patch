--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mxfdec.c
@@ -0,0 +1,3251 @@
+/*
+ * MXF demuxer.
+ * Copyright (c) 2006 SmartJog S.A., Baptiste Coudurier <baptiste dot coudurier at smartjog dot com>
+ *
+ * This file is part of FFmpeg.
