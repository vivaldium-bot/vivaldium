+
+<script>
+
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  test('nameConvert', function() {
+    assert.strictEqual(tr.e.cc.convertNameToJSConvention('_foo'), '_foo');
+    assert.strictEqual(tr.e.cc.convertNameToJSConvention('foo_'), 'foo_');
