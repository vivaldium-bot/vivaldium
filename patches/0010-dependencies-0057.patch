--- /dev/null
+++ b/third_party/ffmpeg/libavformat/oggparsevp8.c
@@ -0,0 +1,142 @@
+/*
+ * On2 VP8 parser for Ogg
+ * Copyright (C) 2013 James Almer
+ *
