+
+int ff_framehash_write_header(AVFormatContext *s)
+{
+    int i;
+
+    if (s->nb_streams && !(s->flags & AVFMT_FLAG_BITEXACT))
+        avio_printf(s->pb, "#software: %s\n", LIBAVFORMAT_IDENT);
