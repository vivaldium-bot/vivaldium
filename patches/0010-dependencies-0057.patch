+static void update16(uint16_t *target, int max, int intensity, int limit)
+{
+    if (*target <= max)
+        *target += intensity;
+    else
+        *target = limit;
+}
+
+static void update(uint8_t *target, int max, int intensity)
+{
+    if (*target <= max)
+        *target += intensity;
+    else
+        *target = 255;
+}
