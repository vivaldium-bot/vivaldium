diff --git a/third_party/ffmpeg/libavformat/os_support.c b/third_party/ffmpeg/libavformat/os_support.c
new file mode 100644
index 0000000000000000000000000000000000000000..86d0b8f306d2343b7bdf8940ac280583f83293fa
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/os_support.c
@@ -0,0 +1,335 @@
+/*
+ * various OS-feature replacement utilities
+ * Copyright (c) 2000, 2001, 2002 Fabrice Bellard
+ * copyright (c) 2002 Francois Revol
+ *
