index 0000000000000000000000000000000000000000..40e71e05de851d372c3a38fe7eb23bd2f4e20222
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_geq.c
@@ -0,0 +1,287 @@
+/*
+ * Copyright (C) 2006 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (C) 2012 Clément Bœsch <u pkh me>
+ *
