index 0000000000000000000000000000000000000000..e92c3b477f9d94d09aa223ab4145375281c200e4
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_bbox.c
@@ -0,0 +1,134 @@
+/*
