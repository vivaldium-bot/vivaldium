index 0000000000000000000000000000000000000000..ad6d488b3ac768675be62693c18f8ee3ecee2433
--- /dev/null
+++ b/third_party/ffmpeg/libavfilter/vf_blackframe.c
@@ -0,0 +1,143 @@
+/*
+ * Copyright (c) 2010 Stefano Sabatini
