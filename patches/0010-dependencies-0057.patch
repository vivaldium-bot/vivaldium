+        lower_values, higher_values, '/'.join(metric)).stdout)
+    self.assertEqual(result['result']['significance'], NEED_MORE_DATA)
+
+  def testCompareBuildbotOutput(self):
+    bb = os.path.join(os.path.dirname(__file__),
