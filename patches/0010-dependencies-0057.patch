+<script>
+'use strict';
+
+tr.b.unittest.testSuite(function() {
+  const ViewType = tr.b.MultiDimensionalViewBuilder.ViewType;
+  const TOP_DOWN_TREE_VIEW = ViewType.TOP_DOWN_TREE_VIEW;
+  const TOP_DOWN_HEAVY_VIEW = ViewType.TOP_DOWN_HEAVY_VIEW;
