+<script>
+'use strict';
+
+tr.exportTo('tr.model.um', function() {
+  class UserModel extends tr.model.EventContainer {
+    constructor(parentModel) {
+      super();
+      this.parentModel_ = parentModel;
+      this.expectations_ = new tr.model.EventSet();
+      this.segments_ = [];
+    }
+
+    get stableId() {
+      return 'UserModel';
