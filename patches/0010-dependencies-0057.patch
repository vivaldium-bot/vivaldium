diff --git a/third_party/ffmpeg/libavformat/iss.c b/third_party/ffmpeg/libavformat/iss.c
new file mode 100644
index 0000000000000000000000000000000000000000..fbde505a2dc051ee188cde380bb5992b69cd271d
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/iss.c
@@ -0,0 +1,153 @@
+/*
+ * ISS (.iss) file demuxer
+ * Copyright (c) 2008 Jaikrishnan Menon <realityman@gmx.net>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
