+    const tracingDump = pmd.getMemoryAllocatorDumpByFullName('tracing');
+    checkDumpNumericsAndDiagnostics(tracingDump, {
+      size: 1024,
+      effective_size: 1024,
+      resident_size: 1000
+    }, {});
+    assert.strictEqual(tracingDump.owns.target, ownedDump);
