--- /dev/null
+++ b/third_party/ffmpeg/libavformat/mpegtsenc.c
@@ -0,0 +1,1859 @@
+/*
+ * MPEG2 transport stream (aka DVB) muxer
+ * Copyright (c) 2003 Fabrice Bellard
+ *
