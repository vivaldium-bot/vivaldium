-function writeInt32(n, a, offset) {
-    n = Math.floor(n);
-    var b1 = n & 255;
-    var b2 = (n >> 8) & 255;
-    var b3 = (n >> 16) & 255;
-    var b4 = (n >> 24) & 255;
