-    Should('Maximum difference (in ulp units (' + bitDepth + '-bits))',
-      maxErrorULP).beLessThanOrEqualTo(thresholdDiffULP);
-
-    Should('Number of differences between results', diffCount)
-      .beLessThanOrEqualTo(thresholdDiffCount);
-}
