-    var distance = Math.sqrt(x * x + y * y + z * z);
-    distance = Math.min(distance, panner.maxDistance);
-    var rolloff = panner.rolloffFactor;
-    var gain = Math.pow(distance / panner.refDistance, -rolloff);
-
-    return gain;
