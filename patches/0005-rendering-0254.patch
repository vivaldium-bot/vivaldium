-    var maxError = -1;
-    var diffCount = 0;
-    var errorPosition = -1;
-    var thresholdSNR = (options.thresholdSNR || 10000);
-
-    var thresholdDiffULP = (options.thresholdDiffULP || 0);
-    var thresholdDiffCount = (options.thresholdDiffCount || 0);
