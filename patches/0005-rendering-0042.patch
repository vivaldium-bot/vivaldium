-      font: 80px/1 Ahem;
-      height: 320px;
-      position: relative;
-      width: 320px;
-    }
-
-  div#containing-block > span
-    {
-      background-color: green;
-      bottom: 1em;
-      color: green;
-      height: 1em;
-      position: absolute;
-      top: auto;
-      width: 1em;
-      writing-mode: vertical-rl;
-    }
-
-/*
-"
-4. 'top' is 'auto', 'height' and 'bottom' are not 'auto', then set 'auto' values for 'margin-top' and 'margin-bottom' to 0, and solve for 'top'
-"
-
