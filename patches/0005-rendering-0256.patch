+description(
+"This test checks that functions re-string-ify in a way that is syntactically " +
+"compatible with concatenation."
+);
+
+shouldBe("(function(){return}).toString()", "'function () {return;}'");
+shouldBe("(function(){return }).toString()", "'function () {return; }'");
