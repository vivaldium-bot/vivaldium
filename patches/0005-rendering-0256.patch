+PASS regex13.exec('xzzzxy') is ['xzzzx','x']
+PASS regex14.exec('aabc') is ['aabc','a','bc']
+PASS regex14.exec('aabcx') is ['aabc','a','bc']
+PASS regex15.exec('aabc') is ['aabc','a','bc']
+PASS regex15.exec('aabcx') is ['aabc','a','bc']
