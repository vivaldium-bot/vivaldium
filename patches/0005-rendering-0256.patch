+shouldBe("parseInt('9007199254740992.0e2000').toString()", "'9007199254740992'");
+
+shouldBe("parseInt(NaN)", "NaN");
+shouldBe("parseInt(-Infinity)", "NaN");
+shouldBe("parseInt(Infinity)", "NaN");
+
+shouldBe("parseInt(-0.6).toString()", "'0'");
