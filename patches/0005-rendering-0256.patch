+shouldBeTrue("isObjectStrict({ })");
+shouldBeFalse("isObjectStrict(1)");
+
+function isFunction(a)
+{
+    return typeof a == "function";
+}
+
+shouldBeTrue("isFunction(function () { })");
+shouldBeFalse("isFunction(1)");
+
+function isFunctionStrict(a)
