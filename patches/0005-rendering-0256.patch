-function timeString( date ) {
-	var minutes = date.getMinutes();
-	if (minutes < 10 ) {
-		minutes = "0" + minutes;
-	}
-	var hours = date.getHours();
-	if (hours < 12) {
-		var suffix = "A";
-	} else {
-		var suffix = "P";
-	}
-	if (hours == 0) {
-		hours = 12;
-	} else if (hours > 12) {
-		hours -= 12;
-	}
-	return hours + ":" + minutes + suffix;
-}
