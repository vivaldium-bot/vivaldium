+
+
+// Test handling of \u007c "|"
+var bsample="sample bm\u007cp cm\\u007cp";
+
+var binlineRe=/.m\u007cp/
+var bevalInlineRe=eval("/.m\\u007cp/")
+var bexplicitRe=new RegExp(".m\\u007cp")
