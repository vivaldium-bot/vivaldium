+description(
+"Tests that a DFG PutById that allocates, and then reallocates, property storage works."
+);
+
+function foo() {
+    var o = {};
+    o.a = 1;
+    o.b = 2;
+    o.c = 3;
+    o.d = 4;
+    o.e = 5;
+    o.f = 6;
