+);
+
+var o = new Object();
+shouldBe("o.toLocaleString()", "o.toString()");
+o.toLocaleString = function () { return "Dynamic toLocaleString()"; }
+shouldBe("o.toLocaleString()", '"Dynamic toLocaleString()"');
+
