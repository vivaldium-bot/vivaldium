+
+shouldBeTrue("isStringStrict('string')");
+shouldBeFalse("isStringStrict(1)");
+
+function isObject(a)
+{
+    return typeof a == "object";
+}
+
+shouldBeTrue("isObject({ })");
+shouldBeFalse("isObject(1)");
+
+function isObjectStrict(a)
+{
+    return typeof a === "object";
+}
