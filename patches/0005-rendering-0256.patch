+);
+
+shouldBe("Number(1152921504606847105).toString()", "'1152921504606847200'");
+shouldBe("parseInt('1152921504606847105').toString()", "'1152921504606847200'");
+shouldBe("(- (- '1152921504606847105')).toString()", "'1152921504606847200'");
