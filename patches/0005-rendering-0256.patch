+    output("set style line 2 lt 1 lw 1 lc rgb \"#9944CC\"");
+    output("set xtics out nomirror");
+    output("unset key");
+
+    function DrawBarBase(color, start, end, top, bottom, transparency) {
+      obj_index++;
