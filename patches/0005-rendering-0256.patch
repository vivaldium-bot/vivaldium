+description("KDE JS Test");
+function testSwitch(v) {
+  var result = "";
+  switch (v) {
+     case 0:
+        result += 'a';
+     case 1:
+        result += 'b';
+     case 1:
+        result += 'c';
+     case 2:
+        result += 'd';
+        break;
+  }
+  return result;
+}
+
+shouldBe("testSwitch(0)", "'abcd'");
+shouldBe("testSwitch(1)", "'bcd'"); // IE agrees, NS disagrees
+shouldBe("testSwitch(2)", "'d'");
+shouldBe("testSwitch(false)", "''");
+
+function testSwitch2(v) {
+  var result = "";
+  switch (v) {
+     case 1:
+        result += 'a';
+        break;
+     case 2:
+        result += 'b';
+        break;
+     default:
+        result += 'c';
+     case 3:
+        result += 'd';
+        break;
+  }
