+<td class="file">normlzr.h</td><td class="proto">UBool icu::Normalizer::operator!=(const Normalizer&amp;)</td><td class="stabchange">Stable<br>2.0</td><td>Deprecated<br>
+<span class=""><span></span></span></td>
