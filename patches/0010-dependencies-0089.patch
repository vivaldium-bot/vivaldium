+        [FlatBuffersTestMethod]
+        public void TestWithFloat()
+        {
+            var builder = new FlatBufferBuilder(1);
+            builder.StartObject(1);
+            builder.AddFloat(0, 1, 0);
+            builder.EndObject();
+
