+         /// <summary>
+         /// Finalize a buffer, pointing to the given `rootTable`.
+         /// </summary>
+         /// <param name="rootTable">
+         /// An offset to be added to the buffer.
+         /// </param>
+         /// <param name="fileIdentifier">
