+        ]
+      } else if (is_android) {
+        sources = [
+          "android/icudtl_dat.S",
+        ]
+      } else {
+        assert(false, "No icu data for this platform")
+      }
+      defines = [ "U_HIDE_DATA_SYMBOL" ]
+    }
+  }
