+        b2.x ||
+        b2.y ||
+        b3.x ||
+        b3.y ||
+        b3.z ||
+        b4.x ||
+        b4.y ||
+        b4.z ||
+        b4.w ? vec4(
+        i  +
+        i2.x +
+        i2.y +
+        i3.x +
+        i3.y +
+        i3.z +
+        i4.x +
+        i4.y +
+        i4.z +
+        i4.w +
+        f  +
+        f2.x +
+        f2.y +
+        f3.x +
+        f3.y +
+        f3.z +
+        f4.x +
+        f4.y +
+        f4.z +
+        f4.w) : vec4(1.0);
