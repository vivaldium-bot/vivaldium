+        pContext->ThrowScriptErrorMessage(XFA_IDS_ARGUMENT_MISMATCH);
+      } else {
+        FX_DOUBLE* pData = FX_Alloc(FX_DOUBLE, argc - 1);
+        for (int32_t i = 1; i < argc; i++) {
+          pData[i - 1] = HValueToDouble(hThis, argValues[i]);
