+}
+void CBC_DataMatrixVersion::Finalize() {
+  for (int32_t i = 0; i < VERSIONS->GetSize(); i++) {
+    delete ((CBC_DataMatrixVersion*)(VERSIONS->GetAt(i)));
+  }
+  VERSIONS->RemoveAll();
