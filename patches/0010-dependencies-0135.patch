+void CRYPT_ArcFourSetup(void* context, const uint8_t* key, uint32_t length) {
+  rc4_state* s = (rc4_state*)context;
+  int i, j, k, *m, a;
+  s->x = 0;
+  s->y = 0;
+  m = s->m;
+  for (i = 0; i < 256; i++) {
+    m[i] = i;
+  }
+  j = k = 0;
+  for (i = 0; i < 256; i++) {
+    a = m[i];
+    j = (j + a + key[k]) & 0xFF;
+    m[i] = m[j];
+    m[j] = a;
+    if (++k >= (int)length) {
+      k = 0;
+    }
+  }
