+}
+void CFWL_ScrollBarTP::DrawTrack(CFX_Graphics* pGraphics,
+                                 const CFX_RectF* pRect,
+                                 FX_BOOL bVert,
+                                 FWLTHEME_STATE eState,
+                                 FX_BOOL bLowerTrack,
+                                 CFX_Matrix* pMatrix) {
+  if (pRect->IsEmpty()) {
