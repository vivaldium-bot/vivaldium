+_tp *_nbuff = new _tp[(_sz)+(_al)-1]; \
+_tp *_nm = _nbuff + ((_al)-1) - (((uintptr_t)(_nbuff + ((_al)-1)) & ((_al)-1))/sizeof(_tp));
