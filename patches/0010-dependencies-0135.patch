+CFX_ByteString CFX_ByteString::FromUnicode(const FX_WCHAR* str,
+                                           FX_STRSIZE len) {
+  FX_STRSIZE str_len = len >= 0 ? len : FXSYS_wcslen(str);
+  return FromUnicode(CFX_WideString(str, str_len));
