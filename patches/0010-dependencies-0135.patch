+TEST (ReconstructionFunTest, WelsHadamardT4Dc) {
+  ENFORCE_STACK_ALIGN_1D (int16_t, pDct, 16 * 16, 16)
+  ENFORCE_STACK_ALIGN_2D (int16_t, pLumaDc, 2, 16, 16)
