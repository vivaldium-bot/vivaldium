+CFX_ByteString CBC_OnedUPCAReader::MaybeReturnResult(CFX_ByteString& result,
+                                                     int32_t& e) {
+  if (result[0] == '0') {
+    result.Delete(0);
+    return result;
+  } else {
+    e = BCExceptionFormatException;
+    return "";
+  }
+  return "";
+}
