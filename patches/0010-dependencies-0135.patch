+
+bool event::fieldFull(IJS_Context* cc,
+                      CJS_PropValue& vp,
+                      CFX_WideString& sError) {
+  CJS_Context* pContext = (CJS_Context*)cc;
+  CJS_EventHandler* pEvent = pContext->GetEventHandler();
+
+  if (!vp.IsGetting() &&
+      wcscmp((const wchar_t*)pEvent->Name(), L"Keystroke") != 0)
+    return false;
+
+  if (pEvent->FieldFull())
+    vp << true;
+  else
+    vp << false;
+  return true;
+}
