+    OMX_F32 *out1 = out0 + n_by_4;
+    OMX_F32 *out2 = out1 + n_by_4;
+    OMX_F32 *out3 = out2 + n_by_4;
+
+    VC_LOAD_SPLIT(&v_t0, in0, n);
+    VC_LOAD_SPLIT(&v_t1, in1, n);
+    VC_LOAD_SPLIT(&v_t2, in2, n);
+    VC_LOAD_SPLIT(&v_t3, in3, n);
