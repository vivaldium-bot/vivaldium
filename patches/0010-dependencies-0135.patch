+  void ToIntArray(int32_t a, int32_t* toReturn);
+  FX_CHAR CalcCheckSum(const CFX_ByteString& contents, int32_t& e);
+
+  int32_t m_iWideNarrRatio;
+  FX_BOOL m_extendedMode;
+};
