+  -7.305627692278276e-01f,   6.828455463852481e-01f,
+  -7.295144381469970e-01f,   6.839654117973154e-01f,
+  -7.284643904482252e-01f,   6.850836677727004e-01f,
+  -7.274126286023758e-01f,   6.862003116800386e-01f,
+  -7.263591550843460e-01f,   6.873153408917590e-01f,
+  -7.253039723730608e-01f,   6.884287527840904e-01f,
+  -7.242470829514670e-01f,   6.895405447370668e-01f,
+  -7.231884893065275e-01f,   6.906507141345346e-01f,
+  -7.221281939292153e-01f,   6.917592583641577e-01f,
+  -7.210661993145081e-01f,   6.928661748174246e-01f,
+  -7.200025079613817e-01f,   6.939714608896540e-01f,
+  -7.189371223728045e-01f,   6.950751139800009e-01f,
+  -7.178700450557317e-01f,   6.961771314914630e-01f,
+  -7.168012785210995e-01f,   6.972775108308865e-01f,
+  -7.157308252838186e-01f,   6.983762494089729e-01f,
+  -7.146586878627691e-01f,   6.994733446402838e-01f,
+  -7.135848687807936e-01f,   7.005687939432483e-01f,
+  -7.125093705646923e-01f,   7.016625947401685e-01f,
+  -7.114321957452164e-01f,   7.027547444572253e-01f,
+  -7.103533468570624e-01f,   7.038452405244849e-01f,
+  -7.092728264388657e-01f,   7.049340803759049e-01f,
+  -7.081906370331954e-01f,   7.060212614493397e-01f,
+  -7.071067811865476e-01f,   7.071067811865475e-01f,
+#else
+#error Unsupported twiddle table size
+#endif
+};
diff --git a/third_party/openmax_dl/dl/sp/src/mips/mips_FFTFwd_RToCCS_F32_complex.c b/third_party/openmax_dl/dl/sp/src/mips/mips_FFTFwd_RToCCS_F32_complex.c
