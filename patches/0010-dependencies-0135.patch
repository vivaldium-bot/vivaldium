+  ctx->state[1] = 0xEFCDAB89;
+  ctx->state[2] = 0x98BADCFE;
+  ctx->state[3] = 0x10325476;
+}
+void CRYPT_MD5Update(void* pctx, const uint8_t* input, uint32_t length) {
+  struct md5_context* ctx = (struct md5_context*)pctx;
