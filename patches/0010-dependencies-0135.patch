+  FX_FLOAT min_x = pPoints->x, max_x = pPoints->x, min_y = pPoints->y,
+           max_y = pPoints->y;
+  for (int i = 1; i < nPoints; i++) {
+    if (min_x > pPoints[i].x) {
+      min_x = pPoints[i].x;
