+    Var('chromium_git') + '/skia.git' + '@' +  Var('skia_revision'),
+
+  "tools/clang":
+    Var('chromium_git') + "/chromium/src/tools/clang@" +  Var('clang_revision'),
+
+  "tools/generate_library_loader":
+    Var('chromium_git') + "/chromium/src/tools/generate_library_loader@" +
