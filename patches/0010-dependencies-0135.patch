+TEST(fxcrt, WideStringOperatorSubscript) {
+  // CFX_WideString includes the NUL terminator for non-empty strings.
+  CFX_WideString abc(L"abc");
+  EXPECT_EQ(L'a', abc[0]);
+  EXPECT_EQ(L'b', abc[1]);
+  EXPECT_EQ(L'c', abc[2]);
+  EXPECT_EQ(L'\0', abc[3]);
+}
