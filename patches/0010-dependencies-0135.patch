+FX_BOOL CXFA_Node::TryMeasure(XFA_ATTRIBUTE eAttr,
+                              CXFA_Measurement& mValue,
+                              FX_BOOL bUseDefault) const {
+  void* pKey = XFA_GetMapKey_Element(GetClassID(), eAttr);
+  void* pValue;
