+CXFA_LayoutProcessor::CXFA_LayoutProcessor(CXFA_Document* pDocument)
+    : m_pDocument(pDocument),
+      m_pRootItemLayoutProcessor(NULL),
+      m_pLayoutPageMgr(NULL),
+      m_nProgressCounter(0),
+      m_bNeeLayout(TRUE) {}
