+void CFX_RenderDevice::InitDeviceInfo() {
+  m_Width = m_pDeviceDriver->GetDeviceCaps(FXDC_PIXEL_WIDTH);
+  m_Height = m_pDeviceDriver->GetDeviceCaps(FXDC_PIXEL_HEIGHT);
+  m_bpp = m_pDeviceDriver->GetDeviceCaps(FXDC_BITS_PIXEL);
