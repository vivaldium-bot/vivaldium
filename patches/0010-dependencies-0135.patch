diff --git a/third_party/pdfium/public/fpdf_structtree.h b/third_party/pdfium/public/fpdf_structtree.h
new file mode 100644
index 0000000000000000000000000000000000000000..3d4da402aa53c07a36e4af904c46f9cbf376b4a3
--- /dev/null
