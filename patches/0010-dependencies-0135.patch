+    m_iStrideA = rand() % 256 + PIXEL_STRIDE;
+    m_iStrideB = rand() % 256 + PIXEL_STRIDE;
+    m_pPixSrcA = (uint8_t*)pMemAlign->WelsMalloc (m_iStrideA << 5, "Sad_m_pPixSrcA");
