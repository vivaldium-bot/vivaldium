+
+  if (vp.IsSetting()) {
+    if (!m_bCanSet)
+      return false;
+
+    if (!vp.GetJSValue()->IsArrayObject())
+      return false;
+
+    vp >> crArray;
+
+    CPWL_Color color;
+    color::ConvertArrayToPWLColor(pRuntime, crArray, &color);
