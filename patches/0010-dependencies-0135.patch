+void CPWL_Wnd::CreateVScrollBar(const PWL_CREATEPARAM& cp) {
+  if (!m_pVScrollBar && HasFlag(PWS_VSCROLL)) {
+    PWL_CREATEPARAM scp = cp;
+
+    // flags
+    scp.dwFlags =
+        PWS_CHILD | PWS_BACKGROUND | PWS_AUTOTRANSPARENT | PWS_NOREFRESHCLIP;
