+                                 const CFX_WideStringC& wsFilter,
+                                 CFX_WideStringArray& wsPathArr,
+                                 FX_BOOL bOpen = TRUE) = 0;
+  virtual IFWL_AdapterTimerMgr* GetTimerMgr() = 0;
+};
