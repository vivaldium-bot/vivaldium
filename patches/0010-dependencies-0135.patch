+                       FX_BOOL bRaw,
+                       const CFX_WideString& wsAttr,
+                       CFX_WideString& wsValue);
+
+ protected:
+  CXFA_WidgetAcc* m_pWidgetAcc;
+  XFA_TEXTPROVIDERTYPE m_eType;
+  CXFA_Node* m_pTextNode;
+};
