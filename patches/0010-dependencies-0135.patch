+        } else {
+          wsXMLBuf.Clear();
+          return;
+        }
+      } else {
+        while (ch != ';' && i < iLen) {
+          strString[iStrIndex++] = ch;
+          ++i;
+          ch = *(pData + i);
+        }
+        strString[iStrIndex] = 0;
