+      if (u > iWidth || (iPrecision + u) >= iWidth) {
+        int32_t i = 0;
+        while (i < iWidth) {
+          resultBuf.AppendChar('*');
+          ++i;
+        }
+        resultBuf.AppendChar(0);
+      } else {
+        if (u == iLength) {
+          if (iLength > iWidth) {
+            int32_t i = 0;
+            while (i < iWidth) {
+              resultBuf.AppendChar('*');
+              ++i;
+            }
+          } else {
+            int32_t i = 0;
+            int32_t iSpace = iWidth - iLength;
+            while (i < iSpace) {
+              resultBuf.AppendChar(' ');
+              ++i;
+            }
+            resultBuf << pData;
+          }
+        } else {
+          int32_t iLeavingSpace = 0;
+          if (iPrecision == 0) {
