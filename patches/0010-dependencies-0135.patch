+CFWL_FontData::CFWL_FontData()
+    : m_dwStyles(0),
+      m_dwCodePage(0),
+      m_pFont(0),
+      m_pFontMgr(NULL)
+#if _FXM_PLATFORM_ != _FXM_PLATFORM_WINDOWS_
