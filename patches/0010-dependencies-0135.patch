+  FX_BOOL RemoveKey(KeyType key) {
+    return CFX_MapPtrToPtr::RemoveKey((void*)key);
+  }
+
+  void RemoveAll() { CFX_MapPtrToPtr::RemoveAll(); }
+
+  FX_POSITION GetStartPosition() const {
