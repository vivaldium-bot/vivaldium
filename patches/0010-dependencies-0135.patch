+
+  "tools/memory":
+    Var('chromium_git') + "/chromium/src/tools/memory@" +
+        Var('tools_memory_revision'),
+
+  "v8":
+    Var('chromium_git') + "/v8/v8.git@" + Var('v8_revision'),
