+void CRYPT_ArcFourCrypt(void* context, unsigned char* data, uint32_t length) {
+  struct rc4_state* s = (struct rc4_state*)context;
+  int i, x, y, *m, a, b;
+  x = s->x;
+  y = s->y;
+  m = s->m;
+  for (i = 0; i < (int)length; i++) {
+    x = (x + 1) & 0xFF;
+    a = m[x];
+    y = (y + a) & 0xFF;
+    m[x] = b = m[y];
+    m[y] = a;
+    data[i] ^= m[(a + b) & 0xFF];
+  }
+  s->x = x;
+  s->y = y;
