+class CFX_BilinearMatrix : public CPDF_FixedMatrix {
+ public:
+  CFX_BilinearMatrix(const CFX_Matrix& src, int bits)
+      : CPDF_FixedMatrix(src, bits) {}
+  inline void Transform(int x,
+                        int y,
+                        int& x1,
+                        int& y1,
+                        int& res_x,
+                        int& res_y) {
+    x1 = a * x + c * y + e + base / 2;
+    y1 = b * x + d * y + f + base / 2;
+    res_x = x1 % base;
+    res_y = y1 % base;
+    if (res_x < 0 && res_x > -base) {
+      res_x = base + res_x;
+    }
+    if (res_y < 0 && res_x > -base) {
+      res_y = base + res_y;
+    }
+    x1 /= base;
+    y1 /= base;
+  }
+};
