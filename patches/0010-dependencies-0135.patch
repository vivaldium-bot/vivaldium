+void CFX_Matrix::Translate(FX_FLOAT x, FX_FLOAT y, bool bPrepended) {
+  if (bPrepended) {
+    e += x * a + y * c;
+    f += y * d + x * b;
+  } else {
+    e += x, f += y;
+  }
+}
+void CFX_Matrix::Scale(FX_FLOAT sx, FX_FLOAT sy, bool bPrepended) {
+  a *= sx, d *= sy;
+  if (bPrepended) {
+    b *= sx;
+    c *= sy;
+  } else {
+    b *= sy;
+    c *= sx;
+    e *= sx;
+    f *= sy;
+  }
