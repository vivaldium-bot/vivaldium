+FWL_ERR CXFA_FWLAdapterWidgetMgr::RepaintWidget(IFWL_Widget* pWidget,
+                                                const CFX_RectF* pRect) {
+  if (!pWidget)
+    return FWL_ERR_Indefinite;
+  CXFA_FFField* pField = (CXFA_FFField*)pWidget->GetPrivateData(pWidget);
