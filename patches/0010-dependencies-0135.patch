+void CPDFSDK_Widget::ResetAppearance(bool bValueChanged) {
+  switch (GetFieldType()) {
+    case FIELDTYPE_TEXTFIELD:
+    case FIELDTYPE_COMBOBOX: {
+      bool bFormatted = false;
+      CFX_WideString sValue = OnFormat(bFormatted);
