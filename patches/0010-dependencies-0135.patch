+                      CFX_Graphics* pGraphics,
+                      const CFX_RectF* pRtBox,
+                      FX_BOOL bDisable = FALSE,
+                      CFX_Matrix* pMatrix = NULL);
+  void SetThemeData(uint32_t dwID);
+  void initCheckPath(FX_FLOAT fCheckLen);
+  struct CKBThemeData {
+    FX_ARGB clrBoxBk[13][2];
