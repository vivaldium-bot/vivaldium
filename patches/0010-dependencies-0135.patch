+TEST(fxcrt, RetainPtrEquals) {
+  PseudoRetainable obj1;
+  PseudoRetainable obj2;
+  CFX_RetainPtr<PseudoRetainable> null_ptr1;
+  CFX_RetainPtr<PseudoRetainable> obj1_ptr1(&obj1);
+  CFX_RetainPtr<PseudoRetainable> obj2_ptr1(&obj2);
+  {
