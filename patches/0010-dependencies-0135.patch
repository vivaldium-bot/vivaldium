+  }
+
+  if (verbose > 63) {
+    printf("FFT Output\n");
+    DumpArrayComplex32("y", fft_size / 2, y);
+  }
+
+  CompareComplex32(snr, y, y_true, fft_size / 2 + 1);
+
+  FreeAlignedPointer(x_aligned);
+  FreeAlignedPointer(y_aligned);
+  free(fft_fwd_spec);
+
+  return snr->complex_snr_;
+}
