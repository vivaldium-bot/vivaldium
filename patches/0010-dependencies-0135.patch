+  bool bCheckit = true;
+  if (iSize >= 2)
+    bCheckit = params[1].ToBool(pRuntime);
+
+  std::vector<CPDF_FormField*> FieldArray = GetFormFields(m_FieldName);
+  if (FieldArray.empty())
+    return false;
