+                                      XFA_OBJECTTYPE_ContainerNode);
+  }
+  static CXFA_Node* GetParent(CXFA_Node* pTemplateNode,
+                              void* pUserData = NULL) {
+    return pTemplateNode->GetNodeItem(XFA_NODEITEM_Parent,
+                                      XFA_OBJECTTYPE_ContainerNode);
+  }
+};
