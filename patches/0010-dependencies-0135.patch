+  void GetNextAssoc(FX_POSITION& rNextPosition, KeyType& rKey) const {
+    void* pKey = NULL;
+    void* pValue = NULL;
+    CFX_MapPtrToPtr::GetNextAssoc(rNextPosition, pKey, pValue);
