+class CPDFXFA_Page {
+ public:
+  CPDFXFA_Page(CPDFXFA_Context* pContext, int page_index);
+
+  void Retain() { m_iRef++; }
+  void Release() {
+    if (--m_iRef <= 0)
+      delete this;
+  }
+
+  bool LoadPage();
+  bool LoadPDFPage(CPDF_Dictionary* pageDict);
+  CPDFXFA_Context* GetContext() const { return m_pContext; }
