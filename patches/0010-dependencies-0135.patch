+                  CFX_WideString& csSubject,
+                  CFX_WideString& csMsg);
+  bool ExportSubmitFile(FPDF_FILEHANDLER* ppFileHandler,
+                        int fileType,
+                        FPDF_DWORD encodeType,
+                        FPDF_DWORD flag);
+  void ToXFAContentFlags(CFX_WideString csSrcContent, FPDF_DWORD& flag);
