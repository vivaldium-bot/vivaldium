+ *              the following is true:
+ *    -   pSrc or pDst is NULL
+ *    -   len < 0
+ *
+ */
+OMXResult omxSP_Copy_S16 (
+    const OMX_S16 *pSrc,
+    OMX_S16 *pDst,
+    OMX_INT len
+);
