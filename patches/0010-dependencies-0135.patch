+CFX_ByteArray& CBC_BarcodeRow::getScaledRow(int32_t scale) {
+  m_output.SetSize(m_row.GetSize() * scale);
+  for (int32_t i = 0; i < m_output.GetSize(); i++) {
+    m_output[i] = (m_row[i / scale]);
+  }
+  return m_output;
+}
