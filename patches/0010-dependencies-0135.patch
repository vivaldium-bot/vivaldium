+  if (flags & FXFONT_SERIF)
+    PitchFamily |= FXFONT_FF_ROMAN;
+  if (flags & FXFONT_SCRIPT)
+    PitchFamily |= FXFONT_FF_SCRIPT;
+  if (flags & FXFONT_FIXED_PITCH)
+    PitchFamily |= FXFONT_FF_FIXEDPITCH;
+}
