+const FPF_SKIAFONTMAP g_SkiaSansFontMap[] = {
+    {0x58c5083, 0xd5b8d10f},  {0x14ee2d13, 0xd5b8d10f},
+    {0x779ce19d, 0xd5b8d10f}, {0xcb7a04c8, 0xd5b8d10f},
