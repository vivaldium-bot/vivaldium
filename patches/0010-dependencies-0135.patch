+class CBC_WhiteRectangleDetector {
+ public:
+  CBC_WhiteRectangleDetector(CBC_CommonBitMatrix* image);
+  CBC_WhiteRectangleDetector(CBC_CommonBitMatrix* image,
+                             int32_t initSize,
+                             int32_t x,
+                             int32_t y);
