+      (pParams->m_dwStates &
+       (FWL_PARTSTATE_MCD_Hovered | FWL_PARTSTATE_MCD_Selected))) {
+    m_pTextOut->SetTextColor(0xFFFFFFFF);
+  } else if (pParams->m_iPart == FWL_PART_MCD_Caption) {
+    m_pTextOut->SetTextColor(m_pThemeData->clrCaption);
