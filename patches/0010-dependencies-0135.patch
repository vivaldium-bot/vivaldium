+#define FPDFSDK_FPDFXFA_CPDFXFA_CONTEXT_H_
+
+#include <memory>
+
+#include "fpdfsdk/fpdfxfa/cpdfxfa_docenvironment.h"
+#include "xfa/fxfa/xfa_ffdoc.h"
+
+class CJS_Runtime;
+class CPDFSDK_FormFillEnvironment;
