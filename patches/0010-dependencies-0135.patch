+      if (iPrecision) {
+        formatStr += ".";
+        formatStr += CFX_ByteString::FormatInteger(iPrecision);
+      }
+      formatStr += "f";
+      numberString.Format(formatStr, fNumber);
+      const FX_CHAR* pData = numberString;
+      int32_t iLength = numberString.GetLength();
+      int32_t u = 0;
+      while (u < iLength) {
