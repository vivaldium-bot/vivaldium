+CPDFSDK_FormFillEnvironment::CPDFSDK_FormFillEnvironment(
+    UnderlyingDocumentType* pDoc,
+    FPDF_FORMFILLINFO* pFFinfo)
+    : m_pInfo(pFFinfo),
+      m_pUnderlyingDoc(pDoc),
+      m_pSysHandler(new CFX_SystemHandler(this)),
+      m_bChangeMask(false),
+      m_bBeingDestroyed(false) {}
