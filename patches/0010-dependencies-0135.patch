+CXFA_FFWidget* XFA_ThemeGetOuterWidget(IFWL_Widget* pWidget) {
+  IFWL_Widget* pOuter = pWidget;
+  while (pOuter->GetOuter()) {
+    pOuter = pOuter->GetOuter();
+  }
+  if (pOuter) {
+    return (CXFA_FFWidget*)pOuter->GetPrivateData(pOuter);
+  }
+  return NULL;
