+void CFWL_FormTP::DrawMinimizeBox(CFX_Graphics* pGraphics,
+                                  const CFX_RectF* pRect,
+                                  FWLTHEME_STATE eState,
+                                  CFX_Matrix* pMatrix,
+                                  int32_t iActive) {
+  DrawMinMaxBoxCommon(pGraphics, pRect, eState, pMatrix);
+  CFX_RectF rtMin;
+  rtMin.Set(pRect->left + 5, pRect->top + 13, pRect->width - 14,
+            pRect->height - 18);
