+    FXSYS_memcpy(&mValue, pValue, sizeof(mValue));
+    return TRUE;
+  }
+  if (bUseDefault &&
+      XFA_GetAttributeDefaultValue(pValue, GetClassID(), eAttr,
+                                   XFA_ATTRIBUTETYPE_Measure, m_ePacket)) {
+    FXSYS_memcpy(&mValue, pValue, sizeof(mValue));
+    return TRUE;
+  }
+  return FALSE;
