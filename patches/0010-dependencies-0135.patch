+  }
+  path.Clear();
+  path.MoveTo(rtLBtn.left + rtLBtn.Width() / 3 * 2,
+              rtLBtn.top + rtLBtn.height / 4);
+  path.LineTo(rtLBtn.left + rtLBtn.Width() / 3, rtLBtn.top + rtLBtn.height / 2);
+  path.LineTo(rtLBtn.left + rtLBtn.Width() / 3 * 2,
