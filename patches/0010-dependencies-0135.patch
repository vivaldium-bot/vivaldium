+    OMX_F32 *out3 = out2 + n_by_4;
+
+    VC v_tw1;
+    VC v_tw2;
+    VC v_tw3;
+    VC v_t0;
+    VC v_t1;
+    VC v_t2;
+    VC v_t3;
+    VC v_t4;
