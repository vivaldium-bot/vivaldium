+CPWL_EditCtrl::CPWL_EditCtrl()
+    : m_pEdit(new CFX_Edit),
+      m_pEditCaret(nullptr),
+      m_bMouseDown(false),
+      m_nCharSet(FXFONT_DEFAULT_CHARSET),
+      m_nCodePage(0) {}
