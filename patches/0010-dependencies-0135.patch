+  FX_FLOAT sinValue = FXSYS_sin(fRadian);
+  CFX_Matrix m;
+  m.Set(cosValue, sinValue, -sinValue, cosValue, 0, 0);
+  if (bPrepended) {
+    FXCRT_Matrix_Concat(*this, m, *this);
+  } else {
+    FXCRT_Matrix_Concat(*this, *this, m);
+  }
