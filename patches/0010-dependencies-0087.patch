+
+/* This test exercises IPv4, IPv6, and dualstack sockets in various ways. */
+
+static void *tag(intptr_t i) { return (void *)i; }
+
+static gpr_timespec ms_from_now(int ms) {
+  return GRPC_TIMEOUT_MILLIS_TO_DEADLINE(ms);
+}
+
+static void drain_cq(grpc_completion_queue *cq) {
+  grpc_event ev;
+  do {
+    ev = grpc_completion_queue_next(cq, ms_from_now(5000), NULL);
+  } while (ev.type != GRPC_QUEUE_SHUTDOWN);
+}
+
+static void do_nothing(void *ignored) {}
+
+void test_connect(const char *server_host, const char *client_host, int port,
+                  int expect_ok) {
+  char *client_hostport;
+  char *server_hostport;
+  grpc_channel *client;
+  grpc_server *server;
+  grpc_completion_queue *cq;
+  grpc_call *c;
+  grpc_call *s;
+  cq_verifier *cqv;
+  gpr_timespec deadline;
+  int got_port;
+  grpc_op ops[6];
+  grpc_op *op;
+  grpc_metadata_array initial_metadata_recv;
+  grpc_metadata_array trailing_metadata_recv;
+  grpc_metadata_array request_metadata_recv;
+  grpc_status_code status;
+  grpc_call_error error;
+  char *details = NULL;
+  size_t details_capacity = 0;
+  int was_cancelled = 2;
+  grpc_call_details call_details;
+  char *peer;
+  int picked_port = 0;
+
+  if (port == 0) {
+    port = grpc_pick_unused_port_or_die();
+    picked_port = 1;
+  }
+
+  gpr_join_host_port(&server_hostport, server_host, port);
+
+  grpc_metadata_array_init(&initial_metadata_recv);
