--- /dev/null
+++ b/third_party/grpc/src/ruby/ext/grpc/rb_call_credentials.c
@@ -0,0 +1,298 @@
+/*
+ *
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
