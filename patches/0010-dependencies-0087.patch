+      call = make_test_call
+      ActiveCall.client_invoke(call)
+      @client_call = ActiveCall.new(call, @pass_through,
+                                    @pass_through, deadline)
+    end
+
+    describe '#multi_req_view' do
+      it 'exposes a fixed subset of the ActiveCall.methods' do
