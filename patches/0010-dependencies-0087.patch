diff --git a/third_party/grpc/test/cpp/util/grpc_cli.cc b/third_party/grpc/test/cpp/util/grpc_cli.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c52e48bae650c1b5502de335473677a2ad80030a
--- /dev/null
+++ b/third_party/grpc/test/cpp/util/grpc_cli.cc
@@ -0,0 +1,226 @@
+/*
+
+ * Copyright 2015, Google Inc.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met:
