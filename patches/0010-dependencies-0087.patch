+!endif
+!if !defined(MFLAGS)
+MFLAGS=
+!endif
+
+# Directories used by "make":
+srcdir = .
+
+# Directories used by "make install":
+prefix = c:\usr
+exec_prefix = $(prefix)
+datadir = $(prefix)\share
+bindir = $(exec_prefix)\bin
+mandir = $(datadir)\man
+man1dir = $(mandir)\man1
+docdir = $(datadir)\doc\gperf
+
+# Programs used by "make":
+
