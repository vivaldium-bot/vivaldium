+
+  before(:each) do
+    @pass_through = proc { |x| x }
+    host = '0.0.0.0:0'
+    @server = GRPC::Core::Server.new(nil)
+    server_port = @server.add_http2_port(host, :this_port_is_insecure)
+    @server.start
