index 0000000000000000000000000000000000000000..be88d4a69a9eb8b5e48ce5f66cf57f6a492092db
--- /dev/null
+++ b/third_party/grpc/test/core/bad_client/bad_client.c
@@ -0,0 +1,198 @@
+/*
