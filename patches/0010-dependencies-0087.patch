+// Do one real rpc and one mocked one
+TEST_F(MockTest, SimpleRpc) {
+  ResetStub();
+  FakeClient client(stub_.get());
+  client.DoEcho();
+  MockStub stub;
+  client.ResetStub(&stub);
+  client.DoEcho();
+}
