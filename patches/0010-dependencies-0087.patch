index 0000000000000000000000000000000000000000..ae955b1f685120b024b879a08b4c895e3d8a1173
--- /dev/null
+++ b/third_party/grpc/test/core/util/passthru_endpoint.c
@@ -0,0 +1,162 @@
+/*
+ *
