+        if self.description:
+            desc = " [" + self.description + "]"
+            sep = "\n\t"
+
+    if os.environ.get('TESTCMD_DEBUG_SKIPS'):
+        at = _caller(traceback.extract_stack(), skip)
+        sys.stderr.write("NO RESULT for test" + of + desc + sep + at)
+    else:
+        sys.stderr.write("NO RESULT\n")
+
+    sys.exit(2)
