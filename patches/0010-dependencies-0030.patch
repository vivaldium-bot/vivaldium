+        </paper-dropdown-menu-light>
+      </template>
+    </demo-snippet>
+
+    <h4>You can style a paper-dropdown-menu using custom properties</h4>
+    <demo-snippet class="centered-demo">
+      <template>
+        <style is="custom-style">
+          paper-dropdown-menu.custom {
+            --paper-input-container-label: {
