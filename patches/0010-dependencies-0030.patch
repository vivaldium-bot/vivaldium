+
+            @classmethod
+            def create_instance(cls, *args, **kwargs):
+                obj = object.__new__(cls)
+                if isinstance(obj, cls):
+                    obj.__init__(*args, **kwargs)
+
+                return obj
+
+            def __call__(self):
+                return self
+
+            def dispatch(self):
