+    if (this.iframeQualifiedName(doc.defaultView) == '0') {
+      this.html.push(
+          `<!-- Original window height: ${this.windowHeight}. -->\n`);
+      this.html.push(`<!-- Original window width: ${this.windowWidth}. -->\n`);
