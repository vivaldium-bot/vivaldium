+
+      var mainThread = m.rendererMain;
+
+      mainThread.sliceGroup.pushSlice(TestUtils.newSliceEx({
+        type: ThreadSlice,
+        start: 4,
+        duration: 4,
+        title: 'TaskQueueManager::RunTask'
+      }));
+
+      mainThread.sliceGroup.pushSlice(TestUtils.newSliceEx({
+        type: ThreadSlice,
+        start: 5,
+        duration: 2,
+        title: 'ThreadProxy::BeginMainFrame'
+      }));
