+
+    <!-- TODO(noms): enable this demo when the webcomponentsjs bug is fixed -->
+    <!-- <h4>Here is an example of a long, scrolling menu, using a <i>dom-repeat</i></h4>
+    <demo-snippet class="centered-demo">
+      <template>
+        <template is="dom-bind" id="Demo">
