+    Tbl = &Tbl_0[e << eshift];
+    e = Tbl[lsrc[1]];
+    Tbl = &Tbl_0[e << (eshift + 4)];  // 16x the range
+    e = (reinterpret_cast<const int8*>(Tbl))[lsrc[2]];
+    Tbl = &Tbl[e << eshift];          // Relative +/-
+    e = Tbl[lsrc[3]];
+  }
+  return e;
+}
