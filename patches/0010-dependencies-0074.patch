--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/qtrle.c
@@ -0,0 +1,551 @@
+/*
+ * Quicktime Animation (RLE) Video Decoder
+ * Copyright (C) 2004 The FFmpeg project
+ *
