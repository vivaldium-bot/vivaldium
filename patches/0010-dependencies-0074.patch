+AVCodec ff_pgm_decoder = {
+    .name           = "pgm",
+    .long_name      = NULL_IF_CONFIG_SMALL("PGM (Portable GrayMap) image"),
+    .type           = AVMEDIA_TYPE_VIDEO,
+    .id             = AV_CODEC_ID_PGM,
+    .priv_data_size = sizeof(PNMContext),
