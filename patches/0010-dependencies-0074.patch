+#0da6 SANYAKA JAYANNA (Level 1, but not in modern use)
+0da7-0db1
+0db3-0dbb
+0dbd
+0dc0-0dc6
+# Dependent Vowels
+0dca
+0dcf-0dd4
+0dd6
+0dd8-0dde
+# 0ddf GAYANUKITTA (Level 3)
+0df2
+# 0df3 DIGA GAYANUKITTA (Level 3)
+# Punctuation
+# 0df4 KUNDDALIYA (Level 3)
