index 0000000000000000000000000000000000000000..f384ba7873ad55f5bde8b2556f5bd39ce831f53e
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/vaapi_vp9.c
@@ -0,0 +1,185 @@
+/*
+ * VP9 HW decode acceleration through VA API
+ *
+ * Copyright (C) 2015 Timo Rothenpieler <timo@rothenpieler.org>
+ *
