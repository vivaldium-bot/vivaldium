--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ppc/mpegvideo_altivec.c
@@ -0,0 +1,130 @@
+/*
+ * Copyright (c) 2002 Dieter Shirley
+ *
+ * dct_unquantize_h263_altivec:
+ * Copyright (c) 2003 Romain Dolbeau <romain@dolbeau.org>
+ *
+ * This file is part of FFmpeg.
+ *
