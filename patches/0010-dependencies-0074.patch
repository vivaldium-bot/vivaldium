+static void vc1_inv_trans_4x8_c(uint8_t *dest, ptrdiff_t stride, int16_t *block)
+{
+    int i;
+    register int t1, t2, t3, t4, t5, t6, t7, t8;
+    int16_t *src, *dst;
+
+    src = block;
+    dst = block;
