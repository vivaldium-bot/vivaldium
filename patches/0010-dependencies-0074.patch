diff --git a/third_party/ffmpeg/libavformat/vag.c b/third_party/ffmpeg/libavformat/vag.c
new file mode 100644
index 0000000000000000000000000000000000000000..2875db501e83a90f7e33efbbf40217ca82e6eac6
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/vag.c
@@ -0,0 +1,83 @@
+/*
+ * VAG demuxer
+ * Copyright (c) 2015 Paul B Mahol
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
