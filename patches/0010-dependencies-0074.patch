+#include "stereo3d.h"
+
+AVStereo3D *av_stereo3d_alloc(void)
+{
+    return av_mallocz(sizeof(AVStereo3D));
+}
+
+AVStereo3D *av_stereo3d_create_side_data(AVFrame *frame)
+{
+    AVFrameSideData *side_data = av_frame_new_side_data(frame,
+                                                        AV_FRAME_DATA_STEREO3D,
+                                                        sizeof(AVStereo3D));
+    if (!side_data)
+        return NULL;
+
+    memset(side_data->data, 0, sizeof(AVStereo3D));
+
+    return (AVStereo3D *)side_data->data;
+}
diff --git a/third_party/ffmpeg/libavutil/stereo3d.h b/third_party/ffmpeg/libavutil/stereo3d.h
new file mode 100644
index 0000000000000000000000000000000000000000..1135dc9ddc686a95059e0a45c9af0a42b428d791
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/stereo3d.h
@@ -0,0 +1,152 @@
+/*
