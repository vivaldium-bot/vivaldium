diff --git a/third_party/ffmpeg/libavcodec/qsv_internal.h b/third_party/ffmpeg/libavcodec/qsv_internal.h
new file mode 100644
index 0000000000000000000000000000000000000000..c0305508dd552bf98eeac90b1eba432113c53fe8
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/qsv_internal.h
@@ -0,0 +1,102 @@
