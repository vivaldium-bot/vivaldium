index 0000000000000000000000000000000000000000..b7dd8baa121859d74b37a92220a070f8f9851266
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/texturedsp.c
@@ -0,0 +1,654 @@
+/*
+ * Texture block decompression
+ * Copyright (C) 2009 Benjamin Dobell, Glass Echidna
+ * Copyright (C) 2012 Matthäus G. "Anteru" Chajdas (http://anteru.net)
+ * Copyright (C) 2015 Vittorio Giovara <vittorio.giovara@gmail.com>
