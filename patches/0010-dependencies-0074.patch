+static av_cold int wmavoice_decode_end(AVCodecContext *ctx)
+{
+    WMAVoiceContext *s = ctx->priv_data;
+
+    if (s->do_apf) {
+        ff_rdft_end(&s->rdft);
+        ff_rdft_end(&s->irdft);
+        ff_dct_end(&s->dct);
+        ff_dct_end(&s->dst);
+    }
+
+    return 0;
+}
