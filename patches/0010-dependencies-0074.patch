index 0000000000000000000000000000000000000000..c6a5015282966e1e14d02cf0ca0d1bc01f8fa702
--- /dev/null
+++ b/third_party/ffmpeg/libavresample/x86/audio_convert.asm
@@ -0,0 +1,1261 @@
+;******************************************************************************
+;* x86 optimized Format Conversion Utils
+;* Copyright (c) 2008 Loren Merritt
+;* Copyright (c) 2012 Justin Ruggles <justin.ruggles@gmail.com>
+;*
+;* This file is part of FFmpeg.
