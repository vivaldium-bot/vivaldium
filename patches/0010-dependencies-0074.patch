+  -->
+
+  <!-- Fill in your name for FIRSTNAME and SURNAME. -->
+  <!ENTITY dhfirstname "<firstname>Josselin</firstname>">
+  <!ENTITY dhsurname   "<surname>Mouette</surname>">
