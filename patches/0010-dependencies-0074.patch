--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/simple_idct.c
@@ -0,0 +1,244 @@
+/*
+ * Simple IDCT
+ *
+ * Copyright (c) 2001 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
