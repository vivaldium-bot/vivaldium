diff --git a/third_party/ffmpeg/libavformat/wavdec.c b/third_party/ffmpeg/libavformat/wavdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..d95596f6ed71643b56cac68e1f381bcae2fe5715
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/wavdec.c
@@ -0,0 +1,850 @@
+/*
+ * WAV demuxer
+ * Copyright (c) 2001, 2002 Fabrice Bellard
+ *
+ * Sony Wave64 demuxer
+ * RF64 demuxer
+ * Copyright (c) 2009 Daniel Verkamp
+ *
