new file mode 100644
index 0000000000000000000000000000000000000000..056a2c7ef17d1b614fefef294db826d2a1fbaa53
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/ttadsp.c
@@ -0,0 +1,59 @@
