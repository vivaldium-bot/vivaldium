diff --git a/third_party/freetype2/src/src/psnames/psmodule.c b/third_party/freetype2/src/src/psnames/psmodule.c
new file mode 100644
index 0000000000000000000000000000000000000000..7528696938a5cc44b8e799db7e04dcc3913dab52
--- /dev/null
+++ b/third_party/freetype2/src/src/psnames/psmodule.c
@@ -0,0 +1,597 @@
+/***************************************************************************/
+/*                                                                         */
+/*  psmodule.c                                                             */
+/*                                                                         */
+/*    PSNames module implementation (body).                                */
+/*                                                                         */
+/*  Copyright 1996-2001, 2002, 2003, 2005, 2006, 2007, 2008 by             */
+/*  David Turner, Robert Wilhelm, and Werner Lemberg.                      */
