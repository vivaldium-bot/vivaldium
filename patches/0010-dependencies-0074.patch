--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rtpenc_xiph.c
@@ -0,0 +1,135 @@
+/*
+ * RTP packetization for Xiph audio and video
+ * Copyright (c) 2010 Josh Allmann
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
