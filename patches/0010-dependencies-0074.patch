index 0000000000000000000000000000000000000000..c6fd3aa4709b91190ad466f1388f21669659297e
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/avr32/intreadwrite.h
@@ -0,0 +1,182 @@
+/*
