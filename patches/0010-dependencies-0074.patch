index 0000000000000000000000000000000000000000..95fab644a7af606a4acfa69bbe5f06e2c2ad3f3e
--- /dev/null
+++ b/third_party/ffmpeg/libavformat/nsvdec.c
@@ -0,0 +1,762 @@
+/*
+ * NSV demuxer
+ * Copyright (c) 2004 The FFmpeg Project
+ *
+ * first version by Francois Revol <revol@free.fr>
+ *
+ * This file is part of FFmpeg.
+ *
