+// Comments in header
+Function* Builder::makeEntrypoint(const char* entryPoint)
+{
+    assert(! mainFunction);
+
+    Block* entry;
+    std::vector<Id> params;
+    std::vector<Decoration> precisions;
+
+    mainFunction = makeFunctionEntry(NoPrecision, makeVoidType(), entryPoint, params, precisions, &entry);
