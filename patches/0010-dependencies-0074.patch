index 0000000000000000000000000000000000000000..5d92351a0e9e5f02db688b794c52e35577a5af83
--- /dev/null
+++ b/third_party/ffmpeg/libavresample/audio_mix_matrix.c
@@ -0,0 +1,294 @@
+/*
+ * Copyright (C) 2011 Michael Niedermayer (michaelni@gmx.at)
+ * Copyright (c) 2012 Justin Ruggles <justin.ruggles@gmail.com>
+ *
+ * This file is part of FFmpeg.
