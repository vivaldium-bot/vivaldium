+/**
+ * @file
+ * Sorenson Vector Quantizer #1 (SVQ1) video codec.
+ * For more information of the SVQ1 algorithm, visit:
+ *   http://www.pcisys.net/~melanson/codecs/
+ */
+
+#include "avcodec.h"
+#include "hpeldsp.h"
+#include "me_cmp.h"
+#include "mpegvideo.h"
+#include "h263.h"
+#include "internal.h"
+#include "mpegutils.h"
