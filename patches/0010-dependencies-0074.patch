+#define DC_VLC_BITS 9
+
+// offset tables for interlaced picture MVDATA decoding
+static const uint8_t offset_table[2][9] = {
+    {  0,  1,  2,  4,  8, 16, 32,  64, 128 },
+    {  0,  1,  3,  7, 15, 31, 63, 127, 255 },
+};
