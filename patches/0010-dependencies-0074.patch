--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/sbr.h
@@ -0,0 +1,217 @@
+/*
+ * Spectral Band Replication definitions and structures
+ * Copyright (c) 2008-2009 Robert Swain ( rob opendot cl )
+ * Copyright (c) 2010      Alex Converse <alex.converse@gmail.com>
+ *
