diff --git a/third_party/ffmpeg/libavresample/arm/audio_convert_init.c b/third_party/ffmpeg/libavresample/arm/audio_convert_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..3d19a0e0e51a969861390926afb6fae0f4089ef8
--- /dev/null
+++ b/third_party/ffmpeg/libavresample/arm/audio_convert_init.c
@@ -0,0 +1,49 @@
+/*
+ * This file is part of FFmpeg.
