+@@
+
+@RET@           void
+@FUNC@          FcAtomicUnlock
+@TYPE1@         FcAtomic *                      @ARG1@          atomic
+@PURPOSE@	unlock a file
+@DESC@
+Unlocks the file.
+@@
+
+@RET@           void
