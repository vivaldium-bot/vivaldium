new file mode 100644
index 0000000000000000000000000000000000000000..2e3ca79fdd1c8185a7c15ef56496b57363265f18
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/sonic.c
@@ -0,0 +1,1126 @@
