index 0000000000000000000000000000000000000000..d5f94e8a611e1f8522cc29dae26aa4a1dd00da99
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/tests/snowenc.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright (C) 2004 Michael Niedermayer <michaelni@gmx.at>
+ *
