+    __asm__ ("loadacc,   (%1+) \n\t"
+             "storeacc,  %0    \n\t"
+             "loadacc,   (%1+) \n\t"
+             "rol8             \n\t"
+             "add,       %0    \n\t"
+             "loadacc,   (%1+) \n\t"
+             "rol8             \n\t"
+             "rol8             \n\t"
+             "add,       %0    \n\t"
+             "loadacc,   (%1+) \n\t"
+             "rol8             \n\t"
+             "rol8             \n\t"
+             "rol8             \n\t"
+             "add,       %0    \n\t"
+             : "=r"(v), "+a"(p));
