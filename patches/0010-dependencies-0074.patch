+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_PNGDSP_H
+#define AVCODEC_PNGDSP_H
+
+#include <stdint.h>
+
+typedef struct PNGDSPContext {
+    void (*add_bytes_l2)(uint8_t *dst,
+                         uint8_t *src1 /* align 16 */,
+                         uint8_t *src2, int w);
+
+    /* this might write to dst[w] */
+    void (*add_paeth_prediction)(uint8_t *dst, uint8_t *src,
+                                 uint8_t *top, int w, int bpp);
+} PNGDSPContext;
+
+void ff_pngdsp_init(PNGDSPContext *dsp);
+void ff_pngdsp_init_x86(PNGDSPContext *dsp);
+
+#endif /* AVCODEC_PNGDSP_H */
diff --git a/third_party/ffmpeg/libavcodec/pngenc.c b/third_party/ffmpeg/libavcodec/pngenc.c
new file mode 100644
index 0000000000000000000000000000000000000000..69b44954049a5b3448d921d78a1d2a5c0273d8af
