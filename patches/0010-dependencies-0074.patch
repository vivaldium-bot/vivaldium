index 0000000000000000000000000000000000000000..7dd718da86e4a530b657905eb16eb563dd521cd9
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/lls.c
@@ -0,0 +1,162 @@
+/*
+ * linear least squares model
+ *
+ * Copyright (c) 2006 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
+ *
