--- /dev/null
+++ b/third_party/ffmpeg/libavformat/rtpdec_mpeg12.c
@@ -0,0 +1,65 @@
+/*
+ * Common code for the RTP depacketization of MPEG-1/2 formats.
+ * Copyright (c) 2002 Fabrice Bellard
+ *
