+
+#ifndef AVFORMAT_NETWORK_H
+#define AVFORMAT_NETWORK_H
+
+#include <errno.h>
+#include <stdint.h>
+
+#include "config.h"
+#include "libavutil/error.h"
+#include "os_support.h"
+#include "avio.h"
