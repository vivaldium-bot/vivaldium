+#include "libavutil/channel_layout.h"
+
+#define BITSTREAM_READER_LE
+#include "avcodec.h"
+#include "bytestream.h"
+#include "get_bits.h"
+#include "internal.h"
+#include "thread.h"
+#include "unary.h"
+#include "wavpack.h"
