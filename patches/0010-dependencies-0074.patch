+void main()
+{
+    vec4 v;
+	float f;
+	bool b;
+	bvec4 bv4;
+	int i;
+
+	uint u;
+
+
+	// floating point
+    v = radians(uv4);
+    v += degrees(v);
+    v += (i = ui*ui, sin(v));
+    v += cos(v);
+    v += tan(v);
+    v += asin(v);
