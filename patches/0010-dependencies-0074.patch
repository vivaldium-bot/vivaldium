+
+/**
+ * @file
+ * VP5 and VP6 compatible video decoder (common data)
+ */
+
+#include "vp56data.h"
+
+const uint8_t ff_vp56_b2p[]   = { 0, 0, 0, 0, 1, 2, 3, 3, 3, 3 };
