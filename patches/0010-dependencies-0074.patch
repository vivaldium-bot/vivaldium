index 0000000000000000000000000000000000000000..325f03c44b7ad3d0ab83f71abc2f8cb81b05d0dc
--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/wma.h
@@ -0,0 +1,160 @@
