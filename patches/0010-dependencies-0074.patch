diff --git a/third_party/fontconfig/src/conf.d/49-sansserif.conf b/third_party/fontconfig/src/conf.d/49-sansserif.conf
new file mode 100644
index 0000000000000000000000000000000000000000..c6209a7d3157390b784b51d0afed0491e2b54289
--- /dev/null
+++ b/third_party/fontconfig/src/conf.d/49-sansserif.conf
@@ -0,0 +1,21 @@
+<?xml version="1.0"?>
+<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
+<fontconfig>
+<!--
+  If the font still has no generic name, add sans-serif
+ -->
+	<match target="pattern">
+		<test qual="all" name="family" compare="not_eq">
+			<string>sans-serif</string>
+		</test>
+		<test qual="all" name="family" compare="not_eq">
+			<string>serif</string>
+		</test>
+		<test qual="all" name="family" compare="not_eq">
+			<string>monospace</string>
+		</test>
+		<edit name="family" mode="append_last">
+			<string>sans-serif</string>
+		</edit>
+	</match>
+</fontconfig>
diff --git a/third_party/fontconfig/src/conf.d/50-user.conf b/third_party/fontconfig/src/conf.d/50-user.conf
new file mode 100644
