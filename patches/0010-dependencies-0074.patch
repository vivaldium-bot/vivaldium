--- /dev/null
+++ b/third_party/ffmpeg/libavcodec/videotoolbox.c
@@ -0,0 +1,1160 @@
+/*
+ * Videotoolbox hardware acceleration
+ *
+ * copyright (c) 2012 Sebastien Zwickert
