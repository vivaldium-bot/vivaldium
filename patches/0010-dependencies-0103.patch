+    class tTokenInput : public tInput {
+    public:
+        tTokenInput(TPpContext* pp, TokenStream* t) : tInput(pp), tokens(t) { }
+        virtual int scan(TPpToken *);
+        virtual int getch() { assert(0); return EndOfInput; }
