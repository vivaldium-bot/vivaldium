+  NSString *str2 = [GTMSQLiteStatement quoteAndEscapeString:str];
+  XCTAssertEqualObjects(str2, @"'This is wild! It''s fun!'");
+  str2 = [GTMSQLiteStatement quoteAndEscapeString:@""];
+  XCTAssertEqualObjects(str2, @"''");
+}
