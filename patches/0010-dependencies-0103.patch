+  // "a\n"
+  seg = [enumerator nextObject];
+  XCTAssertNotNil(seg);
+  XCTAssertFalse([seg isMatch]);
+  XCTAssertEqualStrings([seg string], @"a\n");
+  // "a"
+  seg = [enumerator nextObject];
+  XCTAssertNotNil(seg);
+  XCTAssertTrue([seg isMatch]);
+  XCTAssertEqualStrings([seg string], @"a");
+  // "a"
+  seg = [enumerator nextObject];
+  XCTAssertNotNil(seg);
+  XCTAssertFalse([seg isMatch]);
+  XCTAssertEqualStrings([seg string], @"a");
+  // (end)
+  seg = [enumerator nextObject];
