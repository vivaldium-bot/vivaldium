+GTM_INLINE CGFloat GTMCGDistanceBetweenPoints(CGPoint pt1, CGPoint pt2) {
+  CGFloat dX = pt1.x - pt2.x;
+  CGFloat dY = pt1.y - pt2.y;
+#if CGFLOAT_IS_DOUBLE
+  return sqrt(dX * dX + dY * dY);
+#else
+  return sqrtf(dX * dX + dY * dY);
