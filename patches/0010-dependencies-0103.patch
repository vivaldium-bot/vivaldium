+  GTMCFAutorelease(targetString);
+  if (!(patternString && targetString)) {
+    // COV_NF_START
+    sqlite3_result_error(context,
+                         "LIKE CF implementation failed " \
+                         "to allocate CFStrings", -1);
+    return;
+    // COV_NF_END
+  }
