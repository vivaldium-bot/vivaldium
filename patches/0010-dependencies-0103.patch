+                                 customUpperLower[i].sqlName,
+                                 1,
+                                 customUpperLower[i].userArgs.textRep,
+                                 (void *)&customUpperLower[i].userArgs,
+                                 customUpperLower[i].function,
+                                 NULL,
+                                 NULL);
+    if (rc != SQLITE_OK)
