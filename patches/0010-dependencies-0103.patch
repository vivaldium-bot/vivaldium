+  XCTAssertEqual(err, SQLITE_ROW, @"failed to advance row!");
+
+  oneRow = [statement resultStringAtPosition:0];
+  XCTAssertEqualStrings(oneRow, @"4", @"4 did not come second!");
+
+  [statement finalizeStatement];
+}
