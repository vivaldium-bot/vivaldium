+
+type_name_list
+    : TYPE_NAME {
+        // TODO: 4.0 functionality: subroutine type to list
+    }
+    | type_name_list COMMA TYPE_NAME {
+    }
+    ;
+
+type_specifier
+    : type_specifier_nonarray {
+        $$ = $1;
+        $$.qualifier.precision = parseContext.getDefaultPrecision($$);
+    }
+    | type_specifier_nonarray array_specifier {
