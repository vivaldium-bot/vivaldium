+- (id)initWithInterpreter:(NSString *)interp withArgs:(NSArray *)args {
+  if ((self = [super init])) {
+    trimsWhitespace_ = YES;
+    interpreter_ = [interp copy];
+    interpreterArgs_ = [args retain];
+    if (!interpreter_) {
+      interpreter_ = @"/bin/sh";
+    }
+  }
+  return self;
+}
