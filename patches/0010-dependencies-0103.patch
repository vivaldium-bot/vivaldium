+  CGRect expectedRect = CGRectMake(0, 0, 10, 5);
+  XCTAssertTrue(CGRectEqualToRect(outRect, expectedRect));
+}
+
+- (void)testGTMCGRectScaling {
+  CGRect rect = CGRectMake(1.0f, 2.0f, 5.0f, 10.0f);
+  CGRect rect2 = CGRectMake(1.0, 2.0, 1.0, 12.0);
