+  XCTAssertEqualStrings([seg string], @"a");
+  // "a\n" - skipped
+  // "a"
+  seg = [enumerator nextObject];
+  XCTAssertNotNil(seg);
+  XCTAssertTrue([seg isMatch]);
+  XCTAssertEqualStrings([seg string], @"a");
+  // "a" - skipped
+  // (end)
+  seg = [enumerator nextObject];
