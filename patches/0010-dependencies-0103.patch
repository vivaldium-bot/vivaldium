+// Helper method to help testing GTMLogFormatters
+- (NSString *)stringFromFormatter:(id<GTMLogFormatter>)formatter
+                            level:(GTMLoggerLevel)level
+                           format:(NSString *)fmt, ... {
+  va_list args;
+  va_start(args, fmt);
+  NSString *msg = [formatter stringForFunc:nil
