+    glslangtest::GlobalTestSettings.initializer = initializer.get();
+
+    for (int i = 1; i < argc; ++i) {
+        if (!strncmp("--update-mode", argv[i], 13)) {
+            glslangtest::GlobalTestSettings.updateMode = true;
+            break;
