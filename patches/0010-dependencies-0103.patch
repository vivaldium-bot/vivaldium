+  if (!URLBuilder) {
+    return NO;
+  }
+
+  if (!([[self baseURLString] isEqualToString:[URLBuilder baseURLString]])) {
+    return NO;
+  }
+
+  if (![[self parameters] isEqualToDictionary:[URLBuilder parameters]]) {
+    return NO;
+  }
+
+  return YES;
+}
