+++ b/third_party/google_toolbox_for_mac/src/XcodeConfig/subconfig/MacOSX.xcconfig
@@ -0,0 +1,24 @@
+//
+//  MacOSX.xcconfig
+//
+//  Xcode configuration file for building on Mac OS X.
+//
