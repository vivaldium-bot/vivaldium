+
+  err = [statement bindDoubleAtPosition:1 value:testVal];
+  XCTAssertEqual(err, SQLITE_OK, @"error binding double at position 1");
+
+  err = [statement bindNumberAsDoubleAtPosition:2 number:doubleValue];
