+  const struct {
+    const char           *sqlName;
+    UpperLowerUserArgs   userArgs;
+    void                 *function;
+  } customUpperLower[] = {
+    { "upper", { YES, SQLITE_UTF16 }, &TestUpperLower16Impl },
