+    int sample_rate;
+    int bit_rate;
+    int samples;
+    uint64_t channel_layout;
+    int service_type;
+
+    int remaining_size;
+    uint64_t state;
+
+    int need_next_header;
+    enum AVCodecID codec_id;
+} AACAC3ParseContext;
