index 0000000000000000000000000000000000000000..738d8e38d5b305db1e1551c9e559127611c7e8e9
--- /dev/null
+++ b/third_party/ffmpeg/compat/cuda/nvcuvid.h
@@ -0,0 +1,321 @@
+/*
