+def WriteGn(fd, disjoint_sets):
+  fd.write(COPYRIGHT)
+  fd.write(GN_HEADER)
+
+  # Generate conditional stanza for each disjoint source set.
+  for s in reversed(disjoint_sets):
+    fd.write(s.GenerateGnStanza())
