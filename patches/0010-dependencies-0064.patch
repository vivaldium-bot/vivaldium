+/*
+ * Add all of the elements in 's' to 'p'
+ */
+FcBool
+FcPatternAppend (FcPattern *p, FcPattern *s)
+{
+    int		    i;
+    FcPatternElt    *e;
+    FcValueListPtr  v;
+
+    for (i = 0; i < s->num; i++)
+    {
+	e = FcPatternElts(s)+i;
+	for (v = FcPatternEltValues(e); v; v = FcValueListNext(v))
+	{
+	    if (!FcPatternObjectAddWithBinding (p, e->object,
+						FcValueCanonicalize(&v->value),
+						v->binding, FcTrue))
+		return FcFalse;
+	}
+    }
+    return FcTrue;
+}
