+      stat_call = ((['git', 'diff', '--no-ext-diff', '--stat',
+                   '-M'+similarity, 'fake_ancestor_sha', 'HEAD'],), '+dat')
+
+    return [
+      ((['git', 'symbolic-ref', 'HEAD'],), 'master'),
+      similarity_call,
+      ((['git', 'symbolic-ref', 'HEAD'],), 'master'),
