index 0000000000000000000000000000000000000000..40a119ffe1751cdb8e7f00efe5bb78f0c7796c80
--- /dev/null
+++ b/third_party/ffmpeg/compat/os2threads.h
@@ -0,0 +1,201 @@
+/*
