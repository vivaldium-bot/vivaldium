+template <typename SeqT, int Size, typename Pred>
+class LexCompare
+{
+public:
+	LexCompare (void) : m_pred(Pred()) {}
+
+	bool operator() (const SeqT& a, const SeqT& b) const
+	{
+		for (int i = 0; i < Size; ++i)
+		{
+			if (m_pred(a[i], b[i]))
+				return true;
+			if (m_pred(b[i], a[i]))
+				return false;
+		}
+		return false;
+	}
+
+private:
+	Pred m_pred;
+};
