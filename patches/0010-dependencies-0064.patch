+		for (int shaderNdx = 0; shaderNdx < static_cast<int>(m_shadersExecutions.size()); ++shaderNdx)
+		{
+			computePipelineInfo.stage = shaderStageInfos[shaderNdx];
+			pipelineInfos.push_back(computePipelineInfo);
+		}
+		return pipelineInfos;
+	}
