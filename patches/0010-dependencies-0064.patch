+		"%zero       = OpConstant %i32 0\n"
+		// Main function
+		"%main       = OpFunction %void None %voidf\n"
+		"%label      = OpLabel\n"
+		"%out_var    = OpVariable %var_ptr Function ${variableInitializer}\n"
+		"%idval      = OpLoad %uvec3 %id\n"
