+		"OpLine %other_name 0 4294967295\n"
+		"OpLine %other_name 4294967295 0\n"
+		"OpLine %other_name 32 40\n"
+		"OpLine %file_name 0 0\n"
+		"%second_function = OpFunction %v4f32 None %v4f32_function\n"
+		"OpLine %file_name 1 0\n"
