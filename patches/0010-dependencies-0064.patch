+    expected.append(
+        SourceSet(set(['chrome']),
+                  set([SourceListCondition('x64', 'Chrome', 'win')])))
+    expected.append(
+        SourceSet(set(['arm']),
+                  set([SourceListCondition('arm', 'Chromium', 'win')])))
