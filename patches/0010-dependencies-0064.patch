+      git_mirror=None,
+      fetched_status=None,
+      other_cl_owner=None,
+      custom_cl_base=None,
+      tbr=None):
+    """Generic gerrit upload test framework."""
+    if squash_mode is None:
+      if '--no-squash' in upload_args:
+        squash_mode = 'nosquash'
+      elif '--squash' in upload_args:
+        squash_mode = 'squash'
+      else:
+        squash_mode = 'default'
