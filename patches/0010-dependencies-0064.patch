+    'unsent': Fore.YELLOW,
+    'waiting': Fore.BLUE,
+    'reply': Fore.YELLOW,
+    'not lgtm': Fore.RED,
+    'lgtm': Fore.GREEN,
+    'commit': Fore.MAGENTA,
+    'closed': Fore.CYAN,
+    'error': Fore.WHITE,
