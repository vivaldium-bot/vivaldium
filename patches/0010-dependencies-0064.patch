+                       SourceListCondition('x64', 'Chromium', 'linux')]))
+    e_stanza = e.GenerateGnStanza()
+    string.index(e_stanza, ('is_win && current_cpu == "arm"'
+        ' && ffmpeg_branding == "Chrome"'))
