+  def testTrackTag(self):
+    self.origin.git('tag', 'lkgr', self.origin['M'])
+    self.repo.git('tag', 'lkgr', self.repo['D'])
+
+    self.repo.git('config', 'branch.branch_G.remote', '.')
+    self.repo.git('config', 'branch.branch_G.merge', 'refs/tags/lkgr')
