+int BufferLayout::getBlockIndex (const string& name) const
+{
+	for (int ndx = 0; ndx < (int)blocks.size(); ndx++)
+	{
+		if (blocks[ndx].name == name)
+			return ndx;
+	}
+	return -1;
+}
