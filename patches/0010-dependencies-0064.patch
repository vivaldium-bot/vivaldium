+                          'branch.master.git-find-copies', val],), '')
+
+    if find_copies:
+      stat_call = ((['git', 'diff', '--no-ext-diff', '--stat',
+                     '-l100000', '-C'+similarity,
+                     'fake_ancestor_sha', 'HEAD'],), '+dat')
