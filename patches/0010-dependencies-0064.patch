+  client = GClient.LoadCurrentConfig(options)
+  if not client:
+    raise gclient_utils.Error('client not configured; see \'gclient config\'')
+  if options.verbose:
+    client.PrintLocationAndContents()
+  options.force = True
+  options.nohooks = False
