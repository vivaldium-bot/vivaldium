diff --git a/third_party/ffmpeg/compat/os2threads.h b/third_party/ffmpeg/compat/os2threads.h
new file mode 100644
index 0000000000000000000000000000000000000000..7c0fe13af3cb6927c3d7fc6289e38b724b96c88b
--- /dev/null
+++ b/third_party/ffmpeg/compat/os2threads.h
@@ -0,0 +1,193 @@
+/*
+ * Copyright (c) 2011 KO Myung-Hun <komh@chollian.net>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
