+  switch (opcode) {
+#define OPCODE(Opcode)      \
+  case IrOpcode::k##Opcode: \
+    return true;
+    COMMON_OP_LIST(OPCODE)
+    CONTROL_OP_LIST(OPCODE)
+#undef OPCODE
+    default:
+      return false;
+  }
