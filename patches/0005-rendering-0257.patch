+shouldThrow("'use strict'; eval('var Foo = 10'); Foo");
+shouldBe("eval('class Bar { constructor() {} }; Bar.toString()')", "'class Bar { constructor() {} }'");
+shouldThrow("'use strict'; eval('class Bar { constructor() {} }'); Bar.toString()");
