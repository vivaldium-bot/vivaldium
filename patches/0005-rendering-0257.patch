+#define RECURSE(call)                                             \
+  do {                                                            \
+    if (GetCurrentStackPosition() < stack_limit_) {               \
+      stack_overflow_ = true;                                     \
+      FAIL(root_, "Stack overflow while parsing asm.js module."); \
+    }                                                             \
+                                                                  \
+    AsmType* result = (call);                                     \
+    if (stack_overflow_) {                                        \
+      return AsmType::None();                                     \
+    }                                                             \
+                                                                  \
+    if (result == AsmType::None()) {                              \
+      return AsmType::None();                                     \
+    }                                                             \
+  } while (false)
