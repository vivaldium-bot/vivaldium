+var Debug = debug.Debug
+var exception = null;
+var step = 0;
+
+function listener(event, exec_state, event_data, data) {
+  if (event != Debug.DebugEvent.Exception) return;
+  try {
+    step++;
+  } catch (e) {
+    exception = e;
+  }
+}
+
+Debug.setBreakOnException();
+Debug.setListener(listener);
+
+(function () {
