+      instructions_(zone),
+      defined_(node_count, false, zone),
+      used_(node_count, false, zone),
+      effect_level_(node_count, 0, zone),
+      virtual_registers_(node_count,
+                         InstructionOperand::kInvalidVirtualRegister, zone),
+      virtual_register_rename_(zone),
