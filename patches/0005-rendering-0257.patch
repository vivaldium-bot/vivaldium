-<?xml version="1.0" encoding="iso-8859-1" ?>
-<!DOCTYPE svg PUBLIC "-//W3C//DTD SVG Tiny 1.1//EN"
-"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11-tiny.dtd">
