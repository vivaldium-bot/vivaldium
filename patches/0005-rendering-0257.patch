+
+(function testLt() {
+  var builder = new WasmModuleBuilder();
+
+  var kPages = 3;
+  builder.addMemory(kPages, kPages, true);
+  builder.addFunction("flt", kSig_i_dd)
+    .addBody([
+      kExprGetLocal, 0,     // --
+      kExprGetLocal, 1,     // --
+      kExprF64Lt            // --
+    ])                      // --
+    .exportFunc();
