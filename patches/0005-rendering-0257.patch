+
+var d = new Date(20000000, 0, 1);
+shouldBe('d.getTime()', 'NaN');
+
+shouldBe('Date.UTC(1970, 0, 1, 0, 0, 0, 0)', '0');
+
+d = new Date(-20000000, 0, 1);
+shouldBe('d.getTime()', 'NaN');
