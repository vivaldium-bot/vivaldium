+
+TEST_F(WasmModuleVerifyTest, TwoGlobals) {
+  static const byte data[] = {
+      SECTION(GLOBALS, 7),
+      2,
+      NO_NAME,  // #0: name length
+      kMemF32,  // memory type
+      0,        // exported
