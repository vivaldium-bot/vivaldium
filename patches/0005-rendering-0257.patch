+InstructionOperand InstructionSequenceTest::Unallocated(
+    TestOperand op, UnallocatedOperand::ExtendedPolicy policy) {
+  return UnallocatedOperand(policy, op.vreg_.value_);
+}
+
+
+InstructionOperand InstructionSequenceTest::Unallocated(
+    TestOperand op, UnallocatedOperand::ExtendedPolicy policy,
