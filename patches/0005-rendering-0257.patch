+AssemblerBase::AssemblerBase(Isolate* isolate, void* buffer, int buffer_size)
+    : isolate_(isolate),
+      jit_cookie_(0),
+      enabled_cpu_features_(0),
+      emit_debug_code_(FLAG_debug_code),
+      predictable_code_size_(false),
