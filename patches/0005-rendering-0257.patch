+// CPU specific code for arm independent of OS goes here.
+#ifdef __arm__
+#ifdef __QNXNTO__
+#include <sys/mman.h>  // for cache flushing.
+#undef MAP_TYPE
+#else
+#include <sys/syscall.h>  // for cache flushing.
+#endif
