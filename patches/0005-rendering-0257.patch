+static bool InternalFieldOK(i::Handle<i::JSReceiver> obj, int index,
+                            const char* location) {
+  return Utils::ApiCheck(
+      obj->IsJSObject() &&
+          (index < i::Handle<i::JSObject>::cast(obj)->GetInternalFieldCount()),
