+void Assembler::blr(const Register& xn) {
+  DCHECK(xn.Is64Bits());
+  // The pattern 'blr xzr' is used as a guard to detect when execution falls
+  // through the constant pool. It should not be emitted.
+  DCHECK(!xn.Is(xzr));
+  Emit(BLR | Rn(xn));
+}
