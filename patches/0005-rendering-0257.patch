+  SwitchStatement(ZoneList<const AstRawString*>* labels, int pos)
+      : BreakableStatement(labels, TARGET_FOR_ANONYMOUS, pos, kSwitchStatement),
+        tag_(NULL),
+        cases_(NULL) {}
+
+  Expression* tag_;
+  ZoneList<CaseClause*>* cases_;
+};
