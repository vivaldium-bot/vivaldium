+  // Bitfield extract and insert low.
+  void bfxil(const Register& rd, const Register& rn, int lsb, int width) {
+    DCHECK(width >= 1);
+    DCHECK(lsb + width <= rn.SizeInBits());
+    bfm(rd, rn, lsb, lsb + width - 1);
+  }
