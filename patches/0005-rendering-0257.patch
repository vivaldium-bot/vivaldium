+#ifndef V8_COMPILER_H_
+#define V8_COMPILER_H_
+
+#include <memory>
+
+#include "src/allocation.h"
+#include "src/bailout-reason.h"
+#include "src/contexts.h"
+#include "src/isolate.h"
