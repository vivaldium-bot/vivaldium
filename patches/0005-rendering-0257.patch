+        tests.push.apply(tests, makeTest(start, end, ">", relationship, expressionParts[i][2]));
+        tests.push.apply(tests, makeTest(start, end, ">=", relationship, expressionParts[i][2]));
+    }
+    for (var i = 0; i < tests.length; i++) {
