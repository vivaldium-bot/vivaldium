+  if (FLAG_turbo_loop_stackcheck || !info()->shared_info()->asm_function()) {
+    Node* node = NewNode(javascript()->StackCheck());
+    PrepareFrameState(node, stack_check_id);
+  }
+  Visit(stmt->body());
+}
