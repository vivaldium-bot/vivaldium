index 0000000000000000000000000000000000000000..1c0e3d915d18d1bac554d3f76b510052bd117682
--- /dev/null
+++ b/v8/test/mjsunit/string-index.js
@@ -0,0 +1,275 @@
+// Copyright 2008 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
