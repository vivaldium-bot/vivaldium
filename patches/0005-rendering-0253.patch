+}, TypeError);
+
+
+assertThrows(function() {
+  Object.getOwnPropertyDescriptor(undefined, 'x');
+}, TypeError);
+
+
+assertEquals({
+  configurable: false,
+  enumerable: false,
+  value: 3,
+  writable: false,
