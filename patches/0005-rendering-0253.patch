-                testFailed("Test " + testNumber
-                    + ": durationFrames (" + test.durationFrames + ") outside the range [0, "
-                    + testSpacingFrames + "]");
-            }
-            source.start(startTime, offset, test.durationFrames / context.sampleRate);
-        }
