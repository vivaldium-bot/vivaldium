+  assertEquals("test", O.sum(..."test"));
+  assertEquals(10, O.sum(...[1, 2, 3, 4]));
+  assertEquals(10, O.sum(...[1, 2, 3], 4));
+  assertEquals(10, O.sum(1, ...[2, 3], 4));
+  assertEquals(10, O.sum(1, ...[2, 3], ...[4]));
+  assertEquals(10, O.sum(1, 2, ...[3, 4]));
