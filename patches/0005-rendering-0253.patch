-    }
-
-    // Schedule all the tests.
-    var testNumber = 0;
-    for (var m = 0; m < mixingRulesList.length; ++m) {
-        var mixingRules = mixingRulesList[m];
-        for (var i = 0; i < connectionsList.length; ++i, ++testNumber) {
