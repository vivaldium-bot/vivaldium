-            // We may need to add an epsilon in the comparison if we add more test vectors.
-            if (renderedValue != expectedValue) {
-                var message = s + "rendered: " + renderedValue + " expected: " + expectedValue + " channel: " + c + " frame: " + frame;
-                testFailed(s);
