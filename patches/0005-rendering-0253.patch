index 0000000000000000000000000000000000000000..cab8b1bf6dec00373ff13723ab71f2281ab0a494
--- /dev/null
+++ b/v8/test/mjsunit/substr.js
@@ -0,0 +1,154 @@
+// Copyright 2008 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
