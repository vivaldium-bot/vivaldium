+    assertEquals("number", hint);
+    return 987654321;
+  }
+};
+assertEquals(987654321, %ToLength(d));
+assertEquals(987654321, %_ToLength(d));
+
+var e = new Date(0);
+assertEquals(0, %ToLength(e));
+assertEquals(0, %_ToLength(e));
