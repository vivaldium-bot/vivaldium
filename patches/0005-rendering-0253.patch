index 0000000000000000000000000000000000000000..001906c2906784ace19317b9731ec3d42107355a
--- /dev/null
+++ b/v8/test/mjsunit/setters-on-elements.js
@@ -0,0 +1,199 @@
+// Copyright 2011 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
