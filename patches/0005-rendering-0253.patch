+    constructor() {
+      let r = super();
+      assertEquals(this, r);
+      derivedCalled++;
+    }
+  }
+
+  assertEquals(Base, Base.prototype.constructor);
+  assertEquals(Base.prototype, Derived.prototype.__proto__);
+
+  baseCalled = 0;
+  derivedCalled = 0;
+  new Derived();
+  assertEquals(1, baseCalled);
+  assertEquals(1, derivedCalled);
+
+  class DerivedDerived extends Derived {
+    constructor() {
+      let r = super();
+      assertEquals(this, r);
+      derivedDerivedCalled++;
+    }
+  }
+
+  baseCalled = 0;
+  derivedCalled = 0;
+  derivedDerivedCalled = 0;
+  new DerivedDerived();
+  assertEquals(1, baseCalled);
+  assertEquals(1, derivedCalled);
+  assertEquals(1, derivedDerivedCalled);
+
+  class Base2 {
+    constructor(v) {
+      this.fromBase = v;
+    }
+  }
+  class Derived2 extends Base2 {
+    constructor(v1, v2) {
+      let r = super(v1);
+      assertEquals(this, r);
+      this.fromDerived = v2;
