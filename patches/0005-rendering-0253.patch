--- /dev/null
+++ b/v8/test/mjsunit/regress/regress-latin-1.js
@@ -0,0 +1,91 @@
+// Copyright 2013 the V8 project authors. All rights reserved.
+// Redistribution and use in source and binary forms, with or without
