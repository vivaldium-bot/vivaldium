+  // In strict mode primitive values should not be coerced to an object.
+  a = [];
+  new constructor([1, 2]).find(function() { 'use strict'; a.push(this); }, "");
+  assertEquals("", a[0]);
+  assertEquals(a[0], a[1]);
+
+})();
+
