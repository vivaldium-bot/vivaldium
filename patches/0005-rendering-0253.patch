+  assertEquals(188, f(o1));
+  assertOptimized(f);
+  assertEquals(288, f(o2));
+  assertUnoptimized(f);
+  assertEquals(288, f(o2));
+}
+TestDeoptimization1();
+
+
+function TestInParameterInitializers() {
+  var first_name = "George";
+  var last_name = "Jetson";
+  function fn1(name = do { first_name + " " + last_name }) {
+    return name;
