+template<typename CharT>
+void test1 ( std::experimental::basic_string_view<CharT> sv1,
+             size_t pos1, size_t n1, const CharT *s, int expected ) {
+    if (pos1 > sv1.size()) {
+#ifndef TEST_HAS_NO_EXCEPTIONS
