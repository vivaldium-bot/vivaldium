+        self->exec_argc = this->exec_argv[self->exec_argc] ?
+            (self->exec_argc + 1) : self->exec_argc;
+
+        /* Probe for argc==3 */
+        this->exec_argv = (user_addr_t*)copyin(
+             arg1, sizeof(user_addr_t) * (self->exec_argc + 1));
+        self->exec_argc = this->exec_argv[self->exec_argc] ?
+            (self->exec_argc + 1) : self->exec_argc;
+
+        /* Probe for argc==4 */
+        this->exec_argv = (user_addr_t*)copyin(
