+        # important values.
+        files = [
+          Results.File(None, f, False, None, m)
+          for f, m in dict(files).iteritems()
+        ]
+        return Results.Process(
+            self.pid,
+            files,
+            fix_path(self.executable),
+            self.command,
+            fix_path(self.initial_cwd),
+            [c.to_results_process() for c in self.children])
