+      assert mode in self.ACCEPTABLE_MODES
+      super(Results.File, self).__init__(root, path, tainted, size, 1)
+      self.mode = mode
+
+    def _clone(self, new_root, new_path, tainted):
+      """Clones itself keeping meta-data."""
