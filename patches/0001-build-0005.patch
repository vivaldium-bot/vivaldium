+               this->open_arg0,
+               self->open_arg1,
+               self->open_arg2);
+        logindex++;
+        this->open_arg0 = 0;
+      }
+      syscall::open*:return /trackedpid[pid] == 1/ {
+        self->open_arg0 = 0;
+        self->open_arg1 = 0;
+        self->open_arg2 = 0;
+      }
