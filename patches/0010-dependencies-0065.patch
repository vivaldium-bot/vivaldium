+- (BOOL)removeValueAndLabelAtIndex:(NSUInteger)idx {
+  BOOL isGood = NO;
+  NSUInteger count = [self count];
+  if (idx < count) {
+#if GTM_IPHONE_SDK
+    bool wasGood = ABMultiValueRemoveValueAndLabelAtIndex(multiValue_, 
+                                                          idx);
+#else  // GTM_IPHONE_SDK
