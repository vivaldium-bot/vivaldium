diff --git a/third_party/ffmpeg/libswscale/x86/hscale_fast_bilinear_simd.c b/third_party/ffmpeg/libswscale/x86/hscale_fast_bilinear_simd.c
new file mode 100644
index 0000000000000000000000000000000000000000..b37b63c3ecaa27460178f7e03abe37a0a23e6759
--- /dev/null
+++ b/third_party/ffmpeg/libswscale/x86/hscale_fast_bilinear_simd.c
@@ -0,0 +1,359 @@
+/*
+ * Copyright (C) 2001-2003 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
