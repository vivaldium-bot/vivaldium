+class With(BlockRangeMixIn, AssignTypeMixin, Statement):
+    """class representing a With node"""
+    _astroid_fields = ('items', 'body')
+    items = None
+    body = None
+
+    @cachedproperty
+    def blockstart_tolineno(self):
+        return self.items[-1][0].tolineno
