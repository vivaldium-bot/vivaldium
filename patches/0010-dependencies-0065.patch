+  groups = [book_ groupsWithCompositeNameWithPrefix:kGTMABTestGroupName];
+  STAssertEquals([groups count], (NSUInteger)0, nil);
+  record = [book_ groupForId:recordID];
+  STAssertNil(record, nil);
