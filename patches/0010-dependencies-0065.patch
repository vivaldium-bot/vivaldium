diff --git a/third_party/depot_tools/buildbucket.py b/third_party/depot_tools/buildbucket.py
new file mode 100755
index 0000000000000000000000000000000000000000..bb7d61afc3ee38af601e6baa63c7cbeebe593af1
--- /dev/null
