index 0000000000000000000000000000000000000000..c480dfa506e0808fe72f6a7d18b4171d6a8894ce
--- /dev/null
+++ b/third_party/freetype2/src/src/truetype/ttinterp.h
@@ -0,0 +1,319 @@
+/***************************************************************************/
+/*                                                                         */
+/*  ttinterp.h                                                             */
+/*                                                                         */
+/*    TrueType bytecode interpreter (specification).                       */
+/*                                                                         */
+/*  Copyright 1996-2001, 2002, 2003, 2004, 2005, 2006, 2007, 2010 by       */
+/*  David Turner, Robert Wilhelm, and Werner Lemberg.                      */
+/*                                                                         */
