+  # Prevent the editor from coming up when you upload.
+  export GIT_EDITOR=$(which true)
+  test_expect_success "upload succeeds (needs a server running on localhost)" \
+    "$GIT_CL upload --no-oauth2 -m test | grep -q 'Issue created'"
+)
+SUCCESS=$?
+
+cleanup
+
+if [ $SUCCESS == 0 ]; then
+  echo PASS
+fi
