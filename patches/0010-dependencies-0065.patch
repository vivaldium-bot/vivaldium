+  def testRelPath(self):
+    patches = patch.PatchSet([
+        patch.FilePatchDiff('pp', GIT.COPY, []),
+        patch.FilePatchDiff(
+            'chromeos\\views/webui_menu_widget.h', GIT.RENAME_PARTIAL, []),
