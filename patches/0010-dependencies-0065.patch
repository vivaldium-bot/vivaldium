+
+  git checkout -q -b test2 master
+
+  test_expect_success "$GIT_CL patch $ISSUE --no-oauth2"
+)
+SUCCESS=$?
+
+cleanup
+
+if [ $SUCCESS == 0 ]; then
+  echo PASS
+fi
