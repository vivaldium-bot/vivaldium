+                                               \
+        __asm__ volatile (                     \
+            "sd  %[val_m],  %[pdst_m]  \n\t"   \
+                                               \
+            : [pdst_m] "=m" (*pdst_m)          \
+            : [val_m] "r" (val_m)              \
+        );                                     \
+    }
+#else  // !(__mips_isa_rev >= 6)
+    #define LW(psrc)                           \
+    ( {                                        \
+        uint8_t *psrc_m = (uint8_t *) (psrc);  \
+        uint32_t val_m;                        \
+                                               \
+        __asm__ volatile (                     \
+            "ulw  %[val_m],  %[psrc_m]  \n\t"  \
+                                               \
+            : [val_m] "=r" (val_m)             \
+            : [psrc_m] "m" (*psrc_m)           \
