index 0000000000000000000000000000000000000000..4989aa69915d0ede44a4db8185de204dfb0c6e1f
--- /dev/null
+++ b/third_party/ffmpeg/libswresample/x86/resample.asm
@@ -0,0 +1,605 @@
+;******************************************************************************
+;* Copyright (c) 2012 Michael Niedermayer
+;* Copyright (c) 2014 James Almer <jamrial <at> gmail.com>
+;* Copyright (c) 2014 Ronald S. Bultje <rsbultje@gmail.com>
