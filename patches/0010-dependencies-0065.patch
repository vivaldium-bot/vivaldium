index 0000000000000000000000000000000000000000..51fbe30a23abaa9b9f529a672761b798599c235f
--- /dev/null
+++ b/third_party/ffmpeg/libavutil/intreadwrite.h
@@ -0,0 +1,629 @@
+/*
