+- (BOOL)replaceValueAtIndex:(NSUInteger)idx withValue:(id)value {
+  BOOL isGood = NO;
+  NSUInteger count = [self count];
+  if (idx < count && [self checkValueType:value]) {
+#if GTM_IPHONE_SDK
+    bool goodReplace = ABMultiValueReplaceValueAtIndex(multiValue_, 
+                                                       value, idx);
+#else  // GTM_IPHONE_SDK
+    bool goodReplace 
