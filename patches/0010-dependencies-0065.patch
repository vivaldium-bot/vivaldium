diff --git a/third_party/freetype2/src/src/pcf/rules.mk b/third_party/freetype2/src/src/pcf/rules.mk
new file mode 100644
index 0000000000000000000000000000000000000000..78641528fab10fb0a320a80cba376b77f0040fb0
--- /dev/null
