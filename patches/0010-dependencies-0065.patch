+
+#define BUF_SIZE 512
+
+#define randomize_buffers(mask)                        \
+    do {                                               \
+        int i, size = sizeof(*y0);                     \
+        for (i = 0; i < BUF_SIZE; i += 4 / size) {     \
+            uint32_t r = rnd() & mask;                 \
+            AV_WN32A(y0 + i, r);                       \
+            AV_WN32A(y1 + i, r);                       \
