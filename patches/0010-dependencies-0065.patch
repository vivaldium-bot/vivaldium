+
+  @classmethod
+  def IssueConfigKey(cls):
+    return 'rietveldissue'
+
+  @classmethod
+  def PatchsetConfigKey(cls):
+    return 'rietveldpatchset'
+
+  @classmethod
+  def CodereviewServerConfigKey(cls):
+    return 'rietveldserver'
+
+  def GetRietveldObjForPresubmit(self):
