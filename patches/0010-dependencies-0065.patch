+    cmd = ['bar.py', '--verbose']
+    if input_api.platform == 'win32':
+      cmd.insert(0, input_api.python_executable)
+    CommHelper(input_api, cmd, cwd=self.fake_root_dir, ret=(('', None), 1))
+
+    self.mox.ReplayAll()
+    results = presubmit_canned_checks.RunUnitTests(
