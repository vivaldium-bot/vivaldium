+static inline void rgb24tobgr32_c(const uint8_t *src, uint8_t *dst,
+                                  int src_size)
+{
+    uint8_t *dest      = dst;
+    const uint8_t *s   = src;
+    const uint8_t *end = s + src_size;
+
+    while (s < end) {
+#if HAVE_BIGENDIAN
+        /* RGB24 (= R, G, B) -> RGB32 (= A, B, G, R) */
+        *dest++  = 255;
+        *dest++  = s[2];
+        *dest++  = s[1];
+        *dest++  = s[0];
+        s       += 3;
+#else
+        *dest++  = *s++;
+        *dest++  = *s++;
+        *dest++  = *s++;
+        *dest++  = 255;
+#endif
+    }
+}
+
+static inline void rgb32tobgr24_c(const uint8_t *src, uint8_t *dst,
+                                  int src_size)
+{
+    uint8_t *dest      = dst;
+    const uint8_t *s   = src;
+    const uint8_t *end = s + src_size;
+
+    while (s < end) {
+#if HAVE_BIGENDIAN
+        /* RGB32 (= A, B, G, R) -> RGB24 (= R, G, B) */
+        s++;
+        dest[2]  = *s++;
+        dest[1]  = *s++;
+        dest[0]  = *s++;
+        dest    += 3;
+#else
+        *dest++  = *s++;
+        *dest++  = *s++;
+        *dest++  = *s++;
+        s++;
+#endif
+    }
+}
