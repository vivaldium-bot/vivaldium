+fate-ra-cook: CMP = oneoff
+fate-ra-cook: REF = $(SAMPLES)/real/ra_cook.pcm
+
+FATE_REALMEDIA_VIDEO-$(call DEMDEC, RM, RV30) += fate-rv30
