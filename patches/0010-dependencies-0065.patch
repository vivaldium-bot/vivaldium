+
+#if (__mips_isa_rev >= 6)
+    #define LW(psrc)                           \
+    ( {                                        \
+        uint8_t *psrc_m = (uint8_t *) (psrc);  \
+        uint32_t val_m;                        \
+                                               \
+        __asm__ volatile (                     \
+            "lw  %[val_m],  %[psrc_m]  \n\t"   \
+                                               \
+            : [val_m] "=r" (val_m)             \
+            : [psrc_m] "m" (*psrc_m)           \
+        );                                     \
+                                               \
+        val_m;                                 \
+    } )
+
+    #if (__mips == 64)
+        #define LD(psrc)                           \
+        ( {                                        \
+            uint8_t *psrc_m = (uint8_t *) (psrc);  \
+            uint64_t val_m = 0;                    \
+                                                   \
+            __asm__ volatile (                     \
