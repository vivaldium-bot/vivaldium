index 0000000000000000000000000000000000000000..cbf03f82e8aa0662ecc56c93ef6f8df9b75cb01a
--- /dev/null
+++ b/third_party/ffmpeg/tests/checkasm/alacdsp.c
@@ -0,0 +1,119 @@
+/*
