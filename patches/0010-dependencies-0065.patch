+class NullHandler(logging.Handler):
+    def emit(self, record):
+        pass
+
+log = logging.getLogger('boto')
+perflog = logging.getLogger('boto.perf')
+log.addHandler(NullHandler())
+perflog.addHandler(NullHandler())
+init_logging()
