--- /dev/null
+++ b/third_party/ffmpeg/libavutil/lfg.c
@@ -0,0 +1,102 @@
+/*
+ * Lagged Fibonacci PRNG
+ * Copyright (c) 2008 Michael Niedermayer
+ *
