+
+    (const void*)&AF_AF_AUTOFITTER_SERVICE_GET,
+
+    (FT_Module_Constructor)af_autofitter_init,
+    (FT_Module_Destructor) af_autofitter_done,
+    (FT_Module_Requester)  NULL )
+
+
+/* END */
