+  def RpcServer(self):
+    """Returns an upload.RpcServer() to access this review's rietveld instance.
+    """
+    if not self._rpc_server:
+      self._rpc_server = rietveld.CachingRietveld(
+          self.GetCodereviewServer(),
+          self._auth_config)
