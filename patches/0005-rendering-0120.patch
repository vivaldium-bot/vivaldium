-<!DOCTYPE html>
-<html>
-	<head>
-		<title>Drag and drop alternating between Flash and page</title>
-		<style type="text/css">
-div {
-	width: 100px;
-	height: 100px;
-	background: fuchsia;
-}
-object {
-	width: 400px;
-	height: 400px;
-	border: 5px solid black;
