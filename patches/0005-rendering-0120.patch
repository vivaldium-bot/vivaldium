-        var url = event.params.response.url;
-        if (url.indexOf("blob") === 0)
-            return;
-
-        var type = event.params.type;
-        var requestId = event.params.requestId;
-        for (var i = 0; i < resources.length; ++i) {
-            var resource = resources[i];
