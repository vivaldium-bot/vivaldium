-    // Nothing to test
-    continue;
-  }
-  test(function() {
-    var iters = [];
-    var descs = [];
-    var expectedReferenceNodes = [];
-    var expectedPointers = [];
-
-    for (var j = 0; j < testNodes.length; j++) {
-      var root = eval(testNodes[j]);
-      // Add all distinct iterators with this root, calling nextNode()
