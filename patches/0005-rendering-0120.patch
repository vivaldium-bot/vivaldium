-/*
- * document.createElement(NS)
- *
- * document.getElementsByTagName(NS)
- *
- * Element.setAttribute(NS)
- *
- * Element.getAttribute(NS)
- * Element.hasAttribute(NS)
- * Element.getElementsByTagName(NS)
