-    var resources = [
-        { url: '/resources-page.html', type: "Document", responseAvailable: false },
-        { url: '/stylesheet.css', type: "Stylesheet" },
-        { url: '/script.js', type: "Script" },
-        { url: '/abe.png', type: "Image" },
-        { url: '/test.wav', type: "Media" },
