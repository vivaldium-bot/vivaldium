+   for (i = 0; i < num; i++) {
+      Node *n;
+      n = alloc_instruction(ctx, OPCODE_PRIORITIZE_TEXTURE, 2);
+      if (n) {
+         n[1].ui = textures[i];
+         n[2].f = priorities[i];
+      }
+   }
+   if (ctx->ExecuteFlag) {
+      CALL_PrioritizeTextures(ctx->Exec, (num, textures, priorities));
+   }
+}
