+    TestLLongConstructors();
+
+    TestLLongSimpleOperators();
+
+    logln("Testing operator*=, operator*");
+
+    // operator*=, operator*
+    // small and large values, positive, &NEGative, zero
+    // also test commutivity
+    {
+        const llong ZERO;
