+
+
+        status = U_ZERO_ERROR;
+
+        ucnv_fromUnicode (conv,
+                  (char **)&targ,
+                  (const char *)end,
+                  &src,
+                  sourceLimit,
+                  checkOffsets ? offs : NULL,
