+static void doMisc(void) {
+/* Miscellaneous tests to exercize less popular code paths */
+    UBiDi *bidi, *bidiLine;
+    UChar src[MAXLEN], dest[MAXLEN];
+    int32_t srcLen, destLen, runCount, i;
+    UBiDiLevel level;
+    UBiDiDirection dir;
+    int32_t map[MAXLEN];
