+    switch (index) {
+        CASE_SUITE(0, BasicNormalizerTest);
+        CASE_SUITE(1, NormalizerConformanceTest); // this takes a long time
+        CASE_SUITE(2, CanonicalIteratorTest);
+        default:
+            name="";
+            break;
+    }
+#endif
+}
