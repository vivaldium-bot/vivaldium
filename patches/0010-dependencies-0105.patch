+            }
+            offsetIndex += 2;
+        }
+        status = U_ZERO_ERROR;
+        if (usearch_following(strsrch, u_strlen(text), &status) != 
+            USEARCH_DONE) {
+            log_err("Error expecting out of bounds match\n");
+        }
+        if (usearch_preceding(strsrch, 0, &status) != USEARCH_DONE) {
+            log_err("Error expecting out of bounds match\n");
+        }
+        count ++;
+        usearch_close(strsrch);
+    }
+    close();
