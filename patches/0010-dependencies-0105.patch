+    if (u_strpbrk(testSurrogateString, a) != &testSurrogateString[1]) {
+        log_err("u_strpbrk couldn't find first letter a.\n");
+    }
+    if (u_strpbrk(testSurrogateString, dc) != &testSurrogateString[5]) {
