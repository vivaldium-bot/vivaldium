+    0.0,                            /* alignment bytes */
+    { sizeof(UDataInfo), 0xda, 0x27 },  /* MappedData */
+
+    {sizeof(UDataInfo),
+    0,
+
+    U_IS_BIG_ENDIAN,
+    U_CHARSET_FAMILY,
+    sizeof(UChar),
+    0,
+
+    {0x31, 0x31, 0x31, 0x31},     /* dataFormat="1111" */
+    {0, 0, 0, 0},                 /* formatVersion */
+    {0, 0, 0, 0}}                 /* dataVersion */
+};
+#endif
