+static void printSeq(const unsigned char* a, int len)
+{
+    int i=0;
+    log_verbose("\n{");
+    while (i<len)
+        log_verbose("0x%02X ", a[i++]);
+    log_verbose("}\n");
+}
+
+static void printUSeq(const UChar* a, int len)
+{
+    int i=0;
+    log_verbose("\n{");
+    while (i<len)
+        log_verbose("%0x04X ", a[i++]);
+    log_verbose("}\n");
+}
+
+static void printSeqErr(const unsigned char* a, int len)
