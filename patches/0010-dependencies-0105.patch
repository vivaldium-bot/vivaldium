+AM_CPPFLAGS = \
+	-I$(top_srcdir)/include \
+	-I$(top_srcdir)/src/mapi \
+	-I$(top_srcdir)/src/mesa/ \
+	$(DEFINES) \
+	$(API_DEFINES)
+AM_CFLAGS = $(PTHREAD_CFLAGS) \
+	$(VISIBILITY_CFLAGS)
+AM_CXXFLAGS = $(PTHREAD_CFLAGS) \
+	$(VISIBILITY_CXXFLAGS)
+
+lib_LTLIBRARIES = lib@OSMESA_LIB@.la
