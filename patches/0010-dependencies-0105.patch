+    UnicodeString littleD("yyyy-ddd.hh:mm:ss");
+    UDate expLittleD = date(95, 0, 1, 5, 1, 29);
+    UDate expBigD = expLittleD + 39 * 24 * 3600000.0;
+    expLittleD = expBigD; // Expect the same, with default lenient parsing
