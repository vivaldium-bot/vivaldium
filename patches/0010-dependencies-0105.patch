+    if(U_FAILURE(status))    {
+        log_err("Error in ucal_inDaylightTime: %s\n", u_errorName(status));
+    }
+    if(!ucal_inDaylightTime(caldef, &status))
+        log_verbose("PASS: It is not in daylight saving's time\n");
+    else
+        log_err("FAIL: It is not in daylight saving's time\n");
