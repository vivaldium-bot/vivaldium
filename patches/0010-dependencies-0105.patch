+    for(i=0; i<U_CHAR_DIRECTION_COUNT; ++i) {
+        if(u_charDirection(charFromDirProp[i])!=(UCharDirection)i) {
+            log_err("\nu_charDirection(charFromDirProp[%d]=U+%04x)==%d!=%d\n",
