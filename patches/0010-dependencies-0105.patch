+#if UCONFIG_NO_LEGACY_CONVERSION
+#   define TRY_CNV_1 "iso-8859-1"
+#   define TRY_CNV_2 "ibm-1208"
+#else
+#   define TRY_CNV_1 "iso-8859-7"
+#   define TRY_CNV_2 "sjis"
