+        2005, 6, 21, 1384, 3, 31,
+        2005, 6, 22, 1384, 4, 1,
+        2005, 7, 22, 1384, 4, 31,
+        2005, 7, 23, 1384, 5, 1,
+        2005, 8, 22, 1384, 5, 31,
+        2005, 8, 23, 1384, 6, 1,
+        2005, 9, 22, 1384, 6, 31,
+        2005, 9, 23, 1384, 7, 1,
+        2005, 10, 22, 1384, 7, 30,
+        2005, 10, 23, 1384, 8, 1,
+        2005, 11, 21, 1384, 8, 30,
+        2005, 11, 22, 1384, 9, 1,
+        2005, 12, 21, 1384, 9, 30,
+        2005, 12, 22, 1384, 10, 1,
+        2006, 1, 20, 1384, 10, 30,
+        2006, 1, 21, 1384, 11, 1,
