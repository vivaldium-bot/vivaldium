+    UBool checkOffsets = TRUE;
+    UBool doFlush;
+    char junk[9999];
+    char offset_str[9999];
+    char *p;
+    UConverterFromUCallback oldAction = NULL;
+    const void* oldContext = NULL;
+
+
+    for(i=0;i<NEW_MAX_BUFFER;i++)
+        junkout[i] = (char)0xF0;
+    for(i=0;i<NEW_MAX_BUFFER;i++)
+        junokout[i] = 0xFF;
