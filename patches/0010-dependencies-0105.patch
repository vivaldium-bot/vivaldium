+        "x.x: <%%durationwithmillis<>%%millis-added>;\n"
+        "-x: ->>;%%millis-only:\n"
+        "1000: 00:00.<%%millis<;\n"
+        "%%millis-added:\n"
+        "1000: .<%%millis<;\n"
+        "%%millis:\n"
+        "0: =000=;\n"
+        "%%duration:\n"
+        "0: =%%seconds-only=;\n"
+        "60: =%%min-sec=;\n"
+        "3600: =%%hr-min-sec=;\n"
+        "86400/86400: <%%ddaayyss<[, >>];\n"
+        "%%durationwithmillis:\n"
+        "0: =%%seconds-only=;\n"
+        "60: =%%min-sec=;\n"
+        "3600: =%%hr-min-sec=;\n"
+        "86400/86400: <%%ddaayyss<, >>;\n");
+    u_uastrcpy(pat2,
+        "%%seconds-only:\n"
+        "0: 0:00:=00=;\n"
+        "%%min-sec:\n"
+        "0: :=00=;\n"
+        "0/60: 0:<00<>>;\n"
+        "%%hr-min-sec:\n"
+        "0: :=00=;\n"
+        "60/60: <00<>>;\n"
+        "3600/60: <0<:>>>;\n"
+        "%%ddaayyss:\n"
+        "0 days;\n"
+        "1 day;\n"
+        "=0= days;");
