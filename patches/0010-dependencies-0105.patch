+void
+addTrieTest(TestNode** root);
+
+void
+addTrieTest(TestNode** root) {
+    addTest(root, &TrieTest, "tsutil/trietest/TrieTest");
+    addTest(root, &DummyTrieTest, "tsutil/trietest/DummyTrieTest");
+}
