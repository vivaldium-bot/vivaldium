diff --git a/third_party/mesa/src/src/mesa/main/fog.c b/third_party/mesa/src/src/mesa/main/fog.c
new file mode 100644
index 0000000000000000000000000000000000000000..07405fb4b4207cc31eccd05f1e1c14a664f53967
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/fog.c
@@ -0,0 +1,225 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  5.1
+ *
+ * Copyright (C) 1999-2003  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
