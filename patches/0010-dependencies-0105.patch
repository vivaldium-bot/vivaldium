+      .mesa = 0,
+      .brw = (BRW_NEW_BATCH |
+	      BRW_NEW_STATE_BASE_ADDRESS),
+      .cache = CACHE_NEW_SAMPLER
+   },
+   .emit = upload_sampler_state_pointers,
+};
diff --git a/third_party/mesa/src/src/mesa/drivers/dri/i965/gen6_scissor_state.c b/third_party/mesa/src/src/mesa/drivers/dri/i965/gen6_scissor_state.c
