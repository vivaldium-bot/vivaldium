+/** 
+ * Performs round-trip tests for DateFormat
+ **/
+class DateFormatRoundTripTest : public IntlTest {    
+    
+    // IntlTest override
+    void runIndexedTest( int32_t index, UBool exec, const char* &name, char* par );
+
+public:
