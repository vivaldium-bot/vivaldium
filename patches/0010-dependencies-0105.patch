+
+    /* verify that all these values are in the unserialized Trie */
+    start=0;
+    for(i=0; i<countCheckRanges; ++i) {
+        limit=checkRanges[i].limit;
+        value=checkRanges[i].value;
+
+        if(start==0xd800) {
+            /* skip surrogates */
+            start=limit;
