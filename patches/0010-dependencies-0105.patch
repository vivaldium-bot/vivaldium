+
+void CalendarCaseTest::runIndexedTest( int32_t index, UBool exec, const char* &name, char* /*par*/ )
+{
+    if (exec) logln("TestSuite CalendarCaseTest");
+    switch (index) {
+    CASE(0,IslamicCivil);
+    CASE(1,Hebrew);
+    CASE(2,Indian);
+    CASE(3,Coptic);
+    CASE(4,Ethiopic);
+    default: name = ""; break;
+    }
+}
+
+#undef CASE
