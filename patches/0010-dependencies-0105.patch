+    /* Verify that we don't have a huge interval. */
+    if (interval < (uint64_t)U_INT64_MAX) {
+        ranInt = interval;
+    }
+}
+
+static int64_t randomInRange(void)
+{
+    int64_t value;
+
+    if (ranInt != 0) {
+        value = randomInt64() % ranInt;
+
+        if (value < 0) {
+            value = -value;
+        }
+
+        value += ranMin;
+    } else {
+        do {
+            value = randomInt64();
+        } while (value < ranMin || value > ranMax);
+    }
+
+    return value;
+}
