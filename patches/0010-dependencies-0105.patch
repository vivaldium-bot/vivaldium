+    UConverter *cnv;
+    UErrorCode errorCode;
+
+    int32_t length;
+
+    errorCode=U_ZERO_ERROR;
+    cnv=ucnv_open("Shift-JIS", &errorCode);
+    if(U_FAILURE(errorCode)) {
+        log_data_err("unable to open a Shift-JIS converter - %s\n", u_errorName(errorCode));
