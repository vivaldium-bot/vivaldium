+CollationKey& TestCollator::getCollationKey(const UnicodeString& source,
+                                            CollationKey& key,
+                                            UErrorCode& status) const
+{
+    char temp[100];
+    int length = 100;
+    length = source.extract(temp, length, NULL, status);
+    temp[length] = 0;
+    CollationKey tempkey((uint8_t*)temp, length);
+    key = tempkey;
+    return key;
+}
