index 0000000000000000000000000000000000000000..bd9837fdd9a8360d236ae98a54e981492336c9ed
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/main/drawpix.c
@@ -0,0 +1,384 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
+ * Copyright (C) 1999-2008  Brian Paul   All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
