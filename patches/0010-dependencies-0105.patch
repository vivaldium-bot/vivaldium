+void addEnglishCollTest(TestNode** root)
+{
+    
+    addTest(root, &TestPrimary, "tscoll/encoll/TestPrimary");
+    addTest(root, &TestSecondary, "tscoll/encoll/TestSecondary");
+    addTest(root, &TestTertiary, "tscoll/encoll/TestTertiary");
+
