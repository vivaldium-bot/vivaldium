+        u_uastrncpy(replText, "<$1>", UPRV_LENGTHOF(replText));
+        u_uastrncpy(replText2, "<<$1>>", UPRV_LENGTHOF(replText2));
+        expectedResultSize = strlen(expectedResult);
+        expectedResultSize2 = strlen(expectedResult2);
+
+        status = U_ZERO_ERROR;
