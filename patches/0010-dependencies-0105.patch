+#if !UCONFIG_ONLY_HTML_CONVERSION
+    static const uint8_t utf32[]={
+        0xff, 0xfe, 0, 0 /* BOM only, no text */
+    };
+#endif
+
+    char target[100], utf8NUL[100], shiftJISNUL[100];
