+    memcpy(utf8NUL, utf8, sizeof(utf8));
+    utf8NUL[sizeof(utf8)]=0;
+    memcpy(shiftJISNUL, shiftJIS, sizeof(shiftJIS));
+    shiftJISNUL[sizeof(shiftJIS)]=0;
