+#define _mesa_extensions_get_string( ctx ) "GL_EXT_texture_object"
+
+/** No-op */
+#define _mesa_enable_extension( c, n ) ((void)0)
+
+#endif
+
+#endif
diff --git a/third_party/mesa/src/src/mesa/main/fbobject.c b/third_party/mesa/src/src/mesa/main/fbobject.c
