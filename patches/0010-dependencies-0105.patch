+    log_verbose("Testing for SBCS and LATIN_1\n");
+    {
+        UChar sampleText[] = {0x0031, 0xd801, 0xdc01, 0x0032};
+        const uint8_t expected[] = {0x31, 0x1a, 0x32};
+
+#if !UCONFIG_NO_LEGACY_CONVERSION
+        /*SBCS*/
