+#define ISAN  0x20
+
+#define ISPU  0x40
+#define ISGR  0x80
+#define ISPR 0x100
+
+#define ISSP 0x200
+#define ISBL 0x400
+#define ISCN 0x800
+
+/* C/POSIX-style functions, in the same order as the bit flags */
+typedef UBool U_EXPORT2 IsPOSIXClass(UChar32 c);
+
