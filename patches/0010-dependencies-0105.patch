+   static GLboolean initialized = GL_FALSE;
+
+   if (!initialized) {
+      /* We don't need a special row packing function for each format.
+       * There's a generic fallback which uses a per-pixel packing function.
+       */
+      memset(table, 0, sizeof(table));
