+		      GLint target, GLint format,
+		      __DRIdrawable *draw);
+
+GLboolean
+nouveau_texture_validate(struct gl_context *ctx, struct gl_texture_object *t);
+
+void
+nouveau_texture_reallocate(struct gl_context *ctx, struct gl_texture_object *t);
+
+#endif
