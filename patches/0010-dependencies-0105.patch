+U_CFUNC int U_CALLCONV
+compareUnicodeStrings(const void *s1, const void *s2) {
+  UnicodeString **st1 = (UnicodeString **)s1;
+  UnicodeString **st2 = (UnicodeString **)s2;
+
+  return (*st1)->compare(**st2);
+}
