+        0xf0, 0x92, 0x8d, 0x85,  0xf3, 0xa0, 0x80, 0xa1,  0xf4, 0x8f, 0xbf, 0xbf,  /* not 0x110000 */
+        /* none from this line */
+        0,  0xd0, 0x80
+    }, expectSafe[]={
+        0x61,  0xc3, 0x9f,  0xe0, 0xa4, 0x81,  0xe3, 0x81, 0x80,
+        0xea, 0xb0, 0x80,  /* no surrogates */
