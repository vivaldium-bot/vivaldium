+
+
+class IdnaConfTest: public IntlTest {
+public:
+    void runIndexedTest(int32_t index, UBool exec, const char* &name, char* par=NULL);
+    IdnaConfTest();
+    virtual ~IdnaConfTest();
+private:
+    void Test(void);
