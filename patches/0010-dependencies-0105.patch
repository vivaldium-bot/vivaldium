+                     GLsizei count, GLenum format, GLenum type,
+                     const GLvoid *table )
+{
+   ASSERT_NO_FEATURE();
+}
+
+static inline void
+_mesa_init_colortable_dispatch(struct _glapi_table *disp)
+{
+}
+
