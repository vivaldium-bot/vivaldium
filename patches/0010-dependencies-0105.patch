+    length=numSubstitutions=-5;
+    p=u_strFromJavaModifiedUTF8WithSub(dest, sizeof(dest), &length,
+                                       (const char *)src, UPRV_LENGTHOF(src),
+                                       0xdfff, &numSubstitutions, &errorCode);
