+            log_verbose("pass: #%d: %s + [%s=%s] -> %s\n", i, kwSetTestCases[i].l, kwSetTestCases[i].k, kwSetTestCases[i].v,
+                buffer);
+        }
+        log_verbose("2/%d-buffer modify OK\n",i);
+    }
