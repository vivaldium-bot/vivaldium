+                austrdup(dataTable[CTRY3][i]));
+        }
+        sprintf(temp2, "%x", (int)uloc_getLCID(testLocale));
+        if (strcmp(temp2, rawData2[LCID][i]) != 0) {
+            log_err("LCID mismatch: %s versus %s\n", temp2 , rawData2[LCID][i]);
+        }
+    }
+    
+    free(expected);
+    free(testLocale);
+    cleanUpDataTable();
+}
