+static UCollator *myCollation;
+const static UChar testSourceCases[][MAX_TOKEN_LEN] =
+{
+    {0x0047/*'G'*/, 0x0072/*'r'*/, 0x00F6, 0x00DF, 0x0065/*'e'*/, 0x0000},     
+    {0x0061/*'a'*/, 0x0062/*'b'*/, 0x0063/*'c'*/, 0x0000},
