+    tryPat994(f, "yy/MM/dd HH:mm:ss", "97/01/01 10:11:42", d);
+    tryPat994(f, "yy/MM/dd HH:mm:ss", "97/01/01 10:", null);
+    tryPat994(f, "yy/MM/dd HH:mm:ss", "97/01/01 10", null);
+    tryPat994(f, "yy/MM/dd HH:mm:ss", "97/01/01 ", null);
+    tryPat994(f, "yy/MM/dd HH:mm:ss", "97/01/01", null);
+    udat_close(f);
