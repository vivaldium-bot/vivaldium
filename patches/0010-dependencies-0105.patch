+            sortklen=ucol_getSortKey(c, target, u_strlen(target),  NULL, 0);
+            sortKey2=(uint8_t*)malloc(sizeof(uint8_t) * (sortklen+1));
+            ucol_getSortKey(c, target, u_strlen(target), sortKey2, sortklen+1);
