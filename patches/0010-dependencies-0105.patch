+        numVals = ubrk_getRuleStatusVec(bi, vals, 0, &status);
+        TEST_ASSERT(status == U_BUFFER_OVERFLOW_ERROR);
+        TEST_ASSERT(numVals == 2);
+    }
+
+    ubrk_close(bi);
