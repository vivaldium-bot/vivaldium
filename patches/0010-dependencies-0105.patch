+                const char *mySubChar, int8_t len, const void* context, UErrorCode expectedError)
+{
+
+
+    UErrorCode status = U_ZERO_ERROR;
+    UConverter *conv = 0;
+    char junkout[NEW_MAX_BUFFER]; /* FIX */
+    int32_t junokout[NEW_MAX_BUFFER]; /* FIX */
