+        //for (i=2; i<=6; ++i) {
+        for (i=0; i<16; ++i) {
+        UDate t, t2;
+        int32_t t_y, t_woy, t_dow;
+        cal.clear();
+        cal.set(1999, UCAL_DECEMBER, 26 + i);
+        fmt.format(t = cal.getTime(status), str.remove());
