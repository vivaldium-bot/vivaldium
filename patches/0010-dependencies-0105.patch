+/**
+* Print a usage message for this test class.
+*/
+void IntlTest::usage( void )
+{
+    UBool save_verbose = setVerbose( TRUE );
+    logln("Test names:");
+    logln("-----------");
+
+    int32_t index = 0;
+    const char* name = NULL;
+    do{
+        this->runIndexedTest( index, FALSE, name );
+        if (!name) break;
+        logln(name);
+        index++;
+    }while (name && (name[0] != 0));
+    setVerbose( save_verbose );
+}
