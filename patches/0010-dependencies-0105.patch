+    static const UCharDirection customClasses[] = {
+       /* 0/8    1/9    2/A    3/B    4/C    5/D    6/E    7/F  */
+          DEF,   DEF,   DEF,   DEF,   DEF,   DEF,   DEF,   DEF, /* 00-07 */
