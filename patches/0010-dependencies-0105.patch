+{
+    if (exec) logln("TestSuite TestCalendarLimit");
+    switch (index) {
+        // Re-enable this later
+        case 0:
+            name = "TestCalendarExtremeLimit";
+            if (exec) {
+                logln("TestCalendarExtremeLimit---"); logln("");
+                TestCalendarExtremeLimit();
+            }
+            break;
+        case 1:
+            name = "TestLimits";
+            if (exec) {
+                logln("TestLimits---"); logln("");
+                TestLimits();
+            }
+            break;
+
+        default: name = ""; break;
