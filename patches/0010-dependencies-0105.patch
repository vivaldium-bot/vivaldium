index 0000000000000000000000000000000000000000..fcf96aea3437a0eb20a459478d435061b9f15e37
--- /dev/null
+++ b/third_party/mesa/src/src/mesa/drivers/x11/xmesaP.h
@@ -0,0 +1,428 @@
+/*
+ * Mesa 3-D graphics library
+ * Version:  7.1
+ *
