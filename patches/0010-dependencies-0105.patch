+  while(source < sourceLimit)
+  {
+    puts("");
+    target = ucnv_getNextUChar (conv,
+                                &source,
+                                sourceLimit,
+                                &status);
+    
+    //    printBytes("src",source,sourceLimit-source);
+    U_ASSERT(status);
+    printUChar(target);
