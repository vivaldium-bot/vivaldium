+    log_verbose("Format 1234.56 -> %s\n", u_austrcpy(tempBuf, str) );
+    if(U_SUCCESS(status) && str) {
+        res=(UChar*)malloc(sizeof(UChar) * (strlen("$1,234.56")+1) );
