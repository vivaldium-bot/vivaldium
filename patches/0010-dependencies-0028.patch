+      // Two slices that only partially overlaps the loading phase. Both
+      // should be ignored.
+      mainThread.sliceGroup.pushSlice(TestUtils.newSliceEx({
+        type: ThreadSlice,
+        start: -5,
+        duration: 10,
+        title: 'ThreadProxy::BeginMainFrame'
+      }));
