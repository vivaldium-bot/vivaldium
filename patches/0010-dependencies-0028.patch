+      }));
+
+      mainThread.sliceGroup.pushSlice(TestUtils.newSliceEx({
+        type: ThreadSlice,
+        start: 5,
+        duration: 2,
+        title: 'ThreadProxy::BeginMainFrame'
+      }));
