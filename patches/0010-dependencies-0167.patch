diff --git a/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2010-06-14-NEONCoalescer.ll b/third_party/swiftshader/third_party/LLVM/test/CodeGen/Thumb2/2010-06-14-NEONCoalescer.ll
