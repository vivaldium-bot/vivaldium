index 0000000000000000000000000000000000000000..0580a7bd7b64489debe559164c30b53d95d07537
--- /dev/null
+++ b/third_party/libvpx/source/libvpx/vpx_dsp/x86/quantize_sse2.c
@@ -0,0 +1,223 @@
+/*
