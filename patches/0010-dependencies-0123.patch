+    public:
+        MyDrawable(const SkRect& r) : fR(r), fSweep(0) {}
+
+        void setSweep(SkScalar sweep) {
+            if (fSweep != sweep) {
+                fSweep = sweep;
+                this->notifyDrawingChanged();
+            }
+        }
+
+        void onDraw(SkCanvas* canvas) override {
+            SkPaint paint;
+            paint.setAntiAlias(true);
