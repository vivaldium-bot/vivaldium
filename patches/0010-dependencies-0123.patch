+ */
+#define __STDC_LIMIT_MACROS
+
+#include "SkDraw.h"
+#include "SkBlitter.h"
+#include "SkCanvas.h"
+#include "SkColorPriv.h"
+#include "SkDevice.h"
+#include "SkDeviceLooper.h"
