+#if SK_ARM_NEON_IS_ALWAYS && defined(SK_CPU_LENDIAN)
+    #include <arm_neon.h>
+#else
+    // if we don't have neon, then our black blitter is worth the extra code
+    #define USE_BLACK_BLITTER
