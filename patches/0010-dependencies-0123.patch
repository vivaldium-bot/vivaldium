+        if (fPixelLockCount > 0) {
+            fPixelRef->unlockPixels();
+        }
+        fPixelRef->unref();
+        fPixelRef = NULL;
+        fPixelRefOrigin.setZero();
+    }
+    fPixelLockCount = 0;
+    fPixels = NULL;
+    fColorTable = NULL;
+}
