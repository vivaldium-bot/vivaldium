+// Convert I420 with Alpha to preattenuated ARGB.
+static int I420AlphaToARGBMatrix(const uint8* src_y,
+                                 int src_stride_y,
+                                 const uint8* src_u,
+                                 int src_stride_u,
+                                 const uint8* src_v,
+                                 int src_stride_v,
+                                 const uint8* src_a,
+                                 int src_stride_a,
