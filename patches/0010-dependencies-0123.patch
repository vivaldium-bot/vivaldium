+        : INHERITED(device, paint) { SkASSERT(paint.getAlpha() == 0xFF); }
+    void blitMask(const SkMask&, const SkIRect&) override;
+    void blitAntiH2(int x, int y, U8CPU a0, U8CPU a1) override;
