+#include "SkDumpCanvas.h"
+
+bool SampleWindow::onHandleKey(SkKey key) {
+    {
+        SkView* view = curr_view(this);
+        if (view) {
+            SkEvent evt(gKeyEvtName);
+            evt.setFast32(key);
+            if (view->doQuery(&evt)) {
+                return true;
+            }
+        }
+    }
+    switch (key) {
+        case kRight_SkKey:
+            if (this->nextSample()) {
+                return true;
+            }
+            break;
+        case kLeft_SkKey:
+            if (this->previousSample()) {
+                return true;
+            }
+            return true;
+        case kUp_SkKey:
+            this->changeZoomLevel(1.f / 32.f);
+            return true;
+        case kDown_SkKey:
+            this->changeZoomLevel(-1.f / 32.f);
+            return true;
+        case kOK_SkKey: {
+            SkString title;
+            if (curr_title(this, &title)) {
+                writeTitleToPrefs(title.c_str());
+            }
+            return true;
+        }
+        case kBack_SkKey:
+            this->showOverview();
+            return true;
+        default:
+            break;
+    }
+    return this->INHERITED::onHandleKey(key);
+}
