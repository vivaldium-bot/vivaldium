index 0000000000000000000000000000000000000000..fc7d08792aa55a19c26a2f6bfdbeedc72e734004
--- /dev/null
+++ b/third_party/libyuv/libyuv.gyp
@@ -0,0 +1,161 @@
+# Copyright 2011 The LibYuv Project Authors. All rights reserved.
