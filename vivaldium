#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14,<3.15"
# dependencies = []
# ///
"""Python launcher; uv selects the interpreter without sourcing shell files."""
from pathlib import Path
import runpy
import sys

sys.stdout.reconfigure(line_buffering=True)
sys.stderr.reconfigure(line_buffering=True)
runpy.run_path(str(Path(__file__).resolve().parent / 'importer/main.py'), run_name='__main__')
